; QA fixture (DEV/tools/dock-baseline.sh): a 1-column toolbox that has to wrap,
; organizer on, drawer and most bars off (like Rick's GJ workspace).
[WORKSPACE]
NAME=One Column

[CHROME]
EDIT_BAR=HIDE
ADVANCED_BAR=HIDE
STATUS_BAR=HIDE
PREVIEW=HIDE
COLOR_MIXER=HIDE
CHARMAP=HIDE
DRAWER=HIDE

[TOOLBOX]
COLUMNS=1
