        CASE "OPACITY_SLIDER_TEXT_OUTLINE_FG"    : THEME.OPACITY_SLIDER_TEXT_OUTLINE_FG~&   = THEME_parse_rgba~&(val$)
        CASE "OPACITY_SLIDER_TEXT_OUTLINE_WIDTH" : THEME.OPACITY_SLIDER_TEXT_OUTLINE_WIDTH% = VAL(val$)
        CASE "OPACITY_SLIDER_WARN_FG"            : THEME.OPACITY_SLIDER_WARN_FG~&           = THEME_parse_rgba~&(val$)
        CASE "OPACITY_SLIDER_WARN_BORDER_FG"     : THEME.OPACITY_SLIDER_WARN_BORDER_FG~&    = THEME_parse_rgba~&(val$)
        CASE ELSE
            THEME_apply_kv% = FALSE
    END SELECT
END FUNCTION

' A theme colour drawn fainter than the key: alpha a (0-255) on top of the key's
' own alpha, never instead of it - so a theme can still fade or hide the part by
' the key's alpha (Rick 2026-11-21). A key left at 255 draws at exactly a.
FUNCTION THEME_fade~& (c AS _UNSIGNED LONG, a AS INTEGER)
    THEME_fade~& = (c AND &H00FFFFFF~&) OR _SHL(CLNG(_MAX(0, _MIN(255, a)) * _ALPHA32(c) \ 255), 24)
END FUNCTION

' Free an image handle (if valid) and reset it to 0 so its lazy loader reloads it.
' BYREF, so it works on plain vars, array elements, and UDT members alike.
SUB THEME_free_zero (h AS LONG)
    SAFE_FREEIMAGE h
    h = 0
END SUB

' Live theme switch: reload colors, cursors and every panel's cached icons so a
' theme change applies WITHOUT restarting. CFG.THEME$ must already hold the new
' theme name (Settings sets it before calling this).
'
' Caveat: panel FONT handles are not reloaded (each panel caches its own, and
' re-calling their inits would re-register menus/commands). Every stock DRAW theme
' shares DEFAULT's font, so this is invisible in practice; a theme that changes
' GLOBAL_FONT_FILE still needs a restart for the font to swap.
SUB THEME_reload_all ()
    DIM i AS INTEGER, g AS INTEGER, c AS INTEGER

    ' 1) Colors + theme metadata from the new theme's THEME.CFG.
    THEME_load

    ' 2) Toolbar icons (GUI_TB 0..29) — free+zero for lazy reload.
    FOR i% = 0 TO 29
        THEME_free_zero GUI_TB(i%).iHnd
        THEME_free_zero GUI_TB(i%).iHndAlt
    NEXT i%

    ' 3) Smart-shape flyout child icons.
    FOR g% = 0 TO SUBTOOL_MAX_GROUPS - 1
        FOR c% = 0 TO SUBTOOL_MAX_CHILDREN - 1
            THEME_free_zero SUBTOOL_GROUP_CHILDREN(g%, c%).iconHnd
        NEXT c%
    NEXT g%

    ' 4) Edit bar + Advanced bar (icon + dimmed copy; clear the loaded flag so the
    '    load sub re-runs — the load subs don't free first, so free here).
    FOR i% = 0 TO EDITBAR_TOTAL_SLOTS - 1
        THEME_free_zero EDIT_BAR_ITEMS(i%).iconHandle
        THEME_free_zero EDIT_BAR_ITEMS(i%).disabledHandle
    NEXT i%
    EDIT_BAR.iconsLoaded = FALSE
    FOR i% = 0 TO ADVBAR_TOTAL_SLOTS - 1
        THEME_free_zero ADV_BAR_ITEMS(i%).iconHandle
        THEME_free_zero ADV_BAR_ITEMS(i%).disabledHandle
    NEXT i%
    ADV_BAR.iconsLoaded = FALSE
    BL_free_tiles ' text tiles (GUI/BUTTON-LIST) use the theme's font

    ' 5) Text bar — named base icons and their dimmed "Off" copies.
    THEME_free_zero TEXT_BAR.iconBold       : THEME_free_zero TEXT_BAR.iconBoldOff
    THEME_free_zero TEXT_BAR.iconItalic     : THEME_free_zero TEXT_BAR.iconItalicOff
    THEME_free_zero TEXT_BAR.iconUnderline  : THEME_free_zero TEXT_BAR.iconUnderlineOff
    THEME_free_zero TEXT_BAR.iconStrike     : THEME_free_zero TEXT_BAR.iconStrikeOff
    THEME_free_zero TEXT_BAR.iconMono       : THEME_free_zero TEXT_BAR.iconMonoOff
    THEME_free_zero TEXT_BAR.iconLineHeight : THEME_free_zero TEXT_BAR.iconLineHeightOff
    THEME_free_zero TEXT_BAR.iconOutline    : THEME_free_zero TEXT_BAR.iconOutlineOff
    THEME_free_zero TEXT_BAR.iconShadow     : THEME_free_zero TEXT_BAR.iconShadowOff
    THEME_free_zero TEXT_BAR.iconAlignL     : THEME_free_zero TEXT_BAR.iconAlignLOff
    THEME_free_zero TEXT_BAR.iconAlignC     : THEME_free_zero TEXT_BAR.iconAlignCOff
    THEME_free_zero TEXT_BAR.iconAlignR     : THEME_free_zero TEXT_BAR.iconAlignROff
    THEME_free_zero TEXT_BAR.iconStyleU
    THEME_free_zero TEXT_BAR.iconStyleS
    THEME_free_zero TEXT_BAR.iconStyleX
    THEME_free_zero TEXT_BAR.iconAuto : THEME_free_zero TEXT_BAR.iconAutoOff
    THEME_free_zero TEXT_BAR.iconChar : THEME_free_zero TEXT_BAR.iconCharOff
    THEME_free_zero TEXT_BAR.iconAA   : THEME_free_zero TEXT_BAR.iconAAOff
    TEXT_BAR.iconsLoaded = FALSE

    ' 6) Layer panel icons — the load sub already frees+reloads cleanly.
    LAYER_PANEL_load_icons

    ' 7) Organizer widget icons + grid-mode/snap image arrays.
    FOR i% = 0 TO ORG_WIDGET_COUNT - 1
        THEME_free_zero ORG_WIDGETS(i%).imgHandles
        THEME_free_zero ORG_WIDGETS(i%).imgHandle2
        THEME_free_zero ORG_WIDGETS(i%).imgHandle3
        THEME_free_zero ORG_WIDGETS(i%).imgHandle4
    NEXT i%
    FOR g% = 0 TO 3
        THEME_free_zero GRID_MODE_IMG_OFF(g%)
        THEME_free_zero GRID_MODE_IMG_ON(g%)
        THEME_free_zero GRID_SNAP_IMG(g%)
    NEXT g%

    ' 8) Fill-adjust widget icon (also clears a -1 "no file" sentinel so it retries).
    THEME_free_zero FILL_ADJ_ICON_HANDLE

    ' 9) Cursors — CURSOR_load_all frees + reloads from the new theme.
    CURSOR_load_all

    ' 10) Drawer brushes/patterns/gradients + palette-strip PNGs — force a reload.
    DRAWER_free_samples

    ' 11) Repaint everything.
    GUI_NEEDS_REDRAW% = TRUE
    SCENE_DIRTY%      = TRUE
    FRAME_IDLE%       = FALSE
    _LOGINFO "THEME_reload_all: switched to " + _TRIM$(CFG.THEME$)
END SUB
