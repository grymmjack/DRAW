''
' DRAW - CFG/CONFIG-THEME.BM
' =============================================================================
' Runtime theme loader: reads ASSETS/THEMES/{CFG.THEME$}/THEME.CFG and
' overrides the compiled-in THEME.* defaults set by THEME.BI.
'
' Color values in THEME.CFG are stored as "R,G,B,A" (0-255 each).
' INTEGER and SINGLE values are plain decimal numbers.
' STRING values are plain text (no quotes).
'
' Called from SCREEN_init immediately after CONFIG_load so that CFG.THEME$ is
' known before any GUI subsystem reads THEME.*.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Parse a "R,G,B,A" color string into an _UNSIGNED LONG RGBA32 value.
' Missing components default to 255.
' @param val STRING Comma-separated color string in "R,G,B,A" format
' @return _UNSIGNED LONG - Parsed RGBA32 color value
'
FUNCTION THEME_parse_rgba~& (val$)
    DIM parts%(3)
    DIM i%
    DIM tok$
    DIM rest$
    DIM p%

    parts%(0) = 0: parts%(1) = 0: parts%(2) = 0: parts%(3) = 255
    rest$     = _TRIM$(val$)
    FOR i% = 0 TO 3
        p% = INSTR(rest$, ",")
        IF p% > 0 THEN
            tok$  = _TRIM$(LEFT$(rest$, p% - 1))
            rest$ = MID$(rest$, p% + 1)
        ELSE
            tok$  = _TRIM$(rest$)
            rest$ = ""
        END IF
        IF LEN(tok$) > 0 THEN parts%(i%) = VAL(tok$)
    NEXT i%
    THEME_parse_rgba~& = _RGBA32(parts%(0), parts%(1), parts%(2), parts%(3))
END FUNCTION

''
' Resolve a font filename to an absolute-relative path.
' Priority: ASSETS/THEMES/{theme}/FONTS/{file}  →  ASSETS/FONTS/{file}
' Logs _LOGERROR and returns the fallback path if neither exists.
' @param filename STRING Font filename to resolve (e.g. "Tiny5-Regular.ttf")
' @return STRING - Resolved path to the font file
'
FUNCTION THEME_font_path$ (filename AS STRING)
    DIM themePath AS STRING
    DIM fallback  AS STRING
    themePath$ = "ASSETS/THEMES/" + _TRIM$(CFG.THEME$) + "/FONTS/" + _TRIM$(filename$)
    IF _FILEEXISTS(themePath$) THEN
        THEME_font_path$ = themePath$
        EXIT FUNCTION
    END IF
    fallback$ = "ASSETS/FONTS/" + _TRIM$(filename$)
    IF NOT _FILEEXISTS(fallback$) THEN
        _LOGERROR "THEME_font_path: font not found in theme or fallback: " + _TRIM$(filename$)
    END IF
    THEME_font_path$ = fallback$
END FUNCTION

''
' Load theme settings from ASSETS/THEMES/{CFG.THEME$}/THEME.CFG.
' If the file does not exist, compiled-in THEME.BI defaults remain unchanged.
'
''
' Public theme loader. BUG-54: layer the COMPLETE DEFAULT theme as a base first, then
' overlay the selected theme, so a custom/incomplete theme that omits keys (font sizes,
' bar heights, colours) inherits sane DEFAULT values instead of leaving those THEME.*
' fields at 0. This matters because THEME_load runs once EARLY from SCREEN_init — before
' _ALL.BI includes DEFAULT/THEME.BI (which sets the compiled-in defaults) — so at that
' point every THEME.* field is 0; a complete theme happens to set them all, but an
' incomplete one left the omitted keys at 0, and any *_init that loaded a font / derived
' geometry from a size field during the include chain baked in a size-0 font or zero-
' height bar. Loading DEFAULT first makes the base complete regardless of include timing.
'
SUB THEME_load ()
    DIM sel AS STRING : sel$ = _TRIM$(CFG.THEME$)
    IF UCASE$(sel$) <> "DEFAULT" THEN THEME_load_theme "DEFAULT"
    THEME_load_theme sel$
END SUB

''
' Parse ASSETS/THEMES/<themeName>/THEME.CFG and apply its keys onto the current THEME.
' Only keys present in the file are touched (an omitted key keeps whatever THEME already
' holds), so callers layer a base theme then overlays — see THEME_load.
'
SUB THEME_load_theme (themeName AS STRING)
    DIM themeCfgPath$
    DIM fh%
    DIM ln$
    DIM key$
    DIM val$
    DIM eqPos%
    DIM section$
    DIM bracketEnd%
    DIM unknownKeys%
    DIM fileKeys$ ' CHR$(1) KEY CHR$(2) value, per line the file set (THEME_inherit)

    themeCfgPath$ = "ASSETS/THEMES/" + _TRIM$(themeName$) + "/THEME.CFG"
    IF NOT _FILEEXISTS(themeCfgPath$) THEN
        _LOGINFO "THEME_load_theme: " + themeCfgPath$ + " not found, using compiled defaults"
        EXIT SUB
    END IF

    section$ = ""
    fh%      = FREEFILE
    OPEN themeCfgPath$ FOR INPUT AS #fh%
    DO WHILE NOT EOF(fh%)
        LINE INPUT #fh%, ln$
        ln$ = _TRIM$(ln$)
        ' Skip blank lines and comments
        IF LEN(ln$) = 0 OR LEFT$(ln$, 1) = "#" OR LEFT$(ln$, 1) = ";" THEN
            ' skip
        ELSEIF LEFT$(ln$, 1) = "[" THEN
            ' INI-style [SECTION] header — track current section, skip line
            bracketEnd% = INSTR(ln$, "]")
            IF bracketEnd% > 1 THEN
                section$ = UCASE$(_TRIM$(MID$(ln$, 2, bracketEnd% - 2)))
            END IF
        ELSE
            eqPos% = INSTR(ln$, "=")
            IF eqPos% > 0 THEN
                key$ = UCASE$(_TRIM$(LEFT$(ln$, eqPos% - 1)))
                val$ = _TRIM$(MID$(ln$, eqPos% + 1))

                IF THEME_apply_kv%(key$, val$) = 0 THEN unknownKeys% = unknownKeys% + 1
                fileKeys$ = fileKeys$ + CHR$(1) + key$ + CHR$(2) + val$
            END IF
        END IF
    LOOP
    CLOSE #fh%
    THEME_inherit fileKeys$
    section$ = "" ' suppress unused-variable warning
    _LOGINFO "THEME_load: loaded " + themeCfgPath$ + _IIF(unknownKeys% > 0, " (" + _TRIM$(STR$(unknownKeys%)) + " unknown keys ignored)", "")
END SUB

''
' Theme keys split off an older, shared key: "CHILD=PARENT ..." (parents before their
' children). A theme file that sets PARENT but not CHILD gives CHILD the parent's value,
' so a theme made before the split keeps its look (THEME_inherit). A key with no parent
' here takes its compiled default when the file lacks it.
'
FUNCTION THEME_inherit_list$
    DIM acc AS STRING
    acc$ = "DIALOG_CHECKBOX_BG=DIALOG_BG DIALOG_BUTTON_BG=DIALOG_TOGGLE_BG DIALOG_BUTTON_HOVER_BG=DIALOG_TOGGLE_SEL_BG DIALOG_BUTTON_BORDER=DIALOG_TOGGLE_BORDER"
    acc$ = acc$ + " DIALOG_BUTTON_DISABLED_FG=DIALOG_PREVIEW_LABEL_FG DIALOG_BUTTON_PRIMARY_FG=DIALOG_BUTTON_FG DIALOG_BUTTON_CANCEL_FG=DIALOG_BUTTON_FG"
    acc$ = acc$ + " DIALOG_BUTTON_DANGER_FG=DIALOG_BUTTON_FG DIALOG_BUTTON_WARN_FG=DIALOG_BUTTON_FG DIALOG_BUTTON_ACCENT_FG=DIALOG_BUTTON_FG"
    acc$ = acc$ + " DIALOG_TOGGLE_HOVER_BG=DIALOG_TITLE_HOVER_BG DIALOG_CHECKBOX_BORDER=DIALOG_TOGGLE_BORDER DIALOG_CHECKBOX_HOVER_BORDER=DIALOG_TOGGLE_SEL_BORDER"
    acc$ = acc$ + " DIALOG_CHECKBOX_CHECKED_BG=DIALOG_TOGGLE_SEL_BG DIALOG_CHECKBOX_MARK=DIALOG_TOGGLE_SEL_FG DIALOG_FIELD_BG=DIALOG_SLIDER_TRACK_BG"
    acc$ = acc$ + " DIALOG_FIELD_BORDER=DIALOG_SLIDER_TRACK_BORDER DIALOG_FIELD_FG=DIALOG_SLIDER_VALUE_FG DIALOG_FIELD_HINT_FG=DIALOG_TOGGLE_SEL_BG"
    acc$ = acc$ + " DIALOG_FIELD_HOVER_BG=DIALOG_TOGGLE_SEL_BG DIALOG_FIELD_ACTIVE_BG=DIALOG_TOGGLE_SEL_BG DIALOG_FIELD_ACTIVE_FG=DIALOG_TOGGLE_SEL_FG"
    acc$ = acc$ + " DIALOG_FIELD_ACTIVE_BORDER=DIALOG_TOGGLE_SEL_BORDER DIALOG_LIST_BG=DIALOG_BG DIALOG_LIST_BORDER=DIALOG_TOGGLE_BORDER DIALOG_LIST_FG=DIALOG_LABEL_FG"
    acc$ = acc$ + " DIALOG_LIST_HOVER_BG=DIALOG_TITLE_HOVER_BG DIALOG_LIST_HOVER_FG=DIALOG_LABEL_FG DIALOG_LIST_SEL_BG=DIALOG_TOGGLE_SEL_BG"
    acc$ = acc$ + " DIALOG_LIST_SEL_FG=DIALOG_TOGGLE_SEL_FG DIALOG_LIST_HEADER_BG=DIALOG_TITLE_BG DIALOG_LIST_HEADER_FG=DIALOG_TITLE_FG DIALOG_TAB_FG=DIALOG_LABEL_FG"
    acc$ = acc$ + " DIALOG_TAB_HOVER_BG=DIALOG_TOGGLE_BG DIALOG_TAB_HOVER_FG=DIALOG_TOGGLE_FG DIALOG_TAB_SEL_BG=DIALOG_TOGGLE_SEL_BG"
    acc$ = acc$ + " DIALOG_TAB_SEL_FG=DIALOG_TOGGLE_SEL_FG DIALOG_SECTION_FG=DIALOG_TITLE_FG DIALOG_DIVIDER=DIALOG_BORDER_INNER DIALOG_SWATCH_BORDER=DIALOG_TOGGLE_BORDER"
    acc$ = acc$ + " DIALOG_SWATCH_HOVER_BORDER=DIALOG_TOGGLE_SEL_BORDER"
    acc$ = acc$ + " DIALOG_FIELD_SELECTION_BG=DIALOG_TOGGLE_SEL_BG DIALOG_BAR_BG=DIALOG_BG DIALOG_STATUS_FG=DIALOG_TOGGLE_SEL_FG DIALOG_CHANGED_BG=DIALOG_TOGGLE_SEL_BG DIALOG_CHANGED_FG=DIALOG_TOGGLE_SEL_FG"
