    acc$ = acc$ + " PANEL_TAB_SEL_FG=LAYER_PANEL_HEADER_FG PANEL_CLOSE_FG=CP_CLOSE_HOVER_BG PANEL_CLOSE_HOVER_BG=CP_CLOSE_HOVER_BG"
    acc$ = acc$ + " PANEL_CLOSE_HOVER_FG=CP_CLOSE_FG PANEL_GRIP=LAYER_PANEL_HEADER_FG PANEL_LABEL_FG=CP_TEXT PANEL_VALUE_FG=CP_TEXT_BRIGHT"
    acc$ = acc$ + " PANEL_HINT_FG=CP_TEXT_DIM PANEL_DISABLED_FG=CP_TEXT_DIM PANEL_WARNING_FG=CP_CLOSE_FG PANEL_SECTION_FG=CP_TEXT_DIM"
