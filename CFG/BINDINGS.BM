''
' DRAW - CFG/BINDINGS.BM
' =============================================================================
' User keyboard-binding override engine (Phase 3). See BINDINGS.BI.
'
' Lifecycle (wired in INPUT/INPUT.BM INPUTS_init):
'   INPUTS_register_all            ' compiled-in defaults -> INPUT_BINDS
'   BINDINGS_init : BINDINGS_load  ' read DRAW.bindings deltas
'   BINDINGS_apply                 ' re-point matching INPUT_BINDS triggers + rebuild skip-list
'   INPUT_interesting_keys_build   ' (runs after, sees overridden keycodes)
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Resolve the DRAW.bindings path in the OS-native config dir.
'
SUB BINDINGS_init ()
    BINDINGS_FILE$ = PATHS_CONFIG_DIR$ + "DRAW.bindings"
    BINDING_OVERRIDE_COUNT = 0
END SUB

''
' Load override deltas from DRAW.bindings. Format: one row per line,
'   actionId keycode requireMods forbidMods
' '#' comment lines and blanks ignored. No file = no overrides (defaults win).
'
SUB BINDINGS_load ()
    BINDING_OVERRIDE_COUNT = 0
    IF LEN(BINDINGS_FILE$) = 0 THEN EXIT SUB
    IF NOT _FILEEXISTS(BINDINGS_FILE$) THEN EXIT SUB

    DIM ff AS INTEGER : ff% = FREEFILE
    OPEN BINDINGS_FILE$ FOR INPUT AS #ff%
    DIM ln AS STRING
    DO WHILE NOT EOF(ff%)
        LINE INPUT #ff%, ln$
        ln$ = _TRIM$(ln$)
        IF LEN(ln$) > 0 AND LEFT$(ln$, 1) <> "#" THEN
            DIM a AS INTEGER, kc AS LONG, rm AS INTEGER, fm AS INTEGER, dv AS INTEGER, bt AS INTEGER, wd AS INTEGER, et AS INTEGER, dwd AS INTEGER
            IF BINDINGS_parse_row%(ln$, a, kc, rm, fm, dv, bt, wd, et, dwd) THEN
                IF BINDING_OVERRIDE_COUNT < BINDINGS_MAX_OVERRIDES THEN
                    BINDING_OVERRIDE_COUNT = BINDING_OVERRIDE_COUNT + 1
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).actionId    = a%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).keycode     = kc&
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).requireMods = rm%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).forbidMods  = fm%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).device      = dv%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).button      = bt%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).wheelDir    = wd%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).eventType   = et%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).defWheelDir = dwd%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).active      = TRUE
                END IF
            END IF
        END IF
    LOOP
    CLOSE #ff%
    IF BINDING_OVERRIDE_COUNT > 0 THEN _LOGINFO "BINDINGS: loaded " + _TRIM$(STR$(BINDING_OVERRIDE_COUNT)) + " override(s)"
END SUB

''
' Parse "actionId keycode requireMods forbidMods" (space-separated ints).
' Returns TRUE on a valid 4-field row.
'
FUNCTION BINDINGS_parse_row% (row AS STRING, actionId AS INTEGER, keycode AS LONG, requireMods AS INTEGER, forbidMods AS INTEGER, device AS INTEGER, button AS INTEGER, wheelDir AS INTEGER, eventType AS INTEGER, defWheelDir AS INTEGER)
    DIM parts(1 TO 9) AS STRING, n AS INTEGER, s AS STRING, i AS INTEGER, c AS STRING
    n% = 0 : s$ = ""
    DIM src AS STRING : src$ = _TRIM$(row$) + " "
    FOR i% = 1 TO LEN(src$)
        c$ = MID$(src$, i%, 1)
        IF c$ = " " OR c$ = CHR$(9) THEN
            IF LEN(s$) > 0 AND n% < 9 THEN n% = n% + 1 : parts(n%) = s$ : s$ = ""
        ELSE
            s$ = s$ + c$
        END IF
    NEXT i%
    IF n% < 4 THEN BINDINGS_parse_row% = FALSE : EXIT FUNCTION
    actionId%    = VAL(parts(1))
    keycode&     = VAL(parts(2))
    requireMods% = VAL(parts(3))
    forbidMods%  = VAL(parts(4))
    ' Fields 5-6 (device, button) optional — 4-field files are keyboard rows.
    IF n% >= 6 THEN
        device%  = VAL(parts(5))
        button%  = VAL(parts(6))
    ELSE
        device%  = DEVICE_KEYBOARD
        button%  = 0
    END IF
    ' Fields 7-8 (wheelDir, eventType) optional — 6-field files are button/keyboard rows.
    IF n% >= 8 THEN
        wheelDir%  = VAL(parts(7))
        eventType% = VAL(parts(8))
    ELSE
        wheelDir%  = 0
        eventType% = 0    ' 0 = legacy button/keyboard (never a wheel row)
    END IF
    ' Field 9 (defWheelDir) optional — 8-field files predate the tilt/vertical split
    ' (defWheelDir 0 = first-match apply, the old behavior).
    IF n% >= 9 THEN defWheelDir% = VAL(parts(9)) ELSE defWheelDir% = 0
    IF actionId% = 0 THEN BINDINGS_parse_row% = FALSE : EXIT FUNCTION
    ' A keyboard row needs a keycode; a mouse WHEEL row needs a wheelDir; a mouse
    ' button row needs a button.
    IF device% = DEVICE_MOUSE THEN
        IF eventType% = EVT_MOUSE_WHEEL THEN
            BINDINGS_parse_row% = (wheelDir% <> 0)
        ELSE
            BINDINGS_parse_row% = (button% <> 0)
        END IF
    ELSE
        BINDINGS_parse_row% = (keycode& <> 0)
    END IF
END FUNCTION

''
' Apply loaded overrides on top of the registered defaults: for each override,
' re-point the FIRST dispatched keyboard binding of that action to the new
' trigger, then rebuild the letter skip-list so KEYBOARD_tools defers to the
' new keycode (and stops deferring the old one).
'
SUB BINDINGS_apply ()
    IF BINDING_OVERRIDE_COUNT = 0 THEN EXIT SUB
    DIM o AS INTEGER, i AS INTEGER
    FOR o% = 1 TO BINDING_OVERRIDE_COUNT
        IF BINDING_OVERRIDES(o%).active THEN
            IF BINDING_OVERRIDES(o%).device = DEVICE_MOUSE THEN
                ' Mouse override: re-point the first matching MOUSE binding of the
                ' action. A WHEEL override (eventType EVT_MOUSE_WHEEL) targets the
                ' action's wheel bind and sets wheelDir; a button/down override
                ' (eventType 0 in legacy files = button) targets its button bind and
                ' sets button. Matching on eventType keeps the two independent. NOT
                ' gated on `dispatched` — queried behaviors (paint FG/BG) accept it too.
                DIM ovWheel AS INTEGER : ovWheel% = (BINDING_OVERRIDES(o%).eventType = EVT_MOUSE_WHEEL)
                DIM ovDefWd AS INTEGER : ovDefWd% = BINDING_OVERRIDES(o%).defWheelDir
                FOR i% = 1 TO INPUT_BIND_COUNT
                    IF INPUT_BINDS(i%).actionId = BINDING_OVERRIDES(o%).actionId _
                       AND INPUT_BINDS(i%).device = DEVICE_MOUSE _
                       AND ((INPUT_BINDS(i%).eventType = EVT_MOUSE_WHEEL) = ovWheel%) _
                       AND (ovDefWd% = 0 _ORELSE INPUT_BINDS(i%).defWheelDir = ovDefWd%) THEN
                        ' defWheelDir disambiguates an action with BOTH a tilt (±2) and a
                        ' vertical (±1) wheel bind (601/602): each rebinds independently.
                        ' Legacy overrides carry defWheelDir 0 → first-match (old behavior).
                        IF ovWheel% THEN
                            INPUT_BINDS(i%).wheelDir    = BINDING_OVERRIDES(o%).wheelDir
                        ELSE
                            INPUT_BINDS(i%).button      = BINDING_OVERRIDES(o%).button
                        END IF
                        INPUT_BINDS(i%).requireMods    = BINDING_OVERRIDES(o%).requireMods
                        INPUT_BINDS(i%).userOverridden = TRUE
                        EXIT FOR ' first match only
                    END IF
                NEXT i%
            ELSE
                FOR i% = 1 TO INPUT_BIND_COUNT
                    IF INPUT_BINDS(i%).actionId = BINDING_OVERRIDES(o%).actionId _
                       AND INPUT_BINDS(i%).device = DEVICE_KEYBOARD _
                       AND INPUT_BINDS(i%).dispatched THEN
                        INPUT_BINDS(i%).keycode        = BINDING_OVERRIDES(o%).keycode
                        INPUT_BINDS(i%).requireMods    = BINDING_OVERRIDES(o%).requireMods
                        INPUT_BINDS(i%).forbidMods     = BINDING_OVERRIDES(o%).forbidMods
                        INPUT_BINDS(i%).userOverridden = TRUE
                        EXIT FOR ' first match only
                    END IF
                NEXT i%
            END IF
        END IF
    NEXT o%
    BINDINGS_rebuild_skiplist
    INPUT_interesting_keys_build   ' a rebound key must be watched by the dispatcher
END SUB

''
' Rebuild INPUT_LETTER_DISPATCHED from the current (possibly overridden)
' INPUT_BINDS, mirroring the flag rule in INPUT_register%.
'
SUB BINDINGS_rebuild_skiplist ()
    DIM i AS INTEGER, lc AS INTEGER
    FOR i% = 0 TO 127 : INPUT_LETTER_DISPATCHED(i%) = FALSE : NEXT i%
    FOR i% = 1 TO INPUT_BIND_COUNT
        IF INPUT_BINDS(i%).dispatched AND INPUT_BINDS(i%).eventType = EVT_KEY_PRESS THEN
            ' Flag the CURRENT (possibly overridden) no-mod letter key.
            IF INPUT_BINDS(i%).keycode >= 0 AND INPUT_BINDS(i%).keycode <= 127 _
               AND INPUT_BINDS(i%).requireMods = 0 THEN
                lc% = INPUT_BINDS(i%).keycode
                IF lc% >= 65 AND lc% <= 90 THEN lc% = lc% + 32
                IF lc% >= 0 AND lc% <= 127 THEN INPUT_LETTER_DISPATCHED(lc%) = TRUE
            END IF
            ' ALSO flag the compiled DEFAULT key, so a migrated action's legacy handler
            ' stays suppressed even after the user rebinds the action to another key.
            ' Without this, rebinding e.g. Flip H (h->j) dropped 'h' from the skip-list
            ' and the legacy 'h' handler re-awakened => both h AND j flipped.
            IF INPUT_BINDS(i%).defKeycode >= 0 AND INPUT_BINDS(i%).defKeycode <= 127 _
               AND INPUT_BINDS(i%).defRequireMods = 0 THEN
                lc% = INPUT_BINDS(i%).defKeycode
                IF lc% >= 65 AND lc% <= 90 THEN lc% = lc% + 32
                IF lc% >= 0 AND lc% <= 127 THEN INPUT_LETTER_DISPATCHED(lc%) = TRUE
            END IF
        END IF
    NEXT i%
END SUB

''
' Find a binding that would CONFLICT with (keycode, requireMods) for a given
' action — same keycode, same required mods, a DIFFERENT action, and overlapping
' context (neither forbids a context the other requires). Returns the conflicting
' actionId, or 0 if none.
'
FUNCTION BINDINGS_find_conflict% (forActionId AS INTEGER, keycode AS LONG, requireMods AS INTEGER, requireCtx AS _UNSIGNED _INTEGER64, forbidCtx AS _UNSIGNED _INTEGER64)
    DIM i AS INTEGER
    FOR i% = 1 TO INPUT_BIND_COUNT
        IF INPUT_BINDS(i%).device = DEVICE_KEYBOARD _
           AND INPUT_BINDS(i%).actionId <> forActionId% _
           AND INPUT_BINDS(i%).keycode = keycode& _
           AND INPUT_BINDS(i%).requireMods = requireMods% THEN
            ' context overlap: the other's required ctx isn't forbidden by ours, and vice-versa
            IF (INPUT_BINDS(i%).requireCtx AND forbidCtx) = 0 _
               AND (requireCtx AND INPUT_BINDS(i%).forbidCtx) = 0 THEN
                BINDINGS_find_conflict% = INPUT_BINDS(i%).actionId
                EXIT FUNCTION
            END IF
        END IF
    NEXT i%
    BINDINGS_find_conflict% = 0
END FUNCTION

''
' Set (or replace) an override for an action, persist, and re-apply live.
'
SUB BINDINGS_set_override (actionId AS INTEGER, keycode AS LONG, requireMods AS INTEGER, forbidMods AS INTEGER)
    ' Keyboard override. Slot is keyed by (actionId, device) so a mouse override
    ' for the same action lives in its own row.
    DIM o AS INTEGER, slot AS INTEGER : slot% = 0
    FOR o% = 1 TO BINDING_OVERRIDE_COUNT
        IF BINDING_OVERRIDES(o%).actionId = actionId% AND BINDING_OVERRIDES(o%).device = DEVICE_KEYBOARD THEN slot% = o% : EXIT FOR
    NEXT o%
    IF slot% = 0 THEN
        IF BINDING_OVERRIDE_COUNT >= BINDINGS_MAX_OVERRIDES THEN EXIT SUB
        BINDING_OVERRIDE_COUNT = BINDING_OVERRIDE_COUNT + 1
        slot% = BINDING_OVERRIDE_COUNT
    END IF
    BINDING_OVERRIDES(slot%).actionId    = actionId%
    BINDING_OVERRIDES(slot%).keycode     = keycode&
    BINDING_OVERRIDES(slot%).requireMods = requireMods%
    BINDING_OVERRIDES(slot%).forbidMods  = forbidMods%
    BINDING_OVERRIDES(slot%).device      = DEVICE_KEYBOARD
    BINDING_OVERRIDES(slot%).button      = 0
    BINDING_OVERRIDES(slot%).active      = TRUE
    BINDINGS_save
    BINDINGS_apply
END SUB

''
' Mouse override: remap which mouse button (+ modifiers) triggers an action.
' Parallel to BINDINGS_set_override but stores a button instead of a keycode, in
' its own (actionId, DEVICE_MOUSE) row.
'
SUB BINDINGS_set_mouse_override (actionId AS INTEGER, button AS INTEGER, requireMods AS INTEGER)
    ' Button/down override. Slot keyed by (actionId, MOUSE, NOT-wheel) so an action's
    ' independent WHEEL override lives in its own row and neither clobbers the other.
    DIM o AS INTEGER, slot AS INTEGER : slot% = 0
    FOR o% = 1 TO BINDING_OVERRIDE_COUNT
        IF BINDING_OVERRIDES(o%).actionId = actionId% AND BINDING_OVERRIDES(o%).device = DEVICE_MOUSE _
           AND BINDING_OVERRIDES(o%).eventType <> EVT_MOUSE_WHEEL THEN slot% = o% : EXIT FOR
    NEXT o%
    IF slot% = 0 THEN
        IF BINDING_OVERRIDE_COUNT >= BINDINGS_MAX_OVERRIDES THEN EXIT SUB
        BINDING_OVERRIDE_COUNT = BINDING_OVERRIDE_COUNT + 1
        slot% = BINDING_OVERRIDE_COUNT
    END IF
    BINDING_OVERRIDES(slot%).actionId    = actionId%
    BINDING_OVERRIDES(slot%).keycode     = 0
    BINDING_OVERRIDES(slot%).requireMods = requireMods%
    BINDING_OVERRIDES(slot%).forbidMods  = 0
    BINDING_OVERRIDES(slot%).device      = DEVICE_MOUSE
    BINDING_OVERRIDES(slot%).button      = button%
    BINDING_OVERRIDES(slot%).wheelDir    = 0
    BINDING_OVERRIDES(slot%).eventType   = EVT_MOUSE_DOWN
    BINDING_OVERRIDES(slot%).defWheelDir = 0
    BINDING_OVERRIDES(slot%).active      = TRUE
    BINDINGS_save
    BINDINGS_apply
END SUB

''
' Wheel override: remap which wheel direction (±1 vertical / ±2 tilt, + mods)
' triggers an action. Parallel to the button override but in its own wheel row.
'
SUB BINDINGS_set_wheel_override (actionId AS INTEGER, wheelDir AS INTEGER, requireMods AS INTEGER, defWheelDir AS INTEGER)
    ' Slot keyed by (actionId, MOUSE, WHEEL, defWheelDir) so an action's tilt (±2)
    ' and vertical (±1) wheel binds each get their own override row.
    DIM o AS INTEGER, slot AS INTEGER : slot% = 0
    FOR o% = 1 TO BINDING_OVERRIDE_COUNT
        IF BINDING_OVERRIDES(o%).actionId = actionId% AND BINDING_OVERRIDES(o%).device = DEVICE_MOUSE _
           AND BINDING_OVERRIDES(o%).eventType = EVT_MOUSE_WHEEL _
           AND BINDING_OVERRIDES(o%).defWheelDir = defWheelDir% THEN slot% = o% : EXIT FOR
    NEXT o%
    IF slot% = 0 THEN
        IF BINDING_OVERRIDE_COUNT >= BINDINGS_MAX_OVERRIDES THEN EXIT SUB
        BINDING_OVERRIDE_COUNT = BINDING_OVERRIDE_COUNT + 1
        slot% = BINDING_OVERRIDE_COUNT
    END IF
    BINDING_OVERRIDES(slot%).actionId    = actionId%
    BINDING_OVERRIDES(slot%).keycode     = 0
    BINDING_OVERRIDES(slot%).requireMods = requireMods%
    BINDING_OVERRIDES(slot%).forbidMods  = 0
    BINDING_OVERRIDES(slot%).device      = DEVICE_MOUSE
    BINDING_OVERRIDES(slot%).button      = 0
    BINDING_OVERRIDES(slot%).wheelDir    = wheelDir%
    BINDING_OVERRIDES(slot%).eventType   = EVT_MOUSE_WHEEL
    BINDING_OVERRIDES(slot%).defWheelDir = defWheelDir%
    BINDING_OVERRIDES(slot%).active      = TRUE
    BINDINGS_save
    BINDINGS_apply
END SUB

''
' Write all active overrides to DRAW.bindings (binary PUT — no PRINT/_DEST).
'
SUB BINDINGS_save ()
    IF LEN(BINDINGS_FILE$) = 0 THEN EXIT SUB
    DIM outStr AS STRING, nl AS STRING, o AS INTEGER
    nl$ = CHR$(10)
    outStr$ = "# DRAW binding overrides. Fields: actionId keycode requireMods forbidMods device button [wheelDir eventType [defWheelDir]]" + nl$
    FOR o% = 1 TO BINDING_OVERRIDE_COUNT
        IF BINDING_OVERRIDES(o%).active THEN
            outStr$ = outStr$ + _TRIM$(STR$(BINDING_OVERRIDES(o%).actionId)) + " " _
                        + _TRIM$(STR$(BINDING_OVERRIDES(o%).keycode)) + " " _
                        + _TRIM$(STR$(BINDING_OVERRIDES(o%).requireMods)) + " " _
                        + _TRIM$(STR$(BINDING_OVERRIDES(o%).forbidMods)) + " " _
                        + _TRIM$(STR$(BINDING_OVERRIDES(o%).device)) + " " _
                        + _TRIM$(STR$(BINDING_OVERRIDES(o%).button)) + " " _
                        + _TRIM$(STR$(BINDING_OVERRIDES(o%).wheelDir)) + " " _
                        + _TRIM$(STR$(BINDING_OVERRIDES(o%).eventType)) + " " _
                        + _TRIM$(STR$(BINDING_OVERRIDES(o%).defWheelDir)) + nl$
        END IF
    NEXT o%
    IF _FILEEXISTS(BINDINGS_FILE$) THEN KILL BINDINGS_FILE$
    DIM ff AS INTEGER : ff% = FREEFILE
    OPEN BINDINGS_FILE$ FOR BINARY AS #ff%
    PUT #ff%, 1, outStr$
    CLOSE #ff%
END SUB

''
' Clear all overrides + delete the file. (Defaults take over after the next
' registry rebuild / restart; callers that need it live re-register.)
'
' Restore every binding's LIVE trigger to its compiled default (keycode + mods +
' mouse button), clearing the overridden flag. Live because the registry keeps
' applied triggers — else a reset/preset-switch wouldn't take effect until relaunch.
' Does NOT touch the override table or DRAW.bindings — callers handle those.
'
SUB BINDINGS_restore_live_defaults ()
    DIM i AS INTEGER
    FOR i% = 1 TO INPUT_BIND_COUNT
        INPUT_BINDS(i%).keycode        = INPUT_BINDS(i%).defKeycode
        INPUT_BINDS(i%).requireMods    = INPUT_BINDS(i%).defRequireMods
        INPUT_BINDS(i%).forbidMods     = INPUT_BINDS(i%).defForbidMods
        INPUT_BINDS(i%).button         = INPUT_BINDS(i%).defButton
        INPUT_BINDS(i%).wheelDir       = INPUT_BINDS(i%).defWheelDir
        INPUT_BINDS(i%).userOverridden = FALSE
    NEXT i%
    BINDINGS_rebuild_skiplist
    INPUT_interesting_keys_build
END SUB

SUB BINDINGS_reset_all ()
    BINDING_OVERRIDE_COUNT = 0
    BINDINGS_restore_live_defaults
    IF LEN(BINDINGS_FILE$) > 0 AND _FILEEXISTS(BINDINGS_FILE$) THEN KILL BINDINGS_FILE$
    _LOGINFO "BINDINGS: reset to defaults (live)"
END SUB

''
' Load a shipped preset keymap (ASSETS/PRESETS/<name>.bindings) as the user's
' overrides: its rows REPLACE the current DRAW.bindings, then apply live. Same
' row format as DRAW.bindings. Unmapped actions keep their DRAW defaults.
'
SUB BINDINGS_load_preset (presetName AS STRING)
    DIM path AS STRING : path$ = "ASSETS/PRESETS/" + presetName$ + ".bindings"
    IF NOT _FILEEXISTS(path$) THEN
        _LOGWARN "BINDINGS: preset not found: " + path$
        EXIT SUB
    END IF
    BINDING_OVERRIDE_COUNT = 0
    ' Start from a clean default registry so switching presets REPLACES (not layers
    ' onto) the previous one, and "draw-default" (0 rows) truly resets live.
    BINDINGS_restore_live_defaults
    DIM ff AS INTEGER : ff% = FREEFILE
    OPEN path$ FOR INPUT AS #ff%
    DIM ln AS STRING, a AS INTEGER, kc AS LONG, rm AS INTEGER, fm AS INTEGER, dv AS INTEGER, bt AS INTEGER, wd AS INTEGER, et AS INTEGER, dwd AS INTEGER
    DO WHILE NOT EOF(ff%)
        LINE INPUT #ff%, ln$
        ln$ = _TRIM$(ln$)
        IF LEN(ln$) > 0 AND LEFT$(ln$, 1) <> "#" THEN
            IF BINDINGS_parse_row%(ln$, a, kc, rm, fm, dv, bt, wd, et, dwd) THEN
                IF BINDING_OVERRIDE_COUNT < BINDINGS_MAX_OVERRIDES THEN
                    BINDING_OVERRIDE_COUNT = BINDING_OVERRIDE_COUNT + 1
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).actionId    = a%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).keycode     = kc&
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).requireMods = rm%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).forbidMods  = fm%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).device      = dv%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).button      = bt%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).wheelDir    = wd%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).eventType   = et%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).defWheelDir = dwd%
                    BINDING_OVERRIDES(BINDING_OVERRIDE_COUNT).active      = TRUE
                END IF
            END IF
        END IF
    LOOP
    CLOSE #ff%
    BINDINGS_save   ' becomes the user's DRAW.bindings
    BINDINGS_apply  ' live
    _LOGINFO "BINDINGS: loaded preset '" + presetName$ + "' (" + _TRIM$(STR$(BINDING_OVERRIDE_COUNT)) + " overrides)"
END SUB
