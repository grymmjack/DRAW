        CASE "CURSOR_MARQUEE_RECT_HOTSPOT_X": THEMEP_get$ = RTRIM$(CURSORS(13).hotspot_x_expr)
        CASE "CURSOR_MARQUEE_RECT_HOTSPOT_Y": THEMEP_get$ = RTRIM$(CURSORS(13).hotspot_y_expr)
        CASE "CURSOR_MARQUEE_FREE_FILE": THEMEP_get$ = RTRIM$(CURSORS(14).filename)
        CASE "CURSOR_MARQUEE_FREE_HOTSPOT_X": THEMEP_get$ = RTRIM$(CURSORS(14).hotspot_x_expr)
        CASE "CURSOR_MARQUEE_FREE_HOTSPOT_Y": THEMEP_get$ = RTRIM$(CURSORS(14).hotspot_y_expr)
        CASE "CURSOR_MARQUEE_POLY_FILE": THEMEP_get$ = RTRIM$(CURSORS(15).filename)
        CASE "CURSOR_MARQUEE_POLY_HOTSPOT_X": THEMEP_get$ = RTRIM$(CURSORS(15).hotspot_x_expr)
        CASE "CURSOR_MARQUEE_POLY_HOTSPOT_Y": THEMEP_get$ = RTRIM$(CURSORS(15).hotspot_y_expr)
        CASE "CURSOR_MARQUEE_ELLIP_FILE": THEMEP_get$ = RTRIM$(CURSORS(16).filename)
        CASE "CURSOR_MARQUEE_ELLIP_HOTSPOT_X": THEMEP_get$ = RTRIM$(CURSORS(16).hotspot_x_expr)
        CASE "CURSOR_MARQUEE_ELLIP_HOTSPOT_Y": THEMEP_get$ = RTRIM$(CURSORS(16).hotspot_y_expr)
        CASE "SPLASH_HOLD_TIME": THEMEP_get$ = UIP_num_str$(THEME.SPLASH_HOLD_TIME!)
        CASE "SPLASH_BG_COLOR": THEMEP_get$ = UIP_rgba_str$(THEME.SPLASH_BG_COLOR~&)
        CASE "SPLASH_VERSION_SHOW": THEMEP_get$ = _IIF(THEME.SPLASH_VERSION_SHOW%, "TRUE", "FALSE")
        CASE "SPLASH_VERSION_PREFIX": THEMEP_get$ = RTRIM$(THEME.SPLASH_VERSION_PREFIX$)
        CASE "SPLASH_VERSION_FONT": THEMEP_get$ = RTRIM$(THEME.SPLASH_VERSION_FONT$)
        CASE "SPLASH_VERSION_FONT_SIZE": THEMEP_get$ = UIP_num_str$(THEME.SPLASH_VERSION_FONT_SIZE%)
        CASE "SPLASH_VERSION_COLOR": THEMEP_get$ = UIP_rgba_str$(THEME.SPLASH_VERSION_COLOR~&)
        CASE "SPLASH_VERSION_X": THEMEP_get$ = UIP_num_str$(THEME.SPLASH_VERSION_X%)
        CASE "SPLASH_VERSION_Y": THEMEP_get$ = UIP_num_str$(THEME.SPLASH_VERSION_Y%)
        CASE "WINDOW_BG_COLOR": THEMEP_get$ = UIP_rgba_str$(THEME.WINDOW_BG_COLOR~&)
        CASE "OPACITY_SLIDER_BG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_BG~&)
        CASE "OPACITY_SLIDER_FG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_FG~&)
        CASE "OPACITY_SLIDER_BORDER_FG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_BORDER_FG~&)
        CASE "OPACITY_SLIDER_BORDER_WIDTH": THEMEP_get$ = UIP_num_str$(THEME.OPACITY_SLIDER_BORDER_WIDTH%)
        CASE "OPACITY_SLIDER_PADDING": THEMEP_get$ = UIP_num_str$(THEME.OPACITY_SLIDER_PADDING%)
        CASE "OPACITY_SLIDER_HANDLE_HEIGHT": THEMEP_get$ = UIP_num_str$(THEME.OPACITY_SLIDER_HANDLE_HEIGHT%)
        CASE "OPACITY_SLIDER_TEXT_FG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_TEXT_FG~&)
        CASE "OPACITY_SLIDER_TEXT_BG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_TEXT_BG~&)
        CASE "OPACITY_SLIDER_HANDLE_FG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_HANDLE_FG~&)
        CASE "OPACITY_SLIDER_TEXT_WARN_FG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_TEXT_WARN_FG~&)
        CASE "OPACITY_SLIDER_TEXT_OUTLINE_FG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_TEXT_OUTLINE_FG~&)
        CASE "OPACITY_SLIDER_TEXT_OUTLINE_WIDTH": THEMEP_get$ = UIP_num_str$(THEME.OPACITY_SLIDER_TEXT_OUTLINE_WIDTH%)
        CASE "OPACITY_SLIDER_WARN_FG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_WARN_FG~&)
        CASE "OPACITY_SLIDER_WARN_BORDER_FG": THEMEP_get$ = UIP_rgba_str$(THEME.OPACITY_SLIDER_WARN_BORDER_FG~&)
        CASE ELSE: THEMEP_get$ = ""
    END SELECT
END FUNCTION
