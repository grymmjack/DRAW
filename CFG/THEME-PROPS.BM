    UIP_prop_add "CURSOR_MARQUEE_FREE_HOTSPOT_Y", UIP_T_TEXT, "CURSOR", ""
    UIP_prop_add "CURSOR_MARQUEE_POLY_FILE", UIP_T_IMAGE, "CURSOR", ""
    UIP_prop_add "CURSOR_MARQUEE_POLY_HOTSPOT_X", UIP_T_TEXT, "CURSOR", ""
    UIP_prop_add "CURSOR_MARQUEE_POLY_HOTSPOT_Y", UIP_T_TEXT, "CURSOR", ""
    UIP_prop_add "CURSOR_MARQUEE_ELLIP_FILE", UIP_T_IMAGE, "CURSOR", ""
    UIP_prop_add "CURSOR_MARQUEE_ELLIP_HOTSPOT_X", UIP_T_TEXT, "CURSOR", ""
    UIP_prop_add "CURSOR_MARQUEE_ELLIP_HOTSPOT_Y", UIP_T_TEXT, "CURSOR", ""
    UIP_prop_add "SPLASH_HOLD_TIME", UIP_T_REAL, "SPLASH", "Seconds splash stays visible after fade-in (default 1.0)"
    UIP_prop_add "SPLASH_BG_COLOR", UIP_T_COLOR, "SPLASH", "Splash background fill color (default black)"
    UIP_prop_add "SPLASH_VERSION_SHOW", UIP_T_BOOL, "SPLASH", "TRUE = render version string on splash (default TRUE)"
    UIP_prop_add "SPLASH_VERSION_PREFIX", UIP_T_TEXT, "SPLASH", "String prepended to APP_VERSION$ (default 'v')"
    UIP_prop_add "SPLASH_VERSION_FONT", UIP_T_FONT, "SPLASH", "Font filename, looked up via THEME_font_path$ (default 'Tiny5-Regular.ttf')"
    UIP_prop_add "SPLASH_VERSION_FONT_SIZE", UIP_T_INT, "SPLASH", "Font size in image-space pixels (default 8)"
    UIP_prop_add "SPLASH_VERSION_COLOR", UIP_T_COLOR, "SPLASH", "Version text color (default RGB 145,164,240)"
    UIP_prop_add "SPLASH_VERSION_X", UIP_T_INT, "SPLASH", "X offset in image-space pixels from splash image top-left (default 45)"
    UIP_prop_add "SPLASH_VERSION_Y", UIP_T_INT, "SPLASH", "Y offset in image-space pixels from splash image top-left (default 32)"
    UIP_prop_add "WINDOW_BG_COLOR", UIP_T_COLOR, "WINDOW", "Default window background color (default black)"
    UIP_prop_add "OPACITY_SLIDER_BG", UIP_T_COLOR, "OPACITY_SLIDER", "Slider track fill (inactive / low-fill area)"
    UIP_prop_add "OPACITY_SLIDER_FG", UIP_T_COLOR, "OPACITY_SLIDER", "Slider fill (active / high-fill area)"
    UIP_prop_add "OPACITY_SLIDER_BORDER_FG", UIP_T_COLOR, "OPACITY_SLIDER", "Slider outer border color"
    UIP_prop_add "OPACITY_SLIDER_BORDER_WIDTH", UIP_T_INT, "OPACITY_SLIDER", "Slider border width in pixels"
    UIP_prop_add "OPACITY_SLIDER_PADDING", UIP_T_INT, "OPACITY_SLIDER", "Pixels between border and track body (filled with BG color)"
    UIP_prop_add "OPACITY_SLIDER_HANDLE_HEIGHT", UIP_T_INT, "OPACITY_SLIDER", "Height of handle bar in pixels"
    UIP_prop_add "OPACITY_SLIDER_TEXT_FG", UIP_T_COLOR, "OPACITY_SLIDER", "Percentage text color (normal)"
    UIP_prop_add "OPACITY_SLIDER_TEXT_BG", UIP_T_COLOR, "OPACITY_SLIDER", "Percentage text shadow/bg color (0 = none)"
    UIP_prop_add "OPACITY_SLIDER_HANDLE_FG", UIP_T_COLOR, "OPACITY_SLIDER", "Handle line color"
    UIP_prop_add "OPACITY_SLIDER_TEXT_WARN_FG", UIP_T_COLOR, "OPACITY_SLIDER", "Percentage text color when <= warn threshold"
    UIP_prop_add "OPACITY_SLIDER_TEXT_OUTLINE_FG", UIP_T_COLOR, "OPACITY_SLIDER", "Text stroke/outline color"
    UIP_prop_add "OPACITY_SLIDER_TEXT_OUTLINE_WIDTH", UIP_T_INT, "OPACITY_SLIDER", "Text outline width in pixels (0 = off)"
    UIP_prop_add "OPACITY_SLIDER_WARN_FG", UIP_T_COLOR, "OPACITY_SLIDER", "Slider fill color when <= warn threshold"
    UIP_prop_add "OPACITY_SLIDER_WARN_BORDER_FG", UIP_T_COLOR, "OPACITY_SLIDER", "Border color when <= warn threshold"
END SUB

''
' The live value of a theme key, in theme-file form ("" = unknown key).
' @param pk STRING Theme key (upper case)
' @return STRING value
'
FUNCTION THEMEP_get$ (pk AS STRING)
    SELECT CASE pk
        CASE "STATUS_BG": THEMEP_get$ = UIP_num_str$(THEME.STATUS_bg%)
        CASE "STATUS_FG": THEMEP_get$ = UIP_num_str$(THEME.STATUS_fg%)
        CASE "STATUS_HEIGHT": THEMEP_get$ = UIP_num_str$(THEME.STATUS_height%)
        CASE "STATUS_BG_COLOR": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_bg_color~&)
        CASE "STATUS_FG_COLOR": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_fg_color~&)
        CASE "STATUS_SWATCH_FG_OUTLINE": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_swatch_fg_outline~&)
        CASE "STATUS_SWATCH_BG_OUTLINE": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_swatch_bg_outline~&)
        CASE "STATUS_SWATCH_TRANSPARENT_BG": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_swatch_transparent_bg~&)
        CASE "STATUS_SWATCH_TRANSPARENT_DIAGONAL": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_swatch_transparent_diagonal~&)
        CASE "STATUS_SWATCH_TRANSPARENT_BORDER": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_swatch_transparent_border~&)
        CASE "STATUS_SWATCH_ACTIVE_OUTER": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_swatch_active_outer~&)
        CASE "STATUS_SWATCH_ACTIVE_INNER": THEMEP_get$ = UIP_rgba_str$(THEME.STATUS_swatch_active_inner~&)
        CASE "CROSSHAIR_COLOR_FG": THEMEP_get$ = UIP_rgba_str$(THEME.CROSSHAIR_color_fg~&)
        CASE "CROSSHAIR_OPACITY": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_opacity%)
        CASE "CROSSHAIR_FONT": THEMEP_get$ = RTRIM$(THEME.CROSSHAIR_font$)
        CASE "CROSSHAIR_FONT_SIZE": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_font_size%)
        CASE "CROSSHAIR_FONT_FG": THEMEP_get$ = UIP_rgba_str$(THEME.CROSSHAIR_font_fg~&)
        CASE "CROSSHAIR_FONT_STROKE_FG": THEMEP_get$ = UIP_rgba_str$(THEME.CROSSHAIR_font_stroke_fg~&)
        CASE "CROSSHAIR_FONT_STROKE_WIDTH": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_font_stroke_width%)
        CASE "CROSSHAIR_FONT_OFFSET_X": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_font_offset_x%)
        CASE "CROSSHAIR_FONT_OFFSET_Y": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_font_offset_y%)
        CASE "CROSSHAIR_PATTERN": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_pattern%)
        CASE "CROSSHAIR_ANGLE": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_angle!)
        CASE "CROSSHAIR_OUTLINE_FG": THEMEP_get$ = UIP_rgba_str$(THEME.CROSSHAIR_outline_fg~&)
        CASE "CROSSHAIR_OUTLINE_OPACITY": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_outline_opacity%)
        CASE "CROSSHAIR_OUTLINE_WIDTH": THEMEP_get$ = UIP_num_str$(THEME.CROSSHAIR_outline_width%)
        CASE "SMART_GUIDES_COLOR_FG": THEMEP_get$ = UIP_rgba_str$(THEME.SMART_GUIDES_color_fg~&)
        CASE "SMART_GUIDES_OPACITY": THEMEP_get$ = UIP_num_str$(THEME.SMART_GUIDES_opacity%)
        CASE "SMART_GUIDES_OUTLINE_FG": THEMEP_get$ = UIP_rgba_str$(THEME.SMART_GUIDES_outline_fg~&)
        CASE "SMART_GUIDES_OUTLINE_OPACITY": THEMEP_get$ = UIP_num_str$(THEME.SMART_GUIDES_outline_opacity%)
