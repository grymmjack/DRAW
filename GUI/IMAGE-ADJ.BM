''
' Water Drops / Jiggle (Eye Candy "Shape") — scatter droplet lenses over the shape.
' Droplet centres sit on a hash-jittered grid; inside a droplet the underlying
' pixels are magnified by a radial lens (sample pulled outward from the centre)
' and a specular highlight is added up-left of centre, so each drop reads as a
' refractive bubble. RGB-only (stays inside the shape) -> apply_to_layer.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param dropSize  INTEGER  Droplet radius in px (4..24)
' @param refract   INTEGER  Lens magnification strength 0..100
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_waterdrops& (sourceImg AS LONG, dropSize AS INTEGER, refract AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_waterdrops& = 0 : EXIT FUNCTION

    DIM wdW AS LONG, wdH AS LONG
    wdW& = _WIDTH(sourceImg&) : wdH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM spacing AS INTEGER : spacing% = INT(dropSize% * 2.2) : IF spacing% < 4 THEN spacing% = 4
    DIM kMax AS SINGLE : kMax! = 0.15 + refract% / 100.0 * 0.5
    DIM radius AS SINGLE : radius! = dropSize%

    DIM wx AS LONG, wy AS LONG, aHere AS _UNSIGNED _BYTE
    DIM cgx AS LONG, cgy AS LONG, ngx AS INTEGER, ngy AS INTEGER
    DIM ccx AS SINGLE, ccy AS SINGLE, ddx AS SINGLE, ddy AS SINGLE, dist AS SINGLE
    DIM bestD AS SINGLE, bcx AS SINGLE, bcy AS SINGLE, jit AS SINGLE
    DIM rel AS SINGLE, klens AS SINGLE, samX AS LONG, samY AS LONG, sA AS _UNSIGNED _BYTE
    DIM pix AS _UNSIGNED LONG, pr AS INTEGER, pg AS INTEGER, pb AS INTEGER
    DIM hi AS SINGLE, wr AS INTEGER, wg AS INTEGER, wb AS INTEGER
    FOR wy& = 0 TO wdH& - 1
    IF (wy& AND 15) = 0 THEN IMGADJ_progress_tick "Waterdrops", wy& / wdH&
        FOR wx& = 0 TO wdW& - 1
            _MEMGET srcM, srcM.OFFSET + (wy& * wdW& + wx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE

            ' nearest droplet centre among the 3x3 neighbouring grid cells
            cgx& = wx& \ spacing% : cgy& = wy& \ spacing%
            bestD! = radius! + 1
            bcx! = -1 : bcy! = -1
            FOR ngy% = -1 TO 1
                FOR ngx% = -1 TO 1
                    jit! = IMGADJ_valnoise!((cgx& + ngx%) * 1.3, (cgy& + ngy%) * 1.3, 101)
                    ccx! = (cgx& + ngx%) * spacing% + spacing% * (0.25 + 0.5 * jit!)
                    jit! = IMGADJ_valnoise!((cgx& + ngx%) * 1.3, (cgy& + ngy%) * 1.3, 102)
                    ccy! = (cgy& + ngy%) * spacing% + spacing% * (0.25 + 0.5 * jit!)
                    ddx! = wx& - ccx! : ddy! = wy& - ccy!
                    dist! = SQR(ddx! * ddx! + ddy! * ddy!)
                    IF dist! < bestD! THEN bestD! = dist! : bcx! = ccx! : bcy! = ccy!
                NEXT ngx%
                NEXT ngy%
            IF bestD! > radius! OR bcx! < 0 THEN _CONTINUE

            rel! = bestD! / radius!                          ' 0 centre .. 1 rim
            ' lens: pull the sample outward from the centre near the middle
            klens! = kMax! * (1.0 - rel! * rel!)
            samX& = wx& + INT((wx& - bcx!) * klens! + 0.5)
            samY& = wy& + INT((wy& - bcy!) * klens! + 0.5)
            IF samX& < 0 THEN samX& = 0
            IF samX& >= wdW& THEN samX& = wdW& - 1
            IF samY& < 0 THEN samY& = 0
            IF samY& >= wdH& THEN samY& = wdH& - 1
            _MEMGET srcM, srcM.OFFSET + (samY& * wdW& + samX&) * 4 + 3, sA~%%
            IF sA~%% = 0 THEN samX& = wx& : samY& = wy&      ' don't sample transparency
            _MEMGET srcM, srcM.OFFSET + (samY& * wdW& + samX&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)

            ' specular highlight up-left of the droplet centre
            hi! = 0.0
            ddx! = (wx& - bcx!) / radius! + 0.35
            ddy! = (wy& - bcy!) / radius! + 0.35
            IF ddx! * ddx! + ddy! * ddy! < 0.16 THEN
                hi! = (1.0 - (ddx! * ddx! + ddy! * ddy!) / 0.16) * 0.85
            END IF
            ' slight rim darkening for depth
            IF rel! > 0.85 THEN pr% = INT(pr% * 0.8) : pg% = INT(pg% * 0.8) : pb% = INT(pb% * 0.8)
            wr% = pr% + INT((255 - pr%) * hi!) : IF wr% > 255 THEN wr% = 255
            wg% = pg% + INT((255 - pg%) * hi!) : IF wg% > 255 THEN wg% = 255
            wb% = pb% + INT((255 - pb%) * hi!) : IF wb% > 255 THEN wb% = 255
            _MEMPUT resM, resM.OFFSET + (wy& * wdW& + wx&) * 4, _RGBA32(wr%, wg%, wb%, aHere~%%) AS _UNSIGNED LONG
        NEXT wx&
    NEXT wy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_waterdrops& = result&
END FUNCTION


''
' Open a modal Water Drops dialog: SIZE (4..24) + REFRACT (0..100). RGB-only ->
' apply_to_layer.
'
SUB IMAGE_ADJ_waterdrops_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM dropSize AS INTEGER : dropSize% = 10
    DIM refract  AS INTEGER : refract%  = 60
    DIM oSize AS INTEGER, oRefract AS INTEGER

    DIM k AS LONG
    DIM d_dropSize AS INTEGER : d_dropSize% = 10
    DIM d_refract AS INTEGER : d_refract% = 60
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oSize% = dropSize% : oRefract% = refract%
        dropSize% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, dropSize%, 4, 100)
        dropSize% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, dropSize%, 4, 100)
        refract%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, refract%, 0, 100)
        refract%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, refract%, 0, 100)
        IF dropSize% <> oSize% OR refract% <> oRefract% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, dropSize%, refract%, d_dropSize%, d_refract%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_waterdrops&(ctx.origThumb, dropSize%, refract%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "WATER DROPS"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "SIZE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, dropSize%, 4, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "REFRACT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, refract%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM wdTargets(1 TO MAX_LAYERS) AS INTEGER, wdTgtCount AS INTEGER, wdT AS INTEGER
        DIM wdSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets wdTargets%(), wdTgtCount%
        wdSaveCL% = CURRENT_LAYER%
        IF wdTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        FOR wdT% = 1 TO wdTgtCount%
            CURRENT_LAYER% = wdTargets%(wdT%)
            adjR&          = IMAGE_ADJ_waterdrops&(LAYERS(CURRENT_LAYER%).imgHandle&, dropSize%, refract%)
            IMAGE_ADJ_apply_to_layer adjR&, "Water Drops"
        NEXT wdT%
        IF wdTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = wdSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Electrify (Eye Candy "Shape") — crackling electric arcs around the shape edge.
' Transparent pixels within REACH of the shape get a base glow (falling off with
' distance to the nearest opaque pixel), which a high-frequency noise threshold
' breaks into thin filaments so it reads as arcing electricity rather than a
' smooth halo. Electric blue-white. Adds pixels -> apply_spatial.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param reach     INTEGER  Arc reach from the edge in px (2..12)
' @param intensity INTEGER  Arc brightness/coverage 0..100
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_electrify& (sourceImg AS LONG, reach AS INTEGER, intensity AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_electrify& = 0 : EXIT FUNCTION

    DIM elW AS LONG, elH AS LONG
    elW& = _WIDTH(sourceImg&) : elH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM iScale AS SINGLE : iScale! = 0.5 + intensity% / 100.0
    ' lower threshold with intensity so more filaments light up
    DIM arcThresh AS SINGLE : arcThresh! = 0.72 - (intensity% / 100.0) * 0.22

    DIM ex AS LONG, ey AS LONG, aHere AS _UNSIGNED _BYTE
    DIM ox AS INTEGER, oy AS INTEGER, nax AS LONG, nay AS LONG, nearA AS _UNSIGNED _BYTE
    DIM minD AS SINGLE, dd AS SINGLE, glow AS SINGLE, nz AS SINGLE, arc AS SINGLE
    DIM er AS INTEGER, eg AS INTEGER, eb AS INTEGER, ea AS INTEGER
    FOR ey& = 0 TO elH& - 1
    IF (ey& AND 15) = 0 THEN IMGADJ_progress_tick "Electrify", ey& / elH&
        FOR ex& = 0 TO elW& - 1
            _MEMGET srcM, srcM.OFFSET + (ey& * elW& + ex&) * 4 + 3, aHere~%%
            IF aHere~%% <> 0 THEN _CONTINUE                 ' arcs fill empty space near the edge

            ' nearest opaque pixel within the reach box
            minD! = reach% + 1
            FOR oy% = -reach% TO reach%
                nay& = ey& + oy%
                IF nay& < 0 OR nay& >= elH& THEN _CONTINUE
                FOR ox% = -reach% TO reach%
                    nax& = ex& + ox%
                    IF nax& < 0 OR nax& >= elW& THEN _CONTINUE
                    _MEMGET srcM, srcM.OFFSET + (nay& * elW& + nax&) * 4 + 3, nearA~%%
                    IF nearA~%% <> 0 THEN
                        dd! = SQR(ox% * ox% + oy% * oy%)
                        IF dd! < minD! THEN minD! = dd!
                    END IF
                NEXT ox%
            NEXT oy%
            IF minD! > reach% THEN _CONTINUE

            glow! = 1.0 - minD! / reach%
            ' high-frequency noise -> thin arcing filaments
            nz! = IMGADJ_valnoise!(ex& * 0.55, ey& * 0.55, 91) * 0.6 _
                + IMGADJ_valnoise!(ex& * 1.3, ey& * 1.3, 92) * 0.4
            IF nz! < arcThresh! THEN _CONTINUE              ' between filaments — dark
            arc! = glow! * ((nz! - arcThresh!) / (1.0 - arcThresh! + 0.0001)) * iScale!
            IF arc! <= 0.05 THEN _CONTINUE
            IF arc! > 1.0 THEN arc! = 1.0

            ' electric blue-white: hot core -> white, cooler -> blue
            er% = INT((120 + 135 * arc!)) : IF er% > 255 THEN er% = 255
            eg% = INT((170 + 85 * arc!)) : IF eg% > 255 THEN eg% = 255
            eb% = 255
            ea% = INT(arc! * 255)
            _MEMPUT resM, resM.OFFSET + (ey& * elW& + ex&) * 4, _RGBA32(er%, eg%, eb%, ea%) AS _UNSIGNED LONG
        NEXT ex&
    NEXT ey&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_electrify& = result&
END FUNCTION


''
' Open a modal Electrify dialog: REACH (2..12) + INTENSITY (0..100). Adds pixels
' -> apply_spatial.
'
SUB IMAGE_ADJ_electrify_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM reach     AS INTEGER : reach%     = 7
    DIM intensity AS INTEGER : intensity% = 65
    DIM oReach AS INTEGER, oIntensity AS INTEGER

    DIM k AS LONG
    DIM d_reach AS INTEGER : d_reach% = 7
    DIM d_intensity AS INTEGER : d_intensity% = 65
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oReach% = reach% : oIntensity% = intensity%
        reach%     = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, reach%, 2, 32)
        reach%     = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, reach%, 2, 32)
        intensity% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, intensity%, 0, 100)
        intensity% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, intensity%, 0, 100)
        IF reach% <> oReach% OR intensity% <> oIntensity% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, reach%, intensity%, d_reach%, d_intensity%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_electrify&(IMGADJ_fx_src&(ctx), reach%, intensity%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "ELECTRIFY"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "REACH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, reach%, 2, 32, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "INTENSITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, intensity%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM elTargets(1 TO MAX_LAYERS) AS INTEGER, elTgtCount AS INTEGER, elT AS INTEGER
        DIM elSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets elTargets%(), elTgtCount%
        elSaveCL% = CURRENT_LAYER%
        IF elTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        FOR elT% = 1 TO elTgtCount%
            CURRENT_LAYER% = elTargets%(elT%)
            DIM elEdge AS LONG
            elEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF elEdge& < -1 THEN
                adjR& = IMAGE_ADJ_electrify&(elEdge&, reach%, intensity%)
                IMAGE_ADJ_apply_spatial_edge adjR&, elEdge&, "Electrify"
                SAFE_FREEIMAGE elEdge&
            ELSE
                adjR& = IMAGE_ADJ_electrify&(LAYERS(CURRENT_LAYER%).imgHandle&, reach%, intensity%)
                IMAGE_ADJ_apply_spatial adjR&, "Electrify"
            END IF
        NEXT elT%
        IF elTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = elSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Glass (Eye Candy "Shape") — give the shape a glassy sheen: translucent
' lightening (FROST) plus two diagonal specular highlight streaks (SHINE) swept
' across the surface, brightest along the streak centres. RGB-only (stays inside
' the shape) -> apply_to_layer.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param shine     INTEGER  Specular streak strength 0..100
' @param frost     INTEGER  Overall glassy lightening 0..100
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_glass& (sourceImg AS LONG, shine AS INTEGER, frost AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_glass& = 0 : EXIT FUNCTION

    DIM glW AS LONG, glH AS LONG
    glW& = _WIDTH(sourceImg&) : glH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM shScale AS SINGLE : shScale! = shine% / 100.0
    DIM frScale AS SINGLE : frScale! = frost% / 100.0 * 0.4
    DIM diag AS SINGLE : diag! = glW& + glH&
    ' two streak centres along the diagonal axis (as fractions of the diagonal)
    DIM c1 AS SINGLE, c2 AS SINGLE
    c1! = 0.34 : c2! = 0.6

    DIM gx AS LONG, gy AS LONG, aHere AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG
    DIM u AS SINGLE, s1 AS SINGLE, s2 AS SINGLE, spec AS SINGLE, lift AS SINGLE
    DIM pr AS INTEGER, pg AS INTEGER, pb AS INTEGER, oR2 AS INTEGER, oG2 AS INTEGER, oB2 AS INTEGER
    FOR gy& = 0 TO glH& - 1
    IF (gy& AND 15) = 0 THEN IMGADJ_progress_tick "Glass", gy& / glH&
        FOR gx& = 0 TO glW& - 1
            _MEMGET srcM, srcM.OFFSET + (gy& * glW& + gx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE

            u! = (gx& + gy&) / diag!                        ' position along the diagonal 0..1
            ' gaussian-ish streaks around c1 (broad) and c2 (thin, brighter)
            s1! = EXP(-((u! - c1!) * (u! - c1!)) / 0.004)
            s2! = EXP(-((u! - c2!) * (u! - c2!)) / 0.0012)
            spec! = (s1! * 0.7 + s2! * 1.0) * shScale!

            _MEMGET srcM, srcM.OFFSET + (gy& * glW& + gx&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)
            ' translucent frost lift toward white, then additive specular
            lift! = frScale! + spec!
            IF lift! > 1.0 THEN lift! = 1.0
            oR2% = pr% + INT((255 - pr%) * lift!)
            oG2% = pg% + INT((255 - pg%) * lift!)
            oB2% = pb% + INT((255 - pb%) * lift!)
            _MEMPUT resM, resM.OFFSET + (gy& * glW& + gx&) * 4, _RGBA32(oR2%, oG2%, oB2%, aHere~%%) AS _UNSIGNED LONG
        NEXT gx&
    NEXT gy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_glass& = result&
END FUNCTION


''
' Open a modal Glass dialog: SHINE (0..100) + FROST (0..100). RGB-only ->
' apply_to_layer.
'
SUB IMAGE_ADJ_glass_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM shine AS INTEGER : shine% = 75
    DIM frost AS INTEGER : frost% = 25
    DIM oShine AS INTEGER, oFrost AS INTEGER

    DIM k AS LONG
    DIM d_shine AS INTEGER : d_shine% = 75
    DIM d_frost AS INTEGER : d_frost% = 25
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oShine% = shine% : oFrost% = frost%
        shine% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, shine%, 0, 100)
        shine% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, shine%, 0, 100)
        frost% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, frost%, 0, 100)
        frost% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, frost%, 0, 100)
        IF shine% <> oShine% OR frost% <> oFrost% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, shine%, frost%, d_shine%, d_frost%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_glass&(ctx.origThumb, shine%, frost%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "GLASS"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "SHINE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, shine%, 0, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "FROST:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, frost%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM glTargets(1 TO MAX_LAYERS) AS INTEGER, glTgtCount AS INTEGER, glT AS INTEGER
        DIM glSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets glTargets%(), glTgtCount%
        glSaveCL% = CURRENT_LAYER%
        IF glTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        FOR glT% = 1 TO glTgtCount%
            CURRENT_LAYER% = glTargets%(glT%)
            adjR&          = IMAGE_ADJ_glass&(LAYERS(CURRENT_LAYER%).imgHandle&, shine%, frost%)
            IMAGE_ADJ_apply_to_layer adjR&, "Glass"
        NEXT glT%
        IF glTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = glSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Drip (Eye Candy "Shape") — liquid runs drip off the bottom edge in the shape's
' OWN colour. Only some columns drip (hash-gated by AMOUNT); each drip runs down
' a hash-scaled length, slightly darkened, with a rounded fuller bulb at the tip.
' Adds pixels below the shape -> apply_spatial.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param lengthP   INTEGER  Max drip length in px (4..48)
' @param amount    INTEGER  How many columns drip 0..100
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_drip& (sourceImg AS LONG, lengthP AS INTEGER, amount AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_drip& = 0 : EXIT FUNCTION

    DIM drW AS LONG, drH AS LONG
    drW& = _WIDTH(sourceImg&) : drH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM gate AS SINGLE : gate! = amount% / 100.0 * 0.5     ' fraction of edge columns that drip
    DIM dx AS LONG, dy AS LONG, belowA AS _UNSIGNED _BYTE, aHere AS _UNSIGNED _BYTE, tgtA AS _UNSIGNED _BYTE
    DIM pick AS SINGLE, dripLen AS INTEGER, d AS INTEGER, ny AS LONG
    DIM pix AS _UNSIGNED LONG, pr AS INTEGER, pg AS INTEGER, pb AS INTEGER
    DIM shade AS SINGLE, da AS INTEGER, t AS SINGLE
    FOR dy& = 0 TO drH& - 1
    IF (dy& AND 15) = 0 THEN IMGADJ_progress_tick "Drip", dy& / drH&
        FOR dx& = 0 TO drW& - 1
            _MEMGET srcM, srcM.OFFSET + (dy& * drW& + dx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            IF dy& + 1 >= drH& THEN _CONTINUE
            _MEMGET srcM, srcM.OFFSET + ((dy& + 1) * drW& + dx&) * 4 + 3, belowA~%%
            IF belowA~%% <> 0 THEN _CONTINUE               ' not a bottom edge

            ' does THIS column drip? gate on a per-column hash
            pick! = IMGADJ_valnoise!(dx& * 0.9, 7.3, 81)
            IF pick! > gate! THEN _CONTINUE
            dripLen% = INT(lengthP% * (0.35 + 0.65 * IMGADJ_valnoise!(dx& * 0.5, 1.1, 82)))
            IF dripLen% < 3 THEN _CONTINUE

            _MEMGET srcM, srcM.OFFSET + (dy& * drW& + dx&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)

            FOR d% = 1 TO dripLen%
                ny& = dy& + d%
                IF ny& >= drH& THEN EXIT FOR
                _MEMGET srcM, srcM.OFFSET + (ny& * drW& + dx&) * 4 + 3, tgtA~%%
                IF tgtA~%% <> 0 THEN EXIT FOR
                t! = d% / dripLen%
                ' liquid darkens slightly toward the tip; rounded bulb = full alpha
                ' in the last ~20% of the run, thinner mid-run
                shade! = 0.75 + 0.25 * (1.0 - t!)
                IF t! > 0.8 THEN
                    da% = 255                              ' bulb
                ELSE
                    da% = 210
                END IF
                _MEMPUT resM, resM.OFFSET + (ny& * drW& + dx&) * 4, _RGBA32(INT(pr% * shade!), INT(pg% * shade!), INT(pb% * shade!), da%) AS _UNSIGNED LONG
            NEXT d%
        NEXT dx&
    NEXT dy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_drip& = result&
END FUNCTION


''
' Open a modal Drip dialog: LENGTH (4..48) + AMOUNT (0..100). Adds pixels ->
' apply_spatial.
'
SUB IMAGE_ADJ_drip_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM lengthP AS INTEGER : lengthP% = 22
    DIM amount  AS INTEGER : amount%  = 55
    DIM oLength AS INTEGER, oAmount AS INTEGER

    DIM k AS LONG
    DIM d_lengthP AS INTEGER : d_lengthP% = 22
    DIM d_amount AS INTEGER : d_amount% = 55
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oLength% = lengthP% : oAmount% = amount%
        lengthP% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, lengthP%, 4, 250)
        lengthP% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, lengthP%, 4, 250)
        amount%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, amount%, 0, 100)
        amount%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, amount%, 0, 100)
        IF lengthP% <> oLength% OR amount% <> oAmount% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, lengthP%, amount%, d_lengthP%, d_amount%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_drip&(IMGADJ_fx_src&(ctx), lengthP%, amount%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "DRIP"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "LENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, lengthP%, 4, 250, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "AMOUNT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, amount%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM drTargets(1 TO MAX_LAYERS) AS INTEGER, drTgtCount AS INTEGER, drT AS INTEGER
        DIM drSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets drTargets%(), drTgtCount%
        drSaveCL% = CURRENT_LAYER%
        IF drTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        FOR drT% = 1 TO drTgtCount%
            CURRENT_LAYER% = drTargets%(drT%)
            DIM drEdge AS LONG
            drEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF drEdge& < -1 THEN
                adjR& = IMAGE_ADJ_drip&(drEdge&, lengthP%, amount%)
                IMAGE_ADJ_apply_spatial_edge adjR&, drEdge&, "Drip"
                SAFE_FREEIMAGE drEdge&
            ELSE
                adjR& = IMAGE_ADJ_drip&(LAYERS(CURRENT_LAYER%).imgHandle&, lengthP%, amount%)
                IMAGE_ADJ_apply_spatial adjR&, "Drip"
            END IF
        NEXT drT%
        IF drTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = drSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Icicles (Eye Candy "Shape") — pale ice spikes hang off the shape's bottom edges.
' Each bottom-edge pixel (opaque with transparent directly below) grows a downward
' spike whose LENGTH is a smooth low-frequency noise of the column (so neighbouring
' columns form pointed icicles), in a pale cyan-white that fades and brightens
' toward a glassy tip. Adds pixels below the shape -> apply_spatial.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param lengthP   INTEGER  Max icicle length in px (4..40)
' @param thickness INTEGER  Coverage/opacity 0..100
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_icicles& (sourceImg AS LONG, lengthP AS INTEGER, thickness AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_icicles& = 0 : EXIT FUNCTION

    DIM icW AS LONG, icH AS LONG
    icW& = _WIDTH(sourceImg&) : icH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM tBoost AS SINGLE : tBoost! = 0.4 + thickness% / 100.0
    DIM ix AS LONG, iy AS LONG, belowA AS _UNSIGNED _BYTE, aHere AS _UNSIGNED _BYTE, tgtA AS _UNSIGNED _BYTE
    DIM spikeLen AS INTEGER, d AS INTEGER, ny AS LONG, t AS SINGLE, colN AS SINGLE
    DIM icA AS INTEGER, icR AS INTEGER, icG AS INTEGER, icB AS INTEGER, glint AS SINGLE
    FOR iy& = 0 TO icH& - 1
    IF (iy& AND 15) = 0 THEN IMGADJ_progress_tick "Icicles", iy& / icH&
        FOR ix& = 0 TO icW& - 1
            _MEMGET srcM, srcM.OFFSET + (iy& * icW& + ix&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE                 ' start from the shape
            IF iy& + 1 >= icH& THEN _CONTINUE
            _MEMGET srcM, srcM.OFFSET + ((iy& + 1) * icW& + ix&) * 4 + 3, belowA~%%
            IF belowA~%% <> 0 THEN _CONTINUE               ' not a bottom edge

            ' spike length from a smooth per-column noise -> pointed clusters
            colN! = IMGADJ_valnoise!(ix& * 0.28, 3.7, 71)
            spikeLen% = INT(lengthP% * (0.2 + 0.8 * colN! * colN!) * tBoost!)
            IF spikeLen% < 2 THEN _CONTINUE

            FOR d% = 1 TO spikeLen%
                ny& = iy& + d%
                IF ny& >= icH& THEN EXIT FOR
                _MEMGET srcM, srcM.OFFSET + (ny& * icW& + ix&) * 4 + 3, tgtA~%%
                IF tgtA~%% <> 0 THEN EXIT FOR             ' hit shape below — stop
                t! = d% / spikeLen%                        ' 0 at root, 1 at tip
                ' glassy: brighter, more transparent toward the tip
                glint! = 0.7 + 0.3 * IMGADJ_valnoise!(ix& * 0.9, ny& * 0.5, 72)
                icR% = INT((180 + 40 * t!) * glint!) : IF icR% > 255 THEN icR% = 255
                icG% = INT((215 + 30 * t!) * glint!) : IF icG% > 255 THEN icG% = 255
                icB% = INT((238 + 17 * t!) * glint!) : IF icB% > 255 THEN icB% = 255
                icA% = INT((235 - 150 * t!) * tBoost!)
                IF icA% < 20 THEN icA% = 20
                IF icA% > 255 THEN icA% = 255
                _MEMPUT resM, resM.OFFSET + (ny& * icW& + ix&) * 4, _RGBA32(icR%, icG%, icB%, icA%) AS _UNSIGNED LONG
            NEXT d%
        NEXT ix&
    NEXT iy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_icicles& = result&
END FUNCTION


''
' Open a modal Icicles dialog: LENGTH (4..40) + THICKNESS (0..100). Adds pixels
' -> apply_spatial.
'
SUB IMAGE_ADJ_icicles_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM lengthP   AS INTEGER : lengthP%   = 16
    DIM thickness AS INTEGER : thickness% = 60
    DIM oLength AS INTEGER, oThick AS INTEGER

    DIM k AS LONG
    DIM d_lengthP AS INTEGER : d_lengthP% = 16
    DIM d_thickness AS INTEGER : d_thickness% = 60
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oLength% = lengthP% : oThick% = thickness%
        lengthP%   = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, lengthP%, 4, 250)
        lengthP%   = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, lengthP%, 4, 250)
        thickness% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, thickness%, 0, 100)
        thickness% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, thickness%, 0, 100)
        IF lengthP% <> oLength% OR thickness% <> oThick% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, lengthP%, thickness%, d_lengthP%, d_thickness%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_icicles&(IMGADJ_fx_src&(ctx), lengthP%, thickness%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "ICICLES"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "LENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, lengthP%, 4, 250, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "THICKNESS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, thickness%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM icTargets(1 TO MAX_LAYERS) AS INTEGER, icTgtCount AS INTEGER, icT AS INTEGER
        DIM icSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets icTargets%(), icTgtCount%
        icSaveCL% = CURRENT_LAYER%
        IF icTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        FOR icT% = 1 TO icTgtCount%
            CURRENT_LAYER% = icTargets%(icT%)
            DIM icEdge AS LONG
            icEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF icEdge& < -1 THEN
                adjR& = IMAGE_ADJ_icicles&(icEdge&, lengthP%, thickness%)
                IMAGE_ADJ_apply_spatial_edge adjR&, icEdge&, "Icicles"
                SAFE_FREEIMAGE icEdge&
            ELSE
                adjR& = IMAGE_ADJ_icicles&(LAYERS(CURRENT_LAYER%).imgHandle&, lengthP%, thickness%)
                IMAGE_ADJ_apply_spatial adjR&, "Icicles"
            END IF
        NEXT icT%
        IF icTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = icSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Smoke (Eye Candy "Shape") — a wispy translucent plume rising off the top edge.
' Same top-scan as Fire, but the density is noise-dominated (so it breaks into
' wisps), reaches higher, mapped to a cool dark->light grey ramp at low alpha.
' Adds pixels above the shape -> apply_spatial.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param heightP   INTEGER  Plume reach in px (4..64)
' @param density   INTEGER  Opacity/thickness 0..100
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_smoke& (sourceImg AS LONG, heightP AS INTEGER, density AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_smoke& = 0 : EXIT FUNCTION

    DIM smW AS LONG, smH AS LONG
    smW& = _WIDTH(sourceImg&) : smH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM dBoost AS SINGLE : dBoost! = 0.4 + density% / 100.0
    DIM mx AS LONG, my AS LONG, d AS INTEGER, belowA AS _UNSIGNED _BYTE, aHere AS _UNSIGNED _BYTE
    DIM distDn AS INTEGER, dens AS SINGLE, nz AS SINGLE, g AS INTEGER, ca AS INTEGER
    FOR my& = 0 TO smH& - 1
    IF (my& AND 15) = 0 THEN IMGADJ_progress_tick "Smoke", my& / smH&
        FOR mx& = 0 TO smW& - 1
            _MEMGET srcM, srcM.OFFSET + (my& * smW& + mx&) * 4 + 3, aHere~%%
            IF aHere~%% <> 0 THEN _CONTINUE
            distDn% = 0
            FOR d% = 1 TO heightP%
                IF my& + d% >= smH& THEN EXIT FOR
                _MEMGET srcM, srcM.OFFSET + ((my& + d%) * smW& + mx&) * 4 + 3, belowA~%%
                IF belowA~%% <> 0 THEN distDn% = d% : EXIT FOR
            NEXT d%
            IF distDn% = 0 THEN _CONTINUE

            ' cooling with height, but noise-DOMINATED so it fractures into wisps
            dens! = 1.0 - (distDn% - 1) / heightP%
            nz! = IMGADJ_valnoise!(mx& * 0.14, my& * 0.07, 61) * 0.5 _
                + IMGADJ_valnoise!(mx& * 0.33, my& * 0.16, 62) * 0.3 _
                + IMGADJ_valnoise!(mx& * 0.7, my& * 0.35, 63) * 0.2
            dens! = dens! * nz! * nz! * dBoost! * 1.6      ' nz^2 -> gappy wisps
            IF dens! <= 0.04 THEN _CONTINUE
            IF dens! > 1.0 THEN dens! = 1.0

            ' cool grey ramp, slightly bluish
            g% = 60 + INT(120 * dens!)
            ca% = INT(dens! * 150)                          ' translucent
            IF ca% > 200 THEN ca% = 200
            _MEMPUT resM, resM.OFFSET + (my& * smW& + mx&) * 4, _RGBA32(g%, g%, g% + 6, ca%) AS _UNSIGNED LONG
        NEXT mx&
    NEXT my&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_smoke& = result&
END FUNCTION


''
' Open a modal Smoke dialog: HEIGHT (4..64) + DENSITY (0..100). Adds pixels ->
' apply_spatial.
'
SUB IMAGE_ADJ_smoke_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM heightP AS INTEGER : heightP% = 32
    DIM density AS INTEGER : density% = 55
    DIM oHeight AS INTEGER, oDensity AS INTEGER

    DIM k AS LONG
    DIM d_heightP AS INTEGER : d_heightP% = 32
    DIM d_density AS INTEGER : d_density% = 55
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oHeight% = heightP% : oDensity% = density%
        heightP% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, heightP%, 4, 200)
        heightP% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, heightP%, 4, 200)
        density% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, density%, 0, 100)
        density% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, density%, 0, 100)
        IF heightP% <> oHeight% OR density% <> oDensity% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, heightP%, density%, d_heightP%, d_density%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_smoke&(IMGADJ_fx_src&(ctx), heightP%, density%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "SMOKE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "HEIGHT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, heightP%, 4, 200, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "DENSITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, density%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM smTargets(1 TO MAX_LAYERS) AS INTEGER, smTgtCount AS INTEGER, smT AS INTEGER
        DIM smSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets smTargets%(), smTgtCount%
        smSaveCL% = CURRENT_LAYER%
        IF smTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        FOR smT% = 1 TO smTgtCount%
            CURRENT_LAYER% = smTargets%(smT%)
            DIM smEdge AS LONG
            smEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF smEdge& < -1 THEN
                adjR& = IMAGE_ADJ_smoke&(smEdge&, heightP%, density%)
                IMAGE_ADJ_apply_spatial_edge adjR&, smEdge&, "Smoke"
                SAFE_FREEIMAGE smEdge&
            ELSE
                adjR& = IMAGE_ADJ_smoke&(LAYERS(CURRENT_LAYER%).imgHandle&, heightP%, density%)
                IMAGE_ADJ_apply_spatial adjR&, "Smoke"
            END IF
        NEXT smT%
        IF smTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = smSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Fire (Eye Candy "Shape") — flames rising off the shape's top edge. For each
' TRANSPARENT pixel that has an opaque shape pixel within `height` px below it,
' a heat value is built from closeness-to-shape times an upward-flickering
' fractal noise, then mapped through a black->red->orange->yellow->white fire
' ramp with heat-proportional alpha. Adds pixels above the shape -> apply_spatial.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param heightP   INTEGER  Flame reach in px (4..48)
' @param intensity INTEGER  Heat boost 0..100
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_fire& (sourceImg AS LONG, heightP AS INTEGER, intensity AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_fire& = 0 : EXIT FUNCTION

    DIM fiW AS LONG, fiH AS LONG
    fiW& = _WIDTH(sourceImg&) : fiH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM iBoost AS SINGLE : iBoost! = 1.0 + intensity% / 100.0
    DIM fx AS LONG, fy AS LONG, d AS INTEGER, belowA AS _UNSIGNED _BYTE, aHere AS _UNSIGNED _BYTE
    DIM distDn AS INTEGER, heat AS SINGLE, nz AS SINGLE, cr AS INTEGER, cg AS INTEGER, cb AS INTEGER, ca AS INTEGER
    DIM t AS SINGLE
    FOR fy& = 0 TO fiH& - 1
    IF (fy& AND 15) = 0 THEN IMGADJ_progress_tick "Fire", fy& / fiH&
        FOR fx& = 0 TO fiW& - 1
            _MEMGET srcM, srcM.OFFSET + (fy& * fiW& + fx&) * 4 + 3, aHere~%%
            IF aHere~%% <> 0 THEN _CONTINUE                ' flames only fill empty space
            ' nearest opaque shape pixel directly below, within height
            distDn% = 0
            FOR d% = 1 TO heightP%
                IF fy& + d% >= fiH& THEN EXIT FOR
                _MEMGET srcM, srcM.OFFSET + ((fy& + d%) * fiW& + fx&) * 4 + 3, belowA~%%
                IF belowA~%% <> 0 THEN distDn% = d% : EXIT FOR
            NEXT d%
            IF distDn% = 0 THEN _CONTINUE                  ' nothing below to burn

            ' base heat: hottest at the shape, cooling upward
            heat! = 1.0 - (distDn% - 1) / heightP%
            ' upward-flickering fractal noise (y-scaled tighter so flames streak up)
            nz! = IMGADJ_valnoise!(fx& * 0.18, fy& * 0.09, 51) * 0.6 _
                + IMGADJ_valnoise!(fx& * 0.4, fy& * 0.2, 52) * 0.4
            heat! = heat! * (0.35 + 0.9 * nz!) * iBoost!
            IF heat! <= 0.06 THEN _CONTINUE
            IF heat! > 1.0 THEN heat! = 1.0

            ' fire ramp: dark-red -> red -> orange -> yellow -> white
            IF heat! < 0.25 THEN
                t! = heat! / 0.25
                cr% = INT(90 * t!) + 30 : cg% = 0 : cb% = 0
            ELSEIF heat! < 0.5 THEN
                t! = (heat! - 0.25) / 0.25
                cr% = 120 + INT(135 * t!) : cg% = INT(60 * t!) : cb% = 0
            ELSEIF heat! < 0.75 THEN
                t! = (heat! - 0.5) / 0.25
                cr% = 255 : cg% = 60 + INT(160 * t!) : cb% = INT(30 * t!)
            ELSE
                t! = (heat! - 0.75) / 0.25
                cr% = 255 : cg% = 220 + INT(35 * t!) : cb% = 30 + INT(190 * t!)
            END IF
            ca% = INT(heat! * 235)
            IF ca% > 255 THEN ca% = 255
            _MEMPUT resM, resM.OFFSET + (fy& * fiW& + fx&) * 4, _RGBA32(cr%, cg%, cb%, ca%) AS _UNSIGNED LONG
        NEXT fx&
    NEXT fy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_fire& = result&
END FUNCTION


''
' Open a modal Fire dialog: HEIGHT (4..48) + INTENSITY (0..100). Adds pixels ->
' apply_spatial.
'
SUB IMAGE_ADJ_fire_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM heightP   AS INTEGER : heightP%   = 20
    DIM intensity AS INTEGER : intensity% = 50
    DIM oHeight AS INTEGER, oIntensity AS INTEGER

    DIM k AS LONG
    DIM d_heightP AS INTEGER : d_heightP% = 20
    DIM d_intensity AS INTEGER : d_intensity% = 50
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oHeight% = heightP% : oIntensity% = intensity%
        heightP%   = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, heightP%, 4, 200)
        heightP%   = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, heightP%, 4, 200)
        intensity% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, intensity%, 0, 100)
        intensity% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, intensity%, 0, 100)
        IF heightP% <> oHeight% OR intensity% <> oIntensity% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, heightP%, intensity%, d_heightP%, d_intensity%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_fire&(IMGADJ_fx_src&(ctx), heightP%, intensity%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "FIRE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "HEIGHT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, heightP%, 4, 200, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "INTENSITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, intensity%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM fiTargets(1 TO MAX_LAYERS) AS INTEGER, fiTgtCount AS INTEGER, fiT AS INTEGER
        DIM fiSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets fiTargets%(), fiTgtCount%
        fiSaveCL% = CURRENT_LAYER%
        IF fiTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        DIM fiEdge AS LONG
        FOR fiT% = 1 TO fiTgtCount%
            CURRENT_LAYER% = fiTargets%(fiT%)
            fiEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF fiEdge& < -1 THEN
                adjR& = IMAGE_ADJ_fire&(fiEdge&, heightP%, intensity%)
                IMAGE_ADJ_apply_spatial_edge adjR&, fiEdge&, "Fire"
                SAFE_FREEIMAGE fiEdge&
            ELSE
                adjR& = IMAGE_ADJ_fire&(LAYERS(CURRENT_LAYER%).imgHandle&, heightP%, intensity%)
                IMAGE_ADJ_apply_spatial adjR&, "Fire"
            END IF
        NEXT fiT%
        IF fiTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = fiSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Snow (Eye Candy "Shape") — settle white snow on the shape's top-facing edges
' and (optionally) scatter falling flecks over the layer. A pixel gets snow if a
' TRANSPARENT pixel sits within `depth` px directly above it (i.e. it is near a
' top surface); whiteness falls off with distance from the edge and is broken up
' by hash noise so the cap looks granular. Flecks are sparse white dots placed by
' a deterministic hash. Alpha-changing (flecks add pixels) -> apply_spatial.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param depth     INTEGER  Snow-cap thickness in px (1..12)
' @param flecks    INTEGER  Falling-fleck density 0..100 (0 = none)
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_snow& (sourceImg AS LONG, depth AS INTEGER, flecks AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_snow& = 0 : EXIT FUNCTION

    DIM snW AS LONG, snH AS LONG
    snW& = _WIDTH(sourceImg&) : snH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM sx AS LONG, sy AS LONG, k AS INTEGER, upA AS _UNSIGNED _BYTE
    DIM aHere AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG
    DIM distTop AS INTEGER, snowAmt AS SINGLE, gran AS SINGLE
    DIM pr AS INTEGER, pg AS INTEGER, pb AS INTEGER, snR AS INTEGER, snG AS INTEGER, snB AS INTEGER
    FOR sy& = 0 TO snH& - 1
    IF (sy& AND 15) = 0 THEN IMGADJ_progress_tick "Snow", sy& / snH&
        FOR sx& = 0 TO snW& - 1
            _MEMGET srcM, srcM.OFFSET + (sy& * snW& + sx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE                 ' snow caps only sit on the shape
            ' nearest transparent pixel directly above, within depth
            distTop% = 0
            FOR k% = 1 TO depth%
                IF sy& - k% < 0 THEN distTop% = k% : EXIT FOR
                _MEMGET srcM, srcM.OFFSET + ((sy& - k%) * snW& + sx&) * 4 + 3, upA~%%
                IF upA~%% = 0 THEN distTop% = k% : EXIT FOR
            NEXT k%
            IF distTop% = 0 THEN _CONTINUE                 ' buried — no snow
            snowAmt! = 1.0 - (distTop% - 1) / depth%
            ' granular break-up so the cap edge is not a flat band
            gran! = IMGADJ_valnoise!(sx& * 0.6, sy& * 0.6, 21)
            snowAmt! = snowAmt! * (0.55 + 0.45 * gran!)
            IF snowAmt! < 0.0 THEN _CONTINUE
            IF snowAmt! > 1.0 THEN snowAmt! = 1.0
            _MEMGET srcM, srcM.OFFSET + (sy& * snW& + sx&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)
            snR% = pr% + INT((250 - pr%) * snowAmt!)
            snG% = pg% + INT((250 - pg%) * snowAmt!)
            snB% = pb% + INT((255 - pb%) * snowAmt!)
            _MEMPUT resM, resM.OFFSET + (sy& * snW& + sx&) * 4, _RGBA32(snR%, snG%, snB%, aHere~%%) AS _UNSIGNED LONG
        NEXT sx&
    NEXT sy&

    ' Falling flecks: sparse white dots by deterministic hash across the layer.
    IF flecks% > 0 THEN
        DIM fThresh AS SINGLE : fThresh! = flecks% / 100.0 * 0.06   ' cap density ~6%
        DIM hv AS SINGLE, fa AS INTEGER
        FOR sy& = 0 TO snH& - 1
            FOR sx& = 0 TO snW& - 1
                hv! = IMGADJ_valnoise!(sx& * 1.7 + 0.5, sy& * 1.7 + 0.5, 37)
                ' use a finer hash to get isolated specks, not blobs
                IF hv! > (1.0 - fThresh!) THEN
                    fa% = 190 + INT((hv! - (1.0 - fThresh!)) / (fThresh! + 0.0001) * 65)
                    IF fa% > 255 THEN fa% = 255
                    _MEMPUT resM, resM.OFFSET + (sy& * snW& + sx&) * 4, _RGBA32(255, 255, 255, fa%) AS _UNSIGNED LONG
                END IF
            NEXT sx&
        NEXT sy&
    END IF

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_snow& = result&
END FUNCTION


''
' Open a modal Snow dialog: DEPTH (1..12) + FLECKS (0..100). Adds pixels ->
' apply_spatial.
'
SUB IMAGE_ADJ_snow_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM depth  AS INTEGER : depth%  = 5
    DIM flecks AS INTEGER : flecks% = 30
    DIM oDepth AS INTEGER, oFlecks AS INTEGER

    DIM k AS LONG
    DIM d_depth AS INTEGER : d_depth% = 5
    DIM d_flecks AS INTEGER : d_flecks% = 30
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oDepth% = depth% : oFlecks% = flecks%
        depth%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, depth%, 1, 64)
        depth%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, depth%, 1, 64)
        flecks% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, flecks%, 0, 100)
        flecks% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, flecks%, 0, 100)
        IF depth% <> oDepth% OR flecks% <> oFlecks% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, depth%, flecks%, d_depth%, d_flecks%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_snow&(IMGADJ_fx_src&(ctx), depth%, flecks%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "SNOW"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "DEPTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, depth%, 1, 64, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "FLECKS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, flecks%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM snTargets(1 TO MAX_LAYERS) AS INTEGER, snTgtCount AS INTEGER, snT AS INTEGER
        DIM snSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets snTargets%(), snTgtCount%
        snSaveCL% = CURRENT_LAYER%
        IF snTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        FOR snT% = 1 TO snTgtCount%
            CURRENT_LAYER% = snTargets%(snT%)
            DIM snEdge AS LONG
            snEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF snEdge& < -1 THEN
                adjR& = IMAGE_ADJ_snow&(snEdge&, depth%, flecks%)
                IMAGE_ADJ_apply_spatial_edge adjR&, snEdge&, "Snow"
                SAFE_FREEIMAGE snEdge&
            ELSE
                adjR& = IMAGE_ADJ_snow&(LAYERS(CURRENT_LAYER%).imgHandle&, depth%, flecks%)
                IMAGE_ADJ_apply_spatial adjR&, "Snow"
            END IF
        NEXT snT%
        IF snTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = snSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Motion Trail (Eye Candy "Shape") — a speed-blur smear. Each opaque pixel of the
' shape is scattered along a direction as a fading run of copies IN ITS OWN COLOUR
' (not a flat silhouette like Long Shadow), then the crisp original is composited
' on top. The trail extends toward `angleDeg` (screen space, y-down; 180 = left,
' as if the shape were moving right). Alpha-changing -> apply_spatial.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param length    INTEGER  Trail length in px (2..40)
' @param angleDeg  INTEGER  Direction the trail extends, degrees (0..359)
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_motiontrail& (sourceImg AS LONG, length AS INTEGER, angleDeg AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_motiontrail& = 0 : EXIT FUNCTION

    DIM mtW AS LONG, mtH AS LONG
    mtW& = _WIDTH(sourceImg&) : mtH& = _HEIGHT(sourceImg&)

    DIM trail AS LONG
    trail& = _NEWIMAGE(mtW&, mtH&, 32)
    DIM oldDest AS LONG : oldDest& = _DEST
    _DEST trail& : _DONTBLEND trail& : CLS , _RGBA32(0, 0, 0, 0) : _DEST oldDest&

    DIM srcM AS _MEM, trM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    trM = _MEMIMAGE(trail&)

    DIM rad AS SINGLE : rad! = angleDeg% * 3.14159265 / 180.0
    DIM dxu AS SINGLE, dyu AS SINGLE
    dxu! = COS(rad!) : dyu! = SIN(rad!)

    DIM sx AS LONG, sy AS LONG, k AS INTEGER, tx AS LONG, ty AS LONG
    DIM aSrc AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG, aExist AS _UNSIGNED _BYTE
    DIM sr AS INTEGER, sg AS INTEGER, sb AS INTEGER
    DIM taper AS SINGLE, aOut AS INTEGER
    FOR sy& = 0 TO mtH& - 1
    IF (sy& AND 15) = 0 THEN IMGADJ_progress_tick "Motiontrail", sy& / mtH&
        FOR sx& = 0 TO mtW& - 1
            _MEMGET srcM, srcM.OFFSET + (sy& * mtW& + sx&) * 4 + 3, aSrc~%%
            IF aSrc~%% = 0 THEN _CONTINUE                 ' only smear opaque shape
            _MEMGET srcM, srcM.OFFSET + (sy& * mtW& + sx&) * 4, pix~&
            sr% = _RED32(pix~&) : sg% = _GREEN32(pix~&) : sb% = _BLUE32(pix~&)
            FOR k% = 1 TO length%
                tx& = sx& + INT(dxu! * k% + 0.5)
                ty& = sy& + INT(dyu! * k% + 0.5)
                IF tx& < 0 OR tx& >= mtW& OR ty& < 0 OR ty& >= mtH& THEN _CONTINUE
                taper! = (aSrc~%% / 255.0) * (length% - k%) / length%
                aOut% = INT(taper! * 180)                 ' cap trail at ~70% opacity
                IF aOut% <= 3 THEN _CONTINUE
                ' Keep the strongest (nearest) contribution at each trail pixel.
                _MEMGET trM, trM.OFFSET + (ty& * mtW& + tx&) * 4 + 3, aExist~%%
                IF aOut% > aExist~%% THEN
                    _MEMPUT trM, trM.OFFSET + (ty& * mtW& + tx&) * 4, _RGBA32(sr%, sg%, sb%, aOut%) AS _UNSIGNED LONG
                END IF
            NEXT k%
        NEXT sx&
    NEXT sy&
    _MEMFREE srcM
    _MEMFREE trM

    DIM result AS LONG
    result& = _COPYIMAGE(trail&, 32)
    oldDest& = _DEST
    _DEST result& : _BLEND result& : _PUTIMAGE , sourceImg&, result& : _DEST oldDest&
    SAFE_FREEIMAGE trail&

    IMAGE_ADJ_motiontrail& = result&
END FUNCTION


''
' Open a modal Motion Trail dialog: LENGTH (2..40) + DIRECTION (0..359 degrees).
' Alpha-changing -> apply_spatial.
'
SUB IMAGE_ADJ_motiontrail_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 138
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM length AS INTEGER : length% = 16
    DIM angle  AS INTEGER : angle%  = 180
    DIM oLength AS INTEGER, oAngle AS INTEGER

    DIM k AS LONG
    DIM d_length AS INTEGER : d_length% = 16
    DIM d_angle AS INTEGER : d_angle% = 180
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oLength% = length%
        oAngle%  = angle%
        length% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, length%, 2, 250)
        length% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, length%, 2, 250)
        angle%  = IMGDLG_angle_handle%(ctx, 1, angle%)
        IF length% <> oLength% OR angle% <> oAngle% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, length%, angle%, d_length%, d_angle%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_motiontrail&(IMGADJ_fx_src&(ctx), length%, angle%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "MOTION TRAIL"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "LENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, length%, 2, 250, "", ""
        IMGDLG_angle_draw ctx, 1, angle%, "DIRECTION:"
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM mtTargets(1 TO MAX_LAYERS) AS INTEGER, mtTgtCount AS INTEGER, mtT AS INTEGER
        DIM mtSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets mtTargets%(), mtTgtCount%
        mtSaveCL% = CURRENT_LAYER%
        IF mtTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG
        FOR mtT% = 1 TO mtTgtCount%
            CURRENT_LAYER% = mtTargets%(mtT%)
            DIM mtEdge AS LONG
            mtEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF mtEdge& < -1 THEN
                adjR& = IMAGE_ADJ_motiontrail&(mtEdge&, length%, angle%)
                IMAGE_ADJ_apply_spatial_edge adjR&, mtEdge&, "Motion Trail"
                SAFE_FREEIMAGE mtEdge&
            ELSE
                adjR& = IMAGE_ADJ_motiontrail&(LAYERS(CURRENT_LAYER%).imgHandle&, length%, angle%)
                IMAGE_ADJ_apply_spatial adjR&, "Motion Trail"
            END IF
        NEXT mtT%
        IF mtTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = mtSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Rust (Eye Candy "Shape") — corrode the shape with a fractal-noise oxide overlay
' masked to its own alpha. AMOUNT sets coverage (how much of the surface rusts);
' SCALE sets the blotch size. Corroded pixels blend toward a 3-stop rust ramp
' (dark brown -> orange -> light oxide) chosen by a second noise. Alpha is
' unchanged (stays inside the shape) -> apply_to_layer.
'
' @param sourceImg LONG     Source image (32-bit, with alpha)
' @param amount    INTEGER  Corrosion coverage 0..100
' @param scaleP    INTEGER  Blotch scale in px 4..48
' @return LONG              New 32-bit image handle (0 on failure)
'
FUNCTION IMAGE_ADJ_rust& (sourceImg AS LONG, amount AS INTEGER, scaleP AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_rust& = 0 : EXIT FUNCTION

    DIM rW AS LONG, rH AS LONG
    rW& = _WIDTH(sourceImg&) : rH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM thr AS SINGLE : thr! = 1.0 - (amount% / 100.0) * 0.9   ' more amount -> lower threshold
    DIM invScale AS SINGLE : invScale! = 1.0 / scaleP%

    DIM rx AS LONG, ry AS LONG, aHere AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG
    DIM nv AS SINGLE, amp AS SINGLE, fr AS SINGLE, oct AS INTEGER, cv AS SINGLE
    DIM rustAmt AS SINGLE, mix AS SINGLE
    DIM pr AS INTEGER, pg AS INTEGER, pb AS INTEGER
    DIM tr AS INTEGER, tg AS INTEGER, tb AS INTEGER, outR AS INTEGER, outG AS INTEGER, outB AS INTEGER
    FOR ry& = 0 TO rH& - 1
    IF (ry& AND 15) = 0 THEN IMGADJ_progress_tick "Rust", ry& / rH&
        FOR rx& = 0 TO rW& - 1
            _MEMGET srcM, srcM.OFFSET + (ry& * rW& + rx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE                     ' only rust the shape

            ' 3-octave fractal oxide field
            nv! = 0.0 : amp! = 0.6 : fr! = invScale!
            FOR oct% = 0 TO 2
                nv! = nv! + IMGADJ_valnoise!(rx& * fr!, ry& * fr!, oct% + 7) * amp!
                fr! = fr! * 2.0 : amp! = amp! * 0.5
            NEXT oct%
            IF nv! <= thr! THEN _CONTINUE                       ' bare metal here
            rustAmt! = (nv! - thr!) / (1.0 - thr! + 0.0001)
            IF rustAmt! > 1.0 THEN rustAmt! = 1.0

            ' Pick a rust tone from a second (finer) noise: dark->orange->light
            cv! = IMGADJ_valnoise!(rx& * invScale! * 2.7, ry& * invScale! * 2.7, 13)
            IF cv! < 0.5 THEN
                mix! = cv! / 0.5
                tr% = 70 + INT((150 - 70) * mix!)
                tg% = 32 + INT((70 - 32) * mix!)
                tb% = 14 + INT((22 - 14) * mix!)
            ELSE
                mix! = (cv! - 0.5) / 0.5
                tr% = 150 + INT((196 - 150) * mix!)
                tg% = 70 + INT((116 - 70) * mix!)
                tb% = 22 + INT((66 - 22) * mix!)
            END IF

            _MEMGET srcM, srcM.OFFSET + (ry& * rW& + rx&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)
            ' Blend original toward oxide by rustAmt (clamped to keep some base metal)
            IF rustAmt! > 0.9 THEN rustAmt! = 0.9
            outR% = pr% + INT((tr% - pr%) * rustAmt!)
            outG% = pg% + INT((tg% - pg%) * rustAmt!)
            outB% = pb% + INT((tb% - pb%) * rustAmt!)
            _MEMPUT resM, resM.OFFSET + (ry& * rW& + rx&) * 4, _RGBA32(outR%, outG%, outB%, aHere~%%) AS _UNSIGNED LONG
        NEXT rx&
    NEXT ry&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_rust& = result&
END FUNCTION


''
' Open a modal Rust dialog: AMOUNT (0..100) + SCALE (4..48). RGB-only (stays
' inside the shape) -> apply_to_layer.
'
SUB IMAGE_ADJ_rust_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 176
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM amount AS INTEGER : amount% = 60
    DIM scaleP AS INTEGER : scaleP% = 12
    DIM texMix AS INTEGER : texMix% = 100
    DIM dAmount AS INTEGER : dAmount% = 60
    DIM dScale AS INTEGER : dScale% = 12
    DIM dMix AS INTEGER : dMix% = 100
    DIM oAmount AS INTEGER, oScale AS INTEGER, oMix AS INTEGER
    DIM texFx AS LONG

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oAmount% = amount% : oScale% = scaleP% : oMix% = texMix%
        amount% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, 0, 100)
        amount% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, 0, 100)
        scaleP% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, scaleP%, 4, 200)
        scaleP% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, scaleP%, 4, 200)
        texMix% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, texMix%, 0, 100)
        texMix% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, texMix%, 0, 100)
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset3 ctx, amount%, scaleP%, texMix%, dAmount%, dScale%, dMix%
        IF amount% <> oAmount% OR scaleP% <> oScale% OR texMix% <> oMix% THEN ctx.previewDirty% = TRUE

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            texFx& = IMAGE_ADJ_rust&(ctx.origThumb, amount%, scaleP%)
            ctx.previewThumb = IMAGE_ADJ_mix_result&(ctx.origThumb, texFx&, texMix%)
            SAFE_FREEIMAGE texFx&
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "RUST"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "AMOUNT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, amount%, 0, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "SCALE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, scaleP%, 4, 200, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 2), "MIX:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, texMix%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM rTargets(1 TO MAX_LAYERS) AS INTEGER, rTgtCount AS INTEGER, rT AS INTEGER
        DIM rSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets rTargets%(), rTgtCount%
        rSaveCL% = CURRENT_LAYER%
        IF rTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG, adjMix AS LONG
        FOR rT% = 1 TO rTgtCount%
            CURRENT_LAYER% = rTargets%(rT%)
            adjR&          = IMAGE_ADJ_rust&(LAYERS(CURRENT_LAYER%).imgHandle&, amount%, scaleP%)
            adjMix&        = IMAGE_ADJ_mix_result&(LAYERS(CURRENT_LAYER%).imgHandle&, adjR&, texMix%)
            SAFE_FREEIMAGE adjR&
            IMAGE_ADJ_apply_to_layer adjMix&, "Rust"
        NEXT rT%
        IF rTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = rSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Drop Shadow (flat) — build a silhouette of the shape from its alpha, offset it
' by `offset` px down-right in shColor, softened by a `softness` box blur, and
' composite the original back on top. The layer must have transparency around the
' shape (apply_spatial keeps the new alpha).
'
' @param sourceImg LONG           Source image (32-bit, with alpha)
' @param offset    INTEGER        Shadow offset in px (down-right), 1..20
' @param softness  INTEGER        Blur radius for the shadow, 0..8
' @param shColor   _UNSIGNED LONG Shadow colour (opacity is taken from source alpha)
' @return LONG  New composited image handle
'
FUNCTION IMAGE_ADJ_dropshadow& (sourceImg AS LONG, distance AS INTEGER, softness AS INTEGER, angleDeg AS INTEGER, opacity AS INTEGER, shColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_dropshadow& = 0 : EXIT FUNCTION

    DIM dsW AS LONG, dsH AS LONG
    dsW& = _WIDTH(sourceImg&) : dsH& = _HEIGHT(sourceImg&)

    ' Offset vector from angle (0=right, 90=top, 315=down-right default) x distance.
    DIM dsRad AS SINGLE : dsRad! = angleDeg% * 3.14159265 / 180.0
    DIM ofx AS INTEGER, ofy AS INTEGER
    ofx% = CINT(COS(dsRad!) * distance%)
    ofy% = CINT(-SIN(dsRad!) * distance%)
    DIM opScale AS SINGLE : opScale! = opacity% / 100.0

    ' --- build the offset silhouette in shColor ---
    DIM shadow AS LONG
    shadow& = _NEWIMAGE(dsW&, dsH&, 32)
    DIM oldDest AS LONG : oldDest& = _DEST
    _DEST shadow& : _DONTBLEND shadow& : CLS , _RGBA32(0, 0, 0, 0) : _DEST oldDest&

    DIM srcM AS _MEM, shM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    shM = _MEMIMAGE(shadow&)
    DIM shR AS INTEGER, shG AS INTEGER, shB AS INTEGER
    shR% = _RED32(shColor~&) : shG% = _GREEN32(shColor~&) : shB% = _BLUE32(shColor~&)

    DIM sx AS LONG, sy AS LONG, tx AS LONG, ty AS LONG
    DIM sA AS _UNSIGNED _BYTE, shA AS INTEGER
    FOR sy& = 0 TO dsH& - 1
    IF (sy& AND 15) = 0 THEN IMGADJ_progress_tick "Dropshadow", sy& / dsH&
        ty& = sy& + ofy%
        IF ty& >= 0 AND ty& < dsH& THEN
            FOR sx& = 0 TO dsW& - 1
                _MEMGET srcM, srcM.OFFSET + (sy& * dsW& + sx&) * 4 + 3, sA~%%
                IF sA~%% <> 0 THEN
                    tx& = sx& + ofx%
                    IF tx& >= 0 AND tx& < dsW& THEN
                        shA% = INT(sA~%% * opScale!) : IF shA% > 255 THEN shA% = 255
                        _MEMPUT shM, shM.OFFSET + (ty& * dsW& + tx&) * 4, _RGBA32(shR%, shG%, shB%, shA%) AS _UNSIGNED LONG
                    END IF
                END IF
            NEXT sx&
        END IF
    NEXT sy&
    _MEMFREE srcM
    _MEMFREE shM

    ' --- soften ---
    IF softness% > 0 THEN
        DIM softened AS LONG
        softened& = IMAGE_ADJ_blur_premul_rgba&(shadow&, softness%)
        IF softened& < -1 THEN SAFE_FREEIMAGE shadow& : shadow& = softened&
    END IF

    ' --- composite original over shadow ---
    DIM result AS LONG
    result& = _COPYIMAGE(shadow&, 32)
    oldDest& = _DEST
    _DEST result& : _BLEND result& : _PUTIMAGE , sourceImg&, result& : _DEST oldDest&
    SAFE_FREEIMAGE shadow&

    IMAGE_ADJ_dropshadow& = result&
END FUNCTION


''
' Open a modal Drop Shadow dialog: OFFSET (1..20) + SOFTNESS (0..8) sliders.
' Shadow colour is the current BG colour. Alpha-changing -> apply_spatial.
'
SUB IMAGE_ADJ_dropshadow_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 216
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM distance AS INTEGER : distance% = 6
    DIM soft     AS INTEGER : soft%     = 2
    DIM angle    AS INTEGER : angle%    = 315
    DIM opac     AS INTEGER : opac%     = 75
    DIM dDist AS INTEGER : dDist% = 6
    DIM dSoft AS INTEGER : dSoft% = 2
    DIM dAngle AS INTEGER : dAngle% = 315
    DIM dOpac AS INTEGER : dOpac% = 75
    DIM oDist AS INTEGER, oSoft AS INTEGER, oAngle AS INTEGER, oOpac AS INTEGER

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oDist% = distance% : oSoft% = soft% : oAngle% = angle% : oOpac% = opac%
        distance% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, distance%, 0, 200)
        distance% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, distance%, 0, 200)
        angle%    = IMGDLG_angle_handle%(ctx, 1, angle%)
        soft%     = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, soft%, 0, 100)
        soft%     = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, soft%, 0, 100)
        opac%     = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, 14, opac%, 0, 100)
        opac%     = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, 14, opac%, 0, 100)
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset4 ctx, distance%, soft%, angle%, opac%, dDist%, dSoft%, dAngle%, dOpac%
        IF distance% <> oDist% OR soft% <> oSoft% OR angle% <> oAngle% OR opac% <> oOpac% THEN ctx.previewDirty% = TRUE

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_dropshadow&(IMGADJ_fx_src&(ctx), distance%, soft%, angle%, opac%, PAINT_BG_COLOR~&)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "DROP SHADOW"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "DISTANCE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, distance%, 0, 200, "", ""
        IMGDLG_angle_draw ctx, 1, angle%, "ANGLE:"
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 2), "SOFTNESS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, soft%, 0, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 3), "OPACITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, opac%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM shTargets(1 TO MAX_LAYERS) AS INTEGER, shTgtCount AS INTEGER, shT AS INTEGER
        DIM shSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets shTargets%(), shTgtCount%
        shSaveCL% = CURRENT_LAYER%
        IF shTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR shT% = 1 TO shTgtCount%
            CURRENT_LAYER% = shTargets%(shT%)
            DIM shEdge AS LONG
            shEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF shEdge& < -1 THEN
                adjR& = IMAGE_ADJ_dropshadow&(shEdge&, distance%, soft%, angle%, opac%, PAINT_BG_COLOR~&)
            ELSE
                adjR& = IMAGE_ADJ_dropshadow&(LAYERS(CURRENT_LAYER%).imgHandle&, distance%, soft%, angle%, opac%, PAINT_BG_COLOR~&)
            END IF
            IMAGE_ADJ_apply_spatial_edge adjR&, shEdge&, "Drop Shadow"
            IF shEdge& < -1 THEN SAFE_FREEIMAGE shEdge&
        NEXT shT%
        IF shTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = shSaveCL%
        IMGADJ_stash_fx distance%, soft%, angle%, opac%   ' enable instant Redo
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Duotone / Tritone — quantise luminance into flat colour bands (unlike the
' smooth Gradient Map). DUOTONE: 2 bands — shadows->loColor, highlights->hiColor.
' TRITONE: 3 bands — shadows->loColor, mids->the average of lo/hi, highlights->
' hiColor. The flat-ink poster / Game-Boy look. Same size; alpha preserved.
'
' @param sourceImg LONG           Source image (32-bit)
' @param loColor   _UNSIGNED LONG Shadow colour
' @param hiColor   _UNSIGNED LONG Highlight colour
' @param tritone   INTEGER        0 = 2 bands, 1 = 3 bands
' @return LONG  New duotone/tritone image handle
'
FUNCTION IMAGE_ADJ_duotone& (sourceImg AS LONG, loColor AS _UNSIGNED LONG, hiColor AS _UNSIGNED LONG, tritone AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_duotone& = 0 : EXIT FUNCTION

    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM midColor AS _UNSIGNED LONG
    midColor~& = _RGB32((_RED32(loColor~&) + _RED32(hiColor~&)) \ 2, (_GREEN32(loColor~&) + _GREEN32(hiColor~&)) \ 2, (_BLUE32(loColor~&) + _BLUE32(hiColor~&)) \ 2)

    DIM i AS LONG, px AS _UNSIGNED LONG, lumv AS INTEGER, outc AS _UNSIGNED LONG
    FOR i& = 0 TO srcM.SIZE - 4 STEP 4
        _MEMGET srcM, srcM.OFFSET + i&, px~&
        lumv% = (_RED32(px~&) * 30 + _GREEN32(px~&) * 59 + _BLUE32(px~&) * 11) \ 100
        IF tritone% THEN
            IF lumv% < 85 THEN
                outc~& = loColor~&
            ELSEIF lumv% < 170 THEN
                outc~& = midColor~&
            ELSE
                outc~& = hiColor~&
            END IF
        ELSE
            IF lumv% < 128 THEN outc~& = loColor~& ELSE outc~& = hiColor~&
        END IF
        _MEMPUT resM, resM.OFFSET + i&, outc~& AS _UNSIGNED LONG
    NEXT i&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_duotone& = result&
END FUNCTION


''
' Open a modal Duotone / Tritone dialog: TRITONE toggle. Ramp uses BG (shadows)
' -> FG (highlights); tritone adds their average as the midtone. Live loupe.
'
SUB IMAGE_ADJ_duotone_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 96
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    STATIC tritone AS INTEGER
    DIM dtLo AS _UNSIGNED LONG, dtHi AS _UNSIGNED LONG

    DIM tvX AS INTEGER, tvY AS INTEGER, tvW AS INTEGER, tvH AS INTEGER
    tvX% = IMGDLG_SX : tvW% = 150 : tvH% = 16
    tvY% = 24 + ctx.prevH + 6

    DIM k AS LONG
    DIM d_tritone AS INTEGER : d_tritone% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        IF DIALOG_hit%(ctx, tvX%, tvY%, tvW%, tvH%) THEN
            tritone%          = (tritone% = 0)
            ctx.previewDirty% = TRUE
        END IF
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, tritone%, d_tritone%

        IF ctx.previewDirty% THEN
            dtLo~& = PAINT_BG_COLOR~& : dtHi~& = PAINT_COLOR~&
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_duotone&(ctx.origThumb, dtLo~&, dtHi~&, tritone%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "DUOTONE / TRITONE"
        DIALOG_draw_preview ctx
        DIALOG_draw_toggle ctx, tvX%, tvY%, tvW%, tvH%, "TRITONE (3 BANDS)", tritone%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        dtLo~& = PAINT_BG_COLOR~& : dtHi~& = PAINT_COLOR~&
        DIM dtTargets(1 TO MAX_LAYERS) AS INTEGER, dtTgtCount AS INTEGER, dtT AS INTEGER
        DIM dtSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets dtTargets%(), dtTgtCount%
        dtSaveCL% = CURRENT_LAYER%
        IF dtTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR dtT% = 1 TO dtTgtCount%
            CURRENT_LAYER% = dtTargets%(dtT%)
            adjR&          = IMAGE_ADJ_duotone&(LAYERS(CURRENT_LAYER%).imgHandle&, dtLo~&, dtHi~&, tritone%)
            IMAGE_ADJ_apply_to_layer adjR&, "Duotone"
        NEXT dtT%
        IF dtTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = dtSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Solarize (Sabattier) — invert each colour channel that is above `threshold`,
' leaving darker channels alone. Produces the classic partially-inverted,
' psychedelic tone reversal. Same size; alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param threshold INTEGER Channel value above which to invert (0..255)
' @return LONG  New solarized image handle
'
FUNCTION IMAGE_ADJ_solarize& (sourceImg AS LONG, threshold AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_solarize& = 0 : EXIT FUNCTION

    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' precompute channel LUT
    DIM lut(0 TO 255) AS _UNSIGNED _BYTE, v AS INTEGER
    FOR v% = 0 TO 255
        IF v% > threshold% THEN lut(v%) = 255 - v% ELSE lut(v%) = v%
    NEXT v%

    DIM i AS LONG, px AS _UNSIGNED LONG
    FOR i& = 0 TO srcM.SIZE - 4 STEP 4
        _MEMGET srcM, srcM.OFFSET + i&, px~&
        _MEMPUT resM, resM.OFFSET + i&, _RGB32(lut(_RED32(px~&)), lut(_GREEN32(px~&)), lut(_BLUE32(px~&))) AS _UNSIGNED LONG
    NEXT i&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_solarize& = result&
END FUNCTION


''
' Open a modal Solarize dialog: single THRESHOLD slider (0..255). Live loupe.
'
SUB IMAGE_ADJ_solarize_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM thr  AS INTEGER : thr% = 128
    DIM oThr AS INTEGER

    DIM k AS LONG
    DIM d_thr AS INTEGER : d_thr% = 128
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oThr% = thr%
        thr% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, thr%, 0, 255)
        thr% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, thr%, 0, 255)
        IF thr% <> oThr% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, thr%, d_thr%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_solarize&(ctx.origThumb, thr%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "SOLARIZE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "THRESHOLD:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, thr%, 0, 255, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM soTargets(1 TO MAX_LAYERS) AS INTEGER, soTgtCount AS INTEGER, soT AS INTEGER
        DIM soSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets soTargets%(), soTgtCount%
        soSaveCL% = CURRENT_LAYER%
        IF soTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR soT% = 1 TO soTgtCount%
            CURRENT_LAYER% = soTargets%(soT%)
            adjR&          = IMAGE_ADJ_solarize&(LAYERS(CURRENT_LAYER%).imgHandle&, thr%)
            IMAGE_ADJ_apply_to_layer adjR&, "Solarize"
        NEXT soT%
        IF soTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = soSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Emboss — directional grey relief. Each pixel = 128 + strength * (luminance
' here minus luminance of the up-left neighbour), clamped. Flat areas go mid-grey
' (128), edges become light/dark ridges — a chiselled/bevel look. Same size;
' alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param strength  INTEGER Relief gain (1..10)
' @return LONG  New embossed image handle
'
FUNCTION IMAGE_ADJ_emboss& (sourceImg AS LONG, strength AS INTEGER, angleDeg AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_emboss& = 0 : EXIT FUNCTION

    DIM emW AS LONG, emH AS LONG
    emW& = _WIDTH(sourceImg&) : emH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' Light direction -> one of 8 neighbour offsets toward the light (angle 0=right,
    ' 90=top, 180=left, 270=bottom). Default 135 preserves the classic top-left relief.
    DIM emRad AS SINGLE : emRad! = angleDeg% * 3.14159265 / 180.0
    DIM lcx AS SINGLE, lcy AS SINGLE : lcx! = COS(emRad!) : lcy! = -SIN(emRad!)
    DIM odx AS INTEGER, ody AS INTEGER
    odx% = 0 : IF lcx! > 0.35 THEN odx% = 1 ELSE IF lcx! < -0.35 THEN odx% = -1
    ody% = 0 : IF lcy! > 0.35 THEN ody% = 1 ELSE IF lcy! < -0.35 THEN ody% = -1
    IF odx% = 0 AND ody% = 0 THEN ody% = -1

    REDIM lum(0 TO emW& * emH& - 1) AS INTEGER
    DIM i AS LONG, px AS _UNSIGNED LONG
    FOR i& = 0 TO emW& * emH& - 1
        _MEMGET srcM, srcM.OFFSET + i& * 4, px~&
        lum(i&) = (_RED32(px~&) * 30 + _GREEN32(px~&) * 59 + _BLUE32(px~&) * 11) \ 100
    NEXT i&

    DIM ex AS LONG, ey AS LONG, pxm AS LONG, pym AS LONG, dLum AS LONG, outv AS INTEGER
    FOR ey& = 0 TO emH& - 1
    IF (ey& AND 15) = 0 THEN IMGADJ_progress_tick "Emboss", ey& / emH&
        pym& = ey& + ody% : IF pym& < 0 THEN pym& = 0 ELSE IF pym& >= emH& THEN pym& = emH& - 1
        FOR ex& = 0 TO emW& - 1
            pxm& = ex& + odx% : IF pxm& < 0 THEN pxm& = 0 ELSE IF pxm& >= emW& THEN pxm& = emW& - 1
            dLum& = lum(ey& * emW& + ex&) - lum(pym& * emW& + pxm&)
            outv% = 128 + dLum& * strength%
            IF outv% < 0 THEN outv% = 0 ELSE IF outv% > 255 THEN outv% = 255
            _MEMPUT resM, resM.OFFSET + (ey& * emW& + ex&) * 4, _RGB32(outv%, outv%, outv%) AS _UNSIGNED LONG
        NEXT ex&
    NEXT ey&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_emboss& = result&
END FUNCTION


''
' Open a modal Emboss dialog: single STRENGTH slider (1..10). Live loupe; undo.
'
SUB IMAGE_ADJ_emboss_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 150
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM strength  AS INTEGER : strength% = 3
    DIM angle     AS INTEGER : angle%    = 135
    DIM dStrength AS INTEGER : dStrength% = 3
    DIM dAngle    AS INTEGER : dAngle%   = 135
    DIM oStrength AS INTEGER, oAngle AS INTEGER

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oStrength% = strength% : oAngle% = angle%
        strength% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, strength%, 1, 64)
        strength% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, strength%, 1, 64)
        angle%    = IMGDLG_angle_handle%(ctx, 1, angle%)
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, strength%, angle%, dStrength%, dAngle%
        IF strength% <> oStrength% OR angle% <> oAngle% THEN ctx.previewDirty% = TRUE

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_emboss&(IMGADJ_fx_src&(ctx), strength%, angle%)
            IMAGE_ADJ_fx_preview_finish ctx, 0
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "EMBOSS"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "STRENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, strength%, 1, 64, "", ""
        IMGDLG_angle_draw ctx, 1, angle%, "LIGHT ANGLE:"
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM emTargets(1 TO MAX_LAYERS) AS INTEGER, emTgtCount AS INTEGER, emT AS INTEGER
        DIM emSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets emTargets%(), emTgtCount%
        emSaveCL% = CURRENT_LAYER%
        IF emTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR emT% = 1 TO emTgtCount%
            CURRENT_LAYER% = emTargets%(emT%)
            DIM emEdge AS LONG
            emEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF emEdge& < -1 THEN
                adjR& = IMAGE_ADJ_emboss&(emEdge&, strength%, angle%)
                IMAGE_ADJ_apply_spatial_edge adjR&, emEdge&, "Emboss"
                SAFE_FREEIMAGE emEdge&
            ELSE
                adjR& = IMAGE_ADJ_emboss&(LAYERS(CURRENT_LAYER%).imgHandle&, strength%, angle%)
                IMAGE_ADJ_apply_to_layer adjR&, "Emboss"
            END IF
        NEXT emT%
        IF emTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = emSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Chromatic Aberration — split the R and B channels horizontally by `amount`
' pixels in opposite directions (G stays), producing cyan/red colour fringes at
' edges (retro lens / VHS look). Reads from the source so shifts don't cascade.
' Same size; alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param amount    INTEGER Horizontal channel offset in pixels (0..20)
' @return LONG  New fringed image handle
'
FUNCTION IMAGE_ADJ_chromatic& (sourceImg AS LONG, amount AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_chromatic& = 0 : EXIT FUNCTION

    DIM caW AS LONG, caH AS LONG
    caW& = _WIDTH(sourceImg&) : caH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM cx AS LONG, cy AS LONG, rxx AS LONG, bxx AS LONG
    DIM rPx AS _UNSIGNED LONG, gPx AS _UNSIGNED LONG, bPx AS _UNSIGNED LONG

    FOR cy& = 0 TO caH& - 1
    IF (cy& AND 15) = 0 THEN IMGADJ_progress_tick "Chromatic", cy& / caH&
        FOR cx& = 0 TO caW& - 1
            rxx& = cx& - amount% : IF rxx& < 0 THEN rxx& = 0 ELSE IF rxx& >= caW& THEN rxx& = caW& - 1
            bxx& = cx& + amount% : IF bxx& < 0 THEN bxx& = 0 ELSE IF bxx& >= caW& THEN bxx& = caW& - 1

            _MEMGET srcM, srcM.OFFSET + (cy& * caW& + rxx&) * 4, rPx~&
            _MEMGET srcM, srcM.OFFSET + (cy& * caW& + cx&) * 4, gPx~&
            _MEMGET srcM, srcM.OFFSET + (cy& * caW& + bxx&) * 4, bPx~&

            _MEMPUT resM, resM.OFFSET + (cy& * caW& + cx&) * 4, _RGB32(_RED32(rPx~&), _GREEN32(gPx~&), _BLUE32(bPx~&)) AS _UNSIGNED LONG
        NEXT cx&
    NEXT cy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_chromatic& = result&
END FUNCTION


''
' Open a modal Chromatic Aberration dialog: single AMOUNT slider (0..20 px).
' Live loupe preview; multi-layer + undo on OK.
'
SUB IMAGE_ADJ_chromatic_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM amount  AS INTEGER : amount% = 4
    DIM oAmount AS INTEGER

    DIM k AS LONG
    DIM d_amount AS INTEGER : d_amount% = 4
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oAmount% = amount%
        amount% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, 0, 100)
        amount% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, 0, 100)
        IF amount% <> oAmount% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, amount%, d_amount%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_chromatic&(ctx.origThumb, amount%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "CHROMATIC ABERRATION"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "AMOUNT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, amount%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM caTargets(1 TO MAX_LAYERS) AS INTEGER, caTgtCount AS INTEGER, caT AS INTEGER
        DIM caSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets caTargets%(), caTgtCount%
        caSaveCL% = CURRENT_LAYER%
        IF caTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR caT% = 1 TO caTgtCount%
            CURRENT_LAYER% = caTargets%(caT%)
            adjR&          = IMAGE_ADJ_chromatic&(LAYERS(CURRENT_LAYER%).imgHandle&, amount%)
            IMAGE_ADJ_apply_to_layer adjR&, "Chromatic Aberration"
        NEXT caT%
        IF caTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = caSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Grow / Shrink (Dilate / Erode) — morphological resize of the shape by its
' alpha. GROW: each transparent pixel within `amount` of an opaque pixel takes
' the colour of the nearest opaque pixel (fattens shapes, closes 1px gaps).
' SHRINK: each opaque pixel within `amount` of a transparent pixel (or the image
' border) becomes transparent (thins shapes, removes speckle). Alpha-changing, so
' commit via apply_spatial.
'
' @param sourceImg  LONG    Source image (32-bit)
' @param amount     INTEGER Pixels to grow/shrink (>=1)
' @param shrinkMode INTEGER 0 = grow (dilate), 1 = shrink (erode)
' @return LONG  New morphed image handle
'
FUNCTION IMAGE_ADJ_growshrink& (sourceImg AS LONG, amount AS INTEGER, shrinkMode AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_growshrink& = 0 : EXIT FUNCTION

    DIM gsW AS LONG, gsH AS LONG
    gsW& = _WIDTH(sourceImg&) : gsH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    IF amount% < 1 THEN amount% = 1

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM gx AS LONG, gy AS LONG, dx AS INTEGER, dy AS INTEGER
    DIM r2 AS INTEGER : r2% = amount% * amount%
    DIM selfA AS _UNSIGNED _BYTE, nbA AS _UNSIGNED _BYTE
    DIM nx AS LONG, ny AS LONG
    DIM baseOff AS _OFFSET
    DIM bestD AS INTEGER, bestOff AS _OFFSET, curD AS INTEGER, found AS INTEGER
    DIM nbPx AS _UNSIGNED LONG

    FOR gy& = 0 TO gsH& - 1
    IF (gy& AND 15) = 0 THEN IMGADJ_progress_tick "Growshrink", gy& / gsH&
        FOR gx& = 0 TO gsW& - 1
            baseOff = (gy& * gsW& + gx&) * 4
            _MEMGET srcM, srcM.OFFSET + baseOff + 3, selfA~%%

            IF shrinkMode% = 0 THEN
                ' GROW: only transparent pixels can be filled
                IF selfA~%% <> 0 THEN _CONTINUE
                found% = 0 : bestD% = 999999
                FOR dy% = -amount% TO amount%
                    ny& = gy& + dy%
                    IF ny& >= 0 AND ny& < gsH& THEN
                        FOR dx% = -amount% TO amount%
                            curD% = dx% * dx% + dy% * dy%
                            IF curD% <= r2% AND curD% < bestD% THEN
                                nx& = gx& + dx%
                                IF nx& >= 0 AND nx& < gsW& THEN
                                    _MEMGET srcM, srcM.OFFSET + (ny& * gsW& + nx&) * 4 + 3, nbA~%%
                                    IF nbA~%% <> 0 THEN
                                        bestD% = curD% : bestOff = (ny& * gsW& + nx&) * 4 : found% = 1
                                    END IF
                                END IF
                            END IF
                        NEXT dx%
                    END IF
                NEXT dy%
                IF found% THEN
                    _MEMGET srcM, srcM.OFFSET + bestOff, nbPx~&
                    _MEMPUT resM, resM.OFFSET + baseOff, nbPx~& AS _UNSIGNED LONG
                END IF
            ELSE
                ' SHRINK: only opaque pixels can be cleared
                IF selfA~%% = 0 THEN _CONTINUE
                found% = 0
                FOR dy% = -amount% TO amount%
                    ny& = gy& + dy%
                    FOR dx% = -amount% TO amount%
                        IF dx% * dx% + dy% * dy% <= r2% THEN
                            nx& = gx& + dx%
                            IF nx& < 0 OR nx& >= gsW& OR ny& < 0 OR ny& >= gsH& THEN
                                found% = 1 : EXIT FOR
                            END IF
                            _MEMGET srcM, srcM.OFFSET + (ny& * gsW& + nx&) * 4 + 3, nbA~%%
                            IF nbA~%% = 0 THEN found% = 1 : EXIT FOR
                        END IF
                    NEXT dx%
                    IF found% THEN EXIT FOR
                NEXT dy%
                IF found% THEN _MEMPUT resM, resM.OFFSET + baseOff, _RGBA32(0, 0, 0, 0) AS _UNSIGNED LONG
            END IF
        NEXT gx&
    NEXT gy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_growshrink& = result&
END FUNCTION


''
' Open a modal Grow / Shrink dialog: AMOUNT slider (1..8) + SHRINK toggle.
' Alpha-changing, commits via apply_spatial. Live loupe; multi-layer + undo.
'
SUB IMAGE_ADJ_growshrink_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 130
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM amount  AS INTEGER : amount% = 1
    DIM oAmount AS INTEGER
    STATIC shrinkMode AS INTEGER

    DIM ivX AS INTEGER, ivY AS INTEGER, ivW AS INTEGER, ivH AS INTEGER
    ivX% = IMGDLG_SX : ivW% = 120 : ivH% = 16
    ivY% = IMGDLG_track_y%(ctx, 0) + 24

    DIM k AS LONG
    DIM d_amount AS INTEGER : d_amount% = 1
    DIM d_shrinkMode AS INTEGER : d_shrinkMode% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oAmount% = amount%
        amount% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, 1, 32)
        amount% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, 1, 32)
        IF DIALOG_hit%(ctx, ivX%, ivY%, ivW%, ivH%) THEN
            shrinkMode%       = (shrinkMode% = 0)
            ctx.previewDirty% = TRUE
        END IF
        IF amount% <> oAmount% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, amount%, shrinkMode%, d_amount%, d_shrinkMode%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_growshrink&(IMGADJ_fx_src&(ctx), amount%, shrinkMode%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "GROW / SHRINK"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "AMOUNT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, amount%, 1, 32, "", ""
        DIALOG_draw_toggle ctx, ivX%, ivY%, ivW%, ivH%, "SHRINK", shrinkMode%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM gsTargets(1 TO MAX_LAYERS) AS INTEGER, gsTgtCount AS INTEGER, gsT AS INTEGER
        DIM gsSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets gsTargets%(), gsTgtCount%
        gsSaveCL% = CURRENT_LAYER%
        IF gsTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR gsT% = 1 TO gsTgtCount%
            CURRENT_LAYER% = gsTargets%(gsT%)
            DIM gsEdge AS LONG
            gsEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF gsEdge& < -1 THEN
                adjR& = IMAGE_ADJ_growshrink&(gsEdge&, amount%, shrinkMode%)
                IMAGE_ADJ_apply_spatial_edge adjR&, gsEdge&, "Grow / Shrink"
                SAFE_FREEIMAGE gsEdge&
            ELSE
                adjR& = IMAGE_ADJ_growshrink&(LAYERS(CURRENT_LAYER%).imgHandle&, amount%, shrinkMode%)
                IMAGE_ADJ_apply_spatial adjR&, "Grow / Shrink"
            END IF
        NEXT gsT%
        IF gsTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = gsSaveCL%
        IMGADJ_stash_fx amount%, shrinkMode%, 0, 0   ' enable instant Redo
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Outline / Stroke — add a coloured border along the shape's alpha edges.
' OUTSIDE mode (insideMode=0): paints transparent pixels within `thickness` of an
' opaque pixel — an outer stroke that grows the silhouette. INSIDE mode
' (insideMode=1): paints opaque pixels within `thickness` of a transparent pixel
' (or the image border) — an inner stroke that keeps the silhouette size.
' Alpha changes, so commit via IMAGE_ADJ_apply_spatial (NOT apply_to_layer).
'
' @param sourceImg  LONG           Source layer image (32-bit)
' @param thickness  INTEGER        Stroke width in pixels (>=1)
' @param olColor    _UNSIGNED LONG Stroke colour (opaque)
' @param insideMode INTEGER        0 = outside, 1 = inside
' @return LONG  New image handle with the stroke applied
'
FUNCTION IMAGE_ADJ_outline& (sourceImg AS LONG, thickness AS INTEGER, olColor AS _UNSIGNED LONG, insideMode AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_outline& = 0 : EXIT FUNCTION

    DIM olW AS LONG, olH AS LONG
    olW& = _WIDTH(sourceImg&) : olH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    IF thickness% < 1 THEN thickness% = 1

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM ox AS LONG, oy AS LONG, dx AS INTEGER, dy AS INTEGER
    DIM t2 AS INTEGER : t2% = thickness% * thickness%
    DIM selfA AS _UNSIGNED _BYTE, nbA AS _UNSIGNED _BYTE
    DIM hit AS INTEGER
    DIM nx AS LONG, ny AS LONG
    DIM baseOff AS _OFFSET

    FOR oy& = 0 TO olH& - 1
    IF (oy& AND 15) = 0 THEN IMGADJ_progress_tick "Outline", oy& / olH&
        FOR ox& = 0 TO olW& - 1
            baseOff = (oy& * olW& + ox&) * 4
            _MEMGET srcM, srcM.OFFSET + baseOff + 3, selfA~%%

            IF insideMode% = 0 THEN
                ' OUTSIDE: only transparent source pixels can become stroke
                IF selfA~%% <> 0 THEN _CONTINUE
            ELSE
                ' INSIDE: only opaque source pixels can become stroke
                IF selfA~%% = 0 THEN _CONTINUE
            END IF

            hit% = 0
            FOR dy% = -thickness% TO thickness%
                ny& = oy& + dy%
                FOR dx% = -thickness% TO thickness%
                    IF dx% * dx% + dy% * dy% <= t2% THEN
                        nx& = ox& + dx%
                        ' INSIDE: ANY image border (all 4 edges) counts as transparent
                        IF insideMode% = 1 AND (nx& < 0 OR nx& >= olW& OR ny& < 0 OR ny& >= olH&) THEN
                            hit% = 1 : EXIT FOR
                        END IF
                        IF nx& >= 0 AND nx& < olW& AND ny& >= 0 AND ny& < olH& THEN
                            _MEMGET srcM, srcM.OFFSET + (ny& * olW& + nx&) * 4 + 3, nbA~%%
                            IF insideMode% = 0 THEN
                                IF nbA~%% <> 0 THEN hit% = 1 : EXIT FOR
                            ELSE
                                IF nbA~%% = 0 THEN hit% = 1 : EXIT FOR
                            END IF
                        END IF
                    END IF
                NEXT dx%
                IF hit% THEN EXIT FOR
            NEXT dy%

            IF hit% THEN _MEMPUT resM, resM.OFFSET + baseOff, olColor~& AS _UNSIGNED LONG
        NEXT ox&
    NEXT oy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_outline& = result&
END FUNCTION


''
' Gradient Map — remap each pixel by its luminance along a two-colour ramp:
' luminance 0 -> loColor, 255 -> hiColor, linear between. Classic pixel-art
' recolour (e.g. dark-teal -> bright-yellow). Original alpha preserved
' (apply_to_layer). Uses the BG colour as the shadow end and FG as the highlight.
'
' @param sourceImg LONG           Source image (32-bit)
' @param loColor   _UNSIGNED LONG Colour mapped to luminance 0
' @param hiColor   _UNSIGNED LONG Colour mapped to luminance 255
' @return LONG  New recoloured image handle
'
FUNCTION IMAGE_ADJ_gradientmap& (sourceImg AS LONG, loColor AS _UNSIGNED LONG, hiColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_gradientmap& = 0 : EXIT FUNCTION

    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' --- precompute the 256-entry ramp ---
    DIM gmLoR AS INTEGER, gmLoG AS INTEGER, gmLoB AS INTEGER
    DIM gmHiR AS INTEGER, gmHiG AS INTEGER, gmHiB AS INTEGER
    gmLoR% = _RED32(loColor~&) : gmLoG% = _GREEN32(loColor~&) : gmLoB% = _BLUE32(loColor~&)
    gmHiR% = _RED32(hiColor~&) : gmHiG% = _GREEN32(hiColor~&) : gmHiB% = _BLUE32(hiColor~&)
    DIM rampR(0 TO 255) AS _UNSIGNED _BYTE, rampG(0 TO 255) AS _UNSIGNED _BYTE, rampB(0 TO 255) AS _UNSIGNED _BYTE
    DIM j AS INTEGER
    DIM tt AS SINGLE
    FOR j% = 0 TO 255
        tt! = j% / 255.0
        rampR(j%) = gmLoR% + INT((gmHiR% - gmLoR%) * tt!)
        rampG(j%) = gmLoG% + INT((gmHiG% - gmLoG%) * tt!)
        rampB(j%) = gmLoB% + INT((gmHiB% - gmLoB%) * tt!)
    NEXT j%

    DIM i AS LONG, px AS _UNSIGNED LONG, lumv AS INTEGER
    FOR i& = 0 TO srcM.SIZE - 4 STEP 4
        _MEMGET srcM, srcM.OFFSET + i&, px~&
        lumv% = (_RED32(px~&) * 30 + _GREEN32(px~&) * 59 + _BLUE32(px~&) * 11) \ 100
        _MEMPUT resM, resM.OFFSET + i&, _RGB32(rampR(lumv%), rampG(lumv%), rampB(lumv%)) AS _UNSIGNED LONG
    NEXT i&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_gradientmap& = result&
END FUNCTION


''
' Open a modal Gradient Map dialog. The ramp runs BG colour (shadows) -> FG
' colour (highlights); a SWAP toggle flips the two ends. Live loupe; undo on OK.
'
SUB IMAGE_ADJ_gradientmap_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 96
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    STATIC swapEnds AS INTEGER
    DIM gmLoC AS _UNSIGNED LONG, gmHiC AS _UNSIGNED LONG

    DIM svX AS INTEGER, svY AS INTEGER, svW AS INTEGER, svH AS INTEGER
    svX% = IMGDLG_SX : svW% = 160 : svH% = 16
    svY% = 24 + ctx.prevH + 6

    DIM k AS LONG
    DIM d_swapEnds AS INTEGER : d_swapEnds% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        IF DIALOG_hit%(ctx, svX%, svY%, svW%, svH%) THEN
            swapEnds%         = (swapEnds% = 0)
            ctx.previewDirty% = TRUE
        END IF
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, swapEnds%, d_swapEnds%

        IF ctx.previewDirty% THEN
            IF swapEnds% THEN
                gmLoC~& = PAINT_COLOR~& : gmHiC~& = PAINT_BG_COLOR~&
            ELSE
                gmLoC~& = PAINT_BG_COLOR~& : gmHiC~& = PAINT_COLOR~&
            END IF
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_gradientmap&(ctx.origThumb, gmLoC~&, gmHiC~&)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "GRADIENT MAP"
        DIALOG_draw_preview ctx
        DIALOG_draw_toggle ctx, svX%, svY%, svW%, svH%, "SWAP (BG->FG RAMP)", swapEnds%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        IF swapEnds% THEN
            gmLoC~& = PAINT_COLOR~& : gmHiC~& = PAINT_BG_COLOR~&
        ELSE
            gmLoC~& = PAINT_BG_COLOR~& : gmHiC~& = PAINT_COLOR~&
        END IF
        DIM gmTargets(1 TO MAX_LAYERS) AS INTEGER, gmTgtCount AS INTEGER, gmT AS INTEGER
        DIM gmSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets gmTargets%(), gmTgtCount%
        gmSaveCL% = CURRENT_LAYER%
        IF gmTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR gmT% = 1 TO gmTgtCount%
            CURRENT_LAYER% = gmTargets%(gmT%)
            adjR&          = IMAGE_ADJ_gradientmap&(LAYERS(CURRENT_LAYER%).imgHandle&, gmLoC~&, gmHiC~&)
            IMAGE_ADJ_apply_to_layer adjR&, "Gradient Map"
        NEXT gmT%
        IF gmTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = gmSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Edge Detect (Sobel) — luminance-gradient line art. Builds a luminance map,
' convolves the 3x3 Sobel Gx/Gy kernels, and writes the gradient magnitude as a
' greyscale image (flat areas -> black, edges -> white). STRENGTH scales the
' magnitude; INVERT gives dark lines on white. Same size; alpha preserved via
' apply_to_layer.
'
' @param sourceImg LONG    Source image (32-bit)
' @param strength  INTEGER Magnitude scale, percent (10..300)
' @param invert    INTEGER 0 = white edges on black, 1 = black edges on white
' @return LONG  New greyscale edge image handle
'
FUNCTION IMAGE_ADJ_edgedetect& (sourceImg AS LONG, strength AS INTEGER, invert AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_edgedetect& = 0 : EXIT FUNCTION

    DIM edW AS LONG, edH AS LONG
    edW& = _WIDTH(sourceImg&) : edH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' --- luminance map ---
    REDIM lum(0 TO edW& * edH& - 1) AS INTEGER
    DIM i AS LONG
    DIM px AS _UNSIGNED LONG
    FOR i& = 0 TO edW& * edH& - 1
        _MEMGET srcM, srcM.OFFSET + i& * 4, px~&
        lum(i&) = (_RED32(px~&) * 30 + _GREEN32(px~&) * 59 + _BLUE32(px~&) * 11) \ 100
    NEXT i&

    DIM ex AS LONG, ey AS LONG
    DIM xm AS LONG, xp AS LONG, ym AS LONG, yp AS LONG
    DIM tl AS LONG, tm AS LONG, tr AS LONG
    DIM ml AS LONG, mr AS LONG
    DIM bl AS LONG, bm AS LONG, br AS LONG
    DIM gx AS LONG, gy AS LONG, mag AS LONG, outv AS INTEGER
    DIM sf AS SINGLE : sf! = strength% / 100.0

    FOR ey& = 0 TO edH& - 1
    IF (ey& AND 15) = 0 THEN IMGADJ_progress_tick "Edgedetect", ey& / edH&
        ym& = ey& - 1 : IF ym& < 0 THEN ym& = 0
        yp& = ey& + 1 : IF yp& >= edH& THEN yp& = edH& - 1
        FOR ex& = 0 TO edW& - 1
            xm& = ex& - 1 : IF xm& < 0 THEN xm& = 0
            xp& = ex& + 1 : IF xp& >= edW& THEN xp& = edW& - 1

            tl& = lum(ym& * edW& + xm&) : tm& = lum(ym& * edW& + ex&) : tr& = lum(ym& * edW& + xp&)
            ml& = lum(ey& * edW& + xm&) : mr& = lum(ey& * edW& + xp&)
            bl& = lum(yp& * edW& + xm&) : bm& = lum(yp& * edW& + ex&) : br& = lum(yp& * edW& + xp&)

            gx& = (tr& + 2 * mr& + br&) - (tl& + 2 * ml& + bl&)
            gy& = (bl& + 2 * bm& + br&) - (tl& + 2 * tm& + tr&)
            mag& = INT(SQR(gx& * gx& + gy& * gy&) * sf!)
            IF mag& > 255 THEN mag& = 255
            outv% = mag&
            IF invert% THEN outv% = 255 - outv%

            _MEMPUT resM, resM.OFFSET + (ey& * edW& + ex&) * 4, _RGB32(outv%, outv%, outv%) AS _UNSIGNED LONG
        NEXT ex&
    NEXT ey&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_edgedetect& = result&
END FUNCTION


''
' Open a modal Edge Detect dialog: STRENGTH slider (10..300%) + INVERT toggle.
' Live loupe preview; multi-layer + undo on OK.
'
SUB IMAGE_ADJ_edgedetect_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 130
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM strength  AS INTEGER : strength% = 100
    DIM oStrength AS INTEGER
    STATIC invMode AS INTEGER

    DIM ivX AS INTEGER, ivY AS INTEGER, ivW AS INTEGER, ivH AS INTEGER
    ivX% = IMGDLG_SX : ivW% = 120 : ivH% = 16
    ivY% = IMGDLG_track_y%(ctx, 0) + 24

    DIM k AS LONG
    DIM d_strength AS INTEGER : d_strength% = 100
    DIM d_invMode AS INTEGER : d_invMode% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oStrength% = strength%
        strength%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, strength%, 10, 300)
        strength%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, strength%, 10, 300)
        IF DIALOG_hit%(ctx, ivX%, ivY%, ivW%, ivH%) THEN
            invMode%          = (invMode% = 0)
            ctx.previewDirty% = TRUE
        END IF
        IF strength% <> oStrength% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, strength%, invMode%, d_strength%, d_invMode%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_edgedetect&(ctx.origThumb, strength%, invMode%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "EDGE DETECT"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "STRENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, strength%, 10, 300, "", ""
        DIALOG_draw_toggle ctx, ivX%, ivY%, ivW%, ivH%, "INVERT", invMode%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM edTargets(1 TO MAX_LAYERS) AS INTEGER, edTgtCount AS INTEGER, edT AS INTEGER
        DIM edSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets edTargets%(), edTgtCount%
        edSaveCL% = CURRENT_LAYER%
        IF edTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR edT% = 1 TO edTgtCount%
            CURRENT_LAYER% = edTargets%(edT%)
            adjR&          = IMAGE_ADJ_edgedetect&(LAYERS(CURRENT_LAYER%).imgHandle&, strength%, invMode%)
            IMAGE_ADJ_apply_to_layer adjR&, "Edge Detect"
        NEXT edT%
        IF edTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = edSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Outline / Stroke dialog: THICKNESS slider (1..8) + INSIDE toggle.
' Uses the current foreground colour as the stroke colour. Alpha-changing, so it
' commits via apply_spatial. Live loupe preview; multi-layer + undo on OK.
'
SUB IMAGE_ADJ_outline_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 130
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM thick  AS INTEGER : thick% = 2
    DIM oThick AS INTEGER
    STATIC insideMode AS INTEGER

    DIM ivX AS INTEGER, ivY AS INTEGER, ivW AS INTEGER, ivH AS INTEGER
    ivX% = IMGDLG_SX : ivW% = 120 : ivH% = 16
    ivY% = IMGDLG_track_y%(ctx, 0) + 24

    DIM k AS LONG
    DIM d_thick AS INTEGER : d_thick% = 2
    DIM d_insideMode AS INTEGER : d_insideMode% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oThick% = thick%
        thick% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, thick%, 1, 32)
        thick% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, thick%, 1, 32)
        IF DIALOG_hit%(ctx, ivX%, ivY%, ivW%, ivH%) THEN
            insideMode% = (insideMode% = 0)
            ctx.previewDirty% = TRUE
        END IF
        IF thick% <> oThick% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, thick%, insideMode%, d_thick%, d_insideMode%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_outline&(IMGADJ_fx_src&(ctx), thick%, PAINT_COLOR~&, insideMode%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "OUTLINE / STROKE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "THICKNESS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, thick%, 1, 32, "", ""
        DIALOG_draw_toggle ctx, ivX%, ivY%, ivW%, ivH%, "INSIDE", insideMode%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM olTargets(1 TO MAX_LAYERS) AS INTEGER, olTgtCount AS INTEGER, olT AS INTEGER
        DIM olSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets olTargets%(), olTgtCount%
        olSaveCL% = CURRENT_LAYER%
        IF olTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR olT% = 1 TO olTgtCount%
            CURRENT_LAYER% = olTargets%(olT%)
            DIM olEdge AS LONG
            olEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF olEdge& < -1 THEN
                adjR& = IMAGE_ADJ_outline&(olEdge&, thick%, PAINT_COLOR~&, insideMode%)
                IMAGE_ADJ_apply_spatial_edge adjR&, olEdge&, "Outline"
                SAFE_FREEIMAGE olEdge&
            ELSE
                adjR& = IMAGE_ADJ_outline&(LAYERS(CURRENT_LAYER%).imgHandle&, thick%, PAINT_COLOR~&, insideMode%)
                IMAGE_ADJ_apply_spatial adjR&, "Outline"
            END IF
        NEXT olT%
        IF olTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = olSaveCL%
        IMGADJ_stash_fx thick%, insideMode%, 0, 0   ' enable instant Redo
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Direct op — invert all pixel colors on active layer.
'
SUB IMAGE_ADJ_invert ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB
    DIM iatTargets(1 TO MAX_LAYERS) AS INTEGER, iatTgtCount AS INTEGER, iatT AS INTEGER
    DIM iatSaveCL AS INTEGER
    IMAGE_ADJ_collect_targets iatTargets%(), iatTgtCount%
    IF iatTgtCount% = 0 THEN EXIT SUB
    iatSaveCL% = CURRENT_LAYER%
    IF iatTgtCount% > 1 THEN HISTORY_begin_group
    DIM adjR      AS LONG
    FOR iatT% = 1 TO iatTgtCount%
        CURRENT_LAYER% = iatTargets%(iatT%)
        adjR&          = GJ_IMGADJ_Invert(LAYERS(CURRENT_LAYER%).imgHandle&)
        IMAGE_ADJ_apply_to_layer adjR&, "Invert"
    NEXT iatT%
    IF iatTgtCount% > 1 THEN HISTORY_end_group
    CURRENT_LAYER% = iatSaveCL%
END SUB


''
' Direct op — desaturate active layer (luminance method).
'
SUB IMAGE_ADJ_desaturate ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB
    DIM iatTargets(1 TO MAX_LAYERS) AS INTEGER, iatTgtCount AS INTEGER, iatT AS INTEGER
    DIM iatSaveCL AS INTEGER
    IMAGE_ADJ_collect_targets iatTargets%(), iatTgtCount%
    IF iatTgtCount% = 0 THEN EXIT SUB
    iatSaveCL% = CURRENT_LAYER%
    IF iatTgtCount% > 1 THEN HISTORY_begin_group
    DIM adjR      AS LONG
    FOR iatT% = 1 TO iatTgtCount%
        CURRENT_LAYER% = iatTargets%(iatT%)
        adjR&          = GJ_IMGADJ_Desaturate(LAYERS(CURRENT_LAYER%).imgHandle&, GJ_IMGADJ_DESATURATE_LUMINANCE)
        IMAGE_ADJ_apply_to_layer adjR&, "Desaturate"
    NEXT iatT%
    IF iatTgtCount% > 1 THEN HISTORY_end_group
    CURRENT_LAYER% = iatSaveCL%
END SUB


''
' Direct op — apply a warm sepia tone to the active (and extra-selected) layers.
'
SUB IMAGE_ADJ_sepia ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB
    DIM iatTargets(1 TO MAX_LAYERS) AS INTEGER, iatTgtCount AS INTEGER, iatT AS INTEGER
    DIM iatSaveCL AS INTEGER
    IMAGE_ADJ_collect_targets iatTargets%(), iatTgtCount%
    IF iatTgtCount% = 0 THEN EXIT SUB
    iatSaveCL% = CURRENT_LAYER%
    IF iatTgtCount% > 1 THEN HISTORY_begin_group
    DIM adjR      AS LONG
    FOR iatT% = 1 TO iatTgtCount%
        CURRENT_LAYER% = iatTargets%(iatT%)
        adjR&          = GJ_IMGADJ_Sepia(LAYERS(CURRENT_LAYER%).imgHandle&)
        IMAGE_ADJ_apply_to_layer adjR&, "Sepia"
    NEXT iatT%
    IF iatTgtCount% > 1 THEN HISTORY_end_group
    CURRENT_LAYER% = iatSaveCL%
END SUB


' =============================================================================
' SHARED DIALOG HELPERS (internal)
' =============================================================================

''
' Draw OK and Cancel buttons at fixed bottom positions within the dialog.
' Renders two colored buttons side by side near the bottom of the dialog buffer.
'
' @param ctx DIALOG_CTX The dialog context containing dimensions and image handle
'
SUB IMGDLG_draw_ok_cancel (ctx AS DIALOG_CTX)
    DIM btnY AS INTEGER
    btnY% = ctx.h - IMGDLG_BTN_H - 8
    DIALOG_draw_button ctx, IMGDLG_OK_X, btnY%, IMGDLG_OK_W, IMGDLG_BTN_H, "OK", _RGB32(40, 100, 40), _RGB32(60, 150, 60), _RGB32(80, 200, 80)
    DIALOG_draw_button ctx, IMGDLG_RESET_X, btnY%, IMGDLG_RESET_W, IMGDLG_BTN_H, "RESET", _RGB32(70, 70, 90), _RGB32(100, 100, 130), _RGB32(140, 140, 180)
    DIALOG_draw_button ctx, IMGDLG_CX_X, btnY%, IMGDLG_CX_W, IMGDLG_BTN_H, "CANCEL", _RGB32(100, 40, 40), _RGB32(150, 60, 60), _RGB32(200, 80, 80)
END SUB

''
' Reset-to-default helpers. When the RESET button was clicked this frame
' (IMGDLG_RESET_CLICKED), restore each parameter to its captured default, mark the
' preview dirty, and consume the flag. One helper per parameter count (2/3/4).
'
SUB IMGDLG_reset2 (ctx AS DIALOG_CTX, p1 AS INTEGER, p2 AS INTEGER, d1 AS INTEGER, d2 AS INTEGER)
    IF NOT IMGDLG_RESET_CLICKED% THEN EXIT SUB
    p1% = d1% : p2% = d2%
    ctx.previewDirty% = TRUE
    IMGDLG_RESET_CLICKED% = FALSE
END SUB

SUB IMGDLG_reset3 (ctx AS DIALOG_CTX, p1 AS INTEGER, p2 AS INTEGER, p3 AS INTEGER, d1 AS INTEGER, d2 AS INTEGER, d3 AS INTEGER)
    IF NOT IMGDLG_RESET_CLICKED% THEN EXIT SUB
    p1% = d1% : p2% = d2% : p3% = d3%
    ctx.previewDirty% = TRUE
    IMGDLG_RESET_CLICKED% = FALSE
END SUB

SUB IMGDLG_reset4 (ctx AS DIALOG_CTX, p1 AS INTEGER, p2 AS INTEGER, p3 AS INTEGER, p4 AS INTEGER, d1 AS INTEGER, d2 AS INTEGER, d3 AS INTEGER, d4 AS INTEGER)
    IF NOT IMGDLG_RESET_CLICKED% THEN EXIT SUB
    p1% = d1% : p2% = d2% : p3% = d3% : p4% = d4%
    ctx.previewDirty% = TRUE
    IMGDLG_RESET_CLICKED% = FALSE
END SUB

SUB IMGDLG_reset1 (ctx AS DIALOG_CTX, p1 AS INTEGER, d1 AS INTEGER)
    IF NOT IMGDLG_RESET_CLICKED% THEN EXIT SUB
    p1% = d1%
    ctx.previewDirty% = TRUE
    IMGDLG_RESET_CLICKED% = FALSE
END SUB

''
' Check whether the user clicked the OK or Cancel button at the bottom of the dialog.
' Sets ctx.done% and ctx.result% accordingly (TRUE for OK, FALSE for Cancel).
'
' @param ctx DIALOG_CTX The dialog context to test for button hits and update state
'
SUB IMGDLG_check_ok_cancel (ctx AS DIALOG_CTX)
    DIM btnY AS INTEGER
    btnY% = ctx.h - IMGDLG_BTN_H - 8
    IF DIALOG_hit%(ctx, IMGDLG_OK_X, btnY%, IMGDLG_OK_W, IMGDLG_BTN_H) THEN
        ctx.done% = TRUE : ctx.result% = TRUE
    END IF
    IF DIALOG_hit%(ctx, IMGDLG_RESET_X, btnY%, IMGDLG_RESET_W, IMGDLG_BTN_H) THEN
        IMGDLG_RESET_CLICKED% = TRUE           ' consumed by IMGDLG_resetN in the dialog loop
    END IF
    IF DIALOG_hit%(ctx, IMGDLG_CX_X, btnY%, IMGDLG_CX_W, IMGDLG_BTN_H) THEN
        ctx.done% = TRUE : ctx.result% = FALSE
    END IF
END SUB

''
' Compute the Y position of a slider label for the given 0-based slider index.
' Accounts for ctx.prevH so labels sit below the loupe preview pane.
'
' @param ctx DIALOG_CTX The dialog context (provides preview height offset)
' @param idx INTEGER - Zero-based slider index (0 = first slider, 1 = second, etc.)
' @return INTEGER - Y coordinate in dialog-local pixels for the label
'
FUNCTION IMGDLG_label_y% (ctx AS DIALOG_CTX, idx AS INTEGER)
    IMGDLG_label_y% = 24 + ctx.prevH + idx * 38
END FUNCTION

''
' Compute the Y position of a slider track for the given 0-based slider index.
' Accounts for ctx.prevH so tracks sit below the loupe preview pane.
'
' @param ctx DIALOG_CTX The dialog context (provides preview height offset)
' @param idx INTEGER - Zero-based slider index (0 = first slider, 1 = second, etc.)
' @return INTEGER - Y coordinate in dialog-local pixels for the slider track
'
FUNCTION IMGDLG_track_y% (ctx AS DIALOG_CTX, idx AS INTEGER)
    IMGDLG_track_y% = 36 + ctx.prevH + idx * 38
END FUNCTION

''
' Angle-aware wheel over a slider region: steps 15 degrees per notch, or 1 degree
' with Shift held (fast/slow dialing), wrapping 0..359. Use for any degrees slider.
'
FUNCTION IMGDLG_angle_wheel% (ctx AS DIALOG_CTX, sx AS INTEGER, sy AS INTEGER, sw AS INTEGER, value AS INTEGER)
    DIM nv AS INTEGER : nv = value
    IF ctx.mwheel <> 0 THEN
        IF ctx.my >= sy - 20 AND ctx.my <= sy + 18 AND ctx.mx >= sx - 4 AND ctx.mx <= sx + sw + 4 THEN
            DIM stp AS INTEGER : stp = 15
            IF MODIFIERS.shift% THEN stp = 1
            nv = value - ctx.mwheel * stp
            DO WHILE nv < 0 : nv = nv + 360 : LOOP
            DO WHILE nv > 359 : nv = nv - 360 : LOOP
        END IF
    END IF
    IMGDLG_angle_wheel% = nv
END FUNCTION

''
' Draw a compact angle dial (circle + pointer + degree readout) at centre (dcx,dcy)
' radius dr in dialog-local pixels. Shows `value` degrees; 0 = east, CCW positive.
'
SUB IMGDLG_draw_dial (dcx AS INTEGER, dcy AS INTEGER, dr AS INTEGER, value AS INTEGER)
    DIM ra AS SINGLE : ra! = value% * 3.14159265 / 180.0
    CIRCLE (dcx%, dcy%), dr%, _RGB32(120, 120, 135)
    PAINT (dcx%, dcy%), _RGB32(38, 38, 46), _RGB32(120, 120, 135)
    ' cardinal ticks
    LINE (dcx% - dr%, dcy%)-(dcx% - dr% + 2, dcy%), _RGB32(80, 80, 95)
    LINE (dcx% + dr% - 2, dcy%)-(dcx% + dr%, dcy%), _RGB32(80, 80, 95)
    DIM px AS INTEGER, py AS INTEGER
    px% = dcx% + COS(ra!) * (dr% - 2) : py% = dcy% - SIN(ra!) * (dr% - 2)
    LINE (dcx%, dcy%)-(px%, py%), _RGB32(90, 170, 255)
    CIRCLE (px%, py%), 2, _RGB32(120, 200, 255)
END SUB

''
' Drag inside the dial to set the angle directly (0..359). Returns the new value.
'
FUNCTION IMGDLG_dial_drag% (ctx AS DIALOG_CTX, dcx AS INTEGER, dcy AS INTEGER, dr AS INTEGER, value AS INTEGER)
    DIM nv AS INTEGER : nv = value
    IF ctx.mb1 THEN
        DIM ddx AS INTEGER, ddy AS INTEGER
        ddx = ctx.mx - dcx : ddy = ctx.my - dcy
        IF ddx * ddx + ddy * ddy <= (dr + 4) * (dr + 4) THEN
            DIM a AS SINGLE : a! = _ATAN2(-ddy, ddx) * 180.0 / 3.14159265
            nv = INT(a! + 0.5)
            DO WHILE nv < 0 : nv = nv + 360 : LOOP
            DO WHILE nv > 359 : nv = nv - 360 : LOOP
        END IF
    END IF
    IMGDLG_dial_drag% = nv
END FUNCTION

''
' Combined angle control (INPUT phase): a shortened 0..359 slider plus a compact
' dial to its right, sharing one dialog row. Returns the value after slider drag,
' wheel step (15 / Shift 1), and dial drag. Pair with IMGDLG_angle_draw at the
' SAME rowN so the geometry lines up.
'
FUNCTION IMGDLG_angle_handle% (ctx AS DIALOG_CTX, rowN AS INTEGER, value AS INTEGER)
    DIM sy AS INTEGER : sy% = IMGDLG_track_y%(ctx, rowN%)
    DIM sw AS INTEGER : sw% = IMGDLG_SW - (2 * IMGDLG_ANGLE_DIAL_R + 8)
    DIM v AS INTEGER : v% = value%
    v% = DIALOG_slider_drag%(ctx, IMGDLG_SX, sy%, sw%, 14, v%, 0, 359)
    v% = IMGDLG_angle_wheel%(ctx, IMGDLG_SX, sy%, IMGDLG_SW, v%)
    v% = IMGDLG_dial_drag%(ctx, IMGDLG_SX + IMGDLG_SW - IMGDLG_ANGLE_DIAL_R - 1, sy% + 6, IMGDLG_ANGLE_DIAL_R, v%)
    IMGDLG_angle_handle% = v%
END FUNCTION

''
' Combined angle control (DRAW phase): label with a live degree readout, the
' shortened slider, and the dial. Call with the SAME rowN as IMGDLG_angle_handle.
'
SUB IMGDLG_angle_draw (ctx AS DIALOG_CTX, rowN AS INTEGER, value AS INTEGER, labelTxt AS STRING)
    DIM ly AS INTEGER : ly% = IMGDLG_label_y%(ctx, rowN%)
    DIM sy AS INTEGER : sy% = IMGDLG_track_y%(ctx, rowN%)
    DIM sw AS INTEGER : sw% = IMGDLG_SW - (2 * IMGDLG_ANGLE_DIAL_R + 8)
    DIALOG_draw_label ctx, IMGDLG_SX, ly%, labelTxt$ + " " + _TRIM$(STR$(value%)) + CHR$(248)
    DIALOG_draw_slider ctx, IMGDLG_SX, sy%, sw%, value%, 0, 359, "", ""
    IMGDLG_draw_dial IMGDLG_SX + IMGDLG_SW - IMGDLG_ANGLE_DIAL_R - 1, sy% + 6, IMGDLG_ANGLE_DIAL_R, value%
END SUB


' =============================================================================
' LIVE PREVIEW SETUP  (Loupe Mode)
' =============================================================================

''
' Expand dialog height by IMGDLG_PREV_H, re-centre, rebuild buffer.
' Sets loupeDirty=TRUE so IMAGE_ADJ_update_loupe captures the canvas region
' under the dialog on the very first loop iteration.
' Call immediately after DIALOG_init for any dialog that wants a loupe preview.
' @param ctx DIALOG_CTX Dialog context to expand with preview area
' @param layerImg LONG Layer image handle (reserved for API compatibility)
'
SUB IMAGE_ADJ_setup_preview (ctx AS DIALOG_CTX, layerImg AS LONG)
    layerImg& = layerImg&   ' API compat — loupe captures from canvas coords, not layer handle
    ctx.prevH = IMGDLG_PREV_H
    ctx.h = ctx.h + IMGDLG_PREV_H

    ' Re-centre vertically
    ctx.y = (SCRN.h& - ctx.h) \ 2
    IF ctx.y < 0               THEN ctx.y = 0
    IF ctx.y + ctx.h > SCRN.h& THEN ctx.y = SCRN.h& - ctx.h

    ' Rebuild dialog buffer at new height
    SAFE_FREEIMAGE ctx.imgHandle
    ctx.imgHandle = _NEWIMAGE(ctx.w, ctx.h, 32)

    ctx.splitX       = ctx.w \ 2
    ctx.loupeDirty   = TRUE ' capture loupe region on first frame
    ctx.previewDirty = TRUE
    IMGDLG_RESET_CLICKED% = FALSE ' never carry a stale RESET click into a new dialog
END SUB

''
' Blit a NATIVE 1:1 crop of a layer image into a destination thumb, clamped to
' the layer bounds so out-of-range crops just leave transparent margins (no
' stretching, no out-of-bounds reads). Canvas crop coords are converted to layer
' BUFFER coords via the per-layer apron offset (gotcha #14).
'
SUB IMGADJ_blit_native_crop (srcImg AS LONG, apW AS INTEGER, apH AS INTEGER, cropX0 AS LONG, cropY0 AS LONG, tw AS INTEGER, th AS INTEGER, destImg AS LONG)
    IF NOT (srcImg& < -1) THEN EXIT SUB
    DIM liw AS LONG, lih AS LONG
    liw& = _WIDTH(srcImg&) : lih& = _HEIGHT(srcImg&)
    DIM bx0 AS LONG, by0 AS LONG
    bx0& = cropX0& + apW% : by0& = cropY0& + apH%
    DIM sx0 AS LONG, sy0 AS LONG, sx1 AS LONG, sy1 AS LONG, dx0 AS LONG, dy0 AS LONG
    sx0& = bx0& : IF sx0& < 0 THEN sx0& = 0
    sy0& = by0& : IF sy0& < 0 THEN sy0& = 0
    sx1& = bx0& + tw - 1 : IF sx1& > liw& - 1 THEN sx1& = liw& - 1
    sy1& = by0& + th - 1 : IF sy1& > lih& - 1 THEN sy1& = lih& - 1
    IF sx1& < sx0& OR sy1& < sy0& THEN EXIT SUB         ' no overlap
    dx0& = sx0& - bx0& : dy0& = sy0& - by0&             ' dest offset in destImg
    _PUTIMAGE (dx0&, dy0&)-(dx0& + (sx1& - sx0&), dy0& + (sy1& - sy0&)), srcImg&, destImg&, (sx0&, sy0&)-(sx1&, sy1&)
END SUB

''
' Re-capture the layer pixels under the dialog preview area into ctx.origThumb.
' Captures at NATIVE (1:1) canvas resolution — NOT from the zoomed composite —
' so spatial effects (bricks, noise, rings, warps) preview at the exact same
' scale they apply at. Invalidates ctx.previewThumb and marks ctx.previewDirty.
' @param ctx DIALOG_CTX Dialog context with position and preview state
'
SUB IMAGE_ADJ_update_loupe (ctx AS DIALOG_CTX)
    IF CURRENT_LAYER% < 1 THEN ctx.loupeDirty = FALSE : EXIT SUB

    DIM winW AS INTEGER : winW = ctx.w - 2
    DIM winH AS INTEGER : winH = ctx.prevH
    ' Capture a PADDED window (winW+2P x winH+2P) so edge effects (glow/shadow/
    ' outline/bevel) see real neighbouring canvas pixels rather than treating the
    ' crop's rectangular border as the shape edge. Only the central winW x winH is
    ' displayed; DIALOG_draw_preview derives the pad from the size mismatch.
    DIM tw AS INTEGER : tw = winW + 2 * IMGADJ_LOUPE_PAD
    DIM th AS INTEGER : th = winH + 2 * IMGADJ_LOUPE_PAD

    ' NATIVE 1:1 capture of the canvas region UNDER the dialog's preview pane, so
    ' the loupe acts like a real magnifier window: drag the dialog and it reveals
    ' the pixels it now sits over. tw/th are logical pixels, which equal native
    ' canvas pixels at zoom 1 — so cropping tw x th native px and showing them 1:1
    ' makes the effect preview at exactly the scale it will apply at. (The old
    ' path cropped the ZOOMED composite SCRN.CANVAS&, which multiplied every
    ' spatial feature by the view zoom; the interim fix centred on the canvas,
    ' which ignored the dialog position entirely — the loupe never moved.)
    '
    ' Invert the canvas placement from SCREEN_render (OUTPUT/SCREEN.BM):
    '   dx = (SCRN.w - canvasW*zoom)\2 + offsetX + panelShiftX ; screenX = dx + cx*zoom
    ' The preview pane's top-left in SCREEN coords is (ctx.x+1, ctx.y+prevY).
    DIM loupeDX AS LONG, loupeDY AS LONG
    loupeDX& = (SCRN.w& - SCRN.canvasW& * SCRN.zoom!) \ 2 + SCRN.offsetX% + SCRN.panelShiftX%
    loupeDY& = (SCRN.h& - SCRN.canvasH& * SCRN.zoom!) \ 2 + SCRN.offsetY%
    DIM loupeScrX AS LONG, loupeScrY AS LONG
    loupeScrX& = ctx.x + 1
    loupeScrY& = ctx.y + THEME.DIALOG_title_height% + 2
    DIM cropX0 AS LONG, cropY0 AS LONG
    ' canvas coord of the WINDOW top-left, then step back by the pad for capture
    cropX0& = INT((loupeScrX& - loupeDX&) / SCRN.zoom!) - IMGADJ_LOUPE_PAD
    cropY0& = INT((loupeScrY& - loupeDY&) / SCRN.zoom!) - IMGADJ_LOUPE_PAD

    ' The loupe ALWAYS follows the dialog — a magnifier onto the canvas beneath it,
    ' updating as you drag it. A selection does NOT reposition it. The sel-as-shape
    ' silhouette below is built for whatever region the loupe currently sits over,
    ' so dragging the dialog over the selection reveals the effect radiating there.

    ' Publish the native crop origin so the shared preview/clip code (mask_preview)
    ' can map loupe pixels back to canvas — and thus selection — coordinates.
    IMGADJ_LOUPE_CROPX& = cropX0&
    IMGADJ_LOUPE_CROPY& = cropY0&

    ' origThumb = the target layer(s) at native scale, centred. (We show the
    ' layer being edited rather than the full composite; the mask below is the
    ' same alpha, so previews only touch opaque pixels — matching the apply.)
    SAFE_FREEIMAGE ctx.origThumb
    ctx.origThumb = _NEWIMAGE(tw, th, 32)
    DIM loupeOldD AS LONG : loupeOldD& = _DEST
    _DEST ctx.origThumb : _DONTBLEND ctx.origThumb : CLS , _RGBA32(0, 0, 0, 0) : _BLEND ctx.origThumb : _DEST loupeOldD&

    DIM loupeMulti AS INTEGER, lz AS INTEGER
    loupeMulti% = MULTI_SELECT_has_any%
    IF loupeMulti% THEN
        FOR lz% = 1 TO MAX_LAYERS
            IF MULTI_SELECT_LAYERS(lz%) THEN
                IF LAYERS(lz%).layerType% <> LAYER_TYPE_GROUP THEN
                    IMGADJ_blit_native_crop LAYERS(lz%).imgHandle&, LAYERS(lz%).apronW%, LAYERS(lz%).apronH%, cropX0&, cropY0&, tw, th, ctx.origThumb
                END IF
            END IF
        NEXT lz%
    ELSE
        IMGADJ_blit_native_crop LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%, cropX0&, cropY0&, tw, th, ctx.origThumb
    END IF

    ' Selection silhouette thumb (sel-as-shape preview): same padded crop, alpha =
    ' selection coverage (opaque inside), RGB kept from origThumb. Edge dialogs run
    ' the engine on this so the preview radiates from the selection edge.
    SAFE_FREEIMAGE IMGADJ_SHAPE_THUMB&
    IMGADJ_SHAPE_THUMB& = 0
    IF IMGADJ_sel_active% AND ctx.origThumb < -1 THEN
        DIM covImg AS LONG : covImg& = IMGADJ_sel_coverage&
        IF covImg& < -1 THEN
            IMGADJ_SHAPE_THUMB& = _COPYIMAGE(ctx.origThumb, 32)
            DIM stM AS _MEM, cvM AS _MEM
            stM = _MEMIMAGE(IMGADJ_SHAPE_THUMB&) : cvM = _MEMIMAGE(covImg&)
            DIM scW AS LONG, scH AS LONG : scW& = _WIDTH(covImg&) : scH& = _HEIGHT(covImg&)
            DIM stx AS LONG, sty AS LONG, ccx AS LONG, ccy AS LONG, covr AS _UNSIGNED _BYTE
            DIM stpx AS _UNSIGNED LONG, stA AS _UNSIGNED _BYTE
            FOR sty& = 0 TO th - 1
                ccy& = cropY0& + sty&
                FOR stx& = 0 TO tw - 1
                    ccx& = cropX0& + stx&
                    stA~%% = 0
                    IF ccx& >= 0 AND ccy& >= 0 AND ccx& < scW& AND ccy& < scH& THEN
                        _MEMGET cvM, cvM.OFFSET + (ccy& * scW& + ccx&) * 4 + 2, covr~%%
                        IF covr~%% > 127 THEN stA~%% = 255
                    END IF
                    _MEMGET stM, stM.OFFSET + (sty& * tw + stx&) * 4, stpx~&
                    stpx~& = _RGBA32(_RED32(stpx~&), _GREEN32(stpx~&), _BLUE32(stpx~&), stA~%%)
                    _MEMPUT stM, stM.OFFSET + (sty& * tw + stx&) * 4, stpx~& AS _UNSIGNED LONG
                NEXT stx&
            NEXT sty&
            _MEMFREE stM : _MEMFREE cvM
            SAFE_FREEIMAGE covImg&
        END IF
    END IF

    ' Alpha mask == same target-layer content (so adjustments only show on opaque
    ' layer pixels, matching the alpha-preserving apply). If the crop is entirely
    ' transparent (e.g. a generative effect on an empty layer) leave the mask off
    ' so the full preview shows — matching the old behaviour.
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK&
    IMGADJ_LAYER_MASK& = 0
    IF ctx.origThumb < -1 THEN
        DIM chkM AS _MEM, chkOff AS _OFFSET, chkA AS _UNSIGNED _BYTE, hasC AS INTEGER
        hasC% = FALSE
        chkM = _MEMIMAGE(ctx.origThumb)
        FOR chkOff = 0 TO chkM.SIZE - 4 STEP 4
            _MEMGET chkM, chkM.OFFSET + chkOff + 3, chkA~%%
            IF chkA~%% > 0 THEN hasC% = TRUE : EXIT FOR
        NEXT chkOff
        _MEMFREE chkM
        IF hasC% THEN IMGADJ_LAYER_MASK& = _COPYIMAGE(ctx.origThumb, 32)
    END IF

    ' Invalidate preview thumb — dialog loop will recompute it via previewDirty
    SAFE_FREEIMAGE ctx.previewThumb
    ctx.previewThumb = 0
    ctx.loupeDirty   = FALSE
    ctx.previewDirty = TRUE
END SUB


''
' Mask the previewThumb so pixels where the current layer is transparent
' show the original canvas (origThumb) instead of the adjusted result.
' This makes the preview match the final apply, which preserves alpha.
' @param ctx DIALOG_CTX Dialog context with preview and original thumbnails
'
SUB IMAGE_ADJ_mask_preview (ctx AS DIALOG_CTX)
    IF ctx.previewThumb >= -1 OR ctx.origThumb >= -1 THEN EXIT SUB

    DIM mpMemPrv AS _MEM, mpMemOrig AS _MEM
    mpMemPrv  = _MEMIMAGE(ctx.previewThumb)
    mpMemOrig = _MEMIMAGE(ctx.origThumb)

    DIM mpOff       AS _OFFSET
    DIM mpOrigPx    AS _UNSIGNED LONG

    ' --- Layer-alpha mask: restore original where the target layer is transparent,
    ' matching the alpha-preserving apply. Skipped when no mask exists (generative
    ' effect on an empty layer) so the full generated preview shows. ---
    IF IMGADJ_LAYER_MASK& < -1 THEN
        DIM mpMemMask AS _MEM : mpMemMask = _MEMIMAGE(IMGADJ_LAYER_MASK&)
        DIM mpMaskAlpha AS _UNSIGNED _BYTE
        FOR mpOff = 0 TO mpMemPrv.SIZE - 4 STEP 4
            _MEMGET mpMemMask, mpMemMask.OFFSET + mpOff + 3, mpMaskAlpha~%%
            IF mpMaskAlpha~%% = 0 THEN
                _MEMGET mpMemOrig, mpMemOrig.OFFSET + mpOff, mpOrigPx~&
                _MEMPUT mpMemPrv, mpMemPrv.OFFSET + mpOff, mpOrigPx~&
            END IF
        NEXT mpOff
        _MEMFREE mpMemMask
    END IF

    ' --- Selection-clip parity: when a selection is active and the effect clips to
    ' it (CLIP on, not SEL-AS-SHAPE), restore the original everywhere OUTSIDE the
    ' selection — so the preview shows only the region apply will actually change.
    ' Each loupe pixel maps to canvas coords through the published crop origin
    ' (IMGADJ_LOUPE_CROPX/Y), then samples the selection coverage (red = inside). ---
    IF EFFECT_CLIP_TO_SEL AND EFFECT_SEL_AS_SHAPE = 0 AND IMGADJ_sel_active% THEN
        DIM mpCov AS LONG : mpCov& = IMGADJ_sel_coverage&
        IF mpCov& < -1 THEN
            DIM mpTW AS LONG, mpCovW AS LONG, mpCovH AS LONG
            mpTW&   = _WIDTH(ctx.previewThumb)
            mpCovW& = _WIDTH(mpCov&) : mpCovH& = _HEIGHT(mpCov&)
            DIM mpMemCov AS _MEM : mpMemCov = _MEMIMAGE(mpCov&)
            DIM mpIdx AS LONG, mpLX AS LONG, mpLY AS LONG, mpCX AS LONG, mpCY AS LONG
            DIM mpCovR AS _UNSIGNED _BYTE
            FOR mpOff = 0 TO mpMemPrv.SIZE - 4 STEP 4
                mpIdx& = mpOff \ 4
                mpLX&  = mpIdx& MOD mpTW&
                mpLY&  = mpIdx& \ mpTW&
                mpCX&  = IMGADJ_LOUPE_CROPX& + mpLX&
                mpCY&  = IMGADJ_LOUPE_CROPY& + mpLY&
                IF mpCX& >= 0 AND mpCY& >= 0 AND mpCX& < mpCovW& AND mpCY& < mpCovH& THEN
                    _MEMGET mpMemCov, mpMemCov.OFFSET + (mpCY& * mpCovW& + mpCX&) * 4 + 2, mpCovR~%%
                    IF mpCovR~%% > 127 THEN _CONTINUE   ' inside selection -> keep effect
                END IF
                _MEMGET mpMemOrig, mpMemOrig.OFFSET + mpOff, mpOrigPx~&  ' outside -> restore original
                _MEMPUT mpMemPrv, mpMemPrv.OFFSET + mpOff, mpOrigPx~&
            NEXT mpOff
            _MEMFREE mpMemCov
            SAFE_FREEIMAGE mpCov&
        END IF
    END IF

    _MEMFREE mpMemPrv
    _MEMFREE mpMemOrig
END SUB


''
' Open a modal Brightness/Contrast adjustment dialog with two sliders and live
' loupe preview. Brightness ranges -100..+100, contrast ranges -100..+100.
' On OK, applies both adjustments to the active layer with undo support.
'
SUB IMAGE_ADJ_brightness_contrast_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 176
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM brightness  AS INTEGER, contrast AS INTEGER
    DIM oBrightness AS INTEGER, oContrast AS INTEGER
    DIM prvTmp      AS LONG, prvResult AS LONG
    brightness% = 0 : contrast% = 0

    ' "Preserve Blacks": when on, pure-black (0,0,0) pixels are left untouched so
    ' raising brightness/contrast doesn't lift the blacks. Remembered across opens
    ' this session via STATIC. Scratch strings/amounts for the non-black path.
    STATIC preserveBlacks AS INTEGER
    DIM pbX AS INTEGER, pbY AS INTEGER, pbW AS INTEGER, pbH AS INTEGER
    pbX% = IMGDLG_SX : pbW% = 160 : pbH% = 16
    pbY% = IMGDLG_track_y%(ctx, 1) + 24
    DIM bDir AS STRING, cDir AS STRING, bAmt AS INTEGER, cAmt AS INTEGER

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oBrightness% = brightness% : oContrast% = contrast%
        brightness%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, brightness%, -100, 100)
        brightness%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, brightness%, -100, 100)
        contrast%    = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, contrast%,   -100, 100)
        contrast%    = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, contrast%,   -100, 100)
        IF DIALOG_hit%(ctx, pbX%, pbY%, pbW%, pbH%) THEN
            preserveBlacks%   = (preserveBlacks% = 0) ' toggle (avoid bitwise NOT — gotcha #19)
            ctx.previewDirty% = TRUE
        END IF
        IF brightness% <> oBrightness% OR contrast% <> oContrast% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            IF preserveBlacks% THEN
                IF brightness% >= 0 THEN bDir$ = "+" ELSE bDir$ = "-"
                bAmt% = (ABS(brightness%) * 255) \ 100
                IF contrast% >= 0 THEN cDir$ = "+" ELSE cDir$ = "-"
                cAmt% = ABS(contrast%)
                prvResult& = GJ_IMGADJ_BrightnessContrastNonBlack(ctx.origThumb, bDir$, bAmt%, cDir$, cAmt%)
            ELSE
                IF brightness% > 0 THEN
                    prvTmp& = GJ_IMGADJ_Brightness(ctx.origThumb, "+", (brightness% * 255) \ 100)
                ELSEIF brightness% < 0 THEN
                    prvTmp& = GJ_IMGADJ_Brightness(ctx.origThumb, "-", ((-brightness%) * 255) \ 100)
                ELSE
                    prvTmp& = GJ_IMGADJ_CloneImage(ctx.origThumb)
                END IF
                IF contrast% > 0 THEN
                    prvResult& = GJ_IMGADJ_Contrast(prvTmp&, "+", contrast%)
                ELSEIF contrast% < 0 THEN
                    prvResult& = GJ_IMGADJ_Contrast(prvTmp&, "-", -contrast%)
                ELSE
                    prvResult& = GJ_IMGADJ_CloneImage(prvTmp&)
                END IF
                SAFE_FREEIMAGE prvTmp&
            END IF
            ctx.previewThumb = prvResult&
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "BRIGHTNESS / CONTRAST"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "BRIGHTNESS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, brightness%, -100, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "CONTRAST:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, contrast%,   -100, 100, "", ""
        DIALOG_draw_toggle ctx, pbX%, pbY%, pbW%, pbH%, "PRESERVE BLACKS", preserveBlacks%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM bcTargets(1 TO MAX_LAYERS) AS INTEGER, bcTgtCount AS INTEGER, bcT AS INTEGER
        DIM bcSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets bcTargets%(), bcTgtCount%
        bcSaveCL% = CURRENT_LAYER%
        IF bcTgtCount% > 1 THEN HISTORY_begin_group
        DIM src      AS LONG, tmp AS LONG, adjR AS LONG
        FOR bcT% = 1 TO bcTgtCount%
            CURRENT_LAYER% = bcTargets%(bcT%)
            src&           = LAYERS(CURRENT_LAYER%).imgHandle&
            IF preserveBlacks% THEN
                IF brightness% >= 0 THEN bDir$ = "+" ELSE bDir$ = "-"
                bAmt% = (ABS(brightness%) * 255) \ 100
                IF contrast% >= 0 THEN cDir$ = "+" ELSE cDir$ = "-"
                cAmt% = ABS(contrast%)
                adjR& = GJ_IMGADJ_BrightnessContrastNonBlack(src&, bDir$, bAmt%, cDir$, cAmt%)
            ELSE
                IF brightness% > 0 THEN
                    tmp& = GJ_IMGADJ_Brightness(src&, "+", (brightness% * 255) \ 100)
                ELSEIF brightness% < 0 THEN
                    tmp& = GJ_IMGADJ_Brightness(src&, "-", ((-brightness%) * 255) \ 100)
                ELSE
                    tmp& = GJ_IMGADJ_CloneImage(src&)
                END IF
                IF contrast% > 0 THEN
                    adjR& = GJ_IMGADJ_Contrast(tmp&, "+", contrast%)
                ELSEIF contrast% < 0 THEN
                    adjR& = GJ_IMGADJ_Contrast(tmp&, "-", -contrast%)
                ELSE
                    adjR& = GJ_IMGADJ_CloneImage(tmp&)
                END IF
                IF tmp& < -1 AND tmp& <> src& THEN SAFE_FREEIMAGE tmp&
            END IF
            IMAGE_ADJ_apply_to_layer adjR&, "Brightness / Contrast"
        NEXT bcT%
        IF bcTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = bcSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Hue/Saturation adjustment dialog with two sliders and live
' loupe preview. Hue ranges -180..+180 degrees, saturation ranges -100..+100.
' On OK, applies both adjustments to the active layer with undo support.
'
SUB IMAGE_ADJ_hue_saturation_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 148
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM hueShift AS INTEGER, satShift AS INTEGER
    DIM oHue     AS INTEGER, oSat AS INTEGER
    DIM prvTmp   AS LONG, prvResult AS LONG
    hueShift% = 0 : satShift% = 0

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oHue%     = hueShift% : oSat% = satShift%
        hueShift% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, hueShift%, -180, 180)
        hueShift% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, hueShift%, -180, 180)
        satShift% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, satShift%, -100, 100)
        satShift% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, satShift%, -100, 100)
        IF hueShift% <> oHue% OR satShift% <> oSat% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            IF hueShift% > 0 THEN
                prvTmp& = GJ_IMGADJ_Hue(ctx.origThumb, "+", hueShift%)
            ELSEIF hueShift% < 0 THEN
                prvTmp& = GJ_IMGADJ_Hue(ctx.origThumb, "-", -hueShift%)
            ELSE
                prvTmp& = GJ_IMGADJ_CloneImage(ctx.origThumb)
            END IF
            IF satShift% > 0 THEN
                prvResult& = GJ_IMGADJ_Saturation(prvTmp&, "+", satShift%)
            ELSEIF satShift% < 0 THEN
                prvResult& = GJ_IMGADJ_Saturation(prvTmp&, "-", -satShift%)
            ELSE
                prvResult& = GJ_IMGADJ_CloneImage(prvTmp&)
            END IF
            SAFE_FREEIMAGE prvTmp&
            ctx.previewThumb = prvResult&
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "HUE / SATURATION"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "HUE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, hueShift%, -180, 180, "", CHR$(176)
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "SATURATION:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, satShift%, -100, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM hsTargets(1 TO MAX_LAYERS) AS INTEGER, hsTgtCount AS INTEGER, hsT AS INTEGER
        DIM hsSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets hsTargets%(), hsTgtCount%
        hsSaveCL% = CURRENT_LAYER%
        IF hsTgtCount% > 1 THEN HISTORY_begin_group
        DIM src      AS LONG, tmp AS LONG, adjR AS LONG
        FOR hsT% = 1 TO hsTgtCount%
            CURRENT_LAYER% = hsTargets%(hsT%)
            src&           = LAYERS(CURRENT_LAYER%).imgHandle&
            IF hueShift% > 0 THEN
                tmp& = GJ_IMGADJ_Hue(src&, "+", hueShift%)
            ELSEIF hueShift% < 0 THEN
                tmp& = GJ_IMGADJ_Hue(src&, "-", -hueShift%)
            ELSE
                tmp& = GJ_IMGADJ_CloneImage(src&)
            END IF
            IF satShift% > 0 THEN
                adjR& = GJ_IMGADJ_Saturation(tmp&, "+", satShift%)
            ELSEIF satShift% < 0 THEN
                adjR& = GJ_IMGADJ_Saturation(tmp&, "-", -satShift%)
            ELSE
                adjR& = GJ_IMGADJ_CloneImage(tmp&)
            END IF
            IF tmp& < -1 AND tmp& <> src& THEN SAFE_FREEIMAGE tmp&
            IMAGE_ADJ_apply_to_layer adjR&, "Hue / Saturation"
        NEXT hsT%
        IF hsTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = hsSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Levels adjustment dialog with four sliders and live loupe preview.
' Provides Input Min/Max (0..255) and Output Min/Max (0..255) controls for
' remapping the tonal range. On OK, applies to the active layer with undo support.
'
SUB IMAGE_ADJ_levels_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 224
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM inMin  AS INTEGER, inMax AS INTEGER
    DIM outMin AS INTEGER, outMax AS INTEGER
    DIM oInMin AS INTEGER, oInMax AS INTEGER, oOutMin AS INTEGER, oOutMax AS INTEGER
    inMin% = 0 : inMax% = 255 : outMin% = 0 : outMax% = 255

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oInMin% = inMin% : oInMax% = inMax% : oOutMin% = outMin% : oOutMax% = outMax%
        inMin%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, inMin%,  0, 255)
        inMin%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, inMin%,  0, 255)
        inMax%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inMax%,  0, 255)
        inMax%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inMax%,  0, 255)
        outMin% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, outMin%, 0, 255)
        outMin% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, outMin%, 0, 255)
        outMax% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, 14, outMax%, 0, 255)
        outMax% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, 14, outMax%, 0, 255)
        IF inMin% <> oInMin% OR inMax% <> oInMax% OR outMin% <> oOutMin% OR outMax% <> oOutMax% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = GJ_IMGADJ_Levels(ctx.origThumb, inMin%, inMax%, outMin%, outMax%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "LEVELS"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "INPUT MIN:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, inMin%,  0, 255, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "INPUT MAX:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, inMax%,  0, 255, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 2), "OUTPUT MIN:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, outMin%, 0, 255, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 3), "OUTPUT MAX:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, outMax%, 0, 255, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM lvTargets(1 TO MAX_LAYERS) AS INTEGER, lvTgtCount AS INTEGER, lvT AS INTEGER
        DIM lvSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets lvTargets%(), lvTgtCount%
        lvSaveCL% = CURRENT_LAYER%
        IF lvTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR lvT% = 1 TO lvTgtCount%
            CURRENT_LAYER% = lvTargets%(lvT%)
            adjR&          = GJ_IMGADJ_Levels(LAYERS(CURRENT_LAYER%).imgHandle&, inMin%, inMax%, outMin%, outMax%)
            IMAGE_ADJ_apply_to_layer adjR&, "Levels"
        NEXT lvT%
        IF lvTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = lvSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Color Balance adjustment dialog with three sliders and live loupe
' preview. Red, Green, and Blue channels can each be shifted -255..+255.
' On OK, applies the combined color shift to the active layer with undo support.
'
SUB IMAGE_ADJ_color_balance_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 214
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM redShift AS INTEGER, greenShift AS INTEGER, blueShift AS INTEGER
    DIM oRed     AS INTEGER, oGreen AS INTEGER, oBlue AS INTEGER
    redShift% = 0 : greenShift% = 0 : blueShift% = 0

    ' "Preserve Blacks" toggle (below the BLUE slider); remembered per session.
    STATIC cbPreserveBlacks AS INTEGER
    DIM cbPbX AS INTEGER, cbPbY AS INTEGER, cbPbW AS INTEGER, cbPbH AS INTEGER
    cbPbX% = IMGDLG_SX : cbPbW% = 160 : cbPbH% = 16
    cbPbY% = IMGDLG_track_y%(ctx, 2) + 24

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oRed%       = redShift% : oGreen% = greenShift% : oBlue% = blueShift%
        redShift%   = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, redShift%,   -255, 255)
        redShift%   = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, redShift%,   -255, 255)
        greenShift% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, greenShift%, -255, 255)
        greenShift% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, greenShift%, -255, 255)
        blueShift%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, blueShift%,  -255, 255)
        blueShift%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, blueShift%,  -255, 255)
        IF DIALOG_hit%(ctx, cbPbX%, cbPbY%, cbPbW%, cbPbH%) THEN
            cbPreserveBlacks% = (cbPreserveBlacks% = 0) ' toggle (avoid bitwise NOT — gotcha #19)
            ctx.previewDirty% = TRUE
        END IF
        IF redShift% <> oRed% OR greenShift% <> oGreen% OR blueShift% <> oBlue% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = GJ_IMGADJ_ColorBalance(ctx.origThumb, redShift%, greenShift%, blueShift%, cbPreserveBlacks%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "COLOR BALANCE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "RED:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, redShift%,   -255, 255, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "GREEN:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, greenShift%, -255, 255, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 2), "BLUE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, blueShift%,  -255, 255, "", ""
        DIALOG_draw_toggle ctx, cbPbX%, cbPbY%, cbPbW%, cbPbH%, "PRESERVE BLACKS", cbPreserveBlacks%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM cbTargets(1 TO MAX_LAYERS) AS INTEGER, cbTgtCount AS INTEGER, cbT AS INTEGER
        DIM cbSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets cbTargets%(), cbTgtCount%
        cbSaveCL% = CURRENT_LAYER%
        IF cbTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR cbT% = 1 TO cbTgtCount%
            CURRENT_LAYER% = cbTargets%(cbT%)
            adjR&          = GJ_IMGADJ_ColorBalance(LAYERS(CURRENT_LAYER%).imgHandle&, redShift%, greenShift%, blueShift%, cbPreserveBlacks%)
            IMAGE_ADJ_apply_to_layer adjR&, "Color Balance"
        NEXT cbT%
        IF cbTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = cbSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Blur adjustment dialog with a single radius slider and live loupe
' preview. Radius ranges 1..20 pixels. On OK, applies a box blur to the active
' layer with undo support.
'
''
' Multi-type blur. blurType: 0=Box 1=Gaussian 2=Motion 3=Zoom 4=Spin.
'   Box      — uniform box average (fast, flat).
'   Gaussian — three successive box passes (smooth bell falloff).
'   Motion   — directional smear along angleDeg over +/- radius px.
'   Zoom      — radial blur scaling out from the image centre.
'   Spin     — rotational blur around the image centre.
' Motion/Zoom/Spin sample-average with premultiplied alpha so transparency stays
' clean. angleDeg only affects Motion. Returns a new image; caller frees.
'
FUNCTION IMAGE_ADJ_blur_typed& (sourceImg AS LONG, blurType AS INTEGER, radius AS INTEGER, angleDeg AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_blur_typed& = 0 : EXIT FUNCTION
    IF radius% < 1 THEN IMAGE_ADJ_blur_typed& = _COPYIMAGE(sourceImg&, 32) : EXIT FUNCTION

    IF blurType% = 0 THEN
        IMAGE_ADJ_blur_typed& = IMAGE_ADJ_blur_premul_rgba&(sourceImg&, radius%)
        EXIT FUNCTION
    ELSEIF blurType% = 1 THEN
        DIM r3 AS INTEGER : r3% = radius% \ 3 : IF r3% < 1 THEN r3% = 1
        DIM g1 AS LONG, g2 AS LONG
        g1& = IMAGE_ADJ_blur_premul_rgba&(sourceImg&, r3%)
        g2& = IMAGE_ADJ_blur_premul_rgba&(g1&, r3%)
        IMAGE_ADJ_blur_typed& = IMAGE_ADJ_blur_premul_rgba&(g2&, r3%)
        IF g1& < -1 THEN _FREEIMAGE g1&
        IF g2& < -1 THEN _FREEIMAGE g2&
        EXIT FUNCTION
    END IF

    DIM bw AS LONG, bh AS LONG
    bw& = _WIDTH(sourceImg&) : bh& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _NEWIMAGE(bw&, bh&, 32)
    DIM sM AS _MEM, rM AS _MEM
    sM = _MEMIMAGE(sourceImg&) : rM = _MEMIMAGE(result&)
    DIM bcx AS SINGLE, bcy AS SINGLE : bcx! = bw& / 2.0 : bcy! = bh& / 2.0
    DIM brad AS SINGLE : brad! = angleDeg% * 3.14159265 / 180.0
    DIM mdx AS SINGLE, mdy AS SINGLE : mdx! = COS(brad!) : mdy! = -SIN(brad!)
    DIM bpx AS LONG, bpy AS LONG, bt AS INTEGER
    DIM sax AS SINGLE, say AS SINGLE, bang AS SINGLE, bcs AS SINGLE, bsn AS SINGLE, bsc AS SINGLE
    DIM ssr AS SINGLE, ssg AS SINGLE, ssb AS SINGLE, ssa AS SINGLE
    DIM bcnt AS INTEGER, smp AS _UNSIGNED LONG, saa AS INTEGER, saf AS SINGLE
    DIM six AS LONG, siy AS LONG, oaI AS INTEGER, orI AS INTEGER, ogI AS INTEGER, obI AS INTEGER
    DIM nsteps AS INTEGER : nsteps% = radius%
    DIM tf AS SINGLE
    DIM btShowProg AS INTEGER : btShowProg% = (bw& * bh& >= 120000)
    FOR bpy& = 0 TO bh& - 1
        IF btShowProg% AND (bpy& AND 15) = 0 THEN IMGADJ_progress_tick "Blurring", bpy& / bh&
        FOR bpx& = 0 TO bw& - 1
            ssr! = 0 : ssg! = 0 : ssb! = 0 : ssa! = 0 : bcnt% = 0
            FOR bt% = -nsteps% TO nsteps%
                tf! = bt% / (nsteps% + 1.0)
                IF blurType% = 2 THEN                       ' Motion
                    sax! = bpx& + mdx! * bt% : say! = bpy& + mdy! * bt%
                ELSEIF blurType% = 3 THEN                   ' Zoom
                    bsc! = 1.0 + tf! * 0.6
                    sax! = bcx! + (bpx& - bcx!) * bsc! : say! = bcy! + (bpy& - bcy!) * bsc!
                ELSE                                        ' Spin
                    bang! = tf! * 0.6
                    bcs! = COS(bang!) : bsn! = SIN(bang!)
                    sax! = bcx! + (bpx& - bcx!) * bcs! - (bpy& - bcy!) * bsn!
                    say! = bcy! + (bpx& - bcx!) * bsn! + (bpy& - bcy!) * bcs!
                END IF
                six& = INT(sax! + 0.5) : siy& = INT(say! + 0.5)
                IF six& >= 0 AND siy& >= 0 AND six& < bw& AND siy& < bh& THEN
                    _MEMGET sM, sM.OFFSET + (siy& * bw& + six&) * 4, smp~&
                    saa% = _ALPHA32(smp~&) : saf! = saa% / 255.0
                    ssr! = ssr! + _RED32(smp~&) * saf!
                    ssg! = ssg! + _GREEN32(smp~&) * saf!
                    ssb! = ssb! + _BLUE32(smp~&) * saf!
                    ssa! = ssa! + saa%
                    bcnt% = bcnt% + 1
                END IF
            NEXT bt%
            IF bcnt% > 0 THEN
                oaI% = ssa! / bcnt%
                IF oaI% > 0 THEN
                    orI% = (ssr! / bcnt%) * 255.0 / oaI%
                    ogI% = (ssg! / bcnt%) * 255.0 / oaI%
                    obI% = (ssb! / bcnt%) * 255.0 / oaI%
                    IF orI% > 255 THEN orI% = 255
                    IF ogI% > 255 THEN ogI% = 255
                    IF obI% > 255 THEN obI% = 255
                    _MEMPUT rM, rM.OFFSET + (bpy& * bw& + bpx&) * 4, _RGBA32(orI%, ogI%, obI%, oaI%) AS _UNSIGNED LONG
                END IF
            END IF
        NEXT bpx&
    NEXT bpy&
    _MEMFREE sM : _MEMFREE rM
    IMAGE_ADJ_blur_typed& = result&
END FUNCTION

SUB IMAGE_ADJ_blur_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 176
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM radius  AS INTEGER : radius% = 3
    DIM oRadius AS INTEGER
    DIM bangle  AS INTEGER : bangle% = 0
    DIM oBangle AS INTEGER
    STATIC blurType AS INTEGER   ' 0=Box 1=Gaussian 2=Motion 3=Zoom 4=Spin

    DIM tvX AS INTEGER, tvY AS INTEGER, tvW AS INTEGER, tvH AS INTEGER
    tvX% = IMGDLG_SX : tvW% = 200 : tvH% = 16
    tvY% = IMGDLG_track_y%(ctx, 1) + 26

    DIM k AS LONG, bName AS STRING
    DIM d_radius AS INTEGER : d_radius% = 3
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oRadius% = radius% : oBangle% = bangle%
        radius%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, radius%, 1, 200)
        radius%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, radius%, 1, 200)
        bangle%  = IMGDLG_angle_handle%(ctx, 1, bangle%)
        IF DIALOG_hit%(ctx, tvX%, tvY%, tvW%, tvH%) THEN blurType% = (blurType% + 1) MOD 5 : ctx.previewDirty% = TRUE
        IF radius% <> oRadius% OR bangle% <> oBangle% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, radius%, d_radius%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_blur_typed&(ctx.origThumb, blurType%, radius%, bangle%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        SELECT CASE blurType%
            CASE 1 : bName$ = "GAUSSIAN"
            CASE 2 : bName$ = "MOTION"
            CASE 3 : bName$ = "ZOOM"
            CASE 4 : bName$ = "SPIN"
            CASE ELSE : bName$ = "BOX"
        END SELECT

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "BLUR"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "RADIUS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, radius%, 1, 200, "", " px"
        IMGDLG_angle_draw ctx, 1, bangle%, "ANGLE (MOTION):"
        DIALOG_draw_toggle ctx, tvX%, tvY%, tvW%, tvH%, "TYPE: " + bName$, -1
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM blTargets(1 TO MAX_LAYERS) AS INTEGER, blTgtCount AS INTEGER, blT AS INTEGER
        DIM blSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets blTargets%(), blTgtCount%
        blSaveCL% = CURRENT_LAYER%
        IF blTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR blT% = 1 TO blTgtCount%
            CURRENT_LAYER% = blTargets%(blT%)
            adjR&          = IMAGE_ADJ_blur_typed&(LAYERS(CURRENT_LAYER%).imgHandle&, blurType%, radius%, bangle%)
            IMAGE_ADJ_apply_spatial adjR&, "Blur"
        NEXT blT%
        IF blTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = blSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Sharpen adjustment dialog with a single strength slider and live
' loupe preview. Strength ranges 1..10. Uses unsharp-mask sharpening via
' IMAGE_ADJ_apply_sharpen&. On OK, applies to the active layer with undo support.
'
SUB IMAGE_ADJ_sharpen_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM strength  AS INTEGER : strength% = 3
    DIM oStrength AS INTEGER

    DIM k AS LONG
    DIM d_strength AS INTEGER : d_strength% = 3
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oStrength% = strength%
        strength%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, strength%, 1, 64)
        strength%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, strength%, 1, 64)
        IF strength% <> oStrength% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, strength%, d_strength%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_apply_sharpen&(ctx.origThumb, strength%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "SHARPEN"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "STRENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, strength%, 1, 64, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM shTargets(1 TO MAX_LAYERS) AS INTEGER, shTgtCount AS INTEGER, shT AS INTEGER
        DIM shSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets shTargets%(), shTgtCount%
        shSaveCL% = CURRENT_LAYER%
        IF shTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR shT% = 1 TO shTgtCount%
            CURRENT_LAYER% = shTargets%(shT%)
            adjR&          = IMAGE_ADJ_apply_sharpen&(LAYERS(CURRENT_LAYER%).imgHandle&, strength%)
            IMAGE_ADJ_apply_to_layer adjR&, "Sharpen"
        NEXT shT%
        IF shTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = shSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Gamma adjustment dialog with a single bipolar slider
' (-100..+100). Negative darkens midtones, positive lightens them; 0 = identity.
' Live loupe preview; on OK applies to the active (and extra-selected) layers
' with undo. Maps the slider to GJ_IMGADJ_Gamma's direction$/amount% API.
'
SUB IMAGE_ADJ_gamma_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM amount  AS INTEGER : amount% = 0
    DIM oAmount AS INTEGER
    DIM gDir    AS STRING

    DIM k AS LONG
    DIM d_amount AS INTEGER : d_amount% = 0
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oAmount% = amount%
        amount%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, -100, 100)
        amount%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, -100, 100)
        IF amount% <> oAmount% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, amount%, d_amount%

        IF ctx.previewDirty% THEN
            gDir$ = "+" : IF amount% < 0 THEN gDir$ = "-"
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = GJ_IMGADJ_Gamma(ctx.origThumb, gDir$, ABS(amount%))
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "GAMMA"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "AMOUNT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, amount%, -100, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        gDir$ = "+" : IF amount% < 0 THEN gDir$ = "-"
        DIM gmTargets(1 TO MAX_LAYERS) AS INTEGER, gmTgtCount AS INTEGER, gmT AS INTEGER
        DIM gmSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets gmTargets%(), gmTgtCount%
        gmSaveCL% = CURRENT_LAYER%
        IF gmTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR gmT% = 1 TO gmTgtCount%
            CURRENT_LAYER% = gmTargets%(gmT%)
            adjR&          = GJ_IMGADJ_Gamma(LAYERS(CURRENT_LAYER%).imgHandle&, gDir$, ABS(amount%))
            IMAGE_ADJ_apply_to_layer adjR&, "Gamma"
        NEXT gmT%
        IF gmTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = gmSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Threshold dialog: a single 0..255 luminance cutoff slider plus an
' INVERT toggle. Pixels at/above the cutoff become white (below become black),
' or the reverse when inverted. Live loupe preview; multi-layer + undo on OK.
'
SUB IMAGE_ADJ_threshold_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 130
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM cutoff  AS INTEGER : cutoff% = 128
    DIM oCutoff AS INTEGER
    STATIC invMode AS INTEGER   ' 0 = binary, 1 = inverted (remembered across opens)
    DIM thMode AS INTEGER

    DIM ivX AS INTEGER, ivY AS INTEGER, ivW AS INTEGER, ivH AS INTEGER
    ivX% = IMGDLG_SX : ivW% = 120 : ivH% = 16
    ivY% = IMGDLG_track_y%(ctx, 0) + 24

    DIM k AS LONG
    DIM d_cutoff AS INTEGER : d_cutoff% = 128
    DIM d_invMode AS INTEGER : d_invMode% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oCutoff% = cutoff%
        cutoff%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, cutoff%, 0, 255)
        cutoff%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, cutoff%, 0, 255)
        IF DIALOG_hit%(ctx, ivX%, ivY%, ivW%, ivH%) THEN
            invMode%          = (invMode% = 0) ' toggle (avoid bitwise NOT — gotcha #19)
            ctx.previewDirty% = TRUE
        END IF
        IF cutoff% <> oCutoff% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, cutoff%, invMode%, d_cutoff%, d_invMode%

        IF ctx.previewDirty% THEN
            thMode% = GJ_IMGADJ_THRESHOLD_BINARY : IF invMode% THEN thMode% = GJ_IMGADJ_THRESHOLD_INVERTED
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = GJ_IMGADJ_Threshold(ctx.origThumb, cutoff%, thMode%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "THRESHOLD"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "LEVEL:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, cutoff%, 0, 255, "", ""
        DIALOG_draw_toggle ctx, ivX%, ivY%, ivW%, ivH%, "INVERT", invMode%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        thMode% = GJ_IMGADJ_THRESHOLD_BINARY : IF invMode% THEN thMode% = GJ_IMGADJ_THRESHOLD_INVERTED
        DIM thTargets(1 TO MAX_LAYERS) AS INTEGER, thTgtCount AS INTEGER, thT AS INTEGER
        DIM thSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets thTargets%(), thTgtCount%
        thSaveCL% = CURRENT_LAYER%
        IF thTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR thT% = 1 TO thTgtCount%
            CURRENT_LAYER% = thTargets%(thT%)
            adjR&          = GJ_IMGADJ_Threshold(LAYERS(CURRENT_LAYER%).imgHandle&, cutoff%, thMode%)
            IMAGE_ADJ_apply_to_layer adjR&, "Threshold"
        NEXT thT%
        IF thTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = thSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Colorize dialog: a HUE slider (0..360) and a SATURATION slider
' (0..100%). Recolors every pixel to the chosen hue/saturation while keeping its
' original brightness (tint). Live loupe preview; multi-layer + undo on OK.
'
SUB IMAGE_ADJ_colorize_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM czHue  AS INTEGER : czHue% = 210
    DIM czSat  AS INTEGER : czSat% = 60      ' percent (0..100)
    DIM oHue   AS INTEGER, oSat AS INTEGER

    DIM k AS LONG
    DIM d_czHue AS INTEGER : d_czHue% = 210
    DIM d_czSat AS INTEGER : d_czSat% = 60
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oHue% = czHue% : oSat% = czSat%
        czHue% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, czHue%, 0, 360)
        czHue% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, czHue%, 0, 360)
        czSat% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, czSat%, 0, 100)
        czSat% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, czSat%, 0, 100)
        IF czHue% <> oHue% OR czSat% <> oSat% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, czHue%, czSat%, d_czHue%, d_czSat%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = GJ_IMGADJ_Colorize(ctx.origThumb, czHue%, czSat% / 100.0)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "COLORIZE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "HUE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, czHue%, 0, 360, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "SATURATION:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, czSat%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM czTargets(1 TO MAX_LAYERS) AS INTEGER, czTgtCount AS INTEGER, czT AS INTEGER
        DIM czSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets czTargets%(), czTgtCount%
        czSaveCL% = CURRENT_LAYER%
        IF czTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR czT% = 1 TO czTgtCount%
            CURRENT_LAYER% = czTargets%(czT%)
            adjR&          = GJ_IMGADJ_Colorize(LAYERS(CURRENT_LAYER%).imgHandle&, czHue%, czSat% / 100.0)
            IMAGE_ADJ_apply_to_layer adjR&, "Colorize"
        NEXT czT%
        IF czTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = czSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Glow dialog: RADIUS (1..20) + INTENSITY (0..100). Additively
' blends a blurred copy back over the image for a soft bloom. Alpha is preserved
' (apply_to_layer), so the glow stays within the shape. Live loupe; undo on OK.
'
SUB IMAGE_ADJ_glow_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM glRadius AS INTEGER : glRadius% = 5
    DIM glInten  AS INTEGER : glInten%  = 60
    DIM oRadius  AS INTEGER, oInten AS INTEGER

    DIM k AS LONG
    DIM d_glRadius AS INTEGER : d_glRadius% = 5
    DIM d_glInten AS INTEGER : d_glInten% = 60
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oRadius% = glRadius% : oInten% = glInten%
        glRadius% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, glRadius%, 1, 48)
        glRadius% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, glRadius%, 1, 48)
        glInten%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, glInten%, 0, 100)
        glInten%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, glInten%, 0, 100)
        IF glRadius% <> oRadius% OR glInten% <> oInten% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, glRadius%, glInten%, d_glRadius%, d_glInten%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = GJ_IMGADJ_Glow(ctx.origThumb, glRadius%, glInten%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "GLOW"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "RADIUS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, glRadius%, 1, 48, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "INTENSITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, glInten%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM glTargets(1 TO MAX_LAYERS) AS INTEGER, glTgtCount AS INTEGER, glT AS INTEGER
        DIM glSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets glTargets%(), glTgtCount%
        glSaveCL% = CURRENT_LAYER%
        IF glTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR glT% = 1 TO glTgtCount%
            CURRENT_LAYER% = glTargets%(glT%)
            adjR&          = GJ_IMGADJ_Glow(LAYERS(CURRENT_LAYER%).imgHandle&, glRadius%, glInten%)
            IMAGE_ADJ_apply_to_layer adjR&, "Glow"
        NEXT glT%
        IF glTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = glSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Film Grain dialog: a single AMOUNT slider (0..100) that adds
' monochrome photographic noise. Live loupe preview; multi-layer + undo on OK.
'
SUB IMAGE_ADJ_filmgrain_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM amount  AS INTEGER : amount% = 40
    DIM oAmount AS INTEGER

    DIM k AS LONG
    DIM d_amount AS INTEGER : d_amount% = 40
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oAmount% = amount%
        amount%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, 0, 100)
        amount%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amount%, 0, 100)
        IF amount% <> oAmount% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, amount%, d_amount%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = GJ_IMGADJ_FilmGrain(ctx.origThumb, amount%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "FILM GRAIN"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "AMOUNT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, amount%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM fgTargets(1 TO MAX_LAYERS) AS INTEGER, fgTgtCount AS INTEGER, fgT AS INTEGER
        DIM fgSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets fgTargets%(), fgTgtCount%
        fgSaveCL% = CURRENT_LAYER%
        IF fgTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR fgT% = 1 TO fgTgtCount%
            CURRENT_LAYER% = fgTargets%(fgT%)
            adjR&          = GJ_IMGADJ_FilmGrain(LAYERS(CURRENT_LAYER%).imgHandle&, amount%)
            IMAGE_ADJ_apply_to_layer adjR&, "Film Grain"
        NEXT fgT%
        IF fgTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = fgSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Vignette dialog: a single STRENGTH slider (0..100%) that darkens
' the image toward its edges/corners. Live loupe preview; multi-layer + undo.
'
SUB IMAGE_ADJ_vignette_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM strength  AS INTEGER : strength% = 60   ' percent (0..100)
    DIM oStrength AS INTEGER

    DIM k AS LONG
    DIM d_strength AS INTEGER : d_strength% = 60
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oStrength% = strength%
        strength%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, strength%, 0, 100)
        strength%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, strength%, 0, 100)
        IF strength% <> oStrength% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, strength%, d_strength%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = GJ_IMGADJ_Vignette(ctx.origThumb, strength% / 100.0)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "VIGNETTE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "STRENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, strength%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM vgTargets(1 TO MAX_LAYERS) AS INTEGER, vgTgtCount AS INTEGER, vgT AS INTEGER
        DIM vgSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets vgTargets%(), vgTgtCount%
        vgSaveCL% = CURRENT_LAYER%
        IF vgTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR vgT% = 1 TO vgTgtCount%
            CURRENT_LAYER% = vgTargets%(vgT%)
            adjR&          = GJ_IMGADJ_Vignette(LAYERS(CURRENT_LAYER%).imgHandle&, strength% / 100.0)
            IMAGE_ADJ_apply_to_layer adjR&, "Vignette"
        NEXT vgT%
        IF vgTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = vgSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Posterize adjustment dialog with a levels slider (2..16), an
' optional dither algorithm cycle button, and a dither strength slider. Live loupe
' preview shows the posterized (and optionally dithered) result. On OK, applies
' to the active layer with undo support.
'
SUB IMAGE_ADJ_posterize_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 170
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM levels      AS INTEGER : levels% = 4
    DIM oLevels     AS INTEGER
    DIM pdDither    AS INTEGER : pdDither% = DITHER_NONE
    DIM pdStrength  AS INTEGER : pdStrength% = 50
    DIM pdOldDither AS INTEGER, pdOldStr AS INTEGER

    ' Layout Y for dither controls (below levels slider)
    DIM pdDitherY AS INTEGER : pdDitherY% = IMGDLG_track_y%(ctx, 0) + 22
    DIM pdStrY    AS INTEGER : pdStrY% = pdDitherY% + 24

    ' Dither options as a dropdown: index 0 = OFF (DITHER_NONE), 1..N = algorithms.
    DIM pdDCount AS INTEGER : pdDCount% = DITHER_COUNT_ALL + 1
    REDIM pdDLabels(0 TO pdDCount% - 1) AS STRING
    pdDLabels$(0) = "DITHER: OFF"
    DIM pdi AS INTEGER
    FOR pdi% = 0 TO DITHER_COUNT_ALL - 1 : pdDLabels$(pdi% + 1) = DITHER_algorithm_name$(pdi%) : NEXT
    DIM pdDIdx AS INTEGER   ' dropdown index <-> pdDither value

    DIM k AS LONG
    DIM d_levels AS INTEGER : d_levels% = 4
    DIM d_pdStrength AS INTEGER : d_pdStrength% = 50
    DO
        DIALOG_poll_mouse ctx
        DIALOG_dropdown_input ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oLevels%     = levels%
        pdOldDither% = pdDither%
        pdOldStr%    = pdStrength%

        levels% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, levels%, 2, 64)
        levels% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, levels%, 2, 64)

        ' Dither dropdown (index 0 = OFF/DITHER_NONE, i>0 = algorithm i-1)
        IF pdDither% = DITHER_NONE THEN pdDIdx% = 0 ELSE pdDIdx% = pdDither% + 1
        pdDIdx% = DIALOG_dropdown%(ctx, 1, IMGDLG_SX, pdDitherY%, IMGDLG_SW, pdDIdx%, pdDLabels$(), pdDCount%)
        IF pdDIdx% = 0 THEN pdDither% = DITHER_NONE ELSE pdDither% = pdDIdx% - 1

        ' Strength slider
        IF pdDither% <> DITHER_NONE THEN
            pdStrength% = DIALOG_slider_drag%(ctx, IMGDLG_SX, pdStrY% + 14, IMGDLG_SW, 14, pdStrength%, 0, 100)
            pdStrength% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, pdStrY% + 14, IMGDLG_SW, 14, pdStrength%, 0, 100)
        END IF

        IF levels% <> oLevels% OR pdDither% <> pdOldDither% OR pdStrength% <> pdOldStr% THEN
            ctx.previewDirty% = TRUE
        END IF
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, levels%, pdStrength%, d_levels%, d_pdStrength%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            IF pdDither% <> DITHER_NONE THEN
                ' Dither the ORIGINAL down to `levels` per channel (true colour
                ' dithered posterization). The old posterize-THEN-dither path fed
                ' an already-quantized image into a 1-bit grayscale dither, which
                ' is why every colour collapsed to black/white.
                GJ_IMGADJ_DITHER_LEVELS = levels%
                ctx.previewThumb = DITHER_apply_to_image&(ctx.origThumb, pdDither%, pdStrength% / 100!)
                IF ctx.previewThumb >= -1 THEN ctx.previewThumb = GJ_IMGADJ_Posterize(ctx.origThumb, levels%)
            ELSE
                ctx.previewThumb = GJ_IMGADJ_Posterize(ctx.origThumb, levels%)
            END IF
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "POSTERIZE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "LEVELS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, levels%, 2, 64, "", ""

        ' Dither dropdown (closed box)
        DIALOG_dropdown_draw ctx, 1, IMGDLG_SX, pdDitherY%, IMGDLG_SW, pdDIdx%, pdDLabels$(), pdDCount%

        ' Strength slider
        IF pdDither% <> DITHER_NONE THEN
            DIALOG_draw_slider ctx, IMGDLG_SX, pdStrY% + 14, IMGDLG_SW, pdStrength%, 0, 100, "STRENGTH", "%"
        END IF

        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_dropdown_overlay ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM pdTargets(1 TO MAX_LAYERS) AS INTEGER, pdTgtCount AS INTEGER, pdT AS INTEGER
        DIM pdSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets pdTargets%(), pdTgtCount%
        pdSaveCL% = CURRENT_LAYER%
        IF pdTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR pdT% = 1 TO pdTgtCount%
            CURRENT_LAYER% = pdTargets%(pdT%)
            IF pdDither% <> DITHER_NONE THEN
                GJ_IMGADJ_DITHER_LEVELS = levels%
                adjR& = DITHER_apply_to_image&(LAYERS(CURRENT_LAYER%).imgHandle&, pdDither%, pdStrength% / 100!)
                IF adjR& >= -1 THEN adjR& = GJ_IMGADJ_Posterize(LAYERS(CURRENT_LAYER%).imgHandle&, levels%)
            ELSE
                adjR& = GJ_IMGADJ_Posterize(LAYERS(CURRENT_LAYER%).imgHandle&, levels%)
            END IF
            IMAGE_ADJ_apply_to_layer adjR&, "Posterize"
        NEXT pdT%
        IF pdTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = pdSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Pixelate adjustment dialog with a single pixel-size slider and live
' loupe preview. Pixel size ranges 2..32. On OK, applies pixelation to the active
' layer with undo support.
'
SUB IMAGE_ADJ_pixelate_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM pixSize  AS INTEGER : pixSize% = 4
    DIM oPixSize AS INTEGER

    DIM k AS LONG
    DIM d_pixSize AS INTEGER : d_pixSize% = 4
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oPixSize% = pixSize%
        pixSize%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, pixSize%, 2, 128)
        pixSize%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, pixSize%, 2, 128)
        IF pixSize% <> oPixSize% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, pixSize%, d_pixSize%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ' origThumb is a screen-space crop of SCRN.CANVAS& (the canvas drawn
            ' at SCRN.zoom), but the apply pixelates the layer in CANVAS pixels.
            ' Scale the preview block by zoom so the loupe is WYSIWYG — otherwise
            ' pixSize means screen-px here and canvas-px on apply (only equal at 1x).
            DIM pvPix AS INTEGER : pvPix% = INT(pixSize% * SCRN.zoom! + 0.5)
            IF pvPix% < 1 THEN pvPix% = 1
            ctx.previewThumb = GJ_IMGADJ_Pixelate(ctx.origThumb, pvPix%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "PIXELATE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "PIXEL SIZE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, pixSize%, 2, 128, "", " px"
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM pxTargets(1 TO MAX_LAYERS) AS INTEGER, pxTgtCount AS INTEGER, pxT AS INTEGER
        DIM pxSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets pxTargets%(), pxTgtCount%
        pxSaveCL% = CURRENT_LAYER%
        IF pxTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR pxT% = 1 TO pxTgtCount%
            CURRENT_LAYER% = pxTargets%(pxT%)
            adjR&          = IMAGE_ADJ_pixelate_alpha_aware&(LAYERS(CURRENT_LAYER%).imgHandle&, pixSize%)
            IMAGE_ADJ_apply_to_layer adjR&, "Pixelate"
        NEXT pxT%
        IF pxTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = pxSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Open a modal Remove Background dialog with an eyedropper color picker, a
' threshold slider (0..100, mapped to Euclidean distance 0..441), and a
' contiguous-mode toggle. Live loupe preview shows transparency as a
' checkerboard pattern.
'
' Unlike other adjustments, this intentionally MODIFIES the alpha channel
' (setting matching pixels to transparent). The standard apply_to_layer SUB
' preserves alpha, so a custom apply path is used here.
'
' PICK enters eyedropper mode: click the canvas to sample a background color.
' CONTIGUOUS toggle: when ON, only removes pixels connected to image edges
' (flood fill from borders), preserving interior "islands" of matching color.
' On OK, applies removal to the active layer with undo support.
'
SUB IMAGE_ADJ_remove_background_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 148
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    ' Default target color = current background color
    DIM targetColor AS _UNSIGNED LONG : targetColor~& = PAINT_BG_COLOR~&

    ' Threshold 0-100 slider (maps to Euclidean distance 0-441)
    DIM threshold  AS INTEGER : threshold% = 0
    DIM oThreshold AS INTEGER

    ' Contiguous mode toggle (default ON — smarter removal)
    DIM contiguous AS INTEGER : contiguous% = TRUE

    ' Eyedropper state
    DIM eyedropperMode AS INTEGER        : eyedropperMode% = FALSE
    DIM epWaitRelease  AS INTEGER        : epWaitRelease% = FALSE
    DIM sampleColor    AS _UNSIGNED LONG : sampleColor~& = targetColor~&

    ' Color row layout constants
    DIM colorRowY AS INTEGER ' Y of the color swatch/pick row
    DIM swatchX   AS INTEGER ' Color swatch X
    DIM swatchW   AS INTEGER ' Color swatch width
    DIM swatchH   AS INTEGER ' Color swatch height
    DIM pickBtnX  AS INTEGER ' PICK button X
    DIM pickBtnW  AS INTEGER ' PICK button width
    swatchX%  = IMGDLG_SX
    swatchW%  = 48
    swatchH%  = 14
    pickBtnX% = IMGDLG_SX + swatchW% + 8
    pickBtnW% = 50

    ' Slider and toggle Y positions (computed each frame from colorRowY)
    DIM sliderLabelY AS INTEGER
    DIM sliderTrackY AS INTEGER
    DIM toggleY      AS INTEGER

    ' Checkerboard tile for transparency preview
    DIM checkerTile AS LONG
    checkerTile& = _NEWIMAGE(8, 8, 32)
    DIM rbOldD      AS LONG : rbOldD& = _DEST
    _DEST checkerTile&
    CLS , _RGB32(180, 180, 180)
    LINE (0, 0)-(3, 3), _RGB32(220, 220, 220), BF
    LINE (4, 4)-(7, 7), _RGB32(220, 220, 220), BF
    _DEST rbOldD&

    ' Eyedropper variables
    DIM epMX      AS INTEGER, epMY AS INTEGER
    DIM epMB1     AS INTEGER
    DIM epOldSrc  AS LONG
    DIM epHintStr AS STRING
    DIM epHintW   AS INTEGER, epHintH AS INTEGER, epHintX AS INTEGER

    DIM k         AS LONG
    DIM rbResult  AS LONG
    DIM rawThresh AS INTEGER
    DIM tw        AS INTEGER, th AS INTEGER
    DIM prvD      AS LONG
    DIM cx        AS INTEGER, cy AS INTEGER
    DIM rgbStr    AS STRING

    DIM d_threshold AS INTEGER : d_threshold% = 0
    DIM d_contiguous AS INTEGER : d_contiguous% = TRUE
    DO
        IF eyedropperMode% THEN
            ' ---- EYEDROPPER MODE: show canvas, crosshair, sample on click ----
            WHILE _MOUSEINPUT : WEND
            epMX%  = _MOUSEX
            epMY%  = _MOUSEY
            epMB1% = _MOUSEBUTTON(1)

            ' Sample color from screenshot at mouse position
            IF ctx.screenShot < -1 THEN
                epOldSrc& = _SOURCE
                _SOURCE ctx.screenShot
                IF epMX% >= 0 AND epMX% < _WIDTH(ctx.screenShot) AND epMY% >= 0 AND epMY% < _HEIGHT(ctx.screenShot) THEN
                    sampleColor~& = POINT(epMX%, epMY%)
                END IF
                _SOURCE epOldSrc&
            END IF

            ' Draw canvas + crosshair
            _DEST 0
            IF ctx.screenShot < -1 THEN
                _DONTBLEND 0
                _PUTIMAGE , ctx.screenShot
                _BLEND 0
            END IF

            ' Crosshair lines with gap at center
            IF epMX% >= 0 AND epMX% < _WIDTH(0) AND epMY% >= 0 AND epMY% < _HEIGHT(0) THEN
                IF epMX% > 4 THEN LINE (0, epMY%)-(epMX% - 4, epMY%), _RGB32(255, 255, 255)
                IF epMX% < _WIDTH(0) - 5 THEN LINE (epMX% + 4, epMY%)-(_WIDTH(0) - 1, epMY%), _RGB32(255, 255, 255)
                IF epMY% > 4 THEN LINE (epMX%, 0)-(epMX%, epMY% - 4), _RGB32(255, 255, 255)
                IF epMY% < _HEIGHT(0) - 5 THEN LINE (epMX%, epMY% + 4)-(epMX%, _HEIGHT(0) - 1), _RGB32(255, 255, 255)

                ' Color swatch near cursor
                LINE (epMX% + 8, epMY% + 8)-(epMX% + 28, epMY% + 28), sampleColor~&, BF
                LINE (epMX% + 8, epMY% + 8)-(epMX% + 28, epMY% + 28), _RGB32(255, 255, 255), B
            END IF

            ' Hint text at top center
            epHintStr$ = "CLICK TO SAMPLE - ESC TO CANCEL"
            epHintW%   = _PRINTWIDTH(epHintStr$)
            epHintH%   = _UFONTHEIGHT
            epHintX%   = (_WIDTH(0) - epHintW%) \ 2
            LINE (epHintX% - 4, 2)-(epHintX% + epHintW% + 4, 4 + epHintH%), _RGBA32(0, 0, 0, 200), BF
            COLOR _RGB32(255, 255, 255)
            _UPRINTSTRING (epHintX%, 4), epHintStr$

            _DISPLAY
            _LIMIT CFG.FPS_DIALOG%

            ' Wait for initial button release before accepting clicks
            IF epWaitRelease% THEN
                IF NOT epMB1% THEN epWaitRelease% = FALSE
            ELSE
                IF epMB1% THEN
                    targetColor~&     = sampleColor~&
                    eyedropperMode%   = FALSE
                    ctx.previewDirty% = TRUE
                END IF
            END IF

            ' Escape cancels eyedropper
            k& = _KEYHIT
            IF k& = 27 THEN eyedropperMode% = FALSE
        ELSE
            ' ---- NORMAL DIALOG MODE ----
            DIALOG_poll_mouse ctx
            IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
            k& = _KEYHIT
            IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
            IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

            ' Color row Y position (first control row below preview)
            colorRowY% = 24 + ctx.prevH

            ' PICK button → enter eyedropper mode
            IF DIALOG_hit%(ctx, pickBtnX%, colorRowY%, pickBtnW%, swatchH%) THEN
                eyedropperMode% = TRUE
                epWaitRelease%  = TRUE
            END IF

            ' Slider and toggle Y positions
            sliderLabelY% = colorRowY% + swatchH% + 10
            sliderTrackY% = sliderLabelY% + 12
            toggleY%      = sliderTrackY% + 22

            ' Threshold slider
            oThreshold% = threshold%
            threshold%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, sliderTrackY%, IMGDLG_SW, 14, threshold%, 0, 100)
            threshold%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, sliderTrackY%, IMGDLG_SW, 14, threshold%, 0, 100)
            IF threshold% <> oThreshold% THEN ctx.previewDirty% = TRUE

            ' Contiguous toggle
            IF DIALOG_hit%(ctx, IMGDLG_SX, toggleY%, IMGDLG_SW, 14) THEN
                contiguous%       = NOT contiguous%
                ctx.previewDirty% = TRUE
            END IF

            IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, threshold%, contiguous%, d_threshold%, d_contiguous%

            ' Recompute preview when color, threshold, or mode changes
            IF ctx.previewDirty% THEN
                SAFE_FREEIMAGE ctx.previewThumb

                ' Map 0-100 slider to 0-441 Euclidean distance
                rawThresh% = INT(threshold% * 4.41 + 0.5)
                IF rawThresh% > 441 THEN rawThresh% = 441

                ' Run the appropriate removal algorithm on the preview thumbnail
                IF contiguous% THEN
                    rbResult& = GJ_IMGADJ_RemoveBackgroundContiguous(ctx.origThumb, targetColor~&, rawThresh%)
                ELSE
                    rbResult& = GJ_IMGADJ_RemoveBackground(ctx.origThumb, targetColor~&, rawThresh%)
                END IF

                ' Composite result onto checkerboard so transparency is visible
                tw%              = _WIDTH(ctx.origThumb)
                th%              = _HEIGHT(ctx.origThumb)
                ctx.previewThumb = _NEWIMAGE(tw%, th%, 32)
                prvD&            = _DEST
                _DEST ctx.previewThumb
                ' Tile checkerboard as background
                FOR cy% = 0 TO th% - 1 STEP 8
                    FOR cx% = 0 TO tw% - 1 STEP 8
                        _PUTIMAGE (cx%, cy%)-(cx% + 7, cy% + 7), checkerTile&
                    NEXT cx%
                NEXT cy%
                ' Composite the removed-background image on top (alpha blend)
                _BLEND ctx.previewThumb
                IF rbResult& < -1 THEN
                    _PUTIMAGE , rbResult&, ctx.previewThumb
                    SAFE_FREEIMAGE rbResult&
                END IF
                _DEST prvD&

                ' Do NOT call IMAGE_ADJ_mask_preview — we want to show the
                ' transparency effect, not restore original pixels.
                ctx.previewDirty% = FALSE
            END IF

            ' ---- Draw ----
            _DEST ctx.imgHandle
            DIALOG_draw_frame ctx, "REMOVE BACKGROUND"
            DIALOG_draw_preview ctx

            ' Color swatch + label
            DIALOG_draw_label ctx, IMGDLG_SX, colorRowY% - 12, "COLOR:"
            LINE (swatchX%, colorRowY%)-(swatchX% + swatchW%, colorRowY% + swatchH%), targetColor~&, BF
            LINE (swatchX%, colorRowY%)-(swatchX% + swatchW%, colorRowY% + swatchH%), _RGB32(160, 160, 160), B

            ' PICK button (eyedropper)
            DIALOG_draw_button ctx, pickBtnX%, colorRowY%, pickBtnW%, swatchH%, "PICK", _RGB32(60, 60, 80), _RGB32(80, 80, 120), _RGB32(120, 120, 160)

            ' RGB readout next to PICK button
            rgbStr$ = _TRIM$(STR$(_RED32(targetColor~&))) + "," + _TRIM$(STR$(_GREEN32(targetColor~&))) + "," + _TRIM$(STR$(_BLUE32(targetColor~&)))
            COLOR _RGB32(160, 160, 160)
            _UPRINTSTRING (pickBtnX% + pickBtnW% + 8, colorRowY% + 3), rgbStr$

            ' Threshold slider
            DIALOG_draw_label ctx, IMGDLG_SX, sliderLabelY%, "THRESHOLD:"
            DIALOG_draw_slider ctx, IMGDLG_SX, sliderTrackY%, IMGDLG_SW, threshold%, 0, 100, "", "%"

            ' Contiguous toggle
            DIALOG_draw_toggle ctx, IMGDLG_SX, toggleY%, IMGDLG_SW, 14, "CONTIGUOUS (EDGES ONLY)", contiguous%

            DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
            IMGDLG_draw_ok_cancel ctx
            DIALOG_blit ctx
        END IF
    LOOP UNTIL ctx.done%

    ' ---- Apply (custom — intentionally modifies alpha) ----
    IF ctx.result% THEN
        DIM rbTargets(1 TO MAX_LAYERS) AS INTEGER, rbTgtCount AS INTEGER, rbT AS INTEGER
        DIM rbSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets rbTargets%(), rbTgtCount%
        rbSaveCL% = CURRENT_LAYER%
        IF rbTgtCount% > 1 THEN HISTORY_begin_group
        FOR rbT% = 1 TO rbTgtCount%
            CURRENT_LAYER% = rbTargets%(rbT%)
            DIM applyLayerImg AS LONG
            applyLayerImg& = LAYERS(CURRENT_LAYER%).imgHandle&

            ' Snapshot original for undo
            DIM applySnap AS LONG
            applySnap& = _COPYIMAGE(applyLayerImg&, 32)

            ' Map threshold and run algorithm on the full layer image
            DIM applyThresh AS INTEGER
            applyThresh% = INT(threshold% * 4.41 + 0.5)
            IF applyThresh% > 441 THEN applyThresh% = 441

            DIM applyResult AS LONG
            IF contiguous% THEN
                applyResult& = GJ_IMGADJ_RemoveBackgroundContiguous(applyLayerImg&, targetColor~&, applyThresh%)
            ELSE
                applyResult& = GJ_IMGADJ_RemoveBackground(applyLayerImg&, targetColor~&, applyThresh%)
            END IF

            IF applyResult& < -1 THEN
                ' Blit with _DONTBLEND to overwrite alpha channel
                DIM applyOldD AS LONG : applyOldD& = _DEST
                _DEST applyLayerImg&
                _DONTBLEND applyLayerImg&
                CLS , _RGBA32(0, 0, 0, 0)
                _PUTIMAGE , applyResult&
                _BLEND applyLayerImg&
                _DEST applyOldD&
                SAFE_FREEIMAGE applyResult&

                ' Record undo
                IF applySnap& < -1 THEN
                    HISTORY_record_transform LAYERS(CURRENT_LAYER%).historyId&, CURRENT_LAYER%, 0, applySnap&, "Remove Background"
                    HISTORY_saved_this_frame% = TRUE
                END IF

                LAYERS(CURRENT_LAYER%).contentDirty% = TRUE
                INVALIDATE_layers
            ELSE
                ' Algorithm failed — free the snapshot
                SAFE_FREEIMAGE applySnap&
            END IF
        NEXT rbT%
        IF rbTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = rbSaveCL%
    END IF

    ' ---- Cleanup ----
    SAFE_FREEIMAGE checkerTile&
    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB
