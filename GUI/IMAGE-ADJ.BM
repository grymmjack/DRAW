''
' DRAW - GUI/IMAGE-ADJ.BM
' =============================================================================
' IMAGE menu adjustments - modal dialogs and direct operations.
' All operations apply permanently to the active layer and are undoable.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

' Layout constants shared by all dialogs
' Title bar: y=0..17, slider label at y=24+i*38, track at y=36+i*38 (h=14)
' Divider and OK/Cancel buttons near bottom (computed per dialog)
CONST IMGDLG_W      = 256 ' All dialogs are this wide
CONST IMGDLG_SX     = 8   ' Slider track left edge
CONST IMGDLG_SW     = 240 ' Slider track width
CONST IMGDLG_ANGLE_DIAL_R = 9 ' Compact angle-dial radius (shares a row with the angle slider)
CONST IMGDLG_OK_X    = 8   ' OK button X
CONST IMGDLG_OK_W    = 74  ' OK button width
CONST IMGDLG_RESET_X = 90  ' RESET button X (restores defaults)
CONST IMGDLG_RESET_W = 74  ' RESET button width
CONST IMGDLG_CX_X    = 174 ' Cancel button X
CONST IMGDLG_CX_W    = 74  ' Cancel button width
CONST IMGDLG_BTN_H   = 22  ' OK/Cancel/RESET button height
CONST IMGDLG_PREV_H = 144 ' Loupe preview pane height (pixels)


''
' Initialise image adjustment system. Call once at startup.
'
SUB IMAGE_ADJ_init ()
    GJ_IMGADJ_Init
END SUB


''
' Blit adjResult& into the active layer's imgHandle&, save undo state AFTER
' the modification, release adjResult& and mark everything dirty.
' Preserves _DEST context. Does nothing if adjResult& is invalid.
'
' The undo save happens AFTER pixel modification — matching STROKE_commit,
' flip, fill, and every other destructive operation. Ctrl+Z then restores
' the PREVIOUS checkpoint (the pre-adjustment content).
'
' GJ_IMGADJ functions use _RGB32(r,g,b) which forces alpha=255, destroying
' transparency. This SUB preserves the original alpha channel so transparent
' pixels stay transparent and semi-transparent pixels keep their opacity.
'
' @param adjResult LONG  New image handle returned by a GJ_IMGADJ_* call
' @param historyLabel STRING  Label used for unified history recording
'
SUB IMAGE_ADJ_apply_to_layer (adjResult AS LONG, historyLabel AS STRING)
    IF adjResult& < -1 THEN
        DIM adjLayerImg     AS LONG
        DIM historyRecorded AS INTEGER
        adjLayerImg&     = LAYERS(CURRENT_LAYER%).imgHandle&
        historyRecorded% = FALSE

        ' Snapshot the original image to preserve its alpha channel.
        DIM adjOrigSnap AS LONG
        adjOrigSnap& = _COPYIMAGE(adjLayerImg&, 32)

        ' Blit adjusted result onto the layer
        DIM oldDest AS LONG : oldDest& = _DEST
        _DEST adjLayerImg&
        _DONTBLEND adjLayerImg&
        CLS , _RGBA32(0, 0, 0, 0)
        _PUTIMAGE , adjResult&
        _BLEND adjLayerImg&
        _DEST oldDest&
        SAFE_FREEIMAGE adjResult&

        ' Restore original alpha channel — adjustments should only affect RGB,
        ' never alpha. Transparent pixels stay transparent, semi-transparent
        ' pixels keep their original opacity.
        DIM adjMemOrig AS _MEM, adjMemRes AS _MEM
        adjMemOrig = _MEMIMAGE(adjOrigSnap&)
        adjMemRes  = _MEMIMAGE(adjLayerImg&)
        DIM adjOff     AS _OFFSET
        DIM adjOrigA   AS _UNSIGNED _BYTE
        FOR adjOff = 0 TO adjMemRes.SIZE - 4 STEP 4
            _MEMGET adjMemOrig, adjMemOrig.OFFSET + adjOff + 3, adjOrigA~%%
            _MEMPUT adjMemRes, adjMemRes.OFFSET + adjOff + 3, adjOrigA~%% AS _UNSIGNED _BYTE
        NEXT adjOff
        _MEMFREE adjMemOrig
        _MEMFREE adjMemRes

        ' Clip to the active selection: only the selected region keeps the effect.
        IF EFFECT_CLIP_TO_SEL AND EFFECT_SEL_AS_SHAPE = 0 THEN
            IMGADJ_clip_to_selection adjLayerImg&, adjOrigSnap&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%
        END IF

        IF adjOrigSnap& < -1 THEN
            HISTORY_record_transform LAYERS(CURRENT_LAYER%).historyId&, CURRENT_LAYER%, 0, adjOrigSnap&, historyLabel$
            historyRecorded% = TRUE
        END IF

        IF historyRecorded% THEN HISTORY_saved_this_frame% = TRUE

        IMGADJ_capture_last_fx adjOrigSnap&, historyLabel$
        LAYERS(CURRENT_LAYER%).contentDirty% = TRUE
        INVALIDATE_layers
    END IF
END SUB


''
' Apply a spatial adjustment (blur) whose output already has correct RGBA.
' Same as IMAGE_ADJ_apply_to_layer but does NOT restore the original alpha,
' because blur should soften edges into transparency.
'
' @param adjResult    LONG    New image handle from a blur function
' @param historyLabel STRING  Label used for unified history recording
'
SUB IMAGE_ADJ_apply_spatial (adjResult AS LONG, historyLabel AS STRING)
    IF adjResult& < -1 THEN
        DIM asLayerImg AS LONG
        asLayerImg& = LAYERS(CURRENT_LAYER%).imgHandle&

        DIM asOrigSnap AS LONG
        asOrigSnap& = _COPYIMAGE(asLayerImg&, 32)

        DIM asOldDest AS LONG : asOldDest& = _DEST
        _DEST asLayerImg&
        _DONTBLEND asLayerImg&
        CLS , _RGBA32(0, 0, 0, 0)
        _PUTIMAGE , adjResult&
        _BLEND asLayerImg&
        _DEST asOldDest&
        SAFE_FREEIMAGE adjResult&

        ' No alpha restoration -- blur produces correct blurred RGBA output.

        ' Clip to the active selection: only the selected region keeps the effect.
        IF EFFECT_CLIP_TO_SEL AND EFFECT_SEL_AS_SHAPE = 0 THEN
            IMGADJ_clip_to_selection asLayerImg&, asOrigSnap&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%
        END IF

        IF asOrigSnap& < -1 THEN
            HISTORY_record_transform LAYERS(CURRENT_LAYER%).historyId&, CURRENT_LAYER%, 0, asOrigSnap&, historyLabel$
        END IF

        HISTORY_saved_this_frame% = TRUE

        IMGADJ_capture_last_fx asOrigSnap&, historyLabel$
        LAYERS(CURRENT_LAYER%).contentDirty% = TRUE
        INVALIDATE_layers
    END IF
END SUB


' =============================================================================
' SELECTION ↔ EFFECT interaction
' =============================================================================

''
' TRUE when an editable marquee/lasso selection is active on the canvas.
'
FUNCTION IMGADJ_sel_active% ()
    IMGADJ_sel_active% = FALSE
    IF NOT (MARQUEE.ACTIVE AND MARQUEE.USER_CREATED) THEN EXIT FUNCTION
    IF MARQUEE.WAND_HAS_SELECTION AND MARQUEE.SELECTION_MASK < -1 THEN IMGADJ_sel_active% = TRUE : EXIT FUNCTION
    IF MARQUEE.INITIALIZED THEN IMGADJ_sel_active% = TRUE
END FUNCTION

''
' Build a fresh canvas-sized coverage image (white RGB = inside the selection,
' black = outside) from whichever selection form is active — the per-pixel
' SELECTION_MASK (wand/lasso) or the rectangular BOX. Returns 0 if no selection;
' caller frees the handle.
'
FUNCTION IMGADJ_sel_coverage& ()
    IMGADJ_sel_coverage& = 0
    IF NOT IMGADJ_sel_active% THEN EXIT FUNCTION
    DIM cw AS LONG, ch AS LONG
    cw& = SCRN.canvasW& : ch& = SCRN.canvasH&
    IF cw& < 1 OR ch& < 1 THEN EXIT FUNCTION
    DIM cov AS LONG : cov& = _NEWIMAGE(cw&, ch&, 32)
    IF NOT (cov& < -1) THEN EXIT FUNCTION
    DIM oldD AS LONG : oldD& = _DEST
    _DEST cov& : _DONTBLEND cov& : CLS , _RGBA32(0, 0, 0, 255)
    IF MARQUEE.WAND_HAS_SELECTION AND MARQUEE.SELECTION_MASK < -1 THEN
        _BLEND cov& : _PUTIMAGE , MARQUEE.SELECTION_MASK, cov&   ' white-opaque inside over black
    ELSE
        LINE (MARQUEE.BOX.x, MARQUEE.BOX.y)-(MARQUEE.BOX.x + MARQUEE.BOX.w - 1, MARQUEE.BOX.y + MARQUEE.BOX.h - 1), _RGB32(255, 255, 255), BF
    END IF
    _BLEND cov& : _DEST oldD&
    IMGADJ_sel_coverage& = cov&
END FUNCTION

''
' Clip an already-applied effect to the active selection: restore the original
' pixels everywhere OUTSIDE the selection, so only the selected region keeps the
' effect. Layer buffer coords map to canvas coords via the per-layer apron
' (gotcha #14). No-op if no selection.
'
' @param layerImg LONG   The layer buffer (already holds the effect result)
' @param origSnap LONG   Snapshot of the layer taken BEFORE the effect
' @param apW/apH  INTEGER Per-layer apron offset
'
SUB IMGADJ_clip_to_selection (layerImg AS LONG, origSnap AS LONG, apW AS INTEGER, apH AS INTEGER)
    IF NOT (layerImg& < -1) OR NOT (origSnap& < -1) THEN EXIT SUB
    DIM cov AS LONG : cov& = IMGADJ_sel_coverage&
    IF NOT (cov& < -1) THEN EXIT SUB
    DIM lw AS LONG, lh AS LONG, cw AS LONG, ch AS LONG
    lw& = _WIDTH(layerImg&) : lh& = _HEIGHT(layerImg&)
    cw& = _WIDTH(cov&) : ch& = _HEIGHT(cov&)
    DIM lM AS _MEM, oM AS _MEM, cM AS _MEM
    lM = _MEMIMAGE(layerImg&) : oM = _MEMIMAGE(origSnap&) : cM = _MEMIMAGE(cov&)
    DIM bx AS LONG, by AS LONG, cx AS LONG, cy AS LONG, covR AS _UNSIGNED _BYTE, op AS _UNSIGNED LONG
    FOR by& = 0 TO lh& - 1
        cy& = by& - apH%
        FOR bx& = 0 TO lw& - 1
            cx& = bx& - apW%
            IF cx& >= 0 AND cy& >= 0 AND cx& < cw& AND cy& < ch& THEN
                _MEMGET cM, cM.OFFSET + (cy& * cw& + cx&) * 4 + 2, covR~%%   ' red channel = coverage
                IF covR~%% > 127 THEN _CONTINUE                              ' inside -> keep effect
            END IF
            _MEMGET oM, oM.OFFSET + (by& * lw& + bx&) * 4, op~&              ' outside -> restore original
            _MEMPUT lM, lM.OFFSET + (by& * lw& + bx&) * 4, op~& AS _UNSIGNED LONG
        NEXT bx&
    NEXT by&
    _MEMFREE lM : _MEMFREE oM : _MEMFREE cM
    SAFE_FREEIMAGE cov&
END SUB


' -----------------------------------------------------------------------------
' SELECTION-AS-SHAPE  (edge / growth effects: shadow, outline, glow, bevel, grow)
' -----------------------------------------------------------------------------
' Alpha-edge effects (drop shadow, outline, grow, glow, bevel, emboss) read the
' SOURCE image's alpha channel to locate the silhouette, then radiate an effect
' from that edge. On a solid layer there is no alpha edge, so they do nothing;
' and with CLIP-to-selection they get wiped, because they draw OUTSIDE the shape.
'
' When a selection is active we instead feed the effect a SILHOUETTE of the
' SELECTION (opaque inside, transparent outside, layer RGB retained) so it
' radiates from the selection edge. IMGADJ_composite_effect_only then keeps only
' the pixels the effect ADDED (result <> plain silhouette) and composites them
' over the untouched original layer — so the interior keeps its content and the
' shadow/outline/glow appears around (and, for inner effects, just inside) the
' selection edge. One choke point serves every edge effect.

''
' Build a selection-silhouette source image for an edge effect: a copy of the
' layer buffer whose alpha is forced OPAQUE inside the selection and TRANSPARENT
' outside it (RGB kept from the layer). Returns 0 when no selection is active —
' the caller then runs the effect on the raw layer (normal alpha-edge behaviour).
' Caller frees the returned handle. Buffer coords map to canvas via apron (#14).
'
FUNCTION IMGADJ_edge_shape_source& (layerImg AS LONG, apW AS INTEGER, apH AS INTEGER)
    IMGADJ_edge_shape_source& = 0
    IF NOT IMGADJ_sel_active% THEN EXIT FUNCTION
    IF NOT (layerImg& < -1) THEN EXIT FUNCTION
    DIM cov AS LONG : cov& = IMGADJ_sel_coverage&
    IF NOT (cov& < -1) THEN EXIT FUNCTION
    DIM lw AS LONG, lh AS LONG, cw AS LONG, ch AS LONG
    lw& = _WIDTH(layerImg&) : lh& = _HEIGHT(layerImg&)
    cw& = _WIDTH(cov&) : ch& = _HEIGHT(cov&)
    DIM shp AS LONG : shp& = _COPYIMAGE(layerImg&, 32)
    IF NOT (shp& < -1) THEN SAFE_FREEIMAGE cov& : EXIT FUNCTION
    DIM sM AS _MEM, cM AS _MEM
    sM = _MEMIMAGE(shp&) : cM = _MEMIMAGE(cov&)
    DIM bx AS LONG, by AS LONG, cx AS LONG, cy AS LONG, covR AS _UNSIGNED _BYTE
    DIM px AS _UNSIGNED LONG, insA AS _UNSIGNED _BYTE
    FOR by& = 0 TO lh& - 1
        cy& = by& - apH%
        FOR bx& = 0 TO lw& - 1
            cx& = bx& - apW%
            insA~%% = 0
            IF cx& >= 0 AND cy& >= 0 AND cx& < cw& AND cy& < ch& THEN
                _MEMGET cM, cM.OFFSET + (cy& * cw& + cx&) * 4 + 2, covR~%%
                IF covR~%% > 127 THEN insA~%% = 255
            END IF
            _MEMGET sM, sM.OFFSET + (by& * lw& + bx&) * 4, px~&
            px~& = _RGBA32(_RED32(px~&), _GREEN32(px~&), _BLUE32(px~&), insA~%%)
            _MEMPUT sM, sM.OFFSET + (by& * lw& + bx&) * 4, px~& AS _UNSIGNED LONG
        NEXT bx&
    NEXT by&
    _MEMFREE sM : _MEMFREE cM
    SAFE_FREEIMAGE cov&
    IMGADJ_edge_shape_source& = shp&
END FUNCTION

''
' Composite an edge-effect result onto the layer in SELECTION-AS-SHAPE mode.
' fxResult is what the effect produced from the selection silhouette (shapeSrc).
' For every pixel: if the result is UNCHANGED from the plain silhouette it is NOT
' an effect pixel, so the original layer (origSnap) is kept; otherwise the result
' pixel is composited source-over the original (effect on top). This preserves
' the selection interior and adds only the radiated shadow/outline/glow/bevel.
'
' @param layerImg LONG   Destination layer buffer (written in place)
' @param fxResult LONG   Effect output run on the silhouette
' @param shapeSrc LONG   The plain silhouette the effect was run on
' @param origSnap LONG   Snapshot of the layer BEFORE the effect
'
SUB IMGADJ_composite_effect_only (layerImg AS LONG, fxResult AS LONG, shapeSrc AS LONG, origSnap AS LONG)
    IF NOT (layerImg& < -1) OR NOT (fxResult& < -1) THEN EXIT SUB
    IF NOT (shapeSrc& < -1) OR NOT (origSnap& < -1) THEN EXIT SUB
    DIM fM AS _MEM, sM AS _MEM, oM AS _MEM, lM AS _MEM
    fM = _MEMIMAGE(fxResult&) : sM = _MEMIMAGE(shapeSrc&)
    oM = _MEMIMAGE(origSnap&) : lM = _MEMIMAGE(layerImg&)
    DIM ceOff AS _OFFSET, fp AS _UNSIGNED LONG, sp AS _UNSIGNED LONG, op AS _UNSIGNED LONG
    DIM fa AS INTEGER, oa AS INTEGER
    DIM saf AS SINGLE, daf AS SINGLE, oaf AS SINGLE
    DIM outR AS INTEGER, outG AS INTEGER, outB AS INTEGER, outA AS INTEGER
    FOR ceOff = 0 TO lM.SIZE - 4 STEP 4
        _MEMGET fM, fM.OFFSET + ceOff, fp~&
        _MEMGET sM, sM.OFFSET + ceOff, sp~&
        IF fp~& = sp~& THEN
            ' unchanged silhouette pixel -> keep the original layer here
            _MEMGET oM, oM.OFFSET + ceOff, op~&
            _MEMPUT lM, lM.OFFSET + ceOff, op~& AS _UNSIGNED LONG
        ELSE
            fa% = _ALPHA32(fp~&)
            IF fa% >= 255 THEN
                _MEMPUT lM, lM.OFFSET + ceOff, fp~& AS _UNSIGNED LONG          ' opaque effect
            ELSEIF fa% <= 0 THEN
                ' effect pixel is transparent. If it WAS inside the silhouette the
                ' effect ERODED it (shrink / inner erosion) -> clear the layer here;
                ' otherwise it's outside the effect's reach -> keep the original.
                IF _ALPHA32(sp~&) > 0 THEN
                    _MEMPUT lM, lM.OFFSET + ceOff, _RGBA32(0, 0, 0, 0) AS _UNSIGNED LONG
                ELSE
                    _MEMGET oM, oM.OFFSET + ceOff, op~& : _MEMPUT lM, lM.OFFSET + ceOff, op~& AS _UNSIGNED LONG
                END IF
            ELSE
                _MEMGET oM, oM.OFFSET + ceOff, op~&                            ' effect over original
                oa% = _ALPHA32(op~&)
                saf! = fa% / 255.0 : daf! = oa% / 255.0
                oaf! = saf! + daf! * (1.0 - saf!)
                IF oaf! <= 0.0 THEN
                    _MEMPUT lM, lM.OFFSET + ceOff, _RGBA32(0, 0, 0, 0) AS _UNSIGNED LONG
                ELSE
                    outR% = (_RED32(fp~&)   * saf! + _RED32(op~&)   * daf! * (1.0 - saf!)) / oaf!
                    outG% = (_GREEN32(fp~&) * saf! + _GREEN32(op~&) * daf! * (1.0 - saf!)) / oaf!
                    outB% = (_BLUE32(fp~&)  * saf! + _BLUE32(op~&)  * daf! * (1.0 - saf!)) / oaf!
                    outA% = oaf! * 255.0
                    IF outR% > 255 THEN outR% = 255
                    IF outG% > 255 THEN outG% = 255
                    IF outB% > 255 THEN outB% = 255
                    IF outA% > 255 THEN outA% = 255
                    _MEMPUT lM, lM.OFFSET + ceOff, _RGBA32(outR%, outG%, outB%, outA%) AS _UNSIGNED LONG
                END IF
            END IF
        END IF
    NEXT ceOff
    _MEMFREE fM : _MEMFREE sM : _MEMFREE oM : _MEMFREE lM
END SUB

''
' Apply an edge effect result to the current layer. When shapeSrc is a live
' selection silhouette (non-zero), composites the radiated effect over the
' original layer (SELECTION-AS-SHAPE); otherwise falls back to the normal
' alpha-preserving spatial apply. Records undo either way.
'
' @param adjResult LONG   Effect output (freed here)
' @param shapeSrc  LONG   Selection silhouette used, or 0 for the raw-layer path
' @param historyLabel STRING  Undo label
'
SUB IMAGE_ADJ_apply_spatial_edge (adjResult AS LONG, shapeSrc AS LONG, historyLabel AS STRING)
    IF NOT (adjResult& < -1) THEN EXIT SUB
    IF NOT (shapeSrc& < -1) THEN
        IMAGE_ADJ_apply_spatial adjResult&, historyLabel$
        EXIT SUB
    END IF
    DIM seLayer AS LONG : seLayer& = LAYERS(CURRENT_LAYER%).imgHandle&
    DIM seSnap AS LONG : seSnap& = _COPYIMAGE(seLayer&, 32)
    IMGADJ_composite_effect_only seLayer&, adjResult&, shapeSrc&, seSnap&
    SAFE_FREEIMAGE adjResult&
    IF seSnap& < -1 THEN HISTORY_record_transform LAYERS(CURRENT_LAYER%).historyId&, CURRENT_LAYER%, 0, seSnap&, historyLabel$
    HISTORY_saved_this_frame% = TRUE
    IMGADJ_capture_last_fx seSnap&, historyLabel$
    LAYERS(CURRENT_LAYER%).contentDirty% = TRUE
    INVALIDATE_layers
END SUB

''
' Compute the canvas-space bounding box of the active selection (rect BOX or the
' per-pixel wand/lasso mask). Returns TRUE and fills x0..y1 when a selection is
' present, FALSE otherwise.
'
FUNCTION IMGADJ_sel_bbox% (x0 AS LONG, y0 AS LONG, x1 AS LONG, y1 AS LONG)
    IMGADJ_sel_bbox% = FALSE
    IF NOT IMGADJ_sel_active% THEN EXIT FUNCTION
    IF MARQUEE.WAND_HAS_SELECTION AND MARQUEE.SELECTION_MASK < -1 THEN
        DIM mw AS LONG, mh AS LONG
        mw& = _WIDTH(MARQUEE.SELECTION_MASK) : mh& = _HEIGHT(MARQUEE.SELECTION_MASK)
        DIM bM AS _MEM : bM = _MEMIMAGE(MARQUEE.SELECTION_MASK)
        DIM bxr AS LONG, byr AS LONG, ba AS _UNSIGNED _BYTE, found AS INTEGER
        DIM mnx AS LONG, mny AS LONG, mxx AS LONG, mxy AS LONG
        mnx& = mw& : mny& = mh& : mxx& = -1 : mxy& = -1 : found% = 0
        FOR byr& = 0 TO mh& - 1
            FOR bxr& = 0 TO mw& - 1
                _MEMGET bM, bM.OFFSET + (byr& * mw& + bxr&) * 4 + 3, ba~%%
                IF ba~%% > 0 THEN
                    found% = 1
                    IF bxr& < mnx& THEN mnx& = bxr&
                    IF byr& < mny& THEN mny& = byr&
                    IF bxr& > mxx& THEN mxx& = bxr&
                    IF byr& > mxy& THEN mxy& = byr&
                END IF
            NEXT bxr&
        NEXT byr&
        _MEMFREE bM
        IF found% THEN
            x0& = mnx& : y0& = mny& : x1& = mxx& : y1& = mxy& : IMGADJ_sel_bbox% = TRUE
        END IF
    ELSE
        x0& = MARQUEE.BOX.x : y0& = MARQUEE.BOX.y
        x1& = MARQUEE.BOX.x + MARQUEE.BOX.w - 1 : y1& = MARQUEE.BOX.y + MARQUEE.BOX.h - 1
        IMGADJ_sel_bbox% = TRUE
    END IF
END FUNCTION

''
' Preview source for an edge-effect dialog: the selection silhouette thumb when a
' selection is active (so the engine radiates from the selection edge), else the
' plain layer crop. Both are the same padded size.
'
FUNCTION IMGADJ_fx_src& (ctx AS DIALOG_CTX)
    IF IMGADJ_sel_active% AND IMGADJ_SHAPE_THUMB& < -1 THEN
        IMGADJ_fx_src& = IMGADJ_SHAPE_THUMB&
    ELSE
        IMGADJ_fx_src& = ctx.origThumb
    END IF
END FUNCTION

''
' Finish an edge-effect preview. With a selection active, composites only the
' radiated effect (previewThumb vs the silhouette) over the real layer crop —
' mirroring the sel-as-shape apply. Without a selection: alpha-preserving effects
' (growth = 0) get the layer-alpha mask; growth effects show the raw result.
'
SUB IMAGE_ADJ_fx_preview_finish (ctx AS DIALOG_CTX, growth AS INTEGER)
    IF IMGADJ_sel_active% AND IMGADJ_SHAPE_THUMB& < -1 AND ctx.previewThumb < -1 AND ctx.origThumb < -1 THEN
        IMGADJ_composite_effect_only ctx.previewThumb, ctx.previewThumb, IMGADJ_SHAPE_THUMB&, ctx.origThumb
    ELSEIF growth% = 0 THEN
        IMAGE_ADJ_mask_preview ctx
    END IF
END SUB


' =============================================================================
' LAST-EFFECT MEMORY  —  Redo / Recall / Blend (Fade)   [Photoshop-style]
' =============================================================================

''
' Called by the shared apply funcs right after an effect commits: remembers the
' effect (action id + label), the layer it hit, and BEFORE/AFTER snapshots so
' Blend/Fade can recomposite. No-op during a Blend (so a fade isn't itself
' recorded as the "last effect") and for non-effect actions (FX_PENDING_ACTION 0).
'
' @param beforeSnap LONG  Snapshot of the layer BEFORE the effect
' @param historyLabel STRING  The effect's undo label
'
SUB IMGADJ_capture_last_fx (beforeSnap AS LONG, historyLabel AS STRING)
    IF FX_IN_BLEND THEN EXIT SUB
    IF FX_PENDING_ACTION = 0 THEN EXIT SUB
    SAFE_FREEIMAGE LAST_FX_BEFORE& : LAST_FX_BEFORE& = 0
    SAFE_FREEIMAGE LAST_FX_AFTER&  : LAST_FX_AFTER&  = 0
    IF beforeSnap& < -1 THEN LAST_FX_BEFORE& = _COPYIMAGE(beforeSnap&, 32)
    IF LAYERS(CURRENT_LAYER%).imgHandle& < -1 THEN LAST_FX_AFTER& = _COPYIMAGE(LAYERS(CURRENT_LAYER%).imgHandle&, 32)
    LAST_FX_LAYER%      = CURRENT_LAYER%
    LAST_FX_ACTION%     = FX_PENDING_ACTION
    LAST_FX_LABEL$      = historyLabel$
    LAST_FX_REPLAYABLE% = FALSE   ' a Layer-FX dialog sets TRUE after stashing params
END SUB

''
' Stash the parameters of the just-applied effect so IMAGE_ADJ_redo_last can
' re-run it with no dialog. Call from a Layer-FX dialog's OK branch (after apply).
'
SUB IMGADJ_stash_fx (p0 AS INTEGER, p1 AS INTEGER, p2 AS INTEGER, p3 AS INTEGER)
    LAST_FX_P(0) = p0% : LAST_FX_P(1) = p1% : LAST_FX_P(2) = p2% : LAST_FX_P(3) = p3%
    LAST_FX_REPLAYABLE% = TRUE
END SUB

''
' Re-run one edge effect on the last-effect layer using stashed params (used by
' IMAGE_ADJ_redo_last). Handles sel-as-shape + the raw-layer fallback like the
' dialogs do. spatial% picks the alpha-keeping (1) vs alpha-preserving (0) commit.
'
SUB IMGADJ_replay_edge (adjResult AS LONG, edgeSrc AS LONG, historyLabel AS STRING, spatial AS INTEGER)
    IF edgeSrc& < -1 THEN
        IMAGE_ADJ_apply_spatial_edge adjResult&, edgeSrc&, historyLabel$
    ELSEIF spatial% THEN
        IMAGE_ADJ_apply_spatial adjResult&, historyLabel$
    ELSE
        IMAGE_ADJ_apply_to_layer adjResult&, historyLabel$
    END IF
END SUB

''
' RECALL LAST EFFECT — re-open the last effect's dialog (user tweaks + re-applies).
'
SUB IMAGE_ADJ_recall_last ()
    IF LAST_FX_ACTION% = 0 THEN EXIT SUB
    CMD_execute_action LAST_FX_ACTION%
END SUB

''
' REDO LAST EFFECT — re-apply the last effect instantly (no dialog) with the same
' settings. Layer-FX effects that stashed params replay through the engine; any
' other effect falls back to re-opening its dialog.
'
SUB IMAGE_ADJ_redo_last ()
    IF LAST_FX_ACTION% = 0 THEN EXIT SUB
    IF CURRENT_LAYER% < 1 THEN EXIT SUB
    IF NOT LAST_FX_REPLAYABLE% THEN CMD_execute_action LAST_FX_ACTION% : EXIT SUB

    DIM rLayer AS LONG, rApW AS INTEGER, rApH AS INTEGER, rEdge AS LONG, adjR AS LONG
    rLayer& = LAYERS(CURRENT_LAYER%).imgHandle&
    rApW%   = LAYERS(CURRENT_LAYER%).apronW% : rApH% = LAYERS(CURRENT_LAYER%).apronH%
    rEdge&  = IMGADJ_edge_shape_source&(rLayer&, rApW%, rApH%)
    DIM rSrc AS LONG : rSrc& = rLayer& : IF rEdge& < -1 THEN rSrc& = rEdge&
    FX_PENDING_ACTION = LAST_FX_ACTION%      ' so the replay re-captures for chaining

    SELECT CASE LAST_FX_ACTION%
        CASE 2124  ' Drop Shadow: P0=dist P1=soft P2=angle P3=opac
            adjR& = IMAGE_ADJ_dropshadow&(rSrc&, LAST_FX_P(0), LAST_FX_P(1), LAST_FX_P(2), LAST_FX_P(3), PAINT_BG_COLOR~&)
            IMGADJ_replay_edge adjR&, rEdge&, "Drop Shadow", 1
        CASE 2125  ' Long Shadow: P0=length P1=angle P2=soften P3=fade
            adjR& = IMAGE_ADJ_longshadow&(rSrc&, LAST_FX_P(0), LAST_FX_P(1), PAINT_BG_COLOR~&, LAST_FX_P(2), LAST_FX_P(3))
            IMGADJ_replay_edge adjR&, rEdge&, "Long Shadow", 1
        CASE 2110  ' Outline: P0=thickness P1=insideMode
            adjR& = IMAGE_ADJ_outline&(rSrc&, LAST_FX_P(0), PAINT_COLOR~&, LAST_FX_P(1))
            IMGADJ_replay_edge adjR&, rEdge&, "Outline", 1
        CASE 2113  ' Grow / Shrink: P0=amount P1=shrinkMode
            adjR& = IMAGE_ADJ_growshrink&(rSrc&, LAST_FX_P(0), LAST_FX_P(1))
            IMGADJ_replay_edge adjR&, rEdge&, "Grow / Shrink", 1
        CASE ELSE
            IF rEdge& < -1 THEN SAFE_FREEIMAGE rEdge&
            CMD_execute_action LAST_FX_ACTION%   ' not stashed — fall back to the dialog
            EXIT SUB
    END SELECT
    IF rEdge& < -1 THEN SAFE_FREEIMAGE rEdge&
END SUB

''
' Composite BEFORE and AFTER for Blend/Fade: out = lerp(before, mode(before,after),
' opac). mode 0=Normal 1=Multiply 2=Screen 3=Overlay 4=Darken 5=Lighten. Writes
' the result into destLayer (same dims as before/after).
'
SUB IMGADJ_blend_compose (destLayer AS LONG, beforeImg AS LONG, afterImg AS LONG, opac AS INTEGER, mode AS INTEGER)
    IF NOT (destLayer& < -1) OR NOT (beforeImg& < -1) OR NOT (afterImg& < -1) THEN EXIT SUB
    DIM bM AS _MEM, aM AS _MEM, dM AS _MEM
    bM = _MEMIMAGE(beforeImg&) : aM = _MEMIMAGE(afterImg&) : dM = _MEMIMAGE(destLayer&)
    DIM t AS SINGLE : t! = opac% / 100.0
    DIM po AS _OFFSET, bp AS _UNSIGNED LONG, ap AS _UNSIGNED LONG
    DIM br AS INTEGER, bg AS INTEGER, bb AS INTEGER, ba AS INTEGER
    DIM ar AS INTEGER, ag AS INTEGER, ab AS INTEGER, aa AS INTEGER
    DIM mr AS INTEGER, mg AS INTEGER, mb AS INTEGER
    DIM orC AS INTEGER, ogC AS INTEGER, obC AS INTEGER, oaC AS INTEGER
    FOR po = 0 TO dM.SIZE - 4 STEP 4
        _MEMGET bM, bM.OFFSET + po, bp~& : _MEMGET aM, aM.OFFSET + po, ap~&
        br% = _RED32(bp~&) : bg% = _GREEN32(bp~&) : bb% = _BLUE32(bp~&) : ba% = _ALPHA32(bp~&)
        ar% = _RED32(ap~&) : ag% = _GREEN32(ap~&) : ab% = _BLUE32(ap~&) : aa% = _ALPHA32(ap~&)
        SELECT CASE mode%
            CASE 1 : mr% = br% * ar% \ 255 : mg% = bg% * ag% \ 255 : mb% = bb% * ab% \ 255
            CASE 2 : mr% = 255 - (255 - br%) * (255 - ar%) \ 255 : mg% = 255 - (255 - bg%) * (255 - ag%) \ 255 : mb% = 255 - (255 - bb%) * (255 - ab%) \ 255
            CASE 3 ' Overlay
                mr% = IIFOVL%(br%, ar%) : mg% = IIFOVL%(bg%, ag%) : mb% = IIFOVL%(bb%, ab%)
            CASE 4 : mr% = _IIF(br% < ar%, br%, ar%) : mg% = _IIF(bg% < ag%, bg%, ag%) : mb% = _IIF(bb% < ab%, bb%, ab%)
            CASE 5 : mr% = _IIF(br% > ar%, br%, ar%) : mg% = _IIF(bg% > ag%, bg%, ag%) : mb% = _IIF(bb% > ab%, bb%, ab%)
            CASE ELSE : mr% = ar% : mg% = ag% : mb% = ab%
        END SELECT
        orC% = br% + (mr% - br%) * t! : ogC% = bg% + (mg% - bg%) * t! : obC% = bb% + (mb% - bb%) * t!
        oaC% = ba% + (aa% - ba%) * t!
        _MEMPUT dM, dM.OFFSET + po, _RGBA32(orC%, ogC%, obC%, oaC%) AS _UNSIGNED LONG
    NEXT po
    _MEMFREE bM : _MEMFREE aM : _MEMFREE dM
END SUB

''
' BLEND / FADE LAST EFFECT — reduce the just-applied effect's strength and change
' how it composites over the pre-effect layer, like Photoshop's Edit > Fade.
' Opacity 0 = pre-effect, 100 = full effect. Applies live to the layer; OK keeps
' it (one undo state before->faded), Cancel restores the full effect.
'
SUB IMAGE_ADJ_blend_last ()
    IF NOT (LAST_FX_BEFORE& < -1) OR NOT (LAST_FX_AFTER& < -1) THEN EXIT SUB
    IF LAST_FX_LAYER% < 1 OR LAST_FX_LAYER% > MAX_LAYERS THEN EXIT SUB
    DIM bLayer AS LONG : bLayer& = LAYERS(LAST_FX_LAYER%).imgHandle&
    IF NOT (bLayer& < -1) THEN EXIT SUB
    IF _WIDTH(bLayer&) <> _WIDTH(LAST_FX_AFTER&) OR _HEIGHT(bLayer&) <> _HEIGHT(LAST_FX_AFTER&) THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 130

    DIM opac AS INTEGER : opac% = 100
    DIM oOpac AS INTEGER
    STATIC mode AS INTEGER
    DIM mvX AS INTEGER, mvY AS INTEGER, mvW AS INTEGER, mvH AS INTEGER
    mvX% = IMGDLG_SX : mvW% = 160 : mvH% = 16
    mvY% = IMGDLG_track_y%(ctx, 0) + 26

    FX_IN_BLEND = TRUE
    DIM applied AS INTEGER : applied% = -1     ' force first compose
    DIM k AS LONG, mName AS STRING
    DO
        DIALOG_poll_mouse ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oOpac% = opac%
        opac% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, opac%, 0, 100)
        opac% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, opac%, 0, 100)
        IF DIALOG_hit%(ctx, mvX%, mvY%, mvW%, mvH%) THEN mode% = (mode% + 1) MOD 6 : applied% = -2
        IF opac% <> oOpac% THEN applied% = -2
        IMGDLG_check_ok_cancel ctx                                   ' OK / RESET / CANCEL buttons
        IF IMGDLG_RESET_CLICKED% THEN opac% = 100 : mode% = 0 : applied% = -2 : IMGDLG_RESET_CLICKED% = FALSE

        IF applied% <> 0 THEN
            IMGADJ_blend_compose bLayer&, LAST_FX_BEFORE&, LAST_FX_AFTER&, opac%, mode%
            LAYERS(LAST_FX_LAYER%).contentDirty% = TRUE : INVALIDATE_layers
            ' Render the canvas WITHOUT letting SCREEN_render flush to screen — else
            ' the dialog vanishes for a frame (flicker). We composite canvas + dialog
            ' ourselves and let DIALOG_blit do the single _DISPLAY below.
            SCENE_DIRTY% = TRUE : SCREEN_SUPPRESS_DISPLAY% = TRUE : SCREEN_render : SCREEN_SUPPRESS_DISPLAY% = FALSE
            _PUTIMAGE (0, 0)-(_WIDTH(0) - 1, _HEIGHT(0) - 1), SCRN.CANVAS&, 0
            SAFE_FREEIMAGE ctx.screenShot : ctx.screenShot = _COPYIMAGE(0, 32)
            applied% = 0
        END IF

        SELECT CASE mode%
            CASE 1 : mName$ = "MULTIPLY"
            CASE 2 : mName$ = "SCREEN"
            CASE 3 : mName$ = "OVERLAY"
            CASE 4 : mName$ = "DARKEN"
            CASE 5 : mName$ = "LIGHTEN"
            CASE ELSE : mName$ = "NORMAL"
        END SELECT

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "BLEND LAST: " + LAST_FX_LABEL$
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "OPACITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, opac%, 0, 100, "", ""
        DIALOG_draw_toggle ctx, mvX%, mvY%, mvW%, mvH%, "MODE: " + mName$, -1
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM bSnap AS LONG : bSnap& = _COPYIMAGE(LAST_FX_BEFORE&, 32)
        IF bSnap& < -1 THEN HISTORY_record_transform LAYERS(LAST_FX_LAYER%).historyId&, LAST_FX_LAYER%, 0, bSnap&, "Fade " + LAST_FX_LABEL$
        HISTORY_saved_this_frame% = TRUE
        ' the faded pixels are already in the layer; capture them as the new AFTER
        SAFE_FREEIMAGE LAST_FX_AFTER& : LAST_FX_AFTER& = _COPYIMAGE(bLayer&, 32)
    ELSE
        IMGADJ_blend_compose bLayer&, LAST_FX_BEFORE&, LAST_FX_AFTER&, 100, 0   ' restore full effect
    END IF
    LAYERS(LAST_FX_LAYER%).contentDirty% = TRUE : INVALIDATE_layers
    FX_IN_BLEND = FALSE
    DIALOG_cleanup ctx
END SUB

''
' Overlay blend of two 0..255 channel values (helper for IMGADJ_blend_compose).
'
FUNCTION IIFOVL% (ovlB AS INTEGER, ovlT AS INTEGER)
    IF ovlB% < 128 THEN
        IIFOVL% = 2 * ovlB% * ovlT% \ 255
    ELSE
        IIFOVL% = 255 - 2 * (255 - ovlB%) * (255 - ovlT%) \ 255
    END IF
END FUNCTION


''
' Premultiplied-alpha box blur: blurs all 4 channels (R, G, B, A).
' Uses premultiplied alpha to avoid dark fringe at edges:
'   1. Convert source to premultiplied alpha  (R*=R*A/255 etc.)
'   2. Box-blur all 4 premultiplied channels
'   3. Un-premultiply the result  (R=R'*255/A)
'
' This produces correct soft-edge blur into transparency -- edges become
' semi-transparent and colours stay true.
'
' @param sourceImg LONG     Source image handle
' @param radius    INTEGER  Blur radius (kernel is (2*radius+1)^2)
' @return LONG  New blurred image handle with correct RGBA, or 0 on error
'
''
' Draw a throttled "working…" progress overlay so a long effect doesn't look like
' a lockup. Heavy engines call this from their outer loop; it only actually
' redraws ~12x/sec (TIMER-throttled) and is a no-op for small images (previews).
' The overlay is transient — the next full SCREEN_render wipes it.
' @param label STRING  What is happening (e.g. "Blurring")
' @param frac  SINGLE  Progress 0..1
'
SUB IMGADJ_progress_tick (label AS STRING, frac AS SINGLE)
    STATIC lastDraw AS SINGLE, opStart AS SINGLE, lastCall AS SINGLE
    DIM nowT AS SINGLE : nowT! = TIMER
    ' A gap since the previous call means a NEW operation started — restart the clock.
    IF ABS(nowT! - lastCall!) > 0.4 THEN opStart! = nowT!
    lastCall! = nowT!
    ' Skip fast ops entirely (no flash), and throttle redraws to ~14 fps.
    IF frac! < 1.0 THEN
        IF nowT! - opStart! < 0.18 THEN EXIT SUB
        IF ABS(nowT! - lastDraw!) < 0.07 THEN EXIT SUB
    END IF
    lastDraw! = nowT!

    DIM od AS LONG : od& = _DEST
    DIM ofn AS LONG : ofn& = _FONT
    _DEST 0
    _FONT 16
    DIM sw AS LONG, sh AS LONG : sw& = _WIDTH(0) : sh& = _HEIGHT(0)
    DIM barW AS LONG : barW& = 420 : IF barW& > sw& - 40 THEN barW& = sw& - 40
    DIM barH AS LONG : barH& = 26
    DIM bx AS LONG : bx& = (sw& - barW&) \ 2
    DIM byy AS LONG : byy& = (sh& - barH&) \ 2
    LINE (bx& - 14, byy& - 34)-(bx& + barW& + 14, byy& + barH& + 14), _RGB32(18, 18, 24), BF
    LINE (bx& - 14, byy& - 34)-(bx& + barW& + 14, byy& + barH& + 14), _RGB32(90, 90, 110), B
    LINE (bx&, byy&)-(bx& + barW& - 1, byy& + barH& - 1), _RGB32(45, 45, 55), BF
    DIM fw AS LONG : fw& = barW& * frac! : IF fw& < 0 THEN fw& = 0
    IF fw& > barW& THEN fw& = barW&
    IF fw& > 0 THEN LINE (bx&, byy&)-(bx& + fw& - 1, byy& + barH& - 1), _RGB32(70, 160, 255), BF
    COLOR _RGB32(235, 235, 245), _RGB32(18, 18, 24)
    _PRINTSTRING (bx&, byy& - 26), label$ + " ... " + _TRIM$(STR$(INT(frac! * 100.0))) + "%"
    _DISPLAY
    _FONT ofn&
    _DEST od&
END SUB

''
' Premultiplied-alpha box blur, SEPARABLE (two running-sum passes: horizontal then
' vertical). O(1) per pixel regardless of radius — no more O(radius^2) freeze — so
' large blur/glow/soft-shadow radii stay fast. Premultiplies, blurs all 4 channels,
' un-premultiplies. Shows a progress overlay on big images.
'
FUNCTION IMAGE_ADJ_blur_premul_rgba& (sourceImg AS LONG, radius AS INTEGER)
    IF NOT (sourceImg& < -1) THEN
        IMAGE_ADJ_blur_premul_rgba& = 0
        EXIT FUNCTION
    END IF

    DIM bprW AS LONG, bprH AS LONG
    bprW& = _WIDTH(sourceImg&) : bprH& = _HEIGHT(sourceImg&)

    IF radius% <= 0 THEN
        IMAGE_ADJ_blur_premul_rgba& = _COPYIMAGE(sourceImg&, 32)
        EXIT FUNCTION
    END IF

    DIM bprShowProg AS INTEGER : bprShowProg% = (bprW& * bprH& >= 120000)

    ' --- Step 1: premultiplied-alpha copy ---
    DIM bprPremul AS LONG : bprPremul& = _NEWIMAGE(bprW&, bprH&, 32)
    DIM bprHBlur AS LONG : bprHBlur& = _NEWIMAGE(bprW&, bprH&, 32)
    DIM bprResult AS LONG : bprResult& = _NEWIMAGE(bprW&, bprH&, 32)
    DIM bprSrcM AS _MEM, bprPMM AS _MEM, bprHM AS _MEM, bprResM AS _MEM
    bprSrcM = _MEMIMAGE(sourceImg&) : bprPMM = _MEMIMAGE(bprPremul&)
    bprHM = _MEMIMAGE(bprHBlur&) : bprResM = _MEMIMAGE(bprResult&)

    DIM bprOff AS _OFFSET, bprPx AS _UNSIGNED LONG
    DIM bprR AS INTEGER, bprG AS INTEGER, bprB AS INTEGER, bprA AS INTEGER
    FOR bprOff = 0 TO bprSrcM.SIZE - 4 STEP 4
        _MEMGET bprSrcM, bprSrcM.OFFSET + bprOff, bprPx~&
        bprA% = _ALPHA32(bprPx~&)
        IF bprA% > 0 THEN
            bprR% = _RED32(bprPx~&) * bprA% \ 255
            bprG% = _GREEN32(bprPx~&) * bprA% \ 255
            bprB% = _BLUE32(bprPx~&) * bprA% \ 255
        ELSE
            bprR% = 0 : bprG% = 0 : bprB% = 0
        END IF
        _MEMPUT bprPMM, bprPMM.OFFSET + bprOff, _RGBA32(bprR%, bprG%, bprB%, bprA%) AS _UNSIGNED LONG
    NEXT bprOff
    _MEMFREE bprSrcM

    DIM bprX AS LONG, bprY AS LONG
    DIM sumR AS LONG, sumG AS LONG, sumB AS LONG, sumA AS LONG, cnt AS LONG
    DIM lo AS LONG, hi AS LONG, smp AS _UNSIGNED LONG, rowBase AS _OFFSET

    ' --- Step 2: HORIZONTAL running-sum pass (premul -> hblur) ---
    FOR bprY& = 0 TO bprH& - 1
        rowBase = bprY& * bprW& * 4
        sumR& = 0 : sumG& = 0 : sumB& = 0 : sumA& = 0 : cnt& = 0
        hi& = radius% : IF hi& > bprW& - 1 THEN hi& = bprW& - 1
        FOR bprX& = 0 TO hi&
            _MEMGET bprPMM, bprPMM.OFFSET + rowBase + bprX& * 4, smp~&
            sumR& = sumR& + _RED32(smp~&) : sumG& = sumG& + _GREEN32(smp~&)
            sumB& = sumB& + _BLUE32(smp~&) : sumA& = sumA& + _ALPHA32(smp~&) : cnt& = cnt& + 1
        NEXT bprX&
        FOR bprX& = 0 TO bprW& - 1
            IF cnt& > 0 THEN _MEMPUT bprHM, bprHM.OFFSET + rowBase + bprX& * 4, _RGBA32(sumR& \ cnt&, sumG& \ cnt&, sumB& \ cnt&, sumA& \ cnt&) AS _UNSIGNED LONG
            lo& = bprX& - radius%
            IF lo& >= 0 THEN
                _MEMGET bprPMM, bprPMM.OFFSET + rowBase + lo& * 4, smp~&
                sumR& = sumR& - _RED32(smp~&) : sumG& = sumG& - _GREEN32(smp~&)
                sumB& = sumB& - _BLUE32(smp~&) : sumA& = sumA& - _ALPHA32(smp~&) : cnt& = cnt& - 1
            END IF
            hi& = bprX& + radius% + 1
            IF hi& < bprW& THEN
                _MEMGET bprPMM, bprPMM.OFFSET + rowBase + hi& * 4, smp~&
                sumR& = sumR& + _RED32(smp~&) : sumG& = sumG& + _GREEN32(smp~&)
                sumB& = sumB& + _BLUE32(smp~&) : sumA& = sumA& + _ALPHA32(smp~&) : cnt& = cnt& + 1
            END IF
        NEXT bprX&
        IF bprShowProg% AND (bprY& AND 31) = 0 THEN IMGADJ_progress_tick "Blurring", (bprY& / bprH&) * 0.5
    NEXT bprY&

    ' --- Step 3: VERTICAL running-sum pass (hblur -> result, un-premultiply) ---
    DIM ba AS INTEGER, fr AS INTEGER, fg AS INTEGER, fb AS INTEGER
    FOR bprX& = 0 TO bprW& - 1
        sumR& = 0 : sumG& = 0 : sumB& = 0 : sumA& = 0 : cnt& = 0
        hi& = radius% : IF hi& > bprH& - 1 THEN hi& = bprH& - 1
        FOR bprY& = 0 TO hi&
            _MEMGET bprHM, bprHM.OFFSET + (bprY& * bprW& + bprX&) * 4, smp~&
            sumR& = sumR& + _RED32(smp~&) : sumG& = sumG& + _GREEN32(smp~&)
            sumB& = sumB& + _BLUE32(smp~&) : sumA& = sumA& + _ALPHA32(smp~&) : cnt& = cnt& + 1
        NEXT bprY&
        FOR bprY& = 0 TO bprH& - 1
            IF cnt& > 0 THEN
                ba% = sumA& \ cnt&
                IF ba% > 0 THEN
                    fr% = (sumR& \ cnt&) * 255 \ ba% : IF fr% > 255 THEN fr% = 255
                    fg% = (sumG& \ cnt&) * 255 \ ba% : IF fg% > 255 THEN fg% = 255
                    fb% = (sumB& \ cnt&) * 255 \ ba% : IF fb% > 255 THEN fb% = 255
                    _MEMPUT bprResM, bprResM.OFFSET + (bprY& * bprW& + bprX&) * 4, _RGBA32(fr%, fg%, fb%, ba%) AS _UNSIGNED LONG
                END IF
            END IF
            lo& = bprY& - radius%
            IF lo& >= 0 THEN
                _MEMGET bprHM, bprHM.OFFSET + (lo& * bprW& + bprX&) * 4, smp~&
                sumR& = sumR& - _RED32(smp~&) : sumG& = sumG& - _GREEN32(smp~&)
                sumB& = sumB& - _BLUE32(smp~&) : sumA& = sumA& - _ALPHA32(smp~&) : cnt& = cnt& - 1
            END IF
            hi& = bprY& + radius% + 1
            IF hi& < bprH& THEN
                _MEMGET bprHM, bprHM.OFFSET + (hi& * bprW& + bprX&) * 4, smp~&
                sumR& = sumR& + _RED32(smp~&) : sumG& = sumG& + _GREEN32(smp~&)
                sumB& = sumB& + _BLUE32(smp~&) : sumA& = sumA& + _ALPHA32(smp~&) : cnt& = cnt& + 1
            END IF
        NEXT bprY&
        IF bprShowProg% AND (bprX& AND 31) = 0 THEN IMGADJ_progress_tick "Blurring", 0.5 + (bprX& / bprW&) * 0.5
    NEXT bprX&

    _MEMFREE bprPMM : _MEMFREE bprHM : _MEMFREE bprResM
    SAFE_FREEIMAGE bprPremul& : SAFE_FREEIMAGE bprHBlur&
    IMAGE_ADJ_blur_premul_rgba& = bprResult&
END FUNCTION


''
' Collect target layer indices for image adjustments.
' If multi-select is active, returns all non-group selected layers.
' Otherwise, returns just CURRENT_LAYER% (if it is not a group).
'
' @param targets() INTEGER  Output array (1..MAX_LAYERS) filled with layer indices
' @param tgtCount  INTEGER  Output count of targets written
'
SUB IMAGE_ADJ_collect_targets (targets() AS INTEGER, tgtCount AS INTEGER)
    tgtCount% = 0
    IF MULTI_SELECT_has_any% THEN
        DIM iatI AS INTEGER
        FOR iatI% = 1 TO MAX_LAYERS
            IF MULTI_SELECT_LAYERS(iatI%) THEN
                IF LAYERS(iatI%).imgHandle& < -1 THEN
                    IF LAYERS(iatI%).layerType% <> LAYER_TYPE_GROUP THEN
                        tgtCount% = tgtCount% + 1
                        targets(tgtCount%) = iatI%
                    END IF
                END IF
            END IF
        NEXT iatI%
    END IF
    IF tgtCount% = 0 THEN
        IF CURRENT_LAYER% >= 1 THEN
            IF CURRENT_LAYER% <= MAX_LAYERS THEN
                IF LAYERS(CURRENT_LAYER%).layerType% <> LAYER_TYPE_GROUP THEN
                    tgtCount%  = 1
                    targets(1) = CURRENT_LAYER%
                END IF
            END IF
        END IF
    END IF
END SUB


''
' Alpha-aware box blur that only averages non-transparent pixels, weighted
' by alpha.  Prevents black (RGB 0,0,0) from transparent areas bleeding
' into opaque content during spatial averaging.
' Output pixels use _RGB32 (alpha=255) so IMAGE_ADJ_apply_to_layer can
' restore original alpha normally.
'
' @param sourceImg LONG     Source image handle
' @param radius    INTEGER  Blur radius (kernel is (2*radius+1)^2)
' @return LONG  New blurred image handle, or 0 on error
'
FUNCTION IMAGE_ADJ_blur_alpha_aware& (sourceImg AS LONG, radius AS INTEGER)
    IF NOT (sourceImg& < -1) THEN
        IMAGE_ADJ_blur_alpha_aware& = 0
        EXIT FUNCTION
    END IF

    DIM baaResult AS LONG
    baaResult& = _COPYIMAGE(sourceImg&, 32)
    IF radius% <= 0 THEN
        IMAGE_ADJ_blur_alpha_aware& = baaResult&
        EXIT FUNCTION
    END IF

    DIM baaSrc AS _MEM, baaRes AS _MEM
    baaSrc = _MEMIMAGE(sourceImg&)
    baaRes = _MEMIMAGE(baaResult&)

    DIM baaW AS LONG, baaH AS LONG
    baaW& = _WIDTH(sourceImg&) : baaH& = _HEIGHT(sourceImg&)

    DIM baaX     AS LONG, baaY AS LONG, baaDX AS INTEGER, baaDY AS INTEGER
    DIM baaSX    AS LONG, baaSY AS LONG
    DIM baaSumR  AS LONG, baaSumG AS LONG, baaSumB AS LONG, baaSumW AS LONG
    DIM baaPx    AS _UNSIGNED LONG, baaA AS INTEGER
    DIM baaCurPx AS _UNSIGNED LONG
    DIM baaOutPx AS _UNSIGNED LONG

    FOR baaY& = 0 TO baaH& - 1
    IF (baaY& AND 15) = 0 THEN IMGADJ_progress_tick "Blur_alpha_aware", baaY& / baaH&
        FOR baaX& = 0 TO baaW& - 1
            baaCurPx~& = _MEMGET(baaSrc, baaSrc.OFFSET + (baaY& * baaW& + baaX&) * 4, _UNSIGNED LONG)
            IF _ALPHA32(baaCurPx~&) > 0 THEN
                baaSumR& = 0 : baaSumG& = 0 : baaSumB& = 0 : baaSumW& = 0
                FOR baaDY% = -radius% TO radius%
                    baaSY& = baaY& + baaDY%
                    IF baaSY& >= 0 AND baaSY& < baaH& THEN
                        FOR baaDX% = -radius% TO radius%
                            baaSX& = baaX& + baaDX%
                            IF baaSX& >= 0 AND baaSX& < baaW& THEN
                                baaPx~& = _MEMGET(baaSrc, baaSrc.OFFSET + (baaSY& * baaW& + baaSX&) * 4, _UNSIGNED LONG)
                                baaA%   = _ALPHA32(baaPx~&)
                                IF baaA% > 0 THEN
                                    baaSumR& = baaSumR& + _RED32(baaPx~&)
                                    baaSumG& = baaSumG& + _GREEN32(baaPx~&)
                                    baaSumB& = baaSumB& + _BLUE32(baaPx~&)
                                    baaSumW& = baaSumW& + 1
                                END IF
                            END IF
                        NEXT baaDX%
                    END IF
                NEXT baaDY%
                IF baaSumW& > 0 THEN
                    baaOutPx~& = _RGB32(baaSumR& \ baaSumW&, baaSumG& \ baaSumW&, baaSumB& \ baaSumW&)
                    _MEMPUT baaRes, baaRes.OFFSET + (baaY& * baaW& + baaX&) * 4, baaOutPx~& AS _UNSIGNED LONG
                END IF
            ELSE
                ' Transparent pixel — write RGB32(0,0,0) so apply_to_layer
                ' overwrites cleanly; alpha restore will set alpha back to 0.
                baaOutPx~& = _RGB32(0, 0, 0)
                _MEMPUT baaRes, baaRes.OFFSET + (baaY& * baaW& + baaX&) * 4, baaOutPx~& AS _UNSIGNED LONG
            END IF
        NEXT baaX&
    NEXT baaY&

    _MEMFREE baaSrc
    _MEMFREE baaRes
    IMAGE_ADJ_blur_alpha_aware& = baaResult&
END FUNCTION


''
' Alpha-aware pixelate that only averages non-transparent pixels within
' each block.  Prevents black from transparent areas darkening blocks.
' Output pixels use _RGB32 (alpha=255); transparent blocks are left as-is.
'
' @param sourceImg LONG     Source image handle
' @param pixelSize INTEGER  Block size in pixels
' @return LONG  New pixelated image handle, or 0 on error
'
FUNCTION IMAGE_ADJ_pixelate_alpha_aware& (sourceImg AS LONG, pixelSize AS INTEGER)
    IF NOT (sourceImg& < -1) THEN
        IMAGE_ADJ_pixelate_alpha_aware& = 0
        EXIT FUNCTION
    END IF

    DIM paaBlockSize AS INTEGER
    paaBlockSize% = pixelSize%
    IF paaBlockSize% < 1 THEN paaBlockSize% = 1
    IF paaBlockSize% > 50 THEN paaBlockSize% = 50

    DIM paaW AS LONG, paaH AS LONG
    paaW& = _WIDTH(sourceImg&) : paaH& = _HEIGHT(sourceImg&)

    DIM paaResult AS LONG
    paaResult& = _COPYIMAGE(sourceImg&, 32)

    DIM paaSrc AS _MEM, paaRes AS _MEM
    paaSrc = _MEMIMAGE(sourceImg&)
    paaRes = _MEMIMAGE(paaResult&)

    DIM paaBlockX   AS LONG, paaBlockY AS LONG
    DIM paaX        AS LONG, paaY AS LONG
    DIM paaSumR     AS LONG, paaSumG AS LONG, paaSumB AS LONG, paaSumW AS LONG
    DIM paaPx       AS _UNSIGNED LONG, paaA AS INTEGER
    DIM paaAvgColor AS _UNSIGNED LONG
    DIM paaEndX     AS LONG, paaEndY AS LONG

    FOR paaBlockY& = 0 TO paaH& - 1 STEP paaBlockSize%
    IF (paaBlockY& AND 15) = 0 THEN IMGADJ_progress_tick "Pixelate_alpha_aware", paaBlockY& / paaH&
        FOR paaBlockX& = 0 TO paaW& - 1 STEP paaBlockSize%
            paaSumR& = 0 : paaSumG& = 0 : paaSumB& = 0 : paaSumW& = 0
            paaEndY& = paaBlockY& + paaBlockSize% - 1
            IF paaEndY& > paaH& - 1 THEN paaEndY& = paaH& - 1
            paaEndX& = paaBlockX& + paaBlockSize% - 1
            IF paaEndX& > paaW& - 1 THEN paaEndX& = paaW& - 1

            FOR paaY& = paaBlockY& TO paaEndY&
                FOR paaX& = paaBlockX& TO paaEndX&
                    _MEMGET paaSrc, paaSrc.OFFSET + (paaY& * paaW& + paaX&) * 4, paaPx~&
                    paaA% = _ALPHA32(paaPx~&)
                    IF paaA% > 0 THEN
                        paaSumR& = paaSumR& + _RED32(paaPx~&)
                        paaSumG& = paaSumG& + _GREEN32(paaPx~&)
                        paaSumB& = paaSumB& + _BLUE32(paaPx~&)
                        paaSumW& = paaSumW& + 1
                    END IF
                NEXT paaX&
            NEXT paaY&

            IF paaSumW& > 0 THEN
                paaAvgColor~& = _RGB32(paaSumR& \ paaSumW&, paaSumG& \ paaSumW&, paaSumB& \ paaSumW&)
                FOR paaY& = paaBlockY& TO paaEndY&
                    FOR paaX& = paaBlockX& TO paaEndX&
                        _MEMPUT paaRes, paaRes.OFFSET + (paaY& * paaW& + paaX&) * 4, paaAvgColor~& AS _UNSIGNED LONG
                    NEXT paaX&
                NEXT paaY&
            END IF
        NEXT paaBlockX&
    NEXT paaBlockY&

    _MEMFREE paaSrc
    _MEMFREE paaRes
    IMAGE_ADJ_pixelate_alpha_aware& = paaResult&
END FUNCTION


''
' Build an unsharp-mask sharpened copy of sourceImg.
' Returns a new image handle (caller must SAFE_FREEIMAGE when done).
'
' @param sourceImg LONG   Source image handle
' @param amt       INTEGER  Strength 1-10
' @return LONG - New sharpened image handle, or 0 on error
'
FUNCTION IMAGE_ADJ_apply_sharpen& (sourceImg AS LONG, amt AS INTEGER)
    DIM blurred AS LONG
    blurred& = IMAGE_ADJ_blur_alpha_aware&(sourceImg, 1)
    IF blurred& < -1 THEN
        DIM result AS LONG
        result& = GJ_IMGADJ_CloneImage(sourceImg)
        IF result& < -1 THEN
            DIM mSrc AS _MEM, mBlur AS _MEM, mRes AS _MEM
            mSrc  = _MEMIMAGE(sourceImg)
            mBlur = _MEMIMAGE(blurred&)
            mRes  = _MEMIMAGE(result&)

            DIM totalPx AS LONG
            totalPx& = _WIDTH(sourceImg) * _HEIGHT(sourceImg)

            DIM i  AS LONG
            DIM px AS _UNSIGNED LONG, bpx AS _UNSIGNED LONG
            DIM r  AS INTEGER, g AS INTEGER, bl AS INTEGER, a AS INTEGER
            DIM br AS INTEGER, bg2 AS INTEGER, bb2 AS INTEGER
            DIM nr AS INTEGER, ng AS INTEGER, nb AS INTEGER

            FOR i& = 0 TO totalPx& - 1
                _MEMGET mSrc,  mSrc.OFFSET  + i& * 4, px~&
                _MEMGET mBlur, mBlur.OFFSET + i& * 4, bpx~&

                r  = _RED32(px~&)
                g  = _GREEN32(px~&)
                bl = _BLUE32(px~&)
                a  = _ALPHA32(px~&)

                br  = _RED32(bpx~&)
                bg2 = _GREEN32(bpx~&)
                bb2 = _BLUE32(bpx~&)

                nr = r  + (r  - br)  * amt% \ 5
                ng = g  + (g  - bg2) * amt% \ 5
                nb = bl + (bl - bb2) * amt% \ 5

                IF nr < 0   THEN nr = 0
                IF nr > 255 THEN nr = 255
                IF ng < 0   THEN ng = 0
                IF ng > 255 THEN ng = 255
                IF nb < 0   THEN nb = 0
                IF nb > 255 THEN nb = 255

                DIM outPx AS _UNSIGNED LONG
                outPx~& = _RGBA32(nr, ng, nb, a)
                _MEMPUT mRes, mRes.OFFSET + i& * 4, outPx~&
            NEXT i&

            _MEMFREE mSrc
            _MEMFREE mBlur
            _MEMFREE mRes
        END IF
        SAFE_FREEIMAGE blurred&
        IMAGE_ADJ_apply_sharpen& = result&
    ELSE
        IMAGE_ADJ_apply_sharpen& = GJ_IMGADJ_CloneImage(sourceImg)
    END IF
END FUNCTION


''
' Value-noise helper for the render effects. Deterministic (integer hash of the
' lattice cell, smoothstep-interpolated) so previews are reproducible. Returns
' 0..1 for lattice coords (fx, fy) with the given integer seed.
'
FUNCTION IMGADJ_valnoise! (fx AS SINGLE, fy AS SINGLE, seed AS INTEGER)
    DIM ix AS LONG, iy AS LONG
    DIM tx AS SINGLE, ty AS SINGLE
    ix& = INT(fx!) : iy& = INT(fy!)
    tx! = fx! - ix& : ty! = fy! - iy&
    tx! = tx! * tx! * (3.0 - 2.0 * tx!)   ' smoothstep
    ty! = ty! * ty! * (3.0 - 2.0 * ty!)
    DIM h00 AS LONG, h10 AS LONG, h01 AS LONG, h11 AS LONG
    h00& = ((ix& * 73856093) XOR (iy& * 19349663) XOR (seed% * 83492791)) AND 65535
    h10& = (((ix& + 1) * 73856093) XOR (iy& * 19349663) XOR (seed% * 83492791)) AND 65535
    h01& = ((ix& * 73856093) XOR ((iy& + 1) * 19349663) XOR (seed% * 83492791)) AND 65535
    h11& = (((ix& + 1) * 73856093) XOR ((iy& + 1) * 19349663) XOR (seed% * 83492791)) AND 65535
    DIM v0 AS SINGLE, v1 AS SINGLE
    v0! = (h00& / 65535.0) * (1.0 - tx!) + (h10& / 65535.0) * tx!
    v1! = (h01& / 65535.0) * (1.0 - tx!) + (h11& / 65535.0) * tx!
    IMGADJ_valnoise! = v0! * (1.0 - ty!) + v1! * ty!
END FUNCTION


''
' Cutout — an inset (inner) shadow on the top-left inner edge, so the shape reads
' as punched through the layer. Each opaque pixel is darkened by how close a
' transparent pixel is up-and-left of it within `depth`. RGB-only -> apply_to_layer.
'
' @param sourceImg LONG    Source image (32-bit, with alpha)
' @param depth     INTEGER Inset depth in px (1..10)
' @return LONG  New cutout image handle
'
FUNCTION IMAGE_ADJ_cutout& (sourceImg AS LONG, depth AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_cutout& = 0 : EXIT FUNCTION
    IF depth% < 1 THEN depth% = 1

    DIM cuW AS LONG, cuH AS LONG
    cuW& = _WIDTH(sourceImg&) : cuH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM cx AS LONG, cy AS LONG, dx AS INTEGER, dy AS INTEGER, nx AS LONG, ny AS LONG
    DIM aHere AS _UNSIGNED _BYTE, aN AS _UNSIGNED _BYTE
    DIM bestD AS INTEGER, dd AS INTEGER, fac AS SINGLE, px AS _UNSIGNED LONG
    DIM nr AS INTEGER, ng AS INTEGER, nb AS INTEGER
    FOR cy& = 0 TO cuH& - 1
    IF (cy& AND 15) = 0 THEN IMGADJ_progress_tick "Cutout", cy& / cuH&
        FOR cx& = 0 TO cuW& - 1
            _MEMGET srcM, srcM.OFFSET + (cy& * cuW& + cx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            bestD% = depth% + 1
            FOR dy% = -depth% TO 0
                ny& = cy& + dy%
                IF ny& >= 0 THEN
                    FOR dx% = -depth% TO 0
                        nx& = cx& + dx%
                        IF nx& >= 0 THEN
                            dd% = -dx% : IF -dy% > dd% THEN dd% = -dy%   ' Chebyshev up-left
                            IF dd% < bestD% THEN
                                _MEMGET srcM, srcM.OFFSET + (ny& * cuW& + nx&) * 4 + 3, aN~%%
                                IF aN~%% = 0 THEN bestD% = dd%
                            END IF
                        END IF
                    NEXT dx%
                END IF
            NEXT dy%
            IF bestD% <= depth% THEN
                fac! = (depth% - bestD% + 1) / (depth% + 1.0) * 0.8
                _MEMGET srcM, srcM.OFFSET + (cy& * cuW& + cx&) * 4, px~&
                nr% = _RED32(px~&) * (1.0 - fac!)
                ng% = _GREEN32(px~&) * (1.0 - fac!)
                nb% = _BLUE32(px~&) * (1.0 - fac!)
                _MEMPUT resM, resM.OFFSET + (cy& * cuW& + cx&) * 4, _RGB32(nr%, ng%, nb%) AS _UNSIGNED LONG
            END IF
        NEXT cx&
    NEXT cy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_cutout& = result&
END FUNCTION


''
' Open a modal Cutout dialog: single DEPTH slider (1..10). apply_to_layer.
'
SUB IMAGE_ADJ_cutout_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM dep AS INTEGER : dep% = 4
    DIM oDep AS INTEGER

    DIM k AS LONG
    DIM d_dep AS INTEGER : d_dep% = 4
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oDep% = dep%
        dep% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, dep%, 1, 64)
        dep% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, dep%, 1, 64)
        IF dep% <> oDep% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, dep%, d_dep%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_cutout&(ctx.origThumb, dep%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "CUTOUT"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "DEPTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, dep%, 1, 64, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM cuTargets(1 TO MAX_LAYERS) AS INTEGER, cuTgtCount AS INTEGER, cuT AS INTEGER
        DIM cuSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets cuTargets%(), cuTgtCount%
        cuSaveCL% = CURRENT_LAYER%
        IF cuTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR cuT% = 1 TO cuTgtCount%
            CURRENT_LAYER% = cuTargets%(cuT%)
            adjR&          = IMAGE_ADJ_cutout&(LAYERS(CURRENT_LAYER%).imgHandle&, dep%)
            IMAGE_ADJ_apply_to_layer adjR&, "Cutout"
        NEXT cuT%
        IF cuTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = cuSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Corona — a soft ring of light offset OUTSIDE the shape's alpha edge (an eclipse
' corona), distinct from Outer Glow's edge-hugging bloom. For each transparent
' pixel, distance d to the nearest opaque pixel gives a triangular ring intensity
' peaking at radius/2. Alpha-changing -> apply_spatial (transparent layer).
'
' @param sourceImg    LONG           Source image (32-bit, with alpha)
' @param radius       INTEGER        Ring reach in px (3..24)
' @param intensity    INTEGER        Brightness 0..100
' @param coronaColor  _UNSIGNED LONG Ring colour
' @return LONG  New corona image handle
'
FUNCTION IMAGE_ADJ_corona& (sourceImg AS LONG, radius AS INTEGER, intensity AS INTEGER, coronaColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_corona& = 0 : EXIT FUNCTION
    IF radius% < 2 THEN radius% = 2

    DIM coW AS LONG, coH AS LONG
    coW& = _WIDTH(sourceImg&) : coH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM cR AS INTEGER, cG AS INTEGER, cB AS INTEGER
    cR% = _RED32(coronaColor~&) : cG% = _GREEN32(coronaColor~&) : cB% = _BLUE32(coronaColor~&)
    DIM iScale AS SINGLE : iScale! = intensity% / 100.0
    DIM peak AS SINGLE : peak! = radius% / 2.0

    DIM ox AS LONG, oy AS LONG
    DIM aHere AS _UNSIGNED _BYTE
    DIM bestD AS SINGLE, inten AS SINGLE, aOut AS INTEGER
    ' distance-to-shape for every transparent pixel in O(pixels) (was O(radius^2)).
    ' Chebyshev distance — the ring is a touch squarer than the old Euclidean scan
    ' but no longer freezes at large radius.
    REDIM coDist(0 TO coW& * coH& - 1) AS LONG
    IMGADJ_dist_transform sourceImg&, 1, coDist()
    FOR oy& = 0 TO coH& - 1
    IF (oy& AND 15) = 0 THEN IMGADJ_progress_tick "Corona", oy& / coH&
        FOR ox& = 0 TO coW& - 1
            _MEMGET srcM, srcM.OFFSET + (oy& * coW& + ox&) * 4 + 3, aHere~%%
            IF aHere~%% <> 0 THEN _CONTINUE
            bestD! = coDist&(oy& * coW& + ox&)
            IF bestD! <= radius% THEN
                inten! = (1.0 - ABS(bestD! - peak!) / peak!) * iScale!
                IF inten! > 0.02 THEN
                    IF inten! > 1.0 THEN inten! = 1.0
                    aOut% = INT(inten! * 255)
                    _MEMPUT resM, resM.OFFSET + (oy& * coW& + ox&) * 4, _RGBA32(cR%, cG%, cB%, aOut%) AS _UNSIGNED LONG
                END IF
            END IF
        NEXT ox&
    NEXT oy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_corona& = result&
END FUNCTION


''
' Open a modal Corona dialog: RADIUS (3..24) + INTENSITY (0..100). Ring colour is
' the current FG colour. Alpha-changing -> apply_spatial.
'
SUB IMAGE_ADJ_corona_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM rad AS INTEGER : rad% = 10
    DIM inten AS INTEGER : inten% = 80
    DIM oRad AS INTEGER, oInten AS INTEGER

    DIM k AS LONG
    DIM d_rad AS INTEGER : d_rad% = 10
    DIM d_inten AS INTEGER : d_inten% = 80
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oRad% = rad% : oInten% = inten%
        rad% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, rad%, 3, 48)
        rad% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, rad%, 3, 48)
        inten% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inten%, 0, 100)
        inten% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inten%, 0, 100)
        IF rad% <> oRad% OR inten% <> oInten% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, rad%, inten%, d_rad%, d_inten%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_corona&(IMGADJ_fx_src&(ctx), rad%, inten%, PAINT_COLOR~&)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "CORONA"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "RADIUS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, rad%, 3, 48, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "INTENSITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, inten%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM coTargets(1 TO MAX_LAYERS) AS INTEGER, coTgtCount AS INTEGER, coT AS INTEGER
        DIM coSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets coTargets%(), coTgtCount%
        coSaveCL% = CURRENT_LAYER%
        IF coTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR coT% = 1 TO coTgtCount%
            CURRENT_LAYER% = coTargets%(coT%)
            DIM coEdge AS LONG
            coEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF coEdge& < -1 THEN
                adjR& = IMAGE_ADJ_corona&(coEdge&, rad%, inten%, PAINT_COLOR~&)
                IMAGE_ADJ_apply_spatial_edge adjR&, coEdge&, "Corona"
                SAFE_FREEIMAGE coEdge&
            ELSE
                adjR& = IMAGE_ADJ_corona&(LAYERS(CURRENT_LAYER%).imgHandle&, rad%, inten%, PAINT_COLOR~&)
                IMAGE_ADJ_apply_spatial adjR&, "Corona"
            END IF
        NEXT coT%
        IF coTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = coSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Backlight — a radial sunburst of light rays behind the shape. Fills the
' transparent area with `rays` bright spokes of `color` radiating from the centre
' (brightest at the centre, fading out), so when composited the shape appears
' backlit. Opaque pixels are kept. Alpha-changing -> apply_spatial (transparent layer).
'
' @param sourceImg LONG           Source image (32-bit, with alpha)
' @param rays      INTEGER        Number of light spokes (4..48)
' @param intensity INTEGER        Brightness 0..100
' @param color     _UNSIGNED LONG Ray colour
' @return LONG  New backlit image handle
'
FUNCTION IMAGE_ADJ_backlight& (sourceImg AS LONG, rays AS INTEGER, intensity AS INTEGER, rayColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_backlight& = 0 : EXIT FUNCTION

    DIM blW AS LONG, blH AS LONG
    blW& = _WIDTH(sourceImg&) : blH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM ccx AS SINGLE, ccy AS SINGLE, maxR AS SINGLE
    ccx! = blW& / 2.0 : ccy! = blH& / 2.0
    maxR! = SQR(ccx! * ccx! + ccy! * ccy!)
    DIM cr AS INTEGER, cg AS INTEGER, cb AS INTEGER
    cr% = _RED32(rayColor~&) : cg% = _GREEN32(rayColor~&) : cb% = _BLUE32(rayColor~&)
    DIM iScale AS SINGLE : iScale! = intensity% / 100.0

    DIM bx AS LONG, by AS LONG, aHere AS _UNSIGNED _BYTE
    DIM ddx AS SINGLE, ddy AS SINGLE, rr AS SINGLE, ang AS SINGLE, ray AS SINGLE, fall AS SINGLE, br AS SINGLE
    DIM aOut AS INTEGER
    FOR by& = 0 TO blH& - 1
    IF (by& AND 15) = 0 THEN IMGADJ_progress_tick "Backlight", by& / blH&
        FOR bx& = 0 TO blW& - 1
            _MEMGET srcM, srcM.OFFSET + (by& * blW& + bx&) * 4 + 3, aHere~%%
            IF aHere~%% <> 0 THEN _CONTINUE   ' keep the shape itself
            ddx! = bx& - ccx! : ddy! = by& - ccy!
            rr! = SQR(ddx! * ddx! + ddy! * ddy!)
            ang! = _ATAN2(ddy!, ddx!)
            ray! = 0.5 + 0.5 * COS(ang! * rays%)
            ray! = ray! * ray!                              ' sharpen the spokes
            fall! = 1.0 - rr! / maxR! : IF fall! < 0.0 THEN fall! = 0.0
            br! = ray! * fall! * iScale!
            IF br! > 1.0 THEN br! = 1.0
            IF br! > 0.01 THEN
                aOut% = INT(br! * 255)
                _MEMPUT resM, resM.OFFSET + (by& * blW& + bx&) * 4, _RGBA32(cr%, cg%, cb%, aOut%) AS _UNSIGNED LONG
            END IF
        NEXT bx&
    NEXT by&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_backlight& = result&
END FUNCTION


''
' Open a modal Backlight dialog: RAYS (4..48) + INTENSITY (0..100). Ray colour is
' the current FG colour. Alpha-changing -> apply_spatial.
'
SUB IMAGE_ADJ_backlight_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM rys AS INTEGER : rys% = 16
    DIM inten AS INTEGER : inten% = 70
    DIM oRys AS INTEGER, oInten AS INTEGER

    DIM k AS LONG
    DIM d_rys AS INTEGER : d_rys% = 16
    DIM d_inten AS INTEGER : d_inten% = 70
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oRys% = rys% : oInten% = inten%
        rys% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, rys%, 4, 120)
        rys% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, rys%, 4, 120)
        inten% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inten%, 0, 100)
        inten% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inten%, 0, 100)
        IF rys% <> oRys% OR inten% <> oInten% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, rys%, inten%, d_rys%, d_inten%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_backlight&(IMGADJ_fx_src&(ctx), rys%, inten%, PAINT_COLOR~&)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "BACKLIGHT"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "RAYS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, rys%, 4, 120, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "INTENSITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, inten%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM blTargets(1 TO MAX_LAYERS) AS INTEGER, blTgtCount AS INTEGER, blT AS INTEGER
        DIM blSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets blTargets%(), blTgtCount%
        blSaveCL% = CURRENT_LAYER%
        IF blTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR blT% = 1 TO blTgtCount%
            CURRENT_LAYER% = blTargets%(blT%)
            DIM blEdge AS LONG
            blEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF blEdge& < -1 THEN
                adjR& = IMAGE_ADJ_backlight&(blEdge&, rys%, inten%, PAINT_COLOR~&)
                IMAGE_ADJ_apply_spatial_edge adjR&, blEdge&, "Backlight"
                SAFE_FREEIMAGE blEdge&
            ELSE
                adjR& = IMAGE_ADJ_backlight&(LAYERS(CURRENT_LAYER%).imgHandle&, rys%, inten%, PAINT_COLOR~&)
                IMAGE_ADJ_apply_spatial adjR&, "Backlight"
            END IF
        NEXT blT%
        IF blTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = blSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Render Sky — fill the layer with a procedural sky. mode 0 = day (blue vertical
' gradient), 1 = night (dark gradient + stars), 2 = space (near-black + dense
' stars + a planet). Generative -> apply_spatial.
'
' @param sourceImg LONG    Source image (used only for dimensions)
' @param mode      INTEGER 0 day / 1 night / 2 space
' @return LONG  New opaque sky image handle
'
FUNCTION IMAGE_ADJ_sky& (sourceImg AS LONG, mode AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_sky& = 0 : EXIT FUNCTION

    DIM skW AS LONG, skH AS LONG
    skW& = _WIDTH(sourceImg&) : skH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _NEWIMAGE(skW&, skH&, 32)
    DIM resM AS _MEM : resM = _MEMIMAGE(result&)

    DIM sx AS LONG, sy AS LONG
    DIM tv AS SINGLE, rr AS INTEGER, gg AS INTEGER, bb AS INTEGER
    DIM topR AS INTEGER, topG AS INTEGER, topB AS INTEGER
    DIM botR AS INTEGER, botG AS INTEGER, botB AS INTEGER
    SELECT CASE mode%
        CASE 0 : topR% = 40 : topG% = 90 : topB% = 200 : botR% = 190 : botG% = 220 : botB% = 250
        CASE 1 : topR% = 4 : topG% = 6 : topB% = 26 : botR% = 40 : botG% = 44 : botB% = 90
        CASE ELSE : topR% = 2 : topG% = 2 : topB% = 8 : botR% = 6 : botG% = 4 : botB% = 16
    END SELECT
    FOR sy& = 0 TO skH& - 1
    IF (sy& AND 15) = 0 THEN IMGADJ_progress_tick "Sky", sy& / skH&
        tv! = sy& / (skH& - 1.0)
        rr% = topR% + (botR% - topR%) * tv!
        gg% = topG% + (botG% - topG%) * tv!
        bb% = topB% + (botB% - topB%) * tv!
        FOR sx& = 0 TO skW& - 1
            _MEMPUT resM, resM.OFFSET + (sy& * skW& + sx&) * 4, _RGBA32(rr%, gg%, bb%, 255) AS _UNSIGNED LONG
        NEXT sx&
    NEXT sy&

    ' stars for night / space
    IF mode% >= 1 THEN
        DIM hs AS LONG, thr AS LONG, br AS INTEGER
        thr& = 64850 : IF mode% = 2 THEN thr& = 64200   ' space denser
        FOR sy& = 0 TO skH& - 1
            FOR sx& = 0 TO skW& - 1
                hs& = ((sx& * 374761393) XOR (sy& * 668265263)) AND 65535
                IF hs& > thr& THEN
                    br% = 160 + (hs& AND 95)
                    _MEMPUT resM, resM.OFFSET + (sy& * skW& + sx&) * 4, _RGBA32(br%, br%, br%, 255) AS _UNSIGNED LONG
                END IF
            NEXT sx&
        NEXT sy&
    END IF
    _MEMFREE resM

    ' space: draw a planet
    IF mode% = 2 THEN
        DIM oldDest AS LONG : oldDest& = _DEST
        _DEST result& : _DONTBLEND result&
        DIM pcx AS LONG, pcy AS LONG, pr AS LONG, pyi AS LONG, half AS LONG
        pcx& = skW& * 0.72 : pcy& = skH& * 0.32 : pr& = skH& * 0.16
        FOR pyi& = -pr& TO pr&
            half& = INT(SQR(pr& * pr& - pyi& * pyi&))
            LINE (pcx& - half&, pcy& + pyi&)-(pcx& + half&, pcy& + pyi&), _RGBA32(150, 90 - INT(pyi& * 20 / pr&), 60, 255)
        NEXT pyi&
        _BLEND result& : _DEST oldDest&
    END IF

    IMAGE_ADJ_sky& = result&
END FUNCTION


''
' Open a modal Render Sky dialog: MODE slider (0 day / 1 night / 2 space).
' Generative -> apply_spatial.
'
SUB IMAGE_ADJ_sky_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM smode AS INTEGER : smode% = 0
    DIM oMode AS INTEGER

    DIM k AS LONG
    DIM d_smode AS INTEGER : d_smode% = 0
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oMode% = smode%
        smode% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, smode%, 0, 2)
        smode% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, smode%, 0, 2)
        IF smode% <> oMode% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, smode%, d_smode%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_sky&(ctx.origThumb, smode%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "RENDER SKY"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "MODE (0 DAY / 1 NIGHT / 2 SPACE):"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, smode%, 0, 2, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM skTargets(1 TO MAX_LAYERS) AS INTEGER, skTgtCount AS INTEGER, skT AS INTEGER
        DIM skSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets skTargets%(), skTgtCount%
        skSaveCL% = CURRENT_LAYER%
        IF skTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR skT% = 1 TO skTgtCount%
            CURRENT_LAYER% = skTargets%(skT%)
            adjR&          = IMAGE_ADJ_sky&(LAYERS(CURRENT_LAYER%).imgHandle&, smode%)
            IMAGE_ADJ_apply_spatial adjR&, "Render Sky"
        NEXT skT%
        IF skTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = skSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Render Grid — draw a grid over the layer in the FG colour. Flat mode: evenly
' spaced horizontal + vertical lines. Perspective mode: verticals converge to a
' vanishing point and horizontals recede toward the horizon (floor grid). Lines
' are drawn opaque; source alpha elsewhere is preserved -> apply_spatial.
'
' @param sourceImg   LONG           Source image (32-bit)
' @param spacing     INTEGER        Grid spacing in px (4..64)
' @param persp       INTEGER        0 = flat, 1 = perspective floor grid
' @param lineColor   _UNSIGNED LONG Line colour
' @return LONG  New image with the grid drawn
'
FUNCTION IMAGE_ADJ_grid& (sourceImg AS LONG, spacing AS INTEGER, persp AS INTEGER, lineColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_grid& = 0 : EXIT FUNCTION
    IF spacing% < 2 THEN spacing% = 2

    DIM grW AS LONG, grH AS LONG
    grW& = _WIDTH(sourceImg&) : grH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM c AS _UNSIGNED LONG
    c~& = _RGBA32(_RED32(lineColor~&), _GREEN32(lineColor~&), _BLUE32(lineColor~&), 255)
    DIM oldDest AS LONG : oldDest& = _DEST
    _DEST result& : _DONTBLEND result&

    DIM gg AS LONG
    IF persp% = 0 THEN
        FOR gg& = 0 TO grW& - 1 STEP spacing%
        IF (gg& AND 15) = 0 THEN IMGADJ_progress_tick "Grid", gg& / grW&
            LINE (gg&, 0)-(gg&, grH& - 1), c~&
        NEXT gg&
        FOR gg& = 0 TO grH& - 1 STEP spacing%
            LINE (0, gg&)-(grW& - 1, gg&), c~&
        NEXT gg&
    ELSE
        DIM vpx AS SINGLE, hy AS SINGLE
        vpx! = grW& / 2.0 : hy! = grH& * 0.4
        ' vertical lines converge from the bottom edge to the vanishing point
        FOR gg& = 0 TO grW& - 1 STEP spacing%
            LINE (gg&, grH& - 1)-(vpx!, hy!), c~&
        NEXT gg&
        LINE (grW& - 1, grH& - 1)-(vpx!, hy!), c~&
        ' horizontal receding lines (geometric spacing toward the horizon)
        DIM yy AS SINGLE, gap AS SINGLE
        yy! = grH& - 1 : gap! = spacing%
        DO WHILE yy! > hy! + 1
            LINE (0, yy!)-(grW& - 1, yy!), c~&
            yy! = yy! - gap! : gap! = gap! * 0.78
            IF gap! < 1.5 THEN EXIT DO
        LOOP
        LINE (0, hy!)-(grW& - 1, hy!), c~&
    END IF

    _BLEND result& : _DEST oldDest&
    IMAGE_ADJ_grid& = result&
END FUNCTION


''
' Open a modal Render Grid dialog: SPACING (4..64) + PERSPECTIVE toggle. Line
' colour = FG. -> apply_spatial.
'
SUB IMAGE_ADJ_grid_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 130
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM gspc AS INTEGER : gspc% = 16
    DIM oSpc AS INTEGER
    STATIC perspOn AS INTEGER

    DIM pvX AS INTEGER, pvY AS INTEGER, pvW AS INTEGER, pvH AS INTEGER
    pvX% = IMGDLG_SX : pvW% = 120 : pvH% = 16
    pvY% = IMGDLG_track_y%(ctx, 0) + 24

    DIM k AS LONG
    DIM d_gspc AS INTEGER : d_gspc% = 16
    DIM d_perspOn AS INTEGER : d_perspOn% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oSpc% = gspc%
        gspc% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, gspc%, 4, 200)
        gspc% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, gspc%, 4, 200)
        IF DIALOG_hit%(ctx, pvX%, pvY%, pvW%, pvH%) THEN
            perspOn%          = (perspOn% = 0)
            ctx.previewDirty% = TRUE
        END IF
        IF gspc% <> oSpc% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, gspc%, perspOn%, d_gspc%, d_perspOn%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_grid&(ctx.origThumb, gspc%, perspOn%, PAINT_COLOR~&)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "RENDER GRID"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "SPACING:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, gspc%, 4, 200, "", ""
        DIALOG_draw_toggle ctx, pvX%, pvY%, pvW%, pvH%, "PERSPECTIVE", perspOn%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM grTargets(1 TO MAX_LAYERS) AS INTEGER, grTgtCount AS INTEGER, grT AS INTEGER
        DIM grSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets grTargets%(), grTgtCount%
        grSaveCL% = CURRENT_LAYER%
        IF grTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR grT% = 1 TO grTgtCount%
            CURRENT_LAYER% = grTargets%(grT%)
            adjR&          = IMAGE_ADJ_grid&(LAYERS(CURRENT_LAYER%).imgHandle&, gspc%, perspOn%, PAINT_COLOR~&)
            IMAGE_ADJ_apply_spatial adjR&, "Render Grid"
        NEXT grT%
        IF grTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = grSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Dust & Scratches (Reduce Noise) — a thresholded 3x3 median: a pixel is replaced
' by the neighbourhood median only where it differs from that median by more than
' `threshold`, so outlier speckle/scratches are removed while detail is kept.
' Alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param threshold INTEGER Per-channel difference that counts as noise (2..64)
' @return LONG  New cleaned image handle
'
FUNCTION IMAGE_ADJ_dustscratches& (sourceImg AS LONG, threshold AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_dustscratches& = 0 : EXIT FUNCTION

    DIM dsW AS LONG, dsH AS LONG
    dsW& = _WIDTH(sourceImg&) : dsH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM mx AS LONG, my AS LONG, dx AS INTEGER, dy AS INTEGER, nx AS LONG, ny AS LONG
    DIM rV(0 TO 8) AS INTEGER, gV(0 TO 8) AS INTEGER, bV(0 TO 8) AS INTEGER
    DIM n AS INTEGER, j AS INTEGER, tmp AS INTEGER
    DIM px AS _UNSIGNED LONG, aHere AS _UNSIGNED _BYTE
    DIM oRv AS INTEGER, oGr AS INTEGER, oBl AS INTEGER, mR AS INTEGER, mGr AS INTEGER, mBl AS INTEGER
    DIM fR AS INTEGER, fGr AS INTEGER, fBl AS INTEGER
    FOR my& = 0 TO dsH& - 1
    IF (my& AND 15) = 0 THEN IMGADJ_progress_tick "Dustscratches", my& / dsH&
        FOR mx& = 0 TO dsW& - 1
            n% = 0
            FOR dy% = -1 TO 1
                ny& = my& + dy% : IF ny& < 0 THEN ny& = 0 ELSE IF ny& >= dsH& THEN ny& = dsH& - 1
                FOR dx% = -1 TO 1
                    nx& = mx& + dx% : IF nx& < 0 THEN nx& = 0 ELSE IF nx& >= dsW& THEN nx& = dsW& - 1
                    _MEMGET srcM, srcM.OFFSET + (ny& * dsW& + nx&) * 4, px~&
                    rV(n%) = _RED32(px~&) : gV(n%) = _GREEN32(px~&) : bV(n%) = _BLUE32(px~&)
                    n% = n% + 1
                NEXT dx%
            NEXT dy%
            FOR n% = 1 TO 8
                tmp% = rV(n%) : j% = n% - 1
                DO WHILE j% >= 0 : IF rV(j%) <= tmp% THEN EXIT DO
                    rV(j% + 1) = rV(j%) : j% = j% - 1
                LOOP
                rV(j% + 1) = tmp%
                tmp% = gV(n%) : j% = n% - 1
                DO WHILE j% >= 0 : IF gV(j%) <= tmp% THEN EXIT DO
                    gV(j% + 1) = gV(j%) : j% = j% - 1
                LOOP
                gV(j% + 1) = tmp%
                tmp% = bV(n%) : j% = n% - 1
                DO WHILE j% >= 0 : IF bV(j%) <= tmp% THEN EXIT DO
                    bV(j% + 1) = bV(j%) : j% = j% - 1
                LOOP
                bV(j% + 1) = tmp%
            NEXT n%
            _MEMGET srcM, srcM.OFFSET + (my& * dsW& + mx&) * 4, px~&
            aHere~%% = _ALPHA32(px~&)
            oRv% = _RED32(px~&) : oGr% = _GREEN32(px~&) : oBl% = _BLUE32(px~&)
            mR% = rV(4) : mGr% = gV(4) : mBl% = bV(4)
            fR% = oRv% : IF ABS(oRv% - mR%) > threshold% THEN fR% = mR%
            fGr% = oGr% : IF ABS(oGr% - mGr%) > threshold% THEN fGr% = mGr%
            fBl% = oBl% : IF ABS(oBl% - mBl%) > threshold% THEN fBl% = mBl%
            _MEMPUT resM, resM.OFFSET + (my& * dsW& + mx&) * 4, _RGBA32(fR%, fGr%, fBl%, aHere~%%) AS _UNSIGNED LONG
        NEXT mx&
    NEXT my&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_dustscratches& = result&
END FUNCTION


''
' Open a modal Dust & Scratches dialog: single THRESHOLD slider (2..64).
'
SUB IMAGE_ADJ_dustscratches_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM thr AS INTEGER : thr% = 16
    DIM oThr AS INTEGER

    DIM k AS LONG
    DIM d_thr AS INTEGER : d_thr% = 16
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oThr% = thr%
        thr% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, thr%, 2, 200)
        thr% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, thr%, 2, 200)
        IF thr% <> oThr% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, thr%, d_thr%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_dustscratches&(ctx.origThumb, thr%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "DUST & SCRATCHES"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "THRESHOLD:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, thr%, 2, 200, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM dsTargets(1 TO MAX_LAYERS) AS INTEGER, dsTgtCount AS INTEGER, dsT AS INTEGER
        DIM dsSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets dsTargets%(), dsTgtCount%
        dsSaveCL% = CURRENT_LAYER%
        IF dsTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR dsT% = 1 TO dsTgtCount%
            CURRENT_LAYER% = dsTargets%(dsT%)
            adjR&          = IMAGE_ADJ_dustscratches&(LAYERS(CURRENT_LAYER%).imgHandle&, thr%)
            IMAGE_ADJ_apply_to_layer adjR&, "Dust & Scratches"
        NEXT dsT%
        IF dsTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = dsSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Median / Despeckle — replace each pixel with the per-channel median of its 3x3
' neighbourhood, removing speckle while keeping edges. One-shot; alpha preserved.
'
' @param sourceImg LONG Source image (32-bit)
' @return LONG  New despeckled image handle
'
FUNCTION IMAGE_ADJ_median& (sourceImg AS LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_median& = 0 : EXIT FUNCTION

    DIM mdW AS LONG, mdH AS LONG
    mdW& = _WIDTH(sourceImg&) : mdH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM mx AS LONG, my AS LONG, dx AS INTEGER, dy AS INTEGER, nx AS LONG, ny AS LONG
    DIM rV(0 TO 8) AS INTEGER, gV(0 TO 8) AS INTEGER, bV(0 TO 8) AS INTEGER
    DIM n AS INTEGER, j AS INTEGER, tmp AS INTEGER
    DIM px AS _UNSIGNED LONG, aHere AS _UNSIGNED _BYTE
    FOR my& = 0 TO mdH& - 1
    IF (my& AND 15) = 0 THEN IMGADJ_progress_tick "Median", my& / mdH&
        FOR mx& = 0 TO mdW& - 1
            n% = 0
            FOR dy% = -1 TO 1
                ny& = my& + dy% : IF ny& < 0 THEN ny& = 0 ELSE IF ny& >= mdH& THEN ny& = mdH& - 1
                FOR dx% = -1 TO 1
                    nx& = mx& + dx% : IF nx& < 0 THEN nx& = 0 ELSE IF nx& >= mdW& THEN nx& = mdW& - 1
                    _MEMGET srcM, srcM.OFFSET + (ny& * mdW& + nx&) * 4, px~&
                    rV(n%) = _RED32(px~&) : gV(n%) = _GREEN32(px~&) : bV(n%) = _BLUE32(px~&)
                    n% = n% + 1
                NEXT dx%
            NEXT dy%
            ' insertion sort each channel (9 elements)
            FOR n% = 1 TO 8
                tmp% = rV(n%) : j% = n% - 1
                DO WHILE j% >= 0 : IF rV(j%) <= tmp% THEN EXIT DO
                    rV(j% + 1) = rV(j%) : j% = j% - 1
                LOOP
                rV(j% + 1) = tmp%
                tmp% = gV(n%) : j% = n% - 1
                DO WHILE j% >= 0 : IF gV(j%) <= tmp% THEN EXIT DO
                    gV(j% + 1) = gV(j%) : j% = j% - 1
                LOOP
                gV(j% + 1) = tmp%
                tmp% = bV(n%) : j% = n% - 1
                DO WHILE j% >= 0 : IF bV(j%) <= tmp% THEN EXIT DO
                    bV(j% + 1) = bV(j%) : j% = j% - 1
                LOOP
                bV(j% + 1) = tmp%
            NEXT n%
            _MEMGET srcM, srcM.OFFSET + (my& * mdW& + mx&) * 4 + 3, aHere~%%
            _MEMPUT resM, resM.OFFSET + (my& * mdW& + mx&) * 4, _RGBA32(rV(4), gV(4), bV(4), aHere~%%) AS _UNSIGNED LONG
        NEXT mx&
    NEXT my&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_median& = result&
END FUNCTION


''
' Direct op — apply a Median / Despeckle pass to the active (and extra) layers.
'
SUB IMAGE_ADJ_median ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB
    DIM iatTargets(1 TO MAX_LAYERS) AS INTEGER, iatTgtCount AS INTEGER, iatT AS INTEGER
    DIM iatSaveCL AS INTEGER
    IMAGE_ADJ_collect_targets iatTargets%(), iatTgtCount%
    IF iatTgtCount% = 0 THEN EXIT SUB
    iatSaveCL% = CURRENT_LAYER%
    IF iatTgtCount% > 1 THEN HISTORY_begin_group
    DIM adjR      AS LONG
    FOR iatT% = 1 TO iatTgtCount%
        CURRENT_LAYER% = iatTargets%(iatT%)
        adjR&          = IMAGE_ADJ_median&(LAYERS(CURRENT_LAYER%).imgHandle&)
        IMAGE_ADJ_apply_to_layer adjR&, "Median"
    NEXT iatT%
    IF iatTgtCount% > 1 THEN HISTORY_end_group
    CURRENT_LAYER% = iatSaveCL%
END SUB


''
' Add Noise — add per-pixel random noise (deterministic hash, ~gaussian by
' averaging two hashes). MONO adds the same delta to R/G/B; colour adds an
' independent delta per channel. Same size; alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param amount    INTEGER Noise strength 0..100
' @param mono      INTEGER 0 = colour noise, 1 = monochrome
' @return LONG  New noisy image handle
'
FUNCTION IMAGE_ADJ_addnoise& (sourceImg AS LONG, amount AS INTEGER, mono AS INTEGER, pixSize AS INTEGER, mixP AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_addnoise& = 0 : EXIT FUNCTION

    DIM anW AS LONG, anH AS LONG
    anW& = _WIDTH(sourceImg&) : anH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' pixSize = grain size: noise is constant across each pixSize x pixSize block
    ' (1 = fine per-pixel grain). mixP = how strongly the grain blends over the
    ' original (0 = none, 100 = full-strength).
    DIM anPix AS INTEGER : anPix% = pixSize% : IF anPix% < 1 THEN anPix% = 1
    DIM anMix AS SINGLE : anMix! = mixP% / 100.0
    IF anMix! < 0.0 THEN anMix! = 0.0 ELSE IF anMix! > 1.0 THEN anMix! = 1.0

    DIM nx AS LONG, ny AS LONG, bx AS LONG, by AS LONG, h1 AS LONG, h2 AS LONG
    DIM dR AS INTEGER, dG AS INTEGER, dB AS INTEGER, sc AS SINGLE
    DIM px AS _UNSIGNED LONG, nr AS INTEGER, ng AS INTEGER, nb AS INTEGER
    DIM orR AS INTEGER, orG AS INTEGER, orB AS INTEGER
    sc! = amount% / 100.0 * 255.0
    FOR ny& = 0 TO anH& - 1
    IF (ny& AND 15) = 0 THEN IMGADJ_progress_tick "Addnoise", ny& / anH&
        by& = ny& \ anPix%
        FOR nx& = 0 TO anW& - 1
            bx& = nx& \ anPix%
            h1& = ((bx& * 374761393) XOR (by& * 668265263)) AND 65535
            h2& = (((bx& + 137) * 374761393) XOR ((by& + 71) * 668265263)) AND 65535
            dR% = INT(((h1& / 65535.0) + (h2& / 65535.0) - 1.0) * sc!)
            IF mono% THEN
                dG% = dR% : dB% = dR%
            ELSE
                h1& = ((bx& * 40503) XOR (by& * 12289) XOR 777) AND 65535
                h2& = ((bx& * 24593) XOR (by& * 20347) XOR 555) AND 65535
                dG% = INT(((h1& / 65535.0) + (h2& / 65535.0) - 1.0) * sc!)
                h1& = ((bx& * 15413) XOR (by& * 32603) XOR 999) AND 65535
                h2& = ((bx& * 49157) XOR (by& * 6151) XOR 333) AND 65535
                dB% = INT(((h1& / 65535.0) + (h2& / 65535.0) - 1.0) * sc!)
            END IF
            _MEMGET srcM, srcM.OFFSET + (ny& * anW& + nx&) * 4, px~&
            orR% = _RED32(px~&) : orG% = _GREEN32(px~&) : orB% = _BLUE32(px~&)
            ' additive grain, then blend the grained pixel over the original by mix
            nr% = orR% + INT(dR% * anMix!) : IF nr% < 0 THEN nr% = 0 ELSE IF nr% > 255 THEN nr% = 255
            ng% = orG% + INT(dG% * anMix!) : IF ng% < 0 THEN ng% = 0 ELSE IF ng% > 255 THEN ng% = 255
            nb% = orB% + INT(dB% * anMix!) : IF nb% < 0 THEN nb% = 0 ELSE IF nb% > 255 THEN nb% = 255
            _MEMPUT resM, resM.OFFSET + (ny& * anW& + nx&) * 4, _RGBA32(nr%, ng%, nb%, _ALPHA32(px~&)) AS _UNSIGNED LONG
        NEXT nx&
    NEXT ny&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_addnoise& = result&
END FUNCTION


''
' Open a modal Add Noise dialog: AMOUNT (0..100) + MONO toggle.
'
SUB IMAGE_ADJ_addnoise_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 206
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM amt AS INTEGER : amt% = 25
    DIM oAmt AS INTEGER
    DIM npix AS INTEGER : npix% = 1
    DIM oNpix AS INTEGER
    DIM nmix AS INTEGER : nmix% = 100
    DIM oNmix AS INTEGER
    STATIC monoOn AS INTEGER

    DIM mvX AS INTEGER, mvY AS INTEGER, mvW AS INTEGER, mvH AS INTEGER
    mvX% = IMGDLG_SX : mvW% = 120 : mvH% = 16
    mvY% = IMGDLG_track_y%(ctx, 2) + 24

    DIM k AS LONG
    DIM d_amt AS INTEGER : d_amt% = 25
    DIM d_npix AS INTEGER : d_npix% = 1
    DIM d_nmix AS INTEGER : d_nmix% = 100
    DIM d_monoOn AS INTEGER : d_monoOn% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oAmt% = amt% : oNpix% = npix% : oNmix% = nmix%
        amt% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amt%, 0, 100)
        amt% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amt%, 0, 100)
        npix% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, npix%, 1, 64)
        npix% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, npix%, 1, 64)
        nmix% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, nmix%, 0, 100)
        nmix% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, nmix%, 0, 100)
        IF DIALOG_hit%(ctx, mvX%, mvY%, mvW%, mvH%) THEN
            monoOn%           = (monoOn% = 0)
            ctx.previewDirty% = TRUE
        END IF
        IF amt% <> oAmt% OR npix% <> oNpix% OR nmix% <> oNmix% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset4 ctx, amt%, npix%, nmix%, monoOn%, d_amt%, d_npix%, d_nmix%, d_monoOn%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_addnoise&(ctx.origThumb, amt%, monoOn%, npix%, nmix%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "ADD NOISE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "AMOUNT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, amt%, 0, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "PIXEL SIZE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, npix%, 1, 64, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 2), "MIX:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, nmix%, 0, 100, "", ""
        DIALOG_draw_toggle ctx, mvX%, mvY%, mvW%, mvH%, "MONOCHROME", monoOn%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM anTargets(1 TO MAX_LAYERS) AS INTEGER, anTgtCount AS INTEGER, anT AS INTEGER
        DIM anSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets anTargets%(), anTgtCount%
        anSaveCL% = CURRENT_LAYER%
        IF anTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR anT% = 1 TO anTgtCount%
            CURRENT_LAYER% = anTargets%(anT%)
            adjR&          = IMAGE_ADJ_addnoise&(LAYERS(CURRENT_LAYER%).imgHandle&, amt%, monoOn%, npix%, nmix%)
            IMAGE_ADJ_apply_to_layer adjR&, "Add Noise"
        NEXT anT%
        IF anTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = anSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Terrain — fill the layer with a fractal heightmap (5 octaves of value noise)
' mapped to a natural terrain ramp: deep water -> shallow -> sand -> grass ->
' rock -> snow. Generative (apply_spatial).
'
' @param sourceImg LONG    Source image (used only for dimensions)
' @param scaleP    INTEGER Base feature size in px (16..96)
' @return LONG  New opaque terrain image handle
'
FUNCTION IMAGE_ADJ_terrain& (sourceImg AS LONG, scaleP AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_terrain& = 0 : EXIT FUNCTION
    IF scaleP% < 8 THEN scaleP% = 8

    DIM teW AS LONG, teH AS LONG
    teW& = _WIDTH(sourceImg&) : teH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _NEWIMAGE(teW&, teH&, 32)
    DIM resM AS _MEM : resM = _MEMIMAGE(result&)

    DIM tx AS LONG, ty AS LONG, oct AS INTEGER
    DIM nv AS SINGLE, fr AS SINGLE, amp AS SINGLE, amax AS SINGLE
    DIM tr AS INTEGER, tg AS INTEGER, tb AS INTEGER, sh AS SINGLE
    FOR ty& = 0 TO teH& - 1
    IF (ty& AND 15) = 0 THEN IMGADJ_progress_tick "Terrain", ty& / teH&
        FOR tx& = 0 TO teW& - 1
            nv! = 0.0 : fr! = 1.0 / scaleP% : amp! = 1.0 : amax! = 0.0
            FOR oct% = 0 TO 4
                nv! = nv! + IMGADJ_valnoise!(tx& * fr!, ty& * fr!, oct% + 1) * amp!
                amax! = amax! + amp!
                amp! = amp! * 0.5 : fr! = fr! * 2.0
            NEXT oct%
            nv! = nv! / amax!
            ' terrain bands
            IF nv! < 0.30 THEN
                tr% = 20 : tg% = 40 : tb% = 90 + INT(nv! * 200)                 ' deep water
            ELSEIF nv! < 0.42 THEN
                tr% = 30 : tg% = 90 : tb% = 150                                 ' shallow water
            ELSEIF nv! < 0.47 THEN
                tr% = 210 : tg% = 200 : tb% = 140                               ' sand
            ELSEIF nv! < 0.68 THEN
                sh! = (nv! - 0.47) / 0.21
                tr% = 40 + INT(sh! * 40) : tg% = 120 - INT(sh! * 40) : tb% = 40 ' grass
            ELSEIF nv! < 0.82 THEN
                sh! = (nv! - 0.68) / 0.14
                tr% = 100 + INT(sh! * 30) : tg% = 85 + INT(sh! * 25) : tb% = 70 ' rock
            ELSE
                sh! = (nv! - 0.82) / 0.18
                tr% = 200 + INT(sh! * 55) : tg% = 200 + INT(sh! * 55) : tb% = 210 + INT(sh! * 45) ' snow
            END IF
            IF tb% > 255 THEN tb% = 255
            _MEMPUT resM, resM.OFFSET + (ty& * teW& + tx&) * 4, _RGBA32(tr%, tg%, tb%, 255) AS _UNSIGNED LONG
        NEXT tx&
    NEXT ty&

    _MEMFREE resM
    IMAGE_ADJ_terrain& = result&
END FUNCTION


''
' Open a modal Terrain dialog: single SCALE slider (16..96). Generative ->
' apply_spatial.
'
SUB IMAGE_ADJ_terrain_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM scl AS INTEGER : scl% = 48
    DIM oScl AS INTEGER

    DIM k AS LONG
    DIM d_scl AS INTEGER : d_scl% = 48
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oScl% = scl%
        scl% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, scl%, 16, 400)
        scl% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, scl%, 16, 400)
        IF scl% <> oScl% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, scl%, d_scl%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_terrain&(ctx.origThumb, scl%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "TERRAIN"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "SCALE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, scl%, 16, 400, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM teTargets(1 TO MAX_LAYERS) AS INTEGER, teTgtCount AS INTEGER, teT AS INTEGER
        DIM teSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets teTargets%(), teTgtCount%
        teSaveCL% = CURRENT_LAYER%
        IF teTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR teT% = 1 TO teTgtCount%
            CURRENT_LAYER% = teTargets%(teT%)
            adjR&          = IMAGE_ADJ_terrain&(LAYERS(CURRENT_LAYER%).imgHandle&, scl%)
            IMAGE_ADJ_apply_spatial adjR&, "Terrain"
        NEXT teT%
        IF teTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = teSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Lens Flare — additively composite a bright core plus secondary halo orbs along
' the flare axis (from the flare point through the image centre). `bright` scales
' the intensity. Adds light over the existing pixels; alpha preserved
' (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param bright    INTEGER Intensity 10..100
' @return LONG  New image with the flare added
'
FUNCTION IMAGE_ADJ_lensflare& (sourceImg AS LONG, bright AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_lensflare& = 0 : EXIT FUNCTION

    DIM lfW AS LONG, lfH AS LONG
    lfW& = _WIDTH(sourceImg&) : lfH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' flare point (upper-left third), image centre, axis to centre
    DIM fpx AS SINGLE, fpy AS SINGLE, ccx AS SINGLE, ccy AS SINGLE
    fpx! = lfW& * 0.32 : fpy! = lfH& * 0.3
    ccx! = lfW& / 2.0 : ccy! = lfH& / 2.0
    DIM bScale AS SINGLE : bScale! = bright% / 100.0
    DIM coreR AS SINGLE : coreR! = lfW& * 0.28

    ' up to 5 orbs at fractions along the axis (t: 0=flare point .. 2=opposite side)
    DIM orbT(0 TO 4) AS SINGLE, orbR(0 TO 4) AS SINGLE, orbI(0 TO 4) AS SINGLE
    orbT(0) = 0.0  : orbR(0) = coreR!        : orbI(0) = 1.0
    orbT(1) = 0.65 : orbR(1) = lfW& * 0.06   : orbI(1) = 0.35
    orbT(2) = 1.0  : orbR(2) = lfW& * 0.11   : orbI(2) = 0.25
    orbT(3) = 1.35 : orbR(3) = lfW& * 0.045  : orbI(3) = 0.4
    orbT(4) = 1.7  : orbR(4) = lfW& * 0.09   : orbI(4) = 0.2

    DIM lx AS LONG, ly AS LONG, o AS INTEGER
    DIM ox AS SINGLE, oy AS SINGLE, dxs AS SINGLE, dys AS SINGLE, dist AS SINGLE, f AS SINGLE
    DIM addv AS SINGLE, px AS _UNSIGNED LONG
    DIM nr AS INTEGER, ng AS INTEGER, nb AS INTEGER
    FOR ly& = 0 TO lfH& - 1
    IF (ly& AND 15) = 0 THEN IMGADJ_progress_tick "Lensflare", ly& / lfH&
        FOR lx& = 0 TO lfW& - 1
            addv! = 0.0
            FOR o% = 0 TO 4
                ox! = fpx! + (ccx! - fpx!) * orbT(o%)
                oy! = fpy! + (ccy! - fpy!) * orbT(o%)
                dxs! = lx& - ox! : dys! = ly& - oy!
                dist! = SQR(dxs! * dxs! + dys! * dys!)
                IF dist! < orbR(o%) THEN
                    f! = 1.0 - dist! / orbR(o%)
                    addv! = addv! + f! * f! * orbI(o%)
                END IF
            NEXT o%
            IF addv! > 0.0 THEN
                addv! = addv! * bScale! * 255.0
                _MEMGET srcM, srcM.OFFSET + (ly& * lfW& + lx&) * 4, px~&
                nr% = _RED32(px~&) + addv! : IF nr% > 255 THEN nr% = 255
                ng% = _GREEN32(px~&) + addv! * 0.95 : IF ng% > 255 THEN ng% = 255
                nb% = _BLUE32(px~&) + addv! * 0.8 : IF nb% > 255 THEN nb% = 255
                ' Alpha = max(original, flare brightness) so the flare RENDERS on a
                ' blank/transparent layer, while staying opaque over a photo.
                DIM lfA AS INTEGER : lfA% = _ALPHA32(px~&)
                DIM lfB AS INTEGER : lfB% = INT(addv!) : IF lfB% > 255 THEN lfB% = 255
                IF lfB% > lfA% THEN lfA% = lfB%
                _MEMPUT resM, resM.OFFSET + (ly& * lfW& + lx&) * 4, _RGBA32(nr%, ng%, nb%, lfA%) AS _UNSIGNED LONG
            END IF
        NEXT lx&
    NEXT ly&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_lensflare& = result&
END FUNCTION


''
' Open a modal Lens Flare dialog: single BRIGHTNESS slider (10..100).
'
SUB IMAGE_ADJ_lensflare_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM brt AS INTEGER : brt% = 70
    DIM oBrt AS INTEGER

    DIM k AS LONG
    DIM d_brt AS INTEGER : d_brt% = 70
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oBrt% = brt%
        brt% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, brt%, 10, 100)
        brt% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, brt%, 10, 100)
        IF brt% <> oBrt% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, brt%, d_brt%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_lensflare&(ctx.origThumb, brt%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "LENS FLARE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "BRIGHTNESS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, brt%, 10, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM lfTargets(1 TO MAX_LAYERS) AS INTEGER, lfTgtCount AS INTEGER, lfT AS INTEGER
        DIM lfSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets lfTargets%(), lfTgtCount%
        lfSaveCL% = CURRENT_LAYER%
        IF lfTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR lfT% = 1 TO lfTgtCount%
            CURRENT_LAYER% = lfTargets%(lfT%)
            adjR&          = IMAGE_ADJ_lensflare&(LAYERS(CURRENT_LAYER%).imgHandle&, brt%)
            IMAGE_ADJ_apply_spatial adjR&, "Lens Flare"
        NEXT lfT%
        IF lfTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = lfSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Difference Clouds — generate grayscale plasma and difference it per-channel with
' the existing pixels (|src - cloud|), the marbled/veiny Photoshop look. Keeps
' original alpha (apply_to_layer). One-shot (fixed scale).
'
' @param sourceImg LONG    Source image (32-bit)
' @param scaleP    INTEGER Base feature size in px
' @return LONG  New differenced image handle
'
FUNCTION IMAGE_ADJ_diffclouds& (sourceImg AS LONG, scaleP AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_diffclouds& = 0 : EXIT FUNCTION
    IF scaleP% < 4 THEN scaleP% = 4

    DIM dcW AS LONG, dcH AS LONG
    dcW& = _WIDTH(sourceImg&) : dcH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM dx AS LONG, dy AS LONG, oct AS INTEGER
    DIM nv AS SINGLE, fr AS SINGLE, amp AS SINGLE, amax AS SINGLE
    DIM cg AS INTEGER, px AS _UNSIGNED LONG
    FOR dy& = 0 TO dcH& - 1
    IF (dy& AND 15) = 0 THEN IMGADJ_progress_tick "Diffclouds", dy& / dcH&
        FOR dx& = 0 TO dcW& - 1
            nv! = 0.0 : fr! = 1.0 / scaleP% : amp! = 1.0 : amax! = 0.0
            FOR oct% = 0 TO 2
                nv! = nv! + IMGADJ_valnoise!(dx& * fr!, dy& * fr!, oct% + 1) * amp!
                amax! = amax! + amp!
                amp! = amp! * 0.5 : fr! = fr! * 2.0
            NEXT oct%
            cg% = INT(nv! / amax! * 255)
            _MEMGET srcM, srcM.OFFSET + (dy& * dcW& + dx&) * 4, px~&
            _MEMPUT resM, resM.OFFSET + (dy& * dcW& + dx&) * 4, _RGBA32(ABS(_RED32(px~&) - cg%), ABS(_GREEN32(px~&) - cg%), ABS(_BLUE32(px~&) - cg%), _ALPHA32(px~&)) AS _UNSIGNED LONG
        NEXT dx&
    NEXT dy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_diffclouds& = result&
END FUNCTION


''
' Direct op — apply Difference Clouds to the active (and extra-selected) layers.
'
SUB IMAGE_ADJ_diffclouds ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB
    DIM iatTargets(1 TO MAX_LAYERS) AS INTEGER, iatTgtCount AS INTEGER, iatT AS INTEGER
    DIM iatSaveCL AS INTEGER
    IMAGE_ADJ_collect_targets iatTargets%(), iatTgtCount%
    IF iatTgtCount% = 0 THEN EXIT SUB
    iatSaveCL% = CURRENT_LAYER%
    IF iatTgtCount% > 1 THEN HISTORY_begin_group
    DIM adjR      AS LONG
    FOR iatT% = 1 TO iatTgtCount%
        CURRENT_LAYER% = iatTargets%(iatT%)
        adjR&          = IMAGE_ADJ_diffclouds&(LAYERS(CURRENT_LAYER%).imgHandle&, 24)
        IMAGE_ADJ_apply_spatial adjR&, "Difference Clouds"
    NEXT iatT%
    IF iatTgtCount% > 1 THEN HISTORY_end_group
    CURRENT_LAYER% = iatSaveCL%
END SUB


''
' Clouds — fill the layer with fractal plasma noise mapped along a BG..FG ramp
' (3 octaves of value noise). Generative: ignores existing content and fills
' opaque, so commit via apply_spatial.
'
' @param sourceImg LONG           Source image (used only for dimensions)
' @param loColor   _UNSIGNED LONG Low end of the ramp
' @param hiColor   _UNSIGNED LONG High end of the ramp
' @param scaleP    INTEGER        Base feature size in px (8..64)
' @return LONG  New opaque cloud image handle
'
FUNCTION IMAGE_ADJ_clouds& (sourceImg AS LONG, loColor AS _UNSIGNED LONG, hiColor AS _UNSIGNED LONG, scaleP AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_clouds& = 0 : EXIT FUNCTION
    IF scaleP% < 4 THEN scaleP% = 4

    DIM clW AS LONG, clH AS LONG
    clW& = _WIDTH(sourceImg&) : clH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _NEWIMAGE(clW&, clH&, 32)
    DIM resM AS _MEM : resM = _MEMIMAGE(result&)

    DIM clLoR AS INTEGER, clLoG AS INTEGER, clLoB AS INTEGER
    DIM clHiR AS INTEGER, clHiG AS INTEGER, clHiB AS INTEGER
    clLoR% = _RED32(loColor~&) : clLoG% = _GREEN32(loColor~&) : clLoB% = _BLUE32(loColor~&)
    clHiR% = _RED32(hiColor~&) : clHiG% = _GREEN32(hiColor~&) : clHiB% = _BLUE32(hiColor~&)

    DIM cx AS LONG, cy AS LONG
    DIM nv AS SINGLE, fr AS SINGLE, amp AS SINGLE, amax AS SINGLE
    DIM oct AS INTEGER, cr AS INTEGER, cg AS INTEGER, cb AS INTEGER
    FOR cy& = 0 TO clH& - 1
    IF (cy& AND 15) = 0 THEN IMGADJ_progress_tick "Clouds", cy& / clH&
        FOR cx& = 0 TO clW& - 1
            nv! = 0.0 : fr! = 1.0 / scaleP% : amp! = 1.0 : amax! = 0.0
            FOR oct% = 0 TO 2
                nv! = nv! + IMGADJ_valnoise!(cx& * fr!, cy& * fr!, oct% + 1) * amp!
                amax! = amax! + amp!
                amp! = amp! * 0.5 : fr! = fr! * 2.0
            NEXT oct%
            nv! = nv! / amax!
            cr% = clLoR% + (clHiR% - clLoR%) * nv!
            cg% = clLoG% + (clHiG% - clLoG%) * nv!
            cb% = clLoB% + (clHiB% - clLoB%) * nv!
            _MEMPUT resM, resM.OFFSET + (cy& * clW& + cx&) * 4, _RGBA32(cr%, cg%, cb%, 255) AS _UNSIGNED LONG
        NEXT cx&
    NEXT cy&

    _MEMFREE resM
    IMAGE_ADJ_clouds& = result&
END FUNCTION


''
' Open a modal Clouds dialog: single SCALE slider (8..64). Ramp = BG..FG.
' Generative fill -> apply_spatial.
'
SUB IMAGE_ADJ_clouds_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM scl AS INTEGER : scl% = 24
    DIM oScl AS INTEGER

    DIM k AS LONG
    DIM d_scl AS INTEGER : d_scl% = 24
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oScl% = scl%
        scl% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, scl%, 8, 400)
        scl% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, scl%, 8, 400)
        IF scl% <> oScl% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, scl%, d_scl%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_clouds&(ctx.origThumb, PAINT_BG_COLOR~&, PAINT_COLOR~&, scl%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "CLOUDS"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "SCALE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, scl%, 8, 400, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM clTargets(1 TO MAX_LAYERS) AS INTEGER, clTgtCount AS INTEGER, clT AS INTEGER
        DIM clSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets clTargets%(), clTgtCount%
        clSaveCL% = CURRENT_LAYER%
        IF clTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR clT% = 1 TO clTgtCount%
            CURRENT_LAYER% = clTargets%(clT%)
            adjR&          = IMAGE_ADJ_clouds&(LAYERS(CURRENT_LAYER%).imgHandle&, PAINT_BG_COLOR~&, PAINT_COLOR~&, scl%)
            IMAGE_ADJ_apply_spatial adjR&, "Clouds"
        NEXT clT%
        IF clTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = clSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Wind — horizontal streaking from vertical edges (the Photoshop "wind" look).
' Scanning each row, where the luminance jumps between neighbouring pixels the
' edge colour is smeared rightward for up to `strength` px with a linear fade.
' Same size; alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param strength  INTEGER Streak length in px (2..20)
' @return LONG  New wind-streaked image handle
'
FUNCTION IMAGE_ADJ_wind& (sourceImg AS LONG, strength AS INTEGER, dirDeg AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_wind& = 0 : EXIT FUNCTION

    DIM wiW AS LONG, wiH AS LONG
    wiW& = _WIDTH(sourceImg&) : wiH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    ' Downwind step vector from the direction angle, snapped to the 8 compass
    ' directions (0=right, 90=up, screen-y grows down). Streaks smear downwind;
    ' the edge test compares each pixel with its UPWIND neighbour.
    DIM wRad AS SINGLE : wRad! = dirDeg% * 3.14159265 / 180.0
    DIM sdx AS INTEGER, sdy AS INTEGER
    sdx% = CINT(COS(wRad!)) : sdy% = CINT(-SIN(wRad!))
    IF sdx% = 0 AND sdy% = 0 THEN sdx% = 1                     ' degenerate -> rightward

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM wx AS LONG, wy AS LONG, k AS INTEGER
    DIM cur AS _UNSIGNED LONG, prev AS _UNSIGNED LONG, dst AS _UNSIGNED LONG
    DIM lc AS INTEGER, lp AS INTEGER, fade AS SINGLE
    DIM nr AS INTEGER, ng AS INTEGER, nb AS INTEGER, tx AS LONG, ty AS LONG, px AS LONG, py AS LONG
    FOR wy& = 0 TO wiH& - 1
    IF (wy& AND 15) = 0 THEN IMGADJ_progress_tick "Wind", wy& / wiH&
        FOR wx& = 0 TO wiW& - 1
            px& = wx& - sdx% : py& = wy& - sdy%                ' upwind neighbour
            IF px& < 0 OR px& >= wiW& OR py& < 0 OR py& >= wiH& THEN _CONTINUE
            _MEMGET srcM, srcM.OFFSET + (wy& * wiW& + wx&) * 4, cur~&
            _MEMGET srcM, srcM.OFFSET + (py& * wiW& + px&) * 4, prev~&
            lc% = (_RED32(cur~&) * 30 + _GREEN32(cur~&) * 59 + _BLUE32(cur~&) * 11) \ 100
            lp% = (_RED32(prev~&) * 30 + _GREEN32(prev~&) * 59 + _BLUE32(prev~&) * 11) \ 100
            IF ABS(lc% - lp%) > 28 THEN
                FOR k% = 1 TO strength%
                    tx& = wx& + sdx% * k% : ty& = wy& + sdy% * k%
                    IF tx& < 0 OR tx& >= wiW& OR ty& < 0 OR ty& >= wiH& THEN EXIT FOR
                    fade! = (strength% - k% + 1) / (strength% + 0.0)
                    _MEMGET resM, resM.OFFSET + (ty& * wiW& + tx&) * 4, dst~&
                    nr% = _RED32(dst~&) + (_RED32(cur~&) - _RED32(dst~&)) * fade!
                    ng% = _GREEN32(dst~&) + (_GREEN32(cur~&) - _GREEN32(dst~&)) * fade!
                    nb% = _BLUE32(dst~&) + (_BLUE32(cur~&) - _BLUE32(dst~&)) * fade!
                    _MEMPUT resM, resM.OFFSET + (ty& * wiW& + tx&) * 4, _RGBA32(nr%, ng%, nb%, _ALPHA32(dst~&)) AS _UNSIGNED LONG
                NEXT k%
            END IF
        NEXT wx&
    NEXT wy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_wind& = result&
END FUNCTION


''
' Open a modal Wind dialog: single STRENGTH slider (2..20).
'
SUB IMAGE_ADJ_wind_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 150
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM stg AS INTEGER : stg% = 10
    DIM oStg AS INTEGER
    DIM wdir AS INTEGER : wdir% = 0                 ' 0=right .. 315, snapped to 8-way in engine
    DIM oWdir AS INTEGER

    DIM k AS LONG
    DIM d_stg AS INTEGER : d_stg% = 10
    DIM d_wdir AS INTEGER : d_wdir% = 0
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oStg% = stg% : oWdir% = wdir%
        stg% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, stg%, 2, 80)
        stg% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, stg%, 2, 80)
        wdir% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, wdir%, 0, 315)
        wdir% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, wdir%, 0, 315)
        IF stg% <> oStg% OR wdir% <> oWdir% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, stg%, wdir%, d_stg%, d_wdir%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_wind&(ctx.origThumb, stg%, wdir%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "WIND"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "STRENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, stg%, 2, 80, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "DIRECTION:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, wdir%, 0, 315, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM wiTargets(1 TO MAX_LAYERS) AS INTEGER, wiTgtCount AS INTEGER, wiT AS INTEGER
        DIM wiSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets wiTargets%(), wiTgtCount%
        wiSaveCL% = CURRENT_LAYER%
        IF wiTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR wiT% = 1 TO wiTgtCount%
            CURRENT_LAYER% = wiTargets%(wiT%)
            adjR&          = IMAGE_ADJ_wind&(LAYERS(CURRENT_LAYER%).imgHandle&, stg%, wdir%)
            IMAGE_ADJ_apply_to_layer adjR&, "Wind"
        NEXT wiT%
        IF wiTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = wiSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Pointillize — scatter filled dots of the sampled colour over the BG colour, one
' per grid cell at a hash-jittered position (deterministic). Alpha preserved
' (apply_to_layer), so the dots stay masked to the original shape.
'
' @param sourceImg LONG           Source image (32-bit)
' @param dotSize   INTEGER        Cell/dot diameter in px (3..20)
' @param bgColor   _UNSIGNED LONG Background fill colour
' @return LONG  New pointillized image handle
'
FUNCTION IMAGE_ADJ_pointillize& (sourceImg AS LONG, dotSize AS INTEGER, bgColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_pointillize& = 0 : EXIT FUNCTION
    IF dotSize% < 2 THEN dotSize% = 2

    DIM poW AS LONG, poH AS LONG
    poW& = _WIDTH(sourceImg&) : poH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _NEWIMAGE(poW&, poH&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' fill with BG colour (opaque)
    DIM bgOpaque AS _UNSIGNED LONG
    bgOpaque~& = _RGBA32(_RED32(bgColor~&), _GREEN32(bgColor~&), _BLUE32(bgColor~&), 255)
    DIM i AS LONG
    FOR i& = 0 TO resM.SIZE - 4 STEP 4
        _MEMPUT resM, resM.OFFSET + i&, bgOpaque~& AS _UNSIGNED LONG
    NEXT i&

    DIM gx AS LONG, gy AS LONG, hsh AS LONG, jx AS LONG, jy AS LONG
    DIM rad AS INTEGER, r2 AS INTEGER, dx AS INTEGER, dy AS INTEGER, px AS LONG, py AS LONG
    DIM dotC AS _UNSIGNED LONG
    rad% = dotSize% \ 2 : IF rad% < 1 THEN rad% = 1
    r2% = rad% * rad%
    FOR gy& = 0 TO poH& - 1 STEP dotSize%
    IF (gy& AND 15) = 0 THEN IMGADJ_progress_tick "Pointillize", gy& / poH&
        FOR gx& = 0 TO poW& - 1 STEP dotSize%
            hsh& = ((gx& * 73856093) XOR (gy& * 19349663)) AND 1023
            jx& = gx& + (hsh& AND 31) * dotSize% \ 32
            jy& = gy& + ((hsh& \ 32) AND 31) * dotSize% \ 32
            IF jx& >= poW& THEN jx& = poW& - 1
            IF jy& >= poH& THEN jy& = poH& - 1
            _MEMGET srcM, srcM.OFFSET + (jy& * poW& + jx&) * 4, dotC~&
            dotC~& = _RGBA32(_RED32(dotC~&), _GREEN32(dotC~&), _BLUE32(dotC~&), 255)
            FOR dy% = -rad% TO rad%
                py& = jy& + dy%
                IF py& >= 0 AND py& < poH& THEN
                    FOR dx% = -rad% TO rad%
                        IF dx% * dx% + dy% * dy% <= r2% THEN
                            px& = jx& + dx%
                            IF px& >= 0 AND px& < poW& THEN _MEMPUT resM, resM.OFFSET + (py& * poW& + px&) * 4, dotC~& AS _UNSIGNED LONG
                        END IF
                    NEXT dx%
                END IF
            NEXT dy%
        NEXT gx&
    NEXT gy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_pointillize& = result&
END FUNCTION


''
' Open a modal Pointillize dialog: single DOT SIZE slider (3..20). Background is
' the current BG colour.
'
SUB IMAGE_ADJ_pointillize_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM dsz AS INTEGER : dsz% = 8
    DIM oDsz AS INTEGER

    DIM k AS LONG
    DIM d_dsz AS INTEGER : d_dsz% = 8
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oDsz% = dsz%
        dsz% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, dsz%, 3, 100)
        dsz% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, dsz%, 3, 100)
        IF dsz% <> oDsz% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, dsz%, d_dsz%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_pointillize&(ctx.origThumb, dsz%, PAINT_BG_COLOR~&)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "POINTILLIZE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "DOT SIZE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, dsz%, 3, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM poTargets(1 TO MAX_LAYERS) AS INTEGER, poTgtCount AS INTEGER, poT AS INTEGER
        DIM poSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets poTargets%(), poTgtCount%
        poSaveCL% = CURRENT_LAYER%
        IF poTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR poT% = 1 TO poTgtCount%
            CURRENT_LAYER% = poTargets%(poT%)
            adjR&          = IMAGE_ADJ_pointillize&(LAYERS(CURRENT_LAYER%).imgHandle&, dsz%, PAINT_BG_COLOR~&)
            IMAGE_ADJ_apply_to_layer adjR&, "Pointillize"
        NEXT poT%
        IF poTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = poSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Extrude — 3D blocks. Each `tile` block is averaged; its brightness sets a
' height, and the block's colour square is drawn raised toward the upper-left over
' a darkened base, so the gaps read as block sides (brighter tiles pop further).
' Alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param tile      INTEGER Block size in px (4..40)
' @param depth     INTEGER Max raise in px (2..16)
' @return LONG  New extruded image handle
'
FUNCTION IMAGE_ADJ_extrude& (sourceImg AS LONG, tile AS INTEGER, depth AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_extrude& = 0 : EXIT FUNCTION
    IF tile% < 2 THEN tile% = 2

    DIM exW AS LONG, exH AS LONG
    exW& = _WIDTH(sourceImg&) : exH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' darken the whole thing to ~35% as the recessed base / block sides
    DIM i AS LONG, px AS _UNSIGNED LONG, aa AS INTEGER
    FOR i& = 0 TO srcM.SIZE - 4 STEP 4
        _MEMGET srcM, srcM.OFFSET + i&, px~&
        aa% = _ALPHA32(px~&)
        _MEMPUT resM, resM.OFFSET + i&, _RGBA32(_RED32(px~&) * 35 \ 100, _GREEN32(px~&) * 35 \ 100, _BLUE32(px~&) * 35 \ 100, aa%) AS _UNSIGNED LONG
    NEXT i&

    DIM bx AS LONG, by AS LONG, ix AS LONG, iy AS LONG
    DIM sr AS LONG, sg AS LONG, sb AS LONG, sa AS LONG, cnt AS LONG, bri AS LONG, hgt AS LONG
    DIM x2 AS LONG, y2 AS LONG, fx AS LONG, fy AS LONG
    DIM avgC AS _UNSIGNED LONG
    FOR by& = 0 TO exH& - 1 STEP tile%
    IF (by& AND 15) = 0 THEN IMGADJ_progress_tick "Extrude", by& / exH&
        y2& = by& + tile% - 1 : IF y2& >= exH& THEN y2& = exH& - 1
        FOR bx& = 0 TO exW& - 1 STEP tile%
            x2& = bx& + tile% - 1 : IF x2& >= exW& THEN x2& = exW& - 1
            sr& = 0 : sg& = 0 : sb& = 0 : sa& = 0 : cnt& = 0
            FOR iy& = by& TO y2&
                FOR ix& = bx& TO x2&
                    _MEMGET srcM, srcM.OFFSET + (iy& * exW& + ix&) * 4, px~&
                    sr& = sr& + _RED32(px~&) : sg& = sg& + _GREEN32(px~&)
                    sb& = sb& + _BLUE32(px~&) : sa& = sa& + _ALPHA32(px~&)
                    cnt& = cnt& + 1
                NEXT ix&
            NEXT iy&
            IF cnt& = 0 THEN cnt& = 1
            sr& = sr& \ cnt& : sg& = sg& \ cnt& : sb& = sb& \ cnt& : sa& = sa& \ cnt&
            bri& = (sr& * 30 + sg& * 59 + sb& * 11) \ 100
            hgt& = bri& * depth% \ 255
            avgC~& = _RGBA32(sr&, sg&, sb&, sa&)
            ' draw the raised top face (offset up-left by hgt)
            FOR fy& = by& - hgt& TO y2& - hgt&
                IF fy& >= 0 AND fy& < exH& THEN
                    FOR fx& = bx& - hgt& TO x2& - hgt&
                        IF fx& >= 0 AND fx& < exW& THEN _MEMPUT resM, resM.OFFSET + (fy& * exW& + fx&) * 4, avgC~& AS _UNSIGNED LONG
                    NEXT fx&
                END IF
            NEXT fy&
        NEXT bx&
    NEXT by&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_extrude& = result&
END FUNCTION


''
' Open a modal Extrude dialog: TILE (4..40) + DEPTH (2..16).
'
SUB IMAGE_ADJ_extrude_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM tsz AS INTEGER : tsz% = 14
    DIM dep AS INTEGER : dep% = 6
    DIM oTsz AS INTEGER, oDep AS INTEGER

    DIM k AS LONG
    DIM d_tsz AS INTEGER : d_tsz% = 14
    DIM d_dep AS INTEGER : d_dep% = 6
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oTsz% = tsz% : oDep% = dep%
        tsz% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, tsz%, 4, 200)
        tsz% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, tsz%, 4, 200)
        dep% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, dep%, 2, 64)
        dep% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, dep%, 2, 64)
        IF tsz% <> oTsz% OR dep% <> oDep% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, tsz%, dep%, d_tsz%, d_dep%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_extrude&(ctx.origThumb, tsz%, dep%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "EXTRUDE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "TILE SIZE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, tsz%, 4, 200, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "DEPTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, dep%, 2, 64, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM exTargets(1 TO MAX_LAYERS) AS INTEGER, exTgtCount AS INTEGER, exT AS INTEGER
        DIM exSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets exTargets%(), exTgtCount%
        exSaveCL% = CURRENT_LAYER%
        IF exTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR exT% = 1 TO exTgtCount%
            CURRENT_LAYER% = exTargets%(exT%)
            adjR&          = IMAGE_ADJ_extrude&(LAYERS(CURRENT_LAYER%).imgHandle&, tsz%, dep%)
            IMAGE_ADJ_apply_to_layer adjR&, "Extrude"
        NEXT exT%
        IF exTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = exSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Mosaic / Tessellate — average the colour of each `tile` x `tile` block and fill
' the block with it (true averaging, unlike Pixelate's single-sample), optionally
' drawing thin dark grout between tiles. Alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param tile      INTEGER Tile size in px (3..48)
' @param grout     INTEGER 0 = none, 1 = 1px dark grout between tiles
' @return LONG  New mosaic image handle
'
FUNCTION IMAGE_ADJ_mosaic& (sourceImg AS LONG, tile AS INTEGER, grout AS INTEGER, groutSz AS INTEGER, groutColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_mosaic& = 0 : EXIT FUNCTION
    IF tile% < 2 THEN tile% = 2
    DIM moGs AS INTEGER : moGs% = groutSz% : IF moGs% < 1 THEN moGs% = 1
    IF moGs% > tile% - 1 THEN moGs% = tile% - 1        ' leave at least 1px of tile
    DIM moGr AS INTEGER, moGg AS INTEGER, moGb AS INTEGER
    moGr% = _RED32(groutColor~&) : moGg% = _GREEN32(groutColor~&) : moGb% = _BLUE32(groutColor~&)

    DIM moW AS LONG, moH AS LONG
    moW& = _WIDTH(sourceImg&) : moH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM bx AS LONG, by AS LONG, ix AS LONG, iy AS LONG
    DIM sr AS LONG, sg AS LONG, sb AS LONG, sa AS LONG, cnt AS LONG
    DIM px AS _UNSIGNED LONG, avg AS _UNSIGNED LONG
    DIM x2 AS LONG, y2 AS LONG, isGrout AS INTEGER
    FOR by& = 0 TO moH& - 1 STEP tile%
    IF (by& AND 15) = 0 THEN IMGADJ_progress_tick "Mosaic", by& / moH&
        y2& = by& + tile% - 1 : IF y2& >= moH& THEN y2& = moH& - 1
        FOR bx& = 0 TO moW& - 1 STEP tile%
            x2& = bx& + tile% - 1 : IF x2& >= moW& THEN x2& = moW& - 1
            sr& = 0 : sg& = 0 : sb& = 0 : sa& = 0 : cnt& = 0
            FOR iy& = by& TO y2&
                FOR ix& = bx& TO x2&
                    _MEMGET srcM, srcM.OFFSET + (iy& * moW& + ix&) * 4, px~&
                    sr& = sr& + _RED32(px~&) : sg& = sg& + _GREEN32(px~&)
                    sb& = sb& + _BLUE32(px~&) : sa& = sa& + _ALPHA32(px~&)
                    cnt& = cnt& + 1
                NEXT ix&
            NEXT iy&
            IF cnt& = 0 THEN cnt& = 1
            avg~& = _RGBA32(sr& \ cnt&, sg& \ cnt&, sb& \ cnt&, sa& \ cnt&)
            FOR iy& = by& TO y2&
                FOR ix& = bx& TO x2&
                    isGrout% = 0
                    IF grout% <> 0 THEN
                        IF ix& < bx& + moGs% OR iy& < by& + moGs% THEN isGrout% = 1
                    END IF
                    IF isGrout% THEN
                        _MEMPUT resM, resM.OFFSET + (iy& * moW& + ix&) * 4, _RGBA32(moGr%, moGg%, moGb%, sa& \ cnt&) AS _UNSIGNED LONG
                    ELSE
                        _MEMPUT resM, resM.OFFSET + (iy& * moW& + ix&) * 4, avg~& AS _UNSIGNED LONG
                    END IF
                NEXT ix&
            NEXT iy&
        NEXT bx&
    NEXT by&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_mosaic& = result&
END FUNCTION


''
' Open a modal Mosaic dialog: TILE SIZE (3..48) + GROUT toggle.
'
SUB IMAGE_ADJ_mosaic_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 172
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM tsz AS INTEGER : tsz% = 12
    DIM oTsz AS INTEGER
    DIM gsz AS INTEGER : gsz% = 1
    DIM oGsz AS INTEGER
    STATIC groutOn AS INTEGER

    DIM gvX AS INTEGER, gvY AS INTEGER, gvW AS INTEGER, gvH AS INTEGER
    gvX% = IMGDLG_SX : gvW% = 120 : gvH% = 16
    gvY% = IMGDLG_track_y%(ctx, 1) + 24

    DIM k AS LONG
    DIM d_tsz AS INTEGER : d_tsz% = 12
    DIM d_gsz AS INTEGER : d_gsz% = 1
    DIM d_groutOn AS INTEGER : d_groutOn% = FALSE
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oTsz% = tsz% : oGsz% = gsz%
        tsz% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, tsz%, 3, 200)
        tsz% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, tsz%, 3, 200)
        gsz% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, gsz%, 1, 48)
        gsz% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, gsz%, 1, 48)
        IF DIALOG_hit%(ctx, gvX%, gvY%, gvW%, gvH%) THEN
            groutOn%          = (groutOn% = 0)
            ctx.previewDirty% = TRUE
        END IF
        IF tsz% <> oTsz% OR gsz% <> oGsz% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset3 ctx, tsz%, gsz%, groutOn%, d_tsz%, d_gsz%, d_groutOn%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_mosaic&(ctx.origThumb, tsz%, groutOn%, gsz%, PAINT_BG_COLOR~&)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "MOSAIC / TESSELLATE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "TILE SIZE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, tsz%, 3, 200, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "GROUT SIZE (BG COLOR):"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, gsz%, 1, 48, "", ""
        DIALOG_draw_toggle ctx, gvX%, gvY%, gvW%, gvH%, "GROUT", groutOn%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM moTargets(1 TO MAX_LAYERS) AS INTEGER, moTgtCount AS INTEGER, moT AS INTEGER
        DIM moSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets moTargets%(), moTgtCount%
        moSaveCL% = CURRENT_LAYER%
        IF moTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR moT% = 1 TO moTgtCount%
            CURRENT_LAYER% = moTargets%(moT%)
            adjR&          = IMAGE_ADJ_mosaic&(LAYERS(CURRENT_LAYER%).imgHandle&, tsz%, groutOn%, gsz%, PAINT_BG_COLOR~&)
            IMAGE_ADJ_apply_to_layer adjR&, "Mosaic"
        NEXT moT%
        IF moTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = moSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Stained Glass — like Crystallize, but darken pixels near cell boundaries (where
' the nearest and 2nd-nearest seeds are almost equidistant) to draw the leading
' between glass panes. Alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param cellSize  INTEGER Approx pane size in px (4..40)
' @param borderW   INTEGER Leading thickness in px (1..4)
' @return LONG  New stained-glass image handle
'
FUNCTION IMAGE_ADJ_stainedglass& (sourceImg AS LONG, cellSize AS INTEGER, borderW AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_stainedglass& = 0 : EXIT FUNCTION
    IF cellSize% < 2 THEN cellSize% = 2

    DIM sgW AS LONG, sgH AS LONG
    sgW& = _WIDTH(sourceImg&) : sgH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM cxp AS LONG, cyp AS LONG, gx AS LONG, gy AS LONG, ngx AS LONG, ngy AS LONG
    DIM hsh AS LONG, seedX AS LONG, seedY AS LONG
    DIM bestX AS LONG, bestY AS LONG, bestD AS LONG, secondD AS LONG, dd AS LONG
    DIM px AS _UNSIGNED LONG, aOld AS _UNSIGNED _BYTE
    FOR cyp& = 0 TO sgH& - 1
    IF (cyp& AND 15) = 0 THEN IMGADJ_progress_tick "Stainedglass", cyp& / sgH&
        gy& = cyp& \ cellSize%
        FOR cxp& = 0 TO sgW& - 1
            gx& = cxp& \ cellSize%
            bestD& = 2147483647 : secondD& = 2147483647
            bestX& = cxp& : bestY& = cyp&
            FOR ngy& = gy& - 1 TO gy& + 1
                FOR ngx& = gx& - 1 TO gx& + 1
                    hsh& = ((ngx& * 73856093) XOR (ngy& * 19349663)) AND 1023
                    seedX& = ngx& * cellSize% + (hsh& AND 31) * cellSize% \ 32
                    seedY& = ngy& * cellSize% + ((hsh& \ 32) AND 31) * cellSize% \ 32
                    dd& = (cxp& - seedX&) * (cxp& - seedX&) + (cyp& - seedY&) * (cyp& - seedY&)
                    IF dd& < bestD& THEN
                        secondD& = bestD& : bestD& = dd& : bestX& = seedX& : bestY& = seedY&
                    ELSEIF dd& < secondD& THEN
                        secondD& = dd&
                    END IF
                NEXT ngx&
                NEXT ngy&
            IF SQR(secondD&) - SQR(bestD&) < borderW% THEN
                ' leading — dark, keep source alpha
                _MEMGET srcM, srcM.OFFSET + (cyp& * sgW& + cxp&) * 4 + 3, aOld~%%
                _MEMPUT resM, resM.OFFSET + (cyp& * sgW& + cxp&) * 4, _RGBA32(12, 12, 16, aOld~%%) AS _UNSIGNED LONG
            ELSE
                IF bestX& < 0 THEN bestX& = 0 ELSE IF bestX& >= sgW& THEN bestX& = sgW& - 1
                IF bestY& < 0 THEN bestY& = 0 ELSE IF bestY& >= sgH& THEN bestY& = sgH& - 1
                _MEMGET srcM, srcM.OFFSET + (bestY& * sgW& + bestX&) * 4, px~&
                _MEMPUT resM, resM.OFFSET + (cyp& * sgW& + cxp&) * 4, px~& AS _UNSIGNED LONG
            END IF
        NEXT cxp&
    NEXT cyp&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_stainedglass& = result&
END FUNCTION


''
' Open a modal Stained Glass dialog: CELL SIZE (4..40) + BORDER (1..4).
'
SUB IMAGE_ADJ_stainedglass_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM csz AS INTEGER : csz% = 14
    DIM bdr AS INTEGER : bdr% = 2
    DIM oCsz AS INTEGER, oBdr AS INTEGER

    DIM k AS LONG
    DIM d_csz AS INTEGER : d_csz% = 14
    DIM d_bdr AS INTEGER : d_bdr% = 2
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oCsz% = csz% : oBdr% = bdr%
        csz% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, csz%, 4, 200)
        csz% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, csz%, 4, 200)
        bdr% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, bdr%, 1, 16)
        bdr% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, bdr%, 1, 16)
        IF csz% <> oCsz% OR bdr% <> oBdr% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, csz%, bdr%, d_csz%, d_bdr%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_stainedglass&(ctx.origThumb, csz%, bdr%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "STAINED GLASS"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "CELL SIZE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, csz%, 4, 200, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "BORDER:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, bdr%, 1, 16, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM sgTargets(1 TO MAX_LAYERS) AS INTEGER, sgTgtCount AS INTEGER, sgT AS INTEGER
        DIM sgSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets sgTargets%(), sgTgtCount%
        sgSaveCL% = CURRENT_LAYER%
        IF sgTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR sgT% = 1 TO sgTgtCount%
            CURRENT_LAYER% = sgTargets%(sgT%)
            adjR&          = IMAGE_ADJ_stainedglass&(LAYERS(CURRENT_LAYER%).imgHandle&, csz%, bdr%)
            IMAGE_ADJ_apply_to_layer adjR&, "Stained Glass"
        NEXT sgT%
        IF sgTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = sgSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Crystallize — Voronoi cells. One jittered seed per `cellSize` grid cell
' (deterministic hash jitter — no RNG); each pixel takes the source colour at its
' nearest seed among the 3x3 neighbouring grid cells, giving flat polygonal
' crystals. Alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit)
' @param cellSize  INTEGER Approx crystal size in px (4..40)
' @return LONG  New crystallized image handle
'
FUNCTION IMAGE_ADJ_crystallize& (sourceImg AS LONG, cellSize AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_crystallize& = 0 : EXIT FUNCTION
    IF cellSize% < 2 THEN cellSize% = 2

    DIM crW AS LONG, crH AS LONG
    crW& = _WIDTH(sourceImg&) : crH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM cxp AS LONG, cyp AS LONG, gx AS LONG, gy AS LONG, ngx AS LONG, ngy AS LONG
    DIM hsh AS LONG, seedX AS LONG, seedY AS LONG
    DIM bestX AS LONG, bestY AS LONG, bestD AS LONG, dd AS LONG
    DIM px AS _UNSIGNED LONG
    FOR cyp& = 0 TO crH& - 1
    IF (cyp& AND 15) = 0 THEN IMGADJ_progress_tick "Crystallize", cyp& / crH&
        gy& = cyp& \ cellSize%
        FOR cxp& = 0 TO crW& - 1
            gx& = cxp& \ cellSize%
            bestD& = 2147483647
            bestX& = cxp& : bestY& = cyp&
            FOR ngy& = gy& - 1 TO gy& + 1
                FOR ngx& = gx& - 1 TO gx& + 1
                    hsh& = ((ngx& * 73856093) XOR (ngy& * 19349663)) AND 1023
                    seedX& = ngx& * cellSize% + (hsh& AND 31) * cellSize% \ 32
                    seedY& = ngy& * cellSize% + ((hsh& \ 32) AND 31) * cellSize% \ 32
                    dd& = (cxp& - seedX&) * (cxp& - seedX&) + (cyp& - seedY&) * (cyp& - seedY&)
                    IF dd& < bestD& THEN
                        bestD& = dd& : bestX& = seedX& : bestY& = seedY&
                    END IF
                NEXT ngx&
                NEXT ngy&
            IF bestX& < 0 THEN bestX& = 0 ELSE IF bestX& >= crW& THEN bestX& = crW& - 1
            IF bestY& < 0 THEN bestY& = 0 ELSE IF bestY& >= crH& THEN bestY& = crH& - 1
            _MEMGET srcM, srcM.OFFSET + (bestY& * crW& + bestX&) * 4, px~&
            _MEMPUT resM, resM.OFFSET + (cyp& * crW& + cxp&) * 4, px~& AS _UNSIGNED LONG
        NEXT cxp&
    NEXT cyp&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_crystallize& = result&
END FUNCTION


''
' Open a modal Crystallize dialog: single CELL SIZE slider (4..40).
'
SUB IMAGE_ADJ_crystallize_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM csz AS INTEGER : csz% = 12
    DIM oCsz AS INTEGER

    DIM k AS LONG
    DIM d_csz AS INTEGER : d_csz% = 12
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oCsz% = csz%
        csz% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, csz%, 4, 200)
        csz% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, csz%, 4, 200)
        IF csz% <> oCsz% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, csz%, d_csz%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_crystallize&(ctx.origThumb, csz%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "CRYSTALLIZE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "CELL SIZE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, csz%, 4, 200, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM crTargets(1 TO MAX_LAYERS) AS INTEGER, crTgtCount AS INTEGER, crT AS INTEGER
        DIM crSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets crTargets%(), crTgtCount%
        crSaveCL% = CURRENT_LAYER%
        IF crTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR crT% = 1 TO crTgtCount%
            CURRENT_LAYER% = crTargets%(crT%)
            adjR&          = IMAGE_ADJ_crystallize&(LAYERS(CURRENT_LAYER%).imgHandle&, csz%)
            IMAGE_ADJ_apply_to_layer adjR&, "Crystallize"
        NEXT crT%
        IF crTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = crSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Kaleidoscope — reflect one angular wedge of the image radially into a mandala.
' For each output pixel, its angle is folded into the base wedge (2*pi/segments)
' with mirroring on alternate wedges, then the source is sampled at that folded
' angle and the same radius. Turns any existing art into symmetric mandala
' tiling (unlike draw-time symmetry, which only mirrors new strokes). apply_spatial.
'
' @param sourceImg LONG    Source image (32-bit)
' @param segments  INTEGER Number of mirrored wedges (3..24)
' @param rotDeg    INTEGER Base rotation of the sampled wedge, degrees (0..359)
' @return LONG  New kaleidoscope image handle
'
FUNCTION IMAGE_ADJ_kaleidoscope& (sourceImg AS LONG, segments AS INTEGER, rotDeg AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_kaleidoscope& = 0 : EXIT FUNCTION
    IF segments% < 1 THEN segments% = 1

    DIM klW AS LONG, klH AS LONG
    klW& = _WIDTH(sourceImg&) : klH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _NEWIMAGE(klW&, klH&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM ccx AS SINGLE, ccy AS SINGLE
    ccx! = klW& / 2.0 : ccy! = klH& / 2.0
    DIM wedge AS SINGLE : wedge! = 6.2831853 / segments%
    DIM rot AS SINGLE : rot! = rotDeg% * 3.14159265 / 180.0

    DIM tx AS LONG, ty AS LONG, sxL AS LONG, syL AS LONG
    DIM ddx AS SINGLE, ddy AS SINGLE, rr AS SINGLE, ang AS SINGLE, fa AS SINGLE
    DIM klSeg AS LONG
    DIM px AS _UNSIGNED LONG
    FOR ty& = 0 TO klH& - 1
    IF (ty& AND 15) = 0 THEN IMGADJ_progress_tick "Kaleidoscope", ty& / klH&
        FOR tx& = 0 TO klW& - 1
            ddx! = tx& - ccx! : ddy! = ty& - ccy!
            rr! = SQR(ddx! * ddx! + ddy! * ddy!)
            ang! = _ATAN2(ddy!, ddx!)
            ' fold into [0, wedge) with mirroring on odd wedges
            fa! = ang! - wedge! * INT(ang! / wedge!)
            IF fa! < 0 THEN fa! = fa! + wedge!
            klSeg& = INT(ang! / wedge!)
            IF (klSeg& AND 1) <> 0 THEN fa! = wedge! - fa!
            fa! = fa! + rot!
            sxL& = INT(ccx! + COS(fa!) * rr! + 0.5)
            syL& = INT(ccy! + SIN(fa!) * rr! + 0.5)
            IF sxL& < 0 THEN sxL& = 0 ELSE IF sxL& >= klW& THEN sxL& = klW& - 1
            IF syL& < 0 THEN syL& = 0 ELSE IF syL& >= klH& THEN syL& = klH& - 1
            _MEMGET srcM, srcM.OFFSET + (syL& * klW& + sxL&) * 4, px~&
            _MEMPUT resM, resM.OFFSET + (ty& * klW& + tx&) * 4, px~& AS _UNSIGNED LONG
        NEXT tx&
    NEXT ty&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_kaleidoscope& = result&
END FUNCTION


''
' Open a modal Kaleidoscope dialog: SEGMENTS (3..24) + ROTATION (0..359).
' apply_spatial.
'
SUB IMAGE_ADJ_kaleidoscope_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM segs AS INTEGER : segs% = 8
    DIM rotd AS INTEGER : rotd% = 0
    DIM oSegs AS INTEGER, oRot AS INTEGER

    DIM k AS LONG
    DIM d_segs AS INTEGER : d_segs% = 8
    DIM d_rotd AS INTEGER : d_rotd% = 0
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oSegs% = segs% : oRot% = rotd%
        segs% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, segs%, 3, 64)
        segs% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, segs%, 3, 64)
        rotd% = IMGDLG_angle_handle%(ctx, 1, rotd%)
        IF segs% <> oSegs% OR rotd% <> oRot% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, segs%, rotd%, d_segs%, d_rotd%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_kaleidoscope&(ctx.origThumb, segs%, rotd%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "KALEIDOSCOPE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "SEGMENTS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, segs%, 3, 64, "", ""
        IMGDLG_angle_draw ctx, 1, rotd%, "ROTATION:"
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM klTargets(1 TO MAX_LAYERS) AS INTEGER, klTgtCount AS INTEGER, klT AS INTEGER
        DIM klSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets klTargets%(), klTgtCount%
        klSaveCL% = CURRENT_LAYER%
        IF klTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR klT% = 1 TO klTgtCount%
            CURRENT_LAYER% = klTargets%(klT%)
            adjR&          = IMAGE_ADJ_kaleidoscope&(LAYERS(CURRENT_LAYER%).imgHandle&, segs%, rotd%)
            IMAGE_ADJ_apply_spatial adjR&, "Kaleidoscope"
        NEXT klT%
        IF klTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = klSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Pinch / Bulge (Spherize) — radial power displacement around the centre.
' Positive `amount` bulges (magnifies the centre, fish-eye); negative pinches
' (sucks toward the centre). scale = t^(p-1) where t is the normalised radius and
' p = 1 - amount/200. apply_spatial.
'
' @param sourceImg LONG    Source image (32-bit)
' @param amount    INTEGER -100 (pinch) .. +100 (bulge)
' @return LONG  New displaced image handle
'
FUNCTION IMAGE_ADJ_pinch& (sourceImg AS LONG, amount AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_pinch& = 0 : EXIT FUNCTION

    DIM pnW AS LONG, pnH AS LONG
    pnW& = _WIDTH(sourceImg&) : pnH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _NEWIMAGE(pnW&, pnH&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM ccx AS SINGLE, ccy AS SINGLE, maxR AS SINGLE
    ccx! = pnW& / 2.0 : ccy! = pnH& / 2.0
    maxR! = ccx! : IF ccy! < maxR! THEN maxR! = ccy!
    DIM pw AS SINGLE : pw! = 1.0 - amount% / 200.0

    DIM tx AS LONG, ty AS LONG, sxL AS LONG, syL AS LONG
    DIM ddx AS SINGLE, ddy AS SINGLE, rr AS SINGLE, tnorm AS SINGLE, scl AS SINGLE
    DIM px AS _UNSIGNED LONG
    FOR ty& = 0 TO pnH& - 1
    IF (ty& AND 15) = 0 THEN IMGADJ_progress_tick "Pinch", ty& / pnH&
        FOR tx& = 0 TO pnW& - 1
            ddx! = tx& - ccx! : ddy! = ty& - ccy!
            rr! = SQR(ddx! * ddx! + ddy! * ddy!)
            IF rr! > 0.5 AND rr! < maxR! THEN
                tnorm! = rr! / maxR!
                scl! = tnorm! ^ (pw! - 1.0)
                sxL& = INT(ccx! + ddx! * scl! + 0.5)
                syL& = INT(ccy! + ddy! * scl! + 0.5)
            ELSE
                sxL& = tx& : syL& = ty&
            END IF
            IF sxL& < 0 THEN sxL& = 0 ELSE IF sxL& >= pnW& THEN sxL& = pnW& - 1
            IF syL& < 0 THEN syL& = 0 ELSE IF syL& >= pnH& THEN syL& = pnH& - 1
            _MEMGET srcM, srcM.OFFSET + (syL& * pnW& + sxL&) * 4, px~&
            _MEMPUT resM, resM.OFFSET + (ty& * pnW& + tx&) * 4, px~& AS _UNSIGNED LONG
        NEXT tx&
    NEXT ty&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_pinch& = result&
END FUNCTION


''
' Open a modal Pinch / Bulge dialog: AMOUNT slider (-100 pinch .. +100 bulge).
' apply_spatial.
'
