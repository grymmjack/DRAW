        pnSaveCL% = CURRENT_LAYER%
        IF pnTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR pnT% = 1 TO pnTgtCount%
            CURRENT_LAYER% = pnTargets%(pnT%)
            adjR&          = IMAGE_ADJ_pinch&(LAYERS(CURRENT_LAYER%).imgHandle&, amount%)
            IMAGE_ADJ_apply_spatial adjR&, "Pinch / Bulge"
        NEXT pnT%
        IF pnTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = pnSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Twirl — swirl the image around its centre. Each output pixel within `radius` of
' centre is rotated by an angle that falls off with distance (max at centre, 0 at
' the radius), then the source is sampled at the rotated position. apply_spatial.
'
' @param sourceImg LONG    Source image (32-bit)
' @param angleDeg  INTEGER Maximum swirl angle at centre, degrees (10..360)
' @return LONG  New twirled image handle
'
FUNCTION IMAGE_ADJ_twirl& (sourceImg AS LONG, angleDeg AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_twirl& = 0 : EXIT FUNCTION

    DIM twW AS LONG, twH AS LONG
    twW& = _WIDTH(sourceImg&) : twH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _NEWIMAGE(twW&, twH&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM ccx AS SINGLE, ccy AS SINGLE, maxR AS SINGLE
    ccx! = twW& / 2.0 : ccy! = twH& / 2.0
    maxR! = ccx! : IF ccy! < maxR! THEN maxR! = ccy!
    DIM maxAng AS SINGLE : maxAng! = angleDeg% * 3.14159265 / 180.0

    DIM tx AS LONG, ty AS LONG, sxL AS LONG, syL AS LONG
    DIM ddx AS SINGLE, ddy AS SINGLE, rr AS SINGLE, ang AS SINGLE, ca AS SINGLE, sa AS SINGLE
    DIM px AS _UNSIGNED LONG
    FOR ty& = 0 TO twH& - 1
    IF (ty& AND 15) = 0 THEN IMGADJ_progress_tick "Twirl", ty& / twH&
        FOR tx& = 0 TO twW& - 1
            ddx! = tx& - ccx! : ddy! = ty& - ccy!
            rr! = SQR(ddx! * ddx! + ddy! * ddy!)
            IF rr! < maxR! THEN
                ang! = maxAng! * (1.0 - rr! / maxR!)
                ca! = COS(ang!) : sa! = SIN(ang!)
                sxL& = INT(ccx! + ddx! * ca! - ddy! * sa! + 0.5)
                syL& = INT(ccy! + ddx! * sa! + ddy! * ca! + 0.5)
            ELSE
                sxL& = tx& : syL& = ty&
            END IF
            IF sxL& < 0 THEN sxL& = 0 ELSE IF sxL& >= twW& THEN sxL& = twW& - 1
            IF syL& < 0 THEN syL& = 0 ELSE IF syL& >= twH& THEN syL& = twH& - 1
            _MEMGET srcM, srcM.OFFSET + (syL& * twW& + sxL&) * 4, px~&
            _MEMPUT resM, resM.OFFSET + (ty& * twW& + tx&) * 4, px~& AS _UNSIGNED LONG
        NEXT tx&
    NEXT ty&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_twirl& = result&
END FUNCTION


''
' Open a modal Twirl dialog: single ANGLE slider (10..360 deg). apply_spatial.
'
SUB IMAGE_ADJ_twirl_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM angle  AS INTEGER : angle% = 120
    DIM oAngle AS INTEGER

    DIM k AS LONG
    DIM d_angle AS INTEGER : d_angle% = 120
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oAngle% = angle%
        angle% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, angle%, 10, 360)
        angle% = IMGDLG_angle_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, angle%)
        IF angle% <> oAngle% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, angle%, d_angle%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_twirl&(ctx.origThumb, angle%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "TWIRL"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "ANGLE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, angle%, 10, 360, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM twTargets(1 TO MAX_LAYERS) AS INTEGER, twTgtCount AS INTEGER, twT AS INTEGER
        DIM twSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets twTargets%(), twTgtCount%
        twSaveCL% = CURRENT_LAYER%
        IF twTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR twT% = 1 TO twTgtCount%
            CURRENT_LAYER% = twTargets%(twT%)
            adjR&          = IMAGE_ADJ_twirl&(LAYERS(CURRENT_LAYER%).imgHandle&, angle%)
            IMAGE_ADJ_apply_spatial adjR&, "Twirl"
        NEXT twT%
        IF twTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = twSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Wave / Ripple — sinusoidally displace each pixel. The output samples the source
' at (x + amp*sin(y/wl), y + amp*sin(x/wl)) with nearest-neighbour (crisp for
' pixel art) and edge clamping. Moves alpha too -> apply_spatial.
'
' @param sourceImg  LONG    Source image (32-bit)
' @param amplitude  INTEGER Displacement in px (1..20)
' @param wavelength INTEGER Period in px (4..64)
' @return LONG  New rippled image handle
'
FUNCTION IMAGE_ADJ_wave& (sourceImg AS LONG, amplitude AS INTEGER, wavelength AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_wave& = 0 : EXIT FUNCTION
    IF wavelength% < 1 THEN wavelength% = 1

    DIM wvW AS LONG, wvH AS LONG
    wvW& = _WIDTH(sourceImg&) : wvH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _NEWIMAGE(wvW&, wvH&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM wx AS LONG, wy AS LONG, sxL AS LONG, syL AS LONG
    DIM twoPi AS SINGLE : twoPi! = 6.2831853 / wavelength%
    DIM px AS _UNSIGNED LONG
    FOR wy& = 0 TO wvH& - 1
    IF (wy& AND 15) = 0 THEN IMGADJ_progress_tick "Wave", wy& / wvH&
        FOR wx& = 0 TO wvW& - 1
            sxL& = wx& + INT(amplitude% * SIN(wy& * twoPi!) + 0.5)
            syL& = wy& + INT(amplitude% * SIN(wx& * twoPi!) + 0.5)
            IF sxL& < 0 THEN sxL& = 0 ELSE IF sxL& >= wvW& THEN sxL& = wvW& - 1
            IF syL& < 0 THEN syL& = 0 ELSE IF syL& >= wvH& THEN syL& = wvH& - 1
            _MEMGET srcM, srcM.OFFSET + (syL& * wvW& + sxL&) * 4, px~&
            _MEMPUT resM, resM.OFFSET + (wy& * wvW& + wx&) * 4, px~& AS _UNSIGNED LONG
        NEXT wx&
    NEXT wy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_wave& = result&
END FUNCTION


''
' Open a modal Wave / Ripple dialog: AMPLITUDE (1..20) + WAVELENGTH (4..64).
' Displacement moves alpha -> apply_spatial.
'
SUB IMAGE_ADJ_wave_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM amp AS INTEGER : amp% = 6
    DIM wl  AS INTEGER : wl%  = 24
    DIM oAmp AS INTEGER, oWl AS INTEGER

    DIM k AS LONG
    DIM d_amp AS INTEGER : d_amp% = 6
    DIM d_wl AS INTEGER : d_wl% = 24
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oAmp% = amp% : oWl% = wl%
        amp% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amp%, 1, 100)
        amp% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, amp%, 1, 100)
        wl%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, wl%, 4, 300)
        wl%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, wl%, 4, 300)
        IF amp% <> oAmp% OR wl% <> oWl% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, amp%, wl%, d_amp%, d_wl%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_wave&(ctx.origThumb, amp%, wl%)
            IMAGE_ADJ_mask_preview ctx
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "WAVE / RIPPLE"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "AMPLITUDE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, amp%, 1, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "WAVELENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, wl%, 4, 300, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM wvTargets(1 TO MAX_LAYERS) AS INTEGER, wvTgtCount AS INTEGER, wvT AS INTEGER
        DIM wvSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets wvTargets%(), wvTgtCount%
        wvSaveCL% = CURRENT_LAYER%
        IF wvTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR wvT% = 1 TO wvTgtCount%
            CURRENT_LAYER% = wvTargets%(wvT%)
            adjR&          = IMAGE_ADJ_wave&(LAYERS(CURRENT_LAYER%).imgHandle&, amp%, wl%)
            IMAGE_ADJ_apply_spatial adjR&, "Wave"
        NEXT wvT%
        IF wvTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = wvSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Chrome / Metallic — turn a flat shape into shiny metal. Builds a
' distance-to-edge field (0 at edge → 1 toward `depth` inward), runs it through a
' metallic band function (|sin|) for the reflective light/dark rings, and maps the
' result along a BG(shadow)->FG(highlight) ramp. RGB-only -> apply_to_layer.
'
' @param sourceImg LONG           Source image (32-bit, with alpha)
' @param depth     INTEGER        Band depth in px (2..16)
' @param loColor   _UNSIGNED LONG Shadow end of the metal ramp
' @param hiColor   _UNSIGNED LONG Highlight end of the metal ramp
' @return LONG  New chrome image handle
'
FUNCTION IMAGE_ADJ_chrome& (sourceImg AS LONG, depth AS INTEGER, loColor AS _UNSIGNED LONG, hiColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_chrome& = 0 : EXIT FUNCTION

    DIM chW AS LONG, chH AS LONG
    chW& = _WIDTH(sourceImg&) : chH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM cLoR AS INTEGER, cLoG AS INTEGER, cLoB AS INTEGER
    DIM cHiR AS INTEGER, cHiG AS INTEGER, cHiB AS INTEGER
    cLoR% = _RED32(loColor~&) : cLoG% = _GREEN32(loColor~&) : cLoB% = _BLUE32(loColor~&)
    cHiR% = _RED32(hiColor~&) : cHiG% = _GREEN32(hiColor~&) : cHiB% = _BLUE32(hiColor~&)

    DIM cx AS LONG, cy AS LONG, dx AS INTEGER, dy AS INTEGER
    DIM aHere AS _UNSIGNED _BYTE, aN AS _UNSIGNED _BYTE
    DIM nx AS LONG, ny AS LONG, dist AS INTEGER, curD AS INTEGER
    DIM tt AS SINGLE, mBand AS SINGLE
    DIM mR AS INTEGER, mG AS INTEGER, mB AS INTEGER

    FOR cy& = 0 TO chH& - 1
    IF (cy& AND 15) = 0 THEN IMGADJ_progress_tick "Chrome", cy& / chH&
        FOR cx& = 0 TO chW& - 1
            _MEMGET srcM, srcM.OFFSET + (cy& * chW& + cx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE

            dist% = depth% + 1
            FOR dy% = -depth% TO depth%
                ny& = cy& + dy%
                FOR dx% = -depth% TO depth%
                    curD% = ABS(dx%) : IF ABS(dy%) > curD% THEN curD% = ABS(dy%)
                    IF curD% < dist% THEN
                        nx& = cx& + dx%
                        IF nx& < 0 OR ny& < 0 OR nx& >= chW& OR ny& >= chH& THEN
                            dist% = curD%
                        ELSE
                            _MEMGET srcM, srcM.OFFSET + (ny& * chW& + nx&) * 4 + 3, aN~%%
                            IF aN~%% = 0 THEN dist% = curD%
                        END IF
                    END IF
                NEXT dx%
            NEXT dy%
            IF dist% > depth% THEN dist% = depth%

            tt! = dist% / (depth% + 0.0)
            mBand! = ABS(SIN(tt! * 3.14159265 * 1.5))
            mR% = cLoR% + (cHiR% - cLoR%) * mBand!
            mG% = cLoG% + (cHiG% - cLoG%) * mBand!
            mB% = cLoB% + (cHiB% - cLoB%) * mBand!
            _MEMPUT resM, resM.OFFSET + (cy& * chW& + cx&) * 4, _RGB32(mR%, mG%, mB%) AS _UNSIGNED LONG
        NEXT cx&
    NEXT cy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_chrome& = result&
END FUNCTION


''
' Open a modal Chrome dialog: DEPTH slider (2..16). Metal ramp runs BG (shadow)
' -> FG (highlight); e.g. FG=white + BG=dark gives silver. apply_to_layer.
'
SUB IMAGE_ADJ_chrome_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 110
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM depth  AS INTEGER : depth% = 8
    DIM oDepth AS INTEGER

    DIM k AS LONG
    DIM d_depth AS INTEGER : d_depth% = 8
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oDepth% = depth%
        depth% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, depth%, 2, 64)
        depth% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, depth%, 2, 64)
        IF depth% <> oDepth% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset1 ctx, depth%, d_depth%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_chrome&(IMGADJ_fx_src&(ctx), depth%, PAINT_BG_COLOR~&, PAINT_COLOR~&)
            IMAGE_ADJ_fx_preview_finish ctx, 0
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "CHROME / METALLIC"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "DEPTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, depth%, 2, 64, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM chTargets(1 TO MAX_LAYERS) AS INTEGER, chTgtCount AS INTEGER, chT AS INTEGER
        DIM chSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets chTargets%(), chTgtCount%
        chSaveCL% = CURRENT_LAYER%
        IF chTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR chT% = 1 TO chTgtCount%
            CURRENT_LAYER% = chTargets%(chT%)
            DIM chEdge AS LONG
            chEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF chEdge& < -1 THEN
                adjR& = IMAGE_ADJ_chrome&(chEdge&, depth%, PAINT_BG_COLOR~&, PAINT_COLOR~&)
                IMAGE_ADJ_apply_spatial_edge adjR&, chEdge&, "Chrome"
                SAFE_FREEIMAGE chEdge&
            ELSE
                adjR& = IMAGE_ADJ_chrome&(LAYERS(CURRENT_LAYER%).imgHandle&, depth%, PAINT_BG_COLOR~&, PAINT_COLOR~&)
                IMAGE_ADJ_apply_to_layer adjR&, "Chrome"
            END IF
        NEXT chT%
        IF chTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = chSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Chebyshev (chessboard) distance transform, two 8-neighbour passes => O(pixels),
' independent of radius. Fills distA() with each pixel's distance to the nearest
' SEED. seedMode 0: seeds = transparent pixels AND the image outside (distance to
' the shape's inner edge — Inner Glow / Bevel). seedMode 1: seeds = opaque pixels
' (distance from transparent pixels to the shape — Outer Glow / Corona). distA()
' must be pre-DIMmed 0..w*h-1.
'
SUB IMGADJ_dist_transform (srcImg AS LONG, seedMode AS INTEGER, distA() AS LONG)
    IF NOT (srcImg& < -1) THEN EXIT SUB
    DIM dtW AS LONG, dtH AS LONG : dtW& = _WIDTH(srcImg&) : dtH& = _HEIGHT(srcImg&)
    DIM dtM AS _MEM : dtM = _MEMIMAGE(srcImg&)
    DIM dx AS LONG, dy AS LONG, da AS _UNSIGNED _BYTE, seed AS INTEGER
    DIM BIG AS LONG : BIG& = dtW& + dtH& + 8
    DIM d AS LONG
    FOR dy& = 0 TO dtH& - 1
        FOR dx& = 0 TO dtW& - 1
            _MEMGET dtM, dtM.OFFSET + (dy& * dtW& + dx&) * 4 + 3, da~%%
            IF seedMode% = 0 THEN seed% = (da~%% = 0) ELSE seed% = (da~%% <> 0)
            IF seed% THEN distA&(dy& * dtW& + dx&) = 0 ELSE distA&(dy& * dtW& + dx&) = BIG&
        NEXT dx&
    NEXT dy&
    _MEMFREE dtM
    ' forward pass (top-left -> bottom-right)
    FOR dy& = 0 TO dtH& - 1
        FOR dx& = 0 TO dtW& - 1
            d& = distA&(dy& * dtW& + dx&)
            IF d& > 0 THEN
                IF seedMode% = 0 AND (dx& = 0 OR dy& = 0) THEN IF 1 < d& THEN d& = 1
                IF dx& > 0 THEN IF distA&(dy& * dtW& + dx& - 1) + 1 < d& THEN d& = distA&(dy& * dtW& + dx& - 1) + 1
                IF dy& > 0 THEN IF distA&((dy& - 1) * dtW& + dx&) + 1 < d& THEN d& = distA&((dy& - 1) * dtW& + dx&) + 1
                IF dx& > 0 AND dy& > 0 THEN IF distA&((dy& - 1) * dtW& + dx& - 1) + 1 < d& THEN d& = distA&((dy& - 1) * dtW& + dx& - 1) + 1
                IF dx& < dtW& - 1 AND dy& > 0 THEN IF distA&((dy& - 1) * dtW& + dx& + 1) + 1 < d& THEN d& = distA&((dy& - 1) * dtW& + dx& + 1) + 1
                distA&(dy& * dtW& + dx&) = d&
            END IF
        NEXT dx&
    NEXT dy&
    ' backward pass (bottom-right -> top-left)
    FOR dy& = dtH& - 1 TO 0 STEP -1
        FOR dx& = dtW& - 1 TO 0 STEP -1
            d& = distA&(dy& * dtW& + dx&)
            IF d& > 0 THEN
                IF seedMode% = 0 AND (dx& = dtW& - 1 OR dy& = dtH& - 1) THEN IF 1 < d& THEN d& = 1
                IF dx& < dtW& - 1 THEN IF distA&(dy& * dtW& + dx& + 1) + 1 < d& THEN d& = distA&(dy& * dtW& + dx& + 1) + 1
                IF dy& < dtH& - 1 THEN IF distA&((dy& + 1) * dtW& + dx&) + 1 < d& THEN d& = distA&((dy& + 1) * dtW& + dx&) + 1
                IF dx& < dtW& - 1 AND dy& < dtH& - 1 THEN IF distA&((dy& + 1) * dtW& + dx& + 1) + 1 < d& THEN d& = distA&((dy& + 1) * dtW& + dx& + 1) + 1
                IF dx& > 0 AND dy& < dtH& - 1 THEN IF distA&((dy& + 1) * dtW& + dx& - 1) + 1 < d& THEN d& = distA&((dy& + 1) * dtW& + dx& - 1) + 1
                distA&(dy& * dtW& + dx&) = d&
            END IF
        NEXT dx&
    NEXT dy&
END SUB

''
' Inner Glow — a coloured glow that fades inward from the shape's alpha edges.
' For each opaque pixel, distance-to-edge d (clamped to `radius`) gives a factor
' (1 at the edge, 0 at radius inward); glowColor is blended over the original by
' factor * intensity. RGB-only (glow lives inside opaque pixels) -> apply_to_layer.
'
' @param sourceImg LONG           Source image (32-bit, with alpha)
' @param radius    INTEGER        Inward reach in px (1..16)
' @param intensity INTEGER        Blend strength (1..5)
' @param glowColor _UNSIGNED LONG Glow colour
' @return LONG  New inner-glow image handle
'
FUNCTION IMAGE_ADJ_innerglow& (sourceImg AS LONG, radius AS INTEGER, intensity AS INTEGER, glowColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_innerglow& = 0 : EXIT FUNCTION

    DIM igW AS LONG, igH AS LONG
    igW& = _WIDTH(sourceImg&) : igH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    DIM gR AS INTEGER, gG AS INTEGER, gB AS INTEGER
    gR% = _RED32(glowColor~&) : gG% = _GREEN32(glowColor~&) : gB% = _BLUE32(glowColor~&)

    DIM ix AS LONG, iy AS LONG
    DIM aHere AS _UNSIGNED _BYTE, dist AS INTEGER
    DIM fac AS SINGLE, px AS _UNSIGNED LONG
    DIM nR AS INTEGER, nG AS INTEGER, nB AS INTEGER   ' output RGB (gg would collide with gG, case-insensitive)

    ' distance-to-inner-edge for every pixel in O(pixels) (was O(radius^2) per pixel)
    REDIM igDist(0 TO igW& * igH& - 1) AS LONG
    IMGADJ_dist_transform sourceImg&, 0, igDist()

    FOR iy& = 0 TO igH& - 1
    IF (iy& AND 15) = 0 THEN IMGADJ_progress_tick "Innerglow", iy& / igH&
        FOR ix& = 0 TO igW& - 1
            _MEMGET srcM, srcM.OFFSET + (iy& * igW& + ix&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            dist% = igDist&(iy& * igW& + ix&)
            IF dist% <= radius% THEN
                fac! = (radius% - dist% + 1) / (radius% + 0.0) * (intensity% / 3.0)
                IF fac! > 1.0 THEN fac! = 1.0
                _MEMGET srcM, srcM.OFFSET + (iy& * igW& + ix&) * 4, px~&
                nR% = _RED32(px~&) + (gR% - _RED32(px~&)) * fac!
                nG% = _GREEN32(px~&) + (gG% - _GREEN32(px~&)) * fac!
                nB% = _BLUE32(px~&) + (gB% - _BLUE32(px~&)) * fac!
                _MEMPUT resM, resM.OFFSET + (iy& * igW& + ix&) * 4, _RGB32(nR%, nG%, nB%) AS _UNSIGNED LONG
            END IF
        NEXT ix&
    NEXT iy&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_innerglow& = result&
END FUNCTION


''
' Open a modal Inner Glow dialog: RADIUS (1..16) + INTENSITY (1..5). Glow colour
' is the current FG colour. RGB-only -> apply_to_layer.
'
SUB IMAGE_ADJ_innerglow_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM radius AS INTEGER : radius% = 5
    DIM inten  AS INTEGER : inten%  = 3
    DIM oRadius AS INTEGER, oInten AS INTEGER

    DIM k AS LONG
    DIM d_radius AS INTEGER : d_radius% = 5
    DIM d_inten AS INTEGER : d_inten% = 3
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oRadius% = radius% : oInten% = inten%
        radius% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, radius%, 1, 48)
        radius% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, radius%, 1, 48)
        inten%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inten%, 1, 5)
        inten%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inten%, 1, 5)
        IF radius% <> oRadius% OR inten% <> oInten% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, radius%, inten%, d_radius%, d_inten%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_innerglow&(IMGADJ_fx_src&(ctx), radius%, inten%, PAINT_COLOR~&)
            IMAGE_ADJ_fx_preview_finish ctx, 0
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "INNER GLOW"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "RADIUS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, radius%, 1, 48, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "INTENSITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, inten%, 1, 5, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM igTargets(1 TO MAX_LAYERS) AS INTEGER, igTgtCount AS INTEGER, igT AS INTEGER
        DIM igSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets igTargets%(), igTgtCount%
        igSaveCL% = CURRENT_LAYER%
        IF igTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR igT% = 1 TO igTgtCount%
            CURRENT_LAYER% = igTargets%(igT%)
            DIM igEdge AS LONG
            igEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF igEdge& < -1 THEN
                adjR& = IMAGE_ADJ_innerglow&(igEdge&, radius%, inten%, PAINT_COLOR~&)
                IMAGE_ADJ_apply_spatial_edge adjR&, igEdge&, "Inner Glow"
                SAFE_FREEIMAGE igEdge&
            ELSE
                adjR& = IMAGE_ADJ_innerglow&(LAYERS(CURRENT_LAYER%).imgHandle&, radius%, inten%, PAINT_COLOR~&)
                IMAGE_ADJ_apply_to_layer adjR&, "Inner Glow"
            END IF
        NEXT igT%
        IF igTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = igSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Outer Glow — a soft coloured halo radiating outside the shape's alpha edges.
' Builds a silhouette in glowColor, blurs it by `radius` so it spreads outward,
' boosts the spread alpha by `intensity`, and composites the original on top.
' Alpha-changing -> apply_spatial (needs transparency around the shape).
'
' @param sourceImg LONG           Source image (32-bit, with alpha)
' @param radius    INTEGER        Glow spread in px (1..16)
' @param intensity INTEGER        Glow alpha boost (1..5)
' @param glowColor _UNSIGNED LONG Glow colour
' @return LONG  New composited image handle
'
FUNCTION IMAGE_ADJ_outerglow& (sourceImg AS LONG, radius AS INTEGER, intensity AS INTEGER, glowColor AS _UNSIGNED LONG)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_outerglow& = 0 : EXIT FUNCTION

    DIM ogW AS LONG, ogH AS LONG
    ogW& = _WIDTH(sourceImg&) : ogH& = _HEIGHT(sourceImg&)

    ' silhouette in glowColor
    DIM sil AS LONG
    sil& = _NEWIMAGE(ogW&, ogH&, 32)
    DIM oldDest AS LONG : oldDest& = _DEST
    _DEST sil& : _DONTBLEND sil& : CLS , _RGBA32(0, 0, 0, 0) : _DEST oldDest&

    DIM srcM AS _MEM, silM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    silM = _MEMIMAGE(sil&)
    DIM gR AS INTEGER, gG AS INTEGER, gB AS INTEGER
    gR% = _RED32(glowColor~&) : gG% = _GREEN32(glowColor~&) : gB% = _BLUE32(glowColor~&)
    DIM i AS LONG, aa AS _UNSIGNED _BYTE
    FOR i& = 0 TO srcM.SIZE - 4 STEP 4
        _MEMGET srcM, srcM.OFFSET + i& + 3, aa~%%
        IF aa~%% <> 0 THEN _MEMPUT silM, silM.OFFSET + i&, _RGBA32(gR%, gG%, gB%, 255) AS _UNSIGNED LONG
    NEXT i&
    _MEMFREE srcM
    _MEMFREE silM

    ' blur the silhouette to spread the glow
    DIM glow AS LONG
    glow& = IMAGE_ADJ_blur_premul_rgba&(sil&, radius%)
    SAFE_FREEIMAGE sil&
    IF NOT (glow& < -1) THEN glow& = _NEWIMAGE(ogW&, ogH&, 32)

    ' boost the glow alpha by intensity
    IF intensity% > 1 THEN
        DIM gM AS _MEM : gM = _MEMIMAGE(glow&)
        DIM ba AS INTEGER
        FOR i& = 0 TO gM.SIZE - 4 STEP 4
            _MEMGET gM, gM.OFFSET + i& + 3, aa~%%
            IF aa~%% <> 0 THEN
                ba% = aa~%% * intensity% : IF ba% > 255 THEN ba% = 255
                _MEMPUT gM, gM.OFFSET + i& + 3, ba% AS _UNSIGNED _BYTE
            END IF
        NEXT i&
        _MEMFREE gM
    END IF

    ' composite original over the glow
    DIM result AS LONG
    result& = _COPYIMAGE(glow&, 32)
    oldDest& = _DEST
    _DEST result& : _BLEND result& : _PUTIMAGE , sourceImg&, result& : _DEST oldDest&
    SAFE_FREEIMAGE glow&

    IMAGE_ADJ_outerglow& = result&
END FUNCTION


''
' Open a modal Outer Glow dialog: RADIUS (1..16) + INTENSITY (1..5). Glow colour
' is the current FG colour. Alpha-changing -> apply_spatial.
'
SUB IMAGE_ADJ_outerglow_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 140
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM radius AS INTEGER : radius% = 6
    DIM inten  AS INTEGER : inten%  = 2
    DIM oRadius AS INTEGER, oInten AS INTEGER

    DIM k AS LONG
    DIM d_radius AS INTEGER : d_radius% = 6
    DIM d_inten AS INTEGER : d_inten% = 2
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oRadius% = radius% : oInten% = inten%
        radius% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, radius%, 1, 48)
        radius% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, radius%, 1, 48)
        inten%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inten%, 1, 5)
        inten%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, inten%, 1, 5)
        IF radius% <> oRadius% OR inten% <> oInten% THEN ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset2 ctx, radius%, inten%, d_radius%, d_inten%

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_outerglow&(IMGADJ_fx_src&(ctx), radius%, inten%, PAINT_COLOR~&)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "OUTER GLOW"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "RADIUS:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, radius%, 1, 48, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "INTENSITY:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, inten%, 1, 5, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM ogTargets(1 TO MAX_LAYERS) AS INTEGER, ogTgtCount AS INTEGER, ogT AS INTEGER
        DIM ogSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets ogTargets%(), ogTgtCount%
        ogSaveCL% = CURRENT_LAYER%
        IF ogTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR ogT% = 1 TO ogTgtCount%
            CURRENT_LAYER% = ogTargets%(ogT%)
            DIM ogEdge AS LONG
            ogEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF ogEdge& < -1 THEN
                adjR& = IMAGE_ADJ_outerglow&(ogEdge&, radius%, inten%, PAINT_COLOR~&)
                IMAGE_ADJ_apply_spatial_edge adjR&, ogEdge&, "Outer Glow"
                SAFE_FREEIMAGE ogEdge&
            ELSE
                adjR& = IMAGE_ADJ_outerglow&(LAYERS(CURRENT_LAYER%).imgHandle&, radius%, inten%, PAINT_COLOR~&)
                IMAGE_ADJ_apply_spatial adjR&, "Outer Glow"
            END IF
        NEXT ogT%
        IF ogTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = ogSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Bevel (inner) — raise the shape into a lit 3D button. Builds a distance-to-edge
' heightfield inside the alpha (clamped to `height`), then shades each opaque
' pixel by that field's up-left/down-right diagonal gradient: slopes facing the
' top-left light get a highlight, slopes facing away get shadow. `strength` scales
' the shading. RGB-only; alpha preserved (apply_to_layer).
'
' @param sourceImg LONG    Source image (32-bit, with alpha)
' @param height    INTEGER Bevel width from the edge inward (1..8)
' @param strength  INTEGER Shading gain (1..10)
' @return LONG  New beveled image handle
'
FUNCTION IMAGE_ADJ_bevel& (sourceImg AS LONG, height AS INTEGER, strength AS INTEGER, angleDeg AS INTEGER, direction AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_bevel& = 0 : EXIT FUNCTION

    DIM bvW AS LONG, bvH AS LONG
    bvW& = _WIDTH(sourceImg&) : bvH& = _HEIGHT(sourceImg&)
    DIM result AS LONG
    result& = _COPYIMAGE(sourceImg&, 32)

    ' Light direction -> one of 8 neighbour offsets (odx,ody) toward the light.
    ' angle 0 = light from the right, 90 = top, 180 = left, 270 = bottom.
    ' DIRECTION down (1) flips the relief (raised <-> carved).
    DIM bvRad AS SINGLE : bvRad! = angleDeg% * 3.14159265 / 180.0
    DIM lcx AS SINGLE, lcy AS SINGLE : lcx! = COS(bvRad!) : lcy! = -SIN(bvRad!)
    DIM odx AS INTEGER, ody AS INTEGER
    odx% = 0 : IF lcx! > 0.35 THEN odx% = 1 ELSE IF lcx! < -0.35 THEN odx% = -1
    ody% = 0 : IF lcy! > 0.35 THEN ody% = 1 ELSE IF lcy! < -0.35 THEN ody% = -1
    IF odx% = 0 AND ody% = 0 THEN ody% = -1
    DIM dirSign AS INTEGER : dirSign% = 1 : IF direction% <> 0 THEN dirSign% = -1

    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    resM = _MEMIMAGE(result&)

    ' --- distance-to-edge heightfield (0 outside; 1..height inside) ---
    ' O(pixels) via the shared Chebyshev distance transform. The old inner scan was
    ' O(height^2) PER pixel — the reason a large Height froze. seedMode 0 seeds on
    ' transparent pixels AND the image border, matching the old scan's out-of-bounds
    ' = edge rule exactly; we then clamp the raw distance to Height as before.
    REDIM hgt(0 TO bvW& * bvH& - 1) AS INTEGER
    REDIM bvDist(0 TO bvW& * bvH& - 1) AS LONG
    IMGADJ_dist_transform sourceImg&, 0, bvDist()
    DIM bx AS LONG, by AS LONG
    DIM aHere AS _UNSIGNED _BYTE, dist AS INTEGER
    FOR by& = 0 TO bvH& - 1
    IF (by& AND 31) = 0 THEN IMGADJ_progress_tick "Bevel", by& / bvH&
        FOR bx& = 0 TO bvW& - 1
            _MEMGET srcM, srcM.OFFSET + (by& * bvW& + bx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN
                hgt(by& * bvW& + bx&) = 0
            ELSE
                dist% = bvDist&(by& * bvW& + bx&)
                IF dist% > height% THEN dist% = height%
                hgt(by& * bvW& + bx&) = dist%
            END IF
        NEXT bx&
    NEXT by&

    ' --- shade by the heightfield gradient toward the light direction ---
    DIM px AS _UNSIGNED LONG, pxm AS LONG, pym AS LONG, dH AS LONG, delta AS LONG
    DIM rr AS INTEGER, gg AS INTEGER, bb AS INTEGER
    FOR by& = 0 TO bvH& - 1
        pym& = by& + ody% : IF pym& < 0 THEN pym& = 0 ELSE IF pym& >= bvH& THEN pym& = bvH& - 1
        FOR bx& = 0 TO bvW& - 1
            _MEMGET srcM, srcM.OFFSET + (by& * bvW& + bx&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            pxm& = bx& + odx% : IF pxm& < 0 THEN pxm& = 0 ELSE IF pxm& >= bvW& THEN pxm& = bvW& - 1
            dH& = (hgt(by& * bvW& + bx&) - hgt(pym& * bvW& + pxm&)) * dirSign%
            delta& = dH& * strength% * 12
            _MEMGET srcM, srcM.OFFSET + (by& * bvW& + bx&) * 4, px~&
            rr% = _RED32(px~&) + delta& : IF rr% < 0 THEN rr% = 0 ELSE IF rr% > 255 THEN rr% = 255
            gg% = _GREEN32(px~&) + delta& : IF gg% < 0 THEN gg% = 0 ELSE IF gg% > 255 THEN gg% = 255
            bb% = _BLUE32(px~&) + delta& : IF bb% < 0 THEN bb% = 0 ELSE IF bb% > 255 THEN bb% = 255
            _MEMPUT resM, resM.OFFSET + (by& * bvW& + bx&) * 4, _RGB32(rr%, gg%, bb%) AS _UNSIGNED LONG
        NEXT bx&
    NEXT by&

    _MEMFREE srcM
    _MEMFREE resM
    IMAGE_ADJ_bevel& = result&
END FUNCTION


''
' Open a modal Bevel dialog: HEIGHT (1..8) + STRENGTH (1..10). apply_to_layer.
'
SUB IMAGE_ADJ_bevel_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 200
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM height    AS INTEGER : height%    = 4
    DIM strength  AS INTEGER : strength%  = 4
    DIM angle     AS INTEGER : angle%     = 135
    DIM direction AS INTEGER : direction% = 0
    DIM dHeight   AS INTEGER : dHeight%   = 4    ' captured defaults for RESET
    DIM dStrength AS INTEGER : dStrength% = 4
    DIM dAngle    AS INTEGER : dAngle%    = 135
    DIM dDir      AS INTEGER : dDir%      = 0
    DIM oHeight AS INTEGER, oStrength AS INTEGER, oAngle AS INTEGER, oDir AS INTEGER
    DIM dvX AS INTEGER, dvY AS INTEGER, dvW AS INTEGER, dvH AS INTEGER
    dvX% = IMGDLG_SX : dvY% = IMGDLG_track_y%(ctx, 2) + 26 : dvW% = 150 : dvH% = 16

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oHeight% = height% : oStrength% = strength% : oAngle% = angle% : oDir% = direction%
        height%   = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, height%, 1, 48)
        height%   = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, height%, 1, 48)
        strength% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, strength%, 1, 64)
        strength% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, strength%, 1, 64)
        angle%    = IMGDLG_angle_handle%(ctx, 2, angle%)
        IF DIALOG_hit%(ctx, dvX%, dvY%, dvW%, dvH%) THEN direction% = (direction% = 0) : ctx.previewDirty% = TRUE
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset4 ctx, height%, strength%, angle%, direction%, dHeight%, dStrength%, dAngle%, dDir%
        IF height% <> oHeight% OR strength% <> oStrength% OR angle% <> oAngle% OR direction% <> oDir% THEN ctx.previewDirty% = TRUE

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_bevel&(IMGADJ_fx_src&(ctx), height%, strength%, angle%, direction%)
            IMAGE_ADJ_fx_preview_finish ctx, 0
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "BEVEL"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "HEIGHT:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, height%, 1, 48, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "STRENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, strength%, 1, 64, "", ""
        IMGDLG_angle_draw ctx, 2, angle%, "LIGHT ANGLE:"
        DIALOG_draw_toggle ctx, dvX%, dvY%, dvW%, dvH%, "DIRECTION: DOWN", direction%
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM bvTargets(1 TO MAX_LAYERS) AS INTEGER, bvTgtCount AS INTEGER, bvT AS INTEGER
        DIM bvSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets bvTargets%(), bvTgtCount%
        bvSaveCL% = CURRENT_LAYER%
        IF bvTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR bvT% = 1 TO bvTgtCount%
            CURRENT_LAYER% = bvTargets%(bvT%)
            DIM bvEdge AS LONG
            bvEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF bvEdge& < -1 THEN
                adjR& = IMAGE_ADJ_bevel&(bvEdge&, height%, strength%, angle%, direction%)
                IMAGE_ADJ_apply_spatial_edge adjR&, bvEdge&, "Bevel"
                SAFE_FREEIMAGE bvEdge&
            ELSE
                adjR& = IMAGE_ADJ_bevel&(LAYERS(CURRENT_LAYER%).imgHandle&, height%, strength%, angle%, direction%)
                IMAGE_ADJ_apply_to_layer adjR&, "Bevel"
            END IF
        NEXT bvT%
        IF bvTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = bvSaveCL%
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' Long Shadow (perspective / 3D) — cast a solid diagonal shadow trail down-right
' from the shape (light from the upper-left). A pixel becomes shadow if any of
' the `length` cells up-left of it on the diagonal is opaque; the original is
' composited on top. The trendy flat "long shadow" look. apply_spatial.
'
' @param sourceImg LONG           Source image (32-bit, with alpha)
' @param length    INTEGER        Shadow length in px along the diagonal (1..40)
' @param shColor   _UNSIGNED LONG Shadow colour
' @return LONG  New composited image handle
'
FUNCTION IMAGE_ADJ_longshadow& (sourceImg AS LONG, length AS INTEGER, angleDeg AS INTEGER, shColor AS _UNSIGNED LONG, softFar AS INTEGER, fadeFar AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_longshadow& = 0 : EXIT FUNCTION

    DIM lsW AS LONG, lsH AS LONG
    lsW& = _WIDTH(sourceImg&) : lsH& = _HEIGHT(sourceImg&)

    ' sharp = the crisp shadow, alpha faded with distance; distMap.red = distance
    ' normalised 0(near)..1(far) so a blurred copy can be mixed in more heavily far
    ' from the subject — real cast shadows soften and fade as they stretch away.
    DIM shadow AS LONG, distMap AS LONG
    shadow&  = _NEWIMAGE(lsW&, lsH&, 32)
    distMap& = _NEWIMAGE(lsW&, lsH&, 32)
    DIM oldDest AS LONG : oldDest& = _DEST
    _DEST shadow&  : _DONTBLEND shadow&  : CLS , _RGBA32(0, 0, 0, 0)
    _DEST distMap& : _DONTBLEND distMap& : CLS , _RGBA32(0, 0, 0, 0) : _DEST oldDest&

    DIM srcM AS _MEM, shM AS _MEM, dmM AS _MEM
    srcM = _MEMIMAGE(sourceImg&)
    shM  = _MEMIMAGE(shadow&)
    dmM  = _MEMIMAGE(distMap&)
    DIM shR AS INTEGER, shG AS INTEGER, shB AS INTEGER
    shR% = _RED32(shColor~&) : shG% = _GREEN32(shColor~&) : shB% = _BLUE32(shColor~&)
    DIM fadeF AS SINGLE : fadeF! = fadeFar% / 100.0
    DIM denom AS SINGLE : denom! = length% - 1 : IF denom! < 1.0 THEN denom! = 1.0

    ' Cast direction (0=right, 90=top, 315=down-right default). For each empty
    ' pixel scan BACK along -cast to see if the shape is within `length`.
    DIM lsRad AS SINGLE : lsRad! = angleDeg% * 3.14159265 / 180.0
    DIM cvx AS SINGLE, cvy AS SINGLE : cvx! = COS(lsRad!) : cvy! = -SIN(lsRad!)

    DIM lx AS LONG, ly AS LONG, k AS INTEGER, ux AS LONG, uy AS LONG
    DIM selfA AS _UNSIGNED _BYTE, upA AS _UNSIGNED _BYTE, hitS AS INTEGER, hitK AS INTEGER
    DIM dn AS SINGLE, av AS INTEGER
    FOR ly& = 0 TO lsH& - 1
    IF (ly& AND 15) = 0 THEN IMGADJ_progress_tick "Longshadow", ly& / lsH&
        FOR lx& = 0 TO lsW& - 1
            _MEMGET srcM, srcM.OFFSET + (ly& * lsW& + lx&) * 4 + 3, selfA~%%
            IF selfA~%% <> 0 THEN _CONTINUE   ' opaque pixels keep original (composited later)
            hitS% = 0 : hitK% = 0
            FOR k% = 1 TO length%
                ux& = lx& - CINT(k% * cvx!) : uy& = ly& - CINT(k% * cvy!)
                IF ux& < 0 OR uy& < 0 OR ux& >= lsW& OR uy& >= lsH& THEN EXIT FOR
                _MEMGET srcM, srcM.OFFSET + (uy& * lsW& + ux&) * 4 + 3, upA~%%
                IF upA~%% <> 0 THEN hitS% = 1 : hitK% = k% : EXIT FOR
            NEXT k%
            IF hitS% THEN
                dn! = (hitK% - 1) / denom!                     ' 0 near .. 1 far
                av% = 255 * (1.0 - dn! * fadeF!) : IF av% < 0 THEN av% = 0
                _MEMPUT shM, shM.OFFSET + (ly& * lsW& + lx&) * 4, _RGBA32(shR%, shG%, shB%, av%) AS _UNSIGNED LONG
                _MEMPUT dmM, dmM.OFFSET + (ly& * lsW& + lx&) * 4, _RGBA32(INT(dn! * 255.0), 0, 0, 255) AS _UNSIGNED LONG
            END IF
        NEXT lx&
    NEXT ly&
    _MEMFREE srcM : _MEMFREE shM : _MEMFREE dmM

    ' Distance-weighted blur: blur the sharp shadow AND the distance map, then mix
    ' sharp->blurred by the (blurred) distance so near stays crisp, far goes soft.
    DIM shaded AS LONG
    IF softFar% > 0 THEN
        DIM blurS AS LONG, blurD AS LONG
        blurS& = IMAGE_ADJ_blur_premul_rgba&(shadow&, softFar%)
        blurD& = IMAGE_ADJ_blur_premul_rgba&(distMap&, softFar%)
        shaded& = _COPYIMAGE(shadow&, 32)
        IF blurS& < -1 AND blurD& < -1 AND shaded& < -1 THEN
            DIM spM AS _MEM, bpM AS _MEM, wpM AS _MEM, opM AS _MEM
            spM = _MEMIMAGE(shadow&) : bpM = _MEMIMAGE(blurS&)
            wpM = _MEMIMAGE(blurD&)  : opM = _MEMIMAGE(shaded&)
            DIM po AS _OFFSET, sp AS _UNSIGNED LONG, bp AS _UNSIGNED LONG, wr AS _UNSIGNED _BYTE
            DIM ww AS SINGLE, orC AS INTEGER, ogC AS INTEGER, obC AS INTEGER, oaC AS INTEGER
            FOR po = 0 TO opM.SIZE - 4 STEP 4
                _MEMGET spM, spM.OFFSET + po, sp~&
                _MEMGET bpM, bpM.OFFSET + po, bp~&
                _MEMGET wpM, wpM.OFFSET + po + 2, wr~%%          ' red channel = far-ness
                ww! = wr~%% / 255.0
                orC% = _RED32(sp~&)   * (1.0 - ww!) + _RED32(bp~&)   * ww!
                ogC% = _GREEN32(sp~&) * (1.0 - ww!) + _GREEN32(bp~&) * ww!
                obC% = _BLUE32(sp~&)  * (1.0 - ww!) + _BLUE32(bp~&)  * ww!
                oaC% = _ALPHA32(sp~&) * (1.0 - ww!) + _ALPHA32(bp~&) * ww!
                _MEMPUT opM, opM.OFFSET + po, _RGBA32(orC%, ogC%, obC%, oaC%) AS _UNSIGNED LONG
            NEXT po
            _MEMFREE spM : _MEMFREE bpM : _MEMFREE wpM : _MEMFREE opM
        END IF
        IF blurS& < -1 THEN _FREEIMAGE blurS&
        IF blurD& < -1 THEN _FREEIMAGE blurD&
    ELSE
        shaded& = _COPYIMAGE(shadow&, 32)
    END IF
    SAFE_FREEIMAGE shadow& : SAFE_FREEIMAGE distMap&

    DIM result AS LONG
    result& = _COPYIMAGE(shaded&, 32)
    oldDest& = _DEST
    _DEST result& : _BLEND result& : _PUTIMAGE , sourceImg&, result& : _DEST oldDest&
    SAFE_FREEIMAGE shaded&

    IMAGE_ADJ_longshadow& = result&
END FUNCTION


''
' Open a modal Long Shadow dialog: single LENGTH slider (1..40). Shadow colour is
' the current BG colour. Alpha-changing -> apply_spatial.
'
SUB IMAGE_ADJ_longshadow_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB

    DIM ctx AS DIALOG_CTX
    DIALOG_init ctx, IMGDLG_W, 226
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&

    DIM length  AS INTEGER : length% = 12
    DIM angle   AS INTEGER : angle%  = 315
    DIM softf   AS INTEGER : softf%  = 3
    DIM fadef   AS INTEGER : fadef%  = 50
    DIM dLength AS INTEGER : dLength% = 12
    DIM dAngle  AS INTEGER : dAngle%  = 315
    DIM dSoftf  AS INTEGER : dSoftf%  = 3
    DIM dFadef  AS INTEGER : dFadef%  = 50
    DIM oLength AS INTEGER, oAngle AS INTEGER, oSoftf AS INTEGER, oFadef AS INTEGER

    DIM k AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE

        oLength% = length% : oAngle% = angle% : oSoftf% = softf% : oFadef% = fadef%
        length% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, length%, 1, 250)
        length% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, length%, 1, 250)
        angle%  = IMGDLG_angle_handle%(ctx, 1, angle%)
        softf%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, softf%, 0, 100)
        softf%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, softf%, 0, 100)
        fadef%  = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, 14, fadef%, 0, 100)
        fadef%  = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, 14, fadef%, 0, 100)
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset4 ctx, length%, angle%, softf%, fadef%, dLength%, dAngle%, dSoftf%, dFadef%
        IF length% <> oLength% OR angle% <> oAngle% OR softf% <> oSoftf% OR fadef% <> oFadef% THEN ctx.previewDirty% = TRUE

        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            ctx.previewThumb = IMAGE_ADJ_longshadow&(IMGADJ_fx_src&(ctx), length%, angle%, PAINT_BG_COLOR~&, softf%, fadef%)
            IMAGE_ADJ_fx_preview_finish ctx, 1
            ctx.previewDirty% = FALSE
        END IF

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "PERSPECTIVE SHADOW"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "LENGTH:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, length%, 1, 250, "", ""
        IMGDLG_angle_draw ctx, 1, angle%, "CAST ANGLE:"
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 2), "SOFTEN (FAR):"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, softf%, 0, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 3), "FADE (FAR):"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 3), IMGDLG_SW, fadef%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%

    IF ctx.result% THEN
        DIM lsTargets(1 TO MAX_LAYERS) AS INTEGER, lsTgtCount AS INTEGER, lsT AS INTEGER
        DIM lsSaveCL AS INTEGER
        IMAGE_ADJ_collect_targets lsTargets%(), lsTgtCount%
        lsSaveCL% = CURRENT_LAYER%
        IF lsTgtCount% > 1 THEN HISTORY_begin_group
        DIM adjR     AS LONG
        FOR lsT% = 1 TO lsTgtCount%
            CURRENT_LAYER% = lsTargets%(lsT%)
            DIM lsEdge AS LONG
            lsEdge& = IMGADJ_edge_shape_source&(LAYERS(CURRENT_LAYER%).imgHandle&, LAYERS(CURRENT_LAYER%).apronW%, LAYERS(CURRENT_LAYER%).apronH%)
            IF lsEdge& < -1 THEN
                adjR& = IMAGE_ADJ_longshadow&(lsEdge&, length%, angle%, PAINT_BG_COLOR~&, softf%, fadef%)
                IMAGE_ADJ_apply_spatial_edge adjR&, lsEdge&, "Long Shadow"
                SAFE_FREEIMAGE lsEdge&
            ELSE
                adjR& = IMAGE_ADJ_longshadow&(LAYERS(CURRENT_LAYER%).imgHandle&, length%, angle%, PAINT_BG_COLOR~&, softf%, fadef%)
                IMAGE_ADJ_apply_spatial adjR&, "Long Shadow"
            END IF
        NEXT lsT%
        IF lsTgtCount% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = lsSaveCL%
        IMGADJ_stash_fx length%, angle%, softf%, fadef%   ' enable instant Redo
    END IF

    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB


''
' ===========================================================================
' Eye Candy TEXTURE effects — procedural surfaces painted over the shape's own
' pixels (masked to its alpha -> apply_to_layer). Shared helper below turns a
' [0,1] value plus a 3-stop ramp into a colour.
' ===========================================================================

''
' Blend an effect result back over the original by MIX% (0 = original, 100 = full
' effect), preserving the effect's alpha. Lets textures/overlays be dialed down
' instead of all-or-nothing. Returns a new image; caller frees fxImg separately.
'
FUNCTION IMAGE_ADJ_mix_result& (origImg AS LONG, fxImg AS LONG, mixP AS INTEGER)
    IF NOT (fxImg& < -1) THEN IMAGE_ADJ_mix_result& = 0 : EXIT FUNCTION
    IF mixP% >= 100 OR NOT (origImg& < -1) THEN IMAGE_ADJ_mix_result& = _COPYIMAGE(fxImg&, 32) : EXIT FUNCTION
    DIM mw AS LONG, mh AS LONG
    mw& = _WIDTH(fxImg&) : mh& = _HEIGHT(fxImg&)
    DIM result AS LONG : result& = _COPYIMAGE(fxImg&, 32)
    IF _WIDTH(origImg&) <> mw& OR _HEIGHT(origImg&) <> mh& THEN IMAGE_ADJ_mix_result& = result& : EXIT FUNCTION
    DIM oM AS _MEM, fM AS _MEM, rM AS _MEM
    oM = _MEMIMAGE(origImg&) : fM = _MEMIMAGE(fxImg&) : rM = _MEMIMAGE(result&)
    DIM mf AS SINGLE : mf! = mixP% / 100.0
    DIM i AS _OFFSET, op AS _UNSIGNED LONG, fp AS _UNSIGNED LONG, fa AS _UNSIGNED _BYTE
    DIM orr AS INTEGER, ogg AS INTEGER, obb AS INTEGER, frr AS INTEGER, fgg AS INTEGER, fbb AS INTEGER
    DIM nr AS INTEGER, ng AS INTEGER, nb AS INTEGER
    FOR i = 0 TO fM.SIZE - 4 STEP 4
        _MEMGET fM, fM.OFFSET + i + 3, fa~%%
        IF fa~%% = 0 THEN _CONTINUE                 ' keep transparent fx pixels transparent
        _MEMGET oM, oM.OFFSET + i, op~&
        _MEMGET fM, fM.OFFSET + i, fp~&
        orr% = _RED32(op~&) : ogg% = _GREEN32(op~&) : obb% = _BLUE32(op~&)
        frr% = _RED32(fp~&) : fgg% = _GREEN32(fp~&) : fbb% = _BLUE32(fp~&)
        nr% = orr% + INT((frr% - orr%) * mf!)
        ng% = ogg% + INT((fgg% - ogg%) * mf!)
        nb% = obb% + INT((fbb% - obb%) * mf!)
        _MEMPUT rM, rM.OFFSET + i, _RGBA32(nr%, ng%, nb%, fa~%%) AS _UNSIGNED LONG
    NEXT i
    _MEMFREE oM : _MEMFREE fM : _MEMFREE rM
    IMAGE_ADJ_mix_result& = result&
END FUNCTION

''
' Wood (Eye Candy "Texture") — concentric ring grain warped by turbulence, in a
' dark-brown -> tan ramp, painted onto the shape. SCALE sets ring spacing; GRAIN
' sets turbulence/contrast. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_wood& (sourceImg AS LONG, scaleP AS INTEGER, grain AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_wood& = 0 : EXIT FUNCTION
    DIM woW AS LONG, woH AS LONG
    woW& = _WIDTH(sourceImg&) : woH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)

    DIM cx AS SINGLE, cy AS SINGLE : cx! = woW& * 0.35 : cy! = woH& * 1.4
    DIM freq AS SINGLE : freq! = 0.35 + scaleP% / 100.0 * 1.2
    DIM distort AS SINGLE : distort! = grain% / 100.0 * 8.0
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE
    DIM tb AS SINGLE, dd AS SINGLE, rings AS SINGLE, gv AS SINGLE
    DIM rr AS INTEGER, gg2 AS INTEGER, bb AS INTEGER
    FOR ay& = 0 TO woH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Wood", ay& / woH&
        FOR ax& = 0 TO woW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * woW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            tb! = IMGADJ_valnoise!(ax& * 0.05, ay& * 0.05, 111) * 0.6 _
                + IMGADJ_valnoise!(ax& * 0.13, ay& * 0.13, 112) * 0.4
            dd! = SQR((ax& - cx!) * (ax& - cx!) + (ay& - cy!) * (ay& - cy!))
            rings! = SIN(dd! * freq! * 0.12 + tb! * distort! + IMGADJ_valnoise!(ax& * 0.02, ay& * 0.4, 113) * 3.0)
            gv! = 0.5 + 0.5 * rings!
            gv! = gv! * gv!                                  ' sharpen the darker grain lines
            ' dark-brown (70,40,18) -> tan (170,120,70)
            rr% = 70 + INT((170 - 70) * gv!)
            gg2% = 40 + INT((120 - 40) * gv!)
            bb% = 18 + INT((70 - 18) * gv!)
            _MEMPUT resM, resM.OFFSET + (ay& * woW& + ax&) * 4, _RGBA32(rr%, gg2%, bb%, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_wood& = result&
END FUNCTION

''
' Marble (Eye Candy "Texture") — turbulence-veined marble: a sine of x warped by
' noise gives veins, mapped white<->dark-grey. SCALE sets vein frequency; VEINS
' sets turbulence. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_marble& (sourceImg AS LONG, scaleP AS INTEGER, veins AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_marble& = 0 : EXIT FUNCTION
    DIM maW AS LONG, maH AS LONG
    maW& = _WIDTH(sourceImg&) : maH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)

    DIM freq AS SINGLE : freq! = 0.03 + scaleP% / 100.0 * 0.12
    DIM turb AS SINGLE : turb! = 2.0 + veins% / 100.0 * 10.0
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE
    DIM tb AS SINGLE, v AS SINGLE, gv AS SINGLE, g2 AS INTEGER
    FOR ay& = 0 TO maH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Marble", ay& / maH&
        FOR ax& = 0 TO maW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * maW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            tb! = IMGADJ_valnoise!(ax& * 0.04, ay& * 0.04, 121) * 0.5 _
                + IMGADJ_valnoise!(ax& * 0.1, ay& * 0.1, 122) * 0.3 _
                + IMGADJ_valnoise!(ax& * 0.22, ay& * 0.22, 123) * 0.2
            v! = SIN((ax& + ay& * 0.4) * freq! + tb! * turb!)
            gv! = 0.5 + 0.5 * v!
            gv! = 1.0 - gv! * gv! * gv!                      ' thin dark veins on a light body
            g2% = 120 + INT(135 * gv!)                       ' 120..255 greys
            IF g2% > 255 THEN g2% = 255
            _MEMPUT resM, resM.OFFSET + (ay& * maW& + ax&) * 4, _RGBA32(g2%, g2%, g2% + 4, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_marble& = result&
END FUNCTION

''
' Brick Wall (Eye Candy "Texture") — running-bond brick tiling with mortar lines
' and per-brick colour jitter, painted onto the shape. SIZE sets brick height;
' MORTAR sets the joint width. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_brick& (sourceImg AS LONG, sizeP AS INTEGER, mortarW AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_brick& = 0 : EXIT FUNCTION
    DIM brW AS LONG, brH AS LONG
    brW& = _WIDTH(sourceImg&) : brH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)

    DIM bh AS INTEGER : bh% = sizeP% : IF bh% < 3 THEN bh% = 3
    DIM bw AS INTEGER : bw% = bh% * 2 + bh%                 ' bricks ~3x tall
    DIM mj AS INTEGER : mj% = mortarW% : IF mj% < 1 THEN mj% = 1
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE
    DIM brRow AS LONG, yInRow AS LONG, xShift AS LONG, brCol AS LONG, xInBr AS LONG
    DIM jit AS SINGLE, rr AS INTEGER, gg2 AS INTEGER, bb AS INTEGER
    FOR ay& = 0 TO brH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Brick", ay& / brH&
        FOR ax& = 0 TO brW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * brW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            brRow& = ay& \ bh%
            yInRow& = ay& - brRow& * bh%
            xShift& = ax&
            IF (brRow& AND 1) THEN xShift& = ax& + bw% \ 2   ' running bond offset
            brCol& = xShift& \ bw%
            xInBr& = xShift& - brCol& * bw%
            IF yInRow& < mj% OR xInBr& < mj% THEN
                rr% = 150 : gg2% = 145 : bb% = 138           ' mortar
            ELSE
                jit! = IMGADJ_valnoise!(brCol& * 1.7 + 0.3, brRow& * 1.7 + 0.3, 131)
                rr% = 150 + INT(60 * jit!) : gg2% = 60 + INT(35 * jit!) : bb% = 45 + INT(25 * jit!)
                ' faint per-pixel grain inside the brick
                jit! = IMGADJ_valnoise!(ax& * 0.5, ay& * 0.5, 132)
                rr% = rr% - INT(20 * jit!) : gg2% = gg2% - INT(12 * jit!) : bb% = bb% - INT(10 * jit!)
                IF rr% < 0 THEN rr% = 0
                IF gg2% < 0 THEN gg2% = 0
                IF bb% < 0 THEN bb% = 0
            END IF
            _MEMPUT resM, resM.OFFSET + (ay& * brW& + ax&) * 4, _RGBA32(rr%, gg2%, bb%, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_brick& = result&
END FUNCTION

''
' Diamond Plate (Eye Candy "Texture") — metal tread: alternating diagonal raised
' bars (direction flips per tile) shaded for 3D relief on a flat metal-grey base.
' SIZE sets tile size; DEPTH sets relief contrast. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_diamondplate& (sourceImg AS LONG, sizeP AS INTEGER, depth AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_diamondplate& = 0 : EXIT FUNCTION
    DIM dpW AS LONG, dpH AS LONG
    dpW& = _WIDTH(sourceImg&) : dpH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM ts AS INTEGER : ts% = sizeP% : IF ts% < 4 THEN ts% = 4
    DIM dScale AS SINGLE : dScale! = depth% / 100.0 * 110.0
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE
    DIM tileX AS LONG, tileY AS LONG, u AS SINGLE, vv AS SINGLE, diagv AS SINGLE, band AS SINGLE
    DIM g2 AS INTEGER, baseGrey AS INTEGER
    baseGrey% = 125
    FOR ay& = 0 TO dpH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Diamondplate", ay& / dpH&
        FOR ax& = 0 TO dpW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * dpW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            tileX& = ax& \ ts% : tileY& = ay& \ ts%
            u! = (ax& - tileX& * ts%) / ts% : vv! = (ay& - tileY& * ts%) / ts%
            IF ((tileX& + tileY&) AND 1) THEN
                diagv! = u! + vv!
            ELSE
                diagv! = u! - vv! + 1.0
            END IF
            band! = diagv! - INT(diagv!)                     ' fract, one ridge per tile
            IF band! > 0.25 AND band! < 0.75 THEN
                ' raised bar: shade across its width for 3D (bright->dark)
                g2% = baseGrey% + INT((0.5 - band!) * 2.0 * dScale!)
            ELSE
                g2% = baseGrey% - INT(dScale! * 0.25)        ' recessed base
            END IF
            IF g2% < 20 THEN g2% = 20
            IF g2% > 245 THEN g2% = 245
            _MEMPUT resM, resM.OFFSET + (ay& * dpW& + ax&) * 4, _RGBA32(g2%, g2%, g2% + 4, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_diamondplate& = result&
END FUNCTION

''
' Lightning (Eye Candy "Texture") — a jagged bolt runs down the shape: the bolt's
' x at each row wanders by fractal noise; pixels near the path get a white core
' fading to a blue glow, over a darkened copy of the shape so the bolt pops.
' JAG sets path waviness; GLOW sets bolt width/brightness. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_lightning& (sourceImg AS LONG, jag AS INTEGER, glow AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_lightning& = 0 : EXIT FUNCTION
    DIM ltW AS LONG, ltH AS LONG
    ltW& = _WIDTH(sourceImg&) : ltH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM jagAmp AS SINGLE : jagAmp! = ltW& * 0.12 + jag% / 100.0 * ltW& * 0.3
    DIM glowW AS SINGLE : glowW! = 2.0 + glow% / 100.0 * (ltW& * 0.12)
    DIM cxBase AS SINGLE : cxBase! = ltW& * 0.5
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG
    DIM boltX AS SINGLE, boltX2 AS SINGLE, dist AS SINGLE, dist2 AS SINGLE, t AS SINGLE
    DIM pr AS INTEGER, pg AS INTEGER, pb AS INTEGER, lr AS INTEGER, lg AS INTEGER, lb AS INTEGER, best AS SINGLE
    FOR ay& = 0 TO ltH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Lightning", ay& / ltH&
        ' main bolt path + one branch (offset seed), both wandering by noise
        boltX! = cxBase! + (IMGADJ_valnoise!(ay& * 0.12, 0.5, 191) - 0.5) * 2.0 * jagAmp! _
               + (IMGADJ_valnoise!(ay& * 0.4, 1.5, 192) - 0.5) * jagAmp! * 0.5
        boltX2! = cxBase! + ltW& * 0.18 + (IMGADJ_valnoise!(ay& * 0.15, 7.5, 193) - 0.5) * 2.0 * jagAmp!
        FOR ax& = 0 TO ltW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * ltW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            dist! = ABS(ax& - boltX!)
            dist2! = ABS(ax& - boltX2!)
            IF ay& < ltH& * 0.4 THEN dist2! = 1e9           ' branch only in lower part
            best! = dist! : IF dist2! < best! THEN best! = dist2!
            _MEMGET srcM, srcM.OFFSET + (ay& * ltW& + ax&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)
            IF best! > glowW! THEN
                ' darkened base so the bolt stands out
                _MEMPUT resM, resM.OFFSET + (ay& * ltW& + ax&) * 4, _RGBA32(pr% \ 3, pg% \ 3, INT(pb% \ 3) + 10, aHere~%%) AS _UNSIGNED LONG
            ELSE
                t! = best! / glowW!                          ' 0 core .. 1 edge
                IF t! < 0.25 THEN
                    lr% = 255 : lg% = 255 : lb% = 255        ' white-hot core
                ELSE
                    lr% = INT(150 * (1.0 - t!)) : lg% = INT(190 * (1.0 - t!)) : lb% = INT(120 + 135 * (1.0 - t!))
                    IF lb% > 255 THEN lb% = 255
                END IF
                _MEMPUT resM, resM.OFFSET + (ay& * ltW& + ax&) * 4, _RGBA32(lr%, lg%, lb%, aHere~%%) AS _UNSIGNED LONG
            END IF
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_lightning& = result&
END FUNCTION

''
' Stone Wall (Eye Candy "Texture") — irregular stone cells (Voronoi on a jittered
' grid) in mottled greys, separated by dark mortar where the nearest two seeds are
' close (cell borders). SIZE sets stone size; MORTAR sets joint width. RGB-only
' -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_stone& (sourceImg AS LONG, sizeP AS INTEGER, mortarW AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_stone& = 0 : EXIT FUNCTION
    DIM stW AS LONG, stH AS LONG
    stW& = _WIDTH(sourceImg&) : stH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM sp AS INTEGER : sp% = sizeP% : IF sp% < 4 THEN sp% = 4
    DIM mortarF AS SINGLE : mortarF! = mortarW% * 0.6
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE
    DIM cgx AS LONG, cgy AS LONG, ngx AS INTEGER, ngy AS INTEGER
    DIM scx AS SINGLE, scy AS SINGLE, ddx AS SINGLE, ddy AS SINGLE, dist AS SINGLE
    DIM d1 AS SINGLE, d2 AS SINGLE, bestGX AS LONG, bestGY AS LONG, jit AS SINGLE
    DIM tone AS SINGLE, g2 AS INTEGER
    FOR ay& = 0 TO stH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Stone", ay& / stH&
        FOR ax& = 0 TO stW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * stW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            cgx& = ax& \ sp% : cgy& = ay& \ sp%
            d1! = 1e9 : d2! = 1e9 : bestGX& = 0 : bestGY& = 0
            FOR ngy% = -1 TO 1
                FOR ngx% = -1 TO 1
                    jit! = IMGADJ_valnoise!((cgx& + ngx%) * 1.7, (cgy& + ngy%) * 1.7, 171)
                    scx! = (cgx& + ngx%) * sp% + sp% * (0.2 + 0.6 * jit!)
                    jit! = IMGADJ_valnoise!((cgx& + ngx%) * 1.7, (cgy& + ngy%) * 1.7, 172)
                    scy! = (cgy& + ngy%) * sp% + sp% * (0.2 + 0.6 * jit!)
                    ddx! = ax& - scx! : ddy! = ay& - scy!
                    dist! = SQR(ddx! * ddx! + ddy! * ddy!)
                    IF dist! < d1! THEN
                        d2! = d1! : d1! = dist! : bestGX& = cgx& + ngx% : bestGY& = cgy& + ngy%
                    ELSEIF dist! < d2! THEN
                        d2! = dist!
                    END IF
                NEXT ngx%
                NEXT ngy%
            IF (d2! - d1!) < mortarF! THEN
                g2% = 70                                     ' dark mortar joint
            ELSE
                jit! = IMGADJ_valnoise!(bestGX& * 2.3 + 0.5, bestGY& * 2.3 + 0.5, 173)
                tone! = 0.55 + 0.4 * jit!                    ' per-stone base grey
                ' fine intra-stone speckle
                tone! = tone! + (IMGADJ_valnoise!(ax& * 0.4, ay& * 0.4, 174) - 0.5) * 0.18
                g2% = INT(255 * tone!)
                IF g2% < 40 THEN g2% = 40
                IF g2% > 235 THEN g2% = 235
            END IF
            _MEMPUT resM, resM.OFFSET + (ay& * stW& + ax&) * 4, _RGBA32(g2%, g2% - 4, g2% - 10, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_stone& = result&
END FUNCTION

''
' Reptile Skin (Eye Candy "Texture") — Voronoi scale cells shaded like little
' domes (bright centre, dark ridge at the borders) tinted with the shape colour.
' SIZE sets scale size; RELIEF sets dome contrast. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_reptile& (sourceImg AS LONG, sizeP AS INTEGER, relief AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_reptile& = 0 : EXIT FUNCTION
    DIM rsW AS LONG, rsH AS LONG
    rsW& = _WIDTH(sourceImg&) : rsH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM sp AS INTEGER : sp% = sizeP% : IF sp% < 4 THEN sp% = 4
    DIM reScale AS SINGLE : reScale! = 0.4 + relief% / 100.0 * 1.1
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG
    DIM cgx AS LONG, cgy AS LONG, ngx AS INTEGER, ngy AS INTEGER
    DIM scx AS SINGLE, scy AS SINGLE, ddx AS SINGLE, ddy AS SINGLE, dist AS SINGLE
    DIM d1 AS SINGLE, d2 AS SINGLE, jit AS SINGLE, dome AS SINGLE
    DIM pr AS INTEGER, pg AS INTEGER, pb AS INTEGER, rr AS INTEGER, rg AS INTEGER, rb AS INTEGER
    FOR ay& = 0 TO rsH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Reptile", ay& / rsH&
        FOR ax& = 0 TO rsW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * rsW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            cgx& = ax& \ sp% : cgy& = ay& \ sp%
            d1! = 1e9 : d2! = 1e9
            FOR ngy% = -1 TO 1
                FOR ngx% = -1 TO 1
                    jit! = IMGADJ_valnoise!((cgx& + ngx%) * 1.9, (cgy& + ngy%) * 1.9, 181)
                    scx! = (cgx& + ngx%) * sp% + sp% * (0.25 + 0.5 * jit!)
                    jit! = IMGADJ_valnoise!((cgx& + ngx%) * 1.9, (cgy& + ngy%) * 1.9, 182)
                    scy! = (cgy& + ngy%) * sp% + sp% * (0.25 + 0.5 * jit!)
                    ddx! = ax& - scx! : ddy! = ay& - scy!
                    dist! = SQR(ddx! * ddx! + ddy! * ddy!)
                    IF dist! < d1! THEN
                        d2! = d1! : d1! = dist!
                    ELSEIF dist! < d2! THEN
                        d2! = dist!
                    END IF
                NEXT ngx%
                NEXT ngy%
            ' dome: bright near a cell centre (small d1), dark at the ridge (d1~=d2)
            dome! = (d2! - d1!) / (sp% * 0.5)
            IF dome! > 1.0 THEN dome! = 1.0
            dome! = (dome! - 0.5) * reScale!                 ' -.. + about mid
            _MEMGET srcM, srcM.OFFSET + (ay& * rsW& + ax&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)
            rr% = pr% + INT(dome! * 150) : rg% = pg% + INT(dome! * 150) : rb% = pb% + INT(dome! * 150)
            IF rr% < 0 THEN rr% = 0
            IF rr% > 255 THEN rr% = 255
            IF rg% < 0 THEN rg% = 0
            IF rg% > 255 THEN rg% = 255
            IF rb% < 0 THEN rb% = 0
            IF rb% > 255 THEN rb% = 255
            _MEMPUT resM, resM.OFFSET + (ay& * rsW& + ax&) * 4, _RGBA32(rr%, rg%, rb%, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_reptile& = result&
END FUNCTION

''
' Ripples (Eye Candy "Texture") — concentric water ripples: sample the surface
' with a radial sinusoidal displacement centred on the shape, so the pixels look
' like they sit under rippling water. AMP sets displacement; FREQ sets ring
' spacing. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_ripples& (sourceImg AS LONG, amp AS INTEGER, freqP AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_ripples& = 0 : EXIT FUNCTION
    DIM rpW AS LONG, rpH AS LONG
    rpW& = _WIDTH(sourceImg&) : rpH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM cx AS SINGLE, cy AS SINGLE : cx! = rpW& / 2.0 : cy! = rpH& / 2.0
    DIM amAmp AS SINGLE : amAmp! = amp% / 100.0 * 6.0
    DIM freq AS SINGLE : freq! = 0.1 + freqP% / 100.0 * 0.7
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE, sA AS _UNSIGNED _BYTE
    DIM ddx AS SINGLE, ddy AS SINGLE, dist AS SINGLE, disp AS SINGLE, ux AS SINGLE, uy AS SINGLE
    DIM samX AS LONG, samY AS LONG, pix AS _UNSIGNED LONG
    FOR ay& = 0 TO rpH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Ripples", ay& / rpH&
        FOR ax& = 0 TO rpW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * rpW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            ddx! = ax& - cx! : ddy! = ay& - cy!
            dist! = SQR(ddx! * ddx! + ddy! * ddy!)
            IF dist! < 0.5 THEN dist! = 0.5
            disp! = SIN(dist! * freq!) * amAmp!
            ux! = ddx! / dist! : uy! = ddy! / dist!         ' radial unit vector
            samX& = ax& + INT(ux! * disp! + 0.5)
            samY& = ay& + INT(uy! * disp! + 0.5)
            IF samX& < 0 THEN samX& = 0
            IF samX& >= rpW& THEN samX& = rpW& - 1
            IF samY& < 0 THEN samY& = 0
            IF samY& >= rpH& THEN samY& = rpH& - 1
            _MEMGET srcM, srcM.OFFSET + (samY& * rpW& + samX&) * 4 + 3, sA~%%
            IF sA~%% = 0 THEN samX& = ax& : samY& = ay&
            _MEMGET srcM, srcM.OFFSET + (samY& * rpW& + samX&) * 4, pix~&
            _MEMPUT resM, resM.OFFSET + (ay& * rpW& + ax&) * 4, pix~& AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_ripples& = result&
END FUNCTION

''
' Animal Fur (Eye Candy "Texture") — directional furry noise: many fine strands
' running along a fixed direction, lightening/darkening the shape colour so it
' looks like short fur. DENSITY sets strand contrast; DIRECTION 0=horizontal,
' 100=vertical. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_fur& (sourceImg AS LONG, density AS INTEGER, direction AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_fur& = 0 : EXIT FUNCTION
    DIM fuW AS LONG, fuH AS LONG
    fuW& = _WIDTH(sourceImg&) : fuH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM dScale AS SINGLE : dScale! = 0.4 + density% / 100.0 * 0.9
    ' along-strand smooth, across-strand fine; direction blends the two axes
    DIM dir AS SINGLE : dir! = direction% / 100.0
    DIM alongX AS SINGLE, alongY AS SINGLE, acrX AS SINGLE, acrY AS SINGLE
    alongX! = 0.06 + dir! * 0.84 : alongY! = 0.9 - dir! * 0.84    ' fine axis
    acrX! = 0.9 - dir! * 0.84 : acrY! = 0.06 + dir! * 0.84        ' smooth axis
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG
    DIM n AS SINGLE, sh AS SINGLE, pr AS INTEGER, pg AS INTEGER, pb AS INTEGER
    DIM fr AS INTEGER, fg AS INTEGER, fb AS INTEGER
    FOR ay& = 0 TO fuH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Fur", ay& / fuH&
        FOR ax& = 0 TO fuW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * fuW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            n! = IMGADJ_valnoise!(ax& * alongX! + ay& * alongY! * 0.0, ay& * acrY! + ax& * acrX! * 0.0, 151)
            ' combine a fine strand axis with a slower clump axis
            n! = IMGADJ_valnoise!(ax& * alongX!, ay& * acrY!, 151) * 0.7 _
               + IMGADJ_valnoise!(ax& * alongX! * 0.5, ay& * acrY! * 0.5, 152) * 0.3
            sh! = 0.6 + (n! - 0.5) * 2.0 * dScale!
            IF sh! < 0.25 THEN sh! = 0.25
            IF sh! > 1.35 THEN sh! = 1.35
            _MEMGET srcM, srcM.OFFSET + (ay& * fuW& + ax&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)
            fr% = INT(pr% * sh!) : fg% = INT(pg% * sh!) : fb% = INT(pb% * sh!)
            IF fr% > 255 THEN fr% = 255
            IF fg% > 255 THEN fg% = 255
            IF fb% > 255 THEN fb% = 255
            _MEMPUT resM, resM.OFFSET + (ay& * fuW& + ax&) * 4, _RGBA32(fr%, fg%, fb%, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_fur& = result&
END FUNCTION

''
' Texture Noise (Eye Candy "Texture") — HSB-ish grain overlay: per-pixel hash
' noise perturbs the shape's brightness (and, unless MONO, each channel
' independently for coloured speckle). AMOUNT sets strength; MONO 0=colour,
' 100=monochrome. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_texnoise& (sourceImg AS LONG, amount AS INTEGER, mono AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_texnoise& = 0 : EXIT FUNCTION
    DIM tnW AS LONG, tnH AS LONG
    tnW& = _WIDTH(sourceImg&) : tnH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM amt AS SINGLE : amt! = amount% / 100.0 * 140.0
    DIM isMono AS INTEGER : isMono% = (mono% >= 50)
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG
    DIM nR AS SINGLE, nG AS SINGLE, nB AS SINGLE
    DIM pr AS INTEGER, pg AS INTEGER, pb AS INTEGER, tr AS INTEGER, tg AS INTEGER, tb AS INTEGER
    FOR ay& = 0 TO tnH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Texnoise", ay& / tnH&
        FOR ax& = 0 TO tnW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * tnW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            nR! = (IMGADJ_valnoise!(ax& * 1.9 + 0.1, ay& * 1.9 + 0.1, 161) - 0.5)
            IF isMono% THEN
                nG! = nR! : nB! = nR!
            ELSE
                nG! = (IMGADJ_valnoise!(ax& * 1.9 + 5.3, ay& * 1.9 + 5.3, 162) - 0.5)
                nB! = (IMGADJ_valnoise!(ax& * 1.9 + 9.7, ay& * 1.9 + 9.7, 163) - 0.5)
            END IF
            _MEMGET srcM, srcM.OFFSET + (ay& * tnW& + ax&) * 4, pix~&
            pr% = _RED32(pix~&) : pg% = _GREEN32(pix~&) : pb% = _BLUE32(pix~&)
            tr% = pr% + INT(nR! * amt!) : tg% = pg% + INT(nG! * amt!) : tb% = pb% + INT(nB! * amt!)
            IF tr% < 0 THEN tr% = 0
            IF tr% > 255 THEN tr% = 255
            IF tg% < 0 THEN tg% = 0
            IF tg% > 255 THEN tg% = 255
            IF tb% < 0 THEN tb% = 0
            IF tb% > 255 THEN tb% = 255
            _MEMPUT resM, resM.OFFSET + (ay& * tnW& + ax&) * 4, _RGBA32(tr%, tg%, tb%, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_texnoise& = result&
END FUNCTION

''
' Brushed Metal (Eye Candy "Texture") — anisotropic horizontal streak noise: fine
' along y, smooth along x, so it reads as brushed steel. BRIGHT sets the base
' grey; GRAIN sets streak contrast. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_brushmetal& (sourceImg AS LONG, bright AS INTEGER, grain AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_brushmetal& = 0 : EXIT FUNCTION
    DIM bmW AS LONG, bmH AS LONG
    bmW& = _WIDTH(sourceImg&) : bmH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM bmBase AS INTEGER : bmBase% = 90 + INT(bright% / 100.0 * 110)
    DIM amp AS SINGLE : amp! = grain% / 100.0 * 70.0
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE
    DIM n AS SINGLE, g2 AS INTEGER
    FOR ay& = 0 TO bmH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Brushmetal", ay& / bmH&
        FOR ax& = 0 TO bmW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * bmW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            ' x smooth (0.015), y fine (0.9) -> long horizontal brush strokes
            n! = IMGADJ_valnoise!(ax& * 0.015, ay& * 0.9, 141) - 0.5 _
               + (IMGADJ_valnoise!(ax& * 0.05, ay& * 2.1, 142) - 0.5) * 0.4
            g2% = bmBase% + INT(n! * amp!)
            IF g2% < 0 THEN g2% = 0
            IF g2% > 255 THEN g2% = 255
            _MEMPUT resM, resM.OFFSET + (ay& * bmW& + ax&) * 4, _RGBA32(g2%, g2%, g2% + 6, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_brushmetal& = result&
END FUNCTION

''
' Weave (Eye Candy "Texture") — over/under basket weave. Cells alternate warp
' (vertical) and weft (horizontal) strips; each strip is shaded across its width
' so the strands look rounded, with a shadow in the gaps. SIZE sets strand width;
' TONE tints toward the shape colour vs a straw colour. RGB-only -> apply_to_layer.
'
FUNCTION IMAGE_ADJ_weave& (sourceImg AS LONG, sizeP AS INTEGER, tone AS INTEGER)
    IF NOT (sourceImg& < -1) THEN IMAGE_ADJ_weave& = 0 : EXIT FUNCTION
    DIM weW AS LONG, weH AS LONG
    weW& = _WIDTH(sourceImg&) : weH& = _HEIGHT(sourceImg&)
    DIM result AS LONG : result& = _COPYIMAGE(sourceImg&, 32)
    DIM srcM AS _MEM, resM AS _MEM
    srcM = _MEMIMAGE(sourceImg&) : resM = _MEMIMAGE(result&)
    DIM ss AS INTEGER : ss% = sizeP% : IF ss% < 3 THEN ss% = 3
    DIM period AS INTEGER : period% = ss% * 2
    DIM baseR AS INTEGER, baseG AS INTEGER, baseB AS INTEGER
    DIM ax AS LONG, ay AS LONG, aHere AS _UNSIGNED _BYTE, pix AS _UNSIGNED LONG
    DIM cxp AS LONG, cyp AS LONG, inX AS LONG, inY AS LONG, overV AS INTEGER
    DIM shade AS SINGLE, acr AS SINGLE, wr AS INTEGER, wg AS INTEGER, wb AS INTEGER, tScale AS SINGLE
    tScale! = tone% / 100.0
    FOR ay& = 0 TO weH& - 1
    IF (ay& AND 15) = 0 THEN IMGADJ_progress_tick "Weave", ay& / weH&
        FOR ax& = 0 TO weW& - 1
            _MEMGET srcM, srcM.OFFSET + (ay& * weW& + ax&) * 4 + 3, aHere~%%
            IF aHere~%% = 0 THEN _CONTINUE
            _MEMGET srcM, srcM.OFFSET + (ay& * weW& + ax&) * 4, pix~&
            ' blend shape colour with a straw colour by TONE
            baseR% = INT(_RED32(pix~&) * (1.0 - tScale!) + 200 * tScale!)
            baseG% = INT(_GREEN32(pix~&) * (1.0 - tScale!) + 175 * tScale!)
            baseB% = INT(_BLUE32(pix~&) * (1.0 - tScale!) + 110 * tScale!)
            cxp& = (ax& \ ss%) : cyp& = (ay& \ ss%)
            inX& = ax& - (ax& \ ss%) * ss% : inY& = ay& - (ay& \ ss%) * ss%
            ' checker of over/under
            overV% = ((cxp& + cyp&) AND 1)
            IF overV% THEN
                ' vertical strand on top: shade across its width (inX)
                acr! = (inX& + 0.5) / ss%
            ELSE
                ' horizontal strand on top: shade across inY
                acr! = (inY& + 0.5) / ss%
            END IF
            shade! = 0.55 + 0.45 * SIN(acr! * 3.14159265)     ' rounded strand
            wr% = INT(baseR% * shade!) : wg% = INT(baseG% * shade!) : wb% = INT(baseB% * shade!)
            IF wr% > 255 THEN wr% = 255
            IF wg% > 255 THEN wg% = 255
            IF wb% > 255 THEN wb% = 255
            _MEMPUT resM, resM.OFFSET + (ay& * weW& + ax&) * 4, _RGBA32(wr%, wg%, wb%, aHere~%%) AS _UNSIGNED LONG
        NEXT ax&
    NEXT ay&
    _MEMFREE srcM : _MEMFREE resM
    IMAGE_ADJ_weave& = result&
END FUNCTION


''
' Modal dialogs for the three TEXTURE effects. All share the 2-slider + loupe
' pattern; RGB-only -> apply_to_layer.
'
SUB IMAGE_ADJ_wood_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB
    DIM ctx AS DIALOG_CTX : DIALOG_init ctx, IMGDLG_W, 176
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&
    DIM p1 AS INTEGER : p1% = 40
    DIM p2 AS INTEGER : p2% = 50
    DIM texMix AS INTEGER : texMix% = 100
    DIM d1 AS INTEGER : d1% = 40
    DIM d2 AS INTEGER : d2% = 50
    DIM dMix AS INTEGER : dMix% = 100
    DIM o1 AS INTEGER, o2 AS INTEGER, oMix AS INTEGER, k AS LONG
    DIM texFx AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE
        o1% = p1% : o2% = p2% : oMix% = texMix%
        p1% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, p1%, 0, 100)
        p1% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, p1%, 0, 100)
        p2% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, p2%, 0, 100)
        p2% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, p2%, 0, 100)
        texMix% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, texMix%, 0, 100)
        texMix% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, texMix%, 0, 100)
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset3 ctx, p1%, p2%, texMix%, d1%, d2%, dMix%
        IF p1% <> o1% OR p2% <> o2% OR texMix% <> oMix% THEN ctx.previewDirty% = TRUE
        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            texFx& = IMAGE_ADJ_wood&(ctx.origThumb, p1%, p2%)
            ctx.previewThumb = IMAGE_ADJ_mix_result&(ctx.origThumb, texFx&, texMix%)
            SAFE_FREEIMAGE texFx&
            IMAGE_ADJ_mask_preview ctx : ctx.previewDirty% = FALSE
        END IF
        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "WOOD"
        DIALOG_draw_preview ctx
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 0), "SCALE:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, p1%, 0, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 1), "GRAIN:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, p2%, 0, 100, "", ""
        DIALOG_draw_label ctx, IMGDLG_SX, IMGDLG_label_y%(ctx, 2), "MIX:"
        DIALOG_draw_slider ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, texMix%, 0, 100, "", ""
        DIALOG_draw_divider ctx, ctx.h - IMGDLG_BTN_H - 16
        IMGDLG_draw_ok_cancel ctx
        DIALOG_blit ctx
    LOOP UNTIL ctx.done%
    IF ctx.result% THEN
        DIM tgts(1 TO MAX_LAYERS) AS INTEGER, tc AS INTEGER, ti AS INTEGER, scl AS INTEGER
        IMAGE_ADJ_collect_targets tgts%(), tc%
        scl% = CURRENT_LAYER%
        IF tc% > 1 THEN HISTORY_begin_group
        DIM adjR AS LONG, adjMix AS LONG
        FOR ti% = 1 TO tc%
            CURRENT_LAYER% = tgts%(ti%)
            adjR& = IMAGE_ADJ_wood&(LAYERS(CURRENT_LAYER%).imgHandle&, p1%, p2%)
            adjMix& = IMAGE_ADJ_mix_result&(LAYERS(CURRENT_LAYER%).imgHandle&, adjR&, texMix%)
            SAFE_FREEIMAGE adjR&
            IMAGE_ADJ_apply_to_layer adjMix&, "Wood"
        NEXT ti%
        IF tc% > 1 THEN HISTORY_end_group
        CURRENT_LAYER% = scl%
    END IF
    DIALOG_cleanup ctx
    SAFE_FREEIMAGE IMGADJ_LAYER_MASK& : IMGADJ_LAYER_MASK& = 0
END SUB

SUB IMAGE_ADJ_marble_dialog ()
    IF CURRENT_LAYER% < 1 THEN EXIT SUB
    DIM ctx AS DIALOG_CTX : DIALOG_init ctx, IMGDLG_W, 176
    IMAGE_ADJ_setup_preview ctx, LAYERS(CURRENT_LAYER%).imgHandle&
    DIM p1 AS INTEGER : p1% = 45
    DIM p2 AS INTEGER : p2% = 55
    DIM texMix AS INTEGER : texMix% = 100
    DIM d1 AS INTEGER : d1% = 45
    DIM d2 AS INTEGER : d2% = 55
    DIM dMix AS INTEGER : dMix% = 100
    DIM o1 AS INTEGER, o2 AS INTEGER, oMix AS INTEGER, k AS LONG
    DIM texFx AS LONG
    DO
        DIALOG_poll_mouse ctx
        IF ctx.loupeDirty% THEN IMAGE_ADJ_update_loupe ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done% = TRUE : ctx.result% = TRUE
        IF k& = 27 THEN ctx.done% = TRUE : ctx.result% = FALSE
        o1% = p1% : o2% = p2% : oMix% = texMix%
        p1% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, p1%, 0, 100)
        p1% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 0), IMGDLG_SW, 14, p1%, 0, 100)
        p2% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, p2%, 0, 100)
        p2% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 1), IMGDLG_SW, 14, p2%, 0, 100)
        texMix% = DIALOG_slider_drag%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, texMix%, 0, 100)
        texMix% = DIALOG_slider_wheel%(ctx, IMGDLG_SX, IMGDLG_track_y%(ctx, 2), IMGDLG_SW, 14, texMix%, 0, 100)
        IMGDLG_check_ok_cancel ctx
        IMGDLG_reset3 ctx, p1%, p2%, texMix%, d1%, d2%, dMix%
        IF p1% <> o1% OR p2% <> o2% OR texMix% <> oMix% THEN ctx.previewDirty% = TRUE
        IF ctx.previewDirty% THEN
            SAFE_FREEIMAGE ctx.previewThumb
            texFx& = IMAGE_ADJ_marble&(ctx.origThumb, p1%, p2%)
