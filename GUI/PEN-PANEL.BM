''
' DRAW - GUI/PEN-PANEL.BM
' =============================================================================
' Pen Pressure panel implementation. See GUI/PEN-PANEL.BI.
' Renders to screen 0 at integer toolbar scale (same model as COLOR-SPACE-3D);
' font, title bar and controls come from GUI/FLOAT-PANEL (Color Mixer look).
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

OPTION _EXPLICIT
OPTION _EXPLICITARRAY

' ---------------------------------------------------------------------------
' PENP_init — Defaults + config-driven initial visibility. Lazy buffer init.
' ---------------------------------------------------------------------------
SUB PENP_init ()
    PENP.visible%     = FALSE
    PENP.positioned%  = FALSE
    PENP.initialized% = FALSE
    PENP.autoHidden%  = FALSE
    PENP.renderScale! = 1.0
    PENP.panelImg&    = 0
    PENP.dragging%    = FALSE
    PENP.sliding%     = PENP_CTL_NONE
    PENP.hoverCtl%    = PENP_CTL_NONE
    PENP.closeHover%  = FALSE
    PENP.lastP!       = -1
    IF CFG.PEN_PANEL_VISIBLE% THEN PENP.visible% = TRUE
END SUB

' ---------------------------------------------------------------------------
' PENP_ensure_initialized — layout + panel buffer, restored position.
' ---------------------------------------------------------------------------
SUB PENP_ensure_initialized ()
    IF PENP.initialized% THEN EXIT SUB
    PENP_layout
    IF PENP.panelImg& < -1 THEN _FREEIMAGE PENP.panelImg&
    PENP.panelImg& = _NEWIMAGE(PENP.panelW%, PENP.panelH%, 32)

    PENP_compute_display_size
    IF CFG.PEN_PANEL_X% > -1 AND CFG.PEN_PANEL_Y% > -1 THEN
        PENP.dispX%      = CFG.PEN_PANEL_X%
        PENP.dispY%      = CFG.PEN_PANEL_Y%
        PENP.positioned% = TRUE
    END IF
    PENP.initialized% = TRUE
END SUB

' ---------------------------------------------------------------------------
' PENP_layout — Row tops and slider track span from the Color Mixer font
' metrics (FPANEL), spaced like the mixer's slider rows and sections:
'   status / USE PEN PRESSURE + meter / three checkbox + LIGHT slider pairs /
'   CURVE + TIP / response graph.
' ---------------------------------------------------------------------------
SUB PENP_layout ()
    FPANEL_ensure
    PENP.panelW% = FPANEL_panel_w%
    DIM f AS INTEGER, g AS INTEGER, sec AS INTEGER, sh AS INTEGER, y AS INTEGER
    f%   = FPANEL.fontH%
    g%   = FPANEL.gap%
    sec% = FPANEL.section%
    sh%  = FPANEL.sliderH%

    y% = FPANEL.titleH% + FPANEL.pad%
    PENP.yStatus% = y%                    : y% = y% + f% + sec%
    PENP_ctlY(PENP_CTL_ON) = y%           : y% = y% + f% + g%
    PENP.yMeter% = y%                     : y% = y% + sh% + sec% + g%
    PENP_ctlY(PENP_CTL_SIZE_ON) = y%      : y% = y% + f% + g%
    PENP_ctlY(PENP_CTL_SIZE) = y%         : y% = y% + sh% + sec%
    PENP_ctlY(PENP_CTL_OPAC_ON) = y%      : y% = y% + f% + g%
    PENP_ctlY(PENP_CTL_OPAC) = y%         : y% = y% + sh% + sec%
    PENP_ctlY(PENP_CTL_MIX_ON) = y%       : y% = y% + f% + g%
    PENP_ctlY(PENP_CTL_MIX) = y%          : y% = y% + sh% + sec% + g%
    PENP_ctlY(PENP_CTL_CURVE) = y%        : y% = y% + sh% + g%
    PENP_ctlY(PENP_CTL_TIP) = y%          : y% = y% + sh% + sec% + g%
    PENP.yGraph% = y%                     : y% = y% + PENP_GRAPH_H + FPANEL.pad%
    PENP.panelH% = y%

    ' Track span: after the widest label (sub-slider labels sit under their
    ' checkbox's text), before a value column wide enough for "100%".
    DIM oldDest AS LONG : oldDest& = _DEST
    DIM probe   AS LONG : probe& = _NEWIMAGE(8, 8, 32)
    _DEST probe&
    DIM oldFont AS LONG : oldFont& = FPANEL_begin&
    DIM bs      AS INTEGER : bs% = FPANEL.fontH% - 1
    IF bs% < 7 THEN bs% = 7
    PENP.subX% = FPANEL.pad% + bs% + 4
    DIM lw AS INTEGER : lw% = PENP.subX% + _UPRINTWIDTH("LIGHT")
    IF FPANEL.pad% + _UPRINTWIDTH("CURVE") > lw% THEN lw% = FPANEL.pad% + _UPRINTWIDTH("CURVE")
    PENP.trackX0% = lw% + 6
    PENP.trackX1% = PENP.panelW% - FPANEL.pad% - _UPRINTWIDTH("100%") - 6
    _FONT oldFont&
    _DEST oldDest&
    _FREEIMAGE probe&
END SUB

' ---------------------------------------------------------------------------
' PENP_reset — Reset transient state after a document load.
' ---------------------------------------------------------------------------
SUB PENP_reset ()
    PENP.autoHidden% = FALSE
    PENP.dragging%   = FALSE
    PENP.sliding%    = PENP_CTL_NONE
    PENP.hoverCtl%   = PENP_CTL_NONE
END SUB

' ---------------------------------------------------------------------------
' PENP_toggle — Show/hide the panel (auto-place on first open).
' ---------------------------------------------------------------------------
SUB PENP_toggle ()
    IF PENP.visible% THEN
        PENP.visible% = FALSE
    ELSE
        PENP.visible%    = TRUE
        PENP.autoHidden% = FALSE
        PENP_ensure_initialized
        IF NOT PENP.positioned% THEN PENP_auto_position
        ' Open beside, not on top of, any other floating window
        FPANEL_place REGION_PEN_PANEL, PENP.dispX%, PENP.dispY%, PENP.dispW%, PENP.dispH%, PENP.dispX%, PENP.dispY%
        CFG.PEN_PANEL_X% = PENP.dispX%
        CFG.PEN_PANEL_Y% = PENP.dispY%
    END IF
    CFG.PEN_PANEL_VISIBLE% = PENP.visible%
    SCENE_DIRTY%           = TRUE
    FRAME_IDLE%            = FALSE
END SUB

' ---------------------------------------------------------------------------
' PENP_compute_display_size — native -> viewport footprint (ts/ds scale).
' ---------------------------------------------------------------------------
SUB PENP_compute_display_size ()
    DIM ts AS INTEGER, ds AS INTEGER
    ts%               = USCALE.mixer%      : IF ts% < 1 THEN ts% = 1
    ds%               = SCRN.displayScale% : IF ds% < 1 THEN ds% = 1
    PENP.renderScale! = CSNG(ts%) / CSNG(ds%)
    PENP.dispW%       = INT(CSNG(PENP.panelW%) * CSNG(ts%) / CSNG(ds%) + 0.5)
    PENP.dispH%       = INT(CSNG(PENP.panelH%) * CSNG(ts%) / CSNG(ds%) + 0.5)
END SUB

' ---------------------------------------------------------------------------
' PENP_auto_position — top-left of the work area.
' ---------------------------------------------------------------------------
SUB PENP_auto_position ()
    PENP_ensure_initialized
    DIM pad  AS INTEGER : pad% = 8
    DIM minY AS INTEGER, maxY AS INTEGER
    CS3D_work_area minY%, maxY%
    PENP.dispX%       = SCRN.uiLeftEdge% + pad%
    PENP.dispY%       = minY% + pad%
    PENP.positioned%  = TRUE
    CFG.PEN_PANEL_X%  = PENP.dispX%
    CFG.PEN_PANEL_Y%  = PENP.dispY%
END SUB

' ---------------------------------------------------------------------------
' PENP_clamp_to_work_area — Keep the panel (at least its title bar) on screen.
' ---------------------------------------------------------------------------
SUB PENP_clamp_to_work_area ()
    IF NOT PENP.initialized% THEN EXIT SUB
    IF PENP.docked% THEN EXIT SUB ' the dock slot places it
    DIM minX AS INTEGER, maxX AS INTEGER, minY AS INTEGER, maxY AS INTEGER
    minX% = SCRN.uiLeftEdge%
    maxX% = SCRN.uiRightEdge%
    CS3D_work_area minY%, maxY%
    DIM lx AS LONG, ly AS LONG
    lx = PENP.dispX%: ly = PENP.dispY%
    LAY_clamp lx, ly, CLNG(PENP.dispW%), CLNG(PENP.dispH%), CLNG(minX%), CLNG(minY%), CLNG(maxX%), CLNG(maxY%)
    PENP.dispX% = lx: PENP.dispY% = ly
END SUB

' ---------------------------------------------------------------------------
' PENP_hit_window% / PENP_active_hit% — Is the viewport pixel on the panel?
' ---------------------------------------------------------------------------
FUNCTION PENP_hit_window% (rawX AS INTEGER, rawY AS INTEGER)
    IF DOCK_native_off%(DP_PEN) THEN EXIT FUNCTION ' docked in a slot that shows nothing this frame
    PENP_hit_window% = FALSE
    IF NOT PENP.initialized% THEN EXIT FUNCTION
    IF rawX% >= PENP.dispX% AND rawX% < PENP.dispX% + PENP.dispW% THEN
        IF rawY% >= PENP.dispY% AND rawY% < PENP.dispY% + PENP.dispH% THEN PENP_hit_window% = TRUE
    END IF
END FUNCTION

FUNCTION PENP_active_hit% (rawX AS INTEGER, rawY AS INTEGER)
    PENP_active_hit% = FALSE
    IF NOT PENP.visible% THEN EXIT FUNCTION
    IF PENP.autoHidden% THEN EXIT FUNCTION
    PENP_active_hit% = PENP_hit_window%(rawX%, rawY%)
END FUNCTION

' ---------------------------------------------------------------------------
' Slider value <-> track position. The curve slider is logarithmic (25..400,
' 100 = linear in the middle); the others are linear 0..100 %.
' ---------------------------------------------------------------------------
FUNCTION PENP_slider_frac! (ctl AS INTEGER)
    DIM v AS SINGLE
    SELECT CASE ctl%
        CASE PENP_CTL_SIZE:  v! = CFG.PEN_MIN_SIZE% / 100!
        CASE PENP_CTL_OPAC:  v! = CFG.PEN_MIN_OPACITY% / 100!
        CASE PENP_CTL_MIX:   v! = CFG.PEN_MIX_MIN% / 100!
        CASE PENP_CTL_TIP:   v! = CFG.PEN_TIP_THRESHOLD% / 50!
        CASE PENP_CTL_CURVE
            IF CFG.PEN_PRESSURE_CURVE% < 25 THEN v! = 0 ELSE v! = LOG(CFG.PEN_PRESSURE_CURVE% / 25!) / LOG(16!)
    END SELECT
    IF v! < 0 THEN v! = 0
    IF v! > 1 THEN v! = 1
    PENP_slider_frac! = v!
END FUNCTION

SUB PENP_slider_set (ctl AS INTEGER, frac AS SINGLE)
    DIM f AS SINGLE
    f! = frac!
    IF f! < 0 THEN f! = 0
    IF f! > 1 THEN f! = 1
    SELECT CASE ctl%
        CASE PENP_CTL_SIZE:  CFG.PEN_MIN_SIZE% = INT(f! * 100 + 0.5)
        CASE PENP_CTL_OPAC:  CFG.PEN_MIN_OPACITY% = INT(f! * 100 + 0.5)
        CASE PENP_CTL_MIX:   CFG.PEN_MIX_MIN% = INT(f! * 100 + 0.5)
        CASE PENP_CTL_TIP:   CFG.PEN_TIP_THRESHOLD% = INT(f! * 50 + 0.5)
        CASE PENP_CTL_CURVE
            CFG.PEN_PRESSURE_CURVE% = INT(25 * 16 ^ f! + 0.5)
            ' Snap to linear near the middle so 1.00 is easy to hit.
            IF ABS(CFG.PEN_PRESSURE_CURVE% - 100) <= 4 THEN CFG.PEN_PRESSURE_CURVE% = 100
    END SELECT
END SUB

FUNCTION PENP_slider_text$ (ctl AS INTEGER)
    SELECT CASE ctl%
        CASE PENP_CTL_SIZE:  PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_MIN_SIZE%)) + "%"
        CASE PENP_CTL_OPAC:  PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_MIN_OPACITY%)) + "%"
        CASE PENP_CTL_MIX:   PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_MIX_MIN%)) + "%"
        CASE PENP_CTL_TIP:   PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_TIP_THRESHOLD%)) + "%"
        CASE PENP_CTL_CURVE: PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_PRESSURE_CURVE% \ 100)) + "." + RIGHT$("0" + _TRIM$(STR$(CFG.PEN_PRESSURE_CURVE% MOD 100)), 2)
    END SELECT
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_track_frac! — Native x -> 0..1 along the slider track (matches the
' fill/thumb geometry of FPANEL_track).
' ---------------------------------------------------------------------------
FUNCTION PENP_track_frac! (nx AS INTEGER)
    PENP_track_frac! = (nx% - PENP.trackX0% - 1) / (PENP.trackX1% - PENP.trackX0% - 1)
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_hit% — Control under a native panel point (PENP_CTL_*).
' Checkbox rows are clickable across the panel; sliders on (or just past)
' their track, with half the row gap of slack above and below.
' ---------------------------------------------------------------------------
FUNCTION PENP_hit% (nx AS INTEGER, ny AS INTEGER)
    PENP_hit% = PENP_CTL_NONE
    IF nx% < 2 OR nx% >= PENP.panelW% - 2 THEN EXIT FUNCTION
    DIM onTrack AS INTEGER, c AS INTEGER, y AS INTEGER, slack AS INTEGER
    onTrack% = (nx% >= PENP.trackX0% - 4 AND nx% <= PENP.trackX1% + 4)
    slack%   = FPANEL.gap% \ 2 + 1
    FOR c% = 1 TO PENP_CTL_COUNT
        y% = PENP_ctlY(c%)
        SELECT CASE c%
            CASE PENP_CTL_ON, PENP_CTL_SIZE_ON, PENP_CTL_OPAC_ON, PENP_CTL_MIX_ON
                IF ny% >= y% - 1 AND ny% < y% + FPANEL.fontH% + 1 THEN PENP_hit% = c%
            CASE ELSE
                IF onTrack% AND ny% >= y% - slack% AND ny% < y% + FPANEL.sliderH% + slack% THEN PENP_hit% = c%
        END SELECT
    NEXT c%
END FUNCTION

' ---------------------------------------------------------------------------
' Drawing helpers (into the panel image, native coords, FPANEL font).
' ---------------------------------------------------------------------------
SUB PENP_draw_checkbox (ctl AS INTEGER, checked AS INTEGER, label AS STRING, enabled AS INTEGER)
    FPANEL_checkbox FPANEL.pad%, PENP_ctlY(ctl%), checked%, label$, enabled%, PENP.hoverCtl% = ctl%
END SUB

SUB PENP_draw_slider (ctl AS INTEGER, labelX AS INTEGER, label AS STRING, enabled AS INTEGER)
    DIM fg AS _UNSIGNED LONG, y AS INTEGER, ty AS INTEGER
    IF enabled% THEN fg~& = THEME.CP_text~& ELSE fg~& = THEME.CP_text_dim~&
    y%  = PENP_ctlY(ctl%)
    ty% = y% + (FPANEL.sliderH% - FPANEL.fontH%) \ 2
    FPANEL_text labelX%, ty%, label$, fg~&
    FPANEL_track PENP.trackX0%, y%, PENP.trackX1% - PENP.trackX0% + 1, PENP_slider_frac!(ctl%), THEME.CP_text~&, enabled%
    FPANEL_text PENP.trackX1% + 6, ty%, PENP_slider_text$(ctl%), fg~&
END SUB

' ---------------------------------------------------------------------------
' PENP_render — Compose the panel; blit to screen 0.
' Called from SCREEN_render after CS3D_render (same z-tier).
' ---------------------------------------------------------------------------
SUB PENP_render ()
    IF NOT PENP.visible% THEN EXIT SUB
    IF PENP.autoHidden% THEN EXIT SUB

    PENP_ensure_initialized
    IF NOT PENP.positioned% THEN PENP_auto_position
    PENP_clamp_to_work_area
    REGION_set_bounds REGION_PEN_PANEL, PENP.dispX%, PENP.dispY%, PENP.dispW%, PENP.dispH%, _IIF(PENP.docked% <> 0, ZORDER_DOCKED_WINDOW, ZORDER_FLOATING)

    DIM penOn AS INTEGER, live AS INTEGER, src AS INTEGER
    DIM raw AS SINGLE, curved AS SINGLE, gamma AS SINGLE
    DIM status AS STRING
    penOn% = CFG.PEN_PRESSURE%
    live%  = penOn% _ANDALSO TABLET.ready
    IF live% THEN
        src% = PD_source%
        raw! = PD_raw_pressure!
        IF src% = PD_SRC_MOUSE THEN raw! = 0
    END IF
    gamma! = CFG.PEN_PRESSURE_CURVE% / 100!
    curved! = PD_curve!(raw!, gamma!)
    PENP.lastP! = raw!
    IF NOT penOn% THEN
        status$ = "PRESSURE IS OFF"
    ELSEIF NOT TABLET.ready THEN
        status$ = "NO PEN BACKEND"
    ELSE
        status$ = UCASE$(PD_backend_name$) + " - " + UCASE$(PD_source_name$(src%))
    END IF

    ' Hover: control / close box under the pointer (none while dragging)
    PENP.hoverCtl%   = PENP_CTL_NONE
    PENP.closeHover% = FALSE
    IF PENP_hit_window%(MOUSE.RAW_X%, MOUSE.RAW_Y%) _ANDALSO NOT PENP.dragging% _ANDALSO PENP.sliding% = PENP_CTL_NONE _ANDALSO PENP.renderScale! > 0 THEN
        DIM hx AS INTEGER, hy AS INTEGER
        hx% = INT((MOUSE.RAW_X% - PENP.dispX%) / PENP.renderScale!)
        hy% = INT((MOUSE.RAW_Y% - PENP.dispY%) / PENP.renderScale!)
        PENP.closeHover% = FPANEL_over_close%(hx%, hy%, PENP.panelW%)
        PENP.hoverCtl%   = PENP_hit%(hx%, hy%)
    END IF

    DIM oldDest AS LONG : oldDest& = _DEST
    _DEST PENP.panelImg&
    DIM oldFont AS LONG : oldFont& = FPANEL_begin&
    CLS , THEME.CP_bg~&
    FPANEL_title_bar PENP.panelW%, "PEN PRESSURE", PENP.closeHover%

    DIM pad AS INTEGER, f AS INTEGER, slH AS INTEGER
    pad% = FPANEL.pad% : f% = FPANEL.fontH% : slH% = FPANEL.sliderH%
    FPANEL_text pad%, PENP.yStatus%, LEFT$(status$, 32), THEME.CP_text_dim~&

    PENP_draw_checkbox PENP_CTL_ON, penOn%, "USE PEN PRESSURE", TRUE

    ' Live meter (a slider well, same span as the tracks' left edge to their
    ' right edge): raw pen pressure fills it, the value after the curve is the
    ' bright tick, the tip threshold the red mark.
    DIM mx0 AS INTEGER, mx1 AS INTEGER, mw AS INTEGER, my AS INTEGER
    mx0% = pad% : mx1% = PENP.trackX1% : mw% = mx1% - mx0% - 2 : my% = PENP.yMeter%
    LINE (mx0%, my%)-(mx1%, my% + slH% - 1), THEME.CP_slider_bg~&, BF
    LINE (mx0%, my%)-(mx1%, my% + slH% - 1), THEME.CP_slider_border~&, B
    IF raw! > 0 THEN LINE (mx0% + 1, my% + 1)-(mx0% + 1 + INT(raw! * mw%), my% + slH% - 2), THEME.CP_text_dim~&, BF
    IF CFG.PEN_TIP_THRESHOLD% > 0 THEN
        DIM tx AS INTEGER : tx% = mx0% + 1 + INT(CFG.PEN_TIP_THRESHOLD% / 100! * mw%)
        LINE (tx%, my% + 1)-(tx%, my% + slH% - 2), THEME.CP_close_fg~&
    END IF
    DIM cx AS INTEGER : cx% = mx0% + 1 + INT(curved! * mw%)
    LINE (cx% - 1, my% - 1)-(cx% + 1, my% + slH%), THEME.CP_text_bright~&, BF
    FPANEL_text PENP.trackX1% + 6, my% + (slH% - f%) \ 2, _TRIM$(STR$(INT(raw! * 100 + 0.5))) + "%", THEME.CP_text~&

    ' Size / opacity / mix: a checkbox and its lightest-touch slider each
    PENP_draw_checkbox PENP_CTL_SIZE_ON, CFG.PEN_PRESSURE_SIZE%, "SIZE BY PRESSURE", penOn%
    PENP_draw_slider PENP_CTL_SIZE, PENP.subX%, "LIGHT", penOn% _ANDALSO CFG.PEN_PRESSURE_SIZE%
    PENP_draw_checkbox PENP_CTL_OPAC_ON, CFG.PEN_PRESSURE_OPACITY%, "OPACITY BY PRESSURE", penOn%
    PENP_draw_slider PENP_CTL_OPAC, PENP.subX%, "LIGHT", penOn% _ANDALSO CFG.PEN_PRESSURE_OPACITY%
    PENP_draw_checkbox PENP_CTL_MIX_ON, CFG.PEN_PRESSURE_MIX%, "MIX PAINT BY PRESSURE", penOn%
    PENP_draw_slider PENP_CTL_MIX, PENP.subX%, "LIGHT", penOn% _ANDALSO CFG.PEN_PRESSURE_MIX%
    PENP_draw_slider PENP_CTL_CURVE, pad%, "CURVE", penOn%
    PENP_draw_slider PENP_CTL_TIP, pad%, "TIP", penOn%

    ' Response graph: pressure (x) -> value used (y), with the live point
    DIM gx0 AS INTEGER, gx1 AS INTEGER, gy0 AS INTEGER, gy1 AS INTEGER, gw AS INTEGER, gh AS INTEGER
    DIM i AS INTEGER, px AS INTEGER, py AS INTEGER, lx AS INTEGER, ly AS INTEGER
    gx0% = pad% : gx1% = PENP.panelW% - pad% - 1 : gw% = gx1% - gx0% - 2
    gy0% = PENP.yGraph% : gy1% = PENP.yGraph% + PENP_GRAPH_H - 1 : gh% = gy1% - gy0% - 2
    LINE (gx0%, gy0%)-(gx1%, gy1%), THEME.CP_slider_bg~&, BF
    LINE (gx0% + 1, gy1% - 1)-(gx1% - 1, gy0% + 1), THEME.CP_text_dim~&, , &HCCCC ' linear reference
    FOR i% = 0 TO gw%
        px% = gx0% + 1 + i%
        py% = gy1% - 1 - INT(PD_curve!(i% / gw%, gamma!) * gh% + 0.5)
        IF i% > 0 THEN LINE (lx%, ly%)-(px%, py%), THEME.CP_text~&
        lx% = px% : ly% = py%
    NEXT i%
    IF live% _ANDALSO src% <> PD_SRC_MOUSE THEN
        px% = gx0% + 1 + INT(raw! * gw%)
        py% = gy1% - 1 - INT(curved! * gh%)
        LINE (px% - 2, py% - 2)-(px% + 2, py% + 2), THEME.CP_text_bright~&, BF
    END IF
    LINE (gx0%, gy0%)-(gx1%, gy1%), THEME.CP_slider_border~&, B
    FPANEL_text gx0% + 3, gy0% + 3, "RESPONSE", THEME.CP_text_dim~&

    FPANEL_frame PENP.panelW%, PENP.panelH%
    _FONT oldFont&
    _DEST oldDest&

    ' (menus / popups open over it are drawn back on top: POPUP_reblit_to_screen0)

    DIM ts AS INTEGER, ds AS INTEGER
    ts% = USCALE.mixer%      : IF ts% < 1 THEN ts% = 1
    ds% = SCRN.displayScale% : IF ds% < 1 THEN ds% = 1
    DIM sx AS LONG, sy AS LONG, sw AS LONG, sh AS LONG
    sx& = CLNG(PENP.dispX%) * ds%
    sy& = CLNG(PENP.dispY%) * ds%
    sw& = CLNG(PENP.panelW%) * ts%
    sh& = CLNG(PENP.panelH%) * ts%
    DIM oldDest2 AS LONG : oldDest2& = _DEST
    _DEST 0
    _PUTIMAGE (sx&, sy&)-(sx& + sw& - 1, sy& + sh& - 1), PENP.panelImg&, 0
    _DEST oldDest2&
END SUB

' ---------------------------------------------------------------------------
' PENP_needs_redraw% — TRUE when the live meter is out of date (pen moving).
' ---------------------------------------------------------------------------
FUNCTION PENP_needs_redraw% ()
    PENP_needs_redraw% = FALSE
    IF NOT PENP.visible% OR PENP.autoHidden% THEN EXIT FUNCTION
    IF NOT CFG.PEN_PRESSURE% OR NOT TABLET.ready THEN EXIT FUNCTION
    DIM p AS SINGLE
    IF PD_source% <> PD_SRC_MOUSE THEN p! = PD_raw_pressure!
    PENP_needs_redraw% = (ABS(p! - PENP.lastP!) > 0.004)
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_mouse_input — Title-bar drag/close, checkboxes, slider drags.
' Called from MOUSE_handle_gui_panels when over the panel or a drag is active.
' ---------------------------------------------------------------------------
SUB PENP_mouse_input ()
    IF NOT PENP.visible% THEN EXIT SUB
    IF PENP.autoHidden% THEN EXIT SUB
    IF NOT PENP.initialized% THEN EXIT SUB

    DIM localX AS INTEGER, localY AS INTEGER
    localX% = MOUSE.RAW_X% - PENP.dispX%
    localY% = MOUSE.RAW_Y% - PENP.dispY%
    DIM nativeX AS INTEGER, nativeY AS INTEGER
    IF PENP.renderScale! > 0 THEN
        nativeX% = INT(localX% / PENP.renderScale!)
        nativeY% = INT(localY% / PENP.renderScale!)
    ELSE
        nativeX% = localX% : nativeY% = localY%
    END IF
    DIM justPressed AS INTEGER : justPressed% = (MOUSE.B1% AND NOT MOUSE.OLD_B1%)

    ' Active title-bar drag
    IF PENP.dragging% THEN
        IF MOUSE.B1% THEN
            DOCK_native_drag DP_PEN, MOUSE.RAW_X%, MOUSE.RAW_Y% ' over a dock target: preview
            DIM ppPrevX AS INTEGER, ppPrevY AS INTEGER
            ppPrevX% = PENP.dispX% : ppPrevY% = PENP.dispY%
            PENP.dispX% = PENP.dragStartDX% + (MOUSE.RAW_X% - PENP.dragStartMX%)
            PENP.dispY% = PENP.dragStartDY% + (MOUSE.RAW_Y% - PENP.dragStartMY%)
            PENP_clamp_to_work_area
            FPANEL_place REGION_PEN_PANEL, PENP.dispX%, PENP.dispY%, PENP.dispW%, PENP.dispH%, ppPrevX%, ppPrevY%
            PENP_clamp_to_work_area
        ELSE
            IF DOCK_native_drag_end%(DP_PEN) THEN PENP.dragging% = FALSE: EXIT SUB ' docked
            PENP.dragging% = FALSE
            CONFIG_save
        END IF
        CFG.PEN_PANEL_X% = PENP.dispX%
        CFG.PEN_PANEL_Y% = PENP.dispY%
        SCENE_DIRTY%     = TRUE : FRAME_IDLE% = FALSE
        EXIT SUB
    END IF

    ' Active slider drag
    IF PENP.sliding% <> PENP_CTL_NONE THEN
        IF MOUSE.B1% THEN
            PENP_slider_set PENP.sliding%, PENP_track_frac!(nativeX%)
        ELSE
            PENP.sliding% = PENP_CTL_NONE
            CONFIG_save
        END IF
        SCENE_DIRTY% = TRUE : FRAME_IDLE% = FALSE
        EXIT SUB
    END IF

    IF NOT justPressed% THEN EXIT SUB
    IF localX% < 0 OR localX% >= PENP.dispW% OR localY% < 0 OR localY% >= PENP.dispH% THEN EXIT SUB

    ' Title bar: close button, else start a drag
    IF nativeY% < FPANEL.titleH% THEN
        IF FPANEL_over_close%(nativeX%, nativeY%, PENP.panelW%) THEN
            PENP_toggle
            CONFIG_save
            EXIT SUB
        END IF
        PENP.dragging%    = LAYOUT_unlocked% ' Lock Layout: no move / resize
        PENP.dragStartMX% = MOUSE.RAW_X%
        PENP.dragStartMY% = MOUSE.RAW_Y%
        PENP.dragStartDX% = PENP.dispX%
        PENP.dragStartDY% = PENP.dispY%
        EXIT SUB
    END IF

    DIM ctl AS INTEGER
    ctl% = PENP_hit%(nativeX%, nativeY%)
    SELECT CASE ctl%
        CASE PENP_CTL_ON:      CFG.PEN_PRESSURE% = NOT CFG.PEN_PRESSURE% : CONFIG_save
        CASE PENP_CTL_SIZE_ON: CFG.PEN_PRESSURE_SIZE% = NOT CFG.PEN_PRESSURE_SIZE% : CONFIG_save
        CASE PENP_CTL_OPAC_ON: CFG.PEN_PRESSURE_OPACITY% = NOT CFG.PEN_PRESSURE_OPACITY% : CONFIG_save
        CASE PENP_CTL_MIX_ON:  CFG.PEN_PRESSURE_MIX% = NOT CFG.PEN_PRESSURE_MIX% : CONFIG_save
        CASE PENP_CTL_SIZE, PENP_CTL_OPAC, PENP_CTL_MIX, PENP_CTL_CURVE, PENP_CTL_TIP
            PENP.sliding% = ctl%
            PENP_slider_set ctl%, PENP_track_frac!(nativeX%)
    END SELECT
    IF ctl% <> PENP_CTL_NONE THEN SCENE_DIRTY% = TRUE : FRAME_IDLE% = FALSE
END SUB
