''
' DRAW - GUI/PEN-PANEL.BM
' =============================================================================
' Pen Control panel implementation (was Pen Pressure). See GUI/PEN-PANEL.BI.
' Renders to screen 0 at integer toolbar scale (same model as COLOR-SPACE-3D);
' font, title bar and controls come from GUI/FLOAT-PANEL (Color Mixer look).
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

OPTION _EXPLICIT
OPTION _EXPLICITARRAY

' ---------------------------------------------------------------------------
' PENP_init — Defaults + config-driven initial visibility. Lazy buffer init.
' ---------------------------------------------------------------------------
SUB PENP_init ()
    PENP.visible%     = FALSE
    PENP.positioned%  = FALSE
    PENP.initialized% = FALSE
    PENP.autoHidden%  = FALSE
    PENP.renderScale! = 1.0
    PENP.panelImg&    = 0
    PENP.dragging%    = FALSE
    PENP.sliding%     = PENP_CTL_NONE
    PENP.hoverCtl%    = PENP_CTL_NONE
    PENP.closeHover%  = FALSE
    PENP.lastP!       = -1
    IF CFG.PEN_PANEL_VISIBLE% THEN PENP.visible% = TRUE
END SUB

' ---------------------------------------------------------------------------
' PENP_ensure_initialized — layout + panel buffer, restored position.
' ---------------------------------------------------------------------------
SUB PENP_ensure_initialized ()
    IF PENP.initialized% THEN EXIT SUB
    PENP_layout
    IF PENP.panelImg& < -1 THEN _FREEIMAGE PENP.panelImg&
    PENP.panelImg& = _NEWIMAGE(PENP.panelW%, PENP.panelH%, 32)

    PENP_compute_display_size
    IF CFG.PEN_PANEL_X% > -1 AND CFG.PEN_PANEL_Y% > -1 THEN
        PENP.dispX%      = CFG.PEN_PANEL_X%
        PENP.dispY%      = CFG.PEN_PANEL_Y%
        PENP.positioned% = TRUE
    END IF
    PENP.initialized% = TRUE
END SUB

' ---------------------------------------------------------------------------
' PENP_layout — Row tops and slider track span from the Color Mixer font
' metrics (FPANEL), spaced like the mixer's slider rows and sections:
'   status / USE PEN PRESSURE + meter / three checkbox + LIGHT slider pairs /
'   CURVE + TIP / response graph.
' ---------------------------------------------------------------------------
SUB PENP_layout ()
    FPANEL_ensure
    PENP.natW% = FPANEL_panel_w%
    PENP.panelW% = FPANEL_fit_size%(PENP.natW%, PENP.fitW%) ' docked: the slot's width (the tracks stretch)
    DIM f AS INTEGER, g AS INTEGER, sec AS INTEGER, sh AS INTEGER, y AS INTEGER
    f%   = FPANEL.fontH%
    g%   = FPANEL.gap%
    sec% = FPANEL.section%
    sh%  = FPANEL.sliderH%

    y% = FPANEL.titleH% + FPANEL.pad%
    PENP.yStatus% = y%                    : y% = y% + f% + sec%
    PENP_ctlY(PENP_CTL_ON) = y%           : y% = y% + f% + g%
    PENP.yMeter% = y%                     : y% = y% + sh% + sec% + g%
    PENP_ctlY(PENP_CTL_SIZE_ON) = y%      : y% = y% + f% + g%
    PENP_ctlY(PENP_CTL_SIZE) = y%         : y% = y% + sh% + sec%
    PENP_ctlY(PENP_CTL_OPAC_ON) = y%      : y% = y% + f% + g%
    PENP_ctlY(PENP_CTL_OPAC) = y%         : y% = y% + sh% + sec%
    PENP_ctlY(PENP_CTL_MIX_ON) = y%       : y% = y% + f% + g%
    PENP_ctlY(PENP_CTL_MIX) = y%          : y% = y% + sh% + sec% + g%
    PENP_ctlY(PENP_CTL_CURVE) = y%        : y% = y% + sh% + g%
    PENP_ctlY(PENP_CTL_TIP) = y%          : y% = y% + sh% + sec% + g%
    PENP.yGraph% = y%                     : y% = y% + PENP_GRAPH_H + FPANEL.pad%
    PENP.natH% = y%
    ' docked with height to spare: the response graph takes it
    PENP.graphH% = PENP_GRAPH_H + _MAX(0, PENP.fitH% - PENP.natH%)
    IF PENP.graphH% > PENP_graph_max_h%(PENP.panelW%) THEN PENP.graphH% = _MAX(PENP_GRAPH_H, PENP_graph_max_h%(PENP.panelW%))
    PENP.panelH% = PENP.natH% + PENP.graphH% - PENP_GRAPH_H

    ' Track span: after the widest label (sub-slider labels sit under their
    ' checkbox's text), before a value column wide enough for "100%".
    DIM oldDest AS LONG : oldDest& = _DEST
    DIM probe   AS LONG : probe& = _NEWIMAGE(8, 8, 32)
    _DEST probe&
    DIM oldFont AS LONG : oldFont& = FPANEL_begin&
    DIM bs      AS INTEGER : bs% = FPANEL.fontH% - 1
    IF bs% < 7 THEN bs% = 7
    PENP.subX% = FPANEL.pad% + bs% + 4
    DIM lw AS INTEGER : lw% = PENP.subX% + _UPRINTWIDTH("LIGHT")
    IF FPANEL.pad% + _UPRINTWIDTH("CURVE") > lw% THEN lw% = FPANEL.pad% + _UPRINTWIDTH("CURVE")
    ' (SMOOTHING / SPEED sub-slider labels, under their checkbox too)
    lw% = _MAX(lw%, PENP.subX% + _MAX(_UPRINTWIDTH("AMOUNT"), _UPRINTWIDTH("SMOOTH")))
    PENP.tabH% = _MIN(f% + 3, f% + sec%)
    PENP.trackX0% = lw% + 6
    PENP.trackX1% = PENP.panelW% - FPANEL.pad% - _UPRINTWIDTH("100%") - 6
    DIM valW AS INTEGER: valW% = _UPRINTWIDTH("100%") + 6
    _FONT oldFont&
    _DEST oldDest&
    _FREEIMAGE probe&

    DIM c AS INTEGER, k AS INTEGER, colW AS INTEGER, x0 AS INTEGER, y0 AS INTEGER, gw AS INTEGER, avail AS INTEGER
    PENP.inRow% = DOCK_in_row%(DP_PEN)
    IF PENP.inRow% = 0 THEN ' one column across the panel
        FOR c% = 1 TO PENP_CTL_COUNT
            PENP_ctlX0(c%) = FPANEL.pad%: PENP_ctlX1(c%) = PENP.panelW% - FPANEL.pad% - 1
            PENP_ctlTX0(c%) = PENP.trackX0%: PENP_ctlTX1(c%) = PENP.trackX1%
        NEXT c%
        PENP.gx0% = FPANEL.pad%: PENP.gx1% = PENP.panelW% - FPANEL.pad% - 1
        PENP_layout_tabs
        EXIT SUB
    END IF
    ' In a row: USE + meter | SIZE | OPACITY | MIX | CURVE + TIP | the graph,
    ' side by side, every group from the top; the graph as tall as the panel
    y0% = FPANEL.titleH% + FPANEL.pad%
    PENP.yStatus% = y0%
    PENP_ctlY(PENP_CTL_ON) = y0% + f% + sec%
    PENP.yMeter% = PENP_ctlY(PENP_CTL_ON) + f% + g%
    PENP_ctlY(PENP_CTL_SIZE_ON) = y0%: PENP_ctlY(PENP_CTL_SIZE) = y0% + f% + g%
    PENP_ctlY(PENP_CTL_OPAC_ON) = y0%: PENP_ctlY(PENP_CTL_OPAC) = y0% + f% + g%
    PENP_ctlY(PENP_CTL_MIX_ON) = y0%: PENP_ctlY(PENP_CTL_MIX) = y0% + f% + g%
    PENP_ctlY(PENP_CTL_CURVE) = y0%: PENP_ctlY(PENP_CTL_TIP) = y0% + sh% + g% + g%
    PENP.natH% = PENP_row_h%
    PENP.panelH% = _MAX(PENP.natH%, PENP.fitH%)
    PENP.yGraph% = y0%
    PENP.graphH% = PENP.panelH% - y0% - FPANEL.pad%
    gw% = _MAX(PENP.graphH%, 48)
    PENP.panelW% = _MAX(PENP.fitW%, PENP_row_w%(PENP.panelH%, PENP_ROW_COL_MIN))
    ' a row narrower than that (between side docks - Rick's Tablet workspace:
    ' 504 px for 520): the slot's width all the same, the columns narrower - the
    ' window overflowing its slot covered the bars beside it
    IF PENP.fitW% > 0 _ANDALSO PENP.fitW% < PENP.panelW% THEN PENP.panelW% = _MAX(PENP.fitW%, PENP_row_w%(PENP.panelH%, 24))
    avail% = PENP.panelW% - 2 * FPANEL.pad% - gw% - PENP_ROW_GAP
    colW% = (avail% - 4 * PENP_ROW_GAP) \ 5
    PENP.colW% = colW%
    PENP.gx1% = PENP.panelW% - FPANEL.pad% - 1: PENP.gx0% = PENP.gx1% - gw% + 1
    FOR c% = 1 TO PENP_CTL_COUNT
        SELECT CASE c%
            CASE PENP_CTL_ON, PENP_CTL_TABS, PENP_CTL_STAB_ON, PENP_CTL_STAB_MODE, PENP_CTL_SPD_ON: k% = 0
            CASE PENP_CTL_SIZE_ON, PENP_CTL_SIZE, PENP_CTL_STAB_AMT, PENP_CTL_CATCH, PENP_CTL_SPD_SLOW, PENP_CTL_SPD_FAST: k% = 1
            CASE PENP_CTL_OPAC_ON, PENP_CTL_OPAC, PENP_CTL_GUIDE_LN, PENP_CTL_GUIDE_CUR, PENP_CTL_SPD_AT, PENP_CTL_SPD_SMOOTH: k% = 2
            CASE PENP_CTL_MIX_ON, PENP_CTL_MIX, PENP_CTL_PROC_ON, PENP_CTL_PROC_MODE: k% = 3
            CASE ELSE: k% = 4
        END SELECT
        x0% = FPANEL.pad% + k% * (colW% + PENP_ROW_GAP)
        PENP_ctlX0(c%) = x0%: PENP_ctlX1(c%) = x0% + colW% - 1
        PENP_ctlTX0(c%) = x0% + (PENP.trackX0% - FPANEL.pad%)
        PENP_ctlTX1(c%) = x0% + colW% - 1 - valW%
        IF PENP_ctlTX1(c%) < PENP_ctlTX0(c%) + 16 THEN PENP_ctlTX1(c%) = PENP_ctlTX0(c%) + 16
    NEXT c%
    PENP_layout_tabs
END SUB

' ---------------------------------------------------------------------------
' PENP_layout_tabs — The tab strip (in the status row) and the SMOOTHING /
' SPEED tabs' rows, after PENP_layout placed the PRESSURE tab. They fit in
' the PRESSURE tab's height, so switching tabs never resizes the panel:
'   one column:  SMOOTHING  SMOOTH POSITION / mode / AMOUNT / CATCH UP /
'                           GUIDE LINE / GUIDE CURSOR / SMOOTH PRESSURE /
'                           mode / AMOUNT / the mode hint below
'                SPEED      SPEED SCALING / SLOW / FAST / SPEED / SMOOTH /
'                           NOW AVG TOP / the speed -> gain graph below
'   in a row:    the same groups in PENP_layout's five columns (column 0
'                under the tab strip), the hint / graph in the graph column
' ---------------------------------------------------------------------------
SUB PENP_layout_tabs ()
    DIM f AS INTEGER, g AS INTEGER, sec AS INTEGER, sh AS INTEGER, y AS INTEGER, c AS INTEGER
    DIM y0 AS INTEGER, r2 AS INTEGER, rc AS INTEGER
    f% = FPANEL.fontH%: g% = FPANEL.gap%: sec% = FPANEL.section%: sh% = FPANEL.sliderH%
    FOR c% = 1 TO PENP_CTL_COUNT
        SELECT CASE c%
            CASE PENP_CTL_STAB_ON TO PENP_CTL_PROC_AMT: PENP_ctlTab(c%) = PENP_TAB_SMOOTH
            CASE PENP_CTL_SPD_ON TO PENP_CTL_SPD_SMOOTH: PENP_ctlTab(c%) = PENP_TAB_SPEED
            CASE PENP_CTL_TABS: PENP_ctlTab(c%) = -1
            CASE ELSE: PENP_ctlTab(c%) = PENP_TAB_PRESSURE
        END SELECT
    NEXT c%
    PENP_ctlY(PENP_CTL_TABS) = PENP.yStatus%
    IF PENP.inRow% = 0 THEN
        y% = PENP_ctlY(PENP_CTL_ON)
        PENP_ctlY(PENP_CTL_STAB_ON) = y%   : y% = y% + f% + g%
        PENP_ctlY(PENP_CTL_STAB_MODE) = y% : y% = y% + sh% + g%
        PENP_ctlY(PENP_CTL_STAB_AMT) = y%  : y% = y% + sh% + sec%
        PENP_ctlY(PENP_CTL_CATCH) = y%     : y% = y% + f% + g%
        PENP_ctlY(PENP_CTL_GUIDE_LN) = y%  : y% = y% + f% + g%
        PENP_ctlY(PENP_CTL_GUIDE_CUR) = y% : y% = y% + f% + sec% + g%
        PENP_ctlY(PENP_CTL_PROC_ON) = y%   : y% = y% + f% + g%
        PENP_ctlY(PENP_CTL_PROC_MODE) = y% : y% = y% + sh% + g%
        PENP_ctlY(PENP_CTL_PROC_AMT) = y%  : y% = y% + sh% + sec% + g%
        PENP.hbx0% = FPANEL.pad%: PENP.hbx1% = PENP.panelW% - FPANEL.pad% - 1
        PENP.hby0% = y%: PENP.hby1% = PENP.panelH% - FPANEL.pad% - 1
        y% = PENP_ctlY(PENP_CTL_ON)
        PENP_ctlY(PENP_CTL_SPD_ON) = y%     : y% = y% + f% + g%
        PENP_ctlY(PENP_CTL_SPD_SLOW) = y%   : y% = y% + sh% + g%
        PENP_ctlY(PENP_CTL_SPD_FAST) = y%   : y% = y% + sh% + g%
        PENP_ctlY(PENP_CTL_SPD_AT) = y%     : y% = y% + sh% + g%
        PENP_ctlY(PENP_CTL_SPD_SMOOTH) = y% : y% = y% + sh% + sec%
        PENP.rdX% = FPANEL.pad%: PENP.rdX1% = PENP.panelW% - FPANEL.pad% - 1
        PENP.rdY% = y%                      : y% = y% + f% + g%
        PENP.sgx0% = PENP.gx0%: PENP.sgx1% = PENP.gx1%
        PENP.sgy0% = y%: PENP.sgy1% = PENP.panelH% - FPANEL.pad% - 1
        EXIT SUB
    END IF
    ' in a row: column 0 = the tab strip, a checkbox, then the meter's slot;
    ' the others a slider / checkbox at the top and one under it
    y0% = PENP.yStatus%
    r2% = y0% + sh% + g% + g% ' (under a slider: TIP's place)
    rc% = y0% + f% + g% '       (under a checkbox: a LIGHT slider's place)
    PENP_ctlY(PENP_CTL_STAB_ON) = PENP_ctlY(PENP_CTL_ON): PENP_ctlY(PENP_CTL_STAB_MODE) = PENP.yMeter%
    PENP_ctlY(PENP_CTL_STAB_AMT) = y0%: PENP_ctlY(PENP_CTL_CATCH) = r2%
    PENP_ctlY(PENP_CTL_GUIDE_LN) = y0%: PENP_ctlY(PENP_CTL_GUIDE_CUR) = rc%
    PENP_ctlY(PENP_CTL_PROC_ON) = y0%: PENP_ctlY(PENP_CTL_PROC_MODE) = rc%
    PENP_ctlY(PENP_CTL_PROC_AMT) = y0%
    PENP.hbx0% = PENP.gx0%: PENP.hbx1% = PENP.gx1%
    PENP.hby0% = PENP.yGraph%: PENP.hby1% = PENP.yGraph% + PENP.graphH% - 1
    PENP_ctlY(PENP_CTL_SPD_ON) = PENP_ctlY(PENP_CTL_ON)
    PENP_ctlY(PENP_CTL_SPD_SLOW) = y0%: PENP_ctlY(PENP_CTL_SPD_FAST) = r2%
    PENP_ctlY(PENP_CTL_SPD_AT) = y0%: PENP_ctlY(PENP_CTL_SPD_SMOOTH) = r2%
    PENP.rdX% = FPANEL.pad% + 3 * (PENP.colW% + PENP_ROW_GAP): PENP.rdX1% = PENP.gx0% - PENP_ROW_GAP
    PENP.rdY% = y0%
    PENP.sgx0% = PENP.gx0%: PENP.sgx1% = PENP.gx1%
    PENP.sgy0% = PENP.yGraph%: PENP.sgy1% = PENP.yGraph% + PENP.graphH% - 1
END SUB

' ---------------------------------------------------------------------------
' PENP_row_h% / PENP_row_w% — In a top / bottom row (native px): the height of
' its tallest group (USE: the status, the checkbox, the meter); the width of
' five group columns colW wide and the graph square at height h.
' ---------------------------------------------------------------------------
FUNCTION PENP_row_h% ()
    FPANEL_ensure
    DIM h AS INTEGER
    h = (FPANEL.fontH% + FPANEL.section%) + (FPANEL.fontH% + FPANEL.gap%) + FPANEL.sliderH% ' USE: status, checkbox, meter
    h = _MAX(h, 2 * FPANEL.sliderH% + 2 * FPANEL.gap%) '                                   CURVE + TIP
    PENP_row_h% = FPANEL.titleH% + 2 * FPANEL.pad% + h
END FUNCTION

FUNCTION PENP_row_w% (h AS INTEGER, colW AS INTEGER)
    DIM gw AS INTEGER
    FPANEL_ensure
    gw = _MAX(h - FPANEL.titleH% - 2 * FPANEL.pad%, 48)
    PENP_row_w% = 2 * FPANEL.pad% + 5 * colW + 4 * PENP_ROW_GAP + PENP_ROW_GAP + gw
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_graph_max_h% — Tallest the response graph gets in a panel nw native px
' wide: square (it plots 0..1 against 0..1).
' ---------------------------------------------------------------------------
FUNCTION PENP_graph_max_h% (nw AS INTEGER)
    PENP_graph_max_h% = _MAX(nw, FPANEL_panel_w%) - 2 * FPANEL.pad%
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_fit — Docked: lay out to nw x nh native px (0 = natural).
' ---------------------------------------------------------------------------
SUB PENP_fit (nw AS INTEGER, nh AS INTEGER)
    IF nw = PENP.fitW% _ANDALSO nh = PENP.fitH% _ANDALSO (DOCK_in_row%(DP_PEN) <> 0) = (PENP.inRow% <> 0) THEN EXIT SUB
    PENP.fitW% = nw : PENP.fitH% = nh
    IF PENP.initialized% = 0 THEN EXIT SUB ' PENP_ensure_initialized lays it out
    DIM oldW AS INTEGER, oldH AS INTEGER
    oldW% = PENP.panelW% : oldH% = PENP.panelH%
    PENP_layout
    IF PENP.panelW% <> oldW% _ORELSE PENP.panelH% <> oldH% _ORELSE PENP.panelImg& >= -1 THEN
        IF PENP.panelImg& < -1 THEN _FREEIMAGE PENP.panelImg&
        PENP.panelImg& = _NEWIMAGE(PENP.panelW%, PENP.panelH%, 32)
    END IF
    PENP_compute_display_size
END SUB

' ---------------------------------------------------------------------------
' PENP_reset — Reset transient state after a document load.
' ---------------------------------------------------------------------------
SUB PENP_reset ()
    PENP.autoHidden% = FALSE
    PENP.dragging%   = FALSE
    PENP.sliding%    = PENP_CTL_NONE
    PENP.hoverCtl%   = PENP_CTL_NONE
END SUB

' ---------------------------------------------------------------------------
' PENP_toggle — Show/hide the panel (auto-place on first open).
' ---------------------------------------------------------------------------
SUB PENP_toggle ()
    IF PENP.visible% THEN
        PENP.visible% = FALSE
    ELSE
        PENP.visible%    = TRUE
        PENP.autoHidden% = FALSE
        PENP_ensure_initialized
        IF NOT PENP.positioned% THEN PENP_auto_position
        ' Open beside, not on top of, any other floating window
        FPANEL_place REGION_PEN_PANEL, PENP.dispX%, PENP.dispY%, PENP.dispW%, PENP.dispH%, PENP.dispX%, PENP.dispY%
        CFG.PEN_PANEL_X% = PENP.dispX%
        CFG.PEN_PANEL_Y% = PENP.dispY%
    END IF
    CFG.PEN_PANEL_VISIBLE% = PENP.visible%
    SCENE_DIRTY%           = TRUE
    FRAME_IDLE%            = FALSE
END SUB

' ---------------------------------------------------------------------------
' PENP_compute_display_size — native -> viewport footprint (ts/ds scale).
' ---------------------------------------------------------------------------
SUB PENP_compute_display_size ()
    DIM ts AS INTEGER, ds AS INTEGER
    ts%               = FPANEL_scale%(DP_PEN)      : IF ts% < 1 THEN ts% = 1
    ds%               = SCRN.displayScale% : IF ds% < 1 THEN ds% = 1
    PENP.renderScale! = CSNG(ts%) / CSNG(ds%)
    PENP.dispW%       = INT(CSNG(PENP.panelW%) * CSNG(ts%) / CSNG(ds%) + 0.5)
    PENP.dispH%       = INT(CSNG(PENP.panelH%) * CSNG(ts%) / CSNG(ds%) + 0.5)
END SUB

' ---------------------------------------------------------------------------
' PENP_auto_position — top-left of the work area.
' ---------------------------------------------------------------------------
SUB PENP_auto_position ()
    PENP_ensure_initialized
    DIM pad  AS INTEGER : pad% = 8
    DIM minY AS INTEGER, maxY AS INTEGER
    CS3D_work_area minY%, maxY%
    PENP.dispX%       = SCRN.uiLeftEdge% + pad%
    PENP.dispY%       = minY% + pad%
    PENP.positioned%  = TRUE
    CFG.PEN_PANEL_X%  = PENP.dispX%
    CFG.PEN_PANEL_Y%  = PENP.dispY%
END SUB

' ---------------------------------------------------------------------------
' PENP_clamp_to_work_area — Keep the panel (at least its title bar) on screen.
' ---------------------------------------------------------------------------
SUB PENP_clamp_to_work_area ()
    IF NOT PENP.initialized% THEN EXIT SUB
    IF PENP.docked% THEN EXIT SUB ' the dock slot places it
    DIM minX AS INTEGER, maxX AS INTEGER, minY AS INTEGER, maxY AS INTEGER
    minX% = SCRN.uiLeftEdge%
    maxX% = SCRN.uiRightEdge%
    CS3D_work_area minY%, maxY%
    DIM lx AS LONG, ly AS LONG
    lx = PENP.dispX%: ly = PENP.dispY%
    LAY_clamp lx, ly, CLNG(PENP.dispW%), CLNG(PENP.dispH%), CLNG(minX%), CLNG(minY%), CLNG(maxX%), CLNG(maxY%)
    PENP.dispX% = lx: PENP.dispY% = ly
END SUB

' ---------------------------------------------------------------------------
' PENP_hit_window% / PENP_active_hit% — Is the viewport pixel on the panel?
' ---------------------------------------------------------------------------
FUNCTION PENP_hit_window% (rawX AS INTEGER, rawY AS INTEGER)
    IF DOCK_native_off%(DP_PEN) THEN EXIT FUNCTION ' docked in a slot that shows nothing this frame
    PENP_hit_window% = FALSE
    IF NOT PENP.initialized% THEN EXIT FUNCTION
    IF rawX% >= PENP.dispX% AND rawX% < PENP.dispX% + PENP.dispW% THEN
        IF rawY% >= PENP.dispY% AND rawY% < PENP.dispY% + PENP.dispH% THEN PENP_hit_window% = TRUE
    END IF
END FUNCTION

FUNCTION PENP_active_hit% (rawX AS INTEGER, rawY AS INTEGER)
    PENP_active_hit% = FALSE
    IF NOT PENP.visible% THEN EXIT FUNCTION
    IF PENP.autoHidden% THEN EXIT FUNCTION
    PENP_active_hit% = PENP_hit_window%(rawX%, rawY%)
END FUNCTION

' ---------------------------------------------------------------------------
' Slider value <-> track position. The curve slider is logarithmic (25..400,
' 100 = linear in the middle); the others are linear 0..100 %.
' ---------------------------------------------------------------------------
FUNCTION PENP_slider_frac! (ctl AS INTEGER)
    DIM v AS SINGLE
    SELECT CASE ctl%
        CASE PENP_CTL_SIZE:  v! = CFG.PEN_MIN_SIZE% / 100!
        CASE PENP_CTL_OPAC:  v! = CFG.PEN_MIN_OPACITY% / 100!
        CASE PENP_CTL_MIX:   v! = CFG.PEN_MIX_MIN% / 100!
        CASE PENP_CTL_TIP:   v! = CFG.PEN_TIP_THRESHOLD% / 50!
        CASE PENP_CTL_CURVE
            IF CFG.PEN_PRESSURE_CURVE% < 25 THEN v! = 0 ELSE v! = LOG(CFG.PEN_PRESSURE_CURVE% / 25!) / LOG(16!)
        CASE PENP_CTL_STAB_AMT:   v! = CFG.PEN_STAB_AMOUNT% / 100!
        CASE PENP_CTL_PROC_AMT:   v! = CFG.PEN_PROC_AMOUNT% / 100!
        CASE PENP_CTL_SPD_SLOW:   v! = (CFG.PEN_SPEED_SLOW% - 10) / 90!
        CASE PENP_CTL_SPD_FAST:   v! = (CFG.PEN_SPEED_FAST% - 100) / 400!
        CASE PENP_CTL_SPD_AT:     v! = (CFG.PEN_SPEED_FAST_AT% - 50) / 2950!
        CASE PENP_CTL_SPD_SMOOTH: v! = CFG.PEN_SPEED_SMOOTH% / 100!
    END SELECT
    IF v! < 0 THEN v! = 0
    IF v! > 1 THEN v! = 1
    PENP_slider_frac! = v!
END FUNCTION

SUB PENP_slider_set (ctl AS INTEGER, frac AS SINGLE)
    DIM f AS SINGLE
    f! = frac!
    IF f! < 0 THEN f! = 0
    IF f! > 1 THEN f! = 1
    SELECT CASE ctl%
        CASE PENP_CTL_SIZE:  CFG.PEN_MIN_SIZE% = INT(f! * 100 + 0.5)
        CASE PENP_CTL_OPAC:  CFG.PEN_MIN_OPACITY% = INT(f! * 100 + 0.5)
        CASE PENP_CTL_MIX:   CFG.PEN_MIX_MIN% = INT(f! * 100 + 0.5)
        CASE PENP_CTL_TIP:   CFG.PEN_TIP_THRESHOLD% = INT(f! * 50 + 0.5)
        CASE PENP_CTL_CURVE
            CFG.PEN_PRESSURE_CURVE% = INT(25 * 16 ^ f! + 0.5)
            ' Snap to linear near the middle so 1.00 is easy to hit.
            IF ABS(CFG.PEN_PRESSURE_CURVE% - 100) <= 4 THEN CFG.PEN_PRESSURE_CURVE% = 100
        CASE PENP_CTL_STAB_AMT:   CFG.PEN_STAB_AMOUNT% = INT(f! * 100 + 0.5)
        CASE PENP_CTL_PROC_AMT:   CFG.PEN_PROC_AMOUNT% = INT(f! * 100 + 0.5)
        CASE PENP_CTL_SPD_SLOW:   CFG.PEN_SPEED_SLOW% = 10 + INT(f! * 90 + 0.5)
        CASE PENP_CTL_SPD_FAST
            CFG.PEN_SPEED_FAST% = 100 + INT(f! * 400 + 0.5)
        CASE PENP_CTL_SPD_AT:     CFG.PEN_SPEED_FAST_AT% = 50 + 10 * INT(f! * 295 + 0.5)
        CASE PENP_CTL_SPD_SMOOTH: CFG.PEN_SPEED_SMOOTH% = INT(f! * 100 + 0.5)
    END SELECT
END SUB

''
' A slider's value through the universal value input (VAL_apply%: op
' VAL_OP_NUDGE by d units, VAL_OP_RESET to the factory default). TRUE = it changed.
'
FUNCTION PENP_slider_val% (ctl AS INTEGER, op AS INTEGER, d AS INTEGER)
    DIM r AS INTEGER
    SELECT CASE ctl%
        CASE PENP_CTL_SIZE:       r = VAL_apply%(CFG.PEN_MIN_SIZE%, op, d, 0, 100)
        CASE PENP_CTL_OPAC:       r = VAL_apply%(CFG.PEN_MIN_OPACITY%, op, d, 0, 100)
        CASE PENP_CTL_MIX:        r = VAL_apply%(CFG.PEN_MIX_MIN%, op, d, 0, 100)
        CASE PENP_CTL_TIP:        r = VAL_apply%(CFG.PEN_TIP_THRESHOLD%, op, d, 0, 50)
        CASE PENP_CTL_CURVE:      r = VAL_apply%(CFG.PEN_PRESSURE_CURVE%, op, d, 25, 400)
        CASE PENP_CTL_STAB_AMT:   r = VAL_apply%(CFG.PEN_STAB_AMOUNT%, op, d, 0, 100)
        CASE PENP_CTL_PROC_AMT:   r = VAL_apply%(CFG.PEN_PROC_AMOUNT%, op, d, 0, 100)
        CASE PENP_CTL_SPD_SLOW:   r = VAL_apply%(CFG.PEN_SPEED_SLOW%, op, d, 10, 100)
        CASE PENP_CTL_SPD_FAST:   r = VAL_apply%(CFG.PEN_SPEED_FAST%, op, d, 100, 500)
        CASE PENP_CTL_SPD_AT:     r = VAL_apply%(CFG.PEN_SPEED_FAST_AT%, op, d * 10, 50, 3000)
        CASE PENP_CTL_SPD_SMOOTH: r = VAL_apply%(CFG.PEN_SPEED_SMOOTH%, op, d, 0, 100)
    END SELECT
    PENP_slider_val% = r
END FUNCTION

''
' TRUE for the slider controls (PENP_slider_val% knows them).
'
FUNCTION PENP_is_slider% (ctl AS INTEGER)
    SELECT CASE ctl%
        CASE PENP_CTL_SIZE, PENP_CTL_OPAC, PENP_CTL_MIX, PENP_CTL_TIP, PENP_CTL_CURVE, PENP_CTL_STAB_AMT, PENP_CTL_PROC_AMT, PENP_CTL_SPD_SLOW, PENP_CTL_SPD_FAST, PENP_CTL_SPD_AT, PENP_CTL_SPD_SMOOTH
            PENP_is_slider% = TRUE
    END SELECT
END FUNCTION

''
' The control under the pointer (PENP_hit% in its own units), or PENP_CTL_NONE
' off the panel / on its title.
'
FUNCTION PENP_ctl_at_pointer% ()
    DIM lx AS INTEGER, ly AS INTEGER, nx AS INTEGER, ny AS INTEGER
    lx = MOUSE.RAW_X% - PENP.dispX%: ly = MOUSE.RAW_Y% - PENP.dispY%
    IF lx < 0 _ORELSE ly < 0 _ORELSE lx >= PENP.dispW% _ORELSE ly >= PENP.dispH% THEN EXIT FUNCTION
    IF PENP.renderScale! > 0 THEN nx = INT(lx / PENP.renderScale!): ny = INT(ly / PENP.renderScale!) ELSE nx = lx: ny = ly
    IF ny < FPANEL.titleH% THEN EXIT FUNCTION
    PENP_ctl_at_pointer% = PENP_hit%(nx, ny)
END FUNCTION

''
' The wheel over the panel: a slider under the pointer steps 1 (Shift 10). TRUE =
' the wheel was over the panel (used up).
'
FUNCTION PENP_wheel% (delta AS INTEGER)
    DIM ctl AS INTEGER
    IF delta = 0 _ORELSE PENP.visible% = 0 _ORELSE PENP.autoHidden% _ORELSE PENP.initialized% = 0 THEN EXIT FUNCTION
    IF PENP_hit_window%(MOUSE.RAW_X%, MOUSE.RAW_Y%) = 0 THEN EXIT FUNCTION
    PENP_wheel% = TRUE
    ctl = PENP_ctl_at_pointer%
    IF PENP_is_slider%(ctl) THEN
        IF PENP_slider_val%(ctl, VAL_OP_NUDGE, VAL_wheel_step%(delta)) THEN CONFIG_save: SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
    END IF
END FUNCTION

FUNCTION PENP_slider_text$ (ctl AS INTEGER)
    SELECT CASE ctl%
        CASE PENP_CTL_SIZE:  PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_MIN_SIZE%)) + "%"
        CASE PENP_CTL_OPAC:  PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_MIN_OPACITY%)) + "%"
        CASE PENP_CTL_MIX:   PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_MIX_MIN%)) + "%"
        CASE PENP_CTL_TIP:   PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_TIP_THRESHOLD%)) + "%"
        CASE PENP_CTL_CURVE: PENP_slider_text$ = PENP_x100$(CFG.PEN_PRESSURE_CURVE%)
        CASE PENP_CTL_STAB_AMT: PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_STAB_AMOUNT%))
        CASE PENP_CTL_PROC_AMT
            IF CFG.PEN_PROC_MODE% = PPROC_FIXED THEN
                PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_PROC_AMOUNT%)) + "%"
            ELSE
                PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_PROC_AMOUNT%))
            END IF
        CASE PENP_CTL_SPD_SLOW:   PENP_slider_text$ = PENP_x100$(CFG.PEN_SPEED_SLOW%)
        CASE PENP_CTL_SPD_FAST:   PENP_slider_text$ = PENP_x100$(CFG.PEN_SPEED_FAST%)
        CASE PENP_CTL_SPD_AT:     PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_SPEED_FAST_AT%))
        CASE PENP_CTL_SPD_SMOOTH: PENP_slider_text$ = _TRIM$(STR$(CFG.PEN_SPEED_SMOOTH%))
    END SELECT
END FUNCTION

' 303 -> "3.03"
FUNCTION PENP_x100$ (v AS INTEGER)
    PENP_x100$ = _TRIM$(STR$(v% \ 100)) + "." + RIGHT$("0" + _TRIM$(STR$(v% MOD 100)), 2)
END FUNCTION

' ---------------------------------------------------------------------------
' Control kinds and tabs.
' ---------------------------------------------------------------------------
FUNCTION PENP_tab% ()
    PENP_tab% = _MAX(0, _MIN(PENP_TAB_COUNT - 1, CFG.PEN_PANEL_TAB%))
END FUNCTION

FUNCTION PENP_is_checkbox% (ctl AS INTEGER)
    SELECT CASE ctl%
        CASE PENP_CTL_ON, PENP_CTL_SIZE_ON, PENP_CTL_OPAC_ON, PENP_CTL_MIX_ON, PENP_CTL_STAB_ON, PENP_CTL_CATCH, PENP_CTL_GUIDE_LN, PENP_CTL_GUIDE_CUR, PENP_CTL_PROC_ON, PENP_CTL_SPD_ON
            PENP_is_checkbox% = TRUE
    END SELECT
END FUNCTION

FUNCTION PENP_seg_count% (ctl AS INTEGER) ' segments in a tab strip / mode row (0 = not one)
    SELECT CASE ctl%
        CASE PENP_CTL_TABS: PENP_seg_count% = PENP_TAB_COUNT
        CASE PENP_CTL_STAB_MODE: PENP_seg_count% = STAB_MODE_COUNT
        CASE PENP_CTL_PROC_MODE: PENP_seg_count% = PPROC_MODE_COUNT
    END SELECT
END FUNCTION

' a segment row's span (native px): mode rows sit under their checkbox's text
SUB PENP_seg_span (ctl AS INTEGER, x0 AS INTEGER, x1 AS INTEGER, h AS INTEGER)
    x0% = PENP_ctlX0(ctl%): x1% = PENP_ctlX1(ctl%): h% = FPANEL.sliderH%
    IF ctl% = PENP_CTL_TABS THEN h% = PENP.tabH% ELSE x0% = x0% + PENP.subX% - FPANEL.pad%
END SUB

FUNCTION PENP_seg_at% (ctl AS INTEGER, nx AS INTEGER)
    DIM n AS INTEGER, x0 AS INTEGER, x1 AS INTEGER, h AS INTEGER, k AS INTEGER
    n% = PENP_seg_count%(ctl%)
    IF n% < 1 THEN EXIT FUNCTION
    PENP_seg_span ctl%, x0%, x1%, h%
    k% = (nx% - x0%) * n% \ _MAX(1, x1% - x0% + 1)
    PENP_seg_at% = _MAX(0, _MIN(n% - 1, k%))
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_track_frac! — Native x -> 0..1 along the slider track (matches the
' fill/thumb geometry of FPANEL_track).
' ---------------------------------------------------------------------------
FUNCTION PENP_track_frac! (ctl AS INTEGER, nx AS INTEGER)
    PENP_track_frac! = (nx% - PENP_ctlTX0(ctl%) - 1) / (PENP_ctlTX1(ctl%) - PENP_ctlTX0(ctl%) - 1)
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_hit% — Control under a native panel point (PENP_CTL_*).
' Checkbox rows are clickable across the panel; sliders on (or just past)
' their track, with half the row gap of slack above and below.
' ---------------------------------------------------------------------------
FUNCTION PENP_hit% (nx AS INTEGER, ny AS INTEGER)
    PENP_hit% = PENP_CTL_NONE
    IF nx% < 2 OR nx% >= PENP.panelW% - 2 THEN EXIT FUNCTION
    DIM onTrack AS INTEGER, c AS INTEGER, y AS INTEGER, slack AS INTEGER
    slack%   = FPANEL.gap% \ 2 + 1
    DIM curTab AS INTEGER, sx0 AS INTEGER, sx1 AS INTEGER, sh AS INTEGER
    curTab% = PENP_tab%
    FOR c% = 1 TO PENP_CTL_COUNT
        IF PENP_ctlTab(c%) >= 0 _ANDALSO PENP_ctlTab(c%) <> curTab% THEN _CONTINUE ' (another tab's)
        IF nx% < PENP_ctlX0(c%) - 2 _ORELSE nx% > PENP_ctlX1(c%) + 2 THEN _CONTINUE ' (its column)
        y% = PENP_ctlY(c%)
        IF PENP_is_checkbox%(c%) THEN
            IF ny% >= y% - 1 AND ny% < y% + FPANEL.fontH% + 1 THEN PENP_hit% = c%
            _CONTINUE
        END IF
        IF PENP_seg_count%(c%) > 0 THEN
            PENP_seg_span c%, sx0%, sx1%, sh%
            IF nx% >= sx0% _ANDALSO nx% <= sx1% _ANDALSO ny% >= y% _ANDALSO ny% < y% + sh% THEN PENP_hit% = c%
            _CONTINUE
        END IF
        SELECT CASE c%
            CASE ELSE
                onTrack% = (nx% >= PENP_ctlTX0(c%) - 4 AND nx% <= PENP_ctlTX1(c%) + 4)
                IF onTrack% AND ny% >= y% - slack% AND ny% < y% + FPANEL.sliderH% + slack% THEN PENP_hit% = c%
        END SELECT
    NEXT c%
END FUNCTION

' ---------------------------------------------------------------------------
' Drawing helpers (into the panel image, native coords, FPANEL font).
' ---------------------------------------------------------------------------
SUB PENP_draw_checkbox (ctl AS INTEGER, checked AS INTEGER, label AS STRING, enabled AS INTEGER)
    ' a label wider than its column (a row narrower than the five columns want -
    ' Rick's Tablet / Only Menu bottom rows) ran into the next column: drop the
    ' " BY PRESSURE" (it is the Pen Control panel), then trim what still won't fit
    DIM lab AS STRING, bs AS INTEGER, room AS INTEGER, p AS INTEGER
    lab$ = label$
    bs% = FPANEL.fontH% - 1: IF bs% < 7 THEN bs% = 7 ' (FPANEL_checkbox's box)
    room% = PENP_ctlX1(ctl%) - PENP_ctlX0(ctl%) + 1 - bs% - 4
    IF FPANEL_text_w%(lab$) > room% THEN
        p% = INSTR(lab$, " BY PRESSURE"): IF p% THEN lab$ = LEFT$(lab$, p% - 1)
        ' whole words first ("USE PEN PRESSURE" -> "USE PEN"), then letters
        DO WHILE FPANEL_text_w%(lab$) > room% _ANDALSO _INSTRREV(lab$, " ") > 1: lab$ = LEFT$(lab$, _INSTRREV(lab$, " ") - 1): LOOP
        DO WHILE LEN(lab$) > 1 _ANDALSO FPANEL_text_w%(lab$) > room%: lab$ = RTRIM$(LEFT$(lab$, LEN(lab$) - 1)): LOOP
    END IF
    FPANEL_checkbox PENP_ctlX0(ctl%), PENP_ctlY(ctl%), checked%, lab$, enabled%, PENP.hoverCtl% = ctl%
END SUB

SUB PENP_draw_slider (ctl AS INTEGER, labelX AS INTEGER, label AS STRING, enabled AS INTEGER)
    DIM fg AS _UNSIGNED LONG, y AS INTEGER, ty AS INTEGER
    IF enabled% THEN fg~& = THEME.CP_text~& ELSE fg~& = THEME.CP_text_dim~&
    y%  = PENP_ctlY(ctl%)
    ty% = y% + (FPANEL.sliderH% - FPANEL.fontH%) \ 2
    FPANEL_text PENP_ctlX0(ctl%) + labelX% - FPANEL.pad%, ty%, label$, fg~& ' (labelX: in the column)
    FPANEL_track PENP_ctlTX0(ctl%), y%, PENP_ctlTX1(ctl%) - PENP_ctlTX0(ctl%) + 1, PENP_slider_frac!(ctl%), THEME.CP_text~&, enabled%
    FPANEL_text PENP_ctlTX1(ctl%) + 6, ty%, PENP_slider_text$(ctl%), fg~&
END SUB

' ---------------------------------------------------------------------------
' PENP_render — Compose the panel; blit to screen 0.
' Called from SCREEN_render after CS3D_render (same z-tier).
' ---------------------------------------------------------------------------
SUB PENP_render ()
    IF NOT PENP.visible% THEN EXIT SUB
    IF PENP.autoHidden% THEN EXIT SUB

    PENP_ensure_initialized
    IF NOT PENP.positioned% THEN PENP_auto_position
    PENP_clamp_to_work_area
    REGION_set_bounds REGION_PEN_PANEL, PENP.dispX%, PENP.dispY%, PENP.dispW%, PENP.dispH%, _IIF(PENP.docked% <> 0, ZORDER_DOCKED_WINDOW, ZORDER_FLOATING)

    DIM penOn AS INTEGER, live AS INTEGER, src AS INTEGER
    DIM raw AS SINGLE, curved AS SINGLE, gamma AS SINGLE
    DIM status AS STRING
    penOn% = CFG.PEN_PRESSURE%
    live%  = penOn% _ANDALSO TABLET.ready
    IF live% THEN
        src% = PD_source%
        raw! = PD_raw_pressure!
        IF src% = PD_SRC_MOUSE THEN raw! = 0
    END IF
    gamma! = CFG.PEN_PRESSURE_CURVE% / 100!
    curved! = PD_curve!(raw!, gamma!)
    PENP.lastP! = raw!
    IF NOT penOn% THEN
        status$ = "PRESSURE IS OFF"
    ELSEIF NOT TABLET.ready THEN
        status$ = "NO PEN BACKEND"
    ELSE
        status$ = UCASE$(PD_backend_name$) + " - " + UCASE$(PD_source_name$(src%))
    END IF

    ' Hover: control / close box under the pointer (none while dragging)
    PENP.hoverCtl%   = PENP_CTL_NONE
    PENP.closeHover% = FALSE
    IF PENP_hit_window%(MOUSE.RAW_X%, MOUSE.RAW_Y%) _ANDALSO NOT PENP.dragging% _ANDALSO PENP.sliding% = PENP_CTL_NONE _ANDALSO PENP.renderScale! > 0 THEN
        DIM hx AS INTEGER, hy AS INTEGER
        hx% = INT((MOUSE.RAW_X% - PENP.dispX%) / PENP.renderScale!)
        hy% = INT((MOUSE.RAW_Y% - PENP.dispY%) / PENP.renderScale!)
        PENP.closeHover% = FPANEL_over_close%(hx%, hy%, PENP.panelW%)
        PENP.hoverCtl%   = PENP_hit%(hx%, hy%)
        IF PENP_seg_count%(PENP.hoverCtl%) > 0 THEN PENP.hoverSeg% = PENP_seg_at%(PENP.hoverCtl%, hx%)
    END IF

    DIM oldDest AS LONG : oldDest& = _DEST
    _DEST PENP.panelImg&
    DIM oldFont AS LONG : oldFont& = FPANEL_begin&
    CLS , THEME.CP_bg~&
    FPANEL_title_bar PENP.panelW%, "PEN CONTROL", PENP.closeHover%

    DIM pad AS INTEGER, f AS INTEGER, slH AS INTEGER, curTab AS INTEGER, labX AS INTEGER
    pad% = FPANEL.pad% : f% = FPANEL.fontH% : slH% = FPANEL.sliderH%
    curTab% = PENP_tab%
    ' sub-slider labels sit under their checkbox's text (in a row: the column's left)
    IF PENP.inRow% THEN labX% = pad% ELSE labX% = PENP.subX%

    ' The backend status: in the title bar when it fits, else in the graph
    DIM stX AS INTEGER, stIn AS INTEGER
    stX% = FPANEL_title_text_x% + _UPRINTWIDTH("PEN CONTROL") + 8
    stIn% = (stX% + _UPRINTWIDTH(status$) <= PENP.panelW% - FPANEL.titleH% - 4)
    IF stIn% THEN FPANEL_text PENP.panelW% - FPANEL.titleH% - 4 - _UPRINTWIDTH(status$), FPANEL_title_text_y%, status$, THEME.CP_title_fg~&

    PENP_draw_segs PENP_CTL_TABS, "PRESSURE|SMOOTHING|SPEED", "PRESS|SMOOTH|SPEED", curTab%, TRUE

    SELECT CASE curTab%
    CASE PENP_TAB_SMOOTH
        PENP_render_smooth penOn%, labX%
    CASE PENP_TAB_SPEED
        PENP_render_speed penOn%, labX%
    CASE ELSE
        PENP_draw_checkbox PENP_CTL_ON, penOn%, "USE PEN PRESSURE", TRUE

        ' Live meter (a slider well, same span as the tracks' left edge to their
        ' right edge): raw pen pressure fills it, the value after the curve is the
        ' bright tick, the tip threshold the red mark.
        DIM mx0 AS INTEGER, mx1 AS INTEGER, mw AS INTEGER, my AS INTEGER
        mx0% = PENP_ctlX0(PENP_CTL_ON) : mx1% = PENP_ctlTX1(PENP_CTL_ON) : mw% = mx1% - mx0% - 2 : my% = PENP.yMeter%
        LINE (mx0%, my%)-(mx1%, my% + slH% - 1), THEME.CP_slider_bg~&, BF
        LINE (mx0%, my%)-(mx1%, my% + slH% - 1), THEME.CP_slider_border~&, B
        IF raw! > 0 THEN LINE (mx0% + 1, my% + 1)-(mx0% + 1 + INT(raw! * mw%), my% + slH% - 2), THEME.CP_text_dim~&, BF
        IF CFG.PEN_TIP_THRESHOLD% > 0 THEN
            DIM tx AS INTEGER : tx% = mx0% + 1 + INT(CFG.PEN_TIP_THRESHOLD% / 100! * mw%)
            LINE (tx%, my% + 1)-(tx%, my% + slH% - 2), THEME.CP_close_fg~&
        END IF
        DIM cx AS INTEGER : cx% = mx0% + 1 + INT(curved! * mw%)
        LINE (cx% - 1, my% - 1)-(cx% + 1, my% + slH%), THEME.CP_text_bright~&, BF
        FPANEL_text mx1% + 6, my% + (slH% - f%) \ 2, _TRIM$(STR$(INT(raw! * 100 + 0.5))) + "%", THEME.CP_text~&

        ' Size / opacity / mix: a checkbox and its lightest-touch slider each
        PENP_draw_checkbox PENP_CTL_SIZE_ON, CFG.PEN_PRESSURE_SIZE%, "SIZE BY PRESSURE", penOn%
        PENP_draw_slider PENP_CTL_SIZE, PENP.subX%, "LIGHT", penOn% _ANDALSO CFG.PEN_PRESSURE_SIZE%
        PENP_draw_checkbox PENP_CTL_OPAC_ON, CFG.PEN_PRESSURE_OPACITY%, "OPACITY BY PRESSURE", penOn%
        PENP_draw_slider PENP_CTL_OPAC, PENP.subX%, "LIGHT", penOn% _ANDALSO CFG.PEN_PRESSURE_OPACITY%
        PENP_draw_checkbox PENP_CTL_MIX_ON, CFG.PEN_PRESSURE_MIX%, "MIX PAINT BY PRESSURE", penOn%
        PENP_draw_slider PENP_CTL_MIX, PENP.subX%, "LIGHT", penOn% _ANDALSO CFG.PEN_PRESSURE_MIX%
        PENP_draw_slider PENP_CTL_CURVE, pad%, "CURVE", penOn%
        PENP_draw_slider PENP_CTL_TIP, pad%, "TIP", penOn%

        ' Response graph: pressure (x) -> value used (y), with the live point
        DIM gx0 AS INTEGER, gx1 AS INTEGER, gy0 AS INTEGER, gy1 AS INTEGER, gw AS INTEGER, gh AS INTEGER
        DIM i AS INTEGER, px AS INTEGER, py AS INTEGER, lx AS INTEGER, ly AS INTEGER
        gx0% = PENP.gx0% : gx1% = PENP.gx1% : gw% = gx1% - gx0% - 2
        gy0% = PENP.yGraph% : gy1% = PENP.yGraph% + PENP.graphH% - 1 : gh% = gy1% - gy0% - 2
        LINE (gx0%, gy0%)-(gx1%, gy1%), THEME.CP_slider_bg~&, BF
        LINE (gx0% + 1, gy1% - 1)-(gx1% - 1, gy0% + 1), THEME.CP_text_dim~&, , &HCCCC ' linear reference
        FOR i% = 0 TO gw%
            px% = gx0% + 1 + i%
            py% = gy1% - 1 - INT(PD_curve!(i% / gw%, gamma!) * gh% + 0.5)
            IF i% > 0 THEN LINE (lx%, ly%)-(px%, py%), THEME.CP_text~&
            lx% = px% : ly% = py%
        NEXT i%
        IF live% _ANDALSO src% <> PD_SRC_MOUSE THEN
            px% = gx0% + 1 + INT(raw! * gw%)
            py% = gy1% - 1 - INT(curved! * gh%)
            LINE (px% - 2, py% - 2)-(px% + 2, py% + 2), THEME.CP_text_bright~&, BF
        END IF
        LINE (gx0%, gy0%)-(gx1%, gy1%), THEME.CP_slider_border~&, B
        FPANEL_text gx0% + 3, gy0% + 3, "RESPONSE", THEME.CP_text_dim~&
        IF stIn% = 0 _ANDALSO gh% > 2 * f% + 4 THEN FPANEL_text gx0% + 3, gy1% - f% - 1, PENP_fit$(status$, gw% - 4), THEME.CP_text_dim~&
    END SELECT

    FPANEL_frame PENP.panelW%, PENP.panelH%
    _FONT oldFont&
    _DEST oldDest&

    ' (menus / popups open over it are drawn back on top: POPUP_reblit_to_screen0)

    DIM ts AS INTEGER, ds AS INTEGER
    ts% = FPANEL_scale%(DP_PEN)      : IF ts% < 1 THEN ts% = 1
    ds% = SCRN.displayScale% : IF ds% < 1 THEN ds% = 1
    DIM sx AS LONG, sy AS LONG, sw AS LONG, sh AS LONG
    sx& = CLNG(PENP.dispX%) * ds%
    sy& = CLNG(PENP.dispY%) * ds%
    sw& = CLNG(PENP.panelW%) * ts%
    sh& = CLNG(PENP.panelH%) * ts%
    DIM oldDest2 AS LONG : oldDest2& = _DEST
    _DEST 0
    _PUTIMAGE (sx&, sy&)-(sx& + sw& - 1, sy& + sh& - 1), PENP.panelImg&, 0
    _DEST oldDest2&
END SUB

' ---------------------------------------------------------------------------
' PENP_render_smooth — The SMOOTHING tab: position smoothing (any pointer)
' and pressure processing (a pen), then a hint for the smoothing mode.
' ---------------------------------------------------------------------------
SUB PENP_render_smooth (penOn AS INTEGER, lx AS INTEGER)
    DIM stabOn AS INTEGER, procOn AS INTEGER, sm AS INTEGER, pm AS INTEGER, hint AS STRING
    stabOn% = (CFG.PEN_STAB% <> 0)
    sm% = _MAX(STAB_PULLED, _MIN(STAB_MODE_COUNT, CFG.PEN_STAB_MODE%))
    PENP_draw_checkbox PENP_CTL_STAB_ON, stabOn%, "SMOOTH POSITION", TRUE
    PENP_draw_segs PENP_CTL_STAB_MODE, "STRING|AVERAGE|EMA|INERTIA", "STR|AVG|EMA|INR", sm% - 1, stabOn%
    PENP_draw_slider PENP_CTL_STAB_AMT, lx%, "AMOUNT", stabOn%
    PENP_draw_checkbox PENP_CTL_CATCH, CFG.PEN_STAB_CATCHUP% <> 0, "CATCH UP", stabOn% _ANDALSO (sm% = STAB_MA _ORELSE sm% = STAB_EMA)
    PENP_draw_checkbox PENP_CTL_GUIDE_LN, CFG.PEN_STAB_GUIDE_LINE% <> 0, "GUIDE LINE", stabOn%
    PENP_draw_checkbox PENP_CTL_GUIDE_CUR, CFG.PEN_STAB_GUIDE_CURSOR% <> 0, "GUIDE CURSOR", stabOn%

    procOn% = penOn% _ANDALSO CFG.PEN_PROC% <> 0
    pm% = _MAX(PPROC_FIXED, _MIN(PPROC_MODE_COUNT, CFG.PEN_PROC_MODE%))
    PENP_draw_checkbox PENP_CTL_PROC_ON, CFG.PEN_PROC% <> 0, "SMOOTH PRESSURE", penOn%
    PENP_draw_segs PENP_CTL_PROC_MODE, "FIXED|HOLD|AVERAGE|EMA", "FIX|HLD|AVG|EMA", pm% - 1, procOn%
    PENP_draw_slider PENP_CTL_PROC_AMT, lx%, "AMOUNT", procOn%

    IF PENP.hby1% - PENP.hby0% < FPANEL.fontH% + 4 _ORELSE PENP.hbx1% - PENP.hbx0% < 24 THEN EXIT SUB
    IF NOT stabOn% THEN
        hint$ = "SMOOTH POSITION STEADIES BRUSH AND ERASER STROKES - PEN OR MOUSE. HOVER A CONTROL FOR WHAT IT DOES; RIGHT-CLICK THE PANEL FOR EXAMPLE PRESETS."
    ELSE
        SELECT CASE sm%
            CASE STAB_PULLED:  hint$ = "PULLED STRING: THE LINE HANGS ON A STRING AMOUNT SCREEN PX LONG. SLOW, DETAILED WORK, SHARP CORNERS."
            CASE STAB_MA:      hint$ = "MOVING AVERAGE: CURVED LINES, SOFT CORNERS."
            CASE STAB_EMA:     hint$ = "EXPONENTIAL MA: MASSIVE SMOOTHING, LONG CURVES."
            CASE STAB_INERTIA: hint$ = "INERTIA: FAST, FLOWY LINES."
        END SELECT
        IF CFG.PEN_STAB_CATCHUP% _ANDALSO (sm% = STAB_MA _ORELSE sm% = STAB_EMA) THEN hint$ = hint$ + " CATCH UP: THE LINE REACHES THE POINTER WHEN IT RESTS OR LIFTS."
    END IF
    LINE (PENP.hbx0%, PENP.hby0%)-(PENP.hbx1%, PENP.hby1%), THEME.CP_slider_bg~&, BF
    LINE (PENP.hbx0%, PENP.hby0%)-(PENP.hbx1%, PENP.hby1%), THEME.CP_slider_border~&, B
    PENP_wrap PENP.hbx0% + 3, PENP.hby0% + 3, PENP.hbx1% - 3, PENP.hby1% - 2, hint$, THEME.CP_text_dim~&
END SUB

' ---------------------------------------------------------------------------
' PENP_render_speed — The SPEED tab: speed scaling (a gain on pen pressure
' from how fast the pointer moves), the NOW / AVG / TOP readout and the
' speed -> gain graph with the last stroke's average (dim) and top (red)
' speeds and, while drawing, the live point.
' ---------------------------------------------------------------------------
SUB PENP_render_speed (penOn AS INTEGER, lx AS INTEGER)
    DIM spOn AS INTEGER, nowS AS SINGLE, f AS INTEGER, t AS STRING
    PENC_sync ' (the graph plots CFG's gains)
    f% = FPANEL.fontH%
    spOn% = penOn% _ANDALSO CFG.PEN_SPEED% <> 0
    PENP_draw_checkbox PENP_CTL_SPD_ON, CFG.PEN_SPEED% <> 0, "SPEED SCALING", penOn%
    PENP_draw_slider PENP_CTL_SPD_SLOW, lx%, "SLOW", spOn%
    PENP_draw_slider PENP_CTL_SPD_FAST, lx%, "FAST", spOn%
    PENP_draw_slider PENP_CTL_SPD_AT, lx%, "SPEED", spOn%
    PENP_draw_slider PENP_CTL_SPD_SMOOTH, lx%, "SMOOTH", spOn%
    IF PSPD.started THEN nowS! = PSPD.speed
    PENP.lastSpeed! = nowS!: PENP.lastTop! = PSPD.topSpeed

    DIM rw AS INTEGER : rw% = PENP.rdX1% - PENP.rdX% + 1
    IF PENP.inRow% THEN
        FPANEL_text PENP_ctlX0(PENP_CTL_SPD_ON), PENP.yMeter% + (FPANEL.sliderH% - f%) \ 2, PENP_fit$("GAIN " + PENP_x100$(INT(PSPD_gain_at!(nowS!) * 100 + 0.5)), PENP.colW%), THEME.CP_text~&
        IF rw% > 12 THEN
            FPANEL_text PENP.rdX%, PENP.rdY%, PENP_fit$("NOW " + _TRIM$(STR$(INT(nowS!))), rw%), THEME.CP_text~&
            FPANEL_text PENP.rdX%, PENP.rdY% + f% + FPANEL.gap%, PENP_fit$("AVG " + _TRIM$(STR$(INT(PSPD.avgSpeed))), rw%), THEME.CP_text_dim~&
            FPANEL_text PENP.rdX%, PENP.rdY% + 2 * (f% + FPANEL.gap%), PENP_fit$("TOP " + _TRIM$(STR$(INT(PSPD.topSpeed))), rw%), THEME.CP_close_fg~&
        END IF
    ELSE
        t$ = "NOW " + _TRIM$(STR$(INT(nowS!))) + "  AVG " + _TRIM$(STR$(INT(PSPD.avgSpeed))) + "  TOP " + _TRIM$(STR$(INT(PSPD.topSpeed)))
        FPANEL_text PENP.rdX%, PENP.rdY%, PENP_fit$(t$, rw%), THEME.CP_text~&
    END IF

    ' the graph: speed (x, 0 .. 1.5 x Fast Speed) -> gain (y, 0 .. Fast Gain)
    DIM gx0 AS INTEGER, gx1 AS INTEGER, gy0 AS INTEGER, gy1 AS INTEGER, gw AS INTEGER, gh AS INTEGER
    DIM i AS INTEGER, px AS INTEGER, py AS INTEGER, ox AS INTEGER, oy AS INTEGER
    DIM xMax AS SINGLE, yMax AS SINGLE, cc AS _UNSIGNED LONG
    gx0% = PENP.sgx0%: gx1% = PENP.sgx1%: gy0% = PENP.sgy0%: gy1% = PENP.sgy1%
    gw% = gx1% - gx0% - 2: gh% = gy1% - gy0% - 2
    IF gw% < 16 _ORELSE gh% < 12 THEN EXIT SUB
    xMax! = _MAX(100, PSPD.fastSpeed * 1.5)
    yMax! = _MAX(PSPD.fastGain, 1) * 1.1
    LINE (gx0%, gy0%)-(gx1%, gy1%), THEME.CP_slider_bg~&, BF
    py% = gy1% - 1 - INT(1 / yMax! * gh% + 0.5) ' gain 1 (pressure as the pen gives it)
    LINE (gx0% + 1, py%)-(gx1% - 1, py%), THEME.CP_text_dim~&, , &HCCCC
    px% = gx0% + 1 + INT(PSPD.fastSpeed / xMax! * gw% + 0.5) ' Fast Speed
    LINE (px%, gy0% + 1)-(px%, gy1% - 1), THEME.CP_text_dim~&, , &HAAAA
    IF spOn% THEN cc~& = THEME.CP_text~& ELSE cc~& = THEME.CP_text_dim~&
    FOR i% = 0 TO gw%
        px% = gx0% + 1 + i%
        py% = gy1% - 1 - INT(PSPD_gain_at!(i% / gw% * xMax!) / yMax! * gh% + 0.5)
        IF i% > 0 THEN LINE (ox%, oy%)-(px%, py%), cc~&
        ox% = px%: oy% = py%
    NEXT i%
    IF PSPD.avgSpeed > 0 THEN
        px% = gx0% + 1 + INT(_MIN(PSPD.avgSpeed, xMax!) / xMax! * gw% + 0.5)
        LINE (px%, gy0% + 1)-(px%, gy1% - 1), THEME.CP_text_bright~&, , &HF0F0
    END IF
    IF PSPD.topSpeed > 0 THEN
        px% = gx0% + 1 + INT(_MIN(PSPD.topSpeed, xMax!) / xMax! * gw% + 0.5)
        LINE (px%, gy0% + 1)-(px%, gy1% - 1), THEME.CP_close_fg~&
    END IF
    IF PSPD.started THEN
        px% = gx0% + 1 + INT(_MIN(nowS!, xMax!) / xMax! * gw% + 0.5)
        py% = gy1% - 1 - INT(PSPD_gain_at!(nowS!) / yMax! * gh% + 0.5)
        LINE (px% - 2, py% - 2)-(px% + 2, py% + 2), THEME.CP_text_bright~&, BF
    END IF
    LINE (gx0%, gy0%)-(gx1%, gy1%), THEME.CP_slider_border~&, B
    IF _UPRINTWIDTH("SPEED > GAIN") <= gw% - 4 THEN FPANEL_text gx0% + 3, gy0% + 3, "SPEED > GAIN", THEME.CP_text_dim~&
END SUB

' ---------------------------------------------------------------------------
' PENP_draw_segs — A tab strip / mode row: one chip per item, the value's
' lit. Labels: the full ones when every one fits, else the short ones, else
' first letters. Disabled: dimmed over.
' ---------------------------------------------------------------------------
SUB PENP_draw_segs (ctl AS INTEGER, items AS STRING, shortItems AS STRING, value AS INTEGER, enabled AS INTEGER)
    DIM n AS INTEGER, x0 AS INTEGER, x1 AS INTEGER, h AS INTEGER, y AS INTEGER, i AS INTEGER
    DIM sx AS INTEGER, ex AS INTEGER, segW AS INTEGER, lbl AS STRING, useSet AS INTEGER
    n% = PENP_seg_count%(ctl%)
    IF n% < 1 THEN EXIT SUB
    PENP_seg_span ctl%, x0%, x1%, h%
    y% = PENP_ctlY(ctl%)
    segW% = (x1% - x0% + 1) \ n% - 1
    FOR i% = 1 TO n%
        IF _UPRINTWIDTH(PENP_item$(items$, i%)) > segW% - 2 THEN useSet% = 1
    NEXT i%
    IF useSet% = 1 THEN
        FOR i% = 1 TO n%
            IF _UPRINTWIDTH(PENP_item$(shortItems$, i%)) > segW% - 2 THEN useSet% = 2
        NEXT i%
    END IF
    FOR i% = 0 TO n% - 1
        sx% = x0% + i% * (x1% - x0% + 1) \ n%
        ex% = x0% + (i% + 1) * (x1% - x0% + 1) \ n% - 2
        IF i% = n% - 1 THEN ex% = x1%
        SELECT CASE useSet%
            CASE 0: lbl$ = PENP_item$(items$, i% + 1)
            CASE 1: lbl$ = PENP_item$(shortItems$, i% + 1)
            CASE ELSE: lbl$ = LEFT$(PENP_item$(items$, i% + 1), 1)
        END SELECT
        FPANEL_chip sx%, y%, ex% - sx% + 1, h%, lbl$, i% = value%, enabled% _ANDALSO PENP.hoverCtl% = ctl% _ANDALSO PENP.hoverSeg% = i%
    NEXT i%
    IF NOT enabled% THEN
        DIM bg AS _UNSIGNED LONG : bg~& = THEME.CP_bg~&
        LINE (x0%, y%)-(x1%, y% + h% - 1), _RGBA32(_RED32(bg~&), _GREEN32(bg~&), _BLUE32(bg~&), 150), BF
    END IF
END SUB

' the i-th (1-based) item of "A|B|C"
FUNCTION PENP_item$ (items AS STRING, i AS INTEGER)
    DIM k AS INTEGER, a AS INTEGER, b AS INTEGER
    a% = 1
    FOR k% = 1 TO i% - 1
        b% = INSTR(a%, items$, "|")
        IF b% = 0 THEN EXIT FUNCTION
        a% = b% + 1
    NEXT k%
    b% = INSTR(a%, items$, "|")
    IF b% = 0 THEN b% = LEN(items$) + 1
    PENP_item$ = MID$(items$, a%, b% - a%)
END FUNCTION

' txt cut to fit w px (current font)
FUNCTION PENP_fit$ (txt AS STRING, w AS INTEGER)
    DIM t AS STRING : t$ = txt$
    DO WHILE LEN(t$) > 0 _ANDALSO _UPRINTWIDTH(t$) > w%
        t$ = LEFT$(t$, LEN(t$) - 1)
    LOOP
    PENP_fit$ = t$
END FUNCTION

' txt word-wrapped into x0..x1, from y0 down to y1 (current font)
SUB PENP_wrap (x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER, txt AS STRING, clr AS _UNSIGNED LONG)
    DIM y AS INTEGER, ln AS STRING, w AS STRING, rest AS STRING, sp AS INTEGER, tline AS STRING
    y% = y0%: rest$ = _TRIM$(txt$)
    DO WHILE LEN(rest$) > 0
        sp% = INSTR(rest$, " ")
        IF sp% = 0 THEN w$ = rest$: rest$ = "" ELSE w$ = LEFT$(rest$, sp% - 1): rest$ = LTRIM$(MID$(rest$, sp% + 1))
        IF ln$ = "" THEN tline$ = w$ ELSE tline$ = ln$ + " " + w$
        IF _UPRINTWIDTH(tline$) > x1% - x0% + 1 _ANDALSO ln$ <> "" THEN
            IF y% + FPANEL.fontH% > y1% + 1 THEN EXIT SUB
            FPANEL_text x0%, y%, ln$, clr~&
            y% = y% + FPANEL.fontH% + 1
            ln$ = PENP_fit$(w$, x1% - x0% + 1)
        ELSE
            ln$ = PENP_fit$(tline$, x1% - x0% + 1)
        END IF
    LOOP
    IF ln$ <> "" _ANDALSO y% + FPANEL.fontH% <= y1% + 1 THEN FPANEL_text x0%, y%, ln$, clr~&
END SUB

' ---------------------------------------------------------------------------
' Tooltips (Rick 2026-11-17: "add tooltips about what they do, and examples").
' PENP_tip$ is the one text for a control: "WHAT IT IS - what it does" LF
' "how it behaves" LF "TRY: an example". The panel shows it as a three-line
' tooltip (TOOLTIP_SRC_PEN_PANEL); Settings > Pen Control shows the same text.
' sg = the segment of a tab strip / mode row (0-based; ignored elsewhere).
' Areas that are not controls (the meter, the graphs) have PENP_TIP_* ids.
' ---------------------------------------------------------------------------
FUNCTION PENP_tip$ (ctl AS INTEGER, sg AS INTEGER)
    DIM a AS STRING, b AS STRING, c AS STRING
    SELECT CASE ctl%
        CASE PENP_CTL_TABS
            SELECT CASE sg%
                CASE 0
                    a$ = "PRESSURE - what pen pressure changes"
                    b$ = "Size, opacity and mix paint each follow how hard you press, shaped by the CURVE."
                    c$ = "TRY: SIZE BY PRESSURE on with LIGHT 20 - a light stroke draws a fifth of the brush size. Right-click for example presets."
                CASE 1
                    a$ = "SMOOTHING - steadier lines and steadier pressure"
                    b$ = "SMOOTH POSITION filters where the brush goes (pen or mouse); SMOOTH PRESSURE filters how hard it presses (pen)."
                    c$ = "TRY: SMOOTH POSITION on, STRING, AMOUNT 30, then draw a slow circle. Right-click for example presets."
                CASE ELSE
                    a$ = "SPEED - pressure from how fast the pen moves"
                    b$ = "Fast strokes get more pressure than slow ones (a pen only): quick flicks swell, careful slow lines stay fine."
                    c$ = "TRY: SPEED SCALING on, then draw a slow line and a fast flick and watch the dot on the graph."
            END SELECT
        CASE PENP_CTL_ON
            a$ = "USE PEN PRESSURE - the switch for tablet pressure"
            b$ = "Off: every pen stroke draws as if pressed all the way. A mouse is never affected."
            c$ = "TRY: off to sketch with an even line, back on to ink with tapers."
        CASE PENP_CTL_SIZE_ON
            a$ = "SIZE BY PRESSURE - press harder for a bigger brush"
            b$ = "The Brush and Eraser size runs from LIGHT at the lightest touch up to the full size. A 1px brush stays 1px."
            c$ = "TRY: a 12px brush with LIGHT 20 - strokes taper from about 2px to 12px."
        CASE PENP_CTL_SIZE
            a$ = "LIGHT (LIGHTEST TOUCH SIZE) - the size at the lightest touch, % of the brush size"
            b$ = "0 = lines taper to nothing; 100 = pressure does not change the size at all."
            c$ = "TRY: 0 for hairline tapers, 20 for inking, 50 for a gentle swell."
        CASE PENP_CTL_OPAC_ON
            a$ = "OPACITY BY PRESSURE - press harder for more solid paint"
            b$ = "The Brush and Eraser opacity runs from LIGHT to full. A stroke never builds up over itself."
            c$ = "TRY: on with LIGHT 10 for soft shading you build up stroke by stroke."
        CASE PENP_CTL_OPAC
            a$ = "LIGHT (LIGHTEST TOUCH OPACITY) - the opacity at the lightest touch, %"
            b$ = "0 = the lightest touches are invisible; higher keeps light strokes showing."
            c$ = "TRY: 25 for a pencil-like feel."
        CASE PENP_CTL_MIX_ON
            a$ = "MIX PAINT BY PRESSURE - the mix brush lays paint by pressure"
            b$ = "A light touch only smears the colors under it; full pressure lays the brush's Smudge amount of paint."
            c$ = "TRY: with the mix brush, press lightly to blend two colors, then press hard to lay a new one."
        CASE PENP_CTL_MIX
            a$ = "LIGHT (LIGHTEST TOUCH PAINT) - paint laid at the lightest touch, % of the full amount"
            b$ = "0 = a light touch is pure smudge, no new paint."
            c$ = "TRY: 0 to blend, 30 to always lay a little color."
        CASE PENP_CTL_CURVE
            a$ = "CURVE - how pen pressure maps to the value used"
            b$ = "1.00 = linear. Under 1, light touches count more (a soft pen); over 1, you must press harder (a firm pen)."
            c$ = "TRY: 0.60 if your strokes come out too thin, 1.60 if everything is too heavy. Watch the RESPONSE graph bend."
        CASE PENP_CTL_TIP
            a$ = "TIP (TIP THRESHOLD) - the pen draws only once it presses this hard, %"
            b$ = "Stops stray dots when the pen grazes the tablet. It is the red mark on the meter."
            c$ = "TRY: 3 (the default); raise it to 8-10 if hovering the pen leaves dots."
        CASE PENP_CTL_STAB_ON
            a$ = "SMOOTH POSITION - steady Brush and Eraser strokes, pen or mouse"
            b$ = "The line follows a filtered copy of the pointer, so wobble and jitter drop out (like Lazy Nezumi)."
            c$ = "TRY: STRING, AMOUNT 30, GUIDE LINE on, then draw a slow circle - and the same circle with it off."
        CASE PENP_CTL_STAB_MODE
            SELECT CASE sg%
                CASE 0
                    a$ = "STRING (PULLED STRING) - the brush hangs on a string AMOUNT screen px long"
                    b$ = "It only moves once you pull the string taut, so any wobble shorter than it never reaches the canvas. Corners stay sharp."
                    c$ = "TRY: AMOUNT 20-40 for inking and detailed work. Draw slowly; the guide line is the string."
                CASE 1
                    a$ = "AVERAGE (MOVING AVERAGE) - the line is the average of the last moment of movement"
                    b$ = "Curved lines with soft corners. More AMOUNT = a longer window: smoother, and it lags more."
                    c$ = "TRY: AMOUNT 40 with CATCH UP on for smooth curves that still end where you lift."
                CASE 2
                    a$ = "EMA (EXPONENTIAL MOVING AVERAGE) - the heaviest smoothing"
                    b$ = "Massive smoothing for long sweeping curves; the line trails well behind the pointer."
                    c$ = "TRY: AMOUNT 60-80 with CATCH UP on for hair, rope and long contour lines."
                CASE ELSE
                    a$ = "INERTIA - the brush has mass, on a spring"
                    b$ = "It carries momentum: fast, flowing lines that swing through curves and overshoot a little."
                    c$ = "TRY: AMOUNT 30 for gestural sketching, 70 for loose swooping strokes."
            END SELECT
        CASE PENP_CTL_STAB_AMT
            a$ = "AMOUNT - how much position smoothing (0 = none)"
            b$ = "STRING: the string's length in screen px. AVERAGE / EMA: how long a window. INERTIA: how heavy the brush is."
            c$ = "TRY: start at 30. The command palette has More / Less Smoothing (+-5) to bind to keys."
        CASE PENP_CTL_CATCH
            a$ = "CATCH UP - the line reaches the pointer when it rests or lifts"
            b$ = "AVERAGE and EMA lag behind the pointer; with CATCH UP the stroke still ends exactly where you stopped."
            c$ = "TRY: on for exact end points; off so a fast flick ends a little short, like a natural taper."
        CASE PENP_CTL_GUIDE_LN
            a$ = "GUIDE LINE - while drawing, a line from the drawing point to the pointer"
            b$ = "Shows the string or the lag, so you see where the brush goes next. It is never part of the art."
            c$ = "TRY: keep it on while you learn a mode. Its color is in Settings > Pen Control."
        CASE PENP_CTL_GUIDE_CUR
            a$ = "GUIDE CURSOR - while drawing, a ring at the drawing point"
            b$ = "Marks where the paint is landing while it trails behind the pointer."
            c$ = "TRY: on with a big EMA AMOUNT, where the brush lags far behind."
        CASE PENP_CTL_PROC_ON
            a$ = "SMOOTH PRESSURE - tame the pen's pressure before the CURVE (pen only)"
            b$ = "Evens out a wavering hand, or replaces the pressure outright (FIXED, HOLD)."
            c$ = "TRY: AVERAGE, AMOUNT 25 for a steadier line weight on long strokes."
        CASE PENP_CTL_PROC_MODE
            SELECT CASE sg%
                CASE 0
                    a$ = "FIXED - constant pressure, whatever the pen says"
                    b$ = "Every stroke uses AMOUNT % pressure: an even line, like a technical pen."
                    c$ = "TRY: AMOUNT 70 with SIZE BY PRESSURE on - one even line weight every time."
                CASE 1
                    a$ = "HOLD - lock the pressure once the stroke starts"
                    b$ = "The stroke keeps the weight it landed with, however your hand drifts. More AMOUNT = more samples before it locks."
                    c$ = "TRY: AMOUNT 20 for hatching, where each line keeps the weight you put it down with."
                CASE 2
                    a$ = "AVERAGE - smooth the pressure over a short window"
                    b$ = "Takes out jitter and sudden spikes (up to 0.4 s of pressure at AMOUNT 100)."
                    c$ = "TRY: AMOUNT 25 for a steadier line weight."
                CASE ELSE
                    a$ = "EMA - exponential pressure smoothing"
                    b$ = "Pressure changes glide instead of jumping; a heavier filter than AVERAGE."
                    c$ = "TRY: AMOUNT 40 for slow, even swells along a stroke."
            END SELECT
        CASE PENP_CTL_PROC_AMT
            a$ = "AMOUNT - how strong the pressure processing is"
            b$ = "FIXED: the pressure, %. HOLD: how many samples before it locks. AVERAGE / EMA: how much smoothing."
            c$ = "TRY: 25 to start."
        CASE PENP_CTL_SPD_ON
            a$ = "SPEED SCALING - pressure gain from how fast the pen moves (pen only)"
            b$ = "Slow strokes get the SLOW gain, strokes at SPEED and faster the FAST gain, with an S-curve between."
            c$ = "TRY: on, then draw a slow line and a quick flick: the flick comes out bolder."
        CASE PENP_CTL_SPD_SLOW
            a$ = "SLOW - the pressure gain at rest"
            b$ = "1.00 = the pressure as the pen gives it; under 1, slow strokes come out lighter and thinner."
            c$ = "TRY: 0.26 (the default) keeps careful slow lines fine."
        CASE PENP_CTL_SPD_FAST
            a$ = "FAST - the pressure gain at SPEED and faster"
            b$ = "Over 1.00, fast strokes come out heavier and thicker."
            c$ = "TRY: 3.03 (the default) for bold flicks; 1.00 to only thin the slow strokes."
        CASE PENP_CTL_SPD_AT
            a$ = "SPEED (FAST SPEED) - where the gain reaches FAST, in screen px a second"
            b$ = "The dashed upright on the graph. Lower = less speed needed for the full effect."
            c$ = "TRY: draw your fastest stroke, read TOP, and set SPEED a little under it."
        CASE PENP_CTL_SPD_SMOOTH
            a$ = "SMOOTH (SPEED SMOOTHING) - how much the measured speed is smoothed"
            b$ = "Higher = the gain changes gradually instead of twitching with every jiggle."
            c$ = "TRY: 22 (the default); raise it if the line weight looks bumpy."
        CASE PENP_TIP_METER
            a$ = "PRESSURE METER - how hard the pen presses right now"
            b$ = "The fill is the raw pressure, the bright tick the value after the CURVE, the red mark the TIP threshold."
            c$ = "TRY: press lightly, then firmly, to see your pen's whole range."
        CASE PENP_TIP_GRAPH
            a$ = "RESPONSE - pen pressure (across) to the value used (up)"
            b$ = "The dashed diagonal is linear; the line is your CURVE. The dot follows your pen live."
            c$ = "TRY: drag CURVE and watch the line bend."
        CASE PENP_TIP_SPEED_GRAPH
            a$ = "SPEED > GAIN - pen speed (across) to pressure gain (up)"
            b$ = "Dashed: gain 1.00 and the SPEED mark. Bright dashes: the last stroke's average speed; red: its top speed. The dot is live."
            c$ = "TRY: draw a stroke, then move SPEED near the red line."
        CASE PENP_TIP_READOUT
            a$ = "NOW / AVG / TOP - pen speed, in screen px a second"
            b$ = "NOW while you draw; AVG and TOP are the last stroke's average and top speed."
            c$ = "TRY: use TOP to choose SPEED."
        CASE PENP_TIP_HINT
            a$ = "THE SELECTED SMOOTHING MODE"
            b$ = "STRING: detailed work, sharp corners. AVERAGE: curves, soft corners. EMA: long curves. INERTIA: fast, flowing lines."
            c$ = "RIGHT-CLICK the panel for example presets (Clean Inking, Smooth Curves, Long Sweeps ...)."
    END SELECT
    IF LEN(a$) THEN PENP_tip$ = a$ + CHR$(10) + b$ + CHR$(10) + c$
END FUNCTION

' The tooltip under a raw pointer, or 0: an id unique per control and segment
' (TOOLTIP.HOVER_BTN_IDX), with its text in txt. Only while the panel is the
' top thing under the pointer, and not over its title bar (the dock handle).
FUNCTION PENP_tip_at% (rawX AS INTEGER, rawY AS INTEGER, txt AS STRING)
    DIM nx AS INTEGER, ny AS INTEGER, ctl AS INTEGER, sg AS INTEGER, tb AS INTEGER
    txt$ = ""
    IF PENP_active_hit%(rawX%, rawY%) = 0 _ORELSE PENP.renderScale! <= 0 THEN EXIT FUNCTION
    IF PENP.dragging% _ORELSE PENP.sliding% <> PENP_CTL_NONE THEN EXIT FUNCTION
    IF REGION_hit_test%(rawX%, rawY%) <> REGION_PEN_PANEL THEN EXIT FUNCTION
    nx% = INT((rawX% - PENP.dispX%) / PENP.renderScale!)
    ny% = INT((rawY% - PENP.dispY%) / PENP.renderScale!)
    IF ny% < FPANEL.titleH% THEN EXIT FUNCTION
    ctl% = PENP_hit%(nx%, ny%)
    IF ctl% <> PENP_CTL_NONE THEN
        IF PENP_seg_count%(ctl%) > 0 THEN sg% = PENP_seg_at%(ctl%, nx%)
        txt$ = PENP_tip$(ctl%, sg%)
        PENP_tip_at% = ctl% * 10 + sg% + 1
        EXIT FUNCTION
    END IF
    tb% = PENP_tab%
    ctl% = 0
    SELECT CASE tb%
        CASE PENP_TAB_PRESSURE
            IF ny% >= PENP.yMeter% - 1 _ANDALSO ny% <= PENP.yMeter% + FPANEL.sliderH% _ANDALSO nx% >= PENP_ctlX0(PENP_CTL_ON) _ANDALSO nx% <= PENP_ctlX1(PENP_CTL_ON) THEN ctl% = PENP_TIP_METER
            IF ny% >= PENP.yGraph% _ANDALSO ny% < PENP.yGraph% + PENP.graphH% _ANDALSO nx% >= PENP.gx0% _ANDALSO nx% <= PENP.gx1% THEN ctl% = PENP_TIP_GRAPH
        CASE PENP_TAB_SMOOTH
            IF nx% >= PENP.hbx0% _ANDALSO nx% <= PENP.hbx1% _ANDALSO ny% >= PENP.hby0% _ANDALSO ny% <= PENP.hby1% _ANDALSO PENP.hby1% - PENP.hby0% >= FPANEL.fontH% + 4 THEN ctl% = PENP_TIP_HINT
        CASE PENP_TAB_SPEED
            IF nx% >= PENP.sgx0% _ANDALSO nx% <= PENP.sgx1% _ANDALSO ny% >= PENP.sgy0% _ANDALSO ny% <= PENP.sgy1% THEN ctl% = PENP_TIP_SPEED_GRAPH
            IF nx% >= PENP.rdX% _ANDALSO nx% <= PENP.rdX1% _ANDALSO ny% >= PENP.rdY% - 1 _ANDALSO ny% <= PENP.rdY% + _IIF(PENP.inRow% <> 0, 3, 1) * (FPANEL.fontH% + FPANEL.gap%) THEN ctl% = PENP_TIP_READOUT
    END SELECT
    IF ctl% = 0 THEN EXIT FUNCTION
    txt$ = PENP_tip$(ctl%, 0)
    PENP_tip_at% = ctl% * 10 + 1
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_command — The command palette's Pen Control actions (PENP_ACT_*): the
' same CFG keys as the panel and Settings, saved, said on the status bar.
' ---------------------------------------------------------------------------
SUB PENP_command (act AS INTEGER)
    DIM a AS INTEGER, msg AS STRING, sm AS INTEGER
    a% = act% ' (by reference: copy)
    SELECT CASE a%
        CASE PENP_ACT_STAB
            CFG.PEN_STAB% = (CFG.PEN_STAB% = 0)
            msg$ = "Smoothing " + _IIF(CFG.PEN_STAB%, "on", "off")
        CASE PENP_ACT_STAB_MODE
            sm% = _MAX(STAB_PULLED, _MIN(STAB_MODE_COUNT, CFG.PEN_STAB_MODE%)) + 1
            IF sm% > STAB_MODE_COUNT THEN sm% = STAB_PULLED
            CFG.PEN_STAB_MODE% = sm%
            CFG.PEN_STAB% = TRUE
            msg$ = "Smoothing: " + PENP_item$("Pulled String|Moving Average|Exponential MA|Inertia", sm%)
        CASE PENP_ACT_STAB_UP, PENP_ACT_STAB_DOWN
            CFG.PEN_STAB_AMOUNT% = _MAX(0, _MIN(100, CFG.PEN_STAB_AMOUNT% + _IIF(a% = PENP_ACT_STAB_UP, 5, -5)))
            CFG.PEN_STAB% = TRUE
            msg$ = "Smoothing amount " + _TRIM$(STR$(CFG.PEN_STAB_AMOUNT%))
        CASE PENP_ACT_PROC
            CFG.PEN_PROC% = (CFG.PEN_PROC% = 0)
            msg$ = "Pressure smoothing " + _IIF(CFG.PEN_PROC%, "on", "off")
        CASE PENP_ACT_SPEED
            CFG.PEN_SPEED% = (CFG.PEN_SPEED% = 0)
            msg$ = "Speed scaling " + _IIF(CFG.PEN_SPEED%, "on", "off")
        CASE ELSE: EXIT SUB
    END SELECT
    CONFIG_save
    STATUS_flash msg$
    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

' ---------------------------------------------------------------------------
' PENP_needs_redraw% — TRUE when the live meter is out of date (pen moving),
' or on the SPEED tab the speed readout / graph.
' ---------------------------------------------------------------------------
FUNCTION PENP_needs_redraw% ()
    PENP_needs_redraw% = FALSE
    IF NOT PENP.visible% OR PENP.autoHidden% THEN EXIT FUNCTION
    IF PENP_tab% = PENP_TAB_SPEED THEN
        DIM sp AS SINGLE
        IF PSPD.started THEN sp! = PSPD.speed
        PENP_needs_redraw% = (ABS(sp! - PENP.lastSpeed!) > 2 _ORELSE PSPD.topSpeed <> PENP.lastTop!)
        EXIT FUNCTION
    END IF
    IF PENP_tab% <> PENP_TAB_PRESSURE THEN EXIT FUNCTION
    IF NOT CFG.PEN_PRESSURE% OR NOT TABLET.ready THEN EXIT FUNCTION
    DIM p AS SINGLE
    IF PD_source% <> PD_SRC_MOUSE THEN p! = PD_raw_pressure!
    PENP_needs_redraw% = (ABS(p! - PENP.lastP!) > 0.004)
END FUNCTION

' ---------------------------------------------------------------------------
' PENP_mouse_input — Title-bar drag/close, checkboxes, slider drags.
' Called from MOUSE_handle_gui_panels when over the panel or a drag is active.
' ---------------------------------------------------------------------------
SUB PENP_mouse_input ()
    IF NOT PENP.visible% THEN EXIT SUB
    IF PENP.autoHidden% THEN EXIT SUB
    IF NOT PENP.initialized% THEN EXIT SUB

    DIM localX AS INTEGER, localY AS INTEGER
    localX% = MOUSE.RAW_X% - PENP.dispX%
    localY% = MOUSE.RAW_Y% - PENP.dispY%
    DIM nativeX AS INTEGER, nativeY AS INTEGER
    IF PENP.renderScale! > 0 THEN
        nativeX% = INT(localX% / PENP.renderScale!)
        nativeY% = INT(localY% / PENP.renderScale!)
    ELSE
        nativeX% = localX% : nativeY% = localY%
    END IF
    DIM justPressed AS INTEGER : justPressed% = (MOUSE.B1% AND NOT MOUSE.OLD_B1%)
    IF DOCK_UI.menuOpen _ANDALSO PENP.dragging% = 0 _ANDALSO PENP.sliding% = PENP_CTL_NONE THEN EXIT SUB ' (an open menu: the click is the menu's)

    ' Right-click the panel (not its title, which is the dock handle): the presets menu
    IF MOUSE.B2% _ANDALSO MOUSE.OLD_B2% = 0 _ANDALSO PENP.dragging% = 0 _ANDALSO PENP.sliding% = PENP_CTL_NONE THEN
        IF localX% >= 0 _ANDALSO localX% < PENP.dispW% _ANDALSO localY% >= 0 _ANDALSO localY% < PENP.dispH% _ANDALSO nativeY% >= FPANEL.titleH% THEN
            PENPR_menu_open MOUSE.RAW_X%, MOUSE.RAW_Y%
            EXIT SUB
        END IF
    END IF

    ' Middle-click a slider: its default (the universal value input)
    IF MOUSE.B3% _ANDALSO MOUSE.OLD_B3% = 0 _ANDALSO PENP.dragging% = 0 _ANDALSO PENP.sliding% = PENP_CTL_NONE THEN
        DIM ppMid AS INTEGER
        ppMid = PENP_ctl_at_pointer%
        IF PENP_is_slider%(ppMid) THEN
            IF PENP_slider_val%(ppMid, VAL_OP_RESET, 0) THEN CONFIG_save
            SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
            EXIT SUB
        END IF
    END IF

    ' Active title-bar drag
    IF PENP.dragging% THEN
        IF MOUSE.B1% THEN
            DOCK_native_drag DP_PEN, MOUSE.RAW_X%, MOUSE.RAW_Y% ' over a dock target: preview
            DIM ppPrevX AS INTEGER, ppPrevY AS INTEGER
            ppPrevX% = PENP.dispX% : ppPrevY% = PENP.dispY%
            PENP.dispX% = PENP.dragStartDX% + (MOUSE.RAW_X% - PENP.dragStartMX%)
            PENP.dispY% = PENP.dragStartDY% + (MOUSE.RAW_Y% - PENP.dragStartMY%)
            PENP_clamp_to_work_area
            FPANEL_place REGION_PEN_PANEL, PENP.dispX%, PENP.dispY%, PENP.dispW%, PENP.dispH%, ppPrevX%, ppPrevY%
            PENP_clamp_to_work_area
        ELSE
            IF DOCK_native_drag_end%(DP_PEN) THEN PENP.dragging% = FALSE: EXIT SUB ' docked
            PENP.dragging% = FALSE
            CONFIG_save
        END IF
        CFG.PEN_PANEL_X% = PENP.dispX%
        CFG.PEN_PANEL_Y% = PENP.dispY%
        SCENE_DIRTY%     = TRUE : FRAME_IDLE% = FALSE
        EXIT SUB
    END IF

    ' Active slider drag
    IF PENP.sliding% <> PENP_CTL_NONE THEN
        IF MOUSE.B1% THEN
            PENP_slider_set PENP.sliding%, PENP_track_frac!(PENP.sliding%, nativeX%)
        ELSE
            PENP.sliding% = PENP_CTL_NONE
            CONFIG_save
        END IF
        SCENE_DIRTY% = TRUE : FRAME_IDLE% = FALSE
        EXIT SUB
    END IF

    IF NOT justPressed% THEN EXIT SUB
    IF localX% < 0 OR localX% >= PENP.dispW% OR localY% < 0 OR localY% >= PENP.dispH% THEN EXIT SUB

    ' Title bar: close button, else start a drag
    IF nativeY% < FPANEL.titleH% THEN
        IF FPANEL_over_close%(nativeX%, nativeY%, PENP.panelW%) THEN
            PENP_toggle
            CONFIG_save
            EXIT SUB
        END IF
        PENP.dragging%    = LAYOUT_unlocked% ' Lock Layout: no move / resize
        PENP.dragStartMX% = MOUSE.RAW_X%
        PENP.dragStartMY% = MOUSE.RAW_Y%
        PENP.dragStartDX% = PENP.dispX%
        PENP.dragStartDY% = PENP.dispY%
        EXIT SUB
    END IF

    DIM ctl AS INTEGER
    ctl% = PENP_hit%(nativeX%, nativeY%)
    SELECT CASE ctl%
        CASE PENP_CTL_ON:      CFG.PEN_PRESSURE% = NOT CFG.PEN_PRESSURE% : CONFIG_save
        CASE PENP_CTL_SIZE_ON: CFG.PEN_PRESSURE_SIZE% = NOT CFG.PEN_PRESSURE_SIZE% : CONFIG_save
        CASE PENP_CTL_OPAC_ON: CFG.PEN_PRESSURE_OPACITY% = NOT CFG.PEN_PRESSURE_OPACITY% : CONFIG_save
        CASE PENP_CTL_MIX_ON:  CFG.PEN_PRESSURE_MIX% = NOT CFG.PEN_PRESSURE_MIX% : CONFIG_save
        CASE PENP_CTL_STAB_ON:   CFG.PEN_STAB% = (CFG.PEN_STAB% = 0): CONFIG_save
        CASE PENP_CTL_CATCH:     CFG.PEN_STAB_CATCHUP% = (CFG.PEN_STAB_CATCHUP% = 0): CONFIG_save
        CASE PENP_CTL_GUIDE_LN:  CFG.PEN_STAB_GUIDE_LINE% = (CFG.PEN_STAB_GUIDE_LINE% = 0): CONFIG_save
        CASE PENP_CTL_GUIDE_CUR: CFG.PEN_STAB_GUIDE_CURSOR% = (CFG.PEN_STAB_GUIDE_CURSOR% = 0): CONFIG_save
        CASE PENP_CTL_PROC_ON:   CFG.PEN_PROC% = (CFG.PEN_PROC% = 0): CONFIG_save
        CASE PENP_CTL_SPD_ON:    CFG.PEN_SPEED% = (CFG.PEN_SPEED% = 0): CONFIG_save
        CASE PENP_CTL_TABS:      CFG.PEN_PANEL_TAB% = PENP_seg_at%(ctl%, nativeX%): CONFIG_save
        CASE PENP_CTL_STAB_MODE: CFG.PEN_STAB_MODE% = PENP_seg_at%(ctl%, nativeX%) + 1: CONFIG_save
        CASE PENP_CTL_PROC_MODE: CFG.PEN_PROC_MODE% = PENP_seg_at%(ctl%, nativeX%) + 1: CONFIG_save
        CASE PENP_CTL_NONE
        CASE ELSE ' a slider (a double-click: its default)
            IF VAL_dbl%(DP_PEN * 1000& + ctl%) _ANDALSO PENP_is_slider%(ctl%) THEN
                IF PENP_slider_val%(ctl%, VAL_OP_RESET, 0) THEN CONFIG_save
            ELSE
                PENP.sliding% = ctl%
                PENP_slider_set ctl%, PENP_track_frac!(ctl%, nativeX%)
            END IF
    END SELECT
    IF ctl% <> PENP_CTL_NONE THEN SCENE_DIRTY% = TRUE : FRAME_IDLE% = FALSE
END SUB
