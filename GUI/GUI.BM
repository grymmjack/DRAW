''
' DRAW - GUI/GUI.BM
' =============================================================================
' Subs and functions related to GUI and tool management.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE


''
' Reset all tool states (except marquee selection).
' Call this when switching tools to ensure clean state.
' 
' Resets drawing tools (line, rect, ellipse, polygon, spray), 
' interactive tools (move, zoom), and deactivates special modes (fill, picker).
' 
' DOES NOT reset marquee - selection is preserved as a clipping mask across tool switches.
'
' @param includeMarquee INTEGER TRUE to also reset marquee selection, FALSE to preserve it (default: FALSE)
'
SUB TOOLS_reset_all (includeMarquee AS INTEGER)
    ' Commit an active TRANSFORM overlay before switching tools (BUG-2, v2.0.0).
    ' Otherwise TRANSFORM.ACTIVE stays TRUE and the overlay keeps baking its warped
    ' preview onto the canvas every frame — pixels that live on no layer, so the eraser
    ' cannot remove them until the file is reloaded ("content I can't erase until reload").
    ' TRANSFORM_commit restores CURRENT_TOOL% = TRANSFORM.PREV_TOOL, so preserve the
    ' caller's destination tool (already assigned before TOOLS_reset_all runs).
    IF TRANSFORM.ACTIVE THEN
        DIM destTool AS INTEGER
        destTool% = CURRENT_TOOL%
        TRANSFORM_commit
        CURRENT_TOOL% = destTool%
    END IF

    ' Cancel crop mode if active (before marquee reset, since crop uses marquee)
    IF CROP.STATE = CROP_STATE_ACTIVE THEN
        CROP_cancel
    END IF

    ' Reset drawing shape tools
    LINE_reset
    RECT_reset
    ELLIPSE_reset
    POLY_LINE_cancel_restore          ' roll the partial polygon's canvas back on switch (BUG-6:
    ' match BEZIER_cancel_restore below, not a bare reset — guarded, no-op if none in progress)
    BEZIER_cancel_restore
    SS_POLYGON_reset
    SS_PIE_DONUT_reset
    SS_RR_reset
    SS_TAB_reset
    SS_PILL_reset
    SS_PACMAN_reset
    SS_CUBE_reset
    SS_BEVEL_reset
    SS_ARROW_reset
    SS_TEXT_reset

    ' Reset interactive tools
    MOVE_reset
    SPRAY_reset
    ZOOM_drag_reset
    TEXT_reset
    ERASER_reset
    
    ' Deactivate special modes
    FILL_deactivate
    PICKER_deactivate
    
    ' Optionally reset marquee and magic wand (usually we preserve selection as clipping mask)
    IF includeMarquee% THEN
        MARQUEE_reset
        MAGIC_WAND_reset
    END IF
    
    ' Mark GUI for redraw to update toolbar button states
    GUI_NEEDS_REDRAW% = TRUE
END SUB
