''
' DRAW - GUI/TOOLTIP.BM
' =============================================================================
' Tooltip rendering and hover-delay logic for toolbar buttons, organizer
' widgets, and drawer mini palette.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Returns the toolbar button order index (0..TB_TOTAL-1) under the mouse,
' or -1 if not hovering any button.
' @param mouseX INTEGER Raw screen X coordinate of the mouse cursor
' @param mouseY INTEGER Raw screen Y coordinate of the mouse cursor
' @return INTEGER - Toolbar button order index (0..TB_TOTAL-1), or -1 if none
'
FUNCTION TOOLTIP_get_hovered_btn_idx% (inX%, inY%)
    DIM AS INTEGER i, btnIdx, x, y, w, h
    DIM AS INTEGER scale, scaled_w, scaled_h
    DIM mouseX AS INTEGER, mouseY AS INTEGER

    TOOLTIP_get_hovered_btn_idx% = -1
    ' the slots are where the toolbox was last drawn: not shown now (hidden,
    ' collapsed, an inactive tab) means another panel or the canvas is there
    IF NOT TOOLBAR_is_over_area%(inX%, inY%) THEN EXIT FUNCTION
    mouseX = PSURF_mx%(DP_TOOLBOX, inX%): mouseY = PSURF_my%(DP_TOOLBOX, inY%) ' (in its units at its own Scale: GUI/PANEL-SURFACE)

    ' the buttons are drawn at the toolbar's scale (TOOLBAR_render), not the tooltip's
    scale% = TOOLBAR_scale%
    IF scale% < 1 THEN scale% = 1
    IF scale% > 4 THEN scale% = 4

    scaled_w% = TB_BTN_W * scale%
    scaled_h% = TB_BTN_H * scale%

    FOR i% = 0 TO TB_LIVE_COUNT - 1
        btnIdx% = TOOLBAR_BUTTON_ORDER(i%)
        IF btnIdx% < 0 THEN GOTO TOOLTIP_hover_next
        x% = TB_SLOT_X(i%) ' where the slot was drawn (a command has no GUI_TB entry)
        y% = TB_SLOT_Y(i%)
        w% = scaled_w%
        h% = scaled_h%

        IF mouseX% >= x% AND mouseX% < x% + w% AND mouseY% >= y% AND mouseY% < y% + h% THEN
            TOOLTIP_get_hovered_btn_idx% = i%
            EXIT FUNCTION
        END IF
        TOOLTIP_hover_next:
    NEXT i%

    TOOLTIP_get_hovered_btn_idx% = -1
END FUNCTION

''
' Returns the organizer widget index (0..ORG_WIDGET_COUNT-1) under the mouse,
' or -1 if not hovering any widget.
' @param mouseX INTEGER Raw screen X coordinate of the mouse cursor
' @param mouseY INTEGER Raw screen Y coordinate of the mouse cursor
' @return INTEGER - Organizer widget index (0..ORG_WIDGET_COUNT-1), or -1 if none
'
FUNCTION TOOLTIP_get_hovered_org_idx% (inX%, inY%)
    DIM AS INTEGER i, wx, wy, ww, wh
    DIM mouseX AS INTEGER, mouseY AS INTEGER

    ' the widgets are where the organizer was last drawn (see the toolbar's)
    IF NOT ORGANIZER_is_over_area%(inX%, inY%) THEN
        TOOLTIP_get_hovered_org_idx% = -1
        EXIT FUNCTION
    END IF
    mouseX = PSURF_mx%(DP_ORGANIZER, inX%): mouseY = PSURF_my%(DP_ORGANIZER, inY%) ' (in its units at its own Scale: GUI/PANEL-SURFACE)

    FOR i% = 0 TO ORG_WIDGET_COUNT - 1
        wx% = ORG_WIDGETS(i%).x%
        wy% = ORG_WIDGETS(i%).y%
        ww% = ORG_WIDGETS(i%).w%
        wh% = ORG_WIDGETS(i%).h%

        IF mouseX% >= wx% AND mouseX% < wx% + ww% AND mouseY% >= wy% AND mouseY% < wy% + wh% THEN
            TOOLTIP_get_hovered_org_idx% = i%
            EXIT FUNCTION
        END IF
    NEXT i%

    TOOLTIP_get_hovered_org_idx% = -1
END FUNCTION

''
' Returns TRUE if the mouse is over the drawer mini palette.
' @param mouseX INTEGER Raw screen X coordinate of the mouse cursor
' @param mouseY INTEGER Raw screen Y coordinate of the mouse cursor
' @return INTEGER - TRUE if hovering over mini palette, FALSE otherwise
'
FUNCTION TOOLTIP_get_hovered_mini_pal% (mouseX%, mouseY%)
    IF NOT DRAWER.visible% THEN
        TOOLTIP_get_hovered_mini_pal% = FALSE
        EXIT FUNCTION
    END IF
    TOOLTIP_get_hovered_mini_pal% = (DRAWER_palette_cell_at%(mouseX%, mouseY%) > 0)
END FUNCTION

''
' Returns the edit bar item index (0..EDITBAR_TOTAL_SLOTS-1) under the mouse,
' or -1 if not hovering any button.
' @param mouseX INTEGER Raw screen X
' @param mouseY INTEGER Raw screen Y
' @return INTEGER - Edit bar item index, or -1 if none
'
FUNCTION TOOLTIP_get_hovered_editbar_idx% (mouseX%, mouseY%)
    TOOLTIP_get_hovered_editbar_idx% = -1
    IF NOT SCRN.showEditBar% THEN EXIT FUNCTION
    IF NOT EDITBAR_is_over_area%(mouseX%, mouseY%) THEN EXIT FUNCTION
    TOOLTIP_get_hovered_editbar_idx% = EDITBAR_hit_test%(mouseX%, mouseY%)
END FUNCTION

''
' Returns the advanced bar item index (0..ADVBAR_TOTAL_SLOTS-1) under the mouse,
' or -1 if not hovering any button.
' @param mouseX INTEGER Raw screen X
' @param mouseY INTEGER Raw screen Y
' @return INTEGER - Advanced bar item index, or -1 if none
'
FUNCTION TOOLTIP_get_hovered_advbar_idx% (mouseX%, mouseY%)
    TOOLTIP_get_hovered_advbar_idx% = -1
    IF NOT SCRN.showAdvBar% THEN EXIT FUNCTION
    IF NOT ADVBAR_is_over_area%(mouseX%, mouseY%) THEN EXIT FUNCTION
    TOOLTIP_get_hovered_advbar_idx% = ADVBAR_hit_test%(mouseX%, mouseY%)
END FUNCTION

''
' Update tooltip state each frame. Call from DRAW.BAS main loop before idle check.
' Checks toolbar buttons, organizer widgets, and drawer mini palette in priority order.
'
SUB TOOLTIP_update ()
    IF CFG.TOOLTIPS_DISABLED% THEN
        IF TOOLTIP.ACTIVE% THEN
            TOOLTIP.ACTIVE%        = FALSE
            TOOLTIP.HOVER_BTN_IDX% = -1
            TOOLTIP.HOVER_SOURCE%  = TOOLTIP_SRC_NONE
            FRAME_IDLE%            = FALSE
        END IF
        EXIT SUB
    END IF

    DIM newIdx AS INTEGER
    DIM newSrc AS INTEGER
    newIdx% = -1
    newSrc% = TOOLTIP_SRC_NONE

    ' Over a dock handle (grip / title strip) or with the dock menu open: no tooltip
    IF DOCK_UI.hoverSlot <> 0 _ORELSE DOCK_UI.menuOpen THEN GOTO TOOLTIP_UPDATE_HOVER_RESOLVED
    ' A Swatches menu (set list, edit, gear) is open: it has the pointer, no tooltips
    IF SWP.visible _ANDALSO SWP.autoHidden = 0 _ANDALSO SWP.menu <> SWP_MENU_NONE THEN GOTO TOOLTIP_UPDATE_HOVER_RESOLVED

    ' Subtool flyout (Smart Shapes etc.) takes priority when open
    IF SUBTOOL_FLYOUT.ACTIVE THEN
        IF SUBTOOL_FLYOUT.HOVER_CHILD_IDX >= 0 THEN
            newIdx% = SUBTOOL_FLYOUT.HOVER_CHILD_IDX
            newSrc% = TOOLTIP_SRC_SUBTOOL_FLYOUT
        END IF
        GOTO TOOLTIP_UPDATE_HOVER_RESOLVED
    END IF

    ' Advanced color picker: color-history strip (floating panel, high priority)
    IF ADVCP.visible% AND NOT ADVCP.autoHidden% AND ADVCP_over_history_raw%(MOUSE.RAW_X%, MOUSE.RAW_Y%) THEN
        newIdx% = 0                   ' non-negative so the tooltip activates
        newSrc% = TOOLTIP_SRC_ACP_HISTORY
        GOTO TOOLTIP_UPDATE_HOVER_RESOLVED
    END IF

    ' X-sheet tag / frame note under the pointer: its whole text (they are cut to fit)
    IF ANIM_XS_hit%(MOUSE.RAW_X%, MOUSE.RAW_Y%) THEN
        DIM xsTip AS INTEGER, xsL1 AS STRING, xsL2 AS STRING
        xsTip% = ANIM_XS_tip%(MOUSE.RAW_X%, MOUSE.RAW_Y%, xsL1$, xsL2$)
        IF xsTip% > 0 THEN
            newIdx% = xsTip%
            newSrc% = TOOLTIP_SRC_ANIM_XS
            TOOLTIP.DYNAMIC_TEXT$ = xsL1$ + CHR$(10) + xsL2$
        END IF
        GOTO TOOLTIP_UPDATE_HOVER_RESOLVED
    END IF

    ' Pen Control panel: what the control under the pointer does, and an example
    DIM penTip AS INTEGER, penTxt AS STRING
    penTip% = PENP_tip_at%(MOUSE.RAW_X%, MOUSE.RAW_Y%, penTxt$)
    IF penTip% > 0 THEN
        newIdx% = penTip%
        newSrc% = TOOLTIP_SRC_PEN_PANEL
        TOOLTIP.DYNAMIC_TEXT$ = penTxt$
        GOTO TOOLTIP_UPDATE_HOVER_RESOLVED
    END IF

    ' Selection Bar: what the control under the pointer is and does
    DIM sbTip AS INTEGER, sbTxt AS STRING
    sbTip% = SELBAR_tip_at%(MOUSE.RAW_X%, MOUSE.RAW_Y%, sbTxt$)
    IF sbTip% > 0 THEN
        newIdx% = sbTip%
        newSrc% = TOOLTIP_SRC_SEL_BAR
        TOOLTIP.DYNAMIC_TEXT$ = sbTxt$
        GOTO TOOLTIP_UPDATE_HOVER_RESOLVED
    END IF
    ' the MyPaint Brush Settings / brush palette: the same kind of text (ids 900+ / 950+)
    sbTip% = MPS_tip_at%(MOUSE.RAW_X%, MOUSE.RAW_Y%, sbTxt$)
    IF sbTip% = 0 THEN sbTip% = BSP_tip_at%(MOUSE.RAW_X%, MOUSE.RAW_Y%, sbTxt$)
    IF sbTip% > 0 THEN
        newIdx% = sbTip%
        newSrc% = TOOLTIP_SRC_SEL_BAR
        TOOLTIP.DYNAMIC_TEXT$ = sbTxt$
        GOTO TOOLTIP_UPDATE_HOVER_RESOLVED
    END IF

    ' Check toolbar buttons first
    DIM tbIdx AS INTEGER
    tbIdx% = TOOLTIP_get_hovered_btn_idx%(MOUSE.RAW_X%, MOUSE.RAW_Y%)
    IF tbIdx% >= 0 THEN
        newIdx% = tbIdx%
        newSrc% = TOOLTIP_SRC_TOOLBAR
    ELSE
        ' Check organizer widgets
        DIM orgIdx AS INTEGER
        orgIdx% = TOOLTIP_get_hovered_org_idx%(MOUSE.RAW_X%, MOUSE.RAW_Y%)
        IF orgIdx% >= 0 THEN
            newIdx% = orgIdx%
            newSrc% = TOOLTIP_SRC_ORGANIZER
        ELSE
            ' Check edit bar buttons
            DIM ebIdx AS INTEGER
            ebIdx% = TOOLTIP_get_hovered_editbar_idx%(MOUSE.RAW_X%, MOUSE.RAW_Y%)
            IF ebIdx% >= 0 THEN
                newIdx% = ebIdx%
                newSrc% = TOOLTIP_SRC_EDITBAR
            ELSE
                ' Check advanced bar buttons
                DIM abIdx AS INTEGER
                abIdx% = TOOLTIP_get_hovered_advbar_idx%(MOUSE.RAW_X%, MOUSE.RAW_Y%)
                IF abIdx% >= 0 THEN
                    newIdx% = abIdx%
                    newSrc% = TOOLTIP_SRC_ADVBAR
                ELSE
                    ' Check drawer bins (slots)
                    IF DRAWER.visible% AND DRAWER_is_over_slot%(MOUSE.RAW_X%, MOUSE.RAW_Y%) THEN
                        newIdx% = 0
                        newSrc% = TOOLTIP_SRC_BINS
                    ELSEIF TOOLTIP_get_hovered_mini_pal%(MOUSE.RAW_X%, MOUSE.RAW_Y%) THEN
                        newIdx% = 0
                        newSrc% = TOOLTIP_SRC_MINI_PAL
                    ELSE
                        ' Check layer panel rows — show opacity % over bar, full name elsewhere
                        DIM lnSlot AS INTEGER
                        lnSlot% = LAYER_PANEL_get_row_slot%(MOUSE.RAW_X%, MOUSE.RAW_Y%)
                        IF lnSlot% > 0 THEN
                            newIdx% = lnSlot%
                            ' Determine if hovering over the vertical opacity bar (right edge)
                            DIM lpLocalX AS INTEGER
                            lpLocalX% = PSURF_mx%(DP_LAYERS, MOUSE.RAW_X%) - LAYER_PANEL.panelX1% ' (its units: GUI/PANEL-SURFACE)

                            ' Row-relative Y, so the "no paint" badge can be told
                            ' apart from the blend abbreviation sharing its column
                            ' on the row above it.
                            DIM lpTipListTop AS INTEGER
                            DIM lpTipRowY    AS INTEGER
                            lpTipListTop% = LAYER_PANEL_top% + LAYER_LIST_top_off%
                            lpTipRowY%    = (PSURF_my%(DP_LAYERS, MOUSE.RAW_Y%) - lpTipListTop% + LAYER_PANEL.scrollOffset%) MOD LAYER_ROW_H%
                            lpTipRowY%    = lpTipRowY% - (LAYER_ROW_H% - LAYER_ROW_HEIGHT_MIN) \ 2 ' the 20 px line is centred in a thumbnail row

                            ' Group header "not paintable" badge — drawn at
                            ' panelW-19-8 .. panelW-20 on the second text line
                            ' (y+11..y+18). Checked before the opacity bar; the
                            ' two bands do not overlap, but this keeps the more
                            ' specific test first.
                            IF LAYERS(lnSlot%).layerType% = LAYER_TYPE_GROUP _
                               AND LAYER_PANEL_w% >= 80 _
                               AND lpLocalX% >= LAYER_PANEL_w% - 27 AND lpLocalX% <= LAYER_PANEL_w% - 20 _
                               AND lpTipRowY% >= 11 AND lpTipRowY% <= 18 THEN
                                newSrc%               = TOOLTIP_SRC_LAYER_NO_PAINT
                                TOOLTIP.DYNAMIC_TEXT$ = ""
                            ELSEIF LAYER_PANEL_w% >= 80 AND lpLocalX% >= LAYER_PANEL_w% - 17 AND lpLocalX% <= LAYER_PANEL_w% - 11 THEN
                                DIM opPct AS INTEGER
                                opPct%                = INT((LAYERS(lnSlot%).opacity% / 255.0) * 100 + 0.5)
                                TOOLTIP.DYNAMIC_TEXT$ = LTRIM$(STR$(opPct%)) + "%"
                                newSrc%               = TOOLTIP_SRC_LAYER_OPACITY
                            ELSE
                                newSrc%               = TOOLTIP_SRC_LAYER_NAME
                                TOOLTIP.DYNAMIC_TEXT$ = _TRIM$(LAYERS(lnSlot%).name)
                                ' AI layers show what produced them: the full
                                ' prompt (the row name is truncated), then the
                                ' engine/style/seed needed to reproduce it.
                                IF CFG.AI_ENABLED% <> 0 THEN
                                    IF LAYERS(lnSlot%).layerType% = LAYER_TYPE_AI AND LAYERS(lnSlot%).aiDataIdx% >= 1 THEN
                                        DIM aiTipPool AS INTEGER
                                        aiTipPool% = LAYERS(lnSlot%).aiDataIdx%
                                        DIM aiTip2    AS STRING
                                        aiTip2$ = RTRIM$(AI_LAYER_DATA(aiTipPool%).toolName)
                                        IF LEN(RTRIM$(AI_LAYER_DATA(aiTipPool%).modelName)) > 0 THEN
                                            aiTip2$ = aiTip2$ + " / " + RTRIM$(AI_LAYER_DATA(aiTipPool%).modelName)
                                        END IF
                                        IF LEN(RTRIM$(AI_LAYER_DATA(aiTipPool%).styleName)) > 0 THEN
                                            aiTip2$ = aiTip2$ + " / " + RTRIM$(AI_LAYER_DATA(aiTipPool%).styleName)
                                        END IF
                                        aiTip2$ = aiTip2$ + " / seed " + _TRIM$(STR$(AI_LAYER_DATA(aiTipPool%).seedVal))
                                        TOOLTIP.DYNAMIC_TEXT$ = RTRIM$(AI_LAYER_DATA(aiTipPool%).prompt) + CHR$(10) + aiTip2$
                                    END IF
                                END IF
                            END IF
                        END IF
                    END IF
                END IF
            END IF
        END IF
    END IF

    TOOLTIP_UPDATE_HOVER_RESOLVED:

    ' If hover target changed, reset timer
    IF newIdx% <> TOOLTIP.HOVER_BTN_IDX% OR newSrc% <> TOOLTIP.HOVER_SOURCE% THEN
        TOOLTIP.HOVER_BTN_IDX% = newIdx%
        TOOLTIP.HOVER_SOURCE%  = newSrc%
        TOOLTIP.ACTIVE%        = FALSE
        TOOLTIP.NEEDS_REDRAW%  = TRUE ' Force one redraw to clear old tooltip
        FRAME_IDLE%            = FALSE
        IF newIdx% >= 0 THEN
            TOOLTIP.HOVER_START# = TIMER
        ELSE
            TOOLTIP.HOVER_START# = 0
        END IF
        EXIT SUB
    END IF

    ' Not over anything
    IF newIdx% < 0 THEN
        TOOLTIP.ACTIVE% = FALSE
        EXIT SUB
    END IF

    ' Check if delay has elapsed
    IF NOT TOOLTIP.ACTIVE% THEN
        DIM elapsed AS DOUBLE
        elapsed# = TIMER - TOOLTIP.HOVER_START#
        ' Handle TIMER wraparound at midnight
        IF elapsed# < 0 THEN elapsed# = elapsed# + 86400
        IF elapsed# * 1000 >= CFG.TOOLTIP_HOVER_DELAY_MS% THEN
            TOOLTIP.ACTIVE%       = TRUE
            TOOLTIP.NEEDS_REDRAW% = TRUE ' Force one redraw to show new tooltip
        END IF
    END IF
END SUB

''
' Reset tooltip state (e.g., when clicking or switching tools).
'
SUB TOOLTIP_reset ()
    TOOLTIP.ACTIVE%        = FALSE
    TOOLTIP.HOVER_BTN_IDX% = -1
    TOOLTIP.HOVER_SOURCE%  = TOOLTIP_SRC_NONE
    TOOLTIP.HOVER_START#   = 0
    TOOLTIP.NEEDS_REDRAW%  = FALSE
END SUB

''
' Render the tooltip onto the given target image handle.
' Called from SCREEN_render after final overlay popups.
' @param target LONG Destination image handle to draw the tooltip onto
'
''
' TOOLTIP_wrap_line — greedy word-wrap `text$` to at most `maxPixW%` pixels per
' visual line using the CURRENT _FONT, appending each visual line to outRows() and
' its bold flag to outBold() (fixed-size, 1-based arrays) while advancing rowCount%.
'
' Shared by every tooltip renderer -- the floating TOOLTIP_render and the Settings
' dialog's SW_draw_tooltip -- so a tooltip wraps to fit WHATEVER container the caller
' passes as maxPixW% (the window for floating tooltips, the dialog content area for
' dialog tooltips) instead of assuming the screen and spilling off / clipping.
'
' Breaks on spaces; a single word wider than maxPixW% is hard-broken by character so
' nothing ever exceeds the budget. Stops when outRows() is full. The caller sets the
' font first (measurement uses it) and passes its running row total as rowCount%, so
' several logical lines can be wrapped into one shared array.
' @param text$    STRING  One logical line of tooltip text
' @param isBold%  INTEGER Bold flag stamped on every visual row this line produces
' @param maxPixW% INTEGER Max content width in pixels (the caller's container)
' @param outRows() STRING  (out) visual rows appended here
' @param outBold() INTEGER (out) per-row bold flag
' @param rowCount% INTEGER (in/out) running row count
'
SUB TOOLTIP_wrap_line (text$, isBold%, maxPixW%, outRows() AS STRING, outBold() AS INTEGER, rowCount%)
    IF LEN(text$) = 0 THEN EXIT SUB
    ' an explicit line break (CHR$(10)) starts a new row: tall, one-per-line tips
    DIM nlAt AS INTEGER, nlRest AS STRING, nlSeg AS STRING
    nlAt% = INSTR(text$, CHR$(10))
    IF nlAt% > 0 THEN
        nlRest$ = text$
        DO WHILE LEN(nlRest$) > 0
            nlAt% = INSTR(nlRest$, CHR$(10))
            IF nlAt% = 0 THEN nlSeg$ = nlRest$: nlRest$ = "" ELSE nlSeg$ = LEFT$(nlRest$, nlAt% - 1): nlRest$ = MID$(nlRest$, nlAt% + 1)
            TOOLTIP_wrap_line nlSeg$, isBold%, maxPixW%, outRows(), outBold(), rowCount%
        LOOP
        EXIT SUB
    END IF
    DIM maxRows AS INTEGER : maxRows% = UBOUND(outRows)
    IF rowCount% >= maxRows% THEN EXIT SUB
    DIM budget  AS INTEGER : budget% = maxPixW%
    IF budget% < 8 THEN budget% = 8
    DIM s       AS STRING, curLine AS STRING, wrd AS STRING, testLine AS STRING
    DIM sp      AS INTEGER, cut AS INTEGER
    s$ = text$ : curLine$ = ""
    DO WHILE LEN(s$) > 0 _ANDALSO rowCount% < maxRows%
        sp% = INSTR(s$, " ")
        IF sp% = 0 THEN
            wrd$ = s$ : s$ = ""
        ELSE
            wrd$ = LEFT$(s$, sp% - 1) : s$ = MID$(s$, sp% + 1)
        END IF
        IF LEN(wrd$) > 0 THEN
            ' Hard-break a word too wide to ever fit on one line.
            DO WHILE rowCount% < maxRows% _ANDALSO LEN(wrd$) > 1 _ANDALSO _PRINTWIDTH(wrd$) > budget%
                cut% = LEN(wrd$) - 1
                DO WHILE cut% > 1 _ANDALSO _PRINTWIDTH(LEFT$(wrd$, cut%)) > budget%
                    cut% = cut% - 1
                LOOP
                IF LEN(curLine$) > 0 THEN
                    rowCount% = rowCount% + 1 : outRows(rowCount%) = curLine$ : outBold(rowCount%) = isBold%
                    curLine$ = ""
                    IF rowCount% >= maxRows% THEN EXIT SUB
                END IF
                rowCount% = rowCount% + 1 : outRows(rowCount%) = LEFT$(wrd$, cut%) : outBold(rowCount%) = isBold%
                wrd$ = MID$(wrd$, cut% + 1)
            LOOP
            IF rowCount% >= maxRows% THEN EXIT DO
            IF LEN(curLine$) = 0 THEN
                testLine$ = wrd$
            ELSE
                testLine$ = curLine$ + " " + wrd$
            END IF
            IF _PRINTWIDTH(testLine$) <= budget% THEN
                curLine$ = testLine$
            ELSE
                IF LEN(curLine$) > 0 THEN
                    rowCount% = rowCount% + 1 : outRows(rowCount%) = curLine$ : outBold(rowCount%) = isBold%
                END IF
                curLine$ = wrd$
            END IF
        END IF
    LOOP
    IF LEN(curLine$) > 0 _ANDALSO rowCount% < maxRows% THEN
        rowCount% = rowCount% + 1 : outRows(rowCount%) = curLine$ : outBold(rowCount%) = isBold%
    END IF
END SUB


SUB TOOLTIP_render (target&)
    ' Clear render bounds — prevents stale reblit if we exit early this frame.
    TOOLTIP.RENDER_W% = 0
    IF NOT TOOLTIP.ACTIVE% THEN EXIT SUB
    IF TOOLTIP.HOVER_BTN_IDX% < 0 THEN EXIT SUB

    ' Hide tooltip if any mouse button is down or a menu/popup is open
    ' EXCEPT when hovering over the subtool flyout — that flyout REQUIRES
    ' B1 to be held down to stay open, so tooltips must show during hold.
    IF TOOLTIP.HOVER_SOURCE% <> TOOLTIP_SRC_SUBTOOL_FLYOUT THEN
        IF MOUSE.B1% OR MOUSE.B2% OR MOUSE.B3% THEN EXIT SUB
    END IF
    IF POPUP_tips_blocked% THEN EXIT SUB ' a menu / popup is open (the registry, GUI/POPUP-MENU)

    DIM AS INTEGER idx
    idx% = TOOLTIP.HOVER_BTN_IDX%

    ' Resolve tooltip text based on hover source
    DIM line1$, line2$, line3$
    SELECT CASE TOOLTIP.HOVER_SOURCE%
        CASE TOOLTIP_SRC_TOOLBAR
            IF idx% < 0 _ORELSE idx% >= TB_LIVE_COUNT THEN EXIT SUB
            ' Tooltip text is keyed by the button's DEFAULT slot, so it follows
            ' the button when a workspace reorders the toolbox.
            DIM tipSlot AS INTEGER
            IF TOOLBAR_BUTTON_ORDER(idx%) >= TB_CMD_BASE THEN
                ' a command placed in the toolbox: its bar tooltip, or its name + hotkey
                BL_cmd_tooltip TOOLBAR_BUTTON_ORDER(idx%) - TB_CMD_BASE, line1$, line2$
                IF LEN(line1$) = 0 THEN EXIT SUB
            ELSE
                tipSlot% = TOOLBAR_default_slot%(TOOLBAR_BUTTON_ORDER(idx%))
                IF tipSlot% < 0 THEN EXIT SUB
                line1$ = TOOLTIP_LINE1$(tipSlot%)
                line2$ = TOOLTIP_LINE2$(tipSlot%)
                ' Smart Shapes parent button: dynamic tooltip per chosen sub-shape
                ' ONLY after the user has actually picked a shape this session;
                ' before that, fall back to the default toolbar tooltip text.
                IF TOOLBAR_BUTTON_ORDER(idx%) = TB_SMART_SHAPES AND SMART_SHAPES_CHOSEN% THEN
                    DIM ssTool AS INTEGER
                    ssTool% = SMART_SHAPES_current_tool_const%
                    line1$  = SMART_SHAPES_tooltip_line1$(ssTool%)
                    line2$  = SMART_SHAPES_tooltip_line2$(ssTool%)
                    line3$  = SMART_SHAPES_tooltip_line3$(ssTool%)
                END IF
            END IF
        CASE TOOLTIP_SRC_SUBTOOL_FLYOUT
            DIM flyTool AS INTEGER
            flyTool% = SMART_SHAPES_child_tool_const%(idx%)
            IF flyTool% < 0 THEN EXIT SUB
            line1$ = SMART_SHAPES_tooltip_line1$(flyTool%)
            line2$ = SMART_SHAPES_tooltip_line2$(flyTool%)
            line3$ = SMART_SHAPES_tooltip_line3$(flyTool%)
        CASE TOOLTIP_SRC_ORGANIZER
            IF idx% > 10 THEN EXIT SUB
            line1$ = TOOLTIP_ORG_LINE1$(idx%)
            line2$ = TOOLTIP_ORG_LINE2$(idx%)
            line3$ = TOOLTIP_ORG_LINE3$(idx%)
            IF idx% = ORG_PALETTE_OPS THEN
                ' Name the cycling toggle by its live binding (follows rebinds)
                DIM ttCycKey AS STRING
                ttCycKey$ = UCASE$(HCARD_key_for_action$(2060))
                IF ttCycKey$ = "" THEN ttCycKey$ = "PALETTE > CYCLE COLORS"
                line3$ = "Hover the strip for the full gesture card. COLOR CYCLING: " + ttCycKey$ + ", then CTRL+drag swatches = range; CTRL+click/R/M/wheel = direction/pause/delete/speed."
            END IF
            IF idx% = ORG_SYMMETRY_MODE THEN
                ' the cycle key follows rebinds; the center pick is a canvas Ctrl+click
                DIM ttSymKey AS STRING
                ttSymKey$ = UCASE$(HCARD_key_for_action$(8007))
                line3$ = "CTRL+L-CLICK on the canvas to set the symmetry center point."
                IF LEN(ttSymKey$) > 0 THEN line3$ = line3$ + " " + ttSymKey$ + " cycles the symmetry type."
            END IF
        CASE TOOLTIP_SRC_EDITBAR, TOOLTIP_SRC_ADVBAR
            ' keyed by the button (its list entry), not its position
            DIM ttPanel AS INTEGER
            IF TOOLTIP.HOVER_SOURCE% = TOOLTIP_SRC_EDITBAR THEN ttPanel = BL_EDITBAR ELSE ttPanel = BL_ADVBAR
            IF idx% < 0 _ORELSE idx% >= BL_N(ttPanel) THEN EXIT SUB
            IF BL(ttPanel, idx%).kind = BL_CMD THEN BL_cmd_tooltip BL(ttPanel, idx%).id, line1$, line2$
            IF BL(ttPanel, idx%).kind = BL_TOOL THEN
                ' a tool placed on a bar: its toolbox tooltip
                DIM ttTb AS INTEGER
                ttTb = TOOLBAR_default_slot%(BL(ttPanel, idx%).id)
                IF ttTb >= 0 THEN line1$ = TOOLTIP_LINE1$(ttTb): line2$ = TOOLTIP_LINE2$(ttTb)
            END IF
            IF LEN(line1$) = 0 THEN EXIT SUB
        CASE TOOLTIP_SRC_MINI_PAL
            line1$ = TOOLTIP_MINI_PAL_LINE1$
            line2$ = TOOLTIP_MINI_PAL_LINE2$
        CASE TOOLTIP_SRC_BINS
            line1$ = TOOLTIP_BINS_LINE1$
            line2$ = TOOLTIP_BINS_LINE2$
        CASE TOOLTIP_SRC_LAYER_NAME, TOOLTIP_SRC_ANIM_XS, TOOLTIP_SRC_SEL_BAR
            ' AI layers pack prompt + metadata into DYNAMIC_TEXT separated by a
            ' newline. The tooltip renderer draws discrete lines and has no
            ' newline handling, so an embedded CHR$(10) would print as a box
            ' glyph — split it out here instead.
            DIM ttNl    AS INTEGER
            ttNl% = INSTR(TOOLTIP.DYNAMIC_TEXT$, CHR$(10))
            IF ttNl% > 0 THEN
                line1$ = LEFT$(TOOLTIP.DYNAMIC_TEXT$, ttNl% - 1)
                line2$ = MID$(TOOLTIP.DYNAMIC_TEXT$, ttNl% + 1)
            ELSE
                line1$ = TOOLTIP.DYNAMIC_TEXT$
                line2$ = ""
            END IF
            IF LEN(line1$) = 0 AND LEN(line2$) = 0 THEN EXIT SUB
        CASE TOOLTIP_SRC_PEN_PANEL
            ' three lines: what it is (bold), how it behaves, TRY: an example
            DIM ttP1 AS INTEGER, ttP2 AS INTEGER
            ttP1% = INSTR(TOOLTIP.DYNAMIC_TEXT$, CHR$(10))
            IF ttP1% = 0 THEN EXIT SUB
            ttP2% = INSTR(ttP1% + 1, TOOLTIP.DYNAMIC_TEXT$, CHR$(10))
            line1$ = LEFT$(TOOLTIP.DYNAMIC_TEXT$, ttP1% - 1)
            IF ttP2% THEN
                line2$ = MID$(TOOLTIP.DYNAMIC_TEXT$, ttP1% + 1, ttP2% - ttP1% - 1)
                line3$ = MID$(TOOLTIP.DYNAMIC_TEXT$, ttP2% + 1)
            ELSE
                line2$ = MID$(TOOLTIP.DYNAMIC_TEXT$, ttP1% + 1)
            END IF
        CASE TOOLTIP_SRC_LAYER_NO_PAINT
            line1$ = "You cannot draw on a group parent layer - only it's children"
        CASE TOOLTIP_SRC_LAYER_OPACITY
            line1$ = "Layer Opacity: " + TOOLTIP.DYNAMIC_TEXT$
            line2$ = "DRAG or MWHEEL to adjust"
        CASE TOOLTIP_SRC_ACP_HISTORY
            line1$ = "L-CLICK: Set FG"
            line2$ = "R-CLICK: History menu"
        CASE ELSE
            EXIT SUB
    END SELECT
    IF LEN(line1$) = 0 AND LEN(line2$) = 0 AND LEN(line3$) = 0 THEN EXIT SUB

    ' UI text is shown UPPERCASE (Rick 2026-11-17). Not the layer-name / X-sheet
    ' tips: those show user data (layer name, AI prompt, frame note) as typed.
    ' Done before wrapping, so the wrap measures the text it draws.
    IF TOOLTIP.HOVER_SOURCE% <> TOOLTIP_SRC_LAYER_NAME _ANDALSO TOOLTIP.HOVER_SOURCE% <> TOOLTIP_SRC_ANIM_XS THEN
        line1$ = UCASE$(line1$): line2$ = UCASE$(line2$): line3$ = UCASE$(line3$)
    END IF

    DIM oldDest AS LONG
    oldDest& = _DEST
    _DEST target&

    ' Lazy-load tooltip font
    IF TOOLTIP.FONT_HANDLE& = 0 THEN
        DIM ttFontFile$
        IF LEN(THEME.TOOLTIP_FONT$) > 0 THEN
            ttFontFile$ = THEME_font_path$(_TRIM$(THEME.TOOLTIP_FONT$))
        ELSE
            ttFontFile$ = THEME_font_path$(THEME.GLOBAL_FONT_FILE$)
        END IF
        DIM ttFontSize AS INTEGER
        ttFontSize% = THEME.TOOLTIP_FONT_SIZE%
        IF ttFontSize% < 4 THEN ttFontSize% = 8
        IF LEN(ttFontFile$) > 0 THEN
            TOOLTIP.FONT_HANDLE& = _LOADFONT(ttFontFile$, ttFontSize%, "DONTBLEND")
            IF TOOLTIP.FONT_HANDLE& <= 0 THEN
                _LOGWARN "TOOLTIP_render: _LOADFONT failed for " + ttFontFile$
                TOOLTIP.FONT_HANDLE& = 0
            END IF
        END IF
    END IF

    ' Set font for measuring
    DIM oldFont AS LONG
    oldFont& = _FONT
    IF TOOLTIP.FONT_HANDLE& > 0 THEN _FONT TOOLTIP.FONT_HANDLE&

    DIM fontH AS INTEGER
    fontH% = _UFONTHEIGHT

    DIM pad AS INTEGER, bw AS INTEGER
    pad% = THEME.TOOLTIP_PADDING%
    IF pad% < 1 THEN pad% = 3
    bw% = THEME.TOOLTIP_BORDER_WIDTH%
    IF bw% < 0 THEN bw% = 1

    ' Word-wrap each logical line to fit this tooltip's container (the window that
    ' `target&` renders to), capped for readability. Long lines used to render past
    ' the right edge; now they wrap. Line 1 stays bold, lines 2-3 normal.
    DIM wrapW AS INTEGER, capPx AS INTEGER, avgCW AS INTEGER
    avgCW% = _PRINTWIDTH("ABCDEFGHIJKLMNOPQRSTUVWXYZ") \ 26 ' (the tips are UPPERCASE: keep the cap in characters)
    IF avgCW% < 1 THEN avgCW% = 1
    capPx% = avgCW% * TOOLTIP_MAX_CONTENT_CHARS
    wrapW% = _WIDTH(target&) - 2 * (pad% + bw%) - 8
    IF wrapW% > capPx% THEN wrapW% = capPx%
    IF wrapW% < 40 THEN wrapW% = 40

    DIM ttRows(1 TO 40) AS STRING, ttBold(1 TO 40) AS INTEGER
    DIM rowCount AS INTEGER
    rowCount% = 0
    TOOLTIP_wrap_line line1$, -1, wrapW%, ttRows(), ttBold(), rowCount%
    TOOLTIP_wrap_line line2$, 0, wrapW%, ttRows(), ttBold(), rowCount%
    TOOLTIP_wrap_line line3$, 0, wrapW%, ttRows(), ttBold(), rowCount%
    IF rowCount% = 0 THEN
        IF oldFont& > 0 THEN _FONT oldFont&
        _DEST oldDest&
        EXIT SUB
    END IF

    ' Widest wrapped row → content width
    DIM maxW AS INTEGER, mi AS INTEGER, rww AS INTEGER
    maxW% = 0
    FOR mi% = 1 TO rowCount%
        rww% = _PRINTWIDTH(ttRows(mi%))
        IF rww% > maxW% THEN maxW% = rww%
    NEXT mi%

    DIM numLines AS INTEGER
    numLines% = rowCount%

    DIM ttW AS INTEGER, ttH AS INTEGER
    ttW% = maxW% + pad% * 2 + bw% * 2
    ttH% = fontH% * numLines% + pad% * 2 + bw% * 2
    IF numLines% > 1 THEN ttH% = ttH% + (numLines% - 1) ' 1px gap between lines

    ' Position tooltip relative to mouse cursor
    DIM ttX AS INTEGER, ttY AS INTEGER
    ttX% = MOUSE.RAW_X% + 8  ' Offset right from cursor
    ttY% = MOUSE.RAW_Y% + 16 ' Offset below cursor

    ' Clamp to screen bounds — never go off-screen
    DIM scrW AS INTEGER, scrH AS INTEGER
    scrW% = _WIDTH(target&)
    scrH% = _HEIGHT(target&)

    ' Prevent going off the right edge
    IF ttX% + ttW% > scrW% - 2 THEN
        ttX% = MOUSE.RAW_X% - ttW% - 4 ' Flip to left of cursor
    END IF
    ' Prevent going off the bottom edge
    IF ttY% + ttH% > scrH% - 2 THEN
        ttY% = MOUSE.RAW_Y% - ttH% - 4 ' Flip above cursor
    END IF
    ' Prevent going off the left edge
    IF ttX% < 2 THEN ttX% = 2
    ' Prevent going off the top edge
    IF ttY% < 2 THEN ttY% = 2

    ' Avoid overlapping the toolbar area
    DIM tbOver AS INTEGER
    tbOver% = TOOLBAR_is_over_area%(ttX%, ttY%)
    IF tbOver% THEN
        ' Push tooltip to the left of the toolbar
        ttX% = TB_RECT_X - ttW% - 4
        IF ttX% < 2 THEN ttX% = 2
    END IF

    ' Store final render bounds so TOOLTIP_reblit_to_screen0 can composite over
    ' floating panels (e.g. Color Mixer) that draw directly to screen 0.
    TOOLTIP.RENDER_X% = ttX%
    TOOLTIP.RENDER_Y% = ttY%
    TOOLTIP.RENDER_W% = ttW%
    TOOLTIP.RENDER_H% = ttH%

    ' Draw tooltip background
    DIM bgColor AS _UNSIGNED LONG, borderColor AS _UNSIGNED LONG
    DIM fgColor AS _UNSIGNED LONG, boldColor AS _UNSIGNED LONG
    bgColor~& = THEME.TOOLTIP_BG_COLOR~&
    IF bgColor~& = 0 THEN bgColor~& = _RGBA32(40, 40, 50, 240)
    borderColor~& = THEME.TOOLTIP_BORDER_COLOR~&
    IF borderColor~& = 0 THEN borderColor~& = _RGBA32(100, 100, 120, 255)
    fgColor~& = THEME.TOOLTIP_FG_COLOR~&
    IF fgColor~& = 0 THEN fgColor~& = _RGBA32(200, 200, 200, 255)
    boldColor~& = THEME.TOOLTIP_BOLD_FG_COLOR~&
    IF boldColor~& = 0 THEN boldColor~& = _RGBA32(255, 255, 100, 255)

    ' Fill background
    LINE (ttX%, ttY%)-(ttX% + ttW% - 1, ttY% + ttH% - 1), bgColor~&, BF

    ' Draw border
    IF bw% > 0 THEN
        DIM bIdx AS INTEGER
        FOR bIdx% = 0 TO bw% - 1
            LINE (ttX% + bIdx%, ttY% + bIdx%)-(ttX% + ttW% - 1 - bIdx%, ttY% + ttH% - 1 - bIdx%), borderColor~&, B
        NEXT bIdx%
    END IF

    ' Draw text with transparent background (keep tooltip BG visible behind glyphs)
    _PRINTMODE _KEEPBACKGROUND

    ' Draw each wrapped row with its own colour (wrapped line-1 rows stay bold,
    ' line-2/3 rows normal).
    DIM textX AS INTEGER, textY AS INTEGER, dri AS INTEGER
    textX% = ttX% + pad% + bw%
    textY% = ttY% + pad% + bw%
    FOR dri% = 1 TO rowCount%
        IF ttBold(dri%) THEN COLOR boldColor~& ELSE COLOR fgColor~&
        _UPRINTSTRING (textX%, textY%), ttRows(dri%)
        textY% = textY% + fontH% + 1
    NEXT dri%

    ' Mark tooltip as rendered — allows idle detection to stop burning CPU
    TOOLTIP.NEEDS_REDRAW% = FALSE

    ' Restore font and dest
    IF oldFont& > 0 THEN _FONT oldFont&
    _DEST oldDest&
END SUB

''
' TOOLTIP_reblit_to_screen0 — Re-composite the tooltip region from SCRN.CANVAS&
' directly onto screen 0 AFTER any panel that draws to screen 0 (e.g. Color Mixer).
' Because COLORMIXER_render blits its buffer to screen 0 after the canvas upscale,
' it would otherwise paint over the tooltip that TOOLTIP_render drew into SCRN.CANVAS&.
' Call this immediately after COLORMIXER_render and before _DISPLAY.
'
SUB TOOLTIP_reblit_to_screen0 ()
    IF TOOLTIP.RENDER_W% <= 0 THEN EXIT SUB
    DIM ttDs    AS INTEGER
    ttDs% = SCRN.displayScale%
    IF ttDs% < 1 THEN ttDs% = 1
    DIM ttSaveD AS LONG : ttSaveD& = _DEST
    _DEST 0
    _PUTIMAGE (CLNG(TOOLTIP.RENDER_X%) * ttDs%, CLNG(TOOLTIP.RENDER_Y%) * ttDs%)-((CLNG(TOOLTIP.RENDER_X%) + CLNG(TOOLTIP.RENDER_W%)) * ttDs% - 1, (CLNG(TOOLTIP.RENDER_Y%) + CLNG(TOOLTIP.RENDER_H%)) * ttDs% - 1), SCRN.CANVAS&, 0, (TOOLTIP.RENDER_X%, TOOLTIP.RENDER_Y%)-(TOOLTIP.RENDER_X% + TOOLTIP.RENDER_W% - 1, TOOLTIP.RENDER_Y% + TOOLTIP.RENDER_H% - 1)
    _DEST ttSaveD&
END SUB
