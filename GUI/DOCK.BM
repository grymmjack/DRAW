''
' DRAW - GUI/DOCK.BM
' =============================================================================
' The dock tree (see DOCK.BI): panel registry, tree editing, the default tree
' built from today's dock keys, and DOCK_layout.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Is panel id (organizer / drawer) stacked in the toolbox's dock column? Only
' then does it share the toolbox's height and width (TOOLBAR_reflow). Before
' the tree is built the default one stacks them.
FUNCTION DOCK_with_toolbox% (id AS INTEGER)
    DIM s AS INTEGER, t AS INTEGER
    IF DOCK_READY = 0 THEN DOCK_with_toolbox% = TRUE: EXIT FUNCTION
    s = DPANEL(id).slot: t = DPANEL(DP_TOOLBOX).slot
    IF s = 0 _ORELSE t = 0 THEN EXIT FUNCTION ' floating (or not in the tree)
    IF DOCK_is_row%(DOCK_SLOT(t).col) THEN EXIT FUNCTION ' (a row: side by side, each its own width)
    DOCK_with_toolbox% = (DOCK_SLOT(s).col = DOCK_SLOT(t).col)
END FUNCTION


''
' The docked toolbox shares a column with the shown layers.
FUNCTION DOCK_tb_with_layers% ()
    DIM s AS INTEGER, t AS INTEGER
    IF DOCK_READY = 0 THEN EXIT FUNCTION
    s = DPANEL(DP_TOOLBOX).slot: t = DPANEL(DP_LAYERS).slot
    IF s <= 0 _ORELSE t <= 0 THEN EXIT FUNCTION
    IF DOCK_SLOT(s).col <> DOCK_SLOT(t).col THEN EXIT FUNCTION
    DOCK_tb_with_layers% = (DOCK_panel_shown%(DP_LAYERS) <> 0)
END FUNCTION


''
' The toolbox's buttons follow the width they are given, any number of
' columns (TOOLBAR_cols_fit% shrink): floating, or in the layers' column.
FUNCTION DOCK_tb_follows% ()
    DOCK_tb_follows% = (DOCK_floating%(DP_TOOLBOX) <> 0) _ORELSE (DOCK_tb_with_layers% <> 0) _ORELSE (DOCK_in_row%(DP_TOOLBOX) <> 0)
END FUNCTION


''
' Is panel id showing (its own visibility flag)? The organizer and drawer
' follow the toolbar's Tab toggle too, as they always have.
FUNCTION DOCK_panel_shown% (id AS INTEGER)
    SELECT CASE id
        CASE DP_TOOLBOX: DOCK_panel_shown% = (SCRN.showToolbar% <> 0)
        CASE DP_ORGANIZER: DOCK_panel_shown% = (SCRN.showToolbar% <> 0 _ANDALSO ORGANIZER.visible% <> 0)
        CASE DP_DRAWER: DOCK_panel_shown% = (SCRN.showToolbar% <> 0 _ANDALSO DRAWER.visible% <> 0)
        CASE DP_LAYERS: DOCK_panel_shown% = (LAYER_PANEL.visible% <> 0)
        CASE DP_EDITBAR: DOCK_panel_shown% = (SCRN.showEditBar% <> 0)
        CASE DP_ADVBAR: DOCK_panel_shown% = (SCRN.showAdvBar% <> 0)
        CASE DP_CHARMAP: DOCK_panel_shown% = (SCRN.showCharMap% <> 0)
        CASE DP_WORKFLOW: DOCK_panel_shown% = (SCRN.showToolbar% <> 0 _ANDALSO WF_on% <> 0) ' (hides with the toolbox, as it did inside it)
        CASE DP_TEXTBAR: DOCK_panel_shown% = (TEXT_BAR_wanted% <> 0) ' (with the text tool, or a text layer being edited)
        CASE DP_SELBAR: DOCK_panel_shown% = (SELBAR_wanted% <> 0) ' (with a selection tool)
        CASE DP_MYPAINT: DOCK_panel_shown% = (MYPP_wanted% <> 0) ' (View > MyPaint Brushes)
        CASE DP_MYPSET: DOCK_panel_shown% = (MPS_wanted% <> 0) ' (View > MyPaint Brush Settings)
        CASE DP_BRUSHES: DOCK_panel_shown% = (BSP_wanted% <> 0) ' (View > Brush Palette)
        CASE DP_PREVIEW: DOCK_panel_shown% = (PREVIEW.visible% <> 0 _ANDALSO PREVIEW.autoHidden% = 0)
        CASE DP_MIXER: DOCK_panel_shown% = (COLORMIXER.visible% <> 0 _ANDALSO COLORMIXER.autoHidden% = 0 _ANDALSO COLORMIXER.initialized% <> 0)
        CASE DP_ADVCP: DOCK_panel_shown% = (ADVCP.visible% <> 0 _ANDALSO ADVCP.autoHidden% = 0 _ANDALSO ADVCP.initialized% <> 0)
        CASE DP_CS3D: DOCK_panel_shown% = (CS3D.visible% <> 0 _ANDALSO CS3D.autoHidden% = 0 _ANDALSO CS3D.initialized% <> 0)
        CASE DP_PEN: DOCK_panel_shown% = (PENP.visible% <> 0 _ANDALSO PENP.autoHidden% = 0 _ANDALSO PENP.initialized% <> 0)
        CASE DP_ANIM: DOCK_panel_shown% = (ANIMP.visible <> 0 _ANDALSO ANIMP.autoHidden = 0 _ANDALSO ANIMP.initialized <> 0)
        CASE DP_SWATCH: DOCK_panel_shown% = (SWP.visible <> 0 _ANDALSO SWP.autoHidden = 0 _ANDALSO SWP.initialized <> 0)
        CASE DP_BROWSER: DOCK_panel_shown% = (BROWSER.visible% <> 0 _ANDALSO BROWSER.autoHidden% = 0)
    END SELECT
END FUNCTION


''
' The width a panel wants (viewport px) at its current setting: at its own
' Scale, its width in panel units converted (GUI/PANEL-SURFACE).
FUNCTION DOCK_panel_w% (id AS INTEGER)
    DOCK_panel_w% = PSURF_v%(id, DOCK_panel_w_units%(id))
END FUNCTION


''
' The width a panel wants in its own units (viewport px at Auto).
FUNCTION DOCK_panel_w_units% (id AS INTEGER)
    SELECT CASE id
        CASE DP_TOOLBOX
            ' in the layers' column the layers set the width and the buttons
            ' reflow into it (DOCK_tb_follows%): as narrow as one column
            IF DOCK_tb_with_layers% THEN DOCK_panel_w_units% = TOOLBAR_cols_w%(1) ELSE DOCK_panel_w_units% = TOOLBOX_PANEL_W
        CASE DP_ORGANIZER ' the toolbox's width, but at least one widget stack (docked apart from it)
            DIM orgS AS INTEGER
            orgS = ORGANIZER_scale%: IF orgS < 1 THEN orgS = 1
            ' (only in the toolbox's column: in a column of its own it is as
            ' narrow as one stack, and that column has its own width edge)
            DOCK_panel_w_units% = ORG_COL_W * orgS + 2
            IF DOCK_with_toolbox%(DP_ORGANIZER) THEN DOCK_panel_w_units% = _MAX(PSURF_u_of%(DP_ORGANIZER, DP_TOOLBOX, TOOLBOX_PANEL_W), ORG_COL_W * orgS + 2)
        CASE DP_DRAWER ' at least one bin; the toolbox's width in its column
            DOCK_panel_w_units% = DRAWER_min_w%
            IF DOCK_with_toolbox%(DP_DRAWER) THEN DOCK_panel_w_units% = _MAX(PSURF_u_of%(DP_DRAWER, DP_TOOLBOX, TOOLBOX_PANEL_W), DRAWER_min_w%)
        CASE DP_LAYERS: DOCK_panel_w_units% = LAYERS_clamp_width%(LAYER_PANEL.width%) ' a saved width below the buttons' minimum too
        CASE DP_EDITBAR: DOCK_panel_w_units% = EDITBAR_width%
        CASE DP_ADVBAR: DOCK_panel_w_units% = ADVBAR_width%
        CASE DP_CHARMAP: DOCK_panel_w_units% = CHARMAP_panel_width%
        CASE DP_TEXTBAR: DOCK_panel_w_units% = TEXT_BAR_COL_W ' (it stretches: in a column its controls wrap into lines)
        CASE DP_SELBAR: DOCK_panel_w_units% = SELBAR_COL_W
        CASE DP_MYPAINT: DOCK_panel_w_units% = MYPP_COL_W
        CASE DP_MYPSET: DOCK_panel_w_units% = MPS_COL_W
        CASE DP_BRUSHES: DOCK_panel_w_units% = BSP_COL_W
        CASE DP_WORKFLOW ' one button column (first letters); the toolbox's width in its column
            DOCK_panel_w_units% = WF_min_w%
            IF DOCK_with_toolbox%(DP_WORKFLOW) THEN DOCK_panel_w_units% = _MAX(PSURF_u_of%(DP_WORKFLOW, DP_TOOLBOX, TOOLBOX_PANEL_W), WF_min_w%)
        CASE DP_PREVIEW
            ' its floating width (CFG.PREVIEW_W, native px) - never the slot's:
            ' docked it stretches to the column, so its live width would hold
            ' the column at its widest (the layers could never shrink it back)
            DIM pvW AS SINGLE
            pvW = PREVIEW.renderScale!: IF pvW <= 0 THEN pvW = 1
            DOCK_panel_w_units% = INT(CSNG(_MAX(CFG.PREVIEW_W%, PREVIEW_MIN_W)) * pvW + 0.5)
        CASE DP_MIXER, DP_ADVCP, DP_CS3D, DP_PEN, DP_ANIM, DP_SWATCH
            ' natural width: docked they stretch to the slot (FPANEL_fit), and
            ' a live width would hold the column at its widest
            DOCK_panel_w_units% = FPANEL_nat_w%(id)
        CASE DP_BROWSER
            ' its floating width (CFG.BROWSER_WIDTH, native px - never the slot's or
            ' band's size it has while docked, or a column would inherit a band's width)
            DIM brW AS SINGLE
            brW = BROWSER.renderScale!: IF brW <= 0 THEN brW = 1
            DOCK_panel_w_units% = _MAX(INT(CSNG(_MAX(CFG.BROWSER_WIDTH%, BROWSER_narrowest_w%)) * brW + 0.5), BROWSER_min_disp_w%)
    END SELECT
END FUNCTION


''
' What panel id asks of the layout on one axis - the one place a docked
' panel's size rules live (boxes for QB64_GJ_LIB/LAYOUT lines):
'   width  (axisH FALSE): minS / basisS px. stretchy = it fills its slot (the
'          Preview, the Browser): beside other panels it asks for only its
'          minimum, alone in a column for its floating width - a live width
'          would hold the column wide (Rick: the layers could not be narrowed
'          with the Preview docked above them).
'   height (axisH TRUE, cross = the column's width): a fixed panel's height
'          (minS = basisS), or a flex panel's minimum (basisS 0, stretchy).
SUB DOCK_panel_box (id AS INTEGER, axisH AS INTEGER, cross AS INTEGER, minS AS INTEGER, basisS AS INTEGER, stretchy AS INTEGER)
    DIM rs AS SINGLE
    IF axisH THEN
        IF DPANEL(id).hmode = DP_H_FIXED THEN
            minS = DOCK_fixed_h%(id, cross): basisS = minS: stretchy = FALSE
            ' the Advanced Color Picker can give its wheel up in a short column
            ' (taller than a small window's column, first in it: nothing to drop)
            IF id = DP_ADVCP _ANDALSO DOCK_in_row%(id) = 0 THEN minS = _MAX(0, basisS - FPANEL_disp_of%(DP_ADVCP, ADVCP_col_shrink%))
        ELSE
            minS = _MAX(DOCK_min_h%(id), DOCK_MIN_FLEX_H): basisS = 0: stretchy = TRUE
        END IF
        EXIT SUB
    END IF
    stretchy = FALSE
    basisS = DOCK_panel_w%(id): minS = basisS
    SELECT CASE id
        CASE DP_PREVIEW
            rs = PREVIEW.renderScale!: IF rs <= 0 THEN rs = 1
            minS = INT(PREVIEW_MIN_W * rs + 0.999): stretchy = TRUE
        CASE DP_BROWSER
            minS = BROWSER_min_disp_w%: stretchy = TRUE ' (native px x its scale)
        CASE DP_SWATCH
            minS = FPANEL_disp_of%(DP_SWATCH, SWP_MIN_W): stretchy = TRUE ' a grid: any width
        CASE DP_TEXTBAR
            minS = PSURF_v%(id, TEXT_BAR_MIN_W): stretchy = TRUE ' its controls wrap into the width it gets
        CASE DP_SELBAR
            minS = PSURF_v%(id, SELBAR_MIN_W): stretchy = TRUE
        CASE DP_MYPAINT
            minS = PSURF_v%(id, MYPP_MIN_W): stretchy = TRUE ' a grid: any width
        CASE DP_MYPSET
            minS = PSURF_v%(id, MPS_MIN_W): stretchy = TRUE ' its sliders stack into the width it gets
        CASE DP_BRUSHES
            minS = PSURF_v%(id, BSP_MIN_W): stretchy = TRUE ' a grid: any width
    END SELECT
END SUB


''
' Column c's natural width: the widest of its shown panels (DOCK_panel_box) -
' a stretching panel counts its minimum unless it is all the column holds.
FUNCTION DOCK_col_natural_w% (c AS INTEGER)
    DIM so AS INTEGER, s AS INTEGER, t AS INTEGER, pid AS INTEGER, w AS INTEGER, sw AS INTEGER, fixedW AS INTEGER
    DIM mn AS INTEGER, bs AS INTEGER, st AS INTEGER
    FOR so = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, so)
        IF s = 0 THEN EXIT FOR
        IF DOCK_slot_panel%(s) THEN
            FOR t = 1 TO DOCK_SLOT(s).ntabs
                pid = DOCK_TAB(s, t)
                IF DOCK_panel_shown%(pid) THEN
                    DOCK_panel_box pid, FALSE, 0, mn, bs, st
                    IF st THEN
                        IF bs > sw THEN sw = bs
                        IF mn > w THEN w = mn
                    ELSE
                        fixedW = TRUE
                        IF bs > w THEN w = bs
                    END IF
                END IF
            NEXT t
        END IF
    NEXT so
    IF fixedW = 0 _ANDALSO sw > w THEN w = sw
    DOCK_col_natural_w% = w
END FUNCTION


''
' The narrowest column c's own width edge may take it: the widest minimum of its
' shown panels when they all stretch (a grid / sliders that wrap: the Brush Palette,
' MyPaint, ...), else its natural width (a fixed-width panel sets it). Rick 2026-11-18:
' the Brush Palette floated tiny, docked it could not be dragged back below 320 px.
FUNCTION DOCK_col_min_w% (c AS INTEGER)
    DIM so AS INTEGER, s AS INTEGER, t AS INTEGER, pid AS INTEGER, w AS INTEGER
    DIM mn AS INTEGER, bs AS INTEGER, st AS INTEGER
    FOR so = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, so)
        IF s = 0 THEN EXIT FOR
        IF DOCK_slot_panel%(s) THEN
            FOR t = 1 TO DOCK_SLOT(s).ntabs
                pid = DOCK_TAB(s, t)
                IF DOCK_panel_shown%(pid) THEN
                    DOCK_panel_box pid, FALSE, 0, mn, bs, st
                    IF st = 0 THEN DOCK_col_min_w% = DOCK_col_natural_w%(c): EXIT FUNCTION
                    IF mn > w THEN w = mn
                END IF
            NEXT t
        END IF
    NEXT so
    IF w <= 0 THEN w = DOCK_col_natural_w%(c)
    DOCK_col_min_w% = w
END FUNCTION


''
' Column c's width: its natural width (DOCK_col_natural_w%), or wider when
' the column has its own WIDTH: - only a column whose width edge is the
' column's (no toolbox / layers / bar: those set their own widths).
FUNCTION DOCK_col_width% (c AS INTEGER)
    DIM w AS INTEGER
    w = DOCK_col_natural_w%(c)
    IF DOCK_COL(c).wpx > 0 _ANDALSO DOCK_col_resize_id%(c) = DOCK_NONE THEN
        ' its own width: wider than natural, or narrower when all it holds stretches
        IF DOCK_COL(c).wpx > w THEN
            w = _MIN(DOCK_COL(c).wpx, DOCK_col_max_w%(c))
        ELSE
            w = _MAX(DOCK_COL(c).wpx, DOCK_col_min_w%(c))
        END IF
    END IF
    DOCK_col_width% = w
END FUNCTION


''
' Widest column c's own width edge goes: the widest any of its shown panels
' can use (DOCK_panel_max_w%), never below its natural width. Rick,
' 2026-11-06: an organizer docked alone dragged out to black bars.
FUNCTION DOCK_col_max_w% (c AS INTEGER)
    DIM so AS INTEGER, s AS INTEGER, t AS INTEGER, pid AS INTEGER, w AS INTEGER
    FOR so = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, so)
        IF s = 0 THEN EXIT FOR
        FOR t = 1 TO DOCK_SLOT(s).ntabs
            pid = DOCK_TAB(s, t)
            IF DOCK_panel_shown%(pid) THEN w = _MAX(w, DOCK_panel_max_w%(pid))
        NEXT t
    NEXT so
    DOCK_col_max_w% = _MAX(w, DOCK_col_natural_w%(c))
END FUNCTION


''
' Widest a docked panel can use (px); past it the column would show empty
' panel. Stretching panels (Preview, Browser) use any width.
FUNCTION DOCK_panel_max_w% (id AS INTEGER)
    SELECT CASE id
        CASE DP_ORGANIZER: DOCK_panel_max_w% = PSURF_v%(id, ORGANIZER_max_w%)
        CASE DP_DRAWER: DOCK_panel_max_w% = PSURF_v%(id, DRAWER_max_w%)
        CASE DP_WORKFLOW: DOCK_panel_max_w% = PSURF_v%(id, WF_max_w%) ' every button in one row
        CASE DP_PREVIEW: DOCK_panel_max_w% = 600
        CASE DP_BROWSER ' as wide as the window leaves the canvas a strip (Rick 2026-11-16: "should allow more resizing it's width")
            DOCK_panel_max_w% = _MAX(600, SCRN.w& - 200)
        CASE DP_SWATCH: DOCK_panel_max_w% = 1200 ' a wide band of swatches is fine
        CASE DP_MYPAINT, DP_BRUSHES: DOCK_panel_max_w% = 1200 ' (a wider grid)
        CASE DP_MYPSET: DOCK_panel_max_w% = 4000 ' (any width: its sliders go side by side)
        CASE DP_TEXTBAR, DP_SELBAR: DOCK_panel_max_w% = 4000 ' (any width: its lines follow)
        CASE DP_MIXER, DP_ADVCP, DP_CS3D, DP_PEN, DP_ANIM: DOCK_panel_max_w% = FPANEL_nat_w%(id) * 2 ' they stretch (FPANEL_fit)
        CASE ELSE: DOCK_panel_max_w% = DOCK_panel_w%(id)
    END SELECT
END FUNCTION



' =============================================================================
' The default tree: today's fixed order, from the dock keys
' =============================================================================

''
' Each side, outermost first: layers, the toolbox column (workflow buttons /
' toolbox / organizer / drawer), advanced bar, edit bar, character map. Which side each one is on
' comes from the existing keys, read live, so every old way of switching sides
' (Ctrl+Shift+click a dock edge, workspace *_DOCK keys) keeps working.
SUB DOCK_build_default ()
    DIM side AS INTEGER, tbSide AS INTEGER, lpSide AS INTEGER, ebSide AS INTEGER, abSide AS INTEGER, cmSide AS INTEGER
    IF DPANEL(DP_TOOLBOX).nm = "" THEN DOCK_init_panels
    DOCK_clear
    IF UCASE$(_TRIM$(CFG.TOOLBOX_DOCK_EDGE)) = "RIGHT" THEN tbSide = DOCK_RIGHT ELSE tbSide = DOCK_LEFT
    IF UCASE$(_TRIM$(CFG.LAYERS_PANEL_DOCK_EDGE)) = "LEFT" THEN lpSide = DOCK_LEFT ELSE lpSide = DOCK_RIGHT
    IF EDIT_BAR.dockSide% = EDITBAR_DOCK_RIGHT THEN ebSide = DOCK_RIGHT ELSE ebSide = DOCK_LEFT
    IF ADV_BAR.dockSide% = ADVBAR_DOCK_RIGHT THEN abSide = DOCK_RIGHT ELSE abSide = DOCK_LEFT
    IF CHARMAP.dockSide% = CHARMAP_DOCK_LEFT THEN cmSide = DOCK_LEFT ELSE cmSide = DOCK_RIGHT
    FOR side = DOCK_LEFT TO DOCK_RIGHT
        IF lpSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_LAYERS))
        IF tbSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_WORKFLOW)) + "," + _TRIM$(STR$(DP_TOOLBOX)) + "," + _TRIM$(STR$(DP_ORGANIZER)) + "," + _TRIM$(STR$(DP_DRAWER))
        IF abSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_ADVBAR))
        IF ebSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_EDITBAR))
        IF cmSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_CHARMAP))
    NEXT side
    DOCK_textbar_place ' a top row of its own, under the menu bar (where it always was)
    DOCK_selbar_place ' (just inside it)
    DOCK_mypaint_place
    DOCK_mypset_place ' (under the MyPaint brushes)
    DOCK_brushes_place
    DOCK_READY = TRUE
END SUB


''
' An arrangement saved before a panel existed (DRAW.cfg [DOCK], a workspace's
' [DOCK]) has no place for it, and a dock panel with none is never drawn. The
' workflow buttons (2026-11-14: out of the toolbox into a panel of their own)
' go where they were - above the toolbox: a slot over it in its column, over
' its window when it floats, else a column of their own on the left.
' A tree saved since always has them (docked or floating), so this runs once.
SUB DOCK_adopt_new_panels ()
    DIM s AS INTEGER, c AS INTEGER, h AS INTEGER, col AS INTEGER, ord AS INTEGER
    ' the text bar (2026-11-16: a dock panel, was a strip under the menu bar):
    ' a top row of its own, the outermost - where it was
    IF DPANEL(DP_TEXTBAR).slot = 0 _ANDALSO DPANEL(DP_TEXTBAR).fl = 0 THEN
        DOCK_textbar_place
        IF WS_ACTIVE = 0 _ANDALSO CFG.STOCK_DEFAULT_LAYOUT% = 0 THEN DOCK_ADOPT_SAVE = TRUE
    END IF
    ' the selection bar (2026-11-18): where the text bar is (they never show together)
    IF DPANEL(DP_SELBAR).slot = 0 _ANDALSO DPANEL(DP_SELBAR).fl = 0 THEN
        DOCK_selbar_place
        IF WS_ACTIVE = 0 _ANDALSO CFG.STOCK_DEFAULT_LAYOUT% = 0 THEN DOCK_ADOPT_SAVE = TRUE
    END IF
    ' the MyPaint brushes (2026-11-18): a column of their own on the right, by the canvas
    IF DPANEL(DP_MYPAINT).slot = 0 _ANDALSO DPANEL(DP_MYPAINT).fl = 0 THEN
        DOCK_mypaint_place
        IF WS_ACTIVE = 0 _ANDALSO CFG.STOCK_DEFAULT_LAYOUT% = 0 THEN DOCK_ADOPT_SAVE = TRUE
    END IF
    ' the MyPaint Brush Settings and the brush palette (2026-11-18): under the MyPaint
    ' brushes / a column of their own on the right
    IF DPANEL(DP_MYPSET).slot = 0 _ANDALSO DPANEL(DP_MYPSET).fl = 0 THEN
        DOCK_mypset_place
        IF WS_ACTIVE = 0 _ANDALSO CFG.STOCK_DEFAULT_LAYOUT% = 0 THEN DOCK_ADOPT_SAVE = TRUE
    END IF
    IF DPANEL(DP_BRUSHES).slot = 0 _ANDALSO DPANEL(DP_BRUSHES).fl = 0 THEN
        DOCK_brushes_place
        IF WS_ACTIVE = 0 _ANDALSO CFG.STOCK_DEFAULT_LAYOUT% = 0 THEN DOCK_ADOPT_SAVE = TRUE
    END IF
    IF DPANEL(DP_WORKFLOW).slot <> 0 _ORELSE DPANEL(DP_WORKFLOW).fl THEN EXIT SUB
    s = DPANEL(DP_TOOLBOX).slot
    IF s > 0 THEN
        ' (copies: by reference, the toolbox's ord would shift down with it)
        col = DOCK_SLOT(s).col: ord = DOCK_SLOT(s).ord
        IF DOCK_SLOT(s).used THEN c = DOCK_move_to_slot%(DP_WORKFLOW, col, ord)
    END IF
    IF c = 0 _ANDALSO DPANEL(DP_TOOLBOX).fl THEN
        DPANEL(DP_WORKFLOW).fl = TRUE
        DPANEL(DP_WORKFLOW).fx = DPANEL(DP_TOOLBOX).fx: DPANEL(DP_WORKFLOW).fw = DPANEL(DP_TOOLBOX).fw
        ' its window as DOCK_place_floats sizes it: title, rows, frame
        h = DOCK_float_title_h%(DP_WORKFLOW) + DOCK_fixed_h%(DP_WORKFLOW, DPANEL(DP_WORKFLOW).fw - 2) + 3
        DPANEL(DP_WORKFLOW).fy = DPANEL(DP_TOOLBOX).fy - h: DPANEL(DP_WORKFLOW).fh = h
        c = -1
    END IF
    IF c = 0 THEN c = DOCK_move_to_new_col%(DP_WORKFLOW, DOCK_LEFT, DOCK_MAX_COLS + 1)
    ' your own arrangement (DRAW.cfg) is saved with it at once, so the file
    ' says what is on screen; a workspace's [DOCK] is left as it is (applying
    ' a workspace never writes its file) and adopts it again each time
    IF WS_ACTIVE = 0 _ANDALSO CFG.STOCK_DEFAULT_LAYOUT% = 0 THEN DOCK_ADOPT_SAVE = TRUE
END SUB


''
' The text bar's place when an arrangement has none: a top row of its own,
' the outermost (under the menu bar, where the fixed strip was).
SUB DOCK_textbar_place ()
    DIM c AS INTEGER
    c = DOCK_move_to_new_col%(DP_TEXTBAR, DOCK_TOP, 1)
END SUB


''
' The selection bar's place when an arrangement has none: a row of its own just
' inside the text bar's (or the outermost top row) - only one of them shows at a
' time, and a row with nothing shown takes no room.
SUB DOCK_selbar_place ()
    DIM c AS INTEGER, s AS INTEGER, side AS INTEGER, ord AS INTEGER
    side = DOCK_TOP: ord = 1
    s = DPANEL(DP_TEXTBAR).slot
    IF s > 0 THEN
        IF DOCK_is_row%(DOCK_SLOT(s).col) THEN side = DOCK_COL(DOCK_SLOT(s).col).side: ord = DOCK_COL(DOCK_SLOT(s).col).ord + 1
    END IF
    c = DOCK_move_to_new_col%(DP_SELBAR, side, ord)
END SUB


''
' Tool Options and the Text Bar are one panel to the user (PLANS/TOOL-OPTIONS-BAR.md
' phase 2: the text tool's options are the Text Bar, its code as it was). They never
' show together but for a text layer edited under another tool, so the one hidden
' follows the one shown: right beside it - the next slot in its column, a column /
' row of its own next to its own, a tab in its slot, or floating at its spot. A slot,
' column or row with nothing shown takes no room, so both sit in one place. Runs at
' each layout; moves only when they have come apart (you moved the shown one).
SUB DOCK_bars_follow ()
    DIM lead AS INTEGER, twin AS INTEGER, ls AS INTEGER, lc AS INTEGER, r AS INTEGER, k AS INTEGER, a AS INTEGER
    DIM sig AS STRING
    IF TEXT_BAR_wanted% THEN
        lead = DP_TEXTBAR: twin = DP_SELBAR
    ELSEIF SELBAR_wanted% THEN
        lead = DP_SELBAR: twin = DP_TEXTBAR
    ELSE
        EXIT SUB
    END IF
    ' after a load, the Text Bar's place wins once: an arrangement saved before the two were
    ' linked keeps where you put the Text Bar, and Tool Options joins it there
    IF DOCK_BARS_FIRST THEN
        DOCK_BARS_FIRST = FALSE
        IF DPANEL(DP_TEXTBAR).fl _ORELSE DPANEL(DP_TEXTBAR).slot > 0 THEN lead = DP_TEXTBAR: twin = DP_SELBAR
    END IF
    IF DOCK_bars_together%(lead, twin) THEN DOCK_BARS_SIG = "": EXIT SUB
    ' once per place of the lead: a follow that could not land (a full tree, a clamped float)
    ' must not move + save again every layout
    sig = STR$(lead) + STR$(DPANEL(lead).fl) + STR$(DPANEL(lead).fx) + STR$(DPANEL(lead).fy) + STR$(DPANEL(lead).slot)
    IF DPANEL(lead).slot > 0 THEN sig = sig + STR$(DOCK_SLOT(DPANEL(lead).slot).col) + STR$(DOCK_SLOT(DPANEL(lead).slot).ord)
    IF sig = DOCK_BARS_SIG THEN EXIT SUB
    DOCK_BARS_SIG = sig
    IF DPANEL(lead).fl THEN
        DOCK_detach_panel twin
        DPANEL(twin).fl = TRUE
        DPANEL(twin).fx = DPANEL(lead).fx: DPANEL(twin).fy = DPANEL(lead).fy: DPANEL(twin).fw = DPANEL(lead).fw
        DPANEL(twin).hside = DPANEL(lead).hside: DPANEL(twin).hcol = DPANEL(lead).hcol
        DPANEL(twin).hslot = DPANEL(lead).hslot: DPANEL(twin).halone = DPANEL(lead).halone
    ELSE
        IF DPANEL(lead).slot < 1 THEN EXIT SUB
        DOCK_detach_panel twin ' (first: the tree may renumber)
        ls = DPANEL(lead).slot: lc = DOCK_SLOT(ls).col
        IF DOCK_SLOT(ls).ntabs > 1 THEN ' tabbed with others: a tab there too, the lead's still showing
            FOR k = 1 TO DOCK_SLOT(ls).ntabs
                IF DOCK_TAB(ls, k) = lead THEN a = k
            NEXT k
            r = DOCK_move_to_tab%(twin, ls)
            IF a THEN DOCK_SLOT(ls).act = a
        ELSEIF DOCK_slot_at%(lc, 2) = 0 THEN ' a column / row of its own: one of its own beside it
            r = DOCK_move_to_new_col%(twin, DOCK_COL(lc).side, DOCK_COL(lc).ord + 1)
        ELSE
            r = DOCK_move_to_slot%(twin, lc, DOCK_SLOT(ls).ord + 1)
        END IF
    END IF
    IF WS_ACTIVE = 0 _ANDALSO CFG.STOCK_DEFAULT_LAYOUT% = 0 THEN DOCK_ADOPT_SAVE = TRUE ' (DRAW.cfg says what is on screen)
END SUB


''
' Are bar twin and lead in one place (DOCK_bars_follow)?
FUNCTION DOCK_bars_together% (lead AS INTEGER, twin AS INTEGER)
    DIM ls AS INTEGER, ts AS INTEGER, lc AS INTEGER, tc AS INTEGER
    IF DPANEL(lead).fl THEN
        DOCK_bars_together% = (DPANEL(twin).fl <> 0 _ANDALSO DPANEL(twin).fx = DPANEL(lead).fx _ANDALSO DPANEL(twin).fy = DPANEL(lead).fy)
        EXIT FUNCTION
    END IF
    ls = DPANEL(lead).slot: ts = DPANEL(twin).slot
    IF ls < 1 THEN DOCK_bars_together% = TRUE: EXIT FUNCTION ' (not docked, not floating: nothing to follow)
    IF ts < 1 _ORELSE DPANEL(twin).fl THEN EXIT FUNCTION
    IF ls = ts THEN DOCK_bars_together% = TRUE: EXIT FUNCTION ' (tabs of one slot)
    lc = DOCK_SLOT(ls).col: tc = DOCK_SLOT(ts).col
    IF lc = tc THEN DOCK_bars_together% = (ABS(DOCK_SLOT(ls).ord - DOCK_SLOT(ts).ord) = 1): EXIT FUNCTION
    IF DOCK_slot_at%(lc, 2) <> 0 _ORELSE DOCK_slot_at%(tc, 2) <> 0 THEN EXIT FUNCTION
    DOCK_bars_together% = (DOCK_COL(lc).side = DOCK_COL(tc).side _ANDALSO ABS(DOCK_COL(lc).ord - DOCK_COL(tc).ord) = 1)
END FUNCTION


''
' The MyPaint brush palette's place when an arrangement has none: a column of its
' own, the innermost on the right (a column with nothing shown takes no room).
SUB DOCK_mypaint_place ()
    DIM c AS INTEGER
    c = DOCK_move_to_new_col%(DP_MYPAINT, DOCK_RIGHT, DOCK_MAX_COLS + 1)
END SUB


''
' The MyPaint Brush Settings' place when an arrangement has none: under the MyPaint
' brushes in their column, else a column of its own, the innermost on the right.
SUB DOCK_mypset_place ()
    DIM c AS INTEGER, s AS INTEGER
    s = DPANEL(DP_MYPAINT).slot
    IF s > 0 THEN
        c = DOCK_SLOT(s).col
        IF DOCK_is_row%(c) = 0 THEN
            s = DOCK_move_to_slot%(DP_MYPSET, c, DOCK_MAX_SLOTS + 1)
            IF s > 0 THEN EXIT SUB
        END IF
    END IF
    c = DOCK_move_to_new_col%(DP_MYPSET, DOCK_RIGHT, DOCK_MAX_COLS + 1)
END SUB


''
' The brush palette's place when an arrangement has none: a column of its own, the
' innermost on the right (a column with nothing shown takes no room).
SUB DOCK_brushes_place ()
    DIM c AS INTEGER
    c = DOCK_move_to_new_col%(DP_BRUSHES, DOCK_RIGHT, DOCK_MAX_COLS + 1)
END SUB


''
' The width the text / selection bar has in its row (for the row's height) - the
' width it was last given, else the rows' whole span.
FUNCTION DOCK_bar_row_w% (id AS INTEGER)
    DIM x1 AS INTEGER, x2 AS INTEGER
    IF DPANEL(id).rw > 0 _ANDALSO DOCK_in_row%(id) THEN DOCK_bar_row_w% = DPANEL(id).rw: EXIT FUNCTION
    DOCK_row_span x1, x2
    DOCK_bar_row_w% = _MAX(x2 - x1 + 1, 64)
END FUNCTION


''
' The width the text bar has in its row (for the row's height: its lines at
' that width) - the width it was last given, else the rows' whole span.
FUNCTION DOCK_textbar_row_w% ()
    DIM x1 AS INTEGER, x2 AS INTEGER
    IF DPANEL(DP_TEXTBAR).rw > 0 _ANDALSO DOCK_in_row%(DP_TEXTBAR) THEN DOCK_textbar_row_w% = DPANEL(DP_TEXTBAR).rw: EXIT FUNCTION
    DOCK_row_span x1, x2
    DOCK_textbar_row_w% = _MAX(x2 - x1 + 1, 64)
END FUNCTION


''
' The side a panel's own dock key puts it on (the keys predate the tree:
' View > Layout, Ctrl+Shift+click, workspace *_DOCK keys), 0 = it has none.
''
' Set panel id's classic side key (and the bar's live dock side) to side.
SUB DOCK_key_set (id AS INTEGER, side AS INTEGER)
    DIM e AS STRING
    IF side = DOCK_RIGHT THEN e = "RIGHT" ELSE e = "LEFT"
    SELECT CASE id
        CASE DP_TOOLBOX: CFG.TOOLBOX_DOCK_EDGE = e
        CASE DP_LAYERS: CFG.LAYERS_PANEL_DOCK_EDGE = e
        CASE DP_EDITBAR
            CFG.EDIT_BAR_DOCK_POSITION$ = e
            IF side = DOCK_RIGHT THEN EDIT_BAR.dockSide% = EDITBAR_DOCK_RIGHT ELSE EDIT_BAR.dockSide% = EDITBAR_DOCK_LEFT
        CASE DP_ADVBAR
            CFG.ADV_BAR_DOCK_POSITION$ = e
            IF side = DOCK_RIGHT THEN ADV_BAR.dockSide% = ADVBAR_DOCK_RIGHT ELSE ADV_BAR.dockSide% = ADVBAR_DOCK_LEFT
        CASE DP_CHARMAP
            CFG.CHARMAP_PANEL_DOCK_EDGE$ = e
            IF side = DOCK_RIGHT THEN CHARMAP.dockSide% = CHARMAP_DOCK_RIGHT ELSE CHARMAP.dockSide% = CHARMAP_DOCK_LEFT
    END SELECT
END SUB


FUNCTION DOCK_key_side% (id AS INTEGER)
    DIM r AS INTEGER
    SELECT CASE id
        CASE DP_TOOLBOX
            r = DOCK_LEFT: IF UCASE$(_TRIM$(CFG.TOOLBOX_DOCK_EDGE)) = "RIGHT" THEN r = DOCK_RIGHT
        CASE DP_LAYERS
            r = DOCK_RIGHT: IF UCASE$(_TRIM$(CFG.LAYERS_PANEL_DOCK_EDGE)) = "LEFT" THEN r = DOCK_LEFT
        CASE DP_EDITBAR
            r = DOCK_LEFT: IF EDIT_BAR.dockSide% = EDITBAR_DOCK_RIGHT THEN r = DOCK_RIGHT
        CASE DP_ADVBAR
            r = DOCK_LEFT: IF ADV_BAR.dockSide% = ADVBAR_DOCK_RIGHT THEN r = DOCK_RIGHT
        CASE DP_CHARMAP
            r = DOCK_RIGHT: IF CHARMAP.dockSide% = CHARMAP_DOCK_LEFT THEN r = DOCK_LEFT
    END SELECT
    DOCK_key_side% = r
END FUNCTION


''
' The side a panel is on right now: where the tree docks it, else its key.
' Everything that asks "is it on the left?" reads this, not the key - with an
' arranged (custom) tree the keys no longer place the panels.
FUNCTION DOCK_side_now% (id AS INTEGER)
    DIM r AS INTEGER
    r = DOCK_panel_side%(id)
    IF r = 0 THEN r = DOCK_key_side%(id)
    DOCK_side_now% = r
END FUNCTION


''
' Old code just set panel id's dock key to side. The default tree follows the
' keys by itself; an arranged one moves the panel - its whole column when the
' column holds nothing else (the toolbox's counts its organizer and drawer),
' column holds nothing else (the toolbox's counts its workflow buttons,
' organizer and drawer), else just the panel, into a new innermost column.
' Saved like any move.
SUB DOCK_side_request (id AS INTEGER, side AS INTEGER)
    DIM c AS INTEGER, s AS INTEGER, t AS INTEGER, p AS INTEGER, own AS INTEGER, cur AS INTEGER
    IF WS_stock_default% THEN
        ' Default keeps the stock layout: undo the side key the caller just
        ' flipped and make the move in the arrangement instead (whose commit
        ' asks for a workspace to keep it in)
        IF DOCK_READY = 0 THEN DOCK_build_default
        cur = DOCK_panel_side%(id)
        IF cur = DOCK_LEFT _ORELSE cur = DOCK_RIGHT THEN DOCK_key_set id, cur
        IF cur = side THEN EXIT SUB
        DOCK_change_begin
    END IF
    IF DOCK_CUSTOM = 0 _ORELSE DOCK_READY = 0 THEN EXIT SUB
    IF DPANEL(id).slot = 0 _ORELSE DOCK_panel_side%(id) = side THEN EXIT SUB
    c = DOCK_SLOT(DPANEL(id).slot).col
    own = TRUE
    FOR s = 1 TO DOCK_MAX_SLOTS
        IF DOCK_SLOT(s).used _ANDALSO DOCK_SLOT(s).col = c THEN
            FOR t = 1 TO DOCK_SLOT(s).ntabs
                p = DOCK_TAB(s, t)
                IF p <> id THEN
                    IF id <> DP_TOOLBOX _ORELSE (p <> DP_ORGANIZER _ANDALSO p <> DP_DRAWER _ANDALSO p <> DP_WORKFLOW) THEN own = FALSE
                END IF
            NEXT t
        END IF
    NEXT s
    DOCK_change_begin
    IF own THEN
        DOCK_move_col_side c, side
    ELSE
        c = DOCK_move_to_new_col%(id, side, DOCK_MAX_COLS + 1)
    END IF
    DOCK_change_commit DPANEL(id).title + " moved"
END SUB


' =============================================================================
' Layout: the tree -> rects -> panels
' =============================================================================

''
' Is slot s showing this frame, and which of its tabs is? A tab whose panel is
' hidden is skipped; a slot with no shown tab takes no room.
FUNCTION DOCK_slot_panel% (s AS INTEGER)
    DIM t AS INTEGER
    IF s < 1 THEN EXIT FUNCTION
    IF DOCK_SLOT(s).act >= 1 _ANDALSO DOCK_SLOT(s).act <= DOCK_SLOT(s).ntabs THEN
        IF DOCK_panel_shown%(DOCK_TAB(s, DOCK_SLOT(s).act)) THEN DOCK_slot_panel% = DOCK_TAB(s, DOCK_SLOT(s).act): EXIT FUNCTION
    END IF
    FOR t = 1 TO DOCK_SLOT(s).ntabs
        IF DOCK_panel_shown%(DOCK_TAB(s, t)) THEN DOCK_slot_panel% = DOCK_TAB(s, t): EXIT FUNCTION
    NEXT t
END FUNCTION


''
' Fixed height (px, borders included) of a DP_H_FIXED panel in a column w wide
' (at its own Scale: its height in its units for a width in them).
FUNCTION DOCK_fixed_h% (id AS INTEGER, w AS INTEGER)
    DOCK_fixed_h% = PSURF_v%(id, DOCK_fixed_h_units%(id, PSURF_u%(id, w)))
END FUNCTION

FUNCTION DOCK_fixed_h_units% (id AS INTEGER, w AS INTEGER)
    DIM scl AS INTEGER
    SELECT CASE id
        CASE DP_TOOLBOX
            DIM tbRows AS INTEGER
            scl = TOOLBAR_scale%
            ' the rows it will draw in a w px wide rect (TOOLBAR_fit_width runs
            ' after this, in DOCK_apply_rect): TB_LIVE_ROWS is still the wanted
            ' columns' count, too many when another panel holds the column wider
            tbRows = TOOLBAR_rows_for%(TOOLBAR_cols_fit%(w, DOCK_tb_follows%))
            ' button rows + the bottom border row (the top border row sits just
            ' above - inside the rect too when something is above it, DOCK_tb_inset%)
            DOCK_fixed_h_units% = tbRows * TB_BTN_H * scl + (tbRows - 1) * TB_BTN_PADDING * scl + 1 + DOCK_tb_inset%
        CASE DP_ORGANIZER
            DOCK_fixed_h_units% = ORGANIZER_height_for%(w)
        CASE DP_WORKFLOW
            DOCK_fixed_h_units% = WF_height%(w)
        CASE DP_TEXTBAR
            DOCK_fixed_h_units% = TEXT_BAR_h_for%(w) ' its controls wrapped into w (TEXT_BAR_lines_for%)
        CASE DP_SELBAR
            DOCK_fixed_h_units% = SELBAR_h_for%(w) ' its controls wrapped into w (SELBAR_layout%)
        CASE DP_MYPSET
            DOCK_fixed_h_units% = MPS_h_for%(w) ' its sliders in w (MPS_layout_in%)
        CASE DP_MIXER, DP_ADVCP, DP_CS3D, DP_PEN, DP_ANIM
            DOCK_fixed_h_units% = FPANEL_nat_h%(id) ' natural: spare column height is added in DOCK_stack_column
    END SELECT
END FUNCTION


''
' 1 when the docked toolbox has something above it in its column (a slot
' above, or its own title strip): the toolbox draws its top border one row
' ABOVE TB_RECT_Y, which at a column's top is the edge beside the menu bar but
' below another panel is that panel's last row (or the strip's). Then its rect
' takes that row in: TB_RECT_Y one lower, one row taller. 0 at a column's top
' or floating (unchanged).
FUNCTION DOCK_tb_inset% ()
    DIM s AS INTEGER, c AS INTEGER, o AS INTEGER, t AS INTEGER
    ' at its own Scale its top border row is inside its surface, always
    IF PSURF_on%(DP_TOOLBOX) THEN DOCK_tb_inset% = 1: EXIT FUNCTION
    s = DPANEL(DP_TOOLBOX).slot
    IF s < 1 _ORELSE s > DOCK_MAX_SLOTS THEN EXIT FUNCTION
    IF DOCK_SLOT(s).used = 0 THEN EXIT FUNCTION
    IF DOCK_slot_titled%(s) THEN DOCK_tb_inset% = 1: EXIT FUNCTION
    c = DOCK_SLOT(s).col
    ' side by side in a row: nothing above it - but a BOTTOM row's seam is its
    ' own first pixel row (DOCK_row_seam_y%), so there the border row goes
    ' under the seam and the buttons start below it (else their top highlight
    ' sits against the seam: a double line, dock fuzz 58)
    IF DOCK_is_row%(c) THEN
        IF DOCK_COL(c).side = DOCK_BOTTOM THEN DOCK_tb_inset% = 1
        EXIT FUNCTION
    END IF
    FOR o = 1 TO DOCK_SLOT(s).ord - 1 ' a showing slot above it
        t = DOCK_slot_at%(c, o)
        IF t _ANDALSO DOCK_slot_panel%(t) <> DP_NONE THEN DOCK_tb_inset% = 1: EXIT FUNCTION
    NEXT o
END FUNCTION


''
' Smallest height a flex panel accepts (it overflows the column rather than
' shrink below it).
FUNCTION DOCK_min_h% (id AS INTEGER)
    DIM dScl AS INTEGER, rs AS SINGLE
    IF id = DP_PREVIEW THEN
        ' the Preview never draws smaller than PREVIEW_MIN_H (native px): a
        ' shorter slot let it spill over the panel stacked under it
        PREVIEW_compute_display
        rs = PREVIEW.renderScale!: IF rs <= 0 THEN rs = 1
        DOCK_min_h% = INT(PREVIEW_MIN_H * rs + 0.999)
    END IF
    IF id = DP_LAYERS THEN DOCK_min_h% = PSURF_v%(id, LAYERS_min_height%) ' header + a row + the button bar
    IF id = DP_BROWSER THEN DOCK_min_h% = BROWSER_min_disp_h% ' (native px, like the Preview's)
    IF id = DP_SWATCH THEN DOCK_min_h% = FPANEL_disp_of%(DP_SWATCH, SWP_MIN_H) ' the bar + a row or two; the grid scrolls
    IF id = DP_MYPAINT THEN DOCK_min_h% = PSURF_v%(id, MYPP_min_h%) ' the header + a row of brushes; the grid scrolls
    IF id = DP_BRUSHES THEN DOCK_min_h% = PSURF_v%(id, BSP_min_h%) ' the chips, the sliders + a row of sizes; the grid scrolls
    IF id = DP_DRAWER THEN
        dScl = DRAWER_scale%
        IF dScl < 1 THEN dScl = 1
        IF dScl > 4 THEN dScl = 4
        DOCK_min_h% = PSURF_v%(DP_DRAWER, 32 * dScl)
    END IF
END FUNCTION


''
' The shortest slot s may be: its strip (if titled) + its panel's minimum
' (DOCK_panel_box) - a divider drag never goes below it, and QA checks it
' (dump SMIN lines). A collapsed slot is only its strip.
FUNCTION DOCK_slot_min_h% (s AS INTEGER)
    DIM id AS INTEGER, th AS INTEGER, mn AS INTEGER, bs AS INTEGER, st AS INTEGER
    id = DOCK_slot_panel%(s)
    IF id = DP_NONE THEN EXIT FUNCTION
    IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
    IF DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN DOCK_slot_min_h% = th: EXIT FUNCTION
    DOCK_panel_box id, TRUE, DOCK_COL(DOCK_SLOT(s).col).w, mn, bs, st
    DOCK_slot_min_h% = th + mn
END FUNCTION


''
' Does slot s draw a title / tab strip? Tabs, a collapsed slot, and a docked
' floating window (it lost its own title bar) do; the rest are chromeless.
FUNCTION DOCK_slot_titled% (s AS INTEGER)
    IF DOCK_SLOT(s).ntabs > 1 _ORELSE DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN DOCK_slot_titled% = TRUE
END FUNCTION


''
' Stack column c's showing slots top to bottom inside its rect - one line of
' QB64_GJ_LIB/LAYOUT: fixed panels take their own height, flex panels share
' what is left by weight and never go below their minimum (the others give
' way); two bordered panels share their frame row. A titled slot adds its
' strip, a collapsed one is only its strip. Too short for everything: slots
' collapse to their strips from the bottom (never the first) - the layout's
' own collapse (autoc), not saved. Slot rects include the strip; the panel
' gets the part below it (DOCK_apply_panel).
SUB DOCK_stack_column (c AS INTEGER)
    DIM o AS INTEGER, s AS INTEGER, id AS INTEGER, th AS INTEGER
    DIM prevBordered AS INTEGER, l AS LONG, mn AS INTEGER, bs AS INTEGER, st AS INTEGER
    DIM it(1 TO DOCK_MAX_SLOTS) AS LONG
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        DOCK_SLOT(s).autoc = FALSE
    NEXT o
    ' no flex panel (the layers, the Preview ...) to take the spare height:
    ' the docked floating panels' big areas share it (FPANEL_grow_max%)
    DIM hasFlex AS INTEGER, gm AS INTEGER
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        id = DOCK_slot_panel%(s)
        IF id _ANDALSO DOCK_SLOT(s).collapsed = 0 THEN
            IF DPANEL(id).hmode <> DP_H_FIXED THEN hasFlex = TRUE
        END IF
    NEXT o
    LAY_reset
    l = LAY_line_new&(DOCK_COL(c).h, 0)
    prevBordered = FALSE
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        id = DOCK_slot_panel%(s)
        DOCK_SLOT(s).vis = (id <> DP_NONE)
        IF id THEN
            th = 0
            IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
            DOCK_panel_box id, TRUE, DOCK_COL(c).w, mn, bs, st
            IF DOCK_SLOT(s).collapsed THEN
                it(o) = LAY_add_fixed&(l, th)
            ELSEIF st = 0 THEN ' a fixed height (a floating panel's grows into spare room)
                gm = 0
                IF hasFlex = 0 _ANDALSO FPANEL_has_scale%(id) THEN gm = FPANEL_grow_max%(id, DOCK_COL(c).w)
                IF mn < bs THEN ' it can shrink to mn (the ACP's wheel) when the column is short
                    it(o) = LAY_add&(l, th + mn, th + bs, th + bs + gm, _IIF(gm > 0, 1, 0), 1)
                ELSEIF gm > 0 THEN
                    it(o) = LAY_add&(l, th + bs, th + bs, th + bs + gm, 1, 0)
                ELSE
                    it(o) = LAY_add_fixed&(l, th + bs)
                END IF
            ELSE ' flex: grows by its share, never below its minimum
                it(o) = LAY_add&(l, th + mn, 0, 0, DOCK_SLOT(s).share, 0)
            END IF
            ' share the frame row with a bordered panel above (a dropped slot
            ' ignores it - LAYOUT: a collapsed box has no frame to share)
            IF prevBordered _ANDALSO DPANEL(id).bordered _ANDALSO th = 0 _ANDALSO DOCK_SLOT(s).collapsed = 0 THEN LAY_lead it(o), -1
            IF DOCK_SLOT(s).collapsed THEN prevBordered = FALSE ELSE prevBordered = DPANEL(id).bordered
            ' collapses go from the bottom up, never the first slot
            IF o >= 2 _ANDALSO DOCK_SLOT(s).collapsed = 0 THEN LAY_drop it(o), o, DOCK_TITLE_H
        END IF
    NEXT o
    LAY_solve l
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        IF DOCK_SLOT(s).vis THEN
            DOCK_SLOT(s).autoc = LAY_ITEMS(it(o)).dropped
            DOCK_SLOT(s).x = DOCK_COL(c).x
            DOCK_SLOT(s).w = DOCK_COL(c).w
            DOCK_SLOT(s).y = DOCK_COL(c).y + LAY_ITEMS(it(o)).at
            DOCK_SLOT(s).h = LAY_ITEMS(it(o)).size
        END IF
    NEXT o
END SUB


''
' Hand slot s's rect to its panel (the panel-specific fields old code reads).
SUB DOCK_apply_panel (s AS INTEGER)
    DIM id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER
    id = DOCK_slot_panel%(s)
    IF id = DP_NONE _ORELSE DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN EXIT SUB
    x = DOCK_SLOT(s).x: y = DOCK_SLOT(s).y: w = DOCK_SLOT(s).w: h = DOCK_SLOT(s).h
    IF DOCK_slot_titled%(s) THEN y = y + DOCK_TITLE_H: h = h - DOCK_TITLE_H
    DOCK_apply_rect id, x, y, w, h
END SUB


''
' Give panel id the rect (x, y, w, h): the fields its own code reads.
SUB DOCK_apply_rect (id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    DPANEL(id).rVis = TRUE
    DPANEL(id).rx = x: DPANEL(id).ry = y: DPANEL(id).rw = w: DPANEL(id).rh = h
    SELECT CASE id
        CASE DP_TOOLBOX
            ' (the toolbox family lays out in its units at its own Scale:
            ' GUI/PANEL-SURFACE - the same as the rect at Auto)
            PSURF_set_rect id, x, y, w, h
            SCRN.toolboxX% = x
            TB_RECT_X = x
            TB_RECT_Y = y + DOCK_tb_inset%
            TB_RECT_W = PSURF(id).uw
            ' the buttons reflow into the width they are given: a floating
            ' toolbox follows its window, a docked one fills a wider slot
            TOOLBAR_fit_width PSURF(id).uw, DOCK_tb_follows%
        CASE DP_WORKFLOW
            PSURF_set_rect id, x, y, w, h
            WF_place x, y, PSURF(id).uw, PSURF(id).uh
        CASE DP_TEXTBAR ' (lays out in its units at its own Scale: GUI/PANEL-SURFACE)
            PSURF_set_rect id, x, y, w, h
            TEXT_BAR.barX% = x: TEXT_BAR.barY% = y
            TEXT_BAR.barW% = PSURF(id).uw: TEXT_BAR.barH% = PSURF(id).uh
        CASE DP_SELBAR
            PSURF_set_rect id, x, y, w, h
            SELBAR.x = x: SELBAR.y = y
            SELBAR.w = PSURF(id).uw: SELBAR.h = PSURF(id).uh
        CASE DP_MYPAINT
            PSURF_set_rect id, x, y, w, h
            MYPP.x = x: MYPP.y = y
            MYPP.w = PSURF(id).uw: MYPP.h = PSURF(id).uh
        CASE DP_MYPSET
            PSURF_set_rect id, x, y, w, h
            MPS.x = x: MPS.y = y
            MPS.w = PSURF(id).uw: MPS.h = PSURF(id).uh
        CASE DP_BRUSHES
            PSURF_set_rect id, x, y, w, h
            BSP.x = x: BSP.y = y
            BSP.w = PSURF(id).uw: BSP.h = PSURF(id).uh
        CASE DP_ORGANIZER
            PSURF_set_rect id, x, y, w, h
            ORG_RECT_X = x: ORG_RECT_W = PSURF(id).uw
            ORG_RECT_Y = y: ORG_RECT_H = PSURF(id).uh
        CASE DP_DRAWER
            PSURF_set_rect id, x, y, w, h
            DRW_RECT_X = x: DRW_RECT_W = PSURF(id).uw
            DRW_RECT_Y = y: DRW_RECT_Y2 = y + PSURF(id).uh - 1
        CASE DP_LAYERS
            ' (at its own Scale it lays out in panel units: GUI/PANEL-SURFACE)
            PSURF_set_rect id, x, y, w, h
            SCRN.layerPanelX% = x
            LAYER_PANEL.slotW% = PSURF(id).uw
            LAYER_PANEL.panelY1% = y: LAYER_PANEL.panelY2% = y + PSURF(id).uh - 1
        CASE DP_EDITBAR
            ' (at its own Scale it lays out in panel units: GUI/PANEL-SURFACE)
            PSURF_set_rect id, x, y, w, h
            SCRN.editBarX% = x
            EDIT_BAR.slotW% = PSURF(id).uw
            BL_HROWS(BL_EDITBAR) = 0: IF DOCK_in_row%(id) THEN BL_HROWS(BL_EDITBAR) = BL_hbar_rows_fit%(PSURF(id).uh) ' (a top / bottom row: sideways)
            EDIT_BAR.panelY1% = y: EDIT_BAR.panelY2% = y + PSURF(id).uh - 1
        CASE DP_ADVBAR
            PSURF_set_rect id, x, y, w, h
            SCRN.advBarX% = x
            ADV_BAR.slotW% = PSURF(id).uw
            BL_HROWS(BL_ADVBAR) = 0: IF DOCK_in_row%(id) THEN BL_HROWS(BL_ADVBAR) = BL_hbar_rows_fit%(PSURF(id).uh)
            ADV_BAR.panelY1% = y: ADV_BAR.panelY2% = y + PSURF(id).uh - 1
        CASE DP_CHARMAP
            ' (at its own Scale it lays out in panel units: GUI/PANEL-SURFACE)
            PSURF_set_rect id, x, y, w, h
            SCRN.charMapX% = x
            CHARMAP.panelX1% = x
            CHARMAP.panelX2% = x + PSURF(id).uw - 1
            CHARMAP.panelY1% = y
            CHARMAP.panelY2% = y + PSURF(id).uh - 1
            REGION_set_bounds REGION_CHARMAP, x, y, w, h, ZORDER_PANEL
            IF CHARMAP.panelY2% < CHARMAP.panelY1% THEN CHARMAP.panelY2% = CHARMAP.panelY1%
            CHARMAP.panelW% = PSURF(id).uw
            CHARMAP.gridX% = CHARMAP.panelX1% + 2
            CHARMAP.gridY% = CHARMAP.panelY1% + 2
        CASE DP_MIXER
            COLORMIXER.docked% = TRUE
            FPANEL_fit DP_MIXER, w, h ' fill the slot
            COLORMIXER.dispX% = x + (w - COLORMIXER.dispW%) \ 2
            COLORMIXER.dispY% = y
        CASE DP_ADVCP
            ADVCP.docked% = TRUE
            FPANEL_fit DP_ADVCP, w, h ' fill the slot
            ADVCP.dispX% = x + (w - ADVCP.dispW%) \ 2
            ADVCP.dispY% = y
        CASE DP_CS3D
            CS3D.docked% = TRUE
            FPANEL_fit DP_CS3D, w, h ' fill the slot
            CS3D.dispX% = x + (w - CS3D.dispW%) \ 2
            CS3D.dispY% = y
        CASE DP_PEN
            PENP.docked% = TRUE
            FPANEL_fit DP_PEN, w, h ' fill the slot
            PENP.dispX% = x + (w - PENP.dispW%) \ 2
            PENP.dispY% = y
        CASE DP_ANIM
            ANIMP.docked = TRUE
            FPANEL_fit DP_ANIM, w, h ' fill the slot
            ANIMP.dispX = x + (w - ANIMP.dispW) \ 2
            ANIMP.dispY = y
        CASE DP_SWATCH
            SWP.docked = TRUE
            FPANEL_fit DP_SWATCH, w, h ' fill the slot (the grid takes the height and scrolls)
            SWP.dispX = x + (w - SWP.dispW) \ 2
            SWP.dispY = y
        CASE DP_PREVIEW
            DIM pvRs AS SINGLE
            PREVIEW_compute_display
            pvRs = PREVIEW.renderScale!
            IF pvRs <= 0 THEN pvRs = 1
            PREVIEW.docked% = TRUE
            PREVIEW.x% = x: PREVIEW.y% = y
            PREVIEW.w% = _MAX(PREVIEW_MIN_W, INT(w / pvRs))
            PREVIEW.h% = _MAX(PREVIEW_MIN_H, INT(h / pvRs))
            PREVIEW_compute_display
        CASE DP_BROWSER
            BROWSER.docked% = TRUE
            BROWSER.maximized% = FALSE
            BROWSER.dispX% = x: BROWSER.dispY% = y
            BROWSER.dispW% = w: BROWSER.dispH% = h
            IF BROWSER.initialized% THEN BROWSER_sync_fd_from_display ' its file-dialog rect follows (native px)
    END SELECT
END SUB


''
' The drag-resize id (GUI/DOCK-RESIZE) a column's inner edge drives: the column's
' main panel (toolbox > layers > advanced bar > edit bar; none for the charmap).
FUNCTION DOCK_col_resize_id% (c AS INTEGER)
    DIM o AS INTEGER, s AS INTEGER, t AS INTEGER, id AS INTEGER, best AS INTEGER, r AS INTEGER, rank AS INTEGER, bestRank AS INTEGER
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        FOR t = 1 TO DOCK_SLOT(s).ntabs
            id = DOCK_TAB(s, t)
            IF DOCK_panel_shown%(id) THEN
                SELECT CASE id
                    CASE DP_TOOLBOX: r = DOCK_TOOLBOX: rank = 4
                    ' the layers' width beats the toolbox's columns: the toolbox
                    ' reflows into it (Rick, 2026-11-06)
                    CASE DP_LAYERS: r = DOCK_LAYERS: rank = 5
                    CASE DP_ADVBAR: r = DOCK_ADVBAR: rank = 2
                    CASE DP_EDITBAR: r = DOCK_EDITBAR: rank = 1
                    CASE ELSE: r = DOCK_NONE: rank = 0
                END SELECT
                IF rank > bestRank THEN bestRank = rank: best = r
            END IF
        NEXT t
    NEXT o
    DOCK_col_resize_id% = best
END FUNCTION


''
' Lay out one column's height, slots and panels (pass: full-height columns
' first, then the ones under the menu bar); its x and width are set already
' (DOCK_row_solve).
SUB DOCK_place_columns (wantFull AS INTEGER, barY1 AS INTEGER, charTop AS INTEGER, dockY2 AS INTEGER)
    DIM side AS INTEGER, o AS INTEGER, c AS INTEGER, so AS INTEGER, s AS INTEGER, first AS INTEGER, rid AS INTEGER
    FOR side = DOCK_LEFT TO DOCK_RIGHT
        FOR o = 1 TO DOCK_MAX_COLS
            c = DOCK_col_at%(side, o)
            IF c = 0 THEN EXIT FOR
            IF DOCK_COL(c).vis _ANDALSO DOCK_COL(c).full = wantFull THEN
                ' x: DOCK_row_solve
                IF wantFull THEN
                    DOCK_COL(c).y = 0
                ELSE
                    ' under the menu bar; the character map keeps its own rule
                    ' (menu bar shown at all, not whether it is auto-hidden)
                    DOCK_COL(c).y = barY1
                    first = DOCK_slot_panel%(DOCK_slot_at%(c, 1))
                    IF first = DP_CHARMAP THEN DOCK_COL(c).y = charTop
                END IF
                DOCK_COL(c).h = dockY2 - DOCK_COL(c).y + 1
                DOCK_stack_column c
                FOR so = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, so)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis THEN DOCK_apply_panel s
                NEXT so
                rid = DOCK_col_resize_id%(c)
                ' no toolbox / layers / bar: the column's own width edge
                IF rid = DOCK_NONE _ANDALSO c <= DOCK_COUNT - DOCK_COLW + 1 THEN rid = DOCK_COLW + c - 1
                IF rid THEN DOCK_set_edge rid, DOCK_COL(c).x, DOCK_COL(c).w, (side = DOCK_LEFT), DOCK_COL(c).y, dockY2
            END IF
        NEXT o
    NEXT side
END SUB


''
' The whole side layout (SCREEN_compute_layout): columns get widths from their
' panels, full-height columns go outermost, the menu bar spans the rest.
' Leaves DOCK_LX/DOCK_RX (the canvas edges) and DOCK_MENU_LX/RX.
SUB DOCK_layout (barY1 AS INTEGER, charTop AS INTEGER, dockY2 AS INTEGER)
    DIM c AS INTEGER, so AS INTEGER, s AS INTEGER, id AS INTEGER, t AS INTEGER, i AS INTEGER
    IF DOCK_CUSTOM = 0 _ORELSE DOCK_READY = 0 THEN DOCK_build_default
    IF DOCK_CUSTOM THEN DOCK_adopt_new_panels
    IF DOCK_CUSTOM THEN DOCK_bars_follow ' (Tool Options and the Text Bar: one place)
    FOR i = 1 TO DP_COUNT: DPANEL(i).rVis = FALSE: NEXT i
    DOCK_native_reset_docked
    DOCK_native_init_docked
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used THEN
            DOCK_COL(c).vis = FALSE
            DOCK_COL(c).full = FALSE
            FOR so = 1 TO DOCK_MAX_SLOTS
                s = DOCK_slot_at%(c, so)
                IF s = 0 THEN EXIT FOR
                id = DOCK_slot_panel%(s)
                IF id THEN
                    DOCK_COL(c).vis = TRUE
                    FOR t = 1 TO DOCK_SLOT(s).ntabs
                        IF DOCK_panel_shown%(DOCK_TAB(s, t)) THEN
                            IF DPANEL(DOCK_TAB(s, t)).tall THEN DOCK_COL(c).full = TRUE
                        END IF
                    NEXT t
                END IF
            NEXT so
            IF DOCK_is_row%(c) THEN
                DOCK_COL(c).full = FALSE ' (a row: DOCK_rows_measure / DOCK_place_rows)
            ELSE
                DOCK_COL(c).w = DOCK_col_width%(c)
            END IF
        END IF
    NEXT c
    DOCK_row_solve
    DOCK_rows_measure barY1, dockY2
    ' full-width rows run under the menu bar across the whole window: the side
    ' columns sit between them, none full height (the menu bar spans it all)
    DIM colY1 AS INTEGER, colChar AS INTEGER, colY2 AS INTEGER
    colY1 = barY1: colChar = charTop: colY2 = dockY2
    IF DOCK_ROWS_FULL THEN
        IF DOCK_ROWS_TOPH > 0 THEN
            FOR c = 1 TO DOCK_MAX_COLS: DOCK_COL(c).full = FALSE: NEXT c
            colY1 = barY1 + DOCK_ROWS_TOPH: colChar = colY1
        END IF
        colY2 = dockY2 - DOCK_ROWS_BOTH
    END IF
    ' full height spreads outward: a column outside a full-height one is full
    ' height too, so the menu bar (spanning the rest) stays one piece and the
    ' columns sit in their saved order
    DIM fside AS INTEGER, fo AS INTEGER, innerFull AS INTEGER, fc AS INTEGER
    FOR fside = DOCK_LEFT TO DOCK_RIGHT
        innerFull = 0
        FOR fo = 1 TO DOCK_MAX_COLS
            fc = DOCK_col_at%(fside, fo)
            IF fc = 0 THEN EXIT FOR
            IF DOCK_COL(fc).vis _ANDALSO DOCK_COL(fc).full THEN innerFull = fo
        NEXT fo
        FOR fo = 1 TO innerFull
            fc = DOCK_col_at%(fside, fo)
            IF fc THEN DOCK_COL(fc).full = TRUE
        NEXT fo
    NEXT fside
    DOCK_LAID_OUT = TRUE
    ' the menu bar spans the space between the full-height columns
    DOCK_MENU_LX = 0
    DOCK_MENU_RX = SCRN.w& - 1
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis _ANDALSO DOCK_COL(c).full THEN
            IF DOCK_COL(c).side = DOCK_LEFT THEN
                IF DOCK_COL(c).x + DOCK_COL(c).w > DOCK_MENU_LX THEN DOCK_MENU_LX = DOCK_COL(c).x + DOCK_COL(c).w
            ELSE
                IF DOCK_COL(c).x - 1 < DOCK_MENU_RX THEN DOCK_MENU_RX = DOCK_COL(c).x - 1
            END IF
        END IF
    NEXT c
    DOCK_place_columns TRUE, colY1, colChar, colY2
    DOCK_place_columns FALSE, colY1, colChar, colY2
    DOCK_place_rows barY1, dockY2
    DOCK_place_floats barY1, dockY2
    IF DOCK_ADOPT_SAVE THEN DOCK_ADOPT_SAVE = FALSE: CONFIG_save ' (DOCK_adopt_new_panels)
    IF LEN(DOCK_DUMP_PATH) THEN DOCK_dump_write barY1, dockY2
END SUB


' =============================================================================
' Rows: the TOP / BOTTOM docks (the columns' rules turned sideways)
' =============================================================================
' A row's slots lie left to right in one QB64_GJ_LIB/LAYOUT line across the
' canvas area (DOCK_LX..DOCK_RX, or the whole window with DOCK_ROWS_FULL): a
' panel whose height follows its width (the toolbox, organizer, workflow
' buttons, the bars sideways) takes the narrowest width that fits the row's
' height; the stretching ones (Browser, Preview, Swatches, Drawer) share the
' rest. Rows stack from the outside in: the top ones under the menu bar (and
' the text bar, between the side docks), the bottom ones above the palette
' strip. The canvas re-centres in what is left (DOCK_SHIFT_Y). The Browser's
' old band is a row now (BAND= loads as one: DOCK_load_snapshot).

CONST DOCK_ROW_CANVAS_MIN = 60   ' the canvas keeps at least this much height: the innermost rows hide first
CONST DOCK_ROW_COLLAPSED_W = 96  ' a collapsed slot in a row: just its strip this wide

''
' The width (viewport px) of the toolbox with at most rws button rows: the
' fewest columns that get there (every button in one row when none do).
FUNCTION DOCK_row_tb_w% (rws AS INTEGER)
    DIM c AS INTEGER, n AS INTEGER
    n = TB_LIVE_COUNT: IF n < 1 THEN n = 1
    FOR c = 1 TO n
        IF TOOLBAR_rows_for%(c) <= rws THEN EXIT FOR
    NEXT c
    IF c > n THEN c = n
    DOCK_row_tb_w% = PSURF_v%(DP_TOOLBOX, TOOLBAR_cols_w%(c))
END FUNCTION


''
' The shortest panel id goes in a row (px): at its widest.
FUNCTION DOCK_row_panel_min_h% (id AS INTEGER)
    DIM h AS INTEGER
    SELECT CASE id
        CASE DP_TOOLBOX: h = DOCK_fixed_h%(id, DOCK_row_tb_w%(1))
        CASE DP_ORGANIZER ' (its stack tops, the last widgets beside them: ORGANIZER_layout_in%)
            h = PSURF_v%(id, _MIN(_MIN(ORGANIZER_height_for%(ORGANIZER_max_w%), ORGANIZER_split_h%), ORGANIZER_flat_h%)) ' (down to the flat line: one button high)
        CASE DP_WORKFLOW: h = PSURF_v%(id, WF_height%(WF_max_w%))
        CASE DP_EDITBAR, DP_ADVBAR: h = PSURF_v%(id, BL_hbar_h%(1))
        CASE DP_ADVCP: h = FPANEL_disp_of%(id, ADVCP_title_h% + ADVCP_ROW_WHEEL_MIN + _IIF(ACP_STATE.quantBar% <> 0, ACP_QUANT_ROW_H + 1, 0)) ' (laid sideways: the wheel takes the row's height)
        CASE DP_MIXER: h = FPANEL_disp_of%(id, COLORMIXER_row_min_h%) ' (laid sideways: the SV field takes the row's height)
        CASE DP_PEN: h = FPANEL_disp_of%(id, PENP_row_h%) ' (its groups side by side: PENP_layout)
        CASE DP_TEXTBAR: h = DOCK_fixed_h%(id, DOCK_textbar_row_w%) ' (its lines at the width the row gives it)
        CASE DP_SELBAR, DP_MYPSET: h = DOCK_fixed_h%(id, DOCK_bar_row_w%(id))
        CASE DP_CS3D, DP_ANIM: h = DOCK_fixed_h%(id, DOCK_panel_w%(id))
        CASE ELSE: h = _MAX(DOCK_min_h%(id), DOCK_MIN_FLEX_H)
    END SELECT
    DOCK_row_panel_min_h% = h
END FUNCTION


''
' The height panel id asks of a row it is in (px) when the row has no height
' of its own: two button rows for the toolbox and the bars, one row of stacks
' for the organizer, the floating family's natural height, the Browser's old
' band height.
FUNCTION DOCK_row_want_h% (id AS INTEGER)
    DIM h AS INTEGER
    SELECT CASE id
        CASE DP_TOOLBOX: h = DOCK_fixed_h%(id, DOCK_row_tb_w%(2))
        CASE DP_EDITBAR, DP_ADVBAR: h = PSURF_v%(id, BL_hbar_h%(2))
        CASE DP_BROWSER: h = 220
        CASE DP_PREVIEW, DP_LAYERS, DP_CHARMAP: h = 160
        CASE DP_DRAWER, DP_SWATCH: h = 96
        CASE DP_MYPAINT: h = 140
        CASE DP_BRUSHES: h = PSURF_v%(id, BSP_want_h%) ' (its sizes, up to three rows: no blank band under them)
    END SELECT
    DOCK_row_want_h% = _MAX(h, DOCK_row_panel_min_h%(id))
END FUNCTION


''
' Row c's height this frame: the one set by dragging its inner edge (wpx),
' else the tallest its panels want - never below what they need.
FUNCTION DOCK_row_h% (c AS INTEGER)
    DIM so AS INTEGER, s AS INTEGER, id AS INTEGER, th AS INTEGER, want AS INTEGER, mn AS INTEGER, h AS INTEGER
    DIM bars AS INTEGER, others AS INTEGER
    FOR so = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, so)
        IF s = 0 THEN EXIT FOR
        id = DOCK_slot_panel%(s)
        IF id THEN
            th = 0: IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
            IF (id = DP_SELBAR _ORELSE id = DP_TEXTBAR) _ANDALSO th = 0 _ANDALSO DOCK_SLOT(s).collapsed = 0 THEN bars = TRUE ELSE others = TRUE
            IF DOCK_SLOT(s).collapsed THEN
                mn = _MAX(mn, th)
            ELSE
                want = _MAX(want, th + DOCK_row_want_h%(id))
                mn = _MAX(mn, th + DOCK_row_panel_min_h%(id))
            END IF
        END IF
    NEXT so
    IF DOCK_COL(c).wpx > 0 THEN h = DOCK_COL(c).wpx ELSE h = want
    IF h < mn THEN h = mn
    ' a row of Tool Options / the Text Bar alone is as tall as its lines: no dead strip
    ' under a one-line bar (14 px) and no taller for a dragged edge
    IF bars _ANDALSO others = 0 THEN
        h = mn
    ELSEIF h < DOCK_ROW_MIN_H THEN
        h = DOCK_ROW_MIN_H
    END IF
    DOCK_row_h% = h
END FUNCTION


''
' What panel id asks of a row hh px tall (its rect's height, under any strip):
' its width - the narrowest that fits for the panels that reflow (minW =
' basisW), the stretching ones' minimum (stretchy), else its own width.
SUB DOCK_row_panel_box (id AS INTEGER, hh AS INTEGER, minW AS INTEGER, basisW AS INTEGER, stretchy AS INTEGER)
    DIM c AS INTEGER, n AS INTEGER, w AS INTEGER, u AS INTEGER, mx AS INTEGER, h AS INTEGER
    stretchy = FALSE
    SELECT CASE id
        CASE DP_TOOLBOX
            n = TB_LIVE_COUNT: IF n < 1 THEN n = 1
            basisW = PSURF_v%(id, TOOLBAR_cols_w%(n))
            FOR c = 1 TO n
                w = PSURF_v%(id, TOOLBAR_cols_w%(c))
                IF DOCK_fixed_h%(id, w) <= hh THEN basisW = w: EXIT FOR
            NEXT c
        CASE DP_ORGANIZER, DP_WORKFLOW
            IF id = DP_ORGANIZER THEN
                u = ORG_COL_W * _MAX(1, ORGANIZER_scale%) + 2: mx = _MAX(_MAX(ORGANIZER_max_w%, ORGANIZER_split_w%), ORGANIZER_flat_w%)
            ELSE
                u = WF_min_w%: mx = WF_max_w%
            END IF
            DO
                IF u >= mx THEN u = mx: EXIT DO
                IF id = DP_ORGANIZER THEN h = ORGANIZER_height_in%(u, PSURF_u%(id, hh)) ELSE h = WF_height%(u)
                IF PSURF_v%(id, h) <= hh THEN EXIT DO
                u = u + 2
            LOOP
            basisW = PSURF_v%(id, u)
        CASE DP_EDITBAR
            basisW = PSURF_v%(id, BL_hbar_w%(BL_EDITBAR, BL_hbar_rows_fit%(PSURF_u%(id, hh))))
        CASE DP_ADVBAR
            basisW = PSURF_v%(id, BL_hbar_w%(BL_ADVBAR, BL_hbar_rows_fit%(PSURF_u%(id, hh))))
        CASE DP_ADVCP ' the wheel as tall as the row, its controls in columns beside it (ADVCP_layout);
            '            short of room it narrows them, down to its width with VARIATIONS closed
            basisW = FPANEL_disp_of%(id, ADVCP_row_w%(FPANEL_native_of%(id, hh)))
            minW = _MIN(basisW, FPANEL_disp_of%(id, ADVCP_row_min_w%(FPANEL_native_of%(id, hh))))
            EXIT SUB
        CASE DP_MIXER ' the SV field as tall as the row, its rows in columns beside it (COLORMIXER_relayout)
            basisW = FPANEL_disp_of%(id, COLORMIXER_row_w%(FPANEL_native_of%(id, hh)))
            minW = _MIN(basisW, FPANEL_disp_of%(id, 2 * CP_STATE.natW)) ' (short of room: the field + OLD / NEW, the MORE strips that fit)
            EXIT SUB
        CASE DP_PEN ' its groups in columns side by side, the graph a square as tall as the row (PENP_layout)
            basisW = FPANEL_disp_of%(id, PENP_row_w%(FPANEL_native_of%(id, hh), PENP_ROW_COL_W))
            minW = _MIN(basisW, FPANEL_disp_of%(id, PENP_row_w%(FPANEL_native_of%(id, hh), PENP_ROW_COL_MIN)))
            stretchy = TRUE
            EXIT SUB
        CASE DP_TEXTBAR ' the room the row leaves it: its controls wrap into lines (the row as tall as they need)
            minW = PSURF_v%(id, TEXT_BAR_MIN_W)
            basisW = PSURF_v%(id, TEXT_BAR_ROW_BASIS_W)
            stretchy = TRUE
            EXIT SUB
        CASE DP_SELBAR ' (as the text bar)
            minW = PSURF_v%(id, SELBAR_MIN_W)
            basisW = PSURF_v%(id, SELBAR_ROW_BASIS_W)
            stretchy = TRUE
            EXIT SUB
        CASE DP_MYPAINT ' its grid takes the room the row gives it
            minW = PSURF_v%(id, MYPP_MIN_W)
            basisW = PSURF_v%(id, MYPP_COL_W * 2)
            stretchy = TRUE
            EXIT SUB
        CASE DP_MYPSET ' its sliders side by side in the row
            minW = PSURF_v%(id, MPS_MIN_W)
            basisW = PSURF_v%(id, MPS_SLIDER_W * 4 + 22)
            stretchy = TRUE
            EXIT SUB
        CASE DP_BRUSHES ' its grid takes the room the row gives it
            minW = PSURF_v%(id, BSP_MIN_W)
            basisW = PSURF_v%(id, BSP_COL_W * 2)
            stretchy = TRUE
            EXIT SUB
        CASE DP_CHARMAP ' its grid takes the room the row gives it, whole cells (CHARMAP_cells_per_row%)
            minW = PSURF_v%(id, CHARMAP_width_for%(CHARMAP_MIN_CELLS_PER_ROW))
            basisW = PSURF_v%(id, CHARMAP_width_for%(CHARMAP_MAX_CELLS_PER_ROW))
            stretchy = TRUE
            EXIT SUB
        CASE ELSE
            DOCK_panel_box id, FALSE, 0, minW, basisW, stretchy
            IF id = DP_DRAWER THEN stretchy = TRUE ' (bins fill a wide row)
            EXIT SUB
    END SELECT
    minW = basisW
END SUB


''
' Each row's height and whether it shows this frame (DOCK_layout, before the
' columns: full-width rows set where they start and end). Too tall for the
' window: the innermost rows of the taller side hide first (autoh), so the
' canvas keeps DOCK_ROW_CANVAS_MIN.
SUB DOCK_rows_measure (barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM c AS INTEGER, o AS INTEGER, room AS INTEGER, side AS INTEGER, hid AS INTEGER
    DOCK_ROWS_TOPH = 0: DOCK_ROWS_BOTH = 0
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_is_row%(c) THEN
            DOCK_COL(c).autoh = FALSE
            DOCK_COL(c).full = FALSE
            IF DOCK_COL(c).vis THEN
                DOCK_COL(c).h = DOCK_row_h%(c)
                IF DOCK_COL(c).side = DOCK_TOP THEN DOCK_ROWS_TOPH = DOCK_ROWS_TOPH + DOCK_COL(c).h ELSE DOCK_ROWS_BOTH = DOCK_ROWS_BOTH + DOCK_COL(c).h
            END IF
        END IF
    NEXT c
    room = dockY2 - barY1 + 1 - DOCK_TOPBAR_H - DOCK_ROW_CANVAS_MIN
    DO WHILE DOCK_ROWS_TOPH + DOCK_ROWS_BOTH > room
        IF DOCK_ROWS_TOPH >= DOCK_ROWS_BOTH THEN side = DOCK_TOP ELSE side = DOCK_BOTTOM
        hid = 0
        FOR o = 1 TO DOCK_MAX_COLS
            c = DOCK_col_at%(side, o)
            IF c = 0 THEN EXIT FOR
            IF DOCK_COL(c).vis THEN hid = c
        NEXT o
        IF hid = 0 THEN EXIT DO
        DOCK_COL(hid).vis = FALSE: DOCK_COL(hid).autoh = TRUE
        IF side = DOCK_TOP THEN DOCK_ROWS_TOPH = DOCK_ROWS_TOPH - DOCK_COL(hid).h ELSE DOCK_ROWS_BOTH = DOCK_ROWS_BOTH - DOCK_COL(hid).h
    LOOP
END SUB


''
' Lay row c's showing slots left to right in its rect and hand each panel its
' rect. A slot that does not fit at all is dropped for the frame (vis FALSE).
SUB DOCK_lay_row (c AS INTEGER)
    DIM o AS INTEGER, s AS INTEGER, id AS INTEGER, th AS INTEGER, l AS LONG, mn AS INTEGER, bs AS INTEGER, st AS INTEGER
    DIM it(1 TO DOCK_MAX_SLOTS) AS LONG
    LAY_reset
    l = LAY_line_new&(DOCK_COL(c).w, 0)
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        DOCK_SLOT(s).autoc = FALSE
        id = DOCK_slot_panel%(s)
        DOCK_SLOT(s).vis = (id <> DP_NONE)
        IF id THEN
            th = 0: IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
            IF DOCK_SLOT(s).collapsed THEN
                it(o) = LAY_add_fixed&(l, DOCK_ROW_COLLAPSED_W)
            ELSE
                DOCK_row_panel_box id, DOCK_COL(c).h - th, mn, bs, st
                IF DOCK_SLOT(s).share > 1 THEN
                    ' a width set by dragging its right edge (px): never narrower
                    ' than what fits the row's height, gives way when the row is full
                    IF st THEN it(o) = LAY_add&(l, mn, _MAX(mn, DOCK_SLOT(s).share), 0, 0, 1) ELSE it(o) = LAY_add&(l, bs, _MAX(bs, DOCK_SLOT(s).share), 0, 0, 1)
                ELSEIF st THEN
                    it(o) = LAY_add&(l, mn, 0, 0, 1, 0)
                ELSEIF (id = DP_ADVCP _ORELSE id = DP_MIXER) _ANDALSO mn < bs THEN ' (narrows to fit: ADVCP_layout / COLORMIXER_side_flow%)
                    it(o) = LAY_add&(l, mn, bs, 0, 0, 1)
                ELSE
                    it(o) = LAY_add_fixed&(l, bs)
                END IF
            END IF
            ' no room: the last ones go first, never the first
            IF o >= 2 THEN LAY_drop it(o), o, 0
        END IF
    NEXT o
    LAY_solve l
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        IF DOCK_SLOT(s).vis THEN
            IF LAY_ITEMS(it(o)).dropped _ORELSE LAY_ITEMS(it(o)).size <= 0 THEN
                DOCK_SLOT(s).vis = FALSE
            ELSE
                DOCK_SLOT(s).x = DOCK_COL(c).x + LAY_ITEMS(it(o)).at
                DOCK_SLOT(s).w = _MIN(LAY_ITEMS(it(o)).size, DOCK_COL(c).x + DOCK_COL(c).w - DOCK_SLOT(s).x)
                DOCK_SLOT(s).y = DOCK_COL(c).y
                DOCK_SLOT(s).h = DOCK_COL(c).h
                DOCK_apply_panel s
            END IF
        END IF
    NEXT o
END SUB


''
' The rows' rects (after the columns: between the side docks they span
' DOCK_LX..DOCK_RX), their slots and panels; the canvas shift for them.
SUB DOCK_place_rows (barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM o AS INTEGER, c AS INTEGER, y AS INTEGER, x1 AS INTEGER, x2 AS INTEGER
    DOCK_L_BARY1 = barY1: DOCK_L_DOCKY2 = dockY2
    DOCK_BAND_W = 0 ' (the old band is never laid out: it loads as a row)
    IF DOCK_ROWS_FULL THEN
        x1 = DOCK_WX1: x2 = DOCK_WX2
        y = barY1 ' the text bar goes under them (SCREEN_compute_layout)
    ELSE
        x1 = DOCK_LX: x2 = DOCK_RX
        y = barY1 + DOCK_TOPBAR_H
    END IF
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(DOCK_TOP, o)
        IF c = 0 THEN EXIT FOR
        IF DOCK_COL(c).vis THEN
            DOCK_COL(c).x = x1: DOCK_COL(c).w = x2 - x1 + 1: DOCK_COL(c).y = y
            DOCK_lay_row c
            y = y + DOCK_COL(c).h
        END IF
    NEXT o
    DOCK_ROWS_Y1 = y
    IF DOCK_ROWS_FULL THEN DOCK_ROWS_Y1 = y + DOCK_TOPBAR_H
    y = dockY2 + 1
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(DOCK_BOTTOM, o)
        IF c = 0 THEN EXIT FOR
        IF DOCK_COL(c).vis THEN
            y = y - DOCK_COL(c).h
            DOCK_COL(c).x = x1: DOCK_COL(c).w = x2 - x1 + 1: DOCK_COL(c).y = y
            DOCK_lay_row c
        END IF
    NEXT o
    DOCK_ROWS_Y2 = y - 1
    ' the canvas centres between the rows - but not the Selection Bar's own row: it comes
    ' and goes with the selection tools, and the canvas must not jump under the pointer
    ' each time (it overlaps the canvas's top instead)
    DIM tr AS INTEGER
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(DOCK_TOP, o)
        IF c = 0 THEN EXIT FOR
        IF DOCK_COL(c).vis _ANDALSO DOCK_row_transient%(c) THEN tr = tr + DOCK_COL(c).h
    NEXT o
    DOCK_SHIFT_Y = (DOCK_ROWS_TOPH - tr - DOCK_ROWS_BOTH) \ 2
END SUB

''
' Row c holds only the Selection Bar (a tool's bar: shown with the selection tools).
FUNCTION DOCK_row_transient% (c AS INTEGER)
    DIM so AS INTEGER, s AS INTEGER, id AS INTEGER, n AS INTEGER
    FOR so = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, so)
        IF s = 0 THEN EXIT FOR
        id = DOCK_slot_panel%(s)
        IF id <> 0 _ANDALSO id <> DP_SELBAR THEN EXIT FUNCTION
        IF id = DP_SELBAR THEN n = n + 1
    NEXT so
    DOCK_row_transient% = (n > 0)
END FUNCTION


''
' The text bar's top this frame: under full-width top rows, else where it
' always was (the menu bar's bottom). SCREEN_compute_layout.
FUNCTION DOCK_text_bar_y% (barY1 AS INTEGER)
    IF DOCK_ROWS_FULL THEN DOCK_text_bar_y% = barY1 + DOCK_ROWS_TOPH ELSE DOCK_text_bar_y% = barY1
END FUNCTION


''
' The x range rows span this frame: between the side docks, or the window.
SUB DOCK_row_span (x1 AS INTEGER, x2 AS INTEGER)
    IF DOCK_ROWS_FULL THEN
        x1 = DOCK_WX1: x2 = DOCK_WX2
    ELSE
        x1 = DOCK_LX: x2 = DOCK_RX
    END IF
END SUB


''
' Handle menu "Dock Along the Top / Bottom": panel id goes to the end of the
' innermost row on that side (side by side with what is there), or a new row
' when there is none.
SUB DOCK_dock_along (id AS INTEGER, side AS INTEGER)
    DIM o AS INTEGER, c AS INTEGER, inner AS INTEGER, r AS INTEGER
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(side, o)
        IF c = 0 THEN EXIT FOR
        inner = c
    NEXT o
    IF inner _ANDALSO DPANEL(id).slot > 0 THEN
        IF DOCK_SLOT(DPANEL(id).slot).col = inner THEN EXIT SUB ' already there
    END IF
    IF inner THEN r = DOCK_move_to_slot%(id, inner, DOCK_MAX_SLOTS + 1)
    IF r = 0 THEN r = DOCK_move_to_new_col%(id, side, DOCK_MAX_COLS + 1)
    DPANEL(id).fl = FALSE
END SUB


''
' DOCK_drop_target over a row: near its outer / inner edge a new row before /
' after it, over a panel's left / right third a slot before / after it (its
' middle: a tab), over the empty rest the row's end. TRUE when (mx, my) is on
' a row (the target may still be none: onto its own slot).
FUNCTION DOCK_row_drop_target% (mx AS INTEGER, my AS INTEGER)
    DIM c AS INTEGER, o AS INTEGER, s AS INTEGER, third AS INTEGER, mv AS INTEGER, lastS AS INTEGER, lastX AS INTEGER
    DIM edgeOut AS INTEGER, edgeIn AS INTEGER, topB AS INTEGER
    mv = DOCK_UI.mvPanel
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_is_row%(c) _ANDALSO DOCK_COL(c).vis THEN
            IF mx >= DOCK_COL(c).x _ANDALSO mx < DOCK_COL(c).x + DOCK_COL(c).w _ANDALSO my >= DOCK_COL(c).y _ANDALSO my < DOCK_COL(c).y + DOCK_COL(c).h THEN
                DOCK_row_drop_target% = TRUE
                IF DOCK_COL(c).side = DOCK_TOP THEN
                    edgeOut = (my < DOCK_COL(c).y + 6): edgeIn = (my >= DOCK_COL(c).y + DOCK_COL(c).h - 6)
                ELSE
                    edgeOut = (my >= DOCK_COL(c).y + DOCK_COL(c).h - 6): edgeIn = (my < DOCK_COL(c).y + 6)
                END IF
                IF edgeOut _ORELSE edgeIn THEN
                    DOCK_UI.tgtKind = DOCK_TGT_NEWCOL: DOCK_UI.tgtSide = DOCK_COL(c).side
                    DOCK_UI.tgtOrd = DOCK_COL(c).ord: IF edgeIn THEN DOCK_UI.tgtOrd = DOCK_COL(c).ord + 1
                    topB = (DOCK_COL(c).side = DOCK_TOP _ANDALSO edgeOut <> 0) _ORELSE (DOCK_COL(c).side = DOCK_BOTTOM _ANDALSO edgeIn <> 0)
                    DOCK_UI.tgtX = DOCK_COL(c).x: DOCK_UI.tgtW = DOCK_COL(c).w: DOCK_UI.tgtH = 12
                    IF topB THEN DOCK_UI.tgtY = DOCK_COL(c).y - 6 ELSE DOCK_UI.tgtY = DOCK_COL(c).y + DOCK_COL(c).h - 6
                    EXIT FUNCTION
                END IF
                lastX = DOCK_COL(c).x
                FOR o = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, o)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis THEN
                        lastS = s: lastX = DOCK_SLOT(s).x + DOCK_SLOT(s).w
                        IF mx >= DOCK_SLOT(s).x _ANDALSO mx < DOCK_SLOT(s).x + DOCK_SLOT(s).w THEN
                            third = DOCK_SLOT(s).w \ 3: IF third < 4 THEN third = 4
                            DOCK_UI.tgtY = DOCK_COL(c).y: DOCK_UI.tgtH = DOCK_COL(c).h
                            IF mx < DOCK_SLOT(s).x + third THEN
                                DOCK_UI.tgtKind = DOCK_TGT_SPLIT: DOCK_UI.tgtCol = c: DOCK_UI.tgtOrd = DOCK_SLOT(s).ord
                                DOCK_UI.tgtX = DOCK_SLOT(s).x: DOCK_UI.tgtW = third
                            ELSEIF mx >= DOCK_SLOT(s).x + DOCK_SLOT(s).w - third THEN
                                DOCK_UI.tgtKind = DOCK_TGT_SPLIT: DOCK_UI.tgtCol = c: DOCK_UI.tgtOrd = DOCK_SLOT(s).ord + 1
                                DOCK_UI.tgtX = DOCK_SLOT(s).x + DOCK_SLOT(s).w - third: DOCK_UI.tgtW = third
                            ELSE
                                DOCK_UI.tgtKind = DOCK_TGT_TAB: DOCK_UI.tgtSlot = s
                                DOCK_UI.tgtX = DOCK_SLOT(s).x: DOCK_UI.tgtW = DOCK_SLOT(s).w
                            END IF
                            IF DOCK_SLOT(s).ntabs = 1 _ANDALSO DOCK_TAB(s, 1) = mv THEN DOCK_UI.tgtKind = DOCK_TGT_NONE
                            IF DOCK_UI.mvGroup _ANDALSO s = DPANEL(mv).slot THEN DOCK_UI.tgtKind = DOCK_TGT_NONE
                            EXIT FUNCTION
                        END IF
                    END IF
                NEXT o
                ' the empty rest of the row: at its end
                IF lastS THEN
                    IF DOCK_SLOT(lastS).ntabs = 1 _ANDALSO DOCK_TAB(lastS, 1) = mv THEN EXIT FUNCTION ' it is already last
                END IF
                DOCK_UI.tgtKind = DOCK_TGT_SPLIT: DOCK_UI.tgtCol = c
                IF lastS THEN DOCK_UI.tgtOrd = DOCK_SLOT(lastS).ord + 1 ELSE DOCK_UI.tgtOrd = 1
                DOCK_UI.tgtX = lastX: DOCK_UI.tgtW = _MAX(16, DOCK_COL(c).x + DOCK_COL(c).w - lastX)
                DOCK_UI.tgtY = DOCK_COL(c).y: DOCK_UI.tgtH = DOCK_COL(c).h
                EXIT FUNCTION
            END IF
        END IF
    NEXT c
END FUNCTION



''
' The row whose inner edge (the side facing the canvas) is under (mx, my), 0 = none.
FUNCTION DOCK_row_edge_at% (mx AS INTEGER, my AS INTEGER)
    DIM c AS INTEGER, ey AS INTEGER
    IF DOCK_ui_busy% THEN EXIT FUNCTION
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_is_row%(c) _ANDALSO DOCK_COL(c).vis THEN
            IF mx >= DOCK_COL(c).x _ANDALSO mx < DOCK_COL(c).x + DOCK_COL(c).w THEN
                ' (a bottom row: only the canvas side of its seam - its panels'
                ' grips / title bars start on the seam row itself)
                IF DOCK_COL(c).side = DOCK_BOTTOM THEN
                    ey = DOCK_COL(c).y
                    IF my >= ey - 3 _ANDALSO my <= ey - 1 THEN DOCK_row_edge_at% = c: EXIT FUNCTION
                ELSE
                    ey = DOCK_COL(c).y + DOCK_COL(c).h - 1
                    IF my >= ey - 2 _ANDALSO my <= ey + 1 THEN DOCK_row_edge_at% = c: EXIT FUNCTION
                END IF
            END IF
        END IF
    NEXT c
END FUNCTION


FUNCTION DOCK_band_edge_at% (mx AS INTEGER, my AS INTEGER)
    DOCK_band_edge_at% = (DOCK_row_edge_at%(mx, my) <> 0)
END FUNCTION


''
' DOCK_handle_mouse%: drag a row's inner edge to set its height (wpx; the
' panels reflow into it - a shorter toolbox row gets more columns).
FUNCTION DOCK_handle_band_resize% (mx AS INTEGER, my AS INTEGER)
    DIM h AS INTEGER, c AS INTEGER
    c = DOCK_RZ_BAND
    IF c THEN
        IF DOCK_is_row%(c) = 0 THEN DOCK_RZ_BAND = 0: EXIT FUNCTION
        IF DOCK_COL(c).side = DOCK_BOTTOM THEN h = DOCK_RZ_BH0 - (my - DOCK_RZ_BY0) ELSE h = DOCK_RZ_BH0 + (my - DOCK_RZ_BY0)
        IF h < DOCK_ROW_MIN_H THEN h = DOCK_ROW_MIN_H
        IF h <> DOCK_COL(c).wpx THEN DOCK_COL(c).wpx = h: DOCK_redraw
        IF MOUSE.B1% = 0 THEN
            DOCK_RZ_BAND = 0
            DOCK_COL(c).wpx = DOCK_COL(c).h ' what its panels and the room allowed
            DOCK_change_begin
            DOCK_change_commit "Dock row:" + STR$(DOCK_COL(c).wpx) + " px"
        END IF
        MOUSE.UI_CHROME_CLICKED% = TRUE
        DOCK_handle_band_resize% = TRUE
        EXIT FUNCTION
    END IF
    IF MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0 THEN
        c = DOCK_row_edge_at%(mx, my)
        IF c THEN
            DOCK_RZ_BAND = c: DOCK_RZ_BY0 = my: DOCK_RZ_BH0 = DOCK_COL(c).h
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_band_resize% = TRUE
        END IF
    END IF
END FUNCTION


''
' Row slot s's narrowest width (px): what fits the row's height for a panel
' that reflows (toolbox, organizer, bars, workflow), else its minimum.
FUNCTION DOCK_row_slot_min_w% (s AS INTEGER)
    DIM id AS INTEGER, th AS INTEGER, mn AS INTEGER, bs AS INTEGER, st AS INTEGER, c AS INTEGER
    id = DOCK_slot_panel%(s): c = DOCK_SLOT(s).col
    IF id = DP_NONE _ORELSE c = 0 THEN DOCK_row_slot_min_w% = 16: EXIT FUNCTION
    th = 0: IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
    DOCK_row_panel_box id, DOCK_COL(c).h - th, mn, bs, st
    IF st THEN DOCK_row_slot_min_w% = _MAX(16, mn) ELSE DOCK_row_slot_min_w% = _MAX(16, bs)
END FUNCTION


''
' The row slot whose right edge is under (mx, my), 0 = none: 2px either side
' of it, under the handle strip (a slot's grip / title stays its handle), only
' where a docked panel is on top (never through a floating window).
FUNCTION DOCK_row_slot_edge_at% (mx AS INTEGER, my AS INTEGER)
    DIM c AS INTEGER, o AS INTEGER, s AS INTEGER, ex AS INTEGER, rg AS INTEGER
    IF DOCK_ui_busy% THEN EXIT FUNCTION
    rg = REGION_hit_test%(mx, my)
    SELECT CASE rg
        CASE REGION_GLOBAL, REGION_CANVAS, REGION_TOOLBAR, REGION_ORGANIZER, REGION_DRAWER, _
             REGION_EDIT_BAR, REGION_ADV_BAR, REGION_LAYER_PANEL, REGION_CHARMAP, REGION_WORKFLOW, REGION_TEXT_BAR, REGION_SEL_BAR, REGION_MYPAINT, REGION_MYPSET, REGION_BRUSHES
        CASE ELSE
            IF DOCK_native_for_region%(rg) = 0 THEN EXIT FUNCTION
    END SELECT
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_is_row%(c) _ANDALSO DOCK_COL(c).vis THEN
            IF my >= DOCK_COL(c).y + DOCK_TITLE_H _ANDALSO my < DOCK_COL(c).y + DOCK_COL(c).h THEN
                FOR o = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, o)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis _ANDALSO DOCK_SLOT(s).collapsed = 0 THEN
                        ex = DOCK_SLOT(s).x + DOCK_SLOT(s).w ' (the first px past it)
                        IF mx >= ex - DOCK_GRAB _ANDALSO mx < ex + DOCK_GRAB THEN DOCK_row_slot_edge_at% = s: EXIT FUNCTION
                    END IF
                NEXT o
            END IF
        END IF
    NEXT c
END FUNCTION


''
' Grabbing row slot s's right edge: every set width in its row becomes the
' width it shows. Set widths can add up to more than the row (saved in a wider
' window / at a smaller display scale: Rick's BOTTOM.1 editbar@868 |
' advbar@1837 in a ~1280 px row) - the row shrinks them all in proportion, so
' the first frame of the drag (the slot's set width = its shown one) threw the
' edge far left, and then it jumped right. Also: the row's free width and the
' slot right of s, which gives way as s grows (DOCK_handle_row_slot_resize%).
SUB DOCK_row_rz_grab (s AS INTEGER)
    DIM c AS INTEGER, o AS INTEGER, t AS INTEGER, used AS INTEGER, seen AS INTEGER
    c = DOCK_SLOT(s).col
    DOCK_RZ_N = 0: DOCK_RZ_NW0 = 0: DOCK_RZ_SPARE = 0
    IF c = 0 THEN EXIT SUB
    FOR o = 1 TO DOCK_MAX_SLOTS
        t = DOCK_slot_at%(c, o)
        IF t = 0 THEN EXIT FOR
        IF DOCK_SLOT(t).vis THEN
            IF DOCK_SLOT(t).share > 1 _ANDALSO DOCK_SLOT(t).collapsed = 0 THEN DOCK_SLOT(t).share = _MAX(2, DOCK_SLOT(t).w)
            used = used + DOCK_SLOT(t).w
            IF seen _ANDALSO DOCK_RZ_N = 0 THEN DOCK_RZ_N = t: DOCK_RZ_NW0 = DOCK_SLOT(t).w
            IF t = s THEN seen = TRUE
        END IF
    NEXT o
    IF DOCK_RZ_N THEN
        IF DOCK_SLOT(DOCK_RZ_N).collapsed THEN DOCK_RZ_N = 0
    END IF
    DOCK_RZ_SPARE = _MAX(0, DOCK_COL(c).w - used)
END SUB

''
' Drag a row slot's right edge: its width along the row (DOCK_SLOT.share = px,
' 1 = auto: its own width / a share of the room). Double-click: auto again
' (Rick 2026-11-16: "docked to top/bottom needs to be resizable horizontally").
FUNCTION DOCK_handle_row_slot_resize% (mx AS INTEGER, my AS INTEGER)
    DIM s AS INTEGER, w AS INTEGER, mn AS INTEGER, room AS INTEGER
    s = DOCK_RZ_SLOT
    IF s THEN
        IF DOCK_SLOT(s).used = 0 _ORELSE DOCK_is_row%(DOCK_SLOT(s).col) = 0 THEN DOCK_RZ_SLOT = 0: EXIT FUNCTION
        mn = DOCK_row_slot_min_w%(s)
        w = DOCK_RZ_SW0 + (mx - DOCK_RZ_SX0)
        IF w < mn THEN w = mn
        ' wider: first the row's free width, then what the slot to its right
        ' can give (a splitter between them - the edge stays under the pointer)
        room = DOCK_RZ_SPARE
        IF DOCK_RZ_N THEN room = room + _MAX(0, DOCK_RZ_NW0 - DOCK_row_slot_min_w%(DOCK_RZ_N))
        IF w > DOCK_RZ_SW0 + room THEN w = _MAX(mn, DOCK_RZ_SW0 + room)
        IF w > DOCK_COL(DOCK_SLOT(s).col).w THEN w = DOCK_COL(DOCK_SLOT(s).col).w
        IF w <> DOCK_SLOT(s).share _ANDALSO mx <> DOCK_RZ_SX0 THEN
            DOCK_SLOT(s).share = _MAX(2, w)
            IF DOCK_RZ_N THEN
                IF DOCK_SLOT(DOCK_RZ_N).share > 1 THEN DOCK_SLOT(DOCK_RZ_N).share = _MAX(2, DOCK_RZ_NW0 - _MAX(0, w - DOCK_RZ_SW0 - DOCK_RZ_SPARE))
            END IF
            DOCK_redraw
        END IF
        IF MOUSE.B1% = 0 THEN
            DOCK_RZ_SLOT = 0
            IF mx <> DOCK_RZ_SX0 THEN DOCK_change_commit "Dock panel width:" + STR$(DOCK_SLOT(s).share) + " px (double-click the edge: auto)"
        END IF
        MOUSE.UI_CHROME_CLICKED% = TRUE
        DOCK_handle_row_slot_resize% = TRUE
        EXIT FUNCTION
    END IF
    IF MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0 THEN
        s = DOCK_row_slot_edge_at%(mx, my)
        IF s THEN
            DOCK_change_begin
            IF s = DOCK_RZ_LASTS _ANDALSO ABS(TIMER - DOCK_RZ_LAST) < .4 THEN
                DOCK_SLOT(s).share = 1
                DOCK_RZ_LASTS = 0
                DOCK_change_commit "Dock panel width: auto"
            ELSE
                DOCK_RZ_SLOT = s: DOCK_RZ_SX0 = mx: DOCK_RZ_SW0 = DOCK_SLOT(s).w
                DOCK_row_rz_grab s
                DOCK_RZ_LAST = TIMER: DOCK_RZ_LASTS = s
            END IF
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_row_slot_resize% = TRUE
        END IF
    END IF
END FUNCTION


''
' Floating docked panels: their window (title bar + frame) kept inside the
' canvas work area, the panel's rect inside the frame.
SUB DOCK_place_floats (barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM id AS INTEGER, need AS INTEGER
    FOR id = 1 TO DP_COUNT
        IF DPANEL(id).fl _ANDALSO DPANEL(id).slot = 0 _ANDALSO DPANEL(id).floats = 0 THEN
            IF DOCK_panel_shown%(id) THEN
                DOCK_float_clamp id, barY1, dockY2
                DOCK_apply_rect id, DPANEL(id).fx + 1, DPANEL(id).fy + DOCK_float_title_h%(id), DPANEL(id).fw - 2, DPANEL(id).fh - DOCK_float_title_h%(id) - 1
                ' a narrower toolbox / organizer has more rows: grow the window
                ' to show them (the clamp keeps it on screen next layout)
                IF id = DP_TOOLBOX THEN
                    DOCK_float_fit_toolbox barY1, dockY2
                ELSEIF id = DP_DRAWER THEN
                    DOCK_float_fit_drawer barY1, dockY2
                ELSEIF DPANEL(id).hmode = DP_H_FIXED THEN
                    need = DOCK_fixed_h%(id, DPANEL(id).fw - 2) + DOCK_float_title_h%(id) + _IIF(id = DP_TEXTBAR _ORELSE id = DP_SELBAR, 1, 3) ' (the text / selection bar: its lines, no margin)
                    IF DPANEL(id).fh < need _ORELSE ((id = DP_TEXTBAR _ORELSE id = DP_SELBAR) _ANDALSO DPANEL(id).fh <> need) THEN DPANEL(id).fh = need: DOCK_redraw ' (the text / selection bar: exactly its lines)
                END IF
            END IF
        END IF
    NEXT id
END SUB


SUB DOCK_float_clamp (id AS INTEGER, barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM minW AS INTEGER, scl AS INTEGER
    ' as narrow as the panel can reflow to (not the column it came from)
    SELECT CASE id
        CASE DP_TOOLBOX: minW = PSURF_v%(id, TOOLBAR_cols_w%(1)) + 2 ' one button column
        CASE DP_ORGANIZER
            scl = ORGANIZER_scale%: IF scl < 1 THEN scl = 1
            minW = PSURF_v%(id, ORG_COL_W * scl + 2) + 2 ' one widget stack
        CASE DP_DRAWER: minW = PSURF_v%(id, DRAWER_min_w%) + 2
        CASE DP_WORKFLOW: minW = PSURF_v%(id, WF_min_w%) + 2 ' one button column
        CASE DP_TEXTBAR: minW = PSURF_v%(id, TEXT_BAR_MIN_W) + 2
        CASE DP_SELBAR: minW = PSURF_v%(id, SELBAR_MIN_W) + 2
        CASE DP_MYPAINT: minW = PSURF_v%(id, MYPP_MIN_W) + 2
        CASE DP_MYPSET: minW = PSURF_v%(id, MPS_MIN_W) + 2
        CASE DP_BRUSHES: minW = PSURF_v%(id, BSP_MIN_W) + 2
        CASE DP_LAYERS: minW = PSURF_v%(id, LAYERS_min_width%) + 2 ' not the width it had docked
        CASE ELSE: minW = DOCK_panel_w%(id) + 2
    END SELECT
    IF DPANEL(id).fw < minW THEN DPANEL(id).fw = minW
    IF DPANEL(id).fh < DOCK_float_title_h%(id) + 24 THEN DPANEL(id).fh = DOCK_float_title_h%(id) + 24
    IF DPANEL(id).fw > DOCK_RX - DOCK_LX + 1 THEN DPANEL(id).fw = DOCK_RX - DOCK_LX + 1
    IF DPANEL(id).fh > dockY2 - barY1 + 1 THEN DPANEL(id).fh = dockY2 - barY1 + 1
    IF DPANEL(id).fx < DOCK_LX THEN DPANEL(id).fx = DOCK_LX
    IF DPANEL(id).fx + DPANEL(id).fw - 1 > DOCK_RX THEN DPANEL(id).fx = DOCK_RX - DPANEL(id).fw + 1
    IF DPANEL(id).fy < barY1 THEN DPANEL(id).fy = barY1
    IF DPANEL(id).fy + DPANEL(id).fh - 1 > dockY2 THEN DPANEL(id).fy = dockY2 - DPANEL(id).fh + 1
END SUB


''
' A floating toolbox's window is exactly its buttons: the columns its width
' fits (TOOLBAR_fit_width, up to every button in one row), more if that many
' rows would not fit the height, then the window snapped to that grid - no
' empty area beside or under the buttons when the window is resized.
SUB DOCK_float_fit_toolbox (barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM c AS INTEGER, n AS INTEGER, maxH AS INTEGER, th AS INTEGER, w AS INTEGER, h AS INTEGER
    n = TB_LIVE_COUNT: IF n < 1 THEN n = 1
    th = DOCK_float_title_h%(DP_TOOLBOX)
    maxH = dockY2 - barY1 + 1
    c = TB_LIVE_COLS: IF c < 1 THEN c = 1
    ' (TOOLBAR_cols_w% is in its units: GUI/PANEL-SURFACE)
    DO WHILE c < n _ANDALSO DOCK_fixed_h%(DP_TOOLBOX, PSURF_v%(DP_TOOLBOX, TOOLBAR_cols_w%(c))) + th + 3 > maxH
        c = c + 1
    LOOP
    w = PSURF_v%(DP_TOOLBOX, TOOLBAR_cols_w%(c)) + 2
    h = DOCK_fixed_h%(DP_TOOLBOX, w - 2) + th + 3
    IF DPANEL(DP_TOOLBOX).fw = w _ANDALSO DPANEL(DP_TOOLBOX).fh = h THEN EXIT SUB
    DPANEL(DP_TOOLBOX).fw = w: DPANEL(DP_TOOLBOX).fh = h
    DOCK_float_clamp DP_TOOLBOX, barY1, dockY2
    DOCK_apply_rect DP_TOOLBOX, DPANEL(DP_TOOLBOX).fx + 1, DPANEL(DP_TOOLBOX).fy + th, DPANEL(DP_TOOLBOX).fw - 2, DPANEL(DP_TOOLBOX).fh - th - 1
    DOCK_redraw
END SUB


''
' A floating drawer goes no wider than its widest bin grid + palette rail
' (DRAWER_max_w%) and no taller than that content at its width
' (DRAWER_content_h%): never empty area beside or under the bins. Shorter is
' fine - the bins scroll. Rick, 2026-11-06: a wide floating drawer was mostly
' black.
SUB DOCK_float_fit_drawer (barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM th AS INTEGER, w AS INTEGER, h AS INTEGER
    th = DOCK_float_title_h%(DP_DRAWER)
    w = _MIN(DPANEL(DP_DRAWER).fw, PSURF_v%(DP_DRAWER, DRAWER_max_w%) + 2)
    h = _MIN(DPANEL(DP_DRAWER).fh, PSURF_v%(DP_DRAWER, DRAWER_content_h%(PSURF_u%(DP_DRAWER, w - 2))) + th + 1)
    IF DPANEL(DP_DRAWER).fw = w _ANDALSO DPANEL(DP_DRAWER).fh = h THEN EXIT SUB
    DPANEL(DP_DRAWER).fw = w: DPANEL(DP_DRAWER).fh = h
    DOCK_float_clamp DP_DRAWER, barY1, dockY2
    DOCK_apply_rect DP_DRAWER, DPANEL(DP_DRAWER).fx + 1, DPANEL(DP_DRAWER).fy + th, DPANEL(DP_DRAWER).fw - 2, DPANEL(DP_DRAWER).fh - th - 1
    DOCK_redraw
END SUB


''
' Render pass: paint the part of each column no panel covers as panel (and a
' drawer that has nothing to show), with the side bars' color and a border on
' the column's inner edge - never a black hole.
SUB DOCK_fill_columns ()
    DIM c AS INTEGER, so AS INTEGER, s AS INTEGER, lastY AS INTEGER, y2 AS INTEGER, id AS INTEGER
    DIM oldDest AS LONG
    oldDest& = _DEST
    _DEST SCRN.GUI&
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_is_row%(c) THEN
            IF DOCK_COL(c).vis THEN DOCK_fill_row c
        ELSEIF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis THEN
            lastY = DOCK_COL(c).y - 1
            y2 = DOCK_COL(c).y + DOCK_COL(c).h - 1
            FOR so = 1 TO DOCK_MAX_SLOTS
                s = DOCK_slot_at%(c, so)
                IF s = 0 THEN EXIT FOR
                IF DOCK_SLOT(s).vis THEN
                    id = DOCK_slot_panel%(s)
                    IF id = DP_DRAWER _ANDALSO DRAWER.mode% = DRAWER_MODE_NONE THEN
                        DOCK_fill_rect c, DOCK_SLOT(s).y, _MIN(DOCK_SLOT(s).y + DOCK_SLOT(s).h - 1, y2)
                    END IF
                    lastY = DOCK_SLOT(s).y + DOCK_SLOT(s).h - 1
                END IF
            NEXT so
            IF lastY < y2 THEN DOCK_fill_rect c, lastY + 1, y2
        END IF
    NEXT c
    _DEST oldDest&
END SUB


''
' Row c's uncovered parts (the toolbox family drew already - SCREEN_render): under
' a fixed-height panel or a collapsed slot's strip, an empty drawer, and the
' rest of the row past its last slot.
SUB DOCK_fill_row (c AS INTEGER)
    DIM so AS INTEGER, s AS INTEGER, id AS INTEGER, y1 AS INTEGER, y2 AS INTEGER, lastX AS INTEGER, th AS INTEGER
    y2 = DOCK_COL(c).y + DOCK_COL(c).h - 1
    lastX = DOCK_COL(c).x
    FOR so = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, so)
        IF s = 0 THEN EXIT FOR
        IF DOCK_SLOT(s).vis THEN
            id = DOCK_slot_panel%(s)
            th = 0: IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
            y1 = y2 + 1
            IF DOCK_SLOT(s).collapsed THEN
                y1 = DOCK_SLOT(s).y + th
            ELSEIF id = DP_DRAWER _ANDALSO DRAWER.mode% = DRAWER_MODE_NONE THEN
                y1 = DOCK_SLOT(s).y + th
            ELSEIF id _ANDALSO id < DP_PREVIEW _ANDALSO DPANEL(id).hmode = DP_H_FIXED THEN
                y1 = DOCK_SLOT(s).y + th + DOCK_fixed_h%(id, DOCK_SLOT(s).w)
            END IF
            IF y1 <= y2 THEN LINE (DOCK_SLOT(s).x, y1)-(DOCK_SLOT(s).x + DOCK_SLOT(s).w - 1, y2), THEME.DOCK_bg~&, BF
            lastX = DOCK_SLOT(s).x + DOCK_SLOT(s).w
        END IF
    NEXT so
    IF lastX < DOCK_COL(c).x + DOCK_COL(c).w THEN LINE (lastX, DOCK_COL(c).y)-(DOCK_COL(c).x + DOCK_COL(c).w - 1, y2), THEME.DOCK_bg~&, BF
END SUB


SUB DOCK_fill_rect (c AS INTEGER, y1 AS INTEGER, y2 AS INTEGER)
    DIM x1 AS INTEGER, x2 AS INTEGER
    IF y2 < y1 THEN EXIT SUB
    x1 = DOCK_COL(c).x
    x2 = x1 + DOCK_COL(c).w - 1
    LINE (x1, y1)-(x2, y2), THEME.DOCK_bg~&, BF ' (its border: DOCK_render_seams)
END SUB


' =============================================================================
' Seams: the one border line between a dock column and its neighbour
' =============================================================================
' Every visible column draws a 1px line on its INNER edge (toward the canvas),
' the whole column height: one line between the innermost column and the
' canvas, one between each column and the next one out, none at the window
' edge. The dock owns it - the panels draw no side borders of their own. They
' used to: the edit / advanced bars on both sides, the layers on their right,
' a column's empty part on its inner edge, the toolbox / organizer none, so a
' boundary had two lines beside some neighbours and none beside others.
' Rick, 2026-11-07: "make sure that all docks are consistent and have the
' correct borders between them and the canvas and them and other docks... in
' any configuration". Test: dock-seams-* (dk_seams, also in every dk_check).

''
' Column c's seam x (its inner edge pixel); FALSE when it shows nothing.
FUNCTION DOCK_seam_x% (c AS INTEGER, x AS INTEGER)
    IF c < 1 _ORELSE c > DOCK_MAX_COLS THEN EXIT FUNCTION
    IF DOCK_COL(c).used = 0 _ORELSE DOCK_COL(c).vis = 0 _ORELSE DOCK_COL(c).autoh THEN EXIT FUNCTION
    IF DOCK_COL(c).w <= 0 _ORELSE DOCK_COL(c).h <= 0 THEN EXIT FUNCTION
    IF DOCK_is_row%(c) THEN EXIT FUNCTION ' (a row's seam is a row: DOCK_row_seam_y%)
    IF DOCK_COL(c).side = DOCK_RIGHT THEN x = DOCK_COL(c).x ELSE x = DOCK_COL(c).x + DOCK_COL(c).w - 1
    DOCK_seam_x% = TRUE
END FUNCTION


''
' Row c's seam y (its inner edge pixel row); FALSE when it shows nothing.
FUNCTION DOCK_row_seam_y% (c AS INTEGER, y AS INTEGER)
    IF DOCK_is_row%(c) = 0 THEN EXIT FUNCTION
    IF DOCK_COL(c).vis = 0 _ORELSE DOCK_COL(c).w <= 0 _ORELSE DOCK_COL(c).h <= 0 THEN EXIT FUNCTION
    IF DOCK_COL(c).side = DOCK_BOTTOM THEN y = DOCK_COL(c).y ELSE y = DOCK_COL(c).y + DOCK_COL(c).h - 1
    DOCK_row_seam_y% = TRUE
END FUNCTION


FUNCTION DOCK_seam_color~& (c AS INTEGER)
    IF DOCK_COL(c).side = DOCK_TOP _ORELSE DOCK_COL(c).side = DOCK_BOTTOM THEN DOCK_seam_color~& = THEME.DOCK_seam~&: EXIT FUNCTION ' (as the Browser's band had)
    IF DOCK_COL(c).side = DOCK_RIGHT THEN DOCK_seam_color~& = THEME.DOCK_seam_right~& ELSE DOCK_seam_color~& = THEME.DOCK_seam~&
END FUNCTION


''
' Render pass (SCRN.GUI&, after the docked panels, before the floating ones).
SUB DOCK_render_seams ()
    DIM c AS INTEGER, x AS INTEGER, oldDest AS LONG
    oldDest& = _DEST
    _DEST SCRN.GUI&
    DIM y AS INTEGER, so AS INTEGER, s AS INTEGER, lastS AS INTEGER
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_seam_x%(c, x) THEN LINE (x, DOCK_COL(c).y)-(x, DOCK_COL(c).y + DOCK_COL(c).h - 1), DOCK_seam_color~&(c)
        IF DOCK_row_seam_y%(c, y) THEN
            ' a row: one line on its canvas side, and one between side-by-side panels
            LINE (DOCK_COL(c).x, y)-(DOCK_COL(c).x + DOCK_COL(c).w - 1, y), DOCK_seam_color~&(c)
            lastS = 0
            FOR so = 1 TO DOCK_MAX_SLOTS
                s = DOCK_slot_at%(c, so)
                IF s = 0 THEN EXIT FOR
                IF DOCK_SLOT(s).vis THEN
                    IF lastS THEN LINE (DOCK_SLOT(s).x - 1, DOCK_COL(c).y)-(DOCK_SLOT(s).x - 1, DOCK_COL(c).y + DOCK_COL(c).h - 1), THEME.DOCK_seam~&
                    lastS = s
                END IF
            NEXT so
            ' after the last one: where the empty rest of the row starts
            IF lastS _ANDALSO DOCK_SLOT(lastS).x + DOCK_SLOT(lastS).w < DOCK_COL(c).x + DOCK_COL(c).w THEN
                x = DOCK_SLOT(lastS).x + DOCK_SLOT(lastS).w
                LINE (x, DOCK_COL(c).y)-(x, DOCK_COL(c).y + DOCK_COL(c).h - 1), THEME.DOCK_seam~&
            END IF
        END IF
    NEXT c
    _DEST oldDest&
END SUB


''
' On the window (screen 0), right after the docked native windows drew over
' the presented canvas: their columns' seams again on top of them, and their
' own side frame where it lies on a column edge (within 2px) painted over in
' the column colour - it would stand beside the seam as a second line. A
' window narrower than its column, centred away from the edges, keeps its
' frame. SCREEN_render_windows.
SUB DOCK_render_native_seams ()
    DIM id AS INTEGER, c AS INTEGER, sx AS INTEGER, ds AS INTEGER, oldDest AS LONG, oldSrc AS LONG
    DIM x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, cx1 AS INTEGER, cx2 AS INTEGER
    DIM inL AS INTEGER, inR AS INTEGER, outL AS INTEGER, outR AS INTEGER, k AS INTEGER
    ds = SCRN.displayScale%: IF ds < 1 THEN ds = 1
    oldDest& = _DEST: oldSrc& = _SOURCE
    _DEST 0: _SOURCE 0
    FOR id = DP_PREVIEW TO DP_COUNT
        IF DPANEL(id).slot = 0 THEN _CONTINUE
        IF DOCK_native_rect%(id, x, y, w, h) = 0 THEN _CONTINUE
        IF w < 3 _ORELSE h < 1 THEN _CONTINUE
        c = DOCK_SLOT(DPANEL(id).slot).col
        IF DOCK_seam_x%(c, sx) = 0 THEN _CONTINUE
        cx1 = DOCK_COL(c).x: cx2 = cx1 + DOCK_COL(c).w - 1
        ' which of the window's side frames lie on a seam: the inner edge,
        ' or the outer edge when a column lies beyond it (not the window edge)
        IF DOCK_COL(c).side = DOCK_RIGHT THEN
            inL = (ABS(x - cx1) <= 2)
            outR = (ABS(x + w - 1 - cx2) <= 2 _ANDALSO cx2 < DOCK_WX2)
            inR = FALSE: outL = FALSE
        ELSE
            inR = (ABS(x + w - 1 - cx2) <= 2)
            outL = (ABS(x - cx1) <= 2 _ANDALSO cx1 > 0)
            inL = FALSE: outR = FALSE
        END IF
        IF inL _ORELSE outL THEN
            k = DOCK_frame_px%(x * ds, (y + h \ 2) * ds, 1, ds)
            LINE (x * ds, y * ds)-(x * ds + k - 1, (y + h) * ds - 1), THEME.DOCK_bg~&, BF
        END IF
        IF inR _ORELSE outR THEN
            k = DOCK_frame_px%((x + w) * ds - 1, (y + h \ 2) * ds, -1, ds)
            LINE ((x + w) * ds - k, y * ds)-((x + w) * ds - 1, (y + h) * ds - 1), THEME.DOCK_bg~&, BF
        END IF
        ' the seam over the window's rows
        IF sx >= x - 2 _ANDALSO sx <= x + w + 1 THEN
            LINE (sx * ds, y * ds)-(sx * ds + ds - 1, (y + h) * ds - 1), DOCK_seam_color~&(c), BF
        END IF
    NEXT id

    ' the native windows in a top / bottom row: their ends sit on the side
    ' docks' seams (their side frame is painted out there), and the row's
    ' canvas side is a boundary of its own - one seam row on the row's edge,
    ' their frame and any gap up to it painted out (drawn within the slot, up
    ' to a pixel short at a fractional scale)
    DIM bx1 AS INTEGER, bx2 AS INTEGER, by1 AS INTEGER, by2 AS INTEGER, rs AS INTEGER
    FOR id = DP_PREVIEW TO DP_COUNT
        IF DPANEL(id).slot <= 0 THEN _CONTINUE
        c = DOCK_SLOT(DPANEL(id).slot).col
        IF DOCK_is_row%(c) = 0 _ORELSE DOCK_SLOT(DPANEL(id).slot).vis = 0 THEN _CONTINUE
        IF DOCK_native_rect%(id, x, y, w, h) = 0 THEN _CONTINUE
        IF w <= 2 _ORELSE h <= 2 THEN _CONTINUE
        rs = DPANEL(id).slot
        bx1 = DOCK_SLOT(rs).x: bx2 = DOCK_SLOT(rs).x + DOCK_SLOT(rs).w - 1
        by1 = DOCK_COL(c).y: by2 = DOCK_COL(c).y + DOCK_COL(c).h - 1
        IF bx1 > DOCK_WX1 THEN
            k = DOCK_frame_px%(x * ds, (y + h \ 2) * ds, 1, ds)
            LINE (bx1 * ds, y * ds)-(x * ds + k - 1, (y + h) * ds - 1), THEME.DOCK_bg~&, BF
        END IF
        IF bx2 < DOCK_WX2 THEN
            k = DOCK_frame_px%((x + w) * ds - 1, (y + h \ 2) * ds, -1, ds)
            LINE ((x + w) * ds - k, y * ds)-((bx2 + 1) * ds - 1, (y + h) * ds - 1), THEME.DOCK_bg~&, BF
        END IF
        IF DOCK_COL(c).side = DOCK_TOP THEN
            k = DOCK_frame_py%((x + w \ 2) * ds, (y + h) * ds - 1, -1, ds)
            LINE (bx1 * ds, (y + h) * ds - k)-((bx2 + 1) * ds - 1, (by2 + 1) * ds - 1), THEME.DOCK_bg~&, BF
            LINE (bx1 * ds, by2 * ds)-((bx2 + 1) * ds - 1, (by2 + 1) * ds - 1), DOCK_seam_color~&(c), BF
        ELSE
            k = DOCK_frame_py%((x + w \ 2) * ds, y * ds, 1, ds)
            LINE (bx1 * ds, by1 * ds)-((bx2 + 1) * ds - 1, y * ds + k - 1), THEME.DOCK_bg~&, BF
            LINE (bx1 * ds, by1 * ds)-((bx2 + 1) * ds - 1, (by1 + 1) * ds - 1), DOCK_seam_color~&(c), BF
        END IF
    NEXT id
    _DEST oldDest&: _SOURCE oldSrc&
END SUB


''
' How many window pixels wide a native window's side frame is, from screen-0
' pixel (px, py) going inward (dir 1 = right): the run of its edge colour, at
' most two display pixels (a frame is one window pixel; scales differ).
FUNCTION DOCK_frame_px% (px AS INTEGER, py AS INTEGER, dir AS INTEGER, ds AS INTEGER)
    DIM e AS _UNSIGNED LONG, k AS INTEGER
    e = POINT(px, py)
    k = 1
    DO WHILE k < ds * 2
        IF POINT(px + k * dir, py) <> e THEN EXIT DO
        k = k + 1
    LOOP
    DOCK_frame_px% = k
END FUNCTION


''
' DOCK_frame_px% upright: a frame row's height from (px, py), dir 1 = down.
FUNCTION DOCK_frame_py% (px AS INTEGER, py AS INTEGER, dir AS INTEGER, ds AS INTEGER)
    DIM e AS _UNSIGNED LONG, k AS INTEGER
    e = POINT(px, py)
    k = 1
    DO WHILE k < ds * 2
        IF POINT(px, py + k * dir) <> e THEN EXIT DO
        k = k + 1
    LOOP
    DOCK_frame_py% = k
END FUNCTION



' =============================================================================
' Slot chrome: handles, title strips, the handle menu (P3)
' =============================================================================

''
' The handle of slot s: its title strip, the layers' own header, or the thin
' hover grip at the top of a chromeless panel. Returns FALSE when none.
FUNCTION DOCK_handle_rect% (s AS INTEGER, hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER)
    DIM id AS INTEGER
    IF DOCK_SLOT(s).used = 0 _ORELSE DOCK_SLOT(s).vis = 0 THEN EXIT FUNCTION
    id = DOCK_slot_panel%(s)
    IF id = DP_NONE THEN EXIT FUNCTION
    hx = DOCK_SLOT(s).x: hy = DOCK_SLOT(s).y: hw = DOCK_SLOT(s).w
    IF DOCK_slot_titled%(s) = 0 _ANDALSO DPANEL(id).floats THEN
        DOCK_handle_rect% = DOCK_native_grab%(id, hx, hy, hw, hh)
        EXIT FUNCTION
    END IF
    IF DOCK_slot_titled%(s) THEN
        hh = DOCK_TITLE_H
    ELSEIF id = DP_LAYERS THEN
        hh = PSURF_v%(id, THEME.LAYER_PANEL_header_height%) ' (its header, viewport px)
    ELSE
        hh = DOCK_GRIP_H
    END IF
    DOCK_handle_rect% = TRUE
END FUNCTION


''
' Slot whose handle is under (mx, my), 0 = none. Same guards as the edges:
' nothing floating over it, no menu or popup open.
FUNCTION DOCK_handle_at% (mx AS INTEGER, my AS INTEGER)
    DIM s AS INTEGER, hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER, rg AS INTEGER, only AS INTEGER
    IF DOCK_ui_busy% THEN EXIT FUNCTION
    rg = REGION_hit_test%(mx, my)
    SELECT CASE rg
        CASE REGION_GLOBAL, REGION_CANVAS, REGION_TOOLBAR, REGION_ORGANIZER, REGION_DRAWER, _
             REGION_EDIT_BAR, REGION_ADV_BAR, REGION_LAYER_PANEL, REGION_CHARMAP, REGION_WORKFLOW, REGION_TEXT_BAR, REGION_SEL_BAR, REGION_MYPAINT, REGION_MYPSET, REGION_BRUSHES
        CASE ELSE
            ' over a native window: only its own handle (when it is docked)
            only = DOCK_native_for_region%(rg)
            IF only = 0 THEN EXIT FUNCTION
    END SELECT
    FOR s = 1 TO DOCK_MAX_SLOTS
        IF only _ANDALSO DOCK_slot_panel%(s) <> only THEN _CONTINUE
        IF DOCK_handle_rect%(s, hx, hy, hw, hh) THEN
            IF mx >= hx _ANDALSO mx < hx + hw _ANDALSO my >= hy _ANDALSO my < hy + hh THEN DOCK_handle_at% = s: EXIT FUNCTION
            IF DOCK_native_grab_more%(s, mx, my) THEN DOCK_handle_at% = s: EXIT FUNCTION
        END IF
    NEXT s
END FUNCTION


''
' A docked window's title bar past its handle rect that is handle too: the
' Preview's empty stretch between its FP checkbox and its minimize button
' (the handle rect stops at the checkbox). Rick, 2026-11-06: the docked
' preview could not be dragged out or right-clicked there.
FUNCTION DOCK_native_grab_more% (s AS INTEGER, mx AS INTEGER, my AS INTEGER)
    IF DOCK_slot_titled%(s) THEN EXIT FUNCTION
    IF DOCK_slot_panel%(s) <> DP_PREVIEW THEN EXIT FUNCTION
    DOCK_native_grab_more% = DOCK_preview_title_more%(mx, my)
END FUNCTION


''
' The Preview's empty title stretch (past its FP checkbox, up to the minimize
' box) under (mx, my) - docked or floating (Rick, 2026-11-14: the floating
' Preview's menu opened only on its PREVIEW label, not the empty title bar).
FUNCTION DOCK_preview_title_more% (mx AS INTEGER, my AS INTEGER)
    DIM rs AS SINGLE, x1 AS INTEGER, x2 AS INTEGER, th AS INTEGER
    IF PREVIEW.visible% = 0 _ORELSE PREVIEW.autoHidden% THEN EXIT FUNCTION
    rs = PREVIEW.renderScale!: IF rs <= 0 THEN rs = 1
    th = PREVIEW_title_h%
    x1 = PREVIEW.x% + INT((PREVIEW_cb_x% + PREVIEW_cb_w%) * rs + 0.999) ' past the checkbox
    IF PREVIEW.minimized% THEN x1 = PREVIEW.x% + INT(PREVIEW_cb_x% * rs) ' (no checkbox drawn)
    x2 = PREVIEW.x% + INT((PREVIEW.w% - th * 2) * rs) ' the minimize box
    IF mx < x1 _ORELSE mx >= x2 THEN EXIT FUNCTION
    IF my < PREVIEW.y% _ORELSE my >= PREVIEW.y% + INT(th * rs + 0.5) THEN EXIT FUNCTION
    DOCK_preview_title_more% = TRUE
END FUNCTION


''
' Render pass (with the panels): title strips of titled slots.
SUB DOCK_render_titles ()
    DIM s AS INTEGER, id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, t AS INTEGER, tx AS INTEGER, tw AS INTEGER, lbl AS STRING
    DIM bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER
    DIM oldDest AS LONG, oldFont AS LONG
    oldDest& = _DEST
    oldFont& = _FONT
    _DEST SCRN.GUI&
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle& ELSE IF MENU_BAR.fontHandle& > 0 THEN _FONT MENU_BAR.fontHandle&
    FOR s = 1 TO DOCK_MAX_SLOTS
        IF DOCK_SLOT(s).used _ANDALSO DOCK_SLOT(s).vis THEN
            IF DOCK_slot_titled%(s) THEN
                x = DOCK_SLOT(s).x: y = DOCK_SLOT(s).y: w = DOCK_SLOT(s).w
                LINE (x, y)-(x + w - 1, y + DOCK_TITLE_H - 1), THEME.PANEL_title_bg~&, BF
                LINE (x, y + DOCK_TITLE_H - 1)-(x + w - 1, y + DOCK_TITLE_H - 1), THEME.PANEL_title_border~&
                IF THEMEED.started THEN THEMEED_seen _DEST, "", "DOCKT:" + _TRIM$(STR$(s)), "DOCK TITLE", x, y, w, DOCK_TITLE_H, "@DOCK_render_titles"
                ' twirl: a drawn arrow (right = collapsed, down = open), like
                ' FPANEL_disclosure - not a "v" / ">" glyph (Rick 2026-11-17)
                DOCK_twirl x + 2, y + (DOCK_TITLE_H - 1) \ 2, DOCK_SLOT(s).collapsed, THEME.PANEL_title_fg~&
                _PRINTMODE _KEEPBACKGROUND
                FOR t = 1 TO DOCK_SLOT(s).ntabs
                    id = DOCK_TAB(s, t)
                    IF DOCK_tab_rect%(s, t, tx, tw) THEN
                        ' (a narrow column: the label is cut to its share of the strip)
                        lbl = DOCK_fit_text$(UCASE$(DPANEL(id).title), tw) ' (titles: UPPERCASE - Rick 2026-11-17)
                        IF DOCK_SLOT(s).ntabs > 1 _ANDALSO t = DOCK_SLOT(s).act THEN
                            LINE (tx - 1, y)-(_MIN(tx + tw, x + w - 1), y + DOCK_TITLE_H - 2), THEME.PANEL_tab_sel_bg~&, BF
                        END IF
                        IF DOCK_SLOT(s).ntabs < 2 THEN
                            COLOR THEME.PANEL_title_fg~&, _RGBA32(0, 0, 0, 0) ' (one panel: its title)
                        ELSEIF t = DOCK_SLOT(s).act THEN
                            COLOR THEME.PANEL_tab_sel_fg~&, _RGBA32(0, 0, 0, 0)
                        ELSE
                            COLOR THEME.PANEL_tab_fg~&, _RGBA32(0, 0, 0, 0)
                        END IF
                        IF LEN(lbl) THEN _UPRINTSTRING (tx, y + 1), lbl
                    END IF
                NEXT t
                ' the [x] close box at the right end: closes the showing tab's panel
                IF DOCK_slot_close_rect%(s, bx, by, bw, bh) THEN
                    LINE (bx, by)-(bx + bw - 1, by + bh - 1), THEME.PANEL_title_bg~&, BF
                    DOCK_close_cross bx, by, bw, bh, THEME.PANEL_close_fg~& ' (a small red x)
                END IF
            END IF
        END IF
    NEXT s
    _FONT oldFont&
    _DEST oldDest&
END SUB


''
' Overlay pass (after SkipToPointer): the hover grip and the handle menu.
SUB DOCK_overlay_render ()
    DIM s AS INTEGER, hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER, i AS INTEGER, font AS LONG
    DIM oldDest AS LONG
    oldDest& = _DEST
    _DEST SCRN.CANVAS&
    s = DOCK_UI.hoverSlot
    ' (Lock Layout: no handle highlight - nothing can be dragged)
    IF s _ANDALSO DOCK_UI.menuOpen = 0 _ANDALSO DOCK_DRAG.which = 0 _ANDALSO DOCK_UI.mvActive = 0 _ANDALSO CFG.LAYOUT_LOCKED% = 0 THEN
        IF DOCK_handle_rect%(s, hx, hy, hw, hh) THEN
            IF hh = DOCK_GRIP_H THEN
                LINE (hx, hy)-(hx + hw - 1, hy + hh - 1), THEME.DOCK_handle_hover_bg~&, BF
                FOR i = hx + hw \ 2 - 6 TO hx + hw \ 2 + 6 STEP 3
                    PSET (i, hy + 1), THEME.DOCK_handle_hover_fg~&
                NEXT i
            ELSE
                LINE (hx, hy)-(hx + hw - 1, hy + hh - 1), THEME.DOCK_handle_hover_bg~&, B
            END IF
        END IF
    END IF
    ' the [x] under the pointer: red, like the Color Mixer's / Browser's
    IF DOCK_UI.closeHover _ANDALSO DOCK_UI.menuOpen = 0 _ANDALSO DOCK_UI.mvActive = 0 THEN
        IF DOCK_close_rect_of%(DOCK_UI.closeHover, hx, hy, hw, hh) THEN
            IF hh <= DOCK_FLOAT_GRIP_H THEN ' (a grip strip: inside its frame lines)
                LINE (hx, hy + 1)-(hx + hw - 2, hy + hh - 1), THEME.PANEL_close_hover_bg~&, BF
            ELSE
                LINE (hx, hy)-(hx + hw - 1, hy + hh - 1), THEME.PANEL_close_hover_bg~&, BF
            END IF
            DOCK_close_cross hx, hy, hw, hh, THEME.PANEL_close_hover_fg~&
        END IF
    END IF
    DOCK_move_render
    IF DOCK_UI.menuOpen THEN
        DOCK_menu_build DOCK_UI.menuPanel
        IF MENU_BAR.fontHandle& > 0 THEN font = MENU_BAR.fontHandle&
        POPUP_MENU_render SCRN.CANVAS&, DOCK_UI.menuX, DOCK_UI.menuY, DOCK_UI.menuW, DOCK_UI.menuN, DOCK_MENU_ITEM_H, DOCK_UI.menuHover, font
    END IF
    _DEST oldDest&
END SUB


''
' The handle menu's rows for panel id (POPUP_MENU_* arrays).
SUB DOCK_menu_build (id AS INTEGER)
    DIM n AS INTEGER, side AS INTEGER, s AS INTEGER
    IF DOCK_UI.menuWf THEN WF_menu_build DOCK_UI.menuWf: EXIT SUB ' a workflow button's menu
    IF DOCK_UI.menuPen THEN PENPR_menu_build: EXIT SUB ' the Pen Control presets menu
    IF DOCK_UI.menuMyp THEN MYPP_menu_build: EXIT SUB ' the MyPaint group dropdown
    POPUP_MENU_clear_items
    s = DPANEL(id).slot
    IF s > 0 THEN side = DOCK_COL(DOCK_SLOT(s).col).side
    POPUP_MENU_set_item n, DPANEL(id).title, "", -1, POPUP_MENU_FLAG_DISABLED: n = n + 1
    POPUP_MENU_set_item n, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: n = n + 1
    IF DPANEL(id).floats _ANDALSO s = 0 THEN
        POPUP_MENU_set_item n, "Dock Left", "", DOCK_ACT_LEFT, 0: n = n + 1
        POPUP_MENU_set_item n, "Dock Right", "", DOCK_ACT_RIGHT, 0: n = n + 1
        POPUP_MENU_set_item n, "Dock Along the Top", "", DOCK_ACT_BAND_TOP, 0: n = n + 1
        POPUP_MENU_set_item n, "Dock Along the Bottom", "", DOCK_ACT_BAND_BOTTOM, 0: n = n + 1
        DOCK_menu_add_scale id, n
        DOCK_menu_add_close id, n
        DOCK_UI.menuN = n
        EXIT SUB
    END IF
    POPUP_MENU_set_item n, "Move to Left Edge", "", DOCK_ACT_LEFT, 0: n = n + 1
    POPUP_MENU_set_item n, "Move to Right Edge", "", DOCK_ACT_RIGHT, 0: n = n + 1
    ' (Rick 2026-11-16: any panel can sit in a row along the top / bottom)
    IF side <> DOCK_TOP THEN POPUP_MENU_set_item n, "Dock Along the Top", "", DOCK_ACT_BAND_TOP, 0: n = n + 1
    IF side <> DOCK_BOTTOM THEN POPUP_MENU_set_item n, "Dock Along the Bottom", "", DOCK_ACT_BAND_BOTTOM, 0: n = n + 1
    IF s > 0 THEN
        IF DOCK_SLOT(s).collapsed THEN POPUP_MENU_set_item n, "Expand", "", DOCK_ACT_COLLAPSE, 0 ELSE POPUP_MENU_set_item n, "Collapse to Title", "", DOCK_ACT_COLLAPSE, 0
        n = n + 1
    END IF
    IF DOCK_floating%(id) THEN
        POPUP_MENU_set_item n, "Dock Back", "", DOCK_ACT_DOCKBACK, 0: n = n + 1
    ELSE
        POPUP_MENU_set_item n, "Float", "", DOCK_ACT_FLOAT, 0: n = n + 1
    END IF
    IF id = DP_TOOLBOX _ORELSE id = DP_EDITBAR _ORELSE id = DP_ADVBAR THEN
        POPUP_MENU_set_item n, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: n = n + 1
        POPUP_MENU_set_item n, "Customize Buttons...", "", DOCK_ACT_CUSTOMIZE, 0: n = n + 1
    END IF
    DOCK_menu_add_scale id, n
    POPUP_MENU_set_item n, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: n = n + 1
    POPUP_MENU_set_item n, "Reset Arrangement", "", DOCK_ACT_RESET, 0: n = n + 1
    DOCK_menu_add_close id, n
    DOCK_UI.menuN = n
END SUB


''
' The handle menu's last row: Close (hides the panel, as its [x] does).
SUB DOCK_menu_add_close (id AS INTEGER, n AS INTEGER)
    IF DOCK_panel_closable%(id) = 0 THEN EXIT SUB
    POPUP_MENU_set_item n, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: n = n + 1
    POPUP_MENU_set_item n, "Close", "", DOCK_ACT_CLOSE, 0: n = n + 1
END SUB


''
' The floating-panel family (Animation, Color Mixer, Pen, Advanced Color Picker,
' 3D Color Space): a Scale group - Auto follows the UI Scale, 1x-6x (more when
' the UI Scale or the setting is above 6, to 8) fix it. The one in use is checked.
' Every panel offers the same list: it used to stop at 4x unless the panel was
' already above it, so a Drawer at 1x could not reach the Toolbox's 6x (Rick
' 2026-11-16: "a mismatch in scale options").
SUB DOCK_menu_add_scale (id AS INTEGER, n AS INTEGER)
    DIM cur AS SINGLE, autoS AS INTEGER, topS AS INTEGER, k AS INTEGER
    IF FPANEL_has_scale%(id) = 0 THEN EXIT SUB
    cur = FPANEL_scale_set!(id)
    autoS = FPANEL_auto_scale%(id)
    topS = 6: IF autoS > topS THEN topS = autoS
    IF cur > topS THEN topS = cur
    IF topS > 8 THEN topS = 8
    POPUP_MENU_set_item n, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: n = n + 1
    POPUP_MENU_set_item n, "Scale: Auto (" + _TRIM$(STR$(autoS)) + "x" + _IIF(id = DP_PREVIEW _ORELSE id = DP_BROWSER _ORELSE id < DP_PREVIEW, ")", ", the UI Scale)"), "", DOCK_ACT_SCALE, _IIF(cur = 0, POPUP_MENU_FLAG_CHECKED, 0): n = n + 1
    FOR k = 1 TO topS
        POPUP_MENU_set_item n, "Scale: " + _TRIM$(STR$(k)) + "x", "", DOCK_ACT_SCALE + k, _IIF(cur = k, POPUP_MENU_FLAG_CHECKED, 0): n = n + 1
        ' the half step after it (Rick 2026-11-18: "1.5x 2.5x 3.5x ...")
        IF FPANEL_half_ok%(id) _ANDALSO k < topS THEN
            POPUP_MENU_set_item n, "Scale: " + _TRIM$(STR$(k)) + ".5x", "", DOCK_ACT_SCALE_HALF + k, _IIF(cur = k + .5!, POPUP_MENU_FLAG_CHECKED, 0): n = n + 1
        END IF
    NEXT k
END SUB


SUB DOCK_menu_open (id AS INTEGER, mx AS INTEGER, my AS INTEGER)
    DIM font AS LONG, ph AS INTEGER, px AS INTEGER, py AS INTEGER
    DOCK_UI.menuWf = WF_MENU_NEXT: WF_MENU_NEXT = 0 ' (GUI/WORKFLOW sets it for a button's menu)
    DOCK_UI.menuPen = PENPR_MENU_NEXT: PENPR_MENU_NEXT = 0 ' (GUI/PEN-PRESETS sets it)
    DOCK_UI.menuMyp = MYPP_MENU_NEXT: MYPP_MENU_NEXT = 0 ' (GUI/MYPAINT-PANEL sets it; its click comes after DOCK_handle_chrome: no menuJust)
    DOCK_menu_build id
    IF MENU_BAR.fontHandle& > 0 THEN font = MENU_BAR.fontHandle&
    DOCK_UI.menuW = POPUP_MENU_measure_width%(DOCK_UI.menuN, font)
    POPUP_MENU_place mx, my, DOCK_UI.menuW, DOCK_UI.menuN, DOCK_MENU_ITEM_H, px, py, ph
    DOCK_UI.menuX = px: DOCK_UI.menuY = py
    DOCK_UI.menuPanel = id
    DOCK_UI.menuHover = -1
    DOCK_UI.menuOpen = TRUE
    DOCK_UI.menuJust = (DOCK_UI.menuPen <> 0) ' (opened from a panel's own input, before DOCK_handle_chrome)
    DOCK_redraw
END SUB


SUB DOCK_redraw ()
    GUI_NEEDS_REDRAW% = TRUE
    FRAME_IDLE% = FALSE
    INVALIDATE_scene
END SUB


''
' Before changing the arrangement: inside a workspace that has not replaced it
' yet, remember the user's own so leaving the workspace puts it back.
SUB DOCK_change_begin ()
    IF DOCK_READY = 0 THEN DOCK_build_default
    IF WS_ACTIVE _ANDALSO WS_DOCK_TOUCHED = 0 THEN
        WS_DOCK_USER_SNAP = DOCK_snapshot$
        WS_DOCK_TOUCHED = TRUE
    END IF
    ' from here the tree is custom: DOCK_layout must stop rebuilding the
    ' default one from the dock keys (a live drag would be undone every frame)
    DOCK_CUSTOM = TRUE
    DOCK_BARS_FIRST = FALSE ' (you moved something: the bar you moved leads, not the Text Bar's old place)
    DOCK_READY = TRUE
END SUB


''
' After changing it: it is custom now (not rebuilt from the dock keys) and is
' saved - into the active workspace, else DRAW.cfg.
SUB DOCK_change_commit (msg AS STRING)
    DOCK_CUSTOM = TRUE
    DOCK_READY = TRUE
    IF WS_stock_default% THEN WS_layout_change_in_default msg: EXIT SUB ' Default stays stock: a workspace gets it
    IF WS_ACTIVE THEN WSC_save_dock WS_ACTIVE_ID ELSE CONFIG_save
    IF LEN(msg) THEN STATUS_flash msg
    DOCK_redraw
END SUB


''
' A tab switch / collapse: saved like any change in a workspace (or DRAW.cfg
' when Default is not kept stock), but in stock Default it only lasts this
' session - no workspace name is asked for a click like that.
SUB DOCK_change_commit_soft (msg AS STRING)
    IF WS_stock_default% = 0 THEN DOCK_change_commit msg: EXIT SUB
    DOCK_CUSTOM = TRUE
    DOCK_READY = TRUE
    IF LEN(msg) THEN STATUS_flash msg
    DOCK_redraw
END SUB


SUB DOCK_menu_do (act AS INTEGER)
    DIM id AS INTEGER, c AS INTEGER
    IF DOCK_UI.menuPen THEN DOCK_UI.menuPen = FALSE: PENPR_menu_do act: EXIT SUB ' the Pen Control presets menu
    IF DOCK_UI.menuMyp THEN DOCK_UI.menuMyp = FALSE: MYPP_menu_do act: EXIT SUB ' the MyPaint group dropdown
    IF DOCK_UI.menuWf _ANDALSO act >= WF_MV_ADD THEN WF_menu_do DOCK_UI.menuWf, act: EXIT SUB ' (its Float / Scale rows: the panel's, below)
    id = DOCK_UI.menuPanel
    SELECT CASE act
        CASE DOCK_ACT_LEFT, DOCK_ACT_RIGHT
            DOCK_change_begin
            IF act = DOCK_ACT_LEFT THEN
                c = DOCK_move_to_new_col%(id, DOCK_LEFT, DOCK_MAX_COLS + 1)
            ELSE
                c = DOCK_move_to_new_col%(id, DOCK_RIGHT, DOCK_MAX_COLS + 1)
            END IF
            DOCK_change_commit DPANEL(id).title + " moved"
        CASE DOCK_ACT_BAND_TOP, DOCK_ACT_BAND_BOTTOM
            DOCK_change_begin
            IF act = DOCK_ACT_BAND_TOP THEN DOCK_dock_along id, DOCK_TOP ELSE DOCK_dock_along id, DOCK_BOTTOM
            DOCK_change_commit DPANEL(id).title + " docked along the " + _IIF(act = DOCK_ACT_BAND_TOP, "top", "bottom")
        CASE DOCK_ACT_COLLAPSE
            DOCK_toggle_collapse DPANEL(id).slot
        CASE DOCK_ACT_FLOAT
            IF DPANEL(id).floats THEN DOCK_native_undock id, DOCK_LX + 40, 60 ELSE DOCK_float_panel id, DOCK_LX + 40, 60
        CASE DOCK_ACT_DOCKBACK
            DOCK_dock_back id
        CASE DOCK_ACT_CLOSE
            DOCK_panel_close id
        CASE DOCK_ACT_SCALE TO DOCK_ACT_SCALE + 8
            FPANEL_set_scale id, act - DOCK_ACT_SCALE
        CASE DOCK_ACT_SCALE_HALF + 1 TO DOCK_ACT_SCALE_HALF + 7
            FPANEL_set_scale id, act - DOCK_ACT_SCALE_HALF + .5!
        CASE DOCK_ACT_CUSTOMIZE
            SELECT CASE id
                CASE DP_EDITBAR: TBED_open BL_EDITBAR
                CASE DP_ADVBAR: TBED_open BL_ADVBAR
                CASE ELSE: TBED_open BL_TOOLBOX
            END SELECT
        CASE DOCK_ACT_RESET
            DOCK_change_begin
            DOCK_CUSTOM = FALSE
            DOCK_READY = FALSE
            DOCK_build_default
            IF WS_ACTIVE THEN
                WSC_save_dock WS_ACTIVE_ID
            ELSEIF WS_stock_default% THEN
                WS_default_layout_reset ' (nothing to save: Default is the stock layout)
            ELSE
                CONFIG_save
            END IF
            STATUS_flash "Panel arrangement reset"
            DOCK_redraw
    END SELECT
END SUB


''
' MOUSE_process_frame (via DOCK_handle_mouse%): the handle menu and handles.
' Returns TRUE when it took the click.
FUNCTION DOCK_handle_chrome% (mx AS INTEGER, my AS INTEGER)
    DIM hit AS INTEGER, s AS INTEGER, hv AS INTEGER
    IF DOCK_UI.menuOpen THEN
        ' (a panel opened it earlier this frame - the Pen Control presets: that
        '  right-click is not a pick, wherever the menu landed under the pointer)
        IF DOCK_UI.menuJust THEN DOCK_UI.menuJust = FALSE: MOUSE.UI_CHROME_CLICKED% = TRUE: DOCK_handle_chrome% = TRUE: EXIT FUNCTION
        hv = POPUP_MENU_hover_row%(DOCK_UI.menuX, DOCK_UI.menuY, DOCK_UI.menuW, DOCK_UI.menuN, DOCK_MENU_ITEM_H, mx, my)
        IF hv <> DOCK_UI.menuHover THEN DOCK_UI.menuHover = hv: FRAME_IDLE% = FALSE
        IF (MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0) _ORELSE (MOUSE.B2% _ANDALSO MOUSE.OLD_B2% = 0) THEN
            DOCK_menu_build DOCK_UI.menuPanel
            hit = POPUP_MENU_hit_value%(DOCK_UI.menuX, DOCK_UI.menuY, DOCK_UI.menuW, DOCK_UI.menuN, DOCK_MENU_ITEM_H, mx, my)
            IF hit <> -1 THEN
                DOCK_UI.menuOpen = FALSE
                DOCK_redraw
                IF hit > 0 THEN DOCK_menu_do hit
            END IF
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
        END IF
        EXIT FUNCTION
    END IF
    ' hover (no buttons held): which handle is under the pointer
    IF MOUSE.B1% = 0 _ANDALSO MOUSE.B2% = 0 THEN
        s = DOCK_handle_at%(mx, my)
        IF s <> DOCK_UI.hoverSlot THEN DOCK_UI.hoverSlot = s: FRAME_IDLE% = FALSE
        s = DOCK_close_at%(mx, my)
        IF s <> DOCK_UI.closeHover THEN DOCK_UI.closeHover = s: FRAME_IDLE% = FALSE
    END IF
    ' click an [x] close box: hide that panel (before a handle press can start a move)
    IF MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0 THEN
        s = DOCK_close_at%(mx, my)
        IF s THEN
            DOCK_panel_close s
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
            EXIT FUNCTION
        END IF
    END IF
    ' right-click a handle: the dock menu for its panel
    IF MOUSE.B2% _ANDALSO MOUSE.OLD_B2% = 0 THEN
        s = DOCK_native_float_title_at%(mx, my)
        IF s THEN
            DOCK_menu_open s, mx, my
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
            EXIT FUNCTION
        END IF
        s = DOCK_float_title_at%(mx, my)
        IF s THEN
            DOCK_menu_open s, mx, my
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
            EXIT FUNCTION
        END IF
        s = DOCK_handle_at%(mx, my)
        IF s THEN
            DOCK_menu_open DOCK_slot_panel%(s), mx, my
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
        END IF
    END IF
END FUNCTION



' =============================================================================
' Slot dividers (P3): the boundary between two stacked flexible slots
' =============================================================================

FUNCTION DOCK_slot_flex% (s AS INTEGER)
    DIM id AS INTEGER
    IF DOCK_SLOT(s).used = 0 _ORELSE DOCK_SLOT(s).vis = 0 _ORELSE DOCK_SLOT(s).collapsed THEN EXIT FUNCTION
    id = DOCK_slot_panel%(s)
    IF id THEN DOCK_slot_flex% = (DPANEL(id).hmode = DP_H_FLEX)
END FUNCTION


''
' The divider under (mx, my): slot above in a, below in b (TRUE when found).
' Two showing flex slots next to each other in one column.
''
' Slot s's handle is the 3px hover grip on its top edge (a chromeless panel).
FUNCTION DOCK_slot_grip% (s AS INTEGER)
    DIM hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER
    IF DOCK_handle_rect%(s, hx, hy, hw, hh) THEN DOCK_slot_grip% = (hh = DOCK_GRIP_H)
END FUNCTION


FUNCTION DOCK_divider_at% (mx AS INTEGER, my AS INTEGER, a AS INTEGER, b AS INTEGER)
    DIM c AS INTEGER, o AS INTEGER, s AS INTEGER, prev AS INTEGER
    IF DOCK_ui_busy% THEN EXIT FUNCTION
    FOR c = 1 TO DOCK_MAX_COLS
        ' (not a row: its slots lie side by side, each its own width - a "divider"
        ' at the next slot's top would sit on the row's seam and eat its handles)
        IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis _ANDALSO DOCK_is_row%(c) = 0 THEN
            IF mx >= DOCK_COL(c).x _ANDALSO mx < DOCK_COL(c).x + DOCK_COL(c).w THEN
                prev = 0
                FOR o = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, o)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis THEN
                        IF prev _ANDALSO DOCK_slot_flex%(prev) _ANDALSO DOCK_slot_flex%(s) THEN
                            IF my >= DOCK_SLOT(s).y - 2 _ANDALSO my <= DOCK_SLOT(s).y + 1 THEN
                                ' the lower panel's 3px grip (a chromeless panel's
                                ' handle) starts at the boundary: it wins there,
                                ' or a stacked drawer / bar could never be moved
                                IF my < DOCK_SLOT(s).y _ORELSE DOCK_slot_grip%(s) = 0 THEN
                                    a = prev: b = s
                                    DOCK_divider_at% = TRUE
                                    EXIT FUNCTION
                                END IF
                            END IF
                        END IF
                        prev = s
                    END IF
                NEXT o
            END IF
        END IF
    NEXT c
END FUNCTION


''
' Turn the shares of column c's flex slots into their current pixel heights,
' so moving one divider leaves every other slot where it is.
SUB DOCK_shares_to_px (c AS INTEGER)
    DIM o AS INTEGER, s AS INTEGER
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        IF DOCK_slot_flex%(s) THEN DOCK_SLOT(s).share = _MAX(1, DOCK_SLOT(s).h)
    NEXT o
END SUB


''
' DOCK_handle_mouse%: grab / drag / drop a divider. TRUE when it took the frame.
FUNCTION DOCK_handle_divider% (mx AS INTEGER, my AS INTEGER)
    DIM a AS INTEGER, b AS INTEGER, ha AS INTEGER, minA AS INTEGER, minB AS INTEGER
    IF DOCK_UI.divA THEN
        a = DOCK_UI.divA: b = DOCK_UI.divB
        minA = DOCK_slot_min_h%(a) ' the panel's own minimum + its strip (DOCK_panel_box)
        minB = DOCK_slot_min_h%(b)
        ha = my - DOCK_UI.divTop
        IF ha < minA THEN ha = minA
        IF ha > DOCK_UI.divTotal - minB THEN ha = DOCK_UI.divTotal - minB
        IF ha <> DOCK_SLOT(a).share _ORELSE DOCK_UI.divTotal - ha <> DOCK_SLOT(b).share THEN
            DOCK_SLOT(a).share = ha
            DOCK_SLOT(b).share = DOCK_UI.divTotal - ha
            DOCK_redraw
        END IF
        IF MOUSE.B1% = 0 THEN
            DOCK_UI.divA = 0
            DOCK_change_commit ""
        END IF
        MOUSE.UI_CHROME_CLICKED% = TRUE
        DOCK_handle_divider% = TRUE
        EXIT FUNCTION
    END IF
    IF MOUSE.B1% = 0 _ANDALSO MOUSE.B2% = 0 THEN
        DOCK_UI.divHover = DOCK_divider_at%(mx, my, a, b)
    END IF
    IF MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0 THEN
        IF DOCK_divider_at%(mx, my, a, b) THEN
            DOCK_change_begin
            DOCK_shares_to_px DOCK_SLOT(a).col
            DOCK_UI.divA = a: DOCK_UI.divB = b
            DOCK_UI.divTop = DOCK_SLOT(a).y
            DOCK_UI.divTotal = DOCK_SLOT(a).h + DOCK_SLOT(b).h
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_divider% = TRUE
        END IF
    END IF
END FUNCTION



' =============================================================================
' Moving a panel by its handle (P3): drop targets, preview, apply
' =============================================================================

''
' What dropping the panel being moved at (mx, my) would do: fills the
' DOCK_UI.tgt* fields (kind + where + the preview rect).
SUB DOCK_drop_target (mx AS INTEGER, my AS INTEGER)
    DIM c AS INTEGER, s AS INTEGER, third AS INTEGER, side AS INTEGER, o AS INTEGER, y1 AS INTEGER, y2 AS INTEGER
    DIM pw AS INTEGER, mv AS INTEGER, inner AS INTEGER
    mv = DOCK_UI.mvPanel
    DOCK_UI.tgtKind = DOCK_TGT_NONE
    y1 = 0
    y2 = SCRN.h& - SCREEN_bottom_bars_h% - 1
    pw = DOCK_panel_w%(mv)
    IF pw < 16 THEN pw = 16
    ' the screen edges: a new outermost column. Where a column already lines
    ' the edge only its outer 4px count, or a narrow bar docked there (20px)
    ' could never be stacked onto or tabbed with.
    DIM zl AS INTEGER, zr AS INTEGER
    zl = DOCK_EDGE_ZONE: zr = DOCK_EDGE_ZONE
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis _ANDALSO DOCK_COL(c).autoh = 0 _ANDALSO DOCK_COL(c).w > 0 THEN
            IF DOCK_COL(c).side = DOCK_LEFT _ANDALSO DOCK_COL(c).x <= DOCK_WX1 THEN zl = 4
            IF DOCK_COL(c).side = DOCK_RIGHT _ANDALSO DOCK_COL(c).x + DOCK_COL(c).w > DOCK_WX2 THEN zr = 4
        END IF
    NEXT c
    ' (DOCK_WX1 / WX2: inside a colour strip docked on that side - a drop on
    ' the strip itself still counts as the edge)
    IF mx < DOCK_WX1 + zl _ORELSE mx > DOCK_WX2 - zr THEN
        DOCK_UI.tgtKind = DOCK_TGT_NEWCOL
        IF mx < DOCK_WX1 + zl THEN
            DOCK_UI.tgtSide = DOCK_LEFT: DOCK_UI.tgtX = DOCK_WX1
        ELSE
            DOCK_UI.tgtSide = DOCK_RIGHT: DOCK_UI.tgtX = DOCK_WX2 + 1 - pw
        END IF
        DOCK_UI.tgtOrd = 1
        DOCK_UI.tgtY = y1: DOCK_UI.tgtW = pw: DOCK_UI.tgtH = y2 - y1 + 1
        EXIT SUB
    END IF
    ' over a top / bottom row
    IF DOCK_row_drop_target%(mx, my) THEN EXIT SUB
    ' over a column
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis _ANDALSO DOCK_is_row%(c) = 0 THEN
            ' (its height too only under / over full-width rows: between the side
            ' docks the rows never share a column's x, and a column's slots can
            ' reach past its rect - a docked window taller than the column)
            IF mx >= DOCK_COL(c).x _ANDALSO mx < DOCK_COL(c).x + DOCK_COL(c).w _ANDALSO (DOCK_ROWS_FULL = 0 _ORELSE (my >= DOCK_COL(c).y _ANDALSO my < DOCK_COL(c).y + DOCK_COL(c).h)) THEN
                side = DOCK_COL(c).side
                ' near the column's inner side: a new column next to it, toward the canvas
                IF side = DOCK_LEFT THEN inner = (mx >= DOCK_COL(c).x + DOCK_COL(c).w - 6) ELSE inner = (mx < DOCK_COL(c).x + 6)
                IF inner THEN
                    DOCK_UI.tgtKind = DOCK_TGT_NEWCOL
                    DOCK_UI.tgtSide = side
                    DOCK_UI.tgtOrd = DOCK_COL(c).ord + 1
                    IF side = DOCK_LEFT THEN DOCK_UI.tgtX = DOCK_COL(c).x + DOCK_COL(c).w - pw \ 2 ELSE DOCK_UI.tgtX = DOCK_COL(c).x - pw \ 2
                    DOCK_UI.tgtY = DOCK_COL(c).y: DOCK_UI.tgtW = pw: DOCK_UI.tgtH = DOCK_COL(c).h
                    EXIT SUB
                END IF
                ' over one of its slots: split above / tab / split below
                FOR o = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, o)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis _ANDALSO my >= DOCK_SLOT(s).y _ANDALSO my < DOCK_SLOT(s).y + DOCK_SLOT(s).h THEN
                        third = DOCK_SLOT(s).h \ 3
                        IF third < 4 THEN third = 4
                        DOCK_UI.tgtX = DOCK_SLOT(s).x: DOCK_UI.tgtW = DOCK_SLOT(s).w
                        IF my < DOCK_SLOT(s).y + third THEN
                            DOCK_UI.tgtKind = DOCK_TGT_SPLIT: DOCK_UI.tgtCol = c: DOCK_UI.tgtOrd = DOCK_SLOT(s).ord
                            DOCK_UI.tgtY = DOCK_SLOT(s).y: DOCK_UI.tgtH = third
                        ELSEIF my >= DOCK_SLOT(s).y + DOCK_SLOT(s).h - third THEN
                            DOCK_UI.tgtKind = DOCK_TGT_SPLIT: DOCK_UI.tgtCol = c: DOCK_UI.tgtOrd = DOCK_SLOT(s).ord + 1
                            DOCK_UI.tgtY = DOCK_SLOT(s).y + DOCK_SLOT(s).h - third: DOCK_UI.tgtH = third
                        ELSE
                            DOCK_UI.tgtKind = DOCK_TGT_TAB: DOCK_UI.tgtSlot = s
                            DOCK_UI.tgtY = DOCK_SLOT(s).y: DOCK_UI.tgtH = DOCK_SLOT(s).h
                        END IF
                        ' onto its own slot: only a split that changes nothing - no target
                        IF DOCK_SLOT(s).ntabs = 1 _ANDALSO DOCK_TAB(s, 1) = mv THEN DOCK_UI.tgtKind = DOCK_TGT_NONE
                        IF DOCK_UI.mvGroup _ANDALSO s = DPANEL(mv).slot THEN DOCK_UI.tgtKind = DOCK_TGT_NONE ' a whole slot onto itself
                        EXIT SUB
                    END IF
                NEXT o
                ' below its last panel (the column's empty rest): stack at the bottom
                DIM lastS AS INTEGER, lastY AS INTEGER
                lastS = 0: lastY = DOCK_COL(c).y
                FOR o = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, o)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis THEN lastS = s: lastY = DOCK_SLOT(s).y + DOCK_SLOT(s).h
                NEXT o
                IF my >= lastY _ANDALSO my < DOCK_COL(c).y + DOCK_COL(c).h THEN
                    IF lastS _ANDALSO DOCK_SLOT(lastS).ntabs = 1 _ANDALSO DOCK_TAB(lastS, 1) = mv THEN EXIT SUB ' it is already last
                    DOCK_UI.tgtKind = DOCK_TGT_SPLIT: DOCK_UI.tgtCol = c
                    IF lastS THEN DOCK_UI.tgtOrd = DOCK_SLOT(lastS).ord + 1 ELSE DOCK_UI.tgtOrd = 1
                    DOCK_UI.tgtX = DOCK_COL(c).x: DOCK_UI.tgtW = DOCK_COL(c).w
                    DOCK_UI.tgtY = lastY: DOCK_UI.tgtH = _MAX(16, DOCK_COL(c).y + DOCK_COL(c).h - lastY)
                    EXIT SUB
                END IF
            END IF
        END IF
    NEXT c
    ' the canvas area's top / bottom edge (inside the rows already there): a
    ' new innermost row
    DIM rx1 AS INTEGER, rx2 AS INTEGER, rTop AS INTEGER, rBot AS INTEGER, rh AS INTEGER
    DOCK_row_span rx1, rx2
    IF mx >= rx1 _ANDALSO mx <= rx2 THEN
        rh = DOCK_row_want_h%(mv)
        rTop = DOCK_ROWS_Y1: IF DOCK_ROWS_FULL _ANDALSO DOCK_ROWS_TOPH > 0 THEN rTop = DOCK_ROWS_Y1 - DOCK_TOPBAR_H
        IF DOCK_ROWS_TOPH = 0 THEN rTop = DOCK_L_BARY1 + DOCK_TOPBAR_H
        rBot = DOCK_ROWS_Y2: IF DOCK_ROWS_BOTH = 0 THEN rBot = DOCK_L_DOCKY2
        IF my >= rTop _ANDALSO my < rTop + DOCK_EDGE_ZONE THEN
            DOCK_UI.tgtKind = DOCK_TGT_NEWCOL: DOCK_UI.tgtSide = DOCK_TOP: DOCK_UI.tgtOrd = DOCK_MAX_COLS + 1
            DOCK_UI.tgtX = rx1: DOCK_UI.tgtW = rx2 - rx1 + 1: DOCK_UI.tgtY = rTop: DOCK_UI.tgtH = rh
            EXIT SUB
        END IF
        IF my <= rBot _ANDALSO my > rBot - DOCK_EDGE_ZONE THEN
            DOCK_UI.tgtKind = DOCK_TGT_NEWCOL: DOCK_UI.tgtSide = DOCK_BOTTOM: DOCK_UI.tgtOrd = DOCK_MAX_COLS + 1
            DOCK_UI.tgtX = rx1: DOCK_UI.tgtW = rx2 - rx1 + 1: DOCK_UI.tgtY = rBot - rh + 1: DOCK_UI.tgtH = rh
            EXIT SUB
        END IF
    END IF
    ' next to the canvas side of the innermost column: a new innermost column
    ' (elsewhere over the canvas: float it there)
    IF mx >= DOCK_LX + DOCK_EDGE_ZONE _ANDALSO mx <= DOCK_RX - DOCK_EDGE_ZONE THEN
        DOCK_UI.tgtKind = DOCK_TGT_FLOAT
        DOCK_UI.tgtX = mx - 8: DOCK_UI.tgtY = my - 4
        DOCK_UI.tgtW = DOCK_panel_w%(mv) + 2: DOCK_UI.tgtH = DOCK_float_content_h%(mv) + DOCK_float_title_h%(mv) + 1
        EXIT SUB
    END IF
    IF mx >= DOCK_LX _ANDALSO mx < DOCK_LX + DOCK_EDGE_ZONE THEN
        DOCK_UI.tgtKind = DOCK_TGT_NEWCOL: DOCK_UI.tgtSide = DOCK_LEFT: DOCK_UI.tgtOrd = DOCK_MAX_COLS + 1
        DOCK_UI.tgtX = DOCK_LX: DOCK_UI.tgtY = y1: DOCK_UI.tgtW = pw: DOCK_UI.tgtH = y2 - y1 + 1
    ELSEIF mx <= DOCK_RX _ANDALSO mx > DOCK_RX - DOCK_EDGE_ZONE THEN
        DOCK_UI.tgtKind = DOCK_TGT_NEWCOL: DOCK_UI.tgtSide = DOCK_RIGHT: DOCK_UI.tgtOrd = DOCK_MAX_COLS + 1
        DOCK_UI.tgtX = DOCK_RX - pw + 1: DOCK_UI.tgtY = y1: DOCK_UI.tgtW = pw: DOCK_UI.tgtH = y2 - y1 + 1
    END IF
END SUB


''
' Drop the panel being moved on the current target.
SUB DOCK_drop_apply ()
    DIM mv AS INTEGER, r AS INTEGER, c AS INTEGER, s AS INTEGER, n AS INTEGER, i AS INTEGER, newS AS INTEGER
    DIM grp(1 TO DOCK_MAX_TABS) AS INTEGER
    mv = DOCK_UI.mvPanel
    IF DOCK_UI.tgtKind = DOCK_TGT_NONE THEN EXIT SUB
    ' moving a whole slot: remember its tabs (the active one moves first)
    IF DOCK_UI.mvGroup _ANDALSO DPANEL(mv).slot > 0 _ANDALSO DOCK_UI.tgtKind <> DOCK_TGT_FLOAT THEN
        s = DPANEL(mv).slot
        n = DOCK_SLOT(s).ntabs
        FOR i = 1 TO n: grp(i) = DOCK_TAB(s, i): NEXT i
    END IF
    IF DOCK_UI.tgtKind = DOCK_TGT_FLOAT THEN
        IF DPANEL(mv).floats THEN
            IF DPANEL(mv).slot > 0 THEN DOCK_native_undock mv, DOCK_UI.tgtX, DOCK_UI.tgtY
        ELSEIF DOCK_floating%(mv) = 0 THEN
            DOCK_float_panel mv, DOCK_UI.tgtX, DOCK_UI.tgtY
        END IF
        EXIT SUB
    END IF
    DOCK_change_begin
    SELECT CASE DOCK_UI.tgtKind
        CASE DOCK_TGT_NEWCOL
            r = DOCK_move_to_new_col%(mv, DOCK_UI.tgtSide, DOCK_UI.tgtOrd)
            IF DOCK_side_is_row%(DOCK_UI.tgtSide) _ANDALSO n <= 1 THEN DOCK_change_commit DPANEL(mv).title + " docked along the " + LCASE$(DOCK_side_name$(DOCK_UI.tgtSide)): EXIT SUB
        CASE DOCK_TGT_SPLIT
            ' the target column may renumber when the panel leaves it (same column)
            c = DOCK_UI.tgtCol
            IF DPANEL(mv).slot > 0 _ANDALSO DOCK_SLOT(DPANEL(mv).slot).col = c _ANDALSO DOCK_SLOT(DPANEL(mv).slot).ntabs = 1 _ANDALSO DOCK_SLOT(DPANEL(mv).slot).ord < DOCK_UI.tgtOrd THEN DOCK_UI.tgtOrd = DOCK_UI.tgtOrd - 1
            r = DOCK_move_to_slot%(mv, c, DOCK_UI.tgtOrd)
        CASE DOCK_TGT_TAB
            r = DOCK_move_to_tab%(mv, DOCK_UI.tgtSlot)
    END SELECT
    ' a whole slot: its other tabs follow the active one, in their order
    IF n > 1 _ANDALSO DPANEL(mv).slot > 0 THEN
        FOR i = 1 TO n
            IF grp(i) <> mv THEN r = DOCK_move_to_tab%(grp(i), DPANEL(mv).slot)
        NEXT i
        newS = DPANEL(mv).slot
        FOR i = 1 TO DOCK_SLOT(newS).ntabs
            IF DOCK_TAB(newS, i) = mv THEN DOCK_SLOT(newS).act = i
        NEXT i
        DOCK_change_commit DPANEL(mv).title + " and its tabs moved"
        EXIT SUB
    END IF
    DOCK_change_commit DPANEL(mv).title + " moved"
END SUB


''
' DOCK_handle_mouse%: press on a handle, drag past the threshold, drop.
' TRUE when it took the frame.
FUNCTION DOCK_handle_move% (mx AS INTEGER, my AS INTEGER)
    DIM s AS INTEGER
    IF DOCK_UI.mvNative THEN EXIT FUNCTION ' its own drag code runs it
    IF DOCK_UI.mvPanel THEN
        IF DOCK_UI.mvActive = 0 THEN
            IF ABS(mx - DOCK_UI.mvX0) + ABS(my - DOCK_UI.mvY0) >= DOCK_DRAG_START THEN DOCK_UI.mvActive = TRUE
        END IF
        IF DOCK_UI.mvActive THEN
            DOCK_drop_target mx, my
            ' a floating window follows the pointer unless it is over a dock target
            IF DOCK_UI.mvFloat _ANDALSO (DOCK_UI.tgtKind = DOCK_TGT_NONE _ORELSE DOCK_UI.tgtKind = DOCK_TGT_FLOAT) THEN
                ' snaps as it moves (like the native windows' drags): to the
                ' other floating windows' edges and the work area, no overlap
                DIM fmx AS INTEGER, fmy AS INTEGER, fpx AS INTEGER, fpy AS INTEGER, frg AS INTEGER
                fpx = DPANEL(DOCK_UI.mvPanel).fx: fpy = DPANEL(DOCK_UI.mvPanel).fy
                fmx = mx - DOCK_UI.mvOffX: fmy = my - DOCK_UI.mvOffY
                frg = DOCK_panel_region%(DOCK_UI.mvPanel)
                IF frg THEN FPANEL_place frg, fmx, fmy, DPANEL(DOCK_UI.mvPanel).fw, DPANEL(DOCK_UI.mvPanel).fh, fpx, fpy
                DPANEL(DOCK_UI.mvPanel).fx = fmx
                DPANEL(DOCK_UI.mvPanel).fy = fmy
                DOCK_UI.tgtKind = DOCK_TGT_NONE
                DOCK_redraw
            END IF
            FRAME_IDLE% = FALSE
        END IF
        ' right button cancels a move
        IF MOUSE.B2% _ANDALSO MOUSE.OLD_B2% = 0 THEN
            DOCK_UI.mvPanel = 0: DOCK_UI.mvActive = FALSE: DOCK_UI.tgtKind = DOCK_TGT_NONE
            STATUS_flash "Move cancelled"
            DOCK_redraw
        ELSEIF MOUSE.B1% = 0 THEN
            IF DOCK_UI.mvActive THEN
                IF DOCK_UI.mvFloat _ANDALSO DOCK_UI.tgtKind = DOCK_TGT_NONE THEN
                    DOCK_float_moved DOCK_UI.mvPanel
                ELSE
                    DOCK_drop_apply
                END IF
            ELSEIF DOCK_UI.mvFloat THEN
                DOCK_float_click DOCK_UI.mvPanel
            ELSE
                DOCK_title_click DOCK_UI.mvSlot, DOCK_UI.mvX0
            END IF
            DOCK_UI.mvPanel = 0: DOCK_UI.mvActive = FALSE: DOCK_UI.tgtKind = DOCK_TGT_NONE
            DOCK_redraw
        END IF
        MOUSE.UI_CHROME_CLICKED% = TRUE
        DOCK_handle_move% = TRUE
        EXIT FUNCTION
    END IF
    IF MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0 THEN
        ' a floating panel's title bar
        s = DOCK_float_title_at%(mx, my)
        IF s THEN
            DOCK_UI.mvPanel = s: DOCK_UI.mvSlot = 0: DOCK_UI.mvFloat = TRUE: DOCK_UI.mvGroup = FALSE
            DOCK_UI.mvOffX = mx - DPANEL(s).fx: DOCK_UI.mvOffY = my - DPANEL(s).fy
            DOCK_UI.mvActive = FALSE
            DOCK_UI.mvX0 = mx: DOCK_UI.mvY0 = my
            DOCK_UI.tgtKind = DOCK_TGT_NONE
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_move% = TRUE
            EXIT FUNCTION
        END IF
        s = DOCK_handle_at%(mx, my)
        IF s THEN
            DOCK_UI.mvFloat = FALSE
            DOCK_UI.mvGroup = FALSE
            DOCK_UI.mvPanel = DOCK_slot_panel%(s)
            IF DOCK_slot_titled%(s) THEN
                IF DOCK_tab_at%(s, mx) > 0 THEN
                    DOCK_UI.mvPanel = DOCK_TAB(s, DOCK_tab_at%(s, mx))
                ELSEIF DOCK_SLOT(s).ntabs > 1 _ANDALSO mx >= DOCK_SLOT(s).x + 10 THEN
                    DOCK_UI.mvGroup = TRUE ' the strip past its tabs: move the whole slot
                END IF
            END IF
            DOCK_UI.mvSlot = s
            DOCK_UI.mvActive = FALSE
            DOCK_UI.mvX0 = mx: DOCK_UI.mvY0 = my
            DOCK_UI.tgtKind = DOCK_TGT_NONE
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_move% = TRUE
        END IF
    END IF
END FUNCTION


''
' The visible rect of a native window (viewport px), FALSE = not showing.
FUNCTION DOCK_native_rect% (id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    IF DOCK_panel_shown%(id) = 0 _ORELSE DOCK_native_off%(id) THEN EXIT FUNCTION
    SELECT CASE id
        CASE DP_PREVIEW: PREVIEW_compute_display: x = PREVIEW.x%: y = PREVIEW.y%: w = PREVIEW.dispW%: h = PREVIEW.dispH%
        CASE DP_MIXER: x = COLORMIXER.dispX%: y = COLORMIXER.dispY%: w = COLORMIXER.dispW%: h = COLORMIXER.dispH%
        CASE DP_ADVCP: x = ADVCP.dispX%: y = ADVCP.dispY%: w = ADVCP.dispW%: h = ADVCP.dispH%
        CASE DP_CS3D: x = CS3D.dispX%: y = CS3D.dispY%: w = CS3D.dispW%: h = CS3D.dispH%
        CASE DP_PEN: x = PENP.dispX%: y = PENP.dispY%: w = PENP.dispW%: h = PENP.dispH%
        CASE DP_ANIM: x = ANIMP.dispX: y = ANIMP.dispY: w = ANIMP.dispW: h = ANIMP.dispH
        CASE DP_SWATCH: x = SWP.dispX: y = SWP.dispY: w = SWP.dispW: h = SWP.dispH
        CASE DP_BROWSER: x = BROWSER.dispX%: y = BROWSER.dispY%: w = BROWSER.dispW%: h = BROWSER.dispH%
        CASE ELSE: EXIT FUNCTION
    END SELECT
    DOCK_native_rect% = TRUE
END FUNCTION


''
' No native window (floating or docked) covers the rect (x, y, w, h).
FUNCTION DOCK_label_clear% (x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    DIM id AS INTEGER, rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER
    FOR id = DP_PREVIEW TO DP_COUNT
        IF DOCK_native_rect%(id, rx, ry, rw, rh) THEN
            IF x < rx + rw _ANDALSO x + w > rx _ANDALSO y < ry + rh _ANDALSO y + h > ry THEN EXIT FUNCTION
        END IF
    NEXT id
    DOCK_label_clear% = TRUE
END FUNCTION


''
' After the native windows have drawn on the window (they cover the canvas
' and every overlay on it): the drop target, the drop label and the handle
' menu go on top. The label and menu are copied from the canvas; the target is
' drawn translucent here only (on the canvas it would tint twice). Partial
' presents are off while these show, so the window is repainted every frame
' and the translucent fill never builds up.
SUB DOCK_reblit_to_screen0 ()
    DIM ds AS INTEGER, k AS INTEGER, x1 AS LONG, y1 AS LONG, x2 AS LONG, y2 AS LONG, oldDest AS LONG
    DIM showTgt AS INTEGER, gs AS INTEGER, gid AS INTEGER, hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER
    showTgt = (DOCK_UI.mvActive <> 0 _ANDALSO DOCK_UI.tgtKind <> DOCK_TGT_NONE)
    ' the hover grip of a panel drawn at its own Scale: DOCK_overlay_render puts
    ' it in the presented canvas, and the panel's surface is drawn onto the
    ' window after that, over it (Rick, 2026-11-14: "when i scale the edit bar to
    ' something not auto - it does not show the little handle at the top")
    gs = DOCK_UI.hoverSlot
    IF gs _ANDALSO DOCK_UI.menuOpen = 0 _ANDALSO DOCK_DRAG.which = 0 _ANDALSO DOCK_UI.mvActive = 0 _ANDALSO CFG.LAYOUT_LOCKED% = 0 THEN
        gid = DOCK_slot_panel%(gs)
        IF gid < 1 _ORELSE gid > PSURF_N THEN
            gs = 0
        ELSEIF PSURF_on%(gid) = 0 _ORELSE DOCK_handle_rect%(gs, hx, hy, hw, hh) = 0 THEN
            gs = 0
        END IF
    ELSE
        gs = 0
    END IF
    IF showTgt = 0 _ANDALSO DOCK_UI.menuOpen = 0 _ANDALSO gs = 0 THEN EXIT SUB
    ds = SCRN.displayScale%: IF ds < 1 THEN ds = 1
    oldDest& = _DEST
    _DEST 0
    IF gs THEN DOCK_reblit_rect hx, hy, hw, hh, ds
    IF showTgt THEN
        x1 = CLNG(DOCK_UI.tgtX) * ds: y1 = CLNG(DOCK_UI.tgtY) * ds
        x2 = CLNG(DOCK_UI.tgtX + DOCK_UI.tgtW) * ds - 1: y2 = CLNG(DOCK_UI.tgtY + DOCK_UI.tgtH) * ds - 1
        LINE (x1, y1)-(x2, y2), _RGBA32(80, 160, 255, 80), BF
        FOR k = 0 TO ds - 1
            LINE (x1 + k, y1 + k)-(x2 - k, y2 - k), _RGBA32(120, 190, 255, 230), B
        NEXT k
        IF DOCK_UI.lbW > 0 THEN DOCK_reblit_rect DOCK_UI.lbX, DOCK_UI.lbY, DOCK_UI.lbW, DOCK_UI.lbH, ds
    END IF
    ' (the handle menu is a POPUP_MENU_render popup: POPUP_reblit_to_screen0
    ' redraws exactly its frame - a margin here put canvas pixels over windows)
    _DEST oldDest&
END SUB


SUB DOCK_reblit_rect (x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, ds AS INTEGER)
    DIM x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER
    x1 = _MAX(0, x): y1 = _MAX(0, y)
    x2 = _MIN(SCRN.w& - 1, x + w - 1): y2 = _MIN(SCRN.h& - 1, y + h - 1)
    IF x2 < x1 _ORELSE y2 < y1 THEN EXIT SUB
    _PUTIMAGE (CLNG(x1) * ds, CLNG(y1) * ds)-(CLNG(x2 + 1) * ds - 1, CLNG(y2 + 1) * ds - 1), SCRN.CANVAS&, 0, (x1, y1)-(x2, y2)
END SUB


''
' Overlay: the drop preview while a panel is being moved.
SUB DOCK_move_render ()
    DIM lbl AS STRING, tx AS INTEGER, ty AS INTEGER, oldFont AS LONG
    IF DOCK_UI.mvActive = 0 THEN EXIT SUB
    IF DOCK_UI.mvNative _ANDALSO DOCK_UI.tgtKind = DOCK_TGT_NONE THEN EXIT SUB ' an ordinary window drag
    ' the drop hint in the panels' own small font (Tiny5), not the 16px default
    oldFont& = _FONT
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle&
    ' the target rect itself is drawn by DOCK_reblit_to_screen0, on the window
    ' after the native windows (it may lie over one: a docked Color Mixer)
    lbl = DPANEL(DOCK_UI.mvPanel).title
    IF DOCK_UI.mvGroup _ANDALSO DPANEL(DOCK_UI.mvPanel).slot > 0 THEN lbl = lbl + " +" + STR$(DOCK_SLOT(DPANEL(DOCK_UI.mvPanel).slot).ntabs - 1) + " tab(s)"
    SELECT CASE DOCK_UI.tgtKind
        CASE DOCK_TGT_NEWCOL
            IF DOCK_UI.tgtSide = DOCK_TOP THEN
                lbl = lbl + ": new row along the top"
            ELSEIF DOCK_UI.tgtSide = DOCK_BOTTOM THEN
                lbl = lbl + ": new row along the bottom"
            ELSE
                lbl = lbl + ": new column"
            END IF
        CASE DOCK_TGT_SPLIT
            IF DOCK_is_row%(DOCK_UI.tgtCol) THEN lbl = lbl + ": beside here" ELSE lbl = lbl + ": stack here"
        CASE DOCK_TGT_TAB: lbl = lbl + ": add as a tab"
        CASE DOCK_TGT_FLOAT: lbl = lbl + ": float here"
        CASE DOCK_TGT_BAND
            IF DOCK_UI.tgtSide = DOCK_BAND_TOP THEN lbl = lbl + ": dock along the top" ELSE lbl = lbl + ": dock along the bottom"
        CASE ELSE: lbl = lbl + ": drop on a dock"
    END SELECT
    ' the native windows draw over the canvas (this overlay included), so the
    ' label goes where none of them is (a dragged window is held in the work
    ' area and may lag the pointer, so it counts too)
    DIM lw AS INTEGER, lh AS INTEGER, k AS INTEGER, cx AS INTEGER, cy AS INTEGER
    DIM gx AS INTEGER, gy AS INTEGER, gw AS INTEGER, gh AS INTEGER
    lw = _UPRINTWIDTH(lbl) + 6: lh = _UFONTHEIGHT + 4
    tx = MOUSE.RAW_X% + 10: ty = MOUSE.RAW_Y% + 10
    ' candidates: right / left of the pointer, at a few heights below and above
    ' it (the first height above sits over a dragged window's title bar)
    FOR k = 0 TO 12
        IF k = 12 THEN
            cx = MOUSE.RAW_X% + 10: cy = MOUSE.RAW_Y% + 10 ' nothing clear: beside the pointer
        ELSE
            IF k MOD 2 = 0 THEN cx = MOUSE.RAW_X% + 10 ELSE cx = MOUSE.RAW_X% - lw - 10
            SELECT CASE k \ 2
                CASE 0: cy = MOUSE.RAW_Y% + 10
                CASE 1
                    cy = MOUSE.RAW_Y% - lh - 18
                    IF DOCK_UI.mvNative _ANDALSO DOCK_native_grab%(DOCK_UI.mvPanel, gx, gy, gw, gh) THEN cy = gy - lh - 2
                CASE 2: cy = MOUSE.RAW_Y% - lh - 44
                CASE 3: cy = MOUSE.RAW_Y% + 40
                CASE 4: cy = MOUSE.RAW_Y% - lh - 80
                CASE 5: cy = MOUSE.RAW_Y% + 80
            END SELECT
        END IF
        IF cx + lw > SCRN.w& THEN cx = SCRN.w& - lw
        IF cx < 3 THEN cx = 3
        IF cy < 2 THEN cy = 2
        IF cy + lh > SCRN.h& THEN cy = SCRN.h& - lh
        tx = cx: ty = cy
        IF k = 12 _ORELSE DOCK_label_clear%(cx - 3, cy - 2, lw, lh) THEN EXIT FOR
    NEXT k
    LINE (tx - 3, ty - 2)-(tx + _UPRINTWIDTH(lbl) + 2, ty + _UFONTHEIGHT + 1), _RGBA32(20, 24, 32, 230), BF
    DOCK_UI.lbX = tx - 3: DOCK_UI.lbY = ty - 2: DOCK_UI.lbW = _UPRINTWIDTH(lbl) + 6: DOCK_UI.lbH = _UFONTHEIGHT + 4
    COLOR _RGB32(230, 235, 245), 0
    _PRINTMODE _KEEPBACKGROUND
    _UPRINTSTRING (tx, ty), lbl
    _FONT oldFont&
END SUB



''
' Tab t of titled slot s on its strip: x and width. Tabs take their label's
' width; when those don't fit the strip (a narrow column) they share it evenly
' and their labels are cut (DOCK_fit_text$). Never past the slot's right edge.
' FALSE when the slot shows no tabs.
FUNCTION DOCK_tab_rect% (s AS INTEGER, t AS INTEGER, tx AS INTEGER, tw AS INTEGER)
    DIM k AS INTEGER, x0 AS INTEGER, avail AS INTEGER, total AS INTEGER, x AS INTEGER, wdt AS INTEGER, each AS INTEGER
    DIM bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER
    DIM oldDest AS LONG, oldFont AS LONG
    IF DOCK_slot_titled%(s) = 0 _ORELSE t < 1 _ORELSE t > DOCK_SLOT(s).ntabs THEN EXIT FUNCTION
    oldDest& = _DEST: oldFont& = _FONT
    _DEST SCRN.GUI&
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle& ELSE IF MENU_BAR.fontHandle& > 0 THEN _FONT MENU_BAR.fontHandle&
    x0 = DOCK_SLOT(s).x + 12 ' (past the twirl arrow + a gap)
    avail = DOCK_SLOT(s).x + DOCK_SLOT(s).w - 2 - x0
    IF DOCK_slot_close_rect%(s, bx, by, bw, bh) THEN avail = avail - bw ' (the [x] at the right end)
    IF avail < DOCK_SLOT(s).ntabs THEN avail = DOCK_SLOT(s).ntabs
    FOR k = 1 TO DOCK_SLOT(s).ntabs
        total = total + _UPRINTWIDTH(UCASE$(DPANEL(DOCK_TAB(s, k)).title)) + 8
    NEXT k
    IF total - 4 <= avail THEN
        x = x0
        FOR k = 1 TO t
            wdt = _UPRINTWIDTH(UCASE$(DPANEL(DOCK_TAB(s, k)).title))
            IF k = t THEN tx = x: tw = wdt + 4
            x = x + wdt + 8
        NEXT k
    ELSE
        each = avail \ DOCK_SLOT(s).ntabs
        tx = x0 + (t - 1) * each
        tw = each - 2: IF tw < 1 THEN tw = 1
    END IF
    _FONT oldFont&: _DEST oldDest&
    DOCK_tab_rect% = TRUE
END FUNCTION


''
' lbl cut to fit w px in the current font ("" when not one character fits).
FUNCTION DOCK_fit_text$ (lbl AS STRING, w AS INTEGER)
    DIM r AS STRING
    r = lbl
    DO WHILE LEN(r) > 0 _ANDALSO _UPRINTWIDTH(r) > w
        r = LEFT$(r, LEN(r) - 1)
    LOOP
    DOCK_fit_text$ = r
END FUNCTION


''
' The QA layout dump (DOCK_DUMP_PATH, see DOCK.BI). Lines:
'   TREE <describe, columns joined by " ; ">
'   SCR  <w> <h> <canvas left x> <canvas right x> <dock top y> <dock bottom y>
'   BAND <side 0/1 top/2 bottom> <x> <y> <w> <h> <canvas shift y>   (the Browser's band)
'   COL  <col> <side> <ord> <x> <y> <w> <h> <vis> <hidden for width>
'   SLOT <slot> <col> <ord> <x> <y> <w> <h> <vis> <collapsed> <act> <autocollapsed> <panels,...>
'   P    <name> <shown> <live> <x> <y> <w> <h> <slot> <floating> <fx> <fy> <fw> <fh> <hx> <hy> <hw> <hh> <tabx> <tabw>
'   BTN / TBED / TBC: the toolbox's and bars' buttons and the Customize Toolbars
'   window (GUI/TOOLBAR-EDITOR.BM TBED_dump$)
'   WIN   <name> <x> <y> <w> <h> <slot>   a native window as drawn (tbed = Customize Toolbars)
'   VIEW  <zoom x100> <offsetX> <offsetY> <CURRENT_TOOL%>
'   PALNAME <x> <y> <w> <h>        the palette name (opens the palette menu)
'   MROOT <label> <x> <w>          a menu bar root
'   MENU  <x> <y> <w> <h>          the open dropdown's frame
'   POPUP <kind> <x> <y> <w> <h>   every popup redrawn above the windows last frame
'         (dropdown, flyout-<name>, popup = a context menu, cmdpalette, palettemenu, subtool)
' (handle = what to press to move it: its slot's handle, a floating title or
'  grip, or a floating window's title bar; tab = its tab on a tab strip.)
SUB DOCK_dump_write (barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM d AS STRING, c AS INTEGER, s AS INTEGER, t AS INTEGER, id AS INTEGER, f AS INTEGER, lst AS STRING, lf AS STRING
    DIM hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER, tx AS INTEGER, tw AS INTEGER, fl AS INTEGER
    DIM dqx AS INTEGER, dqy AS INTEGER, dqw AS INTEGER, dqh AS INTEGER, dq(1 TO 16) AS INTEGER
    IF LEN(DOCK_DUMP_PATH) = 0 THEN EXIT SUB
    lf = CHR$(10)
    d = "TREE " + DOCK_dump_tree$ + lf
    ' BAND <side 1 top / 2 bottom, 0 none> <x y w h> <shiftY>: the Browser's row (its old band)
    DIM bdS AS INTEGER, bdC AS INTEGER, bdSl AS INTEGER
    bdSl = DPANEL(DP_BROWSER).slot
    IF bdSl > 0 THEN
        bdC = DOCK_SLOT(bdSl).col
        IF DOCK_is_row%(bdC) _ANDALSO DOCK_COL(bdC).vis _ANDALSO DOCK_SLOT(bdSl).vis THEN bdS = DOCK_COL(bdC).side - 2
    END IF
    IF bdS THEN
        d = d + "BAND" + DOCK_n$(bdS) + DOCK_n$(DOCK_SLOT(bdSl).x) + DOCK_n$(DOCK_COL(bdC).y) + DOCK_n$(DOCK_SLOT(bdSl).w) + DOCK_n$(DOCK_COL(bdC).h) + DOCK_n$(SCRN.panelShiftY%) + lf
    ELSE
        d = d + "BAND 0 0 0 0 0" + DOCK_n$(SCRN.panelShiftY%) + lf
    END IF
    ' ROWS <full width> <first y under the top rows> <last y above the bottom rows> <top h> <bottom h>
    d = d + "ROWS" + DOCK_n$(DOCK_ROWS_FULL <> 0) + DOCK_n$(DOCK_ROWS_Y1) + DOCK_n$(DOCK_ROWS_Y2) + DOCK_n$(DOCK_ROWS_TOPH) + DOCK_n$(DOCK_ROWS_BOTH) + lf
    ' TEXTBAR visible x y w h topbarH fontBtnX fontBtnW; SUBFLY active x y w h vertical btnW btnH
    d = d + "TEXTBAR" + DOCK_n$(TEXT_BAR.visible% <> 0) + DOCK_n$(TEXT_BAR.barX%) + DOCK_n$(TEXT_BAR.barY%) + DOCK_n$(TEXT_BAR.barW%) + DOCK_n$(TEXT_BAR.barH%) + DOCK_n$(DOCK_TOPBAR_H) + DOCK_n$(TEXT_BAR.fontBtnX%) + DOCK_n$(TEXT_BAR.fontBtnW%) + DOCK_n$(TEXT_BAR.lines%) + DOCK_n$(TEXT_BAR_BY(TEXT_BTN_FONT)) + DOCK_n$(TEXT_BAR_BY(TEXT_BTN_AA)) + DOCK_n$(TEXT_BAR.aaBtnX%) + lf ' (+ lines, the FONT / AA line tops, AA x: the controls wrap)
    d = d + SELBAR_dump$ ' SELBAR / SELBARC (GUI/SEL-BAR)
    d = d + MYPP_dump$ + MYPAINT_dump$ ' MYPP / MYPPB (GUI/MYPAINT-PANEL), MYP (TOOLS/MYPAINT)
    d = d + MPS_dump$ + BSP_dump$ ' MPS / MPSS / MPSB (GUI/MYPAINT-SET), BSP / BSPC / BSPS (GUI/BRUSH-PANEL)
    DIM sfx AS INTEGER, sfy AS INTEGER, sfw AS INTEGER, sfh AS INTEGER
    IF SUBTOOL_FLYOUT_frame%(sfx, sfy, sfw, sfh) = 0 THEN sfx = 0: sfy = 0: sfw = 0: sfh = 0
    d = d + "SUBFLY" + DOCK_n$(SUBTOOL_FLYOUT.ACTIVE <> 0) + DOCK_n$(sfx) + DOCK_n$(sfy) + DOCK_n$(sfw) + DOCK_n$(sfh) + DOCK_n$(SUBTOOL_FLYOUT.VERTICAL <> 0) + DOCK_n$(SUBTOOL_FLYOUT.BTN_W) + DOCK_n$(SUBTOOL_FLYOUT.BTN_H) + lf
    ' SBAR <h shown> <h x y w h> <v shown> <v x y w h> <undo count> (canvas scrollbars' tracks)
    d = d + "SBAR" + DOCK_n$(SCROLLBAR.hVisible% <> 0) + DOCK_n$(SCROLLBAR.hTrackX%) + DOCK_n$(SCROLLBAR.hTrackY%) + DOCK_n$(SCROLLBAR.hTrackW%) + DOCK_n$(SCROLLBAR.hTrackH%)
    d = d + DOCK_n$(SCROLLBAR.vVisible% <> 0) + DOCK_n$(SCROLLBAR.vTrackX%) + DOCK_n$(SCROLLBAR.vTrackY%) + DOCK_n$(SCROLLBAR.vTrackW%) + DOCK_n$(SCROLLBAR.vTrackH%) + DOCK_n$(HISTORY.count) + lf
    ' STCHIP <transparent chip x y> <FG transparent> <FG rgba hex> (the status bar's X chip)
    d = d + "STCHIP" + DOCK_n$(STATUS_TRANS_SWATCH_X%) + DOCK_n$(STATUS_TRANS_SWATCH_Y%) + DOCK_n$(PAL_FG_IS_TRANSPARENT% <> 0) + " " + HEX$(PAINT_COLOR~&) + lf
    d = d + "SCR" + DOCK_n$(SCRN.w&) + DOCK_n$(SCRN.h&) + DOCK_n$(DOCK_LX) + DOCK_n$(DOCK_RX) + DOCK_n$(barY1) + DOCK_n$(dockY2) + lf
    ' the seam colors: a left column's inner (right) edge, a right column's inner (left) edge
    d = d + "SEAM " + RIGHT$("00000" + HEX$(THEME.DOCK_seam~& AND &HFFFFFF~&), 6) + " " + RIGHT$("00000" + HEX$(THEME.DOCK_seam_right~& AND &HFFFFFF~&), 6) + lf
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used THEN d = d + "COL" + DOCK_n$(c) + DOCK_n$(DOCK_COL(c).side) + DOCK_n$(DOCK_COL(c).ord) + DOCK_n$(DOCK_COL(c).x) + DOCK_n$(DOCK_COL(c).y) + DOCK_n$(DOCK_COL(c).w) + DOCK_n$(DOCK_COL(c).h) + DOCK_n$(DOCK_COL(c).vis <> 0) + DOCK_n$(DOCK_COL(c).autoh <> 0) + lf
    NEXT c
    FOR s = 1 TO DOCK_MAX_SLOTS
        IF DOCK_SLOT(s).used THEN
            lst = ""
            FOR t = 1 TO DOCK_SLOT(s).ntabs
                IF t > 1 THEN lst = lst + ","
                lst = lst + DPANEL(DOCK_TAB(s, t)).nm
            NEXT t
            d = d + "SLOT" + DOCK_n$(s) + DOCK_n$(DOCK_SLOT(s).col) + DOCK_n$(DOCK_SLOT(s).ord) + DOCK_n$(DOCK_SLOT(s).x) + DOCK_n$(DOCK_SLOT(s).y) + DOCK_n$(DOCK_SLOT(s).w) + DOCK_n$(DOCK_SLOT(s).h) + DOCK_n$(DOCK_SLOT(s).vis <> 0) + DOCK_n$(DOCK_SLOT(s).collapsed <> 0) + DOCK_n$(DOCK_SLOT(s).act) + DOCK_n$(DOCK_SLOT(s).autoc <> 0) + " " + lst + lf
            IF DOCK_SLOT(s).vis THEN d = d + "SMIN" + DOCK_n$(s) + DOCK_n$(DOCK_slot_min_h%(s)) + lf
        END IF
    NEXT s
    FOR id = 1 TO DP_COUNT
        hx = 0: hy = 0: hw = 0: hh = 0: tx = 0: tw = 0
        s = DPANEL(id).slot
        fl = DOCK_floating%(id) _ORELSE (DPANEL(id).floats <> 0 _ANDALSO s = 0 )
        IF s > 0 THEN
            IF DOCK_handle_rect%(s, hx, hy, hw, hh) = 0 THEN hx = 0: hy = 0: hw = 0: hh = 0
            FOR t = 1 TO DOCK_SLOT(s).ntabs
                IF DOCK_TAB(s, t) = id THEN
                    IF DOCK_SLOT(s).ntabs > 1 _ORELSE DOCK_SLOT(s).collapsed THEN
                        IF DOCK_tab_rect%(s, t, tx, tw) = 0 THEN tx = 0: tw = 0
                    END IF
                END IF
            NEXT t
        ELSEIF DOCK_floating%(id) THEN
            hx = DPANEL(id).fx: hy = DPANEL(id).fy: hw = DPANEL(id).fw: hh = DOCK_float_handle_h%(id)
        ELSEIF DPANEL(id).floats THEN
            IF DOCK_native_grab%(id, hx, hy, hw, hh) = 0 THEN hx = 0: hy = 0: hw = 0: hh = 0
        END IF
        f = DOCK_floating%(id)
        d = d + "P " + DPANEL(id).nm + DOCK_n$(DOCK_panel_shown%(id) <> 0) + DOCK_n$(DPANEL(id).rVis <> 0)
        d = d + DOCK_n$(DPANEL(id).rx) + DOCK_n$(DPANEL(id).ry) + DOCK_n$(DPANEL(id).rw) + DOCK_n$(DPANEL(id).rh) + DOCK_n$(s) + DOCK_n$(fl <> 0)
        d = d + DOCK_n$(DPANEL(id).fx) + DOCK_n$(DPANEL(id).fy) + DOCK_n$(DPANEL(id).fw) + DOCK_n$(DPANEL(id).fh)
        d = d + DOCK_n$(hx) + DOCK_n$(hy) + DOCK_n$(hw) + DOCK_n$(hh) + DOCK_n$(tx) + DOCK_n$(tw) + lf
    NEXT id
    d = d + TBED_dump$
    ' the native windows where they are actually drawn (overlap invariant)
    DIM wx AS INTEGER, wy AS INTEGER, ww AS INTEGER, wh AS INTEGER
    FOR id = DP_PREVIEW TO DP_COUNT
        IF DOCK_native_rect%(id, wx, wy, ww, wh) THEN d = d + "WIN " + DPANEL(id).nm + DOCK_n$(wx) + DOCK_n$(wy) + DOCK_n$(ww) + DOCK_n$(wh) + DOCK_n$(DPANEL(id).slot) + lf
    NEXT id
    ' FIT name natW natH: a floating-family panel's natural size (viewport px) -
    ' docked it fills its slot (FPANEL_fit)
    FOR id = DP_PREVIEW TO DP_COUNT
        IF FPANEL_has_scale%(id) _ANDALSO DOCK_panel_shown%(id) THEN d = d + "FIT " + DPANEL(id).nm + DOCK_n$(FPANEL_nat_w%(id)) + DOCK_n$(FPANEL_nat_h%(id)) + lf
    NEXT id
    d = d + COLORMIXER_dump$
    d = d + ADVCP_dump$
    d = d + SWP_dump$
    IF TBED.visible _ANDALSO TBED.autoHidden = 0 _ANDALSO TBED.initialized THEN d = d + "WIN tbed" + DOCK_n$(TBED.dispX) + DOCK_n$(TBED.dispY) + DOCK_n$(TBED.dispW) + DOCK_n$(TBED.dispH) + " 0" + lf
    ' menu bar roots and the open dropdown's frame (popup-over-window tests)
    FOR t = 0 TO MENU_ROOT_COUNT - 1
        d = d + "MROOT " + LCASE$(_TRIM$(MENU_ROOT_LABEL(t))) + DOCK_n$(MENU_ROOT_X(t)) + DOCK_n$(MENU_ROOT_W(t)) + lf
    NEXT t
    d = d + "VIEW" + DOCK_n$(INT(SCRN.zoom! * 100 + 0.5)) + DOCK_n$(SCRN.offsetX%) + DOCK_n$(SCRN.offsetY%) + DOCK_n$(CURRENT_TOOL%) + lf
    d = d + "SBSW" + DOCK_n$(STATUS_FG_SWATCH_X%) + DOCK_n$(STATUS_FG_SWATCH_Y%) + lf ' SBSW <status bar FG swatch x y> (right-click: the GJ picker)
    d = d + "CANVAS" + DOCK_n$(SCRN.canvasW&) + DOCK_n$(SCRN.canvasH&) + DOCK_n$(CROP.STATE) + lf ' CANVAS w h <crop mode>
    ' CANVR x y w h: the canvas on screen (viewport px), as SCREEN_render draws it
    d = d + "CANVR" + DOCK_n$((SCRN.w& - CLNG(SCRN.canvasW& * SCRN.zoom!)) \ 2 + SCRN.offsetX% + SCRN.panelShiftX%) + DOCK_n$((SCRN.h& - CLNG(SCRN.canvasH& * SCRN.zoom!)) \ 2 + SCRN.offsetY% + SCRN.panelShiftY%)
    d = d + DOCK_n$(CLNG(SCRN.canvasW& * SCRN.zoom!)) + DOCK_n$(CLNG(SCRN.canvasH& * SCRN.zoom!)) + lf
    ' HIST <current> <count>: the undo history position (Ctrl+Z / Ctrl+Y move current)
    d = d + "HIST" + DOCK_n$(HISTORY.current%) + DOCK_n$(HISTORY.count%) + lf
    ' TXTED <text data idx> <cursorPos> <charCount> <cursor x> <cursor y> <TDF font at the cursor> [text]: the text being edited
    IF TEXT.ACTIVE THEN
        DIM dkTd AS INTEGER, dkTx AS STRING, dkTi AS INTEGER, dkTf AS INTEGER
        dkTd = TEXT_get_active_text_data_idx%
        IF dkTd >= 1 THEN
            dkTx = ""
            FOR dkTi = 0 TO TEXT_LAYER_DATA(dkTd).charCount - 1
                dkTx = dkTx + TL_CHAR(dkTd, dkTi)
            NEXT dkTi
            dkTf = TEXT_LAYER_DATA(dkTd).cursorPos - 1: IF dkTf < 0 THEN dkTf = 0
            dkTf = TL_FONT_IDX(dkTd, dkTf)
            IF dkTf >= 0 _ANDALSO dkTf < FONT_LIST_COUNT% THEN dkTf = -(FONT_LIST(dkTf).isTdfFont <> 0) ELSE dkTf = 0
            d = d + "TXTED" + DOCK_n$(dkTd) + DOCK_n$(TEXT_LAYER_DATA(dkTd).cursorPos) + DOCK_n$(TEXT_LAYER_DATA(dkTd).charCount) + DOCK_n$(TEXT.CURSOR_X) + DOCK_n$(TEXT.CURSOR_Y) + DOCK_n$(dkTf) + " [" + dkTx + "]" + lf
        END IF
    END IF
    ' SHAPEMOD <rect H div> <rect V div> <ellipse slices> <SS polygon sides>: the arrow-key shape modifiers
    d = d + "SHAPEMOD" + DOCK_n$(RECT_TOOL.H_DIVISIONS) + DOCK_n$(RECT_TOOL.V_DIVISIONS) + DOCK_n$(ELLIPSE_TOOL.SLICES) + DOCK_n$(SS_POLYGON.SIDES) + lf
    ' FLASH <the status flash message while it shows>
    IF TIMER < STATUS_FLASH_UNTIL# THEN d = d + "FLASH " + STATUS_FLASH_MSG$ + lf
    ' PCYC <running> <ranges> <FG index> <FG's range> <FG RRGGBB> then lo-hi:RRGGBB,... per range: palette color cycling
    d = d + "PCYC" + DOCK_n$(-(PCYC_running% <> 0)) + DOCK_n$(PCYC.COUNT%) + DOCK_n$(PAL_FG_IDX%) + DOCK_n$(PCYC_range_at%(PAL_FG_IDX%)) + " " + RIGHT$("00000" + HEX$(PAINT_COLOR~& AND &HFFFFFF~&), 6)
    DIM dkCr AS INTEGER, dkCi AS INTEGER
    FOR dkCr = 1 TO PCYC.COUNT%
        d = d + " " + _TRIM$(STR$(PCYC_R(dkCr).lo)) + "-" + _TRIM$(STR$(PCYC_R(dkCr).hi)) + ":"
        FOR dkCi = PCYC_R(dkCr).lo TO PCYC_R(dkCr).hi
            IF dkCi > PCYC_R(dkCr).lo THEN d = d + ","
            d = d + RIGHT$("00000" + HEX$(PAL(dkCi).value~& AND &HFFFFFF~&), 6)
        NEXT dkCi
    NEXT dkCr
    d = d + lf
    ' FILLADJ <active> <dither mode> <amount%> <offX> <offY> <tileW> <tileH> <rotation> <opacity> <D held>: Fill Adjust (F8)
    d = d + "FILLADJ" + DOCK_n$(-(FILL_ADJ.ACTIVE% <> 0)) + DOCK_n$(FILL_DITHER.mode) + DOCK_n$(INT(FILL_DITHER.amount * 100! + 0.5)) + DOCK_n$(FILL_DITHER.ox) + DOCK_n$(FILL_DITHER.oy) + DOCK_n$(INT(FILL_ADJ.TILE_W! + 0.5)) + DOCK_n$(INT(FILL_ADJ.TILE_H! + 0.5)) + DOCK_n$(INT(FILL_ADJ.ROTATION! + 0.5)) + DOCK_n$(PAINT_OPACITY%) + DOCK_n$(-(FILL_DITHER.dDown <> 0)) + lf
    ' GRADSEL <slot> <color stops> <its own dither mode> <its strength%> <custom image>: the drawer's gradient
    IF DRAWER.gradientSelected% >= 1 _ANDALSO DRAWER.gradientSelected% <= DRAWER_SLOT_COUNT THEN d = d + "GRADSEL" + DOCK_n$(DRAWER.gradientSelected%) + DOCK_n$(GRAD_DEFS(DRAWER.gradientSelected%).colorCount%) + DOCK_n$(GRAD_DEFS(DRAWER.gradientSelected%).ditherMode%) + DOCK_n$(INT(GRAD_DEFS(DRAWER.gradientSelected%).ditherStrength! * 100! + 0.5)) + DOCK_n$(-(DRAWER_GRADIENT_CUSTOM(DRAWER.gradientSelected%) <> 0)) + lf
    ' GRID <w> <h> <originX> <originY> <show> <adjusting>: the grid (the visual adjust: R-click its button)
    d = d + "GRID" + DOCK_n$(GRID.gridWidth%) + DOCK_n$(GRID.gridHeight%) + DOCK_n$(GRID.xPos%) + DOCK_n$(GRID.yPos%) + DOCK_n$(-(GRID.SHOW% <> 0)) + DOCK_n$(-(GRID_ADJ.active <> 0)) + lf
    ' CVORG <x> <y>: canvas px (0,0) in the viewport (no lightbox), as SCREEN_render places it
    d = d + "CVORG" + DOCK_n$((SCRN.w& - CLNG(SCRN.canvasW& * SCRN.zoom!)) \ 2 + SCRN.offsetX% + SCRN.panelShiftX%) + DOCK_n$((SCRN.h& - CLNG(SCRN.canvasH& * SCRN.zoom!)) \ 2 + SCRN.offsetY% + SCRN.panelShiftY%) + lf
    ' XFQ active mode then the transform quad TL TR BR BL (canvas px, rounded) - TOOLS/TRANSFORM
    d = d + "XFQ" + DOCK_n$(TRANSFORM.ACTIVE) + DOCK_n$(TRANSFORM.MODE)
    DIM xfq AS INTEGER
    FOR xfq = 0 TO 3: d = d + DOCK_n$(CINT(TRANSFORM_HX(xfq))) + DOCK_n$(CINT(TRANSFORM_HY(xfq))): NEXT xfq
    d = d + lf
    ' MOVE active transforming symbolChild(clip too) capturedLayer origX origY curX curY
    d = d + "MOVE" + DOCK_n$(MOVE.ACTIVE <> 0) + DOCK_n$(MOVE.TRANSFORMING <> 0) + DOCK_n$(MOVE.SYMBOL_CHILD <> 0) + DOCK_n$(MOVE.CAPTURED_LAYER) + DOCK_n$(MOVE.ORIGINAL_X) + DOCK_n$(MOVE.ORIGINAL_Y) + DOCK_n$(MOVE.CURRENT_X) + DOCK_n$(MOVE.CURRENT_Y) + lf
    ' MARQ <active> <user-created> <x> <y> <w> <h> <a selection is live>
    d = d + "MARQ" + DOCK_n$(MARQUEE.ACTIVE <> 0) + DOCK_n$(MARQUEE.USER_CREATED <> 0) + DOCK_n$(MARQUEE.BOX.x) + DOCK_n$(MARQUEE.BOX.y) + DOCK_n$(MARQUEE.BOX.w) + DOCK_n$(MARQUEE.BOX.h) + DOCK_n$(SELECTION_has_active% <> 0) + lf
    ' PALNAME x y w h: the palette dropdown (a horizontal strip: from its left edge to the strip's end)
    IF PALETTE_STRIP_VISIBLE% THEN
        IF PSG.vert THEN
            d = d + "PALNAME" + DOCK_n$(PSG.nx) + DOCK_n$(PSG.ny) + DOCK_n$(PSG.nw) + DOCK_n$(PSG.nh) + lf
        ELSE
            d = d + "PALNAME" + DOCK_n$(PSG.nx) + DOCK_n$(PSG.y) + DOCK_n$(PSG.nw + 4) + DOCK_n$(PSG.h) + lf
        END IF
    END IF
    IF POPUP_any_open% = 0 THEN POPUP_SHOWN_N = 0 ' (closed since the last redraw)
    FOR t = 0 TO POPUP_SHOWN_N - 1
        d = d + "POPUP " + POPUP_SHOWN_KIND(t) + DOCK_n$(POPUP_SHOWN_X(t)) + DOCK_n$(POPUP_SHOWN_Y(t)) + DOCK_n$(POPUP_SHOWN_W(t)) + DOCK_n$(POPUP_SHOWN_H(t)) + lf
    NEXT t
    ' POPK <name>...: the popups the registry says are open (GUI/POPUP-MENU), then
    ' "partial" / "tips" when they switch the fast redraw paths / tooltips off
    d = d + "POPK"
    FOR t = 1 TO POPUP_K_COUNT
        IF POPUP_k_open%(t) THEN d = d + " " + POPUP_k_name$(t)
    NEXT t
    IF POPUP_blocks_partial% THEN d = d + " partial"
    IF POPUP_tips_blocked% THEN d = d + " tips"
    d = d + lf
    ' CMDPAL searchLen results hover <the highlighted command>: a driver waits for its whole query
    ' to be in before Enter (typed keys are taken a frame at a time; a slow frame lags them)
    IF CMD_PALETTE.visible THEN
        d = d + "CMDPAL" + DOCK_n$(CMD_PALETTE.search_len) + DOCK_n$(CMD_PALETTE.result_count) + DOCK_n$(CMD_PALETTE.hover)
        IF CMD_PALETTE.hover >= 0 _ANDALSO CMD_PALETTE.hover < CMD_PALETTE.result_count THEN d = d + " " + RTRIM$(CMD_LIST(CMD_RESULTS(CMD_PALETTE.hover)).name)
        d = d + lf
    END IF
    IF MENU_BAR.openMenu% >= 0 THEN
        d = d + "MENU" + DOCK_n$(MENU_BAR.subX% - 1) + DOCK_n$(MENU_BAR.subY% - 1) + DOCK_n$(MENU_BAR.subW% + 2) + DOCK_n$(MENU_BAR.subH% + 2) + lf
        ' MENUI <action id>...: the open menu's own rows in order (0 = a divider; flyout children left out)
        d = d + "MENUI"
        FOR t = 0 TO MENU_ITEM_COUNT% - 1
            IF MENU_ITEMS(t).parentIdx = MENU_BAR.openMenu% _ANDALSO MENU_ITEMS(t).subParent < 0 THEN d = d + DOCK_n$(_IIF(MENU_ITEMS(t).isDivider, 0, MENU_ITEMS(t).actionId))
        NEXT t
        d = d + lf
    END IF
    ' PSURF <id> <on> <k> <vx> <vy> <vw> <vh> <uw> <uh> <ready>: a docked panel at its own Scale (GUI/PANEL-SURFACE)
    FOR t = 1 TO PSURF_N
        IF PSURF_on%(t) THEN d = d + "PSURF" + DOCK_n$(t) + " -1 " + CONFIG_half_txt$(PSURF_kf!(t)) + DOCK_n$(PSURF(t).vx) + DOCK_n$(PSURF(t).vy) + DOCK_n$(PSURF(t).vw) + DOCK_n$(PSURF(t).vh) + DOCK_n$(PSURF(t).uw) + DOCK_n$(PSURF(t).uh) + DOCK_n$(PSURF(t).ready) + lf
        ' PSURFP <id> <ux> <uy>: the pointer in its units
        IF PSURF_on%(t) THEN d = d + "PSURFP" + DOCK_n$(t) + DOCK_n$(PSURF_mx%(t, MOUSE.RAW_X%)) + DOCK_n$(PSURF_my%(t, MOUSE.RAW_Y%)) + lf
    NEXT t
    ' PTR <rawX> <rawY> <winX> <winY>: the pointer, viewport and window px
    d = d + "PTR" + DOCK_n$(MOUSE.RAW_X%) + DOCK_n$(MOUSE.RAW_Y%) + DOCK_n$(MOUSE.WIN_X%) + DOCK_n$(MOUSE.WIN_Y%) + lf
    ' ORGW <widget> <x> <y> <w> <h>: the organizer's widgets as drawn, viewport px;
    ' DRWB <x> <y> <w> <h>: the drawer's first shown bin, viewport px; DRWAT
    ' <slot>: the bin under the pointer (0 none) - the toolbox family's own Scale
    IF DOCK_live%(DP_ORGANIZER) THEN
        FOR t = 0 TO ORG_WIDGET_COUNT - 1
            IF ORG_WIDGETS(t).w% > 0 THEN
                dqx = ORG_WIDGETS(t).x%: dqy = ORG_WIDGETS(t).y%: dqw = ORG_WIDGETS(t).w%: dqh = ORG_WIDGETS(t).h%
                PSURF_rect_to_view DP_ORGANIZER, dqx, dqy, dqw, dqh
                d = d + "ORGW" + DOCK_n$(t) + DOCK_n$(dqx) + DOCK_n$(dqy) + DOCK_n$(dqw) + DOCK_n$(dqh) + lf
            END IF
        NEXT t
    END IF
    IF DOCK_live%(DP_DRAWER) _ANDALSO DRAWER.visible% THEN
        DRAWER_layout dq(1), dq(2), dq(3), dq(4), dq(5), dq(6), dq(7), dq(8), dq(9), dq(10), dq(11), dq(12), dq(13), dq(14), dq(15), dq(16)
        dqx = dq(1): dqy = dq(2): dqw = dq(3): dqh = dq(4)
        PSURF_rect_to_view DP_DRAWER, dqx, dqy, dqw, dqh
        d = d + "DRWB" + DOCK_n$(dqx) + DOCK_n$(dqy) + DOCK_n$(dqw) + DOCK_n$(dqh) + lf
        d = d + "DRWAT" + DOCK_n$(DRAWER_slot_at%(MOUSE.RAW_X%, MOUSE.RAW_Y%)) + lf
    END IF
    ' BARHOVER <bar> <hovered entry>: the edit / advanced bar's lit button (-1 none)
    d = d + "BARHOVER editbar" + DOCK_n$(EDIT_BAR.hoverIndex%) + lf + "BARHOVER advbar" + DOCK_n$(ADV_BAR.hoverIndex%) + lf
    ' BRM <maximized> <restoreW> <restoreH> <dragging> <resizing>: the Browser's window state
    d = d + "BRM" + DOCK_n$(BROWSER.maximized%) + DOCK_n$(BROWSER.restoreW%) + DOCK_n$(BROWSER.restoreH%) + DOCK_n$(BROWSER.dragging%) + DOCK_n$(BROWSER.resizing%) + lf
    ' WSA <active workspace id> (default = none)
    d = d + "WSA " + _IIF(WS_ACTIVE <> 0, WS_ACTIVE_ID, "default") + lf
    ' panel state in workspaces: on, saves made, a few live values (GUI/WORKSPACE-APPLY)
    d = d + "WSPN " + DOCK_n0$(ABS(WS_PANELS_ON <> 0)) + " " + DOCK_n0$(WS_POLL_SAVES) + " drawerCols " + DOCK_n0$(CFG.DRAWER_BIN_COLS%) + " editbarScale " + CONFIG_half_txt$(CFG.EDIT_BAR_SCALE!)
    d = d + " palRows " + DOCK_n0$(CFG.PALETTE_MAX_ROWS%) + " palPerRow " + DOCK_n0$(CFG.PALETTE_MAX_CHIPS_PER_ROW%) + " chipH " + DOCK_n0$(CFG.PALETTE_CHIP_HEIGHT%) + " chipW " + DOCK_n0$(CFG.PALETTE_CHIP_WIDTH%)
    d = d + " previewZoom " + _TRIM$(STR$(PREVIEW.zoom!)) + " swatchCols " + DOCK_n0$(CFG.SWATCHES_COLS%) + lf
    ' the colour strip (viewport px y, h, all fit, its size keys) and its size menu: root box, the row whose submenu shows, its box
    ' (... then edge 0 bottom / 1 top / 2 left / 3 right, x, w, shown)
    d = d + PICKER_LOUPE_dump$
    d = d + "PSTRIP " + DOCK_n0$(PSG.y) + " " + DOCK_n0$(PSG.h) + " " + DOCK_n0$(ABS(PALETTE_STRIP_ALL_FIT% <> 0))
    d = d + " " + DOCK_n0$(CFG.PALETTE_MAX_ROWS%) + " " + DOCK_n0$(CFG.PALETTE_MAX_CHIPS_PER_ROW%) + " " + DOCK_n0$(CFG.PALETTE_CHIP_HEIGHT%) + " " + DOCK_n0$(CFG.PALETTE_CHIP_WIDTH%)
    d = d + " " + DOCK_n0$(PSG.edge) + " " + DOCK_n0$(PSG.x) + " " + DOCK_n0$(PSG.w) + " " + DOCK_n0$(ABS(PSG.shown <> 0)) + lf
    ' PSTRIPG: its chip grid (first chip x y, cell w h, per line, lines, scroll, side strip) + scroll buttons
    d = d + "PSTRIPG" + DOCK_n$(PSG.cx0) + DOCK_n$(PSG.cy0) + DOCK_n$(PSG.sw + 1) + DOCK_n$(PSG.sh + 1) + DOCK_n$(PSG.perLine) + DOCK_n$(PSG.lines) + DOCK_n$(PALETTE_STRIP_SCROLL_OFFSET%) + DOCK_n$(-(PSG.vert <> 0))
    d = d + DOCK_n$(PSG.a1x) + DOCK_n$(PSG.a1y) + DOCK_n$(PSG.a1w) + DOCK_n$(PSG.a1h) + DOCK_n$(PSG.a2x) + DOCK_n$(PSG.a2y) + DOCK_n$(PSG.a2w) + DOCK_n$(PSG.a2h) + DOCK_n$(-(PSG.allFit <> 0)) + lf
    IF PSM.isOpen THEN d = d + "PSM " + DOCK_n0$(PSM.rx) + " " + DOCK_n0$(PSM.ry) + " " + DOCK_n0$(PSM.rw) + " " + DOCK_n0$(PSM.subRow) + " " + DOCK_n0$(PSM.sbX) + " " + DOCK_n0$(PSM.sbY) + " " + DOCK_n0$(PSM.sbW) + " " + DOCK_n0$(PSM.sbN) + lf
    IF PSM.isOpen THEN d = d + "PSMN " + DOCK_n0$(PSM_ROOT_N) + " " + DOCK_n0$(PSM.rHover) + lf ' root rows, the hovered one
    ' F11: UIALL <hidden by F11> <tbed open> then each chrome element NAME=0/1 (WS_EL_*), live
    DIM uiEl AS INTEGER
    d = d + "UIALL " + DOCK_n0$(ABS(UIALL_HIDDEN <> 0)) + " " + DOCK_n0$(ABS(TBED.visible <> 0))
    FOR uiEl = 1 TO WS_EL_COUNT
        d = d + " " + WS_EL_NAME(uiEl) + "=" + DOCK_n0$(ABS(WS_el_get%(uiEl) <> 0))
    NEXT uiEl
    d = d + lf
    ' MBAR <open root> <hovered root> <open sounds from hovering roots>, then ROOT <i> <x> <w> <label>
    d = d + "MBAR" + DOCK_n$(MENU_BAR.openMenu%) + DOCK_n$(MENU_BAR.hoverRoot%) + DOCK_n$(MENU_ROOT_SOUNDS) + lf
    FOR t = 0 TO MENU_ROOT_COUNT% - 1
        d = d + "ROOT" + DOCK_n$(t) + DOCK_n$(MENU_ROOT_X(t)) + DOCK_n$(MENU_ROOT_W(t)) + " " + RTRIM$(MENU_ROOT_LABEL(t)) + lf
    NEXT t
    d = d + ANIM_VIEW_dump$ + ANIMP_dump$ + ANIM_LB_dump$ + ANIM_LF_dump$ + ANIM_XS_dump$ + ANIM_LK_dump$ + ANIM_LH_dump$ + ANIM_TG_dump$ + ANIM_NT_dump$ + ANIM_SND_dump$ + AB_dump$ + AB_bin_dump$ + CLIP_dump$ + LL_dump$ + ANIM_XW_dump$ + ANIMPL_dump$ + DOCK_anim_pixels$
    d = d + DOCK_dump_state$
    IF d = DOCK_DUMP_LAST THEN EXIT SUB
    DOCK_DUMP_LAST = d
    DOCK_DUMP_SEQ = DOCK_DUMP_SEQ + 1
    f = FREEFILE
    OPEN DOCK_DUMP_PATH + ".tmp" FOR OUTPUT AS #f
    PRINT #f, "SEQ" + DOCK_n$(DOCK_DUMP_SEQ)
    PRINT #f, d;
    CLOSE #f
    IF _FILEEXISTS(DOCK_DUMP_PATH) THEN KILL DOCK_DUMP_PATH
    NAME DOCK_DUMP_PATH + ".tmp" AS DOCK_DUMP_PATH
END SUB


''
' The QA dump's pixel-scanning animation lines - ANIMC (a CRC per frame of every
' moving layer) and the Move Brush lines (MVBB / MVBA / MVBK scan every frame of
' the current layer) - cost too much to rebuild every frame on a long sheet, so
' they are rebuilt only when their inputs change: the scene was re-rendered
' (QA_SCENE_GEN), the history, the layers, the frames, the brush, the Move
' Brush's state.
FUNCTION DOCK_anim_pixels$ ()
    STATIC sig AS STRING, cached AS STRING
    DIM s AS STRING, j AS INTEGER
    s = STR$(QA_SCENE_GEN) + STR$(HISTORY.current) + STR$(HISTORY.count) + STR$(CURRENT_LAYER%) + STR$(LAYER_COUNT%)
    s = s + STR$(ANIM.active) + STR$(ANIM.count) + STR$(ANIM.current) + STR$(ANIM.frameW) + STR$(ANIM.frameH) + STR$(ANIM_SEL_count%)
    s = s + STR$(MVB.active) + STR$(MVB.dragging) + STR$(MVB.hasPath) + STR$(MVB.fromF) + STR$(MVB.rx0) + STR$(MVB.ry0) + STR$(MVB.rx1) + STR$(MVB.ry1)
    s = s + STR$(MVB.nPts) + STR$(MVB.dur) + STR$(MVB.playing) + STR$(MVB_PATH) + STR$(MVB_EASE) + STR$(MVB_EVERY) + STR$(MVB_COUNT)
    FOR j = 1 TO MVB_BOXES: s = s + STR$(MVB_V(j)): NEXT j
    s = s + STR$(AB.cur) + STR$(AB.n) + STR$(AB.w) + STR$(AB.h) + STR$(CUSTOM_BRUSH.ACTIVE%) + STR$(CUSTOM_BRUSH.WIDTH%) + STR$(CUSTOM_BRUSH.HEIGHT%) + STR$(PAINT_COLOR~&)
    IF s <> sig THEN sig = s: cached = ANIM_OPS_dump$ + MVB_dump$
    DOCK_anim_pixels$ = cached
END FUNCTION

''
' QA dump lines for panel state the tests read (not layout). Viewport px.
'   TIP    active source idx            (TOOLTIP_SRC_* - the tooltip showing, or hovered)
'   CURSOR id flip                      (POINTER.CURSOR_ID - the cursor over the pointer)
'   BARS   ebScroll ebContentH abScroll abContentH
'   CMAP   scrollY maxScroll rows cellH rowStep gridY panelY2 indicatorH hoverIdx
'   LPANEL scrollOffset current
'   LAYER  idx z parent type collapsed visible opacity   (one per live layer)
FUNCTION DOCK_dump_state$ ()
    DIM d AS STRING, lf AS STRING, i AS INTEGER
    lf = CHR$(10)
    d = "TIP" + DOCK_n$(TOOLTIP.ACTIVE <> 0) + DOCK_n$(TOOLTIP.HOVER_SOURCE) + DOCK_n$(TOOLTIP.HOVER_BTN_IDX) + lf
    d = d + "CURSOR" + DOCK_n$(POINTER.CURSOR_ID) + DOCK_n$(POINTER.CURSOR_FLIP) + lf
    d = d + "BARS" + DOCK_n$(EDIT_BAR.scrollOffset%) + DOCK_n$(EDIT_BAR.contentH%) + DOCK_n$(ADV_BAR.scrollOffset%) + DOCK_n$(ADV_BAR.contentH%) + lf
    d = d + "CMAP" + DOCK_n$(CHARMAP.scrollY%) + DOCK_n$(CHARMAP_max_scroll_y%) + DOCK_n$(CHARMAP_row_count%) + DOCK_n$(CHARMAP_cell_h_effective%)
    d = d + DOCK_n$(CHARMAP_cell_h_effective% + CHARMAP_cell_padding_effective%) + DOCK_n$(CHARMAP.gridY%) + DOCK_n$(CHARMAP.panelY2%) + DOCK_n$(CHARMAP_PAGE_INDICATOR_H) + DOCK_n$(CHARMAP.hoverIdx%) + lf
    ' CMAPC cols cellW pad panelW(units) inRow: the grid's columns (a dock row: as many as fit)
    d = d + "CMAPC" + DOCK_n$(CHARMAP_cells_per_row%) + DOCK_n$(CHARMAP_cell_w_effective%) + DOCK_n$(CHARMAP_cell_padding_effective%) + DOCK_n$(CHARMAP.panelW%) + DOCK_n$(ABS(CHARMAP_in_row% <> 0)) + lf
    ' CMAPV <x> <y> <w> <h>: cell 65 ("A") as drawn, viewport px (GUI/PANEL-SURFACE)
    IF CHARMAP_cells_per_row% > 0 THEN
        DIM cvx AS INTEGER, cvy AS INTEGER, cvw AS INTEGER, cvh AS INTEGER
        cvw = CHARMAP_cell_w_effective%: cvh = CHARMAP_cell_h_effective%
        cvx = CHARMAP.gridX% + (65 MOD CHARMAP_cells_per_row%) * (cvw + CHARMAP_cell_padding_effective%)
        cvy = CHARMAP.gridY% + (65 \ CHARMAP_cells_per_row%) * (cvh + CHARMAP_cell_padding_effective%) - CHARMAP.scrollY%
        PSURF_rect_to_view DP_CHARMAP, cvx, cvy, cvw, cvh
        d = d + "CMAPV" + DOCK_n$(cvx) + DOCK_n$(cvy) + DOCK_n$(cvw) + DOCK_n$(cvh) + lf
    END IF
    IF DRW_RECT_W > 0 THEN
        DIM q1 AS INTEGER, q2 AS INTEGER, q3 AS INTEGER, q4 AS INTEGER, q5 AS INTEGER, q6 AS INTEGER, q7 AS INTEGER, q8 AS INTEGER
        DIM q9 AS INTEGER, q10 AS INTEGER, q11 AS INTEGER, q12 AS INTEGER, q13 AS INTEGER, q14 AS INTEGER, q15 AS INTEGER, q16 AS INTEGER
        DRAWER_layout q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14, q15, q16
        ' cols, bin rows in all, rows showing, palette y + h, drawer bottom
        d = d + "DRAWERL" + DOCK_n$(DRAWER_COLS) + DOCK_n$((DRAWER_SLOT_COUNT + DRAWER_COLS - 1) \ _MAX(1, DRAWER_COLS)) + DOCK_n$(DRAWER_VIS_ROWS)
        d = d + DOCK_n$(q8) + DOCK_n$(q10) + DOCK_n$(DRAWER.panelY2%)
        d = d + DOCK_n$(q1) + DOCK_n$(q2) + DOCK_n$(q3) + DOCK_n$(q4) + DOCK_n$(q5) + DOCK_n$(q6) + DOCK_n$(DRAWER.paintMode%) + DOCK_n$(DRAWER.gradientSelected%) + lf ' + the first bin x y, bin w h, gaps x y, paint mode, gradient picked
        ' slots per mode, the last used brush / pattern / gradient slot, that brush's w h
        DIM lastB AS INTEGER
        lastB = DRAWER_last_used_slot%(DRAWER_MODE_BRUSH)
        d = d + "DRAWERS" + DOCK_n$(DRAWER_SLOT_COUNT) + DOCK_n$(lastB) + DOCK_n$(DRAWER_last_used_slot%(DRAWER_MODE_PATTERN)) + DOCK_n$(DRAWER_last_used_slot%(DRAWER_MODE_GRADIENT))
        IF lastB > 0 THEN d = d + DOCK_n$(DRAWER_BRUSH_SLOTS(lastB).W) + DOCK_n$(DRAWER_BRUSH_SLOTS(lastB).H) + lf ELSE d = d + " 0 0" + lf
    END IF
    d = d + "DRAWERR" + DOCK_n$(DRAWER_ROW0) + DOCK_n$(DRAWER.mode%) + lf ' first bin row showing (Shift+wheel scroll), mode
    ' Bin Quick Look: showing, slot, mode, source w h, the brush's drawn w h, the pane's content w h
    d = d + "PVQL" + DOCK_n$(-(PREVIEW.binQuickLookActive% <> 0)) + DOCK_n$(PREVIEW.binQuickLookSlot%) + DOCK_n$(PREVIEW.binQuickLookMode%)
    IF PREVIEW.binQuickLookImg& < -1 THEN
        d = d + DOCK_n$(_WIDTH(PREVIEW.binQuickLookImg&)) + DOCK_n$(_HEIGHT(PREVIEW.binQuickLookImg&))
    ELSE
        d = d + " 0 0"
    END IF
    d = d + DOCK_n$(PREVIEW.binQuickLookDrawW%) + DOCK_n$(PREVIEW.binQuickLookDrawH%) + lf
    ' BROWSERF pathActive searchFocus focusPane titleBarH pathBarH toolBarH searchLen [search text]
    ' (FD px: the path field / search box's typing focus and where they are; 1 = on)
    IF PENP.initialized% THEN ' (native px; PENPC ctl x0 x1 y trackX0 trackX1)
        d = d + "PENPL" + DOCK_n$(ABS(PENP.inRow% <> 0)) + DOCK_n$(PENP.panelW%) + DOCK_n$(PENP.panelH%) + DOCK_n$(PENP.gx0%) + DOCK_n$(PENP.gx1%) + DOCK_n$(PENP.yGraph%) + DOCK_n$(PENP.graphH%) + lf
        FOR i = 1 TO PENP_CTL_COUNT
            d = d + "PENPC" + DOCK_n$(i) + DOCK_n$(PENP_ctlX0(i)) + DOCK_n$(PENP_ctlX1(i)) + DOCK_n$(PENP_ctlY(i)) + DOCK_n$(PENP_ctlTX0(i)) + DOCK_n$(PENP_ctlTX1(i)) + lf
        NEXT i
        ' PENPT tab tabH hint x0 y0 x1 y1 speedGraph x0 y0 x1 y1 readout x y x1 subX pad (Pen Control tabs)
        d = d + "PENPT" + DOCK_n$(PENP_tab%) + DOCK_n$(PENP.tabH%) + DOCK_n$(PENP.hbx0%) + DOCK_n$(PENP.hby0%) + DOCK_n$(PENP.hbx1%) + DOCK_n$(PENP.hby1%)
        d = d + DOCK_n$(PENP.sgx0%) + DOCK_n$(PENP.sgy0%) + DOCK_n$(PENP.sgx1%) + DOCK_n$(PENP.sgy1%) + DOCK_n$(PENP.rdX%) + DOCK_n$(PENP.rdY%) + DOCK_n$(PENP.rdX1%) + DOCK_n$(PENP.subX%) + DOCK_n$(FPANEL.pad%) + lf
    END IF
    ' the stacked preview (docked in a side column): BROWSERV stack placesH previewY previewH contentY contentH
    d = d + "BROWSERV " + DOCK_n0$(ABS(FD_STATE.pvStack <> 0)) + DOCK_n$(FD_STATE.placesH) + DOCK_n$(FD_STATE.previewY) + DOCK_n$(FD_STATE.previewH) + DOCK_n$(FD_STATE.contentY) + DOCK_n$(FD_STATE.contentH) + lf
    d = d + "BROWSERF " + DOCK_n0$(ABS(FD_STATE.pathInputActive <> 0)) + " " + DOCK_n0$(ABS(FD_STATE.searchFocus <> 0)) + DOCK_n$(FD_STATE.focusPane)
    d = d + DOCK_n$(FD_STATE.titleBarH) + DOCK_n$(FD_STATE.pathBarH) + DOCK_n$(FD_STATE.toolBarH) + DOCK_n$(FD_STATE.searchLen) + " " + LEFT$(FD_STATE.searchText, FD_STATE.searchLen) + lf
    ' browser panes (FD px): places w, list x + w, preview x + w, preview on, dialog w, minimums
    d = d + "BROWSERL" + DOCK_n$(FD_STATE.placesW) + DOCK_n$(FD_STATE.contentX) + DOCK_n$(FD_STATE.contentW)
    d = d + DOCK_n$(FD_STATE.previewX) + DOCK_n$(FD_STATE.previewW) + DOCK_n$(FD_CFG.showPreview <> 0) + DOCK_n$(FD_STATE.dialogW)
    d = d + DOCK_n$(FD_STATE.placesMinW) + DOCK_n$(FD_STATE.previewMinW)
    ' + the preview toggle's centre (the 5th toolbar button, FD_INPUT_toolbar_click), the places' drag floor
    DIM fdIsc AS INTEGER, fdBtnW AS INTEGER
    fdIsc = FD_CFG.iconScale: IF fdIsc < 1 THEN fdIsc = 2
    fdBtnW = 11 * fdIsc: IF FD_ICONS_has_png%(FD_ICON_TB_LIST) THEN fdBtnW = FD_iconW(FD_ICON_TB_LIST) * fdIsc
    fdBtnW = fdBtnW + 6
    d = d + DOCK_n$(FD_PADDING + fdBtnW * 4 + fdBtnW \ 2) + DOCK_n$(FD_STATE.titleBarH + FD_STATE.pathBarH + FD_STATE.toolBarH \ 2)
    d = d + DOCK_n$(FD_places_tiny_w%) + lf ' (+ the places pane's dragged floor: an icon and a letter)
    ' BROWSERS <visible> <selected> <lastClick> <rowH> <listTop> <scroll> <count> <view> <done> <opens> <file drag armed/active> <document file>
    ' (FD px; list / details rows: row i's centre is listTop + i * rowH - scroll + rowH \ 2)
    DIM fdTop AS INTEGER
    fdTop = FD_STATE.contentY: IF FD_CFG.viewMode = FD_VIEW_DETAILS THEN fdTop = fdTop + FD_STATE.columnHeaderH
    d = d + "BROWSERS" + DOCK_n$(BROWSER.visible% <> 0) + DOCK_n$(FD_STATE.selectedIndex) + DOCK_n$(FD_STATE.lastClickIndex)
    d = d + DOCK_n$(FD_STATE.rowHeight) + DOCK_n$(fdTop) + DOCK_n$(FD_STATE.scrollOffset) + DOCK_n$(FD_STATE.visibleCount)
    d = d + DOCK_n$(FD_CFG.viewMode) + DOCK_n$(FD_STATE.done <> 0) + DOCK_n$(BROWSER.opens) + DOCK_n$((BROWSER.fileDragStarted% <> 0) + 2 * (BROWSER.fileDragActive% <> 0)) + " " + _IIF(CURRENT_DRW_FILENAME$ <> "", CURRENT_DRW_FILENAME$, CURRENT_FILENAME$) + lf
    ' BROWSERSC <maxScroll> <contentW> <contentH> <thumb cell w> <thumb cell h> (FD px: the list's scroll range -
    ' LONG, a long one-column thumbnail list passes 32767)
    d = d + "BROWSERSC" + DOCK_n$(FD_STATE.maxScroll) + DOCK_n$(FD_STATE.contentW) + DOCK_n$(FD_STATE.contentH)
    ' + <thumbnails loaded> <the last item's thumbnail loaded> (FD-THUMB; BROWSER_tick loads them pointer or not)
    DIM fdLoaded AS LONG, fdLastOk AS INTEGER, fdI AS LONG
    FOR fdI = 0 TO FD_STATE.entryCount - 1
        IF FD_entries(fdI).thumbState = FD_THUMB_LOADED THEN fdLoaded = fdLoaded + 1
    NEXT fdI
    IF FD_STATE.visibleCount > 0 THEN fdLastOk = (FD_entries(FD_filtered(FD_STATE.visibleCount - 1)).thumbState = FD_THUMB_LOADED)
    d = d + DOCK_n$(FD_CFG.thumbSize + FD_PADDING * 2) + DOCK_n$(FD_CFG.thumbSize + FD_PADDING * 2 + FD_STATE.rowHeight)
    d = d + DOCK_n$(fdLoaded) + DOCK_n$(fdLastOk <> 0) + lf
    ' BROWSERDIR <back depth> <forward depth> <folder shown> (the nav history the thumb buttons walk)
    d = d + "BROWSERDIR" + DOCK_n$(FD_STATE.navBackTop + 1) + DOCK_n$(FD_STATE.navFwdTop + 1) + " " + FD_PLAT_trim_cstr$(FD_STATE.currentPath) + lf
    ' BROWSERPV <frames> <showing> <playing> <seeking> <box x y size> <track x w> <picture w h> <selected name>
    ' (the preview pane's animation, FD px - FILE_DIALOG FD_PV_*; picture = the still preview image)
    DIM pvName AS STRING, pvW AS LONG, pvH AS LONG
    IF FD_STATE.selectedIndex >= 0 _ANDALSO FD_STATE.selectedIndex < FD_STATE.visibleCount THEN pvName = FD_PLAT_trim_cstr$(FD_entries(FD_filtered(FD_STATE.selectedIndex)).fileName)
    IF FD_STATE.previewImgHandle < -1 THEN pvW = _WIDTH(FD_STATE.previewImgHandle): pvH = _HEIGHT(FD_STATE.previewImgHandle)
    d = d + "BROWSERPV" + DOCK_n$(FD_STATE.pvN) + DOCK_n$(FD_STATE.pvK) + DOCK_n$(FD_STATE.pvPlay <> 0) + DOCK_n$(FD_STATE.pvSeek <> 0)
    d = d + DOCK_n$(FD_STATE.pvBtnX) + DOCK_n$(FD_STATE.pvBtnY) + DOCK_n$(FD_STATE.pvBtnS) + DOCK_n$(FD_STATE.pvTrkX) + DOCK_n$(FD_STATE.pvTrkW)
    d = d + DOCK_n$(pvW) + DOCK_n$(pvH) + " " + pvName + lf
    d = d + WZ_dump$ + lf ' floating windows front to back (GUI/WINZ)
    d = d + WF_dump$ ' workflow buttons (GUI/WORKFLOW)
    d = d + THEMEED_dump$ ' Theme Edit's elements tree + pick (CFG/THEME-EDIT)
    d = d + "DMENU" + DOCK_n$(DOCK_UI.menuOpen <> 0) + DOCK_n$(DOCK_UI.menuPanel) + DOCK_n$(DOCK_UI.hoverSlot) + DOCK_n$(DOCK_UI.menuX) + DOCK_n$(DOCK_UI.menuY) + DOCK_n$(DOCK_UI.menuW) + DOCK_n$(DOCK_UI.menuN) + lf
    ' DMENUR <row> <value> <y> <h> <checked>: each row of the open menu (a divider's value is -1)
    IF DOCK_UI.menuOpen THEN
        DIM mr AS INTEGER, my AS INTEGER, mh AS INTEGER
        DOCK_menu_build DOCK_UI.menuPanel
        my = DOCK_UI.menuY + 2
        FOR mr = 0 TO DOCK_UI.menuN - 1
            IF (POPUP_MENU_FLAGS(mr) AND POPUP_MENU_FLAG_DIVIDER) <> 0 THEN mh = MENU_DIVIDER_HEIGHT ELSE mh = DOCK_MENU_ITEM_H
            d = d + "DMENUR" + DOCK_n$(mr) + DOCK_n$(POPUP_MENU_VALUES(mr)) + DOCK_n$(my) + DOCK_n$(mh) + DOCK_n$((POPUP_MENU_FLAGS(mr) AND POPUP_MENU_FLAG_CHECKED) <> 0) + lf
            my = my + mh
        NEXT mr
    END IF
    d = d + "PAINT" + DOCK_n$(PAINT_OPACITY%) + DOCK_n$(CURRENT_TOOL%) + lf ' paint opacity %, tool
    ' KMAP <fg chip> <bg chip> <custom brush> <brush size> <brush selector armed> <loop mode> <binds> (keymaps, QA/tests/deluxepaint-keymap.sh)
    d = d + "KMAP" + DOCK_n$(PAL_FG_IDX%) + DOCK_n$(PAL_BG_IDX%) + DOCK_n$(CUSTOM_BRUSH_is_active% <> 0) + DOCK_n$(BRUSH_SIZE.CURRENT) + DOCK_n$(AB_SELECTOR_ON <> 0) + DOCK_n$(ANIM.loopMode) + DOCK_n$(INPUT_BIND_COUNT) + lf
    d = d + "LPANEL" + DOCK_n$(LAYER_PANEL.scrollOffset%) + DOCK_n$(CURRENT_LAYER%) + DOCK_n$(MULTI_SELECT_COUNT) + lf
    ' LPHIT <slot>: the layer row under the pointer (0 none); LPGEO <list top> <row> <list bottom>: the list's offsets
    ' from the panel's top / bottom (the header / button bar, with the layer bar on its side) and a row, viewport px
    d = d + "LPHIT" + DOCK_n$(LAYER_PANEL_get_row_slot%(MOUSE.RAW_X%, MOUSE.RAW_Y%)) + lf
    d = d + "LPGEO" + DOCK_n$(PSURF_v%(DP_LAYERS, LAYER_LIST_top_off%)) + DOCK_n$(PSURF_v%(DP_LAYERS, LAYER_ROW_H%)) + DOCK_n$(PSURF_v%(DP_LAYERS, LAYER_LIST_bot_off%)) + lf
    ' LPBAR <where 0/1/2> <y> <h> <blend x> <w> <eye x> <lock x> <slider x> <w> <blend mode> <opacity> <any visible> <others locked> <hot>
    ' (the layer bar, viewport px; the current layer's blend mode / opacity 0-255)
    DIM lbY AS INTEGER, lbBX AS INTEGER, lbBW AS INTEGER, lbEX AS INTEGER, lbLX AS INTEGER, lbSX AS INTEGER, lbSW AS INTEGER
    DIM lbH AS INTEGER, lbT AS INTEGER, lbW AS INTEGER, lbM AS INTEGER, lbO AS INTEGER
    LAYER_BAR_layout lbY, lbBX, lbBW, lbEX, lbLX, lbSX, lbSW
    lbH = LAYER_BAR_H: PSURF_rect_to_view DP_LAYERS, lbBX, lbY, lbBW, lbH
    lbT = 0: lbW = 11: lbH = LAYER_BAR_H: PSURF_rect_to_view DP_LAYERS, lbEX, lbT, lbW, lbH
    lbT = 0: lbW = 11: lbH = LAYER_BAR_H: PSURF_rect_to_view DP_LAYERS, lbLX, lbT, lbW, lbH
    lbT = 0: lbH = LAYER_BAR_H: PSURF_rect_to_view DP_LAYERS, lbSX, lbT, lbSW, lbH
    lbM = -9: lbO = -1
    IF CURRENT_LAYER% >= 1 _ANDALSO CURRENT_LAYER% <= MAX_LAYERS THEN lbM = LAYERS(CURRENT_LAYER%).blendMode%: lbO = LAYERS(CURRENT_LAYER%).opacity%
    d = d + "LPBAR" + DOCK_n$(CFG.LAYER_PANEL_BAR%) + DOCK_n$(lbY) + DOCK_n$(PSURF_v%(DP_LAYERS, LAYER_BAR_H)) + DOCK_n$(lbBX) + DOCK_n$(lbBW) + DOCK_n$(lbEX) + DOCK_n$(lbLX) + DOCK_n$(lbSX) + DOCK_n$(lbSW)
    d = d + DOCK_n$(lbM) + DOCK_n$(lbO) + DOCK_n$(LAYER_BAR_any_visible% <> 0) + DOCK_n$(LAYER_BAR_others_locked% <> 0) + DOCK_n$(LAYER_BAR_hot% <> 0) + lf
    ' LPBPOP <open> <x> <y> <n>; LPBPOPR <row> <value> <y> <h>: the blend popup (viewport px; a divider's value -1)
    d = d + "LPBPOP" + DOCK_n$(LAYER_PANEL.blendPopupOpen% <> 0) + DOCK_n$(LAYER_PANEL.blendPopupX%) + DOCK_n$(LAYER_PANEL.blendPopupY%) + lf
    IF LAYER_PANEL.blendPopupOpen% THEN
        DIM bpr AS INTEGER, bpy AS INTEGER, bph AS INTEGER, bpn AS INTEGER
        LAYER_PANEL_blend_popup_build LAYER_PANEL.blendPopupLayer%
        bpn = BLEND_MODE_COUNT + 1
        IF LAYER_PANEL.blendPopupLayer% >= 1 _ANDALSO LAYER_PANEL.blendPopupLayer% <= MAX_LAYERS THEN
            IF LAYERS(LAYER_PANEL.blendPopupLayer%).layerType% = LAYER_TYPE_GROUP THEN bpn = BLEND_MODE_COUNT + 3
        END IF
        bpy = LAYER_PANEL.blendPopupY% + 2
        FOR bpr = 0 TO bpn - 1
            IF (POPUP_MENU_FLAGS(bpr) AND POPUP_MENU_FLAG_DIVIDER) <> 0 THEN bph = MENU_DIVIDER_HEIGHT ELSE bph = 10
            d = d + "LPBPOPR" + DOCK_n$(bpr) + DOCK_n$(_IIF((POPUP_MENU_FLAGS(bpr) AND POPUP_MENU_FLAG_DIVIDER) <> 0, -1, POPUP_MENU_VALUES(bpr))) + DOCK_n$(bpy) + DOCK_n$(bph) + lf
            bpy = bpy + bph
        NEXT bpr
    END IF
    ' LPTHUMB <x> <size>: a top-level layer's thumbnail, its left edge and size (viewport px; size 0 = off)
    DIM lptX AS INTEGER, lptY AS INTEGER, lptW AS INTEGER, lptH AS INTEGER
    lptX = LAYER_PANEL.panelX1% + 24: lptY = 0: lptW = LAYER_THUMB_PX%: lptH = lptW
    PSURF_rect_to_view DP_LAYERS, lptX, lptY, lptW, lptH
    d = d + "LPTHUMB" + DOCK_n$(lptX) + DOCK_n$(lptW) + lf
    ' LPREC <x>: the record dots' centre x in the Layers panel (viewport px; 0 = none: not an animation / too narrow)
    DIM lprX AS INTEGER, lprY AS INTEGER, lprW AS INTEGER, lprH AS INTEGER
    lprX = 0
    IF ANIM.active <> 0 _ANDALSO ANIM.count > 1 _ANDALSO LAYER_PANEL_w% >= 80 THEN
        lprX = LAYER_PANEL.panelX1% + LAYER_PANEL_w% - 17 - LAYER_REC_DOT_W \ 2: lprY = 0: lprW = 1: lprH = 1
        PSURF_rect_to_view DP_LAYERS, lprX, lprY, lprW, lprH
    END IF
    d = d + "LPREC" + DOCK_n$(lprX) + lf
    ' LPSEL <active> <x> <y> <w> <h> <pixels> <layers>: the selection (canvas px; pixels = selected in its mask,
    ' else the box) and the layers whose thumbnails made it (LAYER_SEL_FROM, comma list, - none / forgotten)
    DIM lpsN AS LONG, lpsL AS STRING, lpsJ AS INTEGER, lpsM AS _MEM, lpsO AS _OFFSET
    lpsL = ""
    IF LAYER_SEL_holds% THEN
        FOR lpsJ = 1 TO MAX_LAYERS
            IF ASC(LAYER_SEL_FROM, lpsJ) THEN lpsL = lpsL + "," + _TRIM$(STR$(lpsJ))
        NEXT lpsJ
    END IF
    IF lpsL = "" THEN lpsL = "-" ELSE lpsL = MID$(lpsL, 2)
    lpsN = 0
    IF SELECTION_has_active% THEN
        IF MARQUEE.WAND_HAS_SELECTION _ANDALSO MARQUEE.SELECTION_MASK < -1 THEN
            lpsM = _MEMIMAGE(MARQUEE.SELECTION_MASK)
            IF _MEMEXISTS(lpsM) THEN
                FOR lpsO = lpsM.OFFSET + 3 TO lpsM.OFFSET + lpsM.SIZE - 1 STEP 4
                    IF _MEMGET(lpsM, lpsO, _UNSIGNED _BYTE) > 0 THEN lpsN = lpsN + 1
                NEXT lpsO
                _MEMFREE lpsM
            END IF
        ELSE
            lpsN = CLNG(MARQUEE.BOX.w) * MARQUEE.BOX.h
        END IF
    END IF
    d = d + "LPSEL" + DOCK_n$(SELECTION_has_active% <> 0) + DOCK_n$(MARQUEE.BOX.x) + DOCK_n$(MARQUEE.BOX.y) + DOCK_n$(MARQUEE.BOX.w) + DOCK_n$(MARQUEE.BOX.h) + DOCK_n$(lpsN) + " " + lpsL + lf
    ' LPMENU <open> <thumb> <x> <y> <w> <n>: the layer context menu (viewport px); LPMENUR <row> <value> <y> <h> <checked>
    d = d + "LPMENU" + DOCK_n$(LAYER_PANEL.ctxMenuOpen% <> 0) + DOCK_n$(LAYER_PANEL.ctxMenuThumb% <> 0) + DOCK_n$(LAYER_PANEL.ctxMenuX%) + DOCK_n$(LAYER_PANEL.ctxMenuY%) + DOCK_n$(LAYER_PANEL.ctxMenuW%) + DOCK_n$(LAYER_PANEL.ctxMenuItems%) + lf
    IF LAYER_PANEL.ctxMenuOpen% THEN
        DIM lmr AS INTEGER, lmy AS INTEGER, lmh AS INTEGER
        LAYER_PANEL_ctx_menu_build LAYER_PANEL.ctxMenuLayer%, LAYER_PANEL.ctxMenuItems%
        lmy = LAYER_PANEL.ctxMenuY% + 2
        FOR lmr = 0 TO LAYER_PANEL.ctxMenuItems% - 1
            IF (POPUP_MENU_FLAGS(lmr) AND POPUP_MENU_FLAG_DIVIDER) <> 0 THEN lmh = MENU_DIVIDER_HEIGHT ELSE lmh = LAYER_CTX_ITEM_H
            d = d + "LPMENUR" + DOCK_n$(lmr) + DOCK_n$(POPUP_MENU_VALUES(lmr)) + DOCK_n$(lmy) + DOCK_n$(lmh) + DOCK_n$((POPUP_MENU_FLAGS(lmr) AND POPUP_MENU_FLAG_CHECKED) <> 0) + lf
            lmy = lmy + lmh
        NEXT lmr
    END IF
    FOR i = 1 TO MAX_LAYERS
        IF LAYERS(i).imgHandle& <> 0 THEN
            d = d + "LAYER" + DOCK_n$(i) + DOCK_n$(LAYERS(i).zIndex%) + DOCK_n$(LAYERS(i).parentGroupIdx%) + DOCK_n$(LAYERS(i).layerType%)
            d = d + DOCK_n$(LAYERS(i).collapsed% <> 0) + DOCK_n$(LAYERS(i).visible% <> 0) + DOCK_n$(LAYERS(i).opacity%) + DOCK_n$(MULTI_SELECT_LAYERS(i) <> 0) + lf
        END IF
    NEXT i
    DOCK_dump_state$ = d
END FUNCTION


''
' Every frame (LOOP_end) while a QA dump is asked for: the state lines change
' on frames that skip the layout (a hover, a tooltip, a cursor change). The
' file is only rewritten when something changed.
SUB DOCK_dump_refresh ()
    IF LEN(DOCK_DUMP_PATH) = 0 _ORELSE DOCK_LAID_OUT = 0 THEN EXIT SUB
    WS_state_dump_check ' (a test asked for the whole live layout)
    DOCK_dump_write DOCK_L_BARY1, DOCK_L_DOCKY2
END SUB


''
' A modal dialog's line for QA (DOCK_DUMP_PATH + ".modal"): frames stop while a
' modal is up, so the dump file proper says nothing about it. "MODAL picker
' <scale> <mixer screen px>" / "MODAL fd <font> <icons> <Browser Scale>" (GJ-DIALOG-SCALE).
SUB DOCK_dump_modal (what AS STRING)
    IF LEN(DOCK_DUMP_PATH) = 0 THEN EXIT SUB
    DIM f AS INTEGER
    f = FREEFILE
    OPEN DOCK_DUMP_PATH + ".modal" FOR OUTPUT AS #f
    PRINT #f, what
    CLOSE #f
END SUB

FUNCTION DOCK_n$ (v AS LONG)
    DOCK_n$ = " " + _TRIM$(STR$(v))
END FUNCTION


FUNCTION DOCK_dump_tree$ ()
    DIM d AS STRING, r AS STRING, i AS INTEGER, ch AS STRING
    d = DOCK_describe$
    FOR i = 1 TO LEN(d)
        ch = MID$(d, i, 1)
        IF ch = CHR$(10) THEN
            IF i < LEN(d) THEN r = r + " ; "
        ELSE
            r = r + ch
        END IF
    NEXT i
    DOCK_dump_tree$ = r
END FUNCTION


''
' The screen row - one QB64_GJ_LIB/LAYOUT line: the left columns (outermost
' first), the canvas (at least DOCK_MIN_CANVAS_W, takes the rest), the right
' columns (innermost first). Gives every column its x and leaves DOCK_LX /
' DOCK_RX (the canvas edges).
' Small windows: while the line overflows (the canvas would be narrower than
' DOCK_MIN_CANVAS_W), hide the outermost column of the wider side - the
' toolbox's column last, without it there are no tools (this frame only; the
' arrangement is not changed). Which one goes next depends on what is left,
' so each is dropped by hand and the line solved again.
SUB DOCK_row_solve ()
    DIM side AS INTEGER, o AS INTEGER, c AS INTEGER, l AS LONG, cv AS LONG, hid AS INTEGER
    DIM wl AS INTEGER, wr AS INTEGER, rx AS INTEGER, over AS LONG
    DIM it(1 TO DOCK_MAX_COLS) AS LONG
    FOR c = 1 TO DOCK_MAX_COLS: DOCK_COL(c).autoh = FALSE: NEXT c
    LAY_reset
    l = LAY_line_new&(DOCK_WX2 - DOCK_WX1 + 1, 0) ' (inside a colour strip on the left / right)
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(DOCK_LEFT, o)
        IF c = 0 THEN EXIT FOR
        IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis THEN it(c) = LAY_add_fixed&(l, DOCK_COL(c).w)
    NEXT o
    cv = LAY_add&(l, DOCK_MIN_CANVAS_W, 0, 0, 1, 0)
    FOR o = DOCK_MAX_COLS TO 1 STEP -1
        c = DOCK_col_at%(DOCK_RIGHT, o)
        IF c THEN
            IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis THEN it(c) = LAY_add_fixed&(l, DOCK_COL(c).w)
        END IF
    NEXT o
    DO
        LAY_solve l
        over = LAY_overflow&(l)
        IF over = 0 THEN EXIT DO
        wl = 0: wr = 0
        FOR c = 1 TO DOCK_MAX_COLS
            IF it(c) THEN
                IF LAY_ITEMS(it(c)).dropped = 0 THEN
                    IF DOCK_COL(c).side = DOCK_LEFT THEN wl = wl + DOCK_COL(c).w ELSE wr = wr + DOCK_COL(c).w
                END IF
            END IF
        NEXT c
        IF wl + wr = 0 THEN EXIT DO
        IF wl >= wr THEN side = DOCK_LEFT ELSE side = DOCK_RIGHT
        hid = DOCK_hide_outermost%(side, FALSE)
        IF hid = 0 THEN hid = DOCK_hide_outermost%(3 - side, FALSE)
        IF hid = 0 THEN hid = DOCK_hide_outermost%(side, TRUE)
        IF hid = 0 THEN hid = DOCK_hide_outermost%(3 - side, TRUE)
        IF hid = 0 THEN EXIT DO
        FOR c = 1 TO DOCK_MAX_COLS
            IF it(c) _ANDALSO DOCK_COL(c).autoh THEN
                IF LAY_ITEMS(it(c)).dropped = 0 THEN LAY_set_dropped it(c), 0, TRUE
            END IF
        NEXT c
    LOOP
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).autoh THEN DOCK_COL(c).vis = FALSE
    NEXT c
    ' x: from the line - but while it still overflows (no room even with every
    ' column hidden that may be), the right columns stay on the right edge
    DOCK_LX = DOCK_WX1
    DOCK_RX = DOCK_WX2
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(DOCK_LEFT, o)
        IF c = 0 THEN EXIT FOR
        IF DOCK_COL(c).vis THEN DOCK_COL(c).x = DOCK_WX1 + LAY_ITEMS(it(c)).at: DOCK_LX = DOCK_COL(c).x + DOCK_COL(c).w
    NEXT o
    rx = DOCK_WX2 + 1
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(DOCK_RIGHT, o)
        IF c = 0 THEN EXIT FOR
        IF DOCK_COL(c).vis THEN
            rx = rx - DOCK_COL(c).w
            IF over THEN DOCK_COL(c).x = rx ELSE DOCK_COL(c).x = DOCK_WX1 + LAY_ITEMS(it(c)).at
            DOCK_RX = DOCK_COL(c).x - 1
        END IF
    NEXT o
END SUB



''
' Is panel id laid out this frame (a rect to draw and hit-test in)? FALSE for
' a collapsed slot, an inactive tab, a column hidden for a small window, or a
' panel that is not docked. Before the first layout everything counts as live.
FUNCTION DOCK_live% (id AS INTEGER)
    IF DOCK_LAID_OUT = 0 THEN DOCK_live% = TRUE: EXIT FUNCTION
    DOCK_live% = DPANEL(id).rVis
END FUNCTION



''
' Hide the outermost showing column on side (DOCK_row_solve); with
' toolboxToo FALSE the toolbox's column is skipped. TRUE when one was hidden.
FUNCTION DOCK_hide_outermost% (side AS INTEGER, toolboxToo AS INTEGER)
    DIM o AS INTEGER, c AS INTEGER, hasTb AS INTEGER
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(side, o)
        IF c = 0 THEN EXIT FOR
        IF DOCK_COL(c).vis _ANDALSO DOCK_COL(c).autoh = 0 THEN
            hasTb = (DPANEL(DP_TOOLBOX).slot > 0 _ANDALSO DOCK_SLOT(DPANEL(DP_TOOLBOX).slot).col = c)
            IF toolboxToo _ORELSE hasTb = 0 THEN
                DOCK_COL(c).autoh = TRUE
                DOCK_hide_outermost% = TRUE
                EXIT FUNCTION
            END IF
        END IF
    NEXT o
END FUNCTION



' =============================================================================
' Tabs and collapse (P4)
' =============================================================================

''
' Tab of titled slot s under x (1..ntabs), 0 = the chevron / none. Same
' measurement as DOCK_render_titles (the layers header font).
FUNCTION DOCK_tab_at% (s AS INTEGER, mx AS INTEGER)
    DIM t AS INTEGER, tx AS INTEGER, tw AS INTEGER
    IF mx < DOCK_SLOT(s).x + 10 THEN EXIT FUNCTION
    FOR t = 1 TO DOCK_SLOT(s).ntabs
        IF DOCK_tab_rect%(s, t, tx, tw) THEN
            IF mx >= tx - 2 _ANDALSO mx < tx + tw + 2 THEN DOCK_tab_at% = t: EXIT FUNCTION
        END IF
    NEXT t
END FUNCTION


''
' Collapse / expand slot s (saved).
SUB DOCK_toggle_collapse (s AS INTEGER)
    IF s < 1 _ORELSE DOCK_SLOT(s).used = 0 THEN EXIT SUB
    DOCK_change_begin
    DOCK_SLOT(s).collapsed = _NEGATE DOCK_SLOT(s).collapsed
    IF DOCK_SLOT(s).collapsed THEN DOCK_change_commit_soft DPANEL(DOCK_slot_panel%(s)).title + " collapsed" ELSE DOCK_change_commit_soft DPANEL(DOCK_slot_panel%(s)).title + " expanded"
END SUB


''
' A click (no drag) on slot s's handle at x: the chevron collapses / expands,
' a tab becomes active, a double-click anywhere on a title collapses /
' expands. A click on a hover grip or the layers header does nothing.
SUB DOCK_title_click (s AS INTEGER, mx AS INTEGER)
    DIM t AS INTEGER, dbl AS INTEGER
    IF s < 1 THEN EXIT SUB
    IF DOCK_slot_titled%(s) = 0 THEN EXIT SUB
    dbl = (DOCK_UI.lastSlot = s _ANDALSO TIMER - DOCK_UI.lastClick < 0.4 _ANDALSO TIMER >= DOCK_UI.lastClick)
    DOCK_UI.lastSlot = s: DOCK_UI.lastClick = TIMER
    IF DOCK_SLOT(s).collapsed THEN
        ' a collapsed slot is only its title: any click opens it (on a tab,
        ' with that tab showing)
        DOCK_UI.lastSlot = 0
        DOCK_change_begin
        t = DOCK_tab_at%(s, mx)
        IF t > 0 THEN DOCK_SLOT(s).act = t
        DOCK_toggle_collapse s
        EXIT SUB
    END IF
    IF dbl _ORELSE mx < DOCK_SLOT(s).x + 10 THEN
        DOCK_UI.lastSlot = 0
        DOCK_toggle_collapse s
        EXIT SUB
    END IF
    t = DOCK_tab_at%(s, mx)
    IF t > 0 _ANDALSO t <> DOCK_SLOT(s).act THEN
        DOCK_change_begin
        DOCK_SLOT(s).act = t
        DOCK_change_commit_soft ""
    END IF
END SUB



' =============================================================================
' [x] close boxes (Rick 2026-11-17: "not every panel that can be repositioned /
' floated / resized has a [x] to close it ... add [x] red just like the color
' mixer has and the browser"). The native windows draw their own (FPANEL_title_bar);
' these are for the dock-hosted panels: a floating one's frame strip (title or
' grip) and a titled docked strip (tabbed / collapsed: closes the showing tab).
' Chromeless docked panels (a 3px hover grip) have no room: their handle menu's
' Close row does it, as it does for every panel. Closing = the panel's own View
' toggle, so it comes back from the View menu.
' =============================================================================

''
' Can panel id be closed? Not the text bar: it shows with the text tool.
FUNCTION DOCK_panel_closable% (id AS INTEGER)
    DOCK_panel_closable% = (id >= 1 _ANDALSO id <= DP_COUNT _ANDALSO id <> DP_TEXTBAR)
END FUNCTION


''
' The View action that shows / hides panel id (0 = none).
FUNCTION DOCK_panel_toggle_action% (id AS INTEGER)
    SELECT CASE id
        CASE DP_TOOLBOX: DOCK_panel_toggle_action% = 401
        CASE DP_ORGANIZER: DOCK_panel_toggle_action% = 2472
        CASE DP_DRAWER: DOCK_panel_toggle_action% = 2473
        CASE DP_SELBAR: DOCK_panel_toggle_action% = SELBAR_ACT_TOGGLE
        CASE DP_MYPAINT: DOCK_panel_toggle_action% = MYPAINT_ACT_PANEL
        CASE DP_MYPSET: DOCK_panel_toggle_action% = MPS_ACT_PANEL
        CASE DP_BRUSHES: DOCK_panel_toggle_action% = BSP_ACT_PANEL
        CASE DP_LAYERS: DOCK_panel_toggle_action% = 404
        CASE DP_EDITBAR: DOCK_panel_toggle_action% = 435
        CASE DP_ADVBAR: DOCK_panel_toggle_action% = 449
        CASE DP_CHARMAP: DOCK_panel_toggle_action% = 2050
        CASE DP_WORKFLOW: DOCK_panel_toggle_action% = WF_ACT_TOGGLE
        CASE DP_PREVIEW: DOCK_panel_toggle_action% = 434
        CASE DP_MIXER: DOCK_panel_toggle_action% = 2021
        CASE DP_ADVCP: DOCK_panel_toggle_action% = 2023
        CASE DP_CS3D: DOCK_panel_toggle_action% = 2024
        CASE DP_PEN: DOCK_panel_toggle_action% = 2028
        CASE DP_ANIM: DOCK_panel_toggle_action% = ANIMP_ACT_TOGGLE
        CASE DP_SWATCH: DOCK_panel_toggle_action% = SWP_ACT_TOGGLE
        CASE DP_BROWSER: DOCK_panel_toggle_action% = 2022
    END SELECT
END FUNCTION


''
' Hide panel id (its [x] or the handle menu's Close): its View toggle, when showing.
SUB DOCK_panel_close (id AS INTEGER)
    DIM a AS INTEGER
    IF DOCK_panel_closable%(id) = 0 _ORELSE DOCK_panel_shown%(id) = 0 THEN EXIT SUB
    a = DOCK_panel_toggle_action%(id)
    IF a = 0 THEN EXIT SUB
    DOCK_UI.closeHover = 0: DOCK_UI.hoverSlot = 0
    CMD_execute_action a
    STATUS_flash DPANEL(id).title + " closed (View menu brings it back)"
    GUI_NEEDS_REDRAW% = TRUE: SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' The [x] of floating dock panel id: the right end of its frame's title bar or
' grip strip (viewport px). FALSE = none (native window, docked, too narrow).
FUNCTION DOCK_float_close_rect% (id AS INTEGER, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER)
    IF DOCK_panel_closable%(id) = 0 _ORELSE id >= DP_PREVIEW THEN EXIT FUNCTION
    IF DOCK_floating%(id) = 0 THEN EXIT FUNCTION
    bw = DOCK_TITLE_H: bh = DOCK_float_title_h%(id)
    IF DPANEL(id).fw < bw + 20 THEN bw = 8 ' (a one-column bar, 22 px: a slimmer box, the grip dots beside it)
    IF DPANEL(id).fw < bw + 10 THEN EXIT FUNCTION
    bx = DPANEL(id).fx + DPANEL(id).fw - bw: by = DPANEL(id).fy
    DOCK_float_close_rect% = TRUE
END FUNCTION


''
' The [x] of titled docked slot s: the right end of its strip (closes the
' showing tab's panel). FALSE = none.
FUNCTION DOCK_slot_close_rect% (s AS INTEGER, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER)
    IF s < 1 _ORELSE s > DOCK_MAX_SLOTS THEN EXIT FUNCTION
    IF DOCK_SLOT(s).used = 0 _ORELSE DOCK_SLOT(s).vis = 0 THEN EXIT FUNCTION
    IF DOCK_panel_closable%(DOCK_slot_panel%(s)) = 0 THEN EXIT FUNCTION
    IF DOCK_slot_titled%(s) = 0 THEN
        ' the layers have no strip: their own header is the handle, and its
        ' right end the [x] (LAYER_PANEL_render draws it - Rick 2026-11-17)
        IF DOCK_slot_panel%(s) <> DP_LAYERS THEN EXIT FUNCTION
        bh = PSURF_v%(DP_LAYERS, THEME.LAYER_PANEL_header_height%): bw = bh
        IF DOCK_SLOT(s).w < bw + 60 THEN EXIT FUNCTION
        bx = DOCK_SLOT(s).x + DOCK_SLOT(s).w - bw: by = DOCK_SLOT(s).y
        DOCK_slot_close_rect% = TRUE
        EXIT FUNCTION
    END IF
    bw = DOCK_TITLE_H: bh = DOCK_TITLE_H - 1
    IF DOCK_SLOT(s).w < bw + 24 THEN EXIT FUNCTION
    bx = DOCK_SLOT(s).x + DOCK_SLOT(s).w - bw: by = DOCK_SLOT(s).y
    DOCK_slot_close_rect% = TRUE
END FUNCTION


''
' Does the docked layers panel show an [x] at the right end of its own header?
' (Floating, it is on the grip; in a tabbed / collapsed slot, on the strip.)
FUNCTION DOCK_layers_header_close% ()
    DIM s AS INTEGER, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER
    IF DOCK_floating%(DP_LAYERS) THEN EXIT FUNCTION
    s = DPANEL(DP_LAYERS).slot
    IF s < 1 _ORELSE s > DOCK_MAX_SLOTS THEN EXIT FUNCTION
    IF DOCK_slot_panel%(s) <> DP_LAYERS _ORELSE DOCK_slot_titled%(s) THEN EXIT FUNCTION
    DOCK_layers_header_close% = DOCK_slot_close_rect%(s, bx, by, bw, bh)
END FUNCTION


''
' The [x] that closes panel id, wherever it is now (floating frame or the
' titled strip of its slot, as its showing tab).
FUNCTION DOCK_close_rect_of% (id AS INTEGER, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER)
    DIM s AS INTEGER
    IF DOCK_float_close_rect%(id, bx, by, bw, bh) THEN DOCK_close_rect_of% = TRUE: EXIT FUNCTION
    s = DPANEL(id).slot
    IF s < 1 THEN EXIT FUNCTION
    IF DOCK_slot_panel%(s) <> id THEN EXIT FUNCTION
    DOCK_close_rect_of% = DOCK_slot_close_rect%(s, bx, by, bw, bh)
END FUNCTION


''
' Panel whose [x] is under (mx, my), 0 = none: the frontmost floating dock
' panel's, else a titled docked strip's (with the handles' guards).
FUNCTION DOCK_close_at% (mx AS INTEGER, my AS INTEGER)
    DIM id AS INTEGER, s AS INTEGER, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER
    IF DOCK_ui_busy% _ORELSE DOCK_UI.mvActive THEN EXIT FUNCTION
    id = DOCK_float_window_at%(mx, my)
    IF id THEN
        IF DOCK_float_close_rect%(id, bx, by, bw, bh) THEN
            IF mx >= bx _ANDALSO mx < bx + bw _ANDALSO my >= by _ANDALSO my < by + bh THEN DOCK_close_at% = id
        END IF
        EXIT FUNCTION ' (a floating window covers whatever is under it)
    END IF
    s = DOCK_handle_at%(mx, my)
    IF s = 0 THEN EXIT FUNCTION
    IF DOCK_slot_close_rect%(s, bx, by, bw, bh) THEN
        IF mx >= bx _ANDALSO mx < bx + bw _ANDALSO my >= by _ANDALSO my < by + bh THEN DOCK_close_at% = DOCK_slot_panel%(s)
    END IF
END FUNCTION


''
' The twirl arrow of a docked strip at (x, cy = its middle row): down (7 x 4)
' when open, right (4 x 7) when collapsed - FPANEL_disclosure's shape.
SUB DOCK_twirl (x AS INTEGER, cy AS INTEGER, collapsed AS INTEGER, clr AS _UNSIGNED LONG)
    DIM i AS INTEGER
    IF collapsed THEN
        FOR i = 0 TO 3: LINE (x + 1 + i, cy - 3 + i)-(x + 1 + i, cy + 3 - i), clr: NEXT i
    ELSE
        FOR i = 0 TO 3: LINE (x + i, cy - 2 + i)-(x + 6 - i, cy - 2 + i), clr: NEXT i
    END IF
END SUB


''
' The close cross centred in box (bx, by, bw, bh), arms 2-3 px.
SUB DOCK_close_cross (bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER, clr AS _UNSIGNED LONG)
    DIM cx AS INTEGER, cy AS INTEGER, a AS INTEGER
    cx = bx + bw \ 2: cy = by + bh \ 2
    IF bh <= DOCK_FLOAT_GRIP_H THEN ' a grip strip: 3x3 on the dot rows, 1 px clear above / below
        cx = bx + (bw - 1) \ 2: cy = by + (bh + 1) \ 2
        LINE (cx - 1, cy - 1)-(cx + 1, cy + 1), clr
        LINE (cx - 1, cy + 1)-(cx + 1, cy - 1), clr
        EXIT SUB
    END IF
    a = (bh - 1) \ 2 - 2: IF a < 2 THEN a = 2
    IF a > 3 THEN a = 3
    IF a > (bh - 1) \ 2 THEN a = (bh - 1) \ 2
    LINE (cx - a, cy - a)-(cx + a, cy + a), clr
    LINE (cx - a, cy + a)-(cx + a, cy - a), clr
END SUB



' =============================================================================
' Floating docked panels (P5): float, move, dock back
' =============================================================================

''
' Height of a floating panel's handle strip: a grip for the thin bars (and
' anything too narrow for its title), a title bar for the rest.
FUNCTION DOCK_float_title_h% (id AS INTEGER)
    ' the layers float with a grip: their own header names them and is the
    ' rest of the handle (DOCK_float_handle_h%), as it is docked
    IF id = DP_EDITBAR _ORELSE id = DP_ADVBAR _ORELSE id = DP_LAYERS _ORELSE id = DP_TEXTBAR _ORELSE id = DP_SELBAR _ORELSE DPANEL(id).fw < 64 THEN
        DOCK_float_title_h% = DOCK_FLOAT_GRIP_H
    ELSE
        DOCK_float_title_h% = DOCK_TITLE_H
    END IF
END FUNCTION


''
' Height of a floating panel's move handle from its top: the title bar or
' grip, plus the layers' header under the grip.
FUNCTION DOCK_float_handle_h% (id AS INTEGER)
    DIM h AS INTEGER
    h = DOCK_float_title_h%(id)
    IF id = DP_LAYERS THEN h = h + PSURF_v%(id, THEME.LAYER_PANEL_header_height%)
    DOCK_float_handle_h% = h
END FUNCTION


''
' Content height a panel floats at: a bar shows all its icons, anything else
' its docked height within 60..260 px (the work-area clamp trims either).
FUNCTION DOCK_float_content_h% (id AS INTEGER)
    DIM h AS INTEGER
    SELECT CASE id
        CASE DP_EDITBAR: h = PSURF_v%(id, EDIT_BAR.contentH% + THEME.ICON_BAR_padding% + 2)
        CASE DP_ADVBAR: h = PSURF_v%(id, ADV_BAR.contentH% + THEME.ICON_BAR_padding% + 2)
        CASE DP_WORKFLOW: DOCK_float_content_h% = DOCK_fixed_h%(id, DPANEL(id).rw): EXIT FUNCTION ' its rows, no more
        CASE DP_TEXTBAR: DOCK_float_content_h% = DOCK_fixed_h%(id, _MAX(DPANEL(id).rw, PSURF_v%(id, TEXT_BAR_ROW_BASIS_W))): EXIT FUNCTION ' its lines, no more
        CASE DP_SELBAR: DOCK_float_content_h% = DOCK_fixed_h%(id, _MAX(DPANEL(id).rw, PSURF_v%(id, SELBAR_ROW_BASIS_W))): EXIT FUNCTION
        CASE DP_MYPSET: DOCK_float_content_h% = DOCK_fixed_h%(id, _MAX(DPANEL(id).fw - 2, PSURF_v%(id, MPS_COL_W))): EXIT FUNCTION ' its sliders, no more
        CASE ELSE: h = _MIN(260, _MAX(60, DPANEL(id).rh))
    END SELECT
    IF h < 60 THEN h = 60
    DOCK_float_content_h% = h
END FUNCTION


''
' The resize edge of a floating panel under (mx, my): 1 right, 2 bottom,
' 3 corner, 0 none; id = the panel.
FUNCTION DOCK_float_edge_at% (mx AS INTEGER, my AS INTEGER, id AS INTEGER)
    DIM i AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, e AS INTEGER
    IF DOCK_ui_busy% THEN EXIT FUNCTION
    SELECT CASE REGION_hit_test%(mx, my) ' inert under menus, popups and native windows
        CASE REGION_GLOBAL, REGION_CANVAS, REGION_TOOLBAR, REGION_ORGANIZER, REGION_DRAWER, _
             REGION_EDIT_BAR, REGION_ADV_BAR, REGION_LAYER_PANEL, REGION_CHARMAP, REGION_WORKFLOW, REGION_TEXT_BAR, REGION_SEL_BAR, REGION_MYPAINT, REGION_MYPSET, REGION_BRUSHES
        CASE ELSE: EXIT FUNCTION
    END SELECT
    DIM o(1 TO WZ_COUNT) AS INTEGER, k AS INTEGER
    WZ_order o()
    FOR k = WZ_COUNT TO 1 STEP -1 ' front to back (GUI/WINZ)
        i = o(k)
        IF i >= DP_PREVIEW THEN
            IF WZ_hit%(i, mx, my) THEN EXIT FUNCTION ' a native window in front
        ELSEIF DOCK_floating%(i) _ANDALSO DPANEL(i).rVis THEN
            x2 = DPANEL(i).fx + DPANEL(i).fw - 1: y2 = DPANEL(i).fy + DPANEL(i).fh - 1
            IF mx >= DPANEL(i).fx _ANDALSO mx <= x2 + 1 _ANDALSO my >= DPANEL(i).fy _ANDALSO my <= y2 + 1 THEN
                e = 0
                IF mx >= x2 - DOCK_FLOAT_EDGE + 1 THEN e = 1
                IF my >= y2 - DOCK_FLOAT_EDGE + 1 THEN e = e + 2
                IF e = 1 _ANDALSO my < DPANEL(i).fy + DOCK_float_handle_h%(i) THEN e = 0 ' the title bar moves it
                id = i
                DOCK_float_edge_at% = e
                EXIT FUNCTION ' the frontmost panel under the pointer decides
            END IF
        END IF
    NEXT k
END FUNCTION


''
' DOCK_handle_mouse%: grab / drag / drop a floating panel's resize edge.
FUNCTION DOCK_handle_float_resize% (mx AS INTEGER, my AS INTEGER)
    DIM e AS INTEGER, id AS INTEGER
    IF DOCK_RZ.id THEN
        id = DOCK_RZ.id
        IF DOCK_RZ.edge AND 1 THEN DPANEL(id).fw = DOCK_RZ.w0 + mx - DOCK_RZ.x0
        IF DOCK_RZ.edge AND 2 THEN DPANEL(id).fh = DOCK_RZ.h0 + my - DOCK_RZ.y0
        DOCK_redraw
        IF MOUSE.B1% = 0 THEN
            DOCK_RZ.id = 0
            DOCK_change_begin
            DOCK_change_commit ""
        END IF
        MOUSE.UI_CHROME_CLICKED% = TRUE
        DOCK_handle_float_resize% = TRUE
        EXIT FUNCTION
    END IF
    IF MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0 THEN
        e = DOCK_float_edge_at%(mx, my, id)
        IF e THEN
            DOCK_RZ.id = id: DOCK_RZ.edge = e
            DOCK_RZ.x0 = mx: DOCK_RZ.y0 = my
            DOCK_RZ.w0 = DPANEL(id).fw: DOCK_RZ.h0 = DPANEL(id).fh
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_float_resize% = TRUE
        END IF
    END IF
END FUNCTION


''
' Lock Layout (CFG.LAYOUT_LOCKED, View > Lock Layout, Ctrl+Shift+L): FALSE while
' the layout is locked, so a drag that would move, re-dock or resize a panel or a
' floating window never starts - for drawing with a shaky tablet pen. Called where
' such a drag would begin; says why nothing moved.
FUNCTION LAYOUT_unlocked% ()
    IF CFG.LAYOUT_LOCKED% THEN
        STATUS_flash "Workspace locked - View > Lock Workspace (Ctrl+Shift+L) to unlock"
        EXIT FUNCTION
    END IF
    LAYOUT_unlocked% = TRUE
END FUNCTION


''
' POINTER_build: the resize edge under the pointer (or being dragged), 0 = none.
FUNCTION DOCK_float_cursor_edge% (mx AS INTEGER, my AS INTEGER)
    DIM id AS INTEGER
    IF DOCK_RZ.id THEN DOCK_float_cursor_edge% = DOCK_RZ.edge: EXIT FUNCTION
    IF MOUSE.B1% _ORELSE MOUSE.B2% _ORELSE MOUSE.B3% THEN EXIT FUNCTION
    IF CFG.LAYOUT_LOCKED% THEN EXIT FUNCTION ' locked: no resize cursor
    DOCK_float_cursor_edge% = DOCK_float_edge_at%(mx, my, id)
END FUNCTION


FUNCTION DOCK_floating% (id AS INTEGER)
    DOCK_floating% = (DPANEL(id).fl <> 0 _ANDALSO DPANEL(id).slot = 0 _ANDALSO DPANEL(id).floats = 0)
END FUNCTION


''
' Render pass: the floating dock panels back to front (GUI/WINZ order), each
' whole - its window as panel (so what its content doesn't cover is never a
' hole onto the canvas), its content, then its frame + title bar - so a panel
' in front covers the one behind it, grip and border too. The fixed render
' list skips floating panels (DOCK_floating%); they draw only here.
SUB DOCK_render_float_stack ()
    DIM o(1 TO WZ_COUNT) AS INTEGER, i AS INTEGER, id AS INTEGER
    DIM oldDest AS LONG
    oldDest& = _DEST
    WZ_order o()
    FOR i = 1 TO WZ_COUNT
        id = o(i)
        IF id < DP_PREVIEW THEN
            IF DOCK_floating%(id) _ANDALSO DPANEL(id).rVis _ANDALSO DOCK_live%(id) THEN
                _DEST SCRN.GUI&
                LINE (DPANEL(id).fx, DPANEL(id).fy)-(DPANEL(id).fx + DPANEL(id).fw - 1, DPANEL(id).fy + DPANEL(id).fh - 1), THEME.DOCK_bg~&, BF
                PSURF_render id ' (its own surface at a Scale: GUI/PANEL-SURFACE)
                _DEST SCRN.GUI&
                DOCK_render_float_frame id
            END IF
        END IF
    NEXT i
    _DEST oldDest&
END SUB


''
' Draw dock panel id's content (into SCRN.GUI&), as the fixed render list does.
SUB DOCK_render_panel_content (id AS INTEGER)
    SELECT CASE id
        CASE DP_TOOLBOX: IF SCRN.showToolbar% THEN TOOLBAR_render 0, 0, TB_LIVE_COUNT - 1
        CASE DP_ORGANIZER: IF SCRN.showToolbar% THEN ORGANIZER_render
        CASE DP_WORKFLOW: IF SCRN.showToolbar% THEN WF_render
        CASE DP_DRAWER: IF SCRN.showToolbar% THEN DRAWER_render
        CASE DP_EDITBAR: IF SCRN.showEditBar% THEN EDITBAR_render
        CASE DP_ADVBAR: IF SCRN.showAdvBar% THEN ADVBAR_render
        CASE DP_CHARMAP: IF SCRN.showCharMap% THEN CHARMAP_fill_stub: CHARMAP_render
        CASE DP_LAYERS: IF LAYER_PANEL.visible% THEN LAYER_PANEL_render
        CASE DP_TEXTBAR
            IF TEXT_BAR.visible% THEN TEXT_BAR.needsRedraw% = TRUE: TEXT_BAR_render: TEXT_BAR_sync_paint_color ' (its dropdowns: TEXT_BAR_render_dropdowns, over everything)
        CASE DP_SELBAR
            IF SELBAR.visible THEN SELBAR_render
        CASE DP_MYPAINT
            IF MYPP.visible THEN MYPP_render
        CASE DP_MYPSET
            IF MPS.visible THEN MPS_render
        CASE DP_BRUSHES
            IF BSP.visible THEN BSP_render
    END SELECT
END SUB


''
' Is dock panel id drawn by the fixed render list (not floating)?
FUNCTION DOCK_in_list% (id AS INTEGER)
    DOCK_in_list% = (DOCK_live%(id) <> 0 _ANDALSO DOCK_floating%(id) = 0)
END FUNCTION


''
' The frame + title bar of floating docked panel id (into SCRN.GUI&).
SUB DOCK_render_float_frame (id AS INTEGER)
    DIM x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, th AS INTEGER, gx AS INTEGER
    DIM bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER, gc AS INTEGER, g0 AS INTEGER, g1 AS INTEGER
    DIM oldDest AS LONG, oldFont AS LONG
    oldDest& = _DEST: oldFont& = _FONT
    _DEST SCRN.GUI&
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle& ELSE IF MENU_BAR.fontHandle& > 0 THEN _FONT MENU_BAR.fontHandle&
    x = DPANEL(id).fx: y = DPANEL(id).fy: w = DPANEL(id).fw: h = DPANEL(id).fh
    th = DOCK_float_title_h%(id)
    LINE (x, y)-(x + w - 1, y + th - 1), THEME.PANEL_title_bg~&, BF
    LINE (x, y)-(x + w - 1, y + h - 1), THEME.PANEL_title_border~&, B
    IF THEMEED.started THEN THEMEED_seen _DEST, "", "DOCKF:" + _TRIM$(STR$(id)), "FLOATING TITLE", x, y, w, th, "@DOCK_render_float_frame"
    IF th = DOCK_FLOAT_GRIP_H THEN
        ' a thin bar: a grip, no title (drag it; double-click docks it back).
        ' Lock Layout: no grip, no dock mark, no resize corner - plain chrome.
        IF CFG.LAYOUT_LOCKED% = 0 THEN
            ' (centred in what the [x] leaves)
            gc = x + w \ 2: g0 = gc - 6: g1 = gc + 6
            IF DOCK_float_close_rect%(id, bx, by, bw, bh) THEN
                gc = x + (w - bw) \ 2: g0 = _MAX(x + 2, gc - 6): g1 = _MIN(bx - 2, gc + 6)
            END IF
            FOR gx = g0 TO g1 STEP 3
                PSET (gx, y + 2), THEME.PANEL_grip~&
                PSET (gx, y + 4), THEME.PANEL_grip~&
            NEXT gx
        END IF
    ELSE
        COLOR THEME.PANEL_title_fg~&, _RGBA32(0, 0, 0, 0)
        _PRINTMODE _KEEPBACKGROUND
        ' (cut to the room left of the dock mark and the [x]: a narrow float ran its title under them)
        DIM ttl AS STRING, tr AS INTEGER, cut AS INTEGER
        ttl = UCASE$(DPANEL(id).title)
        IF DOCK_float_close_rect%(id, bx, by, bw, bh) THEN tr = bx - 2 ELSE tr = x + w - 2
        IF CFG.LAYOUT_LOCKED% = 0 THEN tr = tr - 9
        DO WHILE LEN(ttl) > 0 _ANDALSO _UPRINTWIDTH(ttl) > tr - (x + 3)
            ttl = LEFT$(ttl, LEN(ttl) - 1): cut = TRUE
        LOOP
        IF cut _ANDALSO LEN(ttl) > 1 THEN ttl = LEFT$(ttl, LEN(ttl) - 1) + "."
        _UPRINTSTRING (x + 3, y + 1), ttl
        ' a "dock" mark at the right (left of the [x]): double-click the title to dock back
        IF CFG.LAYOUT_LOCKED% = 0 THEN
            IF DOCK_float_close_rect%(id, bx, by, bw, bh) THEN _UPRINTSTRING (bx - 8, y + 1), "#" ELSE _UPRINTSTRING (x + w - 8, y + 1), "#"
        END IF
    END IF
    ' the [x] close box at the right end of the title / grip (red on hover: DOCK_overlay_render)
    ' (on a grip strip: a small red x on the grip dots' rows - Rick 2026-11-17)
    IF DOCK_float_close_rect%(id, bx, by, bw, bh) THEN DOCK_close_cross bx, by, bw, bh, THEME.PANEL_close_fg~&
    IF CFG.LAYOUT_LOCKED% = 0 THEN
        ' resize grip in the bottom-right corner
        PSET (x + w - 3, y + h - 3), THEME.PANEL_grip~&
        PSET (x + w - 5, y + h - 3), THEME.PANEL_grip~&
        PSET (x + w - 3, y + h - 5), THEME.PANEL_grip~&
    END IF
    _FONT oldFont&: _DEST oldDest&
END SUB


''
' Floating panel whose window (any part of it) is under (mx, my), 0 = none.
FUNCTION DOCK_float_window_at% (mx AS INTEGER, my AS INTEGER)
    DIM id AS INTEGER
    id = WZ_top_at%(mx, my) ' the frontmost window there (GUI/WINZ)
    IF id >= 1 _ANDALSO id < DP_PREVIEW THEN DOCK_float_window_at% = id
END FUNCTION


''
' Floating panel whose title bar is under (mx, my), 0 = none.
FUNCTION DOCK_float_title_at% (mx AS INTEGER, my AS INTEGER)
    DIM id AS INTEGER
    id = DOCK_float_window_at%(mx, my) ' only the frontmost window's title
    IF id = 0 THEN EXIT FUNCTION
    IF my < DPANEL(id).fy + DOCK_float_handle_h%(id) THEN DOCK_float_title_at% = id
END FUNCTION


''
' Float docked panel id: a window the size it had, at (x, y) (top-left).
SUB DOCK_float_panel (id AS INTEGER, x AS INTEGER, y AS INTEGER)
    DIM s AS INTEGER, w AS INTEGER, h AS INTEGER
    s = DPANEL(id).slot
    IF s > 0 THEN
        DPANEL(id).hside = DOCK_COL(DOCK_SLOT(s).col).side
        DPANEL(id).hcol = DOCK_COL(DOCK_SLOT(s).col).ord
        DPANEL(id).hslot = DOCK_SLOT(s).ord
        DPANEL(id).halone = (DOCK_slot_at%(DOCK_SLOT(s).col, 2) = 0)
    END IF
    w = DPANEL(id).rw: h = DOCK_float_content_h%(id)
    IF w < DOCK_panel_w%(id) THEN w = DOCK_panel_w%(id)
    IF id = DP_EDITBAR _ORELSE id = DP_ADVBAR THEN w = DOCK_panel_w%(id) ' its own columns, not the column it shared
    DOCK_change_begin
    DOCK_detach_panel id
    DPANEL(id).fl = TRUE
    DPANEL(id).fx = x: DPANEL(id).fy = y
    DPANEL(id).fw = w + 2: DPANEL(id).fh = h + DOCK_float_title_h%(id) + 1
    DOCK_change_commit DPANEL(id).title + " floating (double-click its title to dock it back)"
END SUB


''
' Dock floating panel id back where it was (or the nearest side).
SUB DOCK_dock_back (id AS INTEGER)
    DIM side AS INTEGER, c AS INTEGER, r AS INTEGER
    DOCK_change_begin
    side = DPANEL(id).hside
    IF side = 0 THEN
        IF DPANEL(id).fx + DPANEL(id).fw \ 2 < SCRN.w& \ 2 THEN side = DOCK_LEFT ELSE side = DOCK_RIGHT
    END IF
    c = DOCK_col_at%(side, DPANEL(id).hcol)
    IF c > 0 _ANDALSO DPANEL(id).hslot > 0 _ANDALSO DPANEL(id).halone = 0 THEN
        r = DOCK_move_to_slot%(id, c, DPANEL(id).hslot)
    ELSE
        r = DOCK_move_to_new_col%(id, side, _MAX(1, DPANEL(id).hcol))
    END IF
    DPANEL(id).fl = FALSE
    DOCK_change_commit DPANEL(id).title + " docked"
END SUB



''
' A floating window was dragged (not onto a dock): snap it like the other
' floating windows, keep it, save.
SUB DOCK_float_moved (id AS INTEGER)
    DIM x AS INTEGER, y AS INTEGER, rg AS INTEGER
    x = DPANEL(id).fx: y = DPANEL(id).fy
    rg = DOCK_panel_region%(id)
    IF rg THEN FPANEL_place rg, x, y, DPANEL(id).fw, DPANEL(id).fh, DOCK_UI.mvX0 - DOCK_UI.mvOffX, DOCK_UI.mvY0 - DOCK_UI.mvOffY
    DPANEL(id).fx = x: DPANEL(id).fy = y
    DOCK_change_begin
    DOCK_change_commit ""
END SUB


''
' Click (no drag) on a floating title bar: a double-click docks it back.
SUB DOCK_float_click (id AS INTEGER)
    DIM dbl AS INTEGER
    dbl = (DOCK_UI.lastSlot = -id _ANDALSO TIMER - DOCK_UI.lastClick < 0.4 _ANDALSO TIMER >= DOCK_UI.lastClick)
    DOCK_UI.lastSlot = -id: DOCK_UI.lastClick = TIMER
    IF dbl THEN DOCK_UI.lastSlot = 0: DOCK_dock_back id
END SUB


FUNCTION DOCK_panel_region% (id AS INTEGER)
    SELECT CASE id
        CASE DP_TOOLBOX: DOCK_panel_region% = REGION_TOOLBAR
        CASE DP_ORGANIZER: DOCK_panel_region% = REGION_ORGANIZER
        CASE DP_WORKFLOW: DOCK_panel_region% = REGION_WORKFLOW
        CASE DP_DRAWER: DOCK_panel_region% = REGION_DRAWER
        CASE DP_LAYERS: DOCK_panel_region% = REGION_LAYER_PANEL
        CASE DP_EDITBAR: DOCK_panel_region% = REGION_EDIT_BAR
        CASE DP_ADVBAR: DOCK_panel_region% = REGION_ADV_BAR
        CASE DP_CHARMAP: DOCK_panel_region% = REGION_CHARMAP
        CASE DP_TEXTBAR: DOCK_panel_region% = REGION_TEXT_BAR
        CASE DP_SELBAR: DOCK_panel_region% = REGION_SEL_BAR
        CASE DP_MYPAINT: DOCK_panel_region% = REGION_MYPAINT
        CASE DP_MYPSET: DOCK_panel_region% = REGION_MYPSET
        CASE DP_BRUSHES: DOCK_panel_region% = REGION_BRUSHES
    END SELECT
END FUNCTION



' =============================================================================
' Native floating windows in docks (P5): Preview, Color Mixer, Advanced Color
' Picker, 3D Color Space, Pen Pressure, Browser. They keep their own look and
' input; docked, a slot sets their position and size and their title bar
' (left of its buttons) is the dock handle.
' =============================================================================

''
' Save Current Layout ([WINDOWS]): the floating native windows that are
' showing, as DRAW.cfg KEY=value lines (viewport px; sizes as the cfg keeps
' them). Docked ones are in [DOCK]; hidden ones keep the user's own place.
FUNCTION DOCK_native_cfg_lines$ ()
    DIM r AS STRING, lf AS STRING
    lf = CHR$(10)
    IF DOCK_panel_shown%(DP_PREVIEW) _ANDALSO DPANEL(DP_PREVIEW).slot = 0 THEN
        r = r + "PREVIEW_X=" + DOCK_n0$(PREVIEW.x%) + lf + "PREVIEW_Y=" + DOCK_n0$(PREVIEW.y%) + lf
        r = r + "PREVIEW_W=" + DOCK_n0$(PREVIEW.w%) + lf + "PREVIEW_H=" + DOCK_n0$(PREVIEW.h%) + lf
    END IF
    IF DOCK_panel_shown%(DP_MIXER) _ANDALSO DPANEL(DP_MIXER).slot = 0 THEN r = r + "COLOR_MIXER_X=" + DOCK_n0$(COLORMIXER.dispX%) + lf + "COLOR_MIXER_Y=" + DOCK_n0$(COLORMIXER.dispY%) + lf
    IF DOCK_panel_shown%(DP_ADVCP) _ANDALSO DPANEL(DP_ADVCP).slot = 0 THEN r = r + "ADV_COLOR_PICKER_X=" + DOCK_n0$(ADVCP.dispX%) + lf + "ADV_COLOR_PICKER_Y=" + DOCK_n0$(ADVCP.dispY%) + lf
    IF DOCK_panel_shown%(DP_CS3D) _ANDALSO DPANEL(DP_CS3D).slot = 0 THEN r = r + "COLOR_SPACE_3D_X=" + DOCK_n0$(CS3D.dispX%) + lf + "COLOR_SPACE_3D_Y=" + DOCK_n0$(CS3D.dispY%) + lf
    IF DOCK_panel_shown%(DP_PEN) _ANDALSO DPANEL(DP_PEN).slot = 0 THEN r = r + "PEN_PANEL_X=" + DOCK_n0$(PENP.dispX%) + lf + "PEN_PANEL_Y=" + DOCK_n0$(PENP.dispY%) + lf
    IF DOCK_panel_shown%(DP_ANIM) _ANDALSO DPANEL(DP_ANIM).slot = 0 THEN r = r + "ANIM_PANEL_X=" + DOCK_n0$(ANIMP.dispX) + lf + "ANIM_PANEL_Y=" + DOCK_n0$(ANIMP.dispY) + lf
    IF DOCK_panel_shown%(DP_SWATCH) _ANDALSO DPANEL(DP_SWATCH).slot = 0 THEN
        r = r + "SWATCHES_X=" + DOCK_n0$(SWP.dispX) + lf + "SWATCHES_Y=" + DOCK_n0$(SWP.dispY) + lf
        r = r + "SWATCHES_W=" + DOCK_n0$(CFG.SWATCHES_W%) + lf + "SWATCHES_H=" + DOCK_n0$(CFG.SWATCHES_H%) + lf
    END IF
    IF DOCK_panel_shown%(DP_BROWSER) _ANDALSO DPANEL(DP_BROWSER).slot = 0 THEN
        r = r + "BROWSER_POS_X=" + DOCK_n0$(BROWSER.dispX%) + lf + "BROWSER_POS_Y=" + DOCK_n0$(BROWSER.dispY%) + lf
        r = r + "BROWSER_WIDTH=" + DOCK_n0$(CFG.BROWSER_WIDTH%) + lf + "BROWSER_HEIGHT=" + DOCK_n0$(CFG.BROWSER_HEIGHT%) + lf
    END IF
    DOCK_native_cfg_lines$ = r
END FUNCTION


FUNCTION DOCK_n0$ (v AS LONG)
    DOCK_n0$ = _TRIM$(STR$(v))
END FUNCTION


''
' A workspace's [WINDOWS] (or the user's own on leaving) went into CFG: put
' the floating native windows there now - their inits read CFG only once.
' Docked ones are placed by the dock; a value < 0 means "auto" (left alone).
SUB DOCK_native_from_cfg ()
    IF DPANEL(DP_PREVIEW).slot = 0 _ANDALSO CFG.PREVIEW_X% >= 0 _ANDALSO CFG.PREVIEW_Y% >= 0 THEN
        IF CFG.PREVIEW_W% > 0 THEN PREVIEW.w% = CFG.PREVIEW_W%
        IF CFG.PREVIEW_H% > 0 THEN PREVIEW.h% = CFG.PREVIEW_H%
        PREVIEW.x% = CFG.PREVIEW_X%: PREVIEW.y% = CFG.PREVIEW_Y%
        PREVIEW_clamp_to_work_area
    END IF
    IF COLORMIXER.initialized% _ANDALSO DPANEL(DP_MIXER).slot = 0 _ANDALSO CFG.COLOR_MIXER_X% >= 0 _ANDALSO CFG.COLOR_MIXER_Y% >= 0 THEN
        COLORMIXER.dispX% = CFG.COLOR_MIXER_X%: COLORMIXER.dispY% = CFG.COLOR_MIXER_Y%
        COLORMIXER_clamp_to_work_area
    END IF
    IF ADVCP.initialized% _ANDALSO DPANEL(DP_ADVCP).slot = 0 _ANDALSO CFG.ADV_COLOR_PICKER_X% >= 0 _ANDALSO CFG.ADV_COLOR_PICKER_Y% >= 0 THEN
        ADVCP.dispX% = CFG.ADV_COLOR_PICKER_X%: ADVCP.dispY% = CFG.ADV_COLOR_PICKER_Y%
        ADVCP_clamp_to_work_area
    END IF
    IF CS3D.initialized% _ANDALSO DPANEL(DP_CS3D).slot = 0 _ANDALSO CFG.COLOR_SPACE_3D_X% >= 0 _ANDALSO CFG.COLOR_SPACE_3D_Y% >= 0 THEN
        CS3D.dispX% = CFG.COLOR_SPACE_3D_X%: CS3D.dispY% = CFG.COLOR_SPACE_3D_Y%
        CS3D_clamp_to_work_area
    END IF
    IF PENP.initialized% _ANDALSO DPANEL(DP_PEN).slot = 0 _ANDALSO CFG.PEN_PANEL_X% >= 0 _ANDALSO CFG.PEN_PANEL_Y% >= 0 THEN
        PENP.dispX% = CFG.PEN_PANEL_X%: PENP.dispY% = CFG.PEN_PANEL_Y%
        PENP_clamp_to_work_area
    END IF
    IF ANIMP.initialized _ANDALSO DPANEL(DP_ANIM).slot = 0 _ANDALSO CFG.ANIM_PANEL_X% >= 0 _ANDALSO CFG.ANIM_PANEL_Y% >= 0 THEN
        ANIMP.dispX = CFG.ANIM_PANEL_X%: ANIMP.dispY = CFG.ANIM_PANEL_Y%
        ANIMP_clamp_to_work_area
    END IF
    IF SWP.initialized _ANDALSO DPANEL(DP_SWATCH).slot = 0 THEN
        SWP.fitW = 0: SWP.fitH = 0
        SWP_relayout
        SWP_compute_display_size
        IF CFG.SWATCHES_X% >= 0 _ANDALSO CFG.SWATCHES_Y% >= 0 THEN SWP.dispX = CFG.SWATCHES_X%: SWP.dispY = CFG.SWATCHES_Y%
        SWP_clamp_to_work_area
    END IF
    IF BROWSER.initialized% _ANDALSO DPANEL(DP_BROWSER).slot = 0 _ANDALSO CFG.BROWSER_POS_X% >= 0 _ANDALSO CFG.BROWSER_POS_Y% >= 0 THEN
        DIM brRs AS SINGLE
        brRs = BROWSER.renderScale!: IF brRs <= 0 THEN brRs = 1
        BROWSER.dispW% = INT(CSNG(_MAX(CFG.BROWSER_WIDTH%, BROWSER_narrowest_w%)) * brRs + 0.5)
        BROWSER.dispH% = INT(CSNG(_MAX(CFG.BROWSER_HEIGHT%, BROWSER_MIN_H)) * brRs + 0.5)
        BROWSER.dispX% = CFG.BROWSER_POS_X%: BROWSER.dispY% = CFG.BROWSER_POS_Y%
        BROWSER_clamp_size
        BROWSER_clamp_to_work_area
        BROWSER_sync_fd_from_display
    END IF
    SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
END SUB


SUB DOCK_native_reset_docked ()
    ' docked = in the tree: one in a collapsed slot or an inactive tab gets no
    ' rect this frame but must not fall back to floating (DOCK_native_off%)
    PREVIEW.docked% = (DPANEL(DP_PREVIEW).slot > 0)
    COLORMIXER.docked% = (DPANEL(DP_MIXER).slot > 0)
    ADVCP.docked% = (DPANEL(DP_ADVCP).slot > 0)
    CS3D.docked% = (DPANEL(DP_CS3D).slot > 0)
    PENP.docked% = (DPANEL(DP_PEN).slot > 0)
    ANIMP.docked = (DPANEL(DP_ANIM).slot > 0)
    SWP.docked = (DPANEL(DP_SWATCH).slot > 0)
    BROWSER.docked% = (DPANEL(DP_BROWSER).slot > 0) ' a column or a row
    ' floating: back to the natural size (docked, DOCK_apply_rect fits them)
    IF COLORMIXER.docked% = 0 _ANDALSO COLORMIXER.initialized% THEN FPANEL_fit DP_MIXER, 0, 0
    IF ADVCP.docked% = 0 _ANDALSO ADVCP.initialized% THEN FPANEL_fit DP_ADVCP, 0, 0
    IF CS3D.docked% = 0 _ANDALSO CS3D.initialized% THEN FPANEL_fit DP_CS3D, 0, 0
    IF PENP.docked% = 0 _ANDALSO PENP.initialized% THEN FPANEL_fit DP_PEN, 0, 0
    IF ANIMP.docked = 0 _ANDALSO ANIMP.initialized THEN FPANEL_fit DP_ANIM, 0, 0
    IF SWP.docked = 0 _ANDALSO SWP.initialized THEN FPANEL_fit DP_SWATCH, 0, 0
END SUB


''
' A window opened while docked never draws until the layout gives it a rect,
' and the layout only gives one to an initialized window (its size comes from
' its init): initialize visible docked windows here. Their inits allocate
' images and may switch _DEST / _SOURCE / _FONT.
SUB DOCK_native_init_docked ()
    DIM oldDest AS LONG, oldSrc AS LONG, oldFont AS LONG, need AS INTEGER
    IF DPANEL(DP_MIXER).slot _ANDALSO COLORMIXER.visible% _ANDALSO COLORMIXER.initialized% = 0 THEN need = TRUE
    IF DPANEL(DP_ADVCP).slot _ANDALSO ADVCP.visible% _ANDALSO ADVCP.initialized% = 0 THEN need = TRUE
    IF DPANEL(DP_CS3D).slot _ANDALSO CS3D.visible% _ANDALSO CS3D.initialized% = 0 THEN need = TRUE
    IF DPANEL(DP_PEN).slot _ANDALSO PENP.visible% _ANDALSO PENP.initialized% = 0 THEN need = TRUE
    IF DPANEL(DP_ANIM).slot _ANDALSO ANIMP.visible _ANDALSO ANIMP.initialized = 0 THEN need = TRUE
    IF DPANEL(DP_SWATCH).slot _ANDALSO SWP.visible _ANDALSO SWP.initialized = 0 THEN need = TRUE
    IF DPANEL(DP_BROWSER).slot _ANDALSO BROWSER.visible% _ANDALSO BROWSER.initialized% = 0 THEN need = TRUE
    IF need = 0 THEN EXIT SUB
    oldDest& = _DEST: oldSrc& = _SOURCE: oldFont& = _FONT
    IF DPANEL(DP_MIXER).slot _ANDALSO COLORMIXER.visible% THEN COLORMIXER_ensure_initialized
    IF DPANEL(DP_ADVCP).slot _ANDALSO ADVCP.visible% THEN ADVCP_ensure_initialized
    IF DPANEL(DP_CS3D).slot _ANDALSO CS3D.visible% THEN CS3D_ensure_initialized
    IF DPANEL(DP_PEN).slot _ANDALSO PENP.visible% THEN PENP_ensure_initialized
    IF DPANEL(DP_ANIM).slot _ANDALSO ANIMP.visible THEN ANIMP_ensure_initialized
    IF DPANEL(DP_SWATCH).slot _ANDALSO SWP.visible THEN SWP_ensure_initialized
    IF DPANEL(DP_BROWSER).slot _ANDALSO BROWSER.visible% THEN BROWSER_ensure_initialized
    _DEST oldDest&: _SOURCE oldSrc&: _FONT oldFont&
END SUB


''
' A docked native window with no rect this frame (collapsed slot, inactive tab,
' hidden column): it neither draws nor takes the mouse.
FUNCTION DOCK_native_off% (id AS INTEGER)
    IF DPANEL(id).slot = 0 THEN EXIT FUNCTION
    DOCK_native_off% = (DOCK_live%(id) = 0)
END FUNCTION


''
' The grab part of a native window's title bar (viewport rect), FALSE = none.
FUNCTION DOCK_native_grab% (id AS INTEGER, gx AS INTEGER, gy AS INTEGER, gw AS INTEGER, gh AS INTEGER)
    DIM rs AS SINGLE
    SELECT CASE id
        CASE DP_PREVIEW
            IF PREVIEW.visible% = 0 _ORELSE PREVIEW.autoHidden% THEN EXIT FUNCTION
            PREVIEW_compute_display
            rs = PREVIEW.renderScale!: IF rs <= 0 THEN rs = 1
            gx = PREVIEW.x%: gy = PREVIEW.y%
            gw = INT(PREVIEW_cb_x% * rs) ' up to its FP checkbox
            gh = INT(PREVIEW_title_h% * rs + 0.5)
            DOCK_native_grab% = TRUE
        CASE DP_MIXER
            IF DOCK_panel_shown%(DP_MIXER) = 0 THEN EXIT FUNCTION
            rs = COLORMIXER.renderScale!: IF rs <= 0 THEN rs = 1
            gx = COLORMIXER.dispX%: gy = COLORMIXER.dispY%
            gh = INT(CP_THEME.titleBarH% * rs + 0.5) ' the drawn title bar, not the 24px default
            gw = COLORMIXER.dispW% - gh ' left of the close box
            IF COLORMIXER.side% THEN ' (in a row: left of MORE's triangle too)
                DIM tx AS INTEGER, ty AS INTEGER, tw AS INTEGER, th AS INTEGER
                COLORMIXER_side_more_rect tx, ty, tw, th
                gw = INT((tx - 3) * rs)
            END IF
            DOCK_native_grab% = TRUE
        CASE DP_ADVCP
            IF DOCK_panel_shown%(DP_ADVCP) = 0 THEN EXIT FUNCTION
            rs = ADVCP.renderScale!: IF rs <= 0 THEN rs = 1
            gx = ADVCP.dispX%: gy = ADVCP.dispY%
            gh = INT(FPANEL.titleH% * rs + 0.5)
            gw = ADVCP.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_CS3D
            IF DOCK_panel_shown%(DP_CS3D) = 0 THEN EXIT FUNCTION
            rs = CS3D.renderScale!: IF rs <= 0 THEN rs = 1
            gx = CS3D.dispX%: gy = CS3D.dispY%
            gh = INT(FPANEL.titleH% * rs + 0.5)
            gw = CS3D.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_PEN
            IF DOCK_panel_shown%(DP_PEN) = 0 THEN EXIT FUNCTION
            rs = PENP.renderScale!: IF rs <= 0 THEN rs = 1
            gx = PENP.dispX%: gy = PENP.dispY%
            gh = INT(FPANEL.titleH% * rs + 0.5)
            gw = PENP.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_ANIM
            IF DOCK_panel_shown%(DP_ANIM) = 0 THEN EXIT FUNCTION
            rs = ANIMP.renderScale: IF rs <= 0 THEN rs = 1
            gx = ANIMP.dispX: gy = ANIMP.dispY
            gh = INT(FPANEL.titleH% * rs + 0.5)
            gw = ANIMP.dispW - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_SWATCH
            IF DOCK_panel_shown%(DP_SWATCH) = 0 THEN EXIT FUNCTION
            rs = SWP.renderScale: IF rs <= 0 THEN rs = 1
            gx = SWP.dispX: gy = SWP.dispY
            gh = INT(FPANEL.titleH% * rs + 0.5)
            gw = SWP.dispW - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_BROWSER
            IF DOCK_panel_shown%(DP_BROWSER) = 0 THEN EXIT FUNCTION
            rs = BROWSER.renderScale!: IF rs <= 0 THEN rs = 1
            gx = BROWSER.dispX%: gy = BROWSER.dispY%
            gh = INT(FD_STATE.titleBarH * rs + 0.5)
            gw = BROWSER.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
    END SELECT
END FUNCTION


''
' A FLOATING native window whose grab area is under (mx, my), 0 = none.
FUNCTION DOCK_native_float_title_at% (mx AS INTEGER, my AS INTEGER)
    DIM id AS INTEGER, gx AS INTEGER, gy AS INTEGER, gw AS INTEGER, gh AS INTEGER
    FOR id = DP_PREVIEW TO DP_COUNT
        IF DPANEL(id).slot = 0 THEN
            IF DOCK_native_grab%(id, gx, gy, gw, gh) THEN
                IF mx >= gx _ANDALSO mx < gx + gw _ANDALSO my >= gy _ANDALSO my < gy + gh _ANDALSO WZ_top_at%(mx, my) = id THEN DOCK_native_float_title_at% = id: EXIT FUNCTION
                IF id = DP_PREVIEW _ANDALSO WZ_top_at%(mx, my) = id THEN
                    IF DOCK_preview_title_more%(mx, my) THEN DOCK_native_float_title_at% = id: EXIT FUNCTION
                END IF
            END IF
        END IF
    NEXT id
END FUNCTION


''
' The window's own drag (floating): track the dock target under the pointer so
' the preview shows; a FLOAT target means "keep floating".
SUB DOCK_native_drag (id AS INTEGER, mx AS INTEGER, my AS INTEGER)
    ' the first held frame of this drag: remember where it started
    IF DOCK_UI.mvNative = 0 _ORELSE DOCK_UI.mvPanel <> id THEN
        DOCK_UI.mvX0 = mx: DOCK_UI.mvY0 = my: DOCK_UI.mvActive = FALSE
    END IF
    DOCK_UI.mvPanel = id
    DOCK_UI.mvNative = TRUE
    ' a press that has not travelled DOCK_DRAG_START px is a click on the title
    ' (raise the window), never a dock: without this a click on a window lying
    ' over a dock target docked it (Windows QA, gui-float-zorder 2026-11-17)
    IF DOCK_UI.mvActive = 0 THEN
        IF ABS(mx - DOCK_UI.mvX0) + ABS(my - DOCK_UI.mvY0) >= DOCK_DRAG_START THEN DOCK_UI.mvActive = TRUE
    END IF
    ' right-click while dragging: no docking this time (as for a docked panel)
    IF MOUSE.B2% _ANDALSO MOUSE.OLD_B2% = 0 THEN DOCK_UI.mvCancel = TRUE
    IF DOCK_UI.mvCancel _ORELSE DOCK_UI.mvActive = 0 THEN DOCK_UI.tgtKind = DOCK_TGT_NONE: FRAME_IDLE% = FALSE: EXIT SUB
    DOCK_drop_target mx, my
    IF DOCK_UI.tgtKind = DOCK_TGT_FLOAT THEN DOCK_UI.tgtKind = DOCK_TGT_NONE
    FRAME_IDLE% = FALSE
END SUB


''
' The window's own drag ended: dock it if it was over a target. TRUE = docked.
FUNCTION DOCK_native_drag_end% (id AS INTEGER)
    DIM k AS INTEGER
    k = DOCK_UI.tgtKind
    IF DOCK_UI.mvCancel THEN k = DOCK_TGT_NONE
    DOCK_UI.mvCancel = FALSE
    DOCK_UI.mvNative = FALSE: DOCK_UI.mvActive = FALSE
    IF DOCK_UI.mvPanel = id _ANDALSO k <> DOCK_TGT_NONE _ANDALSO k <> DOCK_TGT_FLOAT THEN
        DOCK_drop_apply
        DOCK_UI.mvPanel = 0: DOCK_UI.tgtKind = DOCK_TGT_NONE
        DOCK_native_drag_end% = TRUE
    END IF
    DOCK_UI.mvPanel = 0: DOCK_UI.tgtKind = DOCK_TGT_NONE
END FUNCTION


''
' Undock a native window: back to its own floating size at (x, y).
SUB DOCK_native_undock (id AS INTEGER, x AS INTEGER, y AS INTEGER)
    DOCK_change_begin
    DOCK_detach_panel id
    ' the layout without it, before the clamps below read the work area: the
    ' column it leaves may give a column the small-window rule had hidden its
    ' room back - clamped to the old edges, the window then covered that column
    ' (QA dock-native-browser: a 283 px browser tab left, the charmap came back
    ' under the floating browser, 2026-11-20)
    SCREEN_compute_layout
    SELECT CASE id
        CASE DP_PREVIEW
            PREVIEW.docked% = FALSE
            PREVIEW.w% = CFG.PREVIEW_W%: PREVIEW.h% = CFG.PREVIEW_H%
            PREVIEW.x% = x: PREVIEW.y% = y
            PREVIEW_clamp_to_work_area
            CFG.PREVIEW_X% = PREVIEW.x%: CFG.PREVIEW_Y% = PREVIEW.y%
        CASE DP_MIXER
            COLORMIXER.docked% = FALSE
            FPANEL_fit DP_MIXER, 0, 0 ' its natural size again
            COLORMIXER.dispX% = x: COLORMIXER.dispY% = y
            COLORMIXER_clamp_to_work_area
            CFG.COLOR_MIXER_X% = COLORMIXER.dispX%: CFG.COLOR_MIXER_Y% = COLORMIXER.dispY%
        CASE DP_ADVCP
            ADVCP.docked% = FALSE
            FPANEL_fit DP_ADVCP, 0, 0 ' its natural size again
            ADVCP.dispX% = x: ADVCP.dispY% = y
            ADVCP_clamp_to_work_area
            CFG.ADV_COLOR_PICKER_X% = ADVCP.dispX%: CFG.ADV_COLOR_PICKER_Y% = ADVCP.dispY%
        CASE DP_CS3D
            CS3D.docked% = FALSE
            FPANEL_fit DP_CS3D, 0, 0 ' its natural size again
            CS3D.dispX% = x: CS3D.dispY% = y
            CS3D_clamp_to_work_area
            CFG.COLOR_SPACE_3D_X% = CS3D.dispX%: CFG.COLOR_SPACE_3D_Y% = CS3D.dispY%
        CASE DP_PEN
            PENP.docked% = FALSE
            FPANEL_fit DP_PEN, 0, 0 ' its natural size again
            PENP.dispX% = x: PENP.dispY% = y
            PENP_clamp_to_work_area
            CFG.PEN_PANEL_X% = PENP.dispX%: CFG.PEN_PANEL_Y% = PENP.dispY%
        CASE DP_ANIM
            ANIMP.docked = FALSE
            FPANEL_fit DP_ANIM, 0, 0 ' its natural size again
            ANIMP.dispX = x: ANIMP.dispY = y
            ANIMP_clamp_to_work_area
            CFG.ANIM_PANEL_X% = ANIMP.dispX: CFG.ANIM_PANEL_Y% = ANIMP.dispY
        CASE DP_SWATCH
            SWP.docked = FALSE
            FPANEL_fit DP_SWATCH, 0, 0 ' its own floating size again
            SWP.dispX = x: SWP.dispY = y
            SWP_clamp_to_work_area
            CFG.SWATCHES_X% = SWP.dispX: CFG.SWATCHES_Y% = SWP.dispY
        CASE DP_BROWSER
            DIM brRs AS SINGLE
            DOCK_BAND_SIDE = 0
            BROWSER.docked% = FALSE
            brRs = BROWSER.renderScale!: IF brRs <= 0 THEN brRs = 1
            BROWSER.dispW% = INT(CSNG(_MAX(CFG.BROWSER_WIDTH%, BROWSER_narrowest_w%)) * brRs + 0.5) ' its floating size (native px; kept while docked)
            BROWSER.dispH% = INT(CSNG(_MAX(CFG.BROWSER_HEIGHT%, BROWSER_MIN_H)) * brRs + 0.5)
            BROWSER.dispX% = x: BROWSER.dispY% = y
            BROWSER_clamp_size
            BROWSER_clamp_to_work_area
            IF BROWSER.initialized% THEN BROWSER_sync_fd_from_display
            CFG.BROWSER_POS_X% = BROWSER.dispX%: CFG.BROWSER_POS_Y% = BROWSER.dispY%
    END SELECT
    DOCK_change_commit DPANEL(id).title + " floating"
END SUB



FUNCTION DOCK_native_for_region% (rg AS INTEGER)
    SELECT CASE rg
        CASE REGION_PREVIEW: DOCK_native_for_region% = DP_PREVIEW
        CASE REGION_COLOR_MIXER: DOCK_native_for_region% = DP_MIXER
        CASE REGION_ADV_COLOR_PICKER: DOCK_native_for_region% = DP_ADVCP
        CASE REGION_COLOR_SPACE_3D: DOCK_native_for_region% = DP_CS3D
        CASE REGION_PEN_PANEL: DOCK_native_for_region% = DP_PEN
        CASE REGION_ANIM_PANEL: DOCK_native_for_region% = DP_ANIM
        CASE REGION_SWATCHES: DOCK_native_for_region% = DP_SWATCH
        CASE REGION_IMAGE_BROWSER: DOCK_native_for_region% = DP_BROWSER
    END SELECT
END FUNCTION
