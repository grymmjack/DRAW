''
' DRAW - GUI/DOCK.BM
' =============================================================================
' The dock tree (see DOCK.BI): panel registry, tree editing, the default tree
' built from today's dock keys, and DOCK_layout.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Is panel id showing (its own visibility flag)? The organizer and drawer
' follow the toolbar's Tab toggle too, as they always have.
FUNCTION DOCK_panel_shown% (id AS INTEGER)
    SELECT CASE id
        CASE DP_TOOLBOX: DOCK_panel_shown% = (SCRN.showToolbar% <> 0)
        CASE DP_ORGANIZER: DOCK_panel_shown% = (SCRN.showToolbar% <> 0 _ANDALSO ORGANIZER.visible% <> 0)
        CASE DP_DRAWER: DOCK_panel_shown% = (SCRN.showToolbar% <> 0 _ANDALSO DRAWER.visible% <> 0)
        CASE DP_LAYERS: DOCK_panel_shown% = (LAYER_PANEL.visible% <> 0)
        CASE DP_EDITBAR: DOCK_panel_shown% = (SCRN.showEditBar% <> 0)
        CASE DP_ADVBAR: DOCK_panel_shown% = (SCRN.showAdvBar% <> 0)
        CASE DP_CHARMAP: DOCK_panel_shown% = (SCRN.showCharMap% <> 0)
        CASE DP_PREVIEW: DOCK_panel_shown% = (PREVIEW.visible% <> 0 _ANDALSO PREVIEW.autoHidden% = 0)
        CASE DP_MIXER: DOCK_panel_shown% = (COLORMIXER.visible% <> 0 _ANDALSO COLORMIXER.autoHidden% = 0 _ANDALSO COLORMIXER.initialized% <> 0)
        CASE DP_ADVCP: DOCK_panel_shown% = (ADVCP.visible% <> 0 _ANDALSO ADVCP.autoHidden% = 0 _ANDALSO ADVCP.initialized% <> 0)
        CASE DP_CS3D: DOCK_panel_shown% = (CS3D.visible% <> 0 _ANDALSO CS3D.autoHidden% = 0 _ANDALSO CS3D.initialized% <> 0)
        CASE DP_PEN: DOCK_panel_shown% = (PENP.visible% <> 0 _ANDALSO PENP.autoHidden% = 0 _ANDALSO PENP.initialized% <> 0)
        CASE DP_BROWSER: DOCK_panel_shown% = (BROWSER.visible% <> 0 _ANDALSO BROWSER.autoHidden% = 0)
    END SELECT
END FUNCTION


''
' The width a panel wants (px) at its current setting.
FUNCTION DOCK_panel_w% (id AS INTEGER)
    SELECT CASE id
        CASE DP_TOOLBOX, DP_ORGANIZER, DP_DRAWER: DOCK_panel_w% = TOOLBOX_PANEL_W
        CASE DP_LAYERS: DOCK_panel_w% = LAYER_PANEL.width%
        CASE DP_EDITBAR: DOCK_panel_w% = EDITBAR_width%
        CASE DP_ADVBAR: DOCK_panel_w% = ADVBAR_width%
        CASE DP_CHARMAP: DOCK_panel_w% = CHARMAP_panel_width%
        CASE DP_PREVIEW: DOCK_panel_w% = PREVIEW.dispW%
        CASE DP_MIXER: DOCK_panel_w% = COLORMIXER.dispW%
        CASE DP_ADVCP: DOCK_panel_w% = ADVCP.dispW%
        CASE DP_CS3D: DOCK_panel_w% = CS3D.dispW%
        CASE DP_PEN: DOCK_panel_w% = PENP.dispW%
        CASE DP_BROWSER: DOCK_panel_w% = _MAX(BROWSER.dispW%, BROWSER_MIN_W)
    END SELECT
END FUNCTION


' =============================================================================
' The default tree: today's fixed order, from the dock keys
' =============================================================================

''
' Each side, outermost first: layers, the toolbox column (toolbox / organizer /
' drawer), advanced bar, edit bar, character map. Which side each one is on
' comes from the existing keys, read live, so every old way of switching sides
' (Ctrl+Shift+click a dock edge, workspace *_DOCK keys) keeps working.
SUB DOCK_build_default ()
    DIM side AS INTEGER, tbSide AS INTEGER, lpSide AS INTEGER, ebSide AS INTEGER, abSide AS INTEGER, cmSide AS INTEGER
    IF DPANEL(DP_TOOLBOX).nm = "" THEN DOCK_init_panels
    DOCK_clear
    IF UCASE$(_TRIM$(CFG.TOOLBOX_DOCK_EDGE)) = "RIGHT" THEN tbSide = DOCK_RIGHT ELSE tbSide = DOCK_LEFT
    IF UCASE$(_TRIM$(CFG.LAYERS_PANEL_DOCK_EDGE)) = "LEFT" THEN lpSide = DOCK_LEFT ELSE lpSide = DOCK_RIGHT
    IF EDIT_BAR.dockSide% = EDITBAR_DOCK_RIGHT THEN ebSide = DOCK_RIGHT ELSE ebSide = DOCK_LEFT
    IF ADV_BAR.dockSide% = ADVBAR_DOCK_RIGHT THEN abSide = DOCK_RIGHT ELSE abSide = DOCK_LEFT
    IF CHARMAP.dockSide% = CHARMAP_DOCK_LEFT THEN cmSide = DOCK_LEFT ELSE cmSide = DOCK_RIGHT
    FOR side = DOCK_LEFT TO DOCK_RIGHT
        IF lpSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_LAYERS))
        IF tbSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_TOOLBOX)) + "," + _TRIM$(STR$(DP_ORGANIZER)) + "," + _TRIM$(STR$(DP_DRAWER))
        IF abSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_ADVBAR))
        IF ebSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_EDITBAR))
        IF cmSide = side THEN DOCK_add_stack side, _TRIM$(STR$(DP_CHARMAP))
    NEXT side
    DOCK_READY = TRUE
END SUB


' =============================================================================
' Layout: the tree -> rects -> panels
' =============================================================================

''
' Is slot s showing this frame, and which of its tabs is? A tab whose panel is
' hidden is skipped; a slot with no shown tab takes no room.
FUNCTION DOCK_slot_panel% (s AS INTEGER)
    DIM t AS INTEGER
    IF s < 1 THEN EXIT FUNCTION
    IF DOCK_SLOT(s).act >= 1 _ANDALSO DOCK_SLOT(s).act <= DOCK_SLOT(s).ntabs THEN
        IF DOCK_panel_shown%(DOCK_TAB(s, DOCK_SLOT(s).act)) THEN DOCK_slot_panel% = DOCK_TAB(s, DOCK_SLOT(s).act): EXIT FUNCTION
    END IF
    FOR t = 1 TO DOCK_SLOT(s).ntabs
        IF DOCK_panel_shown%(DOCK_TAB(s, t)) THEN DOCK_slot_panel% = DOCK_TAB(s, t): EXIT FUNCTION
    NEXT t
END FUNCTION


''
' Fixed height (px, borders included) of a DP_H_FIXED panel in a column w wide.
FUNCTION DOCK_fixed_h% (id AS INTEGER, w AS INTEGER)
    DIM scl AS INTEGER
    SELECT CASE id
        CASE DP_TOOLBOX
            scl = CFG.TOOLBAR_SCALE%
            IF scl < 1 THEN scl = 1
            IF scl > 4 THEN scl = 4
            ' button rows + the bottom border row (the top border row sits just above)
            DOCK_fixed_h% = TB_LIVE_ROWS * TB_BTN_H * scl + (TB_LIVE_ROWS - 1) * TB_BTN_PADDING * scl + 1
        CASE DP_ORGANIZER
            DOCK_fixed_h% = ORGANIZER_height_for%(w)
        CASE DP_MIXER: DOCK_fixed_h% = COLORMIXER.dispH%
        CASE DP_ADVCP: DOCK_fixed_h% = ADVCP.dispH%
        CASE DP_CS3D: DOCK_fixed_h% = CS3D.dispH%
        CASE DP_PEN: DOCK_fixed_h% = PENP.dispH%
    END SELECT
END FUNCTION


''
' Smallest height a flex panel accepts (it overflows the column rather than
' shrink below it).
FUNCTION DOCK_min_h% (id AS INTEGER)
    DIM dScl AS INTEGER
    IF id = DP_DRAWER THEN
        dScl = USCALE.drawer%
        IF dScl < 1 THEN dScl = 1
        IF dScl > 4 THEN dScl = 4
        DOCK_min_h% = 32 * dScl
    END IF
END FUNCTION


''
' Does slot s draw a title / tab strip? Tabs, a collapsed slot, and a docked
' floating window (it lost its own title bar) do; the rest are chromeless.
FUNCTION DOCK_slot_titled% (s AS INTEGER)
    DIM id AS INTEGER
    IF DOCK_SLOT(s).ntabs > 1 _ORELSE DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN DOCK_slot_titled% = TRUE
END FUNCTION


''
' Stack column c's showing slots top to bottom inside its rect: fixed panels
' take their own height (two bordered panels share their frame row), flex
' panels share what is left by weight; a titled slot adds its strip, a
' collapsed one is only its strip. Slot rects include the strip; the panel
' gets the part below it (DOCK_apply_panel).
SUB DOCK_stack_column (c AS INTEGER)
    DIM o AS INTEGER, s AS INTEGER, id AS INTEGER, y AS INTEGER
    DIM fixedSum AS INTEGER, shareSum AS INTEGER, flexH AS INTEGER, h AS INTEGER, prevBordered AS INTEGER
    DIM lastFlex AS INTEGER, usedFlex AS INTEGER, th AS INTEGER, isFlex AS INTEGER
    DIM need AS INTEGER
    ' too short for everything: collapse slots to their strips from the bottom
    ' (not the first one) until it fits - the layout's own collapse, not saved
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        DOCK_SLOT(s).autoc = FALSE
    NEXT o
    DO
        need = DOCK_column_need%(c)
        IF need <= DOCK_COL(c).h THEN EXIT DO
        id = 0
        FOR o = DOCK_MAX_SLOTS TO 2 STEP -1
            s = DOCK_slot_at%(c, o)
            IF s THEN
                IF DOCK_slot_panel%(s) _ANDALSO DOCK_SLOT(s).collapsed = 0 _ANDALSO DOCK_SLOT(s).autoc = 0 THEN DOCK_SLOT(s).autoc = TRUE: id = s: EXIT FOR
            END IF
        NEXT o
        IF id = 0 THEN EXIT DO ' nothing left to collapse
    LOOP
    ' sizes first
    prevBordered = FALSE
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        id = DOCK_slot_panel%(s)
        DOCK_SLOT(s).vis = (id <> DP_NONE)
        IF id THEN
            th = 0
            IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
            IF DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN
                fixedSum = fixedSum + th
                prevBordered = FALSE
            ELSEIF DPANEL(id).hmode = DP_H_FIXED THEN
                fixedSum = fixedSum + th + DOCK_fixed_h%(id, DOCK_COL(c).w)
                IF prevBordered _ANDALSO DPANEL(id).bordered _ANDALSO th = 0 THEN fixedSum = fixedSum - 1
                prevBordered = DPANEL(id).bordered
            ELSE
                shareSum = shareSum + DOCK_SLOT(s).share
                lastFlex = s
                prevBordered = DPANEL(id).bordered
            END IF
        END IF
    NEXT o
    flexH = DOCK_COL(c).h - fixedSum
    ' then positions
    y = DOCK_COL(c).y
    prevBordered = FALSE
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        IF DOCK_SLOT(s).vis THEN
            id = DOCK_slot_panel%(s)
            th = 0
            IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
            isFlex = (DPANEL(id).hmode = DP_H_FLEX _ANDALSO DOCK_SLOT(s).collapsed = 0 _ANDALSO DOCK_SLOT(s).autoc = 0)
            IF prevBordered _ANDALSO DPANEL(id).bordered _ANDALSO th = 0 THEN y = y - 1 ' share the frame row
            IF DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN
                h = th
            ELSEIF DPANEL(id).hmode = DP_H_FIXED THEN
                h = th + DOCK_fixed_h%(id, DOCK_COL(c).w)
            ELSEIF s = lastFlex THEN
                h = flexH - usedFlex ' the last flex slot takes the rounding
            ELSE
                h = (flexH * DOCK_SLOT(s).share) \ shareSum
                usedFlex = usedFlex + h
            END IF
            IF isFlex _ANDALSO h - th < DOCK_min_h%(id) THEN h = th + DOCK_min_h%(id)
            DOCK_SLOT(s).x = DOCK_COL(c).x
            DOCK_SLOT(s).w = DOCK_COL(c).w
            DOCK_SLOT(s).y = y
            DOCK_SLOT(s).h = h
            y = y + h
            IF DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN prevBordered = FALSE ELSE prevBordered = DPANEL(id).bordered
        END IF
    NEXT o
END SUB


''
' Height column c needs at least: fixed panels + titles + flex minimums.
FUNCTION DOCK_column_need% (c AS INTEGER)
    DIM o AS INTEGER, s AS INTEGER, id AS INTEGER, need AS INTEGER, th AS INTEGER, prevB AS INTEGER
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        id = DOCK_slot_panel%(s)
        IF id THEN
            th = 0
            IF DOCK_slot_titled%(s) THEN th = DOCK_TITLE_H
            IF DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN
                need = need + th: prevB = FALSE
            ELSEIF DPANEL(id).hmode = DP_H_FIXED THEN
                need = need + th + DOCK_fixed_h%(id, DOCK_COL(c).w)
                IF prevB _ANDALSO DPANEL(id).bordered _ANDALSO th = 0 THEN need = need - 1
                prevB = DPANEL(id).bordered
            ELSE
                need = need + th + _MAX(DOCK_min_h%(id), DOCK_MIN_FLEX_H)
                prevB = DPANEL(id).bordered
            END IF
        END IF
    NEXT o
    DOCK_column_need% = need
END FUNCTION


''
' Hand slot s's rect to its panel (the panel-specific fields old code reads).
SUB DOCK_apply_panel (s AS INTEGER, side AS INTEGER, dockY2 AS INTEGER)
    DIM id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER
    id = DOCK_slot_panel%(s)
    IF id = DP_NONE _ORELSE DOCK_SLOT(s).collapsed _ORELSE DOCK_SLOT(s).autoc THEN EXIT SUB
    x = DOCK_SLOT(s).x: y = DOCK_SLOT(s).y: w = DOCK_SLOT(s).w: h = DOCK_SLOT(s).h
    IF DOCK_slot_titled%(s) THEN y = y + DOCK_TITLE_H: h = h - DOCK_TITLE_H
    DOCK_apply_rect id, x, y, w, h
END SUB


''
' Give panel id the rect (x, y, w, h): the fields its own code reads.
SUB DOCK_apply_rect (id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    DPANEL(id).rVis = TRUE
    DPANEL(id).rx = x: DPANEL(id).ry = y: DPANEL(id).rw = w: DPANEL(id).rh = h
    SELECT CASE id
        CASE DP_TOOLBOX
            SCRN.toolboxX% = x
            TB_RECT_X = x
            TB_RECT_Y = y
            TB_RECT_W = w
        CASE DP_ORGANIZER
            ORG_RECT_X = x: ORG_RECT_W = w
            ORG_RECT_Y = y: ORG_RECT_H = h
        CASE DP_DRAWER
            DRW_RECT_X = x: DRW_RECT_W = w
            DRW_RECT_Y = y: DRW_RECT_Y2 = y + h - 1
        CASE DP_LAYERS
            SCRN.layerPanelX% = x
            LAYER_PANEL.slotW% = w
            LAYER_PANEL.panelY1% = y: LAYER_PANEL.panelY2% = y + h - 1
        CASE DP_EDITBAR
            SCRN.editBarX% = x
            EDIT_BAR.slotW% = w
            EDIT_BAR.panelY1% = y: EDIT_BAR.panelY2% = y + h - 1
        CASE DP_ADVBAR
            SCRN.advBarX% = x
            ADV_BAR.slotW% = w
            ADV_BAR.panelY1% = y: ADV_BAR.panelY2% = y + h - 1
        CASE DP_CHARMAP
            SCRN.charMapX% = x
            CHARMAP.panelX1% = x
            CHARMAP.panelX2% = x + w - 1
            CHARMAP.panelY1% = y
            CHARMAP.panelY2% = y + h - 1
            REGION_set_bounds REGION_CHARMAP, CHARMAP.panelX1%, CHARMAP.panelY1%, CHARMAP.panelX2% - CHARMAP.panelX1% + 1, CHARMAP.panelY2% - CHARMAP.panelY1% + 1, ZORDER_PANEL
            IF CHARMAP.panelY2% < CHARMAP.panelY1% THEN CHARMAP.panelY2% = CHARMAP.panelY1%
            CHARMAP.panelW% = w
            CHARMAP.gridX% = CHARMAP.panelX1% + 2
            CHARMAP.gridY% = CHARMAP.panelY1% + 2
        CASE DP_MIXER
            COLORMIXER.docked% = TRUE
            COLORMIXER.dispX% = x + (w - COLORMIXER.dispW%) \ 2
            COLORMIXER.dispY% = y
        CASE DP_ADVCP
            ADVCP.docked% = TRUE
            ADVCP.dispX% = x + (w - ADVCP.dispW%) \ 2
            ADVCP.dispY% = y
        CASE DP_CS3D
            CS3D.docked% = TRUE
            CS3D.dispX% = x + (w - CS3D.dispW%) \ 2
            CS3D.dispY% = y
        CASE DP_PEN
            PENP.docked% = TRUE
            PENP.dispX% = x + (w - PENP.dispW%) \ 2
            PENP.dispY% = y
        CASE DP_PREVIEW
            DIM pvRs AS SINGLE
            PREVIEW_compute_display
            pvRs = PREVIEW.renderScale!
            IF pvRs <= 0 THEN pvRs = 1
            PREVIEW.docked% = TRUE
            PREVIEW.x% = x: PREVIEW.y% = y
            PREVIEW.w% = _MAX(PREVIEW_MIN_W, INT(w / pvRs))
            PREVIEW.h% = _MAX(PREVIEW_MIN_H, INT(h / pvRs))
            PREVIEW_compute_display
        CASE DP_BROWSER
            BROWSER.docked% = TRUE
            BROWSER.maximized% = FALSE
            BROWSER.dispX% = x: BROWSER.dispY% = y
            BROWSER.dispW% = w: BROWSER.dispH% = h
            IF BROWSER.initialized% THEN BROWSER_sync_fd_from_display ' its file-dialog rect follows (native px)
    END SELECT
END SUB


''
' The drag-resize id (GUI/DOCK-RESIZE) a column's inner edge drives: the column's
' main panel (toolbox > layers > advanced bar > edit bar; none for the charmap).
FUNCTION DOCK_col_resize_id% (c AS INTEGER)
    DIM o AS INTEGER, s AS INTEGER, t AS INTEGER, id AS INTEGER, best AS INTEGER, r AS INTEGER, rank AS INTEGER, bestRank AS INTEGER
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        FOR t = 1 TO DOCK_SLOT(s).ntabs
            id = DOCK_TAB(s, t)
            IF DOCK_panel_shown%(id) THEN
                SELECT CASE id
                    CASE DP_TOOLBOX: r = DOCK_TOOLBOX: rank = 4
                    CASE DP_LAYERS: r = DOCK_LAYERS: rank = 3
                    CASE DP_ADVBAR: r = DOCK_ADVBAR: rank = 2
                    CASE DP_EDITBAR: r = DOCK_EDITBAR: rank = 1
                    CASE ELSE: r = DOCK_NONE: rank = 0
                END SELECT
                IF rank > bestRank THEN bestRank = rank: best = r
            END IF
        NEXT t
    NEXT o
    DOCK_col_resize_id% = best
END FUNCTION


''
' Place one column (pass: full-height columns first, then the ones under the
' menu bar) from the outside in on its side; advances DOCK_LX / DOCK_RX.
SUB DOCK_place_columns (wantFull AS INTEGER, barY1 AS INTEGER, charTop AS INTEGER, dockY2 AS INTEGER)
    DIM side AS INTEGER, o AS INTEGER, c AS INTEGER, so AS INTEGER, s AS INTEGER, first AS INTEGER, rid AS INTEGER
    FOR side = DOCK_LEFT TO DOCK_RIGHT
        FOR o = 1 TO DOCK_MAX_COLS
            c = DOCK_col_at%(side, o)
            IF c = 0 THEN EXIT FOR
            IF DOCK_COL(c).vis _ANDALSO DOCK_COL(c).full = wantFull THEN
                IF side = DOCK_LEFT THEN
                    DOCK_COL(c).x = DOCK_LX
                    DOCK_LX = DOCK_LX + DOCK_COL(c).w
                ELSE
                    DOCK_RX = DOCK_RX - DOCK_COL(c).w
                    DOCK_COL(c).x = DOCK_RX + 1
                END IF
                IF wantFull THEN
                    DOCK_COL(c).y = 0
                ELSE
                    ' under the menu bar; the character map keeps its own rule
                    ' (menu bar shown at all, not whether it is auto-hidden)
                    DOCK_COL(c).y = barY1
                    first = DOCK_slot_panel%(DOCK_slot_at%(c, 1))
                    IF first = DP_CHARMAP THEN DOCK_COL(c).y = charTop
                END IF
                DOCK_COL(c).h = dockY2 - DOCK_COL(c).y + 1
                DOCK_stack_column c
                FOR so = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, so)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis THEN DOCK_apply_panel s, side, dockY2
                NEXT so
                rid = DOCK_col_resize_id%(c)
                IF rid THEN DOCK_set_edge rid, DOCK_COL(c).x, DOCK_COL(c).w, (side = DOCK_LEFT), DOCK_COL(c).y, dockY2
            END IF
        NEXT o
    NEXT side
END SUB


''
' The whole side layout (SCREEN_compute_layout): columns get widths from their
' panels, full-height columns go outermost, the menu bar spans the rest.
' Leaves DOCK_LX/DOCK_RX (the canvas edges) and DOCK_MENU_LX/RX.
SUB DOCK_layout (barY1 AS INTEGER, charTop AS INTEGER, dockY2 AS INTEGER)
    DIM c AS INTEGER, so AS INTEGER, s AS INTEGER, id AS INTEGER, w AS INTEGER, t AS INTEGER, i AS INTEGER
    IF DOCK_CUSTOM = 0 _ORELSE DOCK_READY = 0 THEN DOCK_build_default
    FOR i = 1 TO DP_COUNT: DPANEL(i).rVis = FALSE: NEXT i
    DOCK_native_reset_docked
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used THEN
            DOCK_COL(c).vis = FALSE
            DOCK_COL(c).full = FALSE
            w = 0
            FOR so = 1 TO DOCK_MAX_SLOTS
                s = DOCK_slot_at%(c, so)
                IF s = 0 THEN EXIT FOR
                id = DOCK_slot_panel%(s)
                IF id THEN
                    DOCK_COL(c).vis = TRUE
                    FOR t = 1 TO DOCK_SLOT(s).ntabs
                        IF DOCK_panel_shown%(DOCK_TAB(s, t)) THEN
                            IF DPANEL(DOCK_TAB(s, t)).tall THEN DOCK_COL(c).full = TRUE
                            IF DOCK_panel_w%(DOCK_TAB(s, t)) > w THEN w = DOCK_panel_w%(DOCK_TAB(s, t))
                        END IF
                    NEXT t
                END IF
            NEXT so
            IF DOCK_COL(c).wpx > 0 THEN w = DOCK_COL(c).wpx
            DOCK_COL(c).w = w
        END IF
    NEXT c
    DOCK_hide_for_width
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).autoh THEN DOCK_COL(c).vis = FALSE
    NEXT c
    ' full height spreads outward: a column outside a full-height one is full
    ' height too, so the menu bar (spanning the rest) stays one piece and the
    ' columns sit in their saved order
    DIM fside AS INTEGER, fo AS INTEGER, innerFull AS INTEGER, fc AS INTEGER
    FOR fside = DOCK_LEFT TO DOCK_RIGHT
        innerFull = 0
        FOR fo = 1 TO DOCK_MAX_COLS
            fc = DOCK_col_at%(fside, fo)
            IF fc = 0 THEN EXIT FOR
            IF DOCK_COL(fc).vis _ANDALSO DOCK_COL(fc).full THEN innerFull = fo
        NEXT fo
        FOR fo = 1 TO innerFull
            fc = DOCK_col_at%(fside, fo)
            IF fc THEN DOCK_COL(fc).full = TRUE
        NEXT fo
    NEXT fside
    DOCK_LAID_OUT = TRUE
    DOCK_LX = 0
    DOCK_RX = SCRN.w& - 1
    DOCK_place_columns TRUE, barY1, charTop, dockY2
    DOCK_MENU_LX = DOCK_LX
    DOCK_MENU_RX = DOCK_RX
    DOCK_place_columns FALSE, barY1, charTop, dockY2
    DOCK_place_floats barY1, dockY2
END SUB


''
' Floating docked panels: their window (title bar + frame) kept inside the
' canvas work area, the panel's rect inside the frame.
SUB DOCK_place_floats (barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM id AS INTEGER
    FOR id = 1 TO DP_COUNT
        IF DPANEL(id).fl _ANDALSO DPANEL(id).slot = 0 _ANDALSO DPANEL(id).floats = 0 THEN
            IF DOCK_panel_shown%(id) THEN
                DOCK_float_clamp id, barY1, dockY2
                DOCK_apply_rect id, DPANEL(id).fx + 1, DPANEL(id).fy + DOCK_TITLE_H, DPANEL(id).fw - 2, DPANEL(id).fh - DOCK_TITLE_H - 1
            END IF
        END IF
    NEXT id
END SUB


SUB DOCK_float_clamp (id AS INTEGER, barY1 AS INTEGER, dockY2 AS INTEGER)
    DIM minW AS INTEGER
    minW = DOCK_panel_w%(id) + 2
    IF DPANEL(id).fw < minW THEN DPANEL(id).fw = minW
    IF DPANEL(id).fh < DOCK_TITLE_H + 24 THEN DPANEL(id).fh = DOCK_TITLE_H + 24
    IF DPANEL(id).fw > DOCK_RX - DOCK_LX + 1 THEN DPANEL(id).fw = DOCK_RX - DOCK_LX + 1
    IF DPANEL(id).fh > dockY2 - barY1 + 1 THEN DPANEL(id).fh = dockY2 - barY1 + 1
    IF DPANEL(id).fx < DOCK_LX THEN DPANEL(id).fx = DOCK_LX
    IF DPANEL(id).fx + DPANEL(id).fw - 1 > DOCK_RX THEN DPANEL(id).fx = DOCK_RX - DPANEL(id).fw + 1
    IF DPANEL(id).fy < barY1 THEN DPANEL(id).fy = barY1
    IF DPANEL(id).fy + DPANEL(id).fh - 1 > dockY2 THEN DPANEL(id).fy = dockY2 - DPANEL(id).fh + 1
END SUB


''
' Render pass: paint the part of each column no panel covers as panel (and a
' drawer that has nothing to show), with the side bars' color and a border on
' the column's inner edge - never a black hole.
SUB DOCK_fill_columns ()
    DIM c AS INTEGER, so AS INTEGER, s AS INTEGER, lastY AS INTEGER, y2 AS INTEGER, id AS INTEGER
    DIM oldDest AS LONG
    oldDest& = _DEST
    _DEST SCRN.GUI&
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis THEN
            lastY = DOCK_COL(c).y - 1
            y2 = DOCK_COL(c).y + DOCK_COL(c).h - 1
            FOR so = 1 TO DOCK_MAX_SLOTS
                s = DOCK_slot_at%(c, so)
                IF s = 0 THEN EXIT FOR
                IF DOCK_SLOT(s).vis THEN
                    id = DOCK_slot_panel%(s)
                    IF id = DP_DRAWER _ANDALSO DRAWER.mode% = DRAWER_MODE_NONE THEN
                        DOCK_fill_rect c, DOCK_SLOT(s).y, _MIN(DOCK_SLOT(s).y + DOCK_SLOT(s).h - 1, y2)
                    END IF
                    lastY = DOCK_SLOT(s).y + DOCK_SLOT(s).h - 1
                END IF
            NEXT so
            IF lastY < y2 THEN DOCK_fill_rect c, lastY + 1, y2
        END IF
    NEXT c
    _DEST oldDest&
END SUB


SUB DOCK_fill_rect (c AS INTEGER, y1 AS INTEGER, y2 AS INTEGER)
    DIM x1 AS INTEGER, x2 AS INTEGER
    IF y2 < y1 THEN EXIT SUB
    x1 = DOCK_COL(c).x
    x2 = x1 + DOCK_COL(c).w - 1
    LINE (x1, y1)-(x2, y2), THEME.EDIT_BAR_BG_COLOR~&, BF
    IF DOCK_COL(c).side = DOCK_RIGHT THEN
        LINE (x1, y1)-(x1, y2), THEME.EDIT_BAR_LEFT_BORDER_COLOR~&
    ELSE
        LINE (x2, y1)-(x2, y2), THEME.EDIT_BAR_RIGHT_BORDER_COLOR~&
    END IF
END SUB



' =============================================================================
' Slot chrome: handles, title strips, the handle menu (P3)
' =============================================================================

''
' The handle of slot s: its title strip, the layers' own header, or the thin
' hover grip at the top of a chromeless panel. Returns FALSE when none.
FUNCTION DOCK_handle_rect% (s AS INTEGER, hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER)
    DIM id AS INTEGER
    IF DOCK_SLOT(s).used = 0 _ORELSE DOCK_SLOT(s).vis = 0 THEN EXIT FUNCTION
    id = DOCK_slot_panel%(s)
    IF id = DP_NONE THEN EXIT FUNCTION
    hx = DOCK_SLOT(s).x: hy = DOCK_SLOT(s).y: hw = DOCK_SLOT(s).w
    IF DOCK_slot_titled%(s) = 0 _ANDALSO DPANEL(id).floats THEN
        DOCK_handle_rect% = DOCK_native_grab%(id, hx, hy, hw, hh)
        EXIT FUNCTION
    END IF
    IF DOCK_slot_titled%(s) THEN
        hh = DOCK_TITLE_H
    ELSEIF id = DP_LAYERS THEN
        hh = THEME.LAYER_PANEL_header_height%
    ELSE
        hh = DOCK_GRIP_H
    END IF
    DOCK_handle_rect% = TRUE
END FUNCTION


''
' Slot whose handle is under (mx, my), 0 = none. Same guards as the edges:
' nothing floating over it, no menu or popup open.
FUNCTION DOCK_handle_at% (mx AS INTEGER, my AS INTEGER)
    DIM s AS INTEGER, hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER, rg AS INTEGER, only AS INTEGER
    IF DOCK_ui_busy% THEN EXIT FUNCTION
    rg = REGION_hit_test%(mx, my)
    SELECT CASE rg
        CASE REGION_GLOBAL, REGION_CANVAS, REGION_TOOLBAR, REGION_ORGANIZER, REGION_DRAWER, _
             REGION_EDIT_BAR, REGION_ADV_BAR, REGION_LAYER_PANEL, REGION_CHARMAP
        CASE ELSE
            ' over a native window: only its own handle (when it is docked)
            only = DOCK_native_for_region%(rg)
            IF only = 0 THEN EXIT FUNCTION
    END SELECT
    FOR s = 1 TO DOCK_MAX_SLOTS
        IF only _ANDALSO DOCK_slot_panel%(s) <> only THEN _CONTINUE
        IF DOCK_handle_rect%(s, hx, hy, hw, hh) THEN
            IF mx >= hx _ANDALSO mx < hx + hw _ANDALSO my >= hy _ANDALSO my < hy + hh THEN DOCK_handle_at% = s: EXIT FUNCTION
        END IF
    NEXT s
END FUNCTION


''
' Render pass (with the panels): title strips of titled slots.
SUB DOCK_render_titles ()
    DIM s AS INTEGER, id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, t AS INTEGER, tx AS INTEGER, lbl AS STRING
    DIM oldDest AS LONG, oldFont AS LONG
    oldDest& = _DEST
    oldFont& = _FONT
    _DEST SCRN.GUI&
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle& ELSE IF MENU_BAR.fontHandle& > 0 THEN _FONT MENU_BAR.fontHandle&
    FOR s = 1 TO DOCK_MAX_SLOTS
        IF DOCK_SLOT(s).used _ANDALSO DOCK_SLOT(s).vis THEN
            IF DOCK_slot_titled%(s) THEN
                x = DOCK_SLOT(s).x: y = DOCK_SLOT(s).y: w = DOCK_SLOT(s).w
                LINE (x, y)-(x + w - 1, y + DOCK_TITLE_H - 1), THEME.LAYER_PANEL_header_bg~&, BF
                LINE (x, y + DOCK_TITLE_H - 1)-(x + w - 1, y + DOCK_TITLE_H - 1), THEME.LAYER_PANEL_border~&
                ' chevron: open / collapsed
                COLOR THEME.LAYER_PANEL_header_fg~&, _RGBA32(0, 0, 0, 0)
                IF DOCK_SLOT(s).collapsed THEN lbl = ">" ELSE lbl = "v"
                _PRINTMODE _KEEPBACKGROUND
                _UPRINTSTRING (x + 2, y + 1), lbl
                tx = x + 10
                FOR t = 1 TO DOCK_SLOT(s).ntabs
                    id = DOCK_TAB(s, t)
                    lbl = DPANEL(id).title
                    IF DOCK_SLOT(s).ntabs > 1 _ANDALSO t = DOCK_SLOT(s).act THEN
                        LINE (tx - 2, y)-(tx + _UPRINTWIDTH(lbl) + 1, y + DOCK_TITLE_H - 2), THEME.LAYER_PANEL_bg~&, BF
                    END IF
                    IF DOCK_SLOT(s).ntabs > 1 _ANDALSO t <> DOCK_SLOT(s).act THEN COLOR THEME.LAYER_PANEL_header_fg_dim~&, _RGBA32(0, 0, 0, 0) ELSE COLOR THEME.LAYER_PANEL_header_fg~&, _RGBA32(0, 0, 0, 0)
                    _UPRINTSTRING (tx, y + 1), lbl
                    tx = tx + _UPRINTWIDTH(lbl) + 8
                    IF tx > x + w - 4 THEN EXIT FOR
                NEXT t
            END IF
        END IF
    NEXT s
    _FONT oldFont&
    _DEST oldDest&
END SUB


''
' Overlay pass (after SkipToPointer): the hover grip and the handle menu.
SUB DOCK_overlay_render ()
    DIM s AS INTEGER, hx AS INTEGER, hy AS INTEGER, hw AS INTEGER, hh AS INTEGER, i AS INTEGER, font AS LONG
    DIM oldDest AS LONG
    oldDest& = _DEST
    _DEST SCRN.CANVAS&
    s = DOCK_UI.hoverSlot
    IF s _ANDALSO DOCK_UI.menuOpen = 0 _ANDALSO DOCK_DRAG.which = 0 _ANDALSO DOCK_UI.mvActive = 0 THEN
        IF DOCK_handle_rect%(s, hx, hy, hw, hh) THEN
            IF hh = DOCK_GRIP_H THEN
                LINE (hx, hy)-(hx + hw - 1, hy + hh - 1), THEME.EDIT_BAR_ICON_MOUSE_OUTLINE_COLOR~&, BF
                FOR i = hx + hw \ 2 - 6 TO hx + hw \ 2 + 6 STEP 3
                    PSET (i, hy + 1), THEME.EDIT_BAR_BG_COLOR~&
                NEXT i
            ELSE
                LINE (hx, hy)-(hx + hw - 1, hy + hh - 1), THEME.EDIT_BAR_ICON_MOUSE_OUTLINE_COLOR~&, B
            END IF
        END IF
    END IF
    DOCK_move_render
    IF DOCK_UI.menuOpen THEN
        DOCK_menu_build DOCK_UI.menuPanel
        IF MENU_BAR.fontHandle& > 0 THEN font = MENU_BAR.fontHandle&
        POPUP_MENU_render SCRN.CANVAS&, DOCK_UI.menuX, DOCK_UI.menuY, DOCK_UI.menuW, DOCK_UI.menuN, DOCK_MENU_ITEM_H, DOCK_UI.menuHover, font
    END IF
    _DEST oldDest&
END SUB


''
' The handle menu's rows for panel id (POPUP_MENU_* arrays).
SUB DOCK_menu_build (id AS INTEGER)
    DIM n AS INTEGER, side AS INTEGER, s AS INTEGER, fl AS INTEGER
    POPUP_MENU_clear_items
    s = DPANEL(id).slot
    IF s > 0 THEN side = DOCK_COL(DOCK_SLOT(s).col).side
    POPUP_MENU_set_item n, DPANEL(id).title, "", -1, POPUP_MENU_FLAG_DISABLED: n = n + 1
    POPUP_MENU_set_item n, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: n = n + 1
    IF DPANEL(id).floats _ANDALSO s = 0 THEN
        POPUP_MENU_set_item n, "Dock Left", "", DOCK_ACT_LEFT, 0: n = n + 1
        POPUP_MENU_set_item n, "Dock Right", "", DOCK_ACT_RIGHT, 0: n = n + 1
        DOCK_UI.menuN = n
        EXIT SUB
    END IF
    POPUP_MENU_set_item n, "Move to Left Edge", "", DOCK_ACT_LEFT, 0: n = n + 1
    POPUP_MENU_set_item n, "Move to Right Edge", "", DOCK_ACT_RIGHT, 0: n = n + 1
    IF s > 0 THEN
        IF DOCK_SLOT(s).collapsed THEN POPUP_MENU_set_item n, "Expand", "", DOCK_ACT_COLLAPSE, 0 ELSE POPUP_MENU_set_item n, "Collapse to Title", "", DOCK_ACT_COLLAPSE, 0
        n = n + 1
    END IF
    IF DOCK_floating%(id) THEN
        POPUP_MENU_set_item n, "Dock Back", "", DOCK_ACT_DOCKBACK, 0: n = n + 1
    ELSE
        POPUP_MENU_set_item n, "Float", "", DOCK_ACT_FLOAT, 0: n = n + 1
    END IF
    POPUP_MENU_set_item n, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: n = n + 1
    POPUP_MENU_set_item n, "Reset Arrangement", "", DOCK_ACT_RESET, 0: n = n + 1
    DOCK_UI.menuN = n
END SUB


SUB DOCK_menu_open (id AS INTEGER, mx AS INTEGER, my AS INTEGER)
    DIM font AS LONG, ph AS INTEGER, px AS INTEGER, py AS INTEGER
    DOCK_menu_build id
    IF MENU_BAR.fontHandle& > 0 THEN font = MENU_BAR.fontHandle&
    DOCK_UI.menuW = POPUP_MENU_measure_width%(DOCK_UI.menuN, font)
    POPUP_MENU_place mx, my, DOCK_UI.menuW, DOCK_UI.menuN, DOCK_MENU_ITEM_H, px, py, ph
    DOCK_UI.menuX = px: DOCK_UI.menuY = py
    DOCK_UI.menuPanel = id
    DOCK_UI.menuHover = -1
    DOCK_UI.menuOpen = TRUE
    DOCK_redraw
END SUB


SUB DOCK_redraw ()
    GUI_NEEDS_REDRAW% = TRUE
    FRAME_IDLE% = FALSE
    INVALIDATE_scene
END SUB


''
' Before changing the arrangement: inside a workspace that has not replaced it
' yet, remember the user's own so leaving the workspace puts it back.
SUB DOCK_change_begin ()
    IF DOCK_READY = 0 THEN DOCK_build_default
    IF WS_ACTIVE _ANDALSO WS_DOCK_TOUCHED = 0 THEN
        WS_DOCK_USER_SNAP = DOCK_snapshot$
        WS_DOCK_TOUCHED = TRUE
    END IF
    ' from here the tree is custom: DOCK_layout must stop rebuilding the
    ' default one from the dock keys (a live drag would be undone every frame)
    DOCK_CUSTOM = TRUE
    DOCK_READY = TRUE
END SUB


''
' After changing it: it is custom now (not rebuilt from the dock keys) and is
' saved - into the active workspace, else DRAW.cfg.
SUB DOCK_change_commit (msg AS STRING)
    DOCK_CUSTOM = TRUE
    DOCK_READY = TRUE
    IF WS_ACTIVE THEN WSC_save_dock WS_ACTIVE_ID ELSE CONFIG_save
    IF LEN(msg) THEN STATUS_flash msg
    DOCK_redraw
END SUB


SUB DOCK_menu_do (act AS INTEGER)
    DIM id AS INTEGER, c AS INTEGER
    id = DOCK_UI.menuPanel
    SELECT CASE act
        CASE DOCK_ACT_LEFT, DOCK_ACT_RIGHT
            DOCK_change_begin
            IF act = DOCK_ACT_LEFT THEN
                c = DOCK_move_to_new_col%(id, DOCK_LEFT, DOCK_MAX_COLS + 1)
            ELSE
                c = DOCK_move_to_new_col%(id, DOCK_RIGHT, DOCK_MAX_COLS + 1)
            END IF
            DOCK_change_commit DPANEL(id).title + " moved"
        CASE DOCK_ACT_COLLAPSE
            DOCK_toggle_collapse DPANEL(id).slot
        CASE DOCK_ACT_FLOAT
            IF DPANEL(id).floats THEN DOCK_native_undock id, DOCK_LX + 40, 60 ELSE DOCK_float_panel id, DOCK_LX + 40, 60
        CASE DOCK_ACT_DOCKBACK
            DOCK_dock_back id
        CASE DOCK_ACT_RESET
            DOCK_change_begin
            DOCK_CUSTOM = FALSE
            DOCK_READY = FALSE
            DOCK_build_default
            IF WS_ACTIVE THEN WSC_save_dock WS_ACTIVE_ID ELSE CONFIG_save
            STATUS_flash "Panel arrangement reset"
            DOCK_redraw
    END SELECT
END SUB


''
' MOUSE_process_frame (via DOCK_handle_mouse%): the handle menu and handles.
' Returns TRUE when it took the click.
FUNCTION DOCK_handle_chrome% (mx AS INTEGER, my AS INTEGER)
    DIM hit AS INTEGER, s AS INTEGER, hv AS INTEGER
    IF DOCK_UI.menuOpen THEN
        hv = POPUP_MENU_hover_row%(DOCK_UI.menuX, DOCK_UI.menuY, DOCK_UI.menuW, DOCK_UI.menuN, DOCK_MENU_ITEM_H, mx, my)
        IF hv <> DOCK_UI.menuHover THEN DOCK_UI.menuHover = hv: FRAME_IDLE% = FALSE
        IF (MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0) _ORELSE (MOUSE.B2% _ANDALSO MOUSE.OLD_B2% = 0) THEN
            DOCK_menu_build DOCK_UI.menuPanel
            hit = POPUP_MENU_hit_value%(DOCK_UI.menuX, DOCK_UI.menuY, DOCK_UI.menuW, DOCK_UI.menuN, DOCK_MENU_ITEM_H, mx, my)
            IF hit <> -1 THEN
                DOCK_UI.menuOpen = FALSE
                DOCK_redraw
                IF hit > 0 THEN DOCK_menu_do hit
            END IF
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
        END IF
        EXIT FUNCTION
    END IF
    ' hover (no buttons held): which handle is under the pointer
    IF MOUSE.B1% = 0 _ANDALSO MOUSE.B2% = 0 THEN
        s = DOCK_handle_at%(mx, my)
        IF s <> DOCK_UI.hoverSlot THEN DOCK_UI.hoverSlot = s: FRAME_IDLE% = FALSE
    END IF
    ' right-click a handle: the dock menu for its panel
    IF MOUSE.B2% _ANDALSO MOUSE.OLD_B2% = 0 THEN
        s = DOCK_native_float_title_at%(mx, my)
        IF s THEN
            DOCK_menu_open s, mx, my
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
            EXIT FUNCTION
        END IF
        s = DOCK_float_title_at%(mx, my)
        IF s THEN
            DOCK_menu_open s, mx, my
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
            EXIT FUNCTION
        END IF
        s = DOCK_handle_at%(mx, my)
        IF s THEN
            DOCK_menu_open DOCK_slot_panel%(s), mx, my
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_chrome% = TRUE
        END IF
    END IF
END FUNCTION



' =============================================================================
' Slot dividers (P3): the boundary between two stacked flexible slots
' =============================================================================

FUNCTION DOCK_slot_flex% (s AS INTEGER)
    DIM id AS INTEGER
    IF DOCK_SLOT(s).used = 0 _ORELSE DOCK_SLOT(s).vis = 0 _ORELSE DOCK_SLOT(s).collapsed THEN EXIT FUNCTION
    id = DOCK_slot_panel%(s)
    IF id THEN DOCK_slot_flex% = (DPANEL(id).hmode = DP_H_FLEX)
END FUNCTION


''
' The divider under (mx, my): slot above in a, below in b (TRUE when found).
' Two showing flex slots next to each other in one column.
FUNCTION DOCK_divider_at% (mx AS INTEGER, my AS INTEGER, a AS INTEGER, b AS INTEGER)
    DIM c AS INTEGER, o AS INTEGER, s AS INTEGER, prev AS INTEGER
    IF DOCK_ui_busy% THEN EXIT FUNCTION
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis THEN
            IF mx >= DOCK_COL(c).x _ANDALSO mx < DOCK_COL(c).x + DOCK_COL(c).w THEN
                prev = 0
                FOR o = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, o)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis THEN
                        IF prev _ANDALSO DOCK_slot_flex%(prev) _ANDALSO DOCK_slot_flex%(s) THEN
                            IF my >= DOCK_SLOT(s).y - 2 _ANDALSO my <= DOCK_SLOT(s).y + 1 THEN
                                a = prev: b = s
                                DOCK_divider_at% = TRUE
                                EXIT FUNCTION
                            END IF
                        END IF
                        prev = s
                    END IF
                NEXT o
            END IF
        END IF
    NEXT c
END FUNCTION


''
' Turn the shares of column c's flex slots into their current pixel heights,
' so moving one divider leaves every other slot where it is.
SUB DOCK_shares_to_px (c AS INTEGER)
    DIM o AS INTEGER, s AS INTEGER
    FOR o = 1 TO DOCK_MAX_SLOTS
        s = DOCK_slot_at%(c, o)
        IF s = 0 THEN EXIT FOR
        IF DOCK_slot_flex%(s) THEN DOCK_SLOT(s).share = _MAX(1, DOCK_SLOT(s).h)
    NEXT o
END SUB


''
' DOCK_handle_mouse%: grab / drag / drop a divider. TRUE when it took the frame.
FUNCTION DOCK_handle_divider% (mx AS INTEGER, my AS INTEGER)
    DIM a AS INTEGER, b AS INTEGER, ha AS INTEGER, minA AS INTEGER, minB AS INTEGER
    IF DOCK_UI.divA THEN
        a = DOCK_UI.divA: b = DOCK_UI.divB
        minA = _MAX(DOCK_MIN_FLEX_H, DOCK_min_h%(DOCK_slot_panel%(a)))
        minB = _MAX(DOCK_MIN_FLEX_H, DOCK_min_h%(DOCK_slot_panel%(b)))
        ha = my - DOCK_UI.divTop
        IF ha < minA THEN ha = minA
        IF ha > DOCK_UI.divTotal - minB THEN ha = DOCK_UI.divTotal - minB
        IF ha <> DOCK_SLOT(a).share _ORELSE DOCK_UI.divTotal - ha <> DOCK_SLOT(b).share THEN
            DOCK_SLOT(a).share = ha
            DOCK_SLOT(b).share = DOCK_UI.divTotal - ha
            DOCK_redraw
        END IF
        IF MOUSE.B1% = 0 THEN
            DOCK_UI.divA = 0
            DOCK_change_commit ""
        END IF
        MOUSE.UI_CHROME_CLICKED% = TRUE
        DOCK_handle_divider% = TRUE
        EXIT FUNCTION
    END IF
    IF MOUSE.B1% = 0 _ANDALSO MOUSE.B2% = 0 THEN
        DOCK_UI.divHover = DOCK_divider_at%(mx, my, a, b)
    END IF
    IF MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0 THEN
        IF DOCK_divider_at%(mx, my, a, b) THEN
            DOCK_change_begin
            DOCK_shares_to_px DOCK_SLOT(a).col
            DOCK_UI.divA = a: DOCK_UI.divB = b
            DOCK_UI.divTop = DOCK_SLOT(a).y
            DOCK_UI.divTotal = DOCK_SLOT(a).h + DOCK_SLOT(b).h
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_divider% = TRUE
        END IF
    END IF
END FUNCTION



' =============================================================================
' Moving a panel by its handle (P3): drop targets, preview, apply
' =============================================================================

''
' What dropping the panel being moved at (mx, my) would do: fills the
' DOCK_UI.tgt* fields (kind + where + the preview rect).
SUB DOCK_drop_target (mx AS INTEGER, my AS INTEGER)
    DIM c AS INTEGER, s AS INTEGER, third AS INTEGER, side AS INTEGER, o AS INTEGER, y1 AS INTEGER, y2 AS INTEGER
    DIM pw AS INTEGER, mv AS INTEGER, inner AS INTEGER
    mv = DOCK_UI.mvPanel
    DOCK_UI.tgtKind = DOCK_TGT_NONE
    y1 = 0
    y2 = SCRN.h& - SCREEN_bottom_bars_h% - 1
    pw = DOCK_panel_w%(mv)
    IF pw < 16 THEN pw = 16
    ' the screen edges: a new outermost column
    IF mx < DOCK_EDGE_ZONE _ORELSE mx >= SCRN.w& - DOCK_EDGE_ZONE THEN
        DOCK_UI.tgtKind = DOCK_TGT_NEWCOL
        IF mx < DOCK_EDGE_ZONE THEN
            DOCK_UI.tgtSide = DOCK_LEFT: DOCK_UI.tgtX = 0
        ELSE
            DOCK_UI.tgtSide = DOCK_RIGHT: DOCK_UI.tgtX = SCRN.w& - pw
        END IF
        DOCK_UI.tgtOrd = 1
        DOCK_UI.tgtY = y1: DOCK_UI.tgtW = pw: DOCK_UI.tgtH = y2 - y1 + 1
        EXIT SUB
    END IF
    ' over a column
    FOR c = 1 TO DOCK_MAX_COLS
        IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis THEN
            IF mx >= DOCK_COL(c).x _ANDALSO mx < DOCK_COL(c).x + DOCK_COL(c).w THEN
                side = DOCK_COL(c).side
                ' near the column's inner side: a new column next to it, toward the canvas
                IF side = DOCK_LEFT THEN inner = (mx >= DOCK_COL(c).x + DOCK_COL(c).w - 6) ELSE inner = (mx < DOCK_COL(c).x + 6)
                IF inner THEN
                    DOCK_UI.tgtKind = DOCK_TGT_NEWCOL
                    DOCK_UI.tgtSide = side
                    DOCK_UI.tgtOrd = DOCK_COL(c).ord + 1
                    IF side = DOCK_LEFT THEN DOCK_UI.tgtX = DOCK_COL(c).x + DOCK_COL(c).w - pw \ 2 ELSE DOCK_UI.tgtX = DOCK_COL(c).x - pw \ 2
                    DOCK_UI.tgtY = DOCK_COL(c).y: DOCK_UI.tgtW = pw: DOCK_UI.tgtH = DOCK_COL(c).h
                    EXIT SUB
                END IF
                ' over one of its slots: split above / tab / split below
                FOR o = 1 TO DOCK_MAX_SLOTS
                    s = DOCK_slot_at%(c, o)
                    IF s = 0 THEN EXIT FOR
                    IF DOCK_SLOT(s).vis _ANDALSO my >= DOCK_SLOT(s).y _ANDALSO my < DOCK_SLOT(s).y + DOCK_SLOT(s).h THEN
                        third = DOCK_SLOT(s).h \ 3
                        IF third < 4 THEN third = 4
                        DOCK_UI.tgtX = DOCK_SLOT(s).x: DOCK_UI.tgtW = DOCK_SLOT(s).w
                        IF my < DOCK_SLOT(s).y + third THEN
                            DOCK_UI.tgtKind = DOCK_TGT_SPLIT: DOCK_UI.tgtCol = c: DOCK_UI.tgtOrd = DOCK_SLOT(s).ord
                            DOCK_UI.tgtY = DOCK_SLOT(s).y: DOCK_UI.tgtH = third
                        ELSEIF my >= DOCK_SLOT(s).y + DOCK_SLOT(s).h - third THEN
                            DOCK_UI.tgtKind = DOCK_TGT_SPLIT: DOCK_UI.tgtCol = c: DOCK_UI.tgtOrd = DOCK_SLOT(s).ord + 1
                            DOCK_UI.tgtY = DOCK_SLOT(s).y + DOCK_SLOT(s).h - third: DOCK_UI.tgtH = third
                        ELSE
                            DOCK_UI.tgtKind = DOCK_TGT_TAB: DOCK_UI.tgtSlot = s
                            DOCK_UI.tgtY = DOCK_SLOT(s).y: DOCK_UI.tgtH = DOCK_SLOT(s).h
                        END IF
                        ' onto its own slot: only a split that changes nothing - no target
                        IF DOCK_SLOT(s).ntabs = 1 _ANDALSO DOCK_TAB(s, 1) = mv THEN DOCK_UI.tgtKind = DOCK_TGT_NONE
                        EXIT SUB
                    END IF
                NEXT o
            END IF
        END IF
    NEXT c
    ' next to the canvas side of the innermost column: a new innermost column
    ' (elsewhere over the canvas: float it there)
    IF mx >= DOCK_LX + DOCK_EDGE_ZONE _ANDALSO mx <= DOCK_RX - DOCK_EDGE_ZONE THEN
        DOCK_UI.tgtKind = DOCK_TGT_FLOAT
        DOCK_UI.tgtX = mx - 8: DOCK_UI.tgtY = my - 4
        DOCK_UI.tgtW = DOCK_panel_w%(mv) + 2: DOCK_UI.tgtH = _MIN(260, _MAX(60, DPANEL(mv).rh)) + DOCK_TITLE_H + 1
        EXIT SUB
    END IF
    IF mx >= DOCK_LX _ANDALSO mx < DOCK_LX + DOCK_EDGE_ZONE THEN
        DOCK_UI.tgtKind = DOCK_TGT_NEWCOL: DOCK_UI.tgtSide = DOCK_LEFT: DOCK_UI.tgtOrd = DOCK_MAX_COLS + 1
        DOCK_UI.tgtX = DOCK_LX: DOCK_UI.tgtY = y1: DOCK_UI.tgtW = pw: DOCK_UI.tgtH = y2 - y1 + 1
    ELSEIF mx <= DOCK_RX _ANDALSO mx > DOCK_RX - DOCK_EDGE_ZONE THEN
        DOCK_UI.tgtKind = DOCK_TGT_NEWCOL: DOCK_UI.tgtSide = DOCK_RIGHT: DOCK_UI.tgtOrd = DOCK_MAX_COLS + 1
        DOCK_UI.tgtX = DOCK_RX - pw + 1: DOCK_UI.tgtY = y1: DOCK_UI.tgtW = pw: DOCK_UI.tgtH = y2 - y1 + 1
    END IF
END SUB


''
' Drop the panel being moved on the current target.
SUB DOCK_drop_apply ()
    DIM mv AS INTEGER, r AS INTEGER, c AS INTEGER, s AS INTEGER
    mv = DOCK_UI.mvPanel
    IF DOCK_UI.tgtKind = DOCK_TGT_NONE THEN EXIT SUB
    IF DOCK_UI.tgtKind = DOCK_TGT_FLOAT THEN
        IF DPANEL(mv).floats THEN
            IF DPANEL(mv).slot > 0 THEN DOCK_native_undock mv, DOCK_UI.tgtX, DOCK_UI.tgtY
        ELSEIF DOCK_floating%(mv) = 0 THEN
            DOCK_float_panel mv, DOCK_UI.tgtX, DOCK_UI.tgtY
        END IF
        EXIT SUB
    END IF
    DOCK_change_begin
    SELECT CASE DOCK_UI.tgtKind
        CASE DOCK_TGT_NEWCOL
            r = DOCK_move_to_new_col%(mv, DOCK_UI.tgtSide, DOCK_UI.tgtOrd)
        CASE DOCK_TGT_SPLIT
            ' the target column may renumber when the panel leaves it (same column)
            c = DOCK_UI.tgtCol
            IF DPANEL(mv).slot > 0 _ANDALSO DOCK_SLOT(DPANEL(mv).slot).col = c _ANDALSO DOCK_SLOT(DPANEL(mv).slot).ntabs = 1 _ANDALSO DOCK_SLOT(DPANEL(mv).slot).ord < DOCK_UI.tgtOrd THEN DOCK_UI.tgtOrd = DOCK_UI.tgtOrd - 1
            r = DOCK_move_to_slot%(mv, c, DOCK_UI.tgtOrd)
        CASE DOCK_TGT_TAB
            r = DOCK_move_to_tab%(mv, DOCK_UI.tgtSlot)
    END SELECT
    DOCK_change_commit DPANEL(mv).title + " moved"
END SUB


''
' DOCK_handle_mouse%: press on a handle, drag past the threshold, drop.
' TRUE when it took the frame.
FUNCTION DOCK_handle_move% (mx AS INTEGER, my AS INTEGER)
    DIM s AS INTEGER
    IF DOCK_UI.mvNative THEN EXIT FUNCTION ' its own drag code runs it
    IF DOCK_UI.mvPanel THEN
        IF DOCK_UI.mvActive = 0 THEN
            IF ABS(mx - DOCK_UI.mvX0) + ABS(my - DOCK_UI.mvY0) >= DOCK_DRAG_START THEN DOCK_UI.mvActive = TRUE
        END IF
        IF DOCK_UI.mvActive THEN
            DOCK_drop_target mx, my
            ' a floating window follows the pointer unless it is over a dock target
            IF DOCK_UI.mvFloat _ANDALSO (DOCK_UI.tgtKind = DOCK_TGT_NONE _ORELSE DOCK_UI.tgtKind = DOCK_TGT_FLOAT) THEN
                DPANEL(DOCK_UI.mvPanel).fx = mx - DOCK_UI.mvOffX
                DPANEL(DOCK_UI.mvPanel).fy = my - DOCK_UI.mvOffY
                DOCK_UI.tgtKind = DOCK_TGT_NONE
                DOCK_redraw
            END IF
            FRAME_IDLE% = FALSE
        END IF
        ' right button cancels a move
        IF MOUSE.B2% _ANDALSO MOUSE.OLD_B2% = 0 THEN
            DOCK_UI.mvPanel = 0: DOCK_UI.mvActive = FALSE: DOCK_UI.tgtKind = DOCK_TGT_NONE
            STATUS_flash "Move cancelled"
            DOCK_redraw
        ELSEIF MOUSE.B1% = 0 THEN
            IF DOCK_UI.mvActive THEN
                IF DOCK_UI.mvFloat _ANDALSO DOCK_UI.tgtKind = DOCK_TGT_NONE THEN
                    DOCK_float_moved DOCK_UI.mvPanel
                ELSE
                    DOCK_drop_apply
                END IF
            ELSEIF DOCK_UI.mvFloat THEN
                DOCK_float_click DOCK_UI.mvPanel
            ELSE
                DOCK_title_click DOCK_UI.mvSlot, DOCK_UI.mvX0
            END IF
            DOCK_UI.mvPanel = 0: DOCK_UI.mvActive = FALSE: DOCK_UI.tgtKind = DOCK_TGT_NONE
            DOCK_redraw
        END IF
        MOUSE.UI_CHROME_CLICKED% = TRUE
        DOCK_handle_move% = TRUE
        EXIT FUNCTION
    END IF
    IF MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0 THEN
        ' a floating panel's title bar
        s = DOCK_float_title_at%(mx, my)
        IF s THEN
            DOCK_UI.mvPanel = s: DOCK_UI.mvSlot = 0: DOCK_UI.mvFloat = TRUE
            DOCK_UI.mvOffX = mx - DPANEL(s).fx: DOCK_UI.mvOffY = my - DPANEL(s).fy
            DOCK_UI.mvActive = FALSE
            DOCK_UI.mvX0 = mx: DOCK_UI.mvY0 = my
            DOCK_UI.tgtKind = DOCK_TGT_NONE
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_move% = TRUE
            EXIT FUNCTION
        END IF
        s = DOCK_handle_at%(mx, my)
        IF s THEN
            DOCK_UI.mvFloat = FALSE
            DOCK_UI.mvPanel = DOCK_slot_panel%(s)
            IF DOCK_slot_titled%(s) THEN
                IF DOCK_tab_at%(s, mx) > 0 THEN DOCK_UI.mvPanel = DOCK_TAB(s, DOCK_tab_at%(s, mx))
            END IF
            DOCK_UI.mvSlot = s
            DOCK_UI.mvActive = FALSE
            DOCK_UI.mvX0 = mx: DOCK_UI.mvY0 = my
            DOCK_UI.tgtKind = DOCK_TGT_NONE
            MOUSE.UI_CHROME_CLICKED% = TRUE
            DOCK_handle_move% = TRUE
        END IF
    END IF
END FUNCTION


''
' Overlay: the drop preview while a panel is being moved.
SUB DOCK_move_render ()
    DIM lbl AS STRING, tx AS INTEGER, ty AS INTEGER
    IF DOCK_UI.mvActive = 0 THEN EXIT SUB
    IF DOCK_UI.mvNative _ANDALSO DOCK_UI.tgtKind = DOCK_TGT_NONE THEN EXIT SUB ' an ordinary window drag
    IF DOCK_UI.tgtKind <> DOCK_TGT_NONE THEN
        LINE (DOCK_UI.tgtX, DOCK_UI.tgtY)-(DOCK_UI.tgtX + DOCK_UI.tgtW - 1, DOCK_UI.tgtY + DOCK_UI.tgtH - 1), _RGBA32(80, 160, 255, 80), BF
        LINE (DOCK_UI.tgtX, DOCK_UI.tgtY)-(DOCK_UI.tgtX + DOCK_UI.tgtW - 1, DOCK_UI.tgtY + DOCK_UI.tgtH - 1), _RGBA32(120, 190, 255, 220), B
    END IF
    lbl = DPANEL(DOCK_UI.mvPanel).title
    SELECT CASE DOCK_UI.tgtKind
        CASE DOCK_TGT_NEWCOL: lbl = lbl + ": new column"
        CASE DOCK_TGT_SPLIT: lbl = lbl + ": stack here"
        CASE DOCK_TGT_TAB: lbl = lbl + ": add as a tab"
        CASE DOCK_TGT_FLOAT: lbl = lbl + ": float here"
        CASE ELSE: lbl = lbl + ": drop on a dock"
    END SELECT
    tx = MOUSE.RAW_X% + 10: ty = MOUSE.RAW_Y% + 10
    ' a native window draws over the canvas (and is held inside the work area,
    ' so it may lag the pointer): put the label above its title bar
    IF DOCK_UI.mvNative THEN
        DIM gx AS INTEGER, gy AS INTEGER, gw AS INTEGER, gh AS INTEGER
        IF DOCK_native_grab%(DOCK_UI.mvPanel, gx, gy, gw, gh) THEN
            IF gy - _UFONTHEIGHT - 6 >= 2 THEN ty = gy - _UFONTHEIGHT - 6
        END IF
    END IF
    IF tx + _UPRINTWIDTH(lbl) + 6 > SCRN.w& THEN tx = SCRN.w& - _UPRINTWIDTH(lbl) - 6
    LINE (tx - 3, ty - 2)-(tx + _UPRINTWIDTH(lbl) + 2, ty + _UFONTHEIGHT + 1), _RGBA32(20, 24, 32, 230), BF
    COLOR _RGB32(230, 235, 245), 0
    _PRINTMODE _KEEPBACKGROUND
    _UPRINTSTRING (tx, ty), lbl
END SUB



''
' Small windows: while the dock columns would leave the canvas narrower than
' DOCK_MIN_CANVAS_W, hide the outermost column of the wider side (this frame
' only; the arrangement is not changed).
SUB DOCK_hide_for_width ()
    DIM c AS INTEGER, used AS INTEGER, wl AS INTEGER, wr AS INTEGER, side AS INTEGER, o AS INTEGER, hid AS INTEGER
    FOR c = 1 TO DOCK_MAX_COLS: DOCK_COL(c).autoh = FALSE: NEXT c
    DO
        wl = 0: wr = 0
        FOR c = 1 TO DOCK_MAX_COLS
            IF DOCK_COL(c).used _ANDALSO DOCK_COL(c).vis _ANDALSO DOCK_COL(c).autoh = 0 THEN
                IF DOCK_COL(c).side = DOCK_LEFT THEN wl = wl + DOCK_COL(c).w ELSE wr = wr + DOCK_COL(c).w
            END IF
        NEXT c
        IF SCRN.w& - wl - wr >= DOCK_MIN_CANVAS_W _ORELSE wl + wr = 0 THEN EXIT DO
        IF wl >= wr THEN side = DOCK_LEFT ELSE side = DOCK_RIGHT
        ' the outermost column of the wider side - but the toolbox's column
        ' last: without it there are no tools
        hid = DOCK_hide_outermost%(side, FALSE)
        IF hid = 0 THEN hid = DOCK_hide_outermost%(3 - side, FALSE)
        IF hid = 0 THEN hid = DOCK_hide_outermost%(side, TRUE)
        IF hid = 0 THEN hid = DOCK_hide_outermost%(3 - side, TRUE)
        IF hid = 0 THEN EXIT DO
    LOOP
END SUB



''
' Is panel id laid out this frame (a rect to draw and hit-test in)? FALSE for
' a collapsed slot, an inactive tab, a column hidden for a small window, or a
' panel that is not docked. Before the first layout everything counts as live.
FUNCTION DOCK_live% (id AS INTEGER)
    IF DOCK_LAID_OUT = 0 THEN DOCK_live% = TRUE: EXIT FUNCTION
    DOCK_live% = DPANEL(id).rVis
END FUNCTION



''
' Hide the outermost showing column on side (DOCK_hide_for_width); with
' toolboxToo FALSE the toolbox's column is skipped. TRUE when one was hidden.
FUNCTION DOCK_hide_outermost% (side AS INTEGER, toolboxToo AS INTEGER)
    DIM o AS INTEGER, c AS INTEGER, hasTb AS INTEGER
    FOR o = 1 TO DOCK_MAX_COLS
        c = DOCK_col_at%(side, o)
        IF c = 0 THEN EXIT FOR
        IF DOCK_COL(c).vis _ANDALSO DOCK_COL(c).autoh = 0 THEN
            hasTb = (DPANEL(DP_TOOLBOX).slot > 0 _ANDALSO DOCK_SLOT(DPANEL(DP_TOOLBOX).slot).col = c)
            IF toolboxToo _ORELSE hasTb = 0 THEN
                DOCK_COL(c).autoh = TRUE
                DOCK_hide_outermost% = TRUE
                EXIT FUNCTION
            END IF
        END IF
    NEXT o
END FUNCTION



' =============================================================================
' Tabs and collapse (P4)
' =============================================================================

''
' Tab of titled slot s under x (1..ntabs), 0 = the chevron / none. Same
' measurement as DOCK_render_titles (the layers header font).
FUNCTION DOCK_tab_at% (s AS INTEGER, mx AS INTEGER)
    DIM tx AS INTEGER, t AS INTEGER, wdt AS INTEGER, oldDest AS LONG, oldFont AS LONG
    IF mx < DOCK_SLOT(s).x + 10 THEN EXIT FUNCTION
    oldDest& = _DEST: oldFont& = _FONT
    _DEST SCRN.GUI&
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle& ELSE IF MENU_BAR.fontHandle& > 0 THEN _FONT MENU_BAR.fontHandle&
    tx = DOCK_SLOT(s).x + 10
    FOR t = 1 TO DOCK_SLOT(s).ntabs
        wdt = _UPRINTWIDTH(DPANEL(DOCK_TAB(s, t)).title)
        IF mx >= tx - 2 _ANDALSO mx < tx + wdt + 6 THEN DOCK_tab_at% = t: EXIT FOR
        tx = tx + wdt + 8
    NEXT t
    _FONT oldFont&: _DEST oldDest&
END FUNCTION


''
' Collapse / expand slot s (saved).
SUB DOCK_toggle_collapse (s AS INTEGER)
    IF s < 1 _ORELSE DOCK_SLOT(s).used = 0 THEN EXIT SUB
    DOCK_change_begin
    DOCK_SLOT(s).collapsed = _NEGATE DOCK_SLOT(s).collapsed
    IF DOCK_SLOT(s).collapsed THEN DOCK_change_commit DPANEL(DOCK_slot_panel%(s)).title + " collapsed" ELSE DOCK_change_commit DPANEL(DOCK_slot_panel%(s)).title + " expanded"
END SUB


''
' A click (no drag) on slot s's handle at x: the chevron collapses / expands,
' a tab becomes active, a double-click anywhere on a title collapses /
' expands. A click on a hover grip or the layers header does nothing.
SUB DOCK_title_click (s AS INTEGER, mx AS INTEGER)
    DIM t AS INTEGER, dbl AS INTEGER
    IF s < 1 THEN EXIT SUB
    IF DOCK_slot_titled%(s) = 0 THEN EXIT SUB
    dbl = (DOCK_UI.lastSlot = s _ANDALSO TIMER - DOCK_UI.lastClick < 0.4 _ANDALSO TIMER >= DOCK_UI.lastClick)
    DOCK_UI.lastSlot = s: DOCK_UI.lastClick = TIMER
    IF dbl _ORELSE mx < DOCK_SLOT(s).x + 10 THEN
        DOCK_UI.lastSlot = 0
        DOCK_toggle_collapse s
        EXIT SUB
    END IF
    t = DOCK_tab_at%(s, mx)
    IF t > 0 _ANDALSO t <> DOCK_SLOT(s).act THEN
        DOCK_change_begin
        DOCK_SLOT(s).act = t
        DOCK_change_commit ""
    END IF
END SUB



' =============================================================================
' Floating docked panels (P5): float, move, dock back
' =============================================================================

FUNCTION DOCK_floating% (id AS INTEGER)
    DOCK_floating% = (DPANEL(id).fl <> 0 _ANDALSO DPANEL(id).slot = 0 _ANDALSO DPANEL(id).floats = 0)
END FUNCTION


''
' Render pass: the frame + title bar of each floating docked panel.
SUB DOCK_render_floats ()
    DIM id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER
    DIM oldDest AS LONG, oldFont AS LONG
    oldDest& = _DEST: oldFont& = _FONT
    _DEST SCRN.GUI&
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle& ELSE IF MENU_BAR.fontHandle& > 0 THEN _FONT MENU_BAR.fontHandle&
    FOR id = 1 TO DP_COUNT
        IF DOCK_floating%(id) _ANDALSO DPANEL(id).rVis THEN
            x = DPANEL(id).fx: y = DPANEL(id).fy: w = DPANEL(id).fw: h = DPANEL(id).fh
            LINE (x, y)-(x + w - 1, y + DOCK_TITLE_H - 1), THEME.LAYER_PANEL_header_bg~&, BF
            LINE (x, y)-(x + w - 1, y + h - 1), THEME.LAYER_PANEL_border~&, B
            COLOR THEME.LAYER_PANEL_header_fg~&, _RGBA32(0, 0, 0, 0)
            _PRINTMODE _KEEPBACKGROUND
            _UPRINTSTRING (x + 3, y + 1), DPANEL(id).title
            ' a "dock" mark at the right: double-click the title to dock back
            _UPRINTSTRING (x + w - 8, y + 1), "#"
        END IF
    NEXT id
    _FONT oldFont&: _DEST oldDest&
END SUB


''
' Floating panel whose title bar is under (mx, my), 0 = none.
FUNCTION DOCK_float_title_at% (mx AS INTEGER, my AS INTEGER)
    DIM id AS INTEGER
    FOR id = DP_COUNT TO 1 STEP -1
        IF DOCK_floating%(id) _ANDALSO DPANEL(id).rVis THEN
            IF mx >= DPANEL(id).fx _ANDALSO mx < DPANEL(id).fx + DPANEL(id).fw _ANDALSO my >= DPANEL(id).fy _ANDALSO my < DPANEL(id).fy + DOCK_TITLE_H THEN DOCK_float_title_at% = id: EXIT FUNCTION
        END IF
    NEXT id
END FUNCTION


''
' Float docked panel id: a window the size it had, at (x, y) (top-left).
SUB DOCK_float_panel (id AS INTEGER, x AS INTEGER, y AS INTEGER)
    DIM s AS INTEGER, w AS INTEGER, h AS INTEGER
    s = DPANEL(id).slot
    IF s > 0 THEN
        DPANEL(id).hside = DOCK_COL(DOCK_SLOT(s).col).side
        DPANEL(id).hcol = DOCK_COL(DOCK_SLOT(s).col).ord
        DPANEL(id).hslot = DOCK_SLOT(s).ord
        DPANEL(id).halone = (DOCK_slot_at%(DOCK_SLOT(s).col, 2) = 0)
    END IF
    w = DPANEL(id).rw: h = DPANEL(id).rh
    IF w < DOCK_panel_w%(id) THEN w = DOCK_panel_w%(id)
    IF h < 60 THEN h = 60
    IF h > 260 THEN h = 260
    DOCK_change_begin
    DOCK_detach_panel id
    DPANEL(id).fl = TRUE
    DPANEL(id).fx = x: DPANEL(id).fy = y
    DPANEL(id).fw = w + 2: DPANEL(id).fh = h + DOCK_TITLE_H + 1
    DOCK_change_commit DPANEL(id).title + " floating (double-click its title to dock it back)"
END SUB


''
' Dock floating panel id back where it was (or the nearest side).
SUB DOCK_dock_back (id AS INTEGER)
    DIM side AS INTEGER, c AS INTEGER, r AS INTEGER
    DOCK_change_begin
    side = DPANEL(id).hside
    IF side = 0 THEN
        IF DPANEL(id).fx + DPANEL(id).fw \ 2 < SCRN.w& \ 2 THEN side = DOCK_LEFT ELSE side = DOCK_RIGHT
    END IF
    c = DOCK_col_at%(side, DPANEL(id).hcol)
    IF c > 0 _ANDALSO DPANEL(id).hslot > 0 _ANDALSO DPANEL(id).halone = 0 THEN
        r = DOCK_move_to_slot%(id, c, DPANEL(id).hslot)
    ELSE
        r = DOCK_move_to_new_col%(id, side, _MAX(1, DPANEL(id).hcol))
    END IF
    DPANEL(id).fl = FALSE
    DOCK_change_commit DPANEL(id).title + " docked"
END SUB



''
' A floating window was dragged (not onto a dock): snap it like the other
' floating windows, keep it, save.
SUB DOCK_float_moved (id AS INTEGER)
    DIM x AS INTEGER, y AS INTEGER, rg AS INTEGER
    x = DPANEL(id).fx: y = DPANEL(id).fy
    rg = DOCK_panel_region%(id)
    IF rg THEN FPANEL_place rg, x, y, DPANEL(id).fw, DPANEL(id).fh, DOCK_UI.mvX0 - DOCK_UI.mvOffX, DOCK_UI.mvY0 - DOCK_UI.mvOffY
    DPANEL(id).fx = x: DPANEL(id).fy = y
    DOCK_change_begin
    DOCK_change_commit ""
END SUB


''
' Click (no drag) on a floating title bar: a double-click docks it back.
SUB DOCK_float_click (id AS INTEGER)
    DIM dbl AS INTEGER
    dbl = (DOCK_UI.lastSlot = -id _ANDALSO TIMER - DOCK_UI.lastClick < 0.4 _ANDALSO TIMER >= DOCK_UI.lastClick)
    DOCK_UI.lastSlot = -id: DOCK_UI.lastClick = TIMER
    IF dbl THEN DOCK_UI.lastSlot = 0: DOCK_dock_back id
END SUB


FUNCTION DOCK_panel_region% (id AS INTEGER)
    SELECT CASE id
        CASE DP_TOOLBOX: DOCK_panel_region% = REGION_TOOLBAR
        CASE DP_ORGANIZER: DOCK_panel_region% = REGION_ORGANIZER
        CASE DP_DRAWER: DOCK_panel_region% = REGION_DRAWER
        CASE DP_LAYERS: DOCK_panel_region% = REGION_LAYER_PANEL
        CASE DP_EDITBAR: DOCK_panel_region% = REGION_EDIT_BAR
        CASE DP_ADVBAR: DOCK_panel_region% = REGION_ADV_BAR
        CASE DP_CHARMAP: DOCK_panel_region% = REGION_CHARMAP
    END SELECT
END FUNCTION



' =============================================================================
' Native floating windows in docks (P5): Preview, Color Mixer, Advanced Color
' Picker, 3D Color Space, Pen Pressure, Browser. They keep their own look and
' input; docked, a slot sets their position and size and their title bar
' (left of its buttons) is the dock handle.
' =============================================================================

SUB DOCK_native_reset_docked ()
    ' docked = in the tree: one in a collapsed slot or an inactive tab gets no
    ' rect this frame but must not fall back to floating (DOCK_native_off%)
    PREVIEW.docked% = (DPANEL(DP_PREVIEW).slot > 0)
    COLORMIXER.docked% = (DPANEL(DP_MIXER).slot > 0)
    ADVCP.docked% = (DPANEL(DP_ADVCP).slot > 0)
    CS3D.docked% = (DPANEL(DP_CS3D).slot > 0)
    PENP.docked% = (DPANEL(DP_PEN).slot > 0)
    BROWSER.docked% = (DPANEL(DP_BROWSER).slot > 0)
END SUB


''
' A docked native window with no rect this frame (collapsed slot, inactive tab,
' hidden column): it neither draws nor takes the mouse.
FUNCTION DOCK_native_off% (id AS INTEGER)
    IF DPANEL(id).slot = 0 THEN EXIT FUNCTION
    DOCK_native_off% = (DOCK_live%(id) = 0)
END FUNCTION


''
' The grab part of a native window's title bar (viewport rect), FALSE = none.
FUNCTION DOCK_native_grab% (id AS INTEGER, gx AS INTEGER, gy AS INTEGER, gw AS INTEGER, gh AS INTEGER)
    DIM rs AS SINGLE
    SELECT CASE id
        CASE DP_PREVIEW
            IF PREVIEW.visible% = 0 _ORELSE PREVIEW.autoHidden% THEN EXIT FUNCTION
            PREVIEW_compute_display
            rs = PREVIEW.renderScale!: IF rs <= 0 THEN rs = 1
            gx = PREVIEW.x%: gy = PREVIEW.y%
            gw = INT(PREVIEW_cb_x% * rs) ' up to its FP checkbox
            gh = INT(PREVIEW_title_h% * rs + 0.5)
            DOCK_native_grab% = TRUE
        CASE DP_MIXER
            IF DOCK_panel_shown%(DP_MIXER) = 0 THEN EXIT FUNCTION
            rs = COLORMIXER.renderScale!: IF rs <= 0 THEN rs = 1
            gx = COLORMIXER.dispX%: gy = COLORMIXER.dispY%
            gh = INT(CP_TITLE_BAR_H * rs + 0.5)
            gw = COLORMIXER.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_ADVCP
            IF DOCK_panel_shown%(DP_ADVCP) = 0 THEN EXIT FUNCTION
            rs = ADVCP.renderScale!: IF rs <= 0 THEN rs = 1
            gx = ADVCP.dispX%: gy = ADVCP.dispY%
            gh = INT(FPANEL.titleH% * rs + 0.5)
            gw = ADVCP.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_CS3D
            IF DOCK_panel_shown%(DP_CS3D) = 0 THEN EXIT FUNCTION
            rs = CS3D.renderScale!: IF rs <= 0 THEN rs = 1
            gx = CS3D.dispX%: gy = CS3D.dispY%
            gh = INT(FPANEL.titleH% * rs + 0.5)
            gw = CS3D.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_PEN
            IF DOCK_panel_shown%(DP_PEN) = 0 THEN EXIT FUNCTION
            rs = PENP.renderScale!: IF rs <= 0 THEN rs = 1
            gx = PENP.dispX%: gy = PENP.dispY%
            gh = INT(FPANEL.titleH% * rs + 0.5)
            gw = PENP.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
        CASE DP_BROWSER
            IF DOCK_panel_shown%(DP_BROWSER) = 0 THEN EXIT FUNCTION
            rs = BROWSER.renderScale!: IF rs <= 0 THEN rs = 1
            gx = BROWSER.dispX%: gy = BROWSER.dispY%
            gh = INT(FD_STATE.titleBarH * rs + 0.5)
            gw = BROWSER.dispW% - gh ' left of the close box
            DOCK_native_grab% = TRUE
    END SELECT
END FUNCTION


''
' A FLOATING native window whose grab area is under (mx, my), 0 = none.
FUNCTION DOCK_native_float_title_at% (mx AS INTEGER, my AS INTEGER)
    DIM id AS INTEGER, gx AS INTEGER, gy AS INTEGER, gw AS INTEGER, gh AS INTEGER
    FOR id = DP_PREVIEW TO DP_COUNT
        IF DPANEL(id).slot = 0 THEN
            IF DOCK_native_grab%(id, gx, gy, gw, gh) THEN
                IF mx >= gx _ANDALSO mx < gx + gw _ANDALSO my >= gy _ANDALSO my < gy + gh THEN DOCK_native_float_title_at% = id: EXIT FUNCTION
            END IF
        END IF
    NEXT id
END FUNCTION


''
' The window's own drag (floating): track the dock target under the pointer so
' the preview shows; a FLOAT target means "keep floating".
SUB DOCK_native_drag (id AS INTEGER, mx AS INTEGER, my AS INTEGER)
    DOCK_UI.mvPanel = id
    DOCK_UI.mvNative = TRUE
    DOCK_UI.mvActive = TRUE
    DOCK_drop_target mx, my
    IF DOCK_UI.tgtKind = DOCK_TGT_FLOAT THEN DOCK_UI.tgtKind = DOCK_TGT_NONE
    FRAME_IDLE% = FALSE
END SUB


''
' The window's own drag ended: dock it if it was over a target. TRUE = docked.
FUNCTION DOCK_native_drag_end% (id AS INTEGER)
    DIM k AS INTEGER
    k = DOCK_UI.tgtKind
    DOCK_UI.mvNative = FALSE: DOCK_UI.mvActive = FALSE
    IF DOCK_UI.mvPanel = id _ANDALSO k <> DOCK_TGT_NONE _ANDALSO k <> DOCK_TGT_FLOAT THEN
        DOCK_drop_apply
        DOCK_UI.mvPanel = 0: DOCK_UI.tgtKind = DOCK_TGT_NONE
        DOCK_native_drag_end% = TRUE
    END IF
    DOCK_UI.mvPanel = 0: DOCK_UI.tgtKind = DOCK_TGT_NONE
END FUNCTION


''
' Undock a native window: back to its own floating size at (x, y).
SUB DOCK_native_undock (id AS INTEGER, x AS INTEGER, y AS INTEGER)
    DOCK_change_begin
    DOCK_detach_panel id
    SELECT CASE id
        CASE DP_PREVIEW
            PREVIEW.docked% = FALSE
            PREVIEW.w% = CFG.PREVIEW_W%: PREVIEW.h% = CFG.PREVIEW_H%
            PREVIEW.x% = x: PREVIEW.y% = y
            PREVIEW_clamp_to_work_area
            CFG.PREVIEW_X% = PREVIEW.x%: CFG.PREVIEW_Y% = PREVIEW.y%
        CASE DP_MIXER
            COLORMIXER.docked% = FALSE
            COLORMIXER.dispX% = x: COLORMIXER.dispY% = y
            COLORMIXER_clamp_to_work_area
            CFG.COLOR_MIXER_X% = COLORMIXER.dispX%: CFG.COLOR_MIXER_Y% = COLORMIXER.dispY%
        CASE DP_ADVCP
            ADVCP.docked% = FALSE
            ADVCP.dispX% = x: ADVCP.dispY% = y
            ADVCP_clamp_to_work_area
            CFG.ADV_COLOR_PICKER_X% = ADVCP.dispX%: CFG.ADV_COLOR_PICKER_Y% = ADVCP.dispY%
        CASE DP_CS3D
            CS3D.docked% = FALSE
            CS3D.dispX% = x: CS3D.dispY% = y
            CS3D_clamp_to_work_area
            CFG.COLOR_SPACE_3D_X% = CS3D.dispX%: CFG.COLOR_SPACE_3D_Y% = CS3D.dispY%
        CASE DP_PEN
            PENP.docked% = FALSE
            PENP.dispX% = x: PENP.dispY% = y
            PENP_clamp_to_work_area
            CFG.PEN_PANEL_X% = PENP.dispX%: CFG.PEN_PANEL_Y% = PENP.dispY%
        CASE DP_BROWSER
            DIM brRs AS SINGLE
            BROWSER.docked% = FALSE
            brRs = BROWSER.renderScale!: IF brRs <= 0 THEN brRs = 1
            BROWSER.dispW% = INT(CSNG(_MAX(CFG.BROWSER_WIDTH%, BROWSER_MIN_W)) * brRs + 0.5) ' its floating size (native px; kept while docked)
            BROWSER.dispH% = INT(CSNG(_MAX(CFG.BROWSER_HEIGHT%, BROWSER_MIN_H)) * brRs + 0.5)
            BROWSER.dispX% = x: BROWSER.dispY% = y
            BROWSER_clamp_size
            BROWSER_clamp_to_work_area
            IF BROWSER.initialized% THEN BROWSER_sync_fd_from_display
            CFG.BROWSER_POS_X% = BROWSER.dispX%: CFG.BROWSER_POS_Y% = BROWSER.dispY%
    END SELECT
    DOCK_change_commit DPANEL(id).title + " floating"
END SUB



FUNCTION DOCK_native_for_region% (rg AS INTEGER)
    SELECT CASE rg
        CASE REGION_PREVIEW: DOCK_native_for_region% = DP_PREVIEW
        CASE REGION_COLOR_MIXER: DOCK_native_for_region% = DP_MIXER
        CASE REGION_ADV_COLOR_PICKER: DOCK_native_for_region% = DP_ADVCP
        CASE REGION_COLOR_SPACE_3D: DOCK_native_for_region% = DP_CS3D
        CASE REGION_PEN_PANEL: DOCK_native_for_region% = DP_PEN
        CASE REGION_IMAGE_BROWSER: DOCK_native_for_region% = DP_BROWSER
    END SELECT
END FUNCTION
