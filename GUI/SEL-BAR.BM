''
' DRAW - GUI/SEL-BAR.BM - the Selection Bar (GUI/SEL-BAR.BI).
'
$INCLUDEONCE

''
' Should the bar (Tool Options) show: the current tool has options on it, View > Tool
' Options on, the chrome not hidden by F11 - the dock lays it out only then
' (DOCK_panel_shown%). PLANS/TOOL-OPTIONS-BAR.md: "only there for tools with options".
FUNCTION SELBAR_wanted% ()
    DIM lst(1 TO 1) AS INTEGER
    IF SCRN.textBarHiddenByToggleAll% THEN EXIT FUNCTION ' (F11 holds the tool bars off)
    IF CFG.SELECTION_BAR% = 0 THEN EXIT FUNCTION
    SELBAR_wanted% = (SELBAR_list%(lst()) > 0)
END FUNCTION


''
' The mode a selection tool uses with no modifier held (MOUSE.BM): the bar's chips.
FUNCTION SELBAR_mode% ()
    DIM m AS INTEGER
    m = CFG.SELECTION_MODE%
    IF m < SEL_MODE_REPLACE _ORELSE m > SEL_MODE_INTERSECT THEN m = SEL_MODE_REPLACE
    SELBAR_mode% = m
END FUNCTION


''
' Text width in the bar's font (the menu bar's).
FUNCTION SELBAR_tw% (t AS STRING)
    IF MENU_BAR.fontHandle& > 0 THEN
        SELBAR_tw% = _UPRINTWIDTH(t, 0, MENU_BAR.fontHandle&)
    ELSE
        SELBAR_tw% = LEN(t) * 8
    END IF
END FUNCTION


FUNCTION SELBAR_row_h% ()
    DIM h AS INTEGER
    h = THEME.TEXT_BAR_ROW_HEIGHT%
    IF h < 10 THEN h = 14
    SELBAR_row_h% = h
END FUNCTION


''
' 1 = a chip of a group (one lit), 2 = an on / off toggle, 3 = a slider, 4 = a button,
' 5 = a label (names the chips after it; not a control).
FUNCTION SELBAR_kind% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_REPLACE TO SBC_INTERSECT, SBC_FREE TO SBC_SIZE, SBC_P_ROUND TO SBC_P_BACKSLASH, SBC_P_SYM0 TO SBC_P_SYM3, SBC_LN_SC0 TO SBC_LN_SC0 + 3, SBC_LN_EC0 TO SBC_LN_EC0 + 3, SBC_LN_SNAP15 TO SBC_LN_SNAPPX: SELBAR_kind% = 1
        CASE SBC_CONTIGUOUS, SBC_MERGED, SBC_AAEDGE, SBC_CENTER, SBC_P_PIXPERF, SBC_P_AA, SBC_BZ_HANDLES: SELBAR_kind% = 2
        CASE SBC_FEATHER, SBC_TOLERANCE, SBC_SHAPE_W, SBC_SHAPE_H, SBC_PATHSMOOTH, SBC_AMOUNT, SBC_P_SIZE, SBC_P_SOFT, SBC_P_OPACITY, SBC_LN_SPOKES, SBC_RC_HDIV TO SBC_EL_RINGS: SELBAR_kind% = 3
        CASE SBC_L_SHAPE, SBC_L_SYM, SBC_L_START, SBC_L_END, SBC_L_SNAP, SBC_L_KIND, SBC_L_FLAT, SBC_L_DICE, SBC_L_LIGHT: SELBAR_kind% = 5
        CASE SBC_SS_K0 TO SBC_SS_FILLED, SBC_SS_FLAT0 TO SBC_SS_FLAT0 + 3, SBC_SS_D0 TO SBC_SS_D0 + 6, SBC_SS_INNER, SBC_SS_OUTER: SELBAR_kind% = 1
        CASE SBC_SS_SNAPV, SBC_SS_LOCKROT, SBC_FL_CONTIG, SBC_FL_GRID, SBC_FL_ADJ: SELBAR_kind% = 2
        CASE SBC_FL_S0 TO SBC_FL_S0 + 3, SBC_FL_B0 TO SBC_FL_B0 + 3, SBC_PK_S0 TO SBC_PK_S0 + 2, SBC_PK_SZ0 TO SBC_PK_SZ0 + 2: SELBAR_kind% = 1
        CASE SBC_FL_TOL, SBC_SP_SPREAD TO SBC_SP_FLOW, SBC_PK_LOUPE: SELBAR_kind% = 3
        CASE SBC_L_SAMPLE, SBC_L_BLEND, SBC_L_AREA: SELBAR_kind% = 5
        CASE SBC_SS_SIDES, SBC_SS_PDEPTH, SBC_SS_SLICES TO SBC_SS_RADIUS, SBC_SS_ROUND TO SBC_SS_PACHOLE, SBC_SS_ZDEPTH TO SBC_SS_TURN, SBC_SS_LAZ TO SBC_SS_BORDER, SBC_SS_STEM TO SBC_SS_THICK: SELBAR_kind% = 3
        CASE SBC_BR_MIX, SBC_BR_TILE, SBC_ER_SMART, SBC_MP_FROMBR, SBC_MP_BRUSHES, SBC_MP_SETTINGS: SELBAR_kind% = 2
        CASE SBC_BR_SMUDGE TO SBC_BR_MIXRAD, SBC_MP_SIZE TO SBC_MP_TWIST, SBC_CR_W, SBC_CR_H: SELBAR_kind% = 3
        CASE ELSE: SELBAR_kind% = 4
    END SELECT
END FUNCTION


FUNCTION SELBAR_label$ (id AS INTEGER)
    DIM t AS STRING
    SELECT CASE id
        CASE SBC_REPLACE: t = "REPLACE"
        CASE SBC_ADD: t = "ADD"
        CASE SBC_SUBTRACT: t = "SUBTRACT"
        CASE SBC_INTERSECT: t = "INTERSECT"
        CASE SBC_FEATHER: t = "FEATHER"
        CASE SBC_FEATHER_GO: t = "APPLY"
        CASE SBC_TOLERANCE: t = "TOLERANCE"
        CASE SBC_CONTIGUOUS: t = "CONTIGUOUS"
        CASE SBC_MERGED: t = "SAMPLE MERGED"
        CASE SBC_AAEDGE: t = "AA EDGE"
        CASE SBC_FREE: t = "FREE"
        CASE SBC_RATIO: t = "RATIO"
        CASE SBC_SIZE: t = "SIZE"
        CASE SBC_SHAPE_W: t = "W"
        CASE SBC_SHAPE_H: t = "H"
        CASE SBC_CENTER: t = "FROM CENTER"
        CASE SBC_PATHSMOOTH: t = "SMOOTH PATH"
        CASE SBC_AMOUNT: t = "AMOUNT"
        CASE SBC_GROW: t = "GROW"
        CASE SBC_SHRINK: t = "SHRINK"
        CASE SBC_SMOOTH: t = "SMOOTH"
        CASE SBC_INVERT: t = "INVERT"
        CASE SBC_DESELECT: t = "DESELECT"
        CASE SBC_P_SIZE: t = "SIZE"
        CASE SBC_L_SHAPE: t = "SHAPE"
        CASE SBC_P_ROUND: t = "ROUND"
        CASE SBC_P_SQUARE: t = "SQUARE"
        CASE SBC_P_SLASH: t = "/"
        CASE SBC_P_BACKSLASH: t = "\"
        CASE SBC_P_SOFT: t = "SOFT"
        CASE SBC_P_OPACITY: t = "OPACITY"
        CASE SBC_P_PIXPERF: t = "PIXEL PERFECT"
        CASE SBC_P_AA: t = _IIF(CURRENT_TOOL% = TOOL_SPRAY, "AIRBRUSH", "AA") ' (the spray's AA is its airbrush)
        CASE SBC_L_SYM: t = "SYMMETRY"
        CASE SBC_P_SYM0: t = "OFF"
        CASE SBC_P_SYM0 + 1: t = "|"
        CASE SBC_P_SYM0 + 2: t = "+"
        CASE SBC_P_SYM3: t = "*"
        CASE SBC_L_START: t = "START"
        CASE SBC_L_END: t = "END"
        CASE SBC_LN_SC0, SBC_LN_EC0: t = "NONE"
        CASE SBC_LN_SC0 + 1, SBC_LN_EC0 + 1: t = "ARROW"
        CASE SBC_LN_SC0 + 2, SBC_LN_EC0 + 2: t = "CUBE"
        CASE SBC_LN_SC0 + 3, SBC_LN_EC0 + 3: t = "DOT"
        CASE SBC_LN_SPOKES: t = "SPOKES"
        CASE SBC_L_SNAP: t = "SNAP"
        CASE SBC_LN_SNAP15: t = "15"
        CASE SBC_LN_SNAP15 + 1: t = "30"
        CASE SBC_LN_SNAP15 + 2: t = "45"
        CASE SBC_LN_SNAP15 + 3: t = "90"
        CASE SBC_LN_SNAPPX: t = "PIXEL"
        CASE SBC_RC_HDIV: t = "DIVIDE |"
        CASE SBC_RC_VDIV: t = "DIVIDE -"
        CASE SBC_EL_SLICES: t = "SLICES"
        CASE SBC_EL_RINGS: t = "RINGS"
        CASE SBC_PL_FINISH: t = "FINISH"
        CASE SBC_PL_CANCEL, SBC_BZ_CANCEL: t = "CANCEL"
        CASE SBC_BZ_HANDLES: t = "HANDLES"
        CASE SBC_BZ_COMMIT: t = "COMMIT"
        CASE SBC_L_KIND: t = "KIND"
        CASE SBC_SS_K0: t = "POLYGON"
        CASE SBC_SS_K0 + 1: t = "PIE"
        CASE SBC_SS_K0 + 2: t = "ROUNDED"
        CASE SBC_SS_K0 + 3: t = "TAB"
        CASE SBC_SS_K0 + 4: t = "PILL"
        CASE SBC_SS_K0 + 5: t = "PAC-MAN"
        CASE SBC_SS_K0 + 6: t = "DICE"
        CASE SBC_SS_K0 + 7: t = "BEVEL"
        CASE SBC_SS_K0 + 8: t = "ARROW"
        CASE SBC_SS_K9: t = "3D TEXT"
        CASE SBC_SS_OUTLINE: t = _IIF(CURRENT_TOOL% = TOOL_SS_3D_CUBE, "WIRE", "OUTLINE")
        CASE SBC_SS_FILLED: t = _IIF(CURRENT_TOOL% = TOOL_SS_3D_CUBE, "SOLID", "FILLED")
        CASE SBC_SS_SIDES: t = "SIDES"
        CASE SBC_SS_PDEPTH: t = "POINTS"
        CASE SBC_SS_SNAPV: t = "GRID SNAP"
        CASE SBC_SS_LOCKROT: t = "NO SPIN"
        CASE SBC_SS_SLICES: t = "SLICES"
        CASE SBC_SS_PIEHOLE, SBC_SS_PACHOLE: t = "HOLE"
        CASE SBC_SS_RADIUS: t = "RADIUS"
        CASE SBC_L_FLAT: t = "FLAT"
        CASE SBC_SS_FLAT0: t = "TOP"
        CASE SBC_SS_FLAT0 + 1: t = "RIGHT"
        CASE SBC_SS_FLAT0 + 2: t = "BOTTOM"
        CASE SBC_SS_FLAT0 + 3: t = "LEFT"
        CASE SBC_SS_ROUND: t = "ROUND"
        CASE SBC_SS_SEGS: t = "SEGMENTS"
        CASE SBC_SS_MOUTH: t = "MOUTH"
        CASE SBC_L_DICE: t = "DIE"
        CASE SBC_SS_D0 TO SBC_SS_D0 + 6: t = "D" + _TRIM$(STR$(SELBAR_dice%(id)))
        CASE SBC_SS_ZDEPTH: t = "DEPTH"
        CASE SBC_SS_TILT: t = "TILT"
        CASE SBC_SS_TURN: t = "TURN"
        CASE SBC_L_LIGHT: t = "LIGHT"
        CASE SBC_SS_LAZ: t = "ANGLE"
        CASE SBC_SS_LEL: t = "HEIGHT"
        CASE SBC_SS_LINT: t = "POWER"
        CASE SBC_SS_BEVEL: t = "BEVEL"
        CASE SBC_SS_BORDER: t = "BORDER"
        CASE SBC_SS_INNER: t = "INNER"
        CASE SBC_SS_OUTER: t = "OUTER"
        CASE SBC_SS_STEM: t = "STEM"
        CASE SBC_SS_HEAD: t = "HEAD"
        CASE SBC_SS_FLARE: t = "FLARE"
        CASE SBC_SS_THICK: t = "THICK"
        CASE SBC_L_SAMPLE: t = "SAMPLE"
        CASE SBC_FL_S0, SBC_PK_S0 + 1: t = "LAYER"
        CASE SBC_FL_S0 + 1, SBC_PK_S0: t = "MERGED"
        CASE SBC_FL_S0 + 2: t = "ALL LAYERS"
        CASE SBC_FL_S0 + 3: t = "REPLACE ALL"
        CASE SBC_PK_S0 + 2: t = "REFERENCE"
        CASE SBC_FL_TOL: t = "TOLERANCE"
        CASE SBC_FL_CONTIG: t = "CONTIGUOUS"
        CASE SBC_FL_GRID: t = "GRID CELL"
        CASE SBC_FL_ADJ: t = "ADJUST"
        CASE SBC_L_BLEND: t = "BLEND"
        CASE SBC_FL_B0: t = "SRGB"
        CASE SBC_FL_B0 + 1: t = "OKLAB"
        CASE SBC_FL_B0 + 2: t = "LINEAR"
        CASE SBC_FL_B0 + 3: t = "PIGMENT"
        CASE SBC_SP_SPREAD: t = "SPREAD"
        CASE SBC_SP_DENSITY: t = "DENSITY"
        CASE SBC_SP_FLOW: t = "FLOW"
        CASE SBC_L_AREA: t = "AREA"
        CASE SBC_PK_SZ0: t = "1"
        CASE SBC_PK_SZ0 + 1: t = "3X3"
        CASE SBC_PK_SZ0 + 2: t = "5X5"
        CASE SBC_PK_LOUPE: t = "LOUPE"
        CASE SBC_BR_MIX: t = "MIX"
        CASE SBC_BR_SMUDGE: t = "SMUDGE"
        CASE SBC_BR_LENGTH: t = "LENGTH"
        CASE SBC_BR_MIXRAD: t = "RADIUS"
        CASE SBC_BR_TILE: t = "TILE"
        CASE SBC_ER_SMART: t = "ALL LAYERS"
        CASE SBC_MP_FROMBR: t = "SIZE = BRUSH"
        CASE SBC_MP_SIZE: t = "SIZE"
        CASE SBC_MP_OPAQUE: t = "OPAQUE"
        CASE SBC_MP_PRESS: t = "PRESSURE"
        CASE SBC_MP_TWIST: t = "TWIST"
        CASE SBC_MP_BRUSHES: t = "BRUSHES"
        CASE SBC_MP_SETTINGS: t = "SETTINGS"
        CASE SBC_MV_FLIPH: t = "FLIP H"
        CASE SBC_MV_FLIPV: t = "FLIP V"
        CASE SBC_MV_ROTCCW: t = "ROTATE CCW"
        CASE SBC_MV_ROTCW: t = "ROTATE CW"
        CASE SBC_MV_HALF: t = "SCALE 50%"
        CASE SBC_MV_DOUBLE: t = "SCALE 2X"
        CASE SBC_TR_APPLY, SBC_CR_APPLY: t = "APPLY"
        CASE SBC_TR_CANCEL, SBC_CR_CANCEL: t = "CANCEL"
        CASE SBC_CR_W: t = "W"
        CASE SBC_CR_H: t = "H"
        CASE SBC_CR_TRIM: t = "TRIM"
        CASE SBC_CR_WHOLE: t = "WHOLE IMAGE"
        CASE SBC_VW_OUT: t = "ZOOM -"
        CASE SBC_VW_IN: t = "ZOOM +"
        CASE SBC_VW_100: t = "100%"
        CASE SBC_VW_FIT: t = "FIT"
        CASE SBC_VW_CENTER: t = "CENTER"
    END SELECT
    SELBAR_label$ = t
