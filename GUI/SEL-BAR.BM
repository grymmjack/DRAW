''
' A chip / toggle lit?
FUNCTION SELBAR_on% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_REPLACE TO SBC_INTERSECT: SELBAR_on% = (SELBAR_mode% = id - SBC_REPLACE)
        CASE SBC_FREE TO SBC_SIZE: SELBAR_on% = (CFG.SELECTION_SHAPE% = id - SBC_FREE)
        CASE SBC_CONTIGUOUS: SELBAR_on% = (CFG.WAND_CONTIGUOUS% <> 0)
        CASE SBC_MERGED: SELBAR_on% = (CFG.WAND_SAMPLE_MERGED% <> 0)
        CASE SBC_AAEDGE: SELBAR_on% = (CFG.WAND_ANTIALIAS% <> 0)
        CASE SBC_CENTER: SELBAR_on% = (CFG.SELECTION_FROM_CENTER% <> 0)
        CASE SBC_P_ROUND: SELBAR_on% = (BRUSH_SIZE.SHAPE = BRUSH_SHAPE_ROUND)
        CASE SBC_P_SQUARE: SELBAR_on% = (BRUSH_SIZE.SHAPE = BRUSH_SHAPE_SQUARE)
        CASE SBC_P_SLASH: SELBAR_on% = (BRUSH_SIZE.SHAPE = BRUSH_SHAPE_SLASH)
        CASE SBC_P_BACKSLASH: SELBAR_on% = (BRUSH_SIZE.SHAPE = BRUSH_SHAPE_BACKSLASH)
        CASE SBC_P_PIXPERF: SELBAR_on% = (BRUSH_SIZE.PIXEL_PERFECT <> 0)
        CASE SBC_P_AA: SELBAR_on% = (CFG.ANTIALIAS% <> 0)
        CASE SBC_P_SYM0 TO SBC_P_SYM3: SELBAR_on% = (SYMMETRY.MODE% = id - SBC_P_SYM0)
        CASE SBC_LN_SC0 TO SBC_LN_SC0 + 3: SELBAR_on% = (LINE_TOOL.START_CAP = id - SBC_LN_SC0)
        CASE SBC_LN_EC0 TO SBC_LN_EC0 + 3: SELBAR_on% = (LINE_TOOL.END_CAP = id - SBC_LN_EC0)
        CASE SBC_LN_SNAP15 TO SBC_LN_SNAP15 + 3: SELBAR_on% = (CFG.ANGLE_SNAP_PIXEL_ART% = 0 _ANDALSO CFG.ANGLE_SNAP_DEGREES% = SELBAR_snap_deg%(id))
        CASE SBC_LN_SNAPPX: SELBAR_on% = (CFG.ANGLE_SNAP_PIXEL_ART% <> 0)
        CASE SBC_BZ_HANDLES: SELBAR_on% = (BEZIER.SHOW_HANDLES% <> 0)
        CASE SBC_SS_K0 TO SBC_SS_K9: SELBAR_on% = (CURRENT_TOOL% = TOOL_SS_POLYGON + id - SBC_SS_K0)
        CASE SBC_SS_OUTLINE: SELBAR_on% = (SS_BAR_FILLED = 0)
        CASE SBC_SS_FILLED: SELBAR_on% = (SS_BAR_FILLED <> 0)
        CASE SBC_SS_SNAPV: SELBAR_on% = (SS_POLYGON.SNAP_VERTS <> 0)
        CASE SBC_SS_LOCKROT: SELBAR_on% = (SS_POLYGON.LOCK_ROTATION <> 0)
        CASE SBC_SS_FLAT0 TO SBC_SS_FLAT0 + 3: SELBAR_on% = (SS_TAB.FLAT_SIDE = id - SBC_SS_FLAT0)
        CASE SBC_SS_D0 TO SBC_SS_D0 + 6: SELBAR_on% = (SS_CUBE.DICE_TYPE = SELBAR_dice%(id))
        CASE SBC_SS_INNER: SELBAR_on% = (SS_BEVEL.STYLE = 0)
        CASE SBC_SS_OUTER: SELBAR_on% = (SS_BEVEL.STYLE = 1)
        CASE SBC_FL_S0 TO SBC_FL_S0 + 3: SELBAR_on% = (CFG.FILL_SAMPLE% = id - SBC_FL_S0)
        CASE SBC_FL_CONTIG: SELBAR_on% = (CFG.FILL_CONTIGUOUS% <> 0)
        CASE SBC_FL_GRID: SELBAR_on% = (GRID.CELL_FILL% <> 0)
        CASE SBC_FL_ADJ: SELBAR_on% = (FILL_ADJ.ENABLED% <> 0)
        CASE SBC_FL_B0 TO SBC_FL_B0 + 3: SELBAR_on% = (CFG.GRADIENT_BLEND_SPACE% = id - SBC_FL_B0)
        CASE SBC_PK_S0 TO SBC_PK_S0 + 2: SELBAR_on% = (CFG.PICKER_SAMPLE% = id - SBC_PK_S0)
        CASE SBC_PK_SZ0 TO SBC_PK_SZ0 + 2: SELBAR_on% = (CFG.PICKER_SAMPLE_SIZE% = 1 + 2 * (id - SBC_PK_SZ0))
        CASE SBC_BR_MIX: SELBAR_on% = (CFG.BRUSH_MIX% <> 0)
        CASE SBC_BR_TILE: SELBAR_on% = (SCRN.patternTileMode% <> 0)
        CASE SBC_ER_SMART: SELBAR_on% = (ERASER_BAR_SMART <> 0)
        CASE SBC_MP_FROMBR: SELBAR_on% = (CFG.MYPAINT_SIZE_FROM_BRUSH% <> 0)
        CASE SBC_MP_BRUSHES: SELBAR_on% = (CFG.MYPAINT_PANEL% <> 0)
        CASE SBC_MP_SETTINGS: SELBAR_on% = (CFG.MYPAINT_SETTINGS% <> 0)
    END SELECT
END FUNCTION


''
' A slider's value and range.
FUNCTION SELBAR_val% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_FEATHER: SELBAR_val% = CFG.SELECTION_FEATHER%
        CASE SBC_TOLERANCE: SELBAR_val% = CFG.WAND_TOLERANCE%
        CASE SBC_SHAPE_W: SELBAR_val% = CFG.SELECTION_SHAPE_W%
        CASE SBC_SHAPE_H: SELBAR_val% = CFG.SELECTION_SHAPE_H%
        CASE SBC_PATHSMOOTH: SELBAR_val% = CFG.SELECTION_SMOOTH%
        CASE SBC_AMOUNT: SELBAR_val% = CFG.SELECTION_GROW%
        CASE SBC_P_SIZE: SELBAR_val% = BRUSH_SIZE.CURRENT
        CASE SBC_P_SOFT: SELBAR_val% = BRUSH_SIZE.SOFT
        CASE SBC_P_OPACITY: SELBAR_val% = PAINT_OPACITY%
        CASE SBC_LN_SPOKES: SELBAR_val% = LINE_TOOL.SPOKES ' (the line being drawn, else the next one's)
        CASE SBC_RC_HDIV: SELBAR_val% = RECT_TOOL.H_DIVISIONS
        CASE SBC_RC_VDIV: SELBAR_val% = RECT_TOOL.V_DIVISIONS
        CASE SBC_EL_SLICES: SELBAR_val% = ELLIPSE_TOOL.SLICES
        CASE SBC_EL_RINGS: SELBAR_val% = ELLIPSE_TOOL.RINGS
        CASE SBC_SS_SIDES: SELBAR_val% = SS_POLYGON.SIDES
        CASE SBC_SS_PDEPTH: SELBAR_val% = SS_POLYGON.POINT_DEPTH
        CASE SBC_SS_SLICES: SELBAR_val% = SS_PIE_DONUT.SLICES
        CASE SBC_SS_PIEHOLE: SELBAR_val% = SS_PIE_DONUT.HOLE_PCT
        CASE SBC_SS_RADIUS: SELBAR_val% = _IIF(CURRENT_TOOL% = TOOL_SS_TAB, SS_TAB.RADIUS, SS_RR.RADIUS)
        CASE SBC_SS_ROUND: SELBAR_val% = SS_PILL.ROUNDNESS_PCT
        CASE SBC_SS_SEGS: SELBAR_val% = SS_PILL.SEGMENTS
        CASE SBC_SS_MOUTH: SELBAR_val% = SS_PACMAN.MOUTH_DEG
        CASE SBC_SS_PACHOLE: SELBAR_val% = SS_PACMAN.HOLE_PCT
        CASE SBC_SS_ZDEPTH: SELBAR_val% = _IIF(CURRENT_TOOL% = TOOL_SS_3D_TEXT, SS_TEXT.Z_DEPTH, SS_CUBE.Z_DEPTH)
        CASE SBC_SS_TILT: SELBAR_val% = SELBAR_deg%(_IIF(CURRENT_TOOL% = TOOL_SS_3D_TEXT, SS_TEXT.ROT_X, SS_CUBE.ROT_X)) ' (the keys let it run past 180: shown wrapped)
        CASE SBC_SS_TURN: SELBAR_val% = SELBAR_deg%(_IIF(CURRENT_TOOL% = TOOL_SS_3D_TEXT, SS_TEXT.ROT_Y, SS_CUBE.ROT_Y))
        CASE SBC_SS_LAZ: SELBAR_val% = CINT(SS_LIGHT.AZIMUTH)
        CASE SBC_SS_LEL: SELBAR_val% = CINT(SS_LIGHT.ELEVATION)
        CASE SBC_SS_LINT: SELBAR_val% = CINT(SS_LIGHT.INTENSITY * 100)
        CASE SBC_SS_BEVEL: SELBAR_val% = SS_BEVEL.BEVEL_SIZE
        CASE SBC_SS_BORDER: SELBAR_val% = SS_BEVEL.BORDER_SIZE
        CASE SBC_SS_STEM: SELBAR_val% = SS_ARROW.STEM_FATNESS_PCT
        CASE SBC_SS_HEAD: SELBAR_val% = SS_ARROW.HEAD_LEN_PCT
        CASE SBC_SS_FLARE: SELBAR_val% = SS_ARROW.HEAD_FLARE_PCT
        CASE SBC_SS_THICK: SELBAR_val% = SS_ARROW.THICKNESS
        CASE SBC_FL_TOL: SELBAR_val% = CFG.FILL_TOLERANCE%
        CASE SBC_SP_SPREAD: SELBAR_val% = CFG.SPRAY_SPREAD%
        CASE SBC_SP_DENSITY: SELBAR_val% = CFG.SPRAY_DENSITY%
        CASE SBC_SP_FLOW: SELBAR_val% = CFG.SPRAY_FLOW%
        CASE SBC_PK_LOUPE: SELBAR_val% = PICKER_LOUPE_resolve_int%(CFG.PICKER_LOUPE_ZOOM_LEVEL%, THEME.PICKER_LOUPE_zoom_level%, 8) ' (as the loupe reads it)
        CASE SBC_BR_SMUDGE: SELBAR_val% = CFG.BRUSH_MIX_SMUDGE%
        CASE SBC_BR_LENGTH: SELBAR_val% = CFG.BRUSH_MIX_LENGTH%
        CASE SBC_BR_MIXRAD: SELBAR_val% = CFG.BRUSH_MIX_RADIUS%
        CASE SBC_MP_SIZE TO SBC_MP_TWIST: MYPAINT_init: SELBAR_val% = MPS_get%(SELBAR_mps%(id)) ' (the MyPaint Brush Settings' sliders)
        CASE SBC_CR_W: SELBAR_val% = MARQUEE.BOX.w
        CASE SBC_CR_H: SELBAR_val% = MARQUEE.BOX.h
    END SELECT
END FUNCTION

''
' Degrees d wrapped into -180..180 (the 3D rotations).
FUNCTION SELBAR_deg% (d AS INTEGER)
    DIM r AS LONG
    r = ((CLNG(d) + 180) MOD 360 + 360) MOD 360 - 180
    SELBAR_deg% = r
END FUNCTION

''
' A MyPaint slider's MyPaint Brush Settings slider (GUI/MYPAINT-SET: MPS_get / MPS_set / MPS_lo ..).
FUNCTION SELBAR_mps% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_MP_SIZE: SELBAR_mps% = MPS_SIZE
        CASE SBC_MP_OPAQUE: SELBAR_mps% = MPS_OPAQUE
        CASE SBC_MP_PRESS: SELBAR_mps% = MPS_PRESSURE
        CASE SBC_MP_TWIST: SELBAR_mps% = MPS_TWIST
    END SELECT
END FUNCTION

''
' A dice chip's die (D4 .. D30).
FUNCTION SELBAR_dice% (id AS INTEGER)
    SELECT CASE id - SBC_SS_D0
        CASE 0: SELBAR_dice% = 4
        CASE 1: SELBAR_dice% = 6
        CASE 2: SELBAR_dice% = 8
        CASE 3: SELBAR_dice% = 10
        CASE 4: SELBAR_dice% = 12
        CASE 5: SELBAR_dice% = 20
        CASE 6: SELBAR_dice% = 30
    END SELECT
END FUNCTION

''
' A slider's value as it reads on the bar (SIZE: an index, shown in px).
FUNCTION SELBAR_disp$ (id AS INTEGER, v AS INTEGER)
    IF id = SBC_P_SIZE _ANDALSO v >= 1 _ANDALSO v <= BRUSH_SIZE_COUNT THEN SELBAR_disp$ = _TRIM$(STR$(BRUSH_PIXEL_SIZES(v))): EXIT FUNCTION
    SELBAR_disp$ = _TRIM$(STR$(v))
END FUNCTION

FUNCTION SELBAR_lo% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_SHAPE_W, SBC_SHAPE_H, SBC_AMOUNT: SELBAR_lo% = 1
        CASE SBC_P_SIZE: SELBAR_lo% = BRUSH_SIZE.MIN
        CASE SBC_P_OPACITY: SELBAR_lo% = 10 ' (as the keys 1-0)
        CASE SBC_SS_SIDES: SELBAR_lo% = SS_POLY_MIN_SIDES
        CASE SBC_SS_RADIUS: SELBAR_lo% = SS_RR_MIN_RADIUS
        CASE SBC_SS_SEGS, SBC_SS_BEVEL: SELBAR_lo% = 1
        CASE SBC_SS_ZDEPTH: SELBAR_lo% = _IIF(CURRENT_TOOL% = TOOL_SS_3D_TEXT, 5, 10)
        CASE SBC_SS_TILT, SBC_SS_TURN, SBC_SS_LAZ: SELBAR_lo% = -180
        CASE SBC_SS_LEL: SELBAR_lo% = -89
        CASE SBC_SS_LINT: SELBAR_lo% = 20
        CASE SBC_SS_STEM, SBC_SS_HEAD: SELBAR_lo% = 10
        CASE SBC_SS_FLARE: SELBAR_lo% = 50
        CASE SBC_SS_THICK: SELBAR_lo% = 4
        CASE SBC_SP_SPREAD: SELBAR_lo% = 25
        CASE SBC_SP_DENSITY, SBC_SP_FLOW: SELBAR_lo% = 10
        CASE SBC_PK_LOUPE: SELBAR_lo% = 1
        CASE SBC_BR_MIXRAD: SELBAR_lo% = 25
        CASE SBC_MP_SIZE TO SBC_MP_TWIST: SELBAR_lo% = MPS_lo%(SELBAR_mps%(id))
        CASE SBC_CR_W, SBC_CR_H: SELBAR_lo% = 1
    END SELECT
END FUNCTION

FUNCTION SELBAR_hi% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_FEATHER, SBC_AMOUNT: SELBAR_hi% = 64
        CASE SBC_TOLERANCE: SELBAR_hi% = 255
        CASE SBC_SHAPE_W, SBC_SHAPE_H: SELBAR_hi% = 512 ' (the slider's reach; DRAW.cfg takes up to 8192)
        CASE SBC_PATHSMOOTH: SELBAR_hi% = 4
        CASE SBC_P_SIZE: SELBAR_hi% = BRUSH_SIZE.MAX
        CASE SBC_P_SOFT, SBC_P_OPACITY: SELBAR_hi% = 100
        CASE SBC_LN_SPOKES, SBC_EL_SLICES, SBC_EL_RINGS: SELBAR_hi% = 16 ' (as the arrow keys)
        CASE SBC_RC_HDIV, SBC_RC_VDIV: SELBAR_hi% = 32
        CASE SBC_SS_SIDES: SELBAR_hi% = SS_POLY_MAX_SIDES
        CASE SBC_SS_PDEPTH, SBC_SS_FLARE, SBC_SS_THICK: SELBAR_hi% = 200
        CASE SBC_SS_SLICES: SELBAR_hi% = SS_PIE_MAX_SLICES
        CASE SBC_SS_PIEHOLE, SBC_SS_PACHOLE, SBC_SS_STEM: SELBAR_hi% = 90
        CASE SBC_SS_RADIUS: SELBAR_hi% = SS_RR_MAX_RADIUS
        CASE SBC_SS_ROUND: SELBAR_hi% = 100
        CASE SBC_SS_SEGS: SELBAR_hi% = SS_PILL_MAX_SEGMENTS
        CASE SBC_SS_MOUTH: SELBAR_hi% = 170
        CASE SBC_SS_ZDEPTH: SELBAR_hi% = _IIF(CURRENT_TOOL% = TOOL_SS_3D_TEXT, 200, 300)
        CASE SBC_SS_TILT, SBC_SS_TURN, SBC_SS_LAZ, SBC_SS_LINT: SELBAR_hi% = 180
        CASE SBC_SS_LEL: SELBAR_hi% = 89
        CASE SBC_SS_BEVEL: SELBAR_hi% = SS_BEVEL_MAX
        CASE SBC_SS_BORDER: SELBAR_hi% = 10
        CASE SBC_SS_HEAD: SELBAR_hi% = 80
        CASE SBC_FL_TOL: SELBAR_hi% = 255
        CASE SBC_SP_SPREAD TO SBC_SP_FLOW: SELBAR_hi% = 400
        CASE SBC_PK_LOUPE: SELBAR_hi% = 8
        CASE SBC_BR_SMUDGE, SBC_BR_LENGTH: SELBAR_hi% = 100
        CASE SBC_BR_MIXRAD: SELBAR_hi% = 400
        CASE SBC_MP_SIZE TO SBC_MP_TWIST: SELBAR_hi% = MPS_hi%(SELBAR_mps%(id))
        CASE SBC_CR_W: SELBAR_hi% = _MIN(8192, SCRN.canvasW& * 2) ' (the box may grow the canvas)
        CASE SBC_CR_H: SELBAR_hi% = _MIN(8192, SCRN.canvasH& * 2)
    END SELECT
END FUNCTION


''
' Set slider id to v (clamped); saved to DRAW.cfg when save.
SUB SELBAR_set (id AS INTEGER, v AS INTEGER, save AS INTEGER)
    DIM n AS INTEGER
    n = v
    IF n < SELBAR_lo%(id) THEN n = SELBAR_lo%(id)
    IF id = SBC_SHAPE_W _ORELSE id = SBC_SHAPE_H THEN
        IF n > 8192 THEN n = 8192
    ELSEIF n > SELBAR_hi%(id) THEN
        n = SELBAR_hi%(id)
    END IF
    SELECT CASE id
        CASE SBC_FEATHER: CFG.SELECTION_FEATHER% = n
        CASE SBC_TOLERANCE: CFG.WAND_TOLERANCE% = n
        CASE SBC_SHAPE_W: CFG.SELECTION_SHAPE_W% = n
        CASE SBC_SHAPE_H: CFG.SELECTION_SHAPE_H% = n
        CASE SBC_PATHSMOOTH: CFG.SELECTION_SMOOTH% = n
        CASE SBC_AMOUNT: CFG.SELECTION_GROW% = n
        CASE SBC_P_SIZE: BRUSH_SIZE_set n
        CASE SBC_P_SOFT: BRUSH_SIZE_set_shape BRUSH_SIZE.SHAPE, n ' (saves BRUSH_SOFT itself)
        CASE SBC_P_OPACITY: PAINT_OPACITY% = n: SCENE_DIRTY% = TRUE
        ' the shapes: the next one's value, and the one being drawn
        CASE SBC_LN_SPOKES: LINE_TOOL.BAR_SPOKES = n: LINE_TOOL.SPOKES = n: SCENE_DIRTY% = TRUE
        CASE SBC_RC_HDIV: RECT_TOOL.BAR_H_DIV = n: RECT_TOOL.H_DIVISIONS = n: SCENE_DIRTY% = TRUE
        CASE SBC_RC_VDIV: RECT_TOOL.BAR_V_DIV = n: RECT_TOOL.V_DIVISIONS = n: SCENE_DIRTY% = TRUE
        CASE SBC_EL_SLICES: ELLIPSE_TOOL.BAR_SLICES = n: ELLIPSE_TOOL.SLICES = n: SCENE_DIRTY% = TRUE
        CASE SBC_EL_RINGS: ELLIPSE_TOOL.BAR_RINGS = n: ELLIPSE_TOOL.RINGS = n: SCENE_DIRTY% = TRUE
        ' the smart shapes: their SS_* values (they carry over to the next shape)
        CASE SBC_SS_SIDES: SS_POLYGON.SIDES = n
        CASE SBC_SS_PDEPTH: SS_POLYGON.POINT_DEPTH = n
        CASE SBC_SS_SLICES: SS_PIE_DONUT.SLICES = n
        CASE SBC_SS_PIEHOLE: SS_PIE_DONUT.HOLE_PCT = n
        CASE SBC_SS_RADIUS: IF CURRENT_TOOL% = TOOL_SS_TAB THEN SS_TAB.RADIUS = n ELSE SS_RR.RADIUS = n
        CASE SBC_SS_ROUND: SS_PILL.ROUNDNESS_PCT = n
        CASE SBC_SS_SEGS: SS_PILL.SEGMENTS = n
        CASE SBC_SS_MOUTH: SS_PACMAN.MOUTH_DEG = n
        CASE SBC_SS_PACHOLE: SS_PACMAN.HOLE_PCT = n
        CASE SBC_SS_ZDEPTH: IF CURRENT_TOOL% = TOOL_SS_3D_TEXT THEN SS_TEXT.Z_DEPTH = n ELSE SS_CUBE.Z_DEPTH = n
        CASE SBC_SS_TILT: IF CURRENT_TOOL% = TOOL_SS_3D_TEXT THEN SS_TEXT.ROT_X = n ELSE SS_CUBE.ROT_X = n
        CASE SBC_SS_TURN: IF CURRENT_TOOL% = TOOL_SS_3D_TEXT THEN SS_TEXT.ROT_Y = n ELSE SS_CUBE.ROT_Y = n
        CASE SBC_SS_LAZ: SS_LIGHT.AZIMUTH = n
        CASE SBC_SS_LEL: SS_LIGHT.ELEVATION = n
        CASE SBC_SS_LINT: SS_LIGHT.INTENSITY = n / 100!
        CASE SBC_SS_BEVEL: SS_BEVEL.BEVEL_SIZE = n
        CASE SBC_SS_BORDER: SS_BEVEL.BORDER_SIZE = n
        CASE SBC_SS_STEM: SS_ARROW.STEM_FATNESS_PCT = n
        CASE SBC_SS_HEAD: SS_ARROW.HEAD_LEN_PCT = n
        CASE SBC_SS_FLARE: SS_ARROW.HEAD_FLARE_PCT = n
        CASE SBC_SS_THICK: SS_ARROW.THICKNESS = n
        CASE SBC_FL_TOL: CFG.FILL_TOLERANCE% = n
        CASE SBC_SP_SPREAD: CFG.SPRAY_SPREAD% = n
        CASE SBC_SP_DENSITY: CFG.SPRAY_DENSITY% = n
        CASE SBC_SP_FLOW: CFG.SPRAY_FLOW% = n
        CASE SBC_PK_LOUPE: CFG.PICKER_LOUPE_ZOOM_LEVEL% = n
        CASE SBC_BR_SMUDGE: CFG.BRUSH_MIX_SMUDGE% = n
        CASE SBC_BR_LENGTH: CFG.BRUSH_MIX_LENGTH% = n
        CASE SBC_BR_MIXRAD: CFG.BRUSH_MIX_RADIUS% = n
        CASE SBC_MP_SIZE TO SBC_MP_TWIST: MPS_set SELBAR_mps%(id), n, save ' (saves its own keys)
        CASE SBC_CR_W: MARQUEE.BOX.w = n: INVALIDATE_scene
        CASE SBC_CR_H: MARQUEE.BOX.h = n: INVALIDATE_scene
    END SELECT
    IF id >= SBC_SS_SIDES THEN SCENE_DIRTY% = TRUE ' (a shape being dragged redraws)
    IF save _ANDALSO (id < SBC_P_SIZE _ORELSE (id >= SBC_L_SAMPLE _ANDALSO id <= SBC_BR_MIXRAD)) THEN CONFIG_save ' (the painting set and the shapes are not DRAW.cfg, but SOFT, which saves itself; the fill / spray / picker are)
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' Slider id back to its factory default (the universal value input: a
' middle-click, or a double-click on its track).
SUB SELBAR_reset (id AS INTEGER)
    DIM r AS INTEGER
    SELECT CASE id
        CASE SBC_FEATHER: r = VAL_apply%(CFG.SELECTION_FEATHER%, VAL_OP_RESET, 0, SELBAR_lo%(id), SELBAR_hi%(id))
        CASE SBC_TOLERANCE: r = VAL_apply%(CFG.WAND_TOLERANCE%, VAL_OP_RESET, 0, SELBAR_lo%(id), SELBAR_hi%(id))
        CASE SBC_SHAPE_W: r = VAL_apply%(CFG.SELECTION_SHAPE_W%, VAL_OP_RESET, 0, 1, 8192)
        CASE SBC_SHAPE_H: r = VAL_apply%(CFG.SELECTION_SHAPE_H%, VAL_OP_RESET, 0, 1, 8192)
        CASE SBC_PATHSMOOTH: r = VAL_apply%(CFG.SELECTION_SMOOTH%, VAL_OP_RESET, 0, SELBAR_lo%(id), SELBAR_hi%(id))
        CASE SBC_AMOUNT: r = VAL_apply%(CFG.SELECTION_GROW%, VAL_OP_RESET, 0, SELBAR_lo%(id), SELBAR_hi%(id))
        CASE SBC_P_SIZE: SELBAR_set id, CFG.DEFAULT_BRUSH_SIZE%, FALSE ' (the start size: Settings > GENERAL)
        CASE SBC_P_SOFT: SELBAR_set id, 0, FALSE
        CASE SBC_P_OPACITY: SELBAR_set id, 100, FALSE
        CASE SBC_LN_SPOKES, SBC_RC_HDIV TO SBC_EL_RINGS: SELBAR_set id, 0, FALSE
        CASE SBC_SS_SIDES TO SBC_SS_THICK: SELBAR_set id, SELBAR_ss_def%(id), FALSE
        CASE SBC_FL_TOL: SELBAR_set id, 0, TRUE
        CASE SBC_SP_SPREAD TO SBC_SP_FLOW: SELBAR_set id, 100, TRUE
        CASE SBC_PK_LOUPE: CFG.PICKER_LOUPE_ZOOM_LEVEL% = 0: CONFIG_save ' (0 = the theme's zoom)
        CASE SBC_BR_SMUDGE, SBC_BR_LENGTH: SELBAR_set id, 50, TRUE
        CASE SBC_BR_MIXRAD: SELBAR_set id, 100, TRUE
        CASE SBC_MP_SIZE TO SBC_MP_TWIST: MPS_reset SELBAR_mps%(id)
        CASE SBC_CR_W: SELBAR_set id, SCRN.canvasW&, FALSE
        CASE SBC_CR_H: SELBAR_set id, SCRN.canvasH&, FALSE
    END SELECT
    IF r THEN CONFIG_save
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' A smart-shape slider's factory value (the SS_*.BI defaults).
FUNCTION SELBAR_ss_def% (id AS INTEGER)
    DIM r AS INTEGER
    SELECT CASE id
        CASE SBC_SS_SIDES: r = 5
        CASE SBC_SS_PDEPTH, SBC_SS_ROUND, SBC_SS_FLARE, SBC_SS_LINT: r = 100
        CASE SBC_SS_SLICES, SBC_SS_BEVEL: r = 4
        CASE SBC_SS_RADIUS: r = 5
        CASE SBC_SS_SEGS: r = 1
        CASE SBC_SS_MOUTH: r = 60
        CASE SBC_SS_ZDEPTH: r = 30
        CASE SBC_SS_TILT: r = _IIF(CURRENT_TOOL% = TOOL_SS_3D_TEXT, 15, 25)
        CASE SBC_SS_TURN: r = _IIF(CURRENT_TOOL% = TOOL_SS_3D_TEXT, -15, -25)
        CASE SBC_SS_LAZ: r = -35
        CASE SBC_SS_LEL: r = 45
        CASE SBC_SS_STEM: r = 50
        CASE SBC_SS_HEAD: r = 35
        CASE SBC_SS_THICK: r = 20
    END SELECT
    SELBAR_ss_def% = r
END FUNCTION

''
' A middle-click (viewport px) on a slider or its value: its default. TRUE when taken.
FUNCTION SELBAR_middle% (inX AS INTEGER, inY AS INTEGER)
    DIM i AS INTEGER
    IF SELBAR.visible = 0 _ORELSE SELBAR_is_over_area%(inX, inY) = 0 THEN EXIT FUNCTION
    SELBAR_middle% = TRUE
    i = SELBAR_hit%(PSURF_mx%(DP_SELBAR, inX), PSURF_my%(DP_SELBAR, inY))
    IF i = 0 THEN EXIT FUNCTION
    IF SELBAR_kind%(SB_ID(i)) = 3 THEN SELBAR_reset SB_ID(i)
END FUNCTION

''
' A control's width (its units).
FUNCTION SELBAR_ctl_w% (id AS INTEGER)
    IF SELBAR_kind%(id) = 3 THEN
        SELBAR_ctl_w% = SELBAR_tw%(SELBAR_label$(id)) + 3 + SELBAR_TRACK_W + 3 + _MAX(SELBAR_tw%(SELBAR_disp$(id, SELBAR_hi%(id))), SELBAR_tw%(SELBAR_disp$(id, SELBAR_lo%(id))))
    ELSEIF SELBAR_kind%(id) = 5 THEN
        SELBAR_ctl_w% = SELBAR_tw%(SELBAR_label$(id)) + 2
    ELSE
        SELBAR_ctl_w% = SELBAR_tw%(SELBAR_label$(id)) + 8
    END IF
END FUNCTION


'
' The controls for the current tool, in order (0 = a group break), into lst(); returns
' how many (0 = the tool has nothing on the bar, so the bar does not show).
FUNCTION SELBAR_list% (lst() AS INTEGER)
    DIM n AS INTEGER
    REDIM lst(1 TO SELBAR_MAX_CTL) AS INTEGER
    IF TRANSFORM.ACTIVE THEN ' (the transform overlay, whatever the tool: Enter / Esc)
        n = SELBAR_list_add%(lst(), 0, SBC_TR_APPLY, SBC_TR_CANCEL)
        SELBAR_list% = n
        EXIT FUNCTION
    END IF
    SELECT CASE CURRENT_TOOL%
        CASE TOOL_MARQUEE
            IF CROP.STATE = CROP_STATE_ACTIVE THEN ' (crop runs on the marquee)
                IF MARQUEE.ACTIVE% THEN n = SELBAR_list_add%(lst(), 0, SBC_CR_W, SBC_CR_H)
                n = SELBAR_list_add%(lst(), n, SBC_CR_APPLY, SBC_CR_CANCEL)
                n = SELBAR_list_add%(lst(), n, SBC_CR_TRIM, SBC_CR_WHOLE)
            ELSE
                n = SELBAR_list_select%(lst()) ' (the selection tools: unchanged)
            END IF
        CASE TOOL_BRUSH
            n = SELBAR_list_paint%(lst(), TRUE, TRUE)
            n = SELBAR_list_add%(lst(), n, SBC_BR_MIX, SBC_BR_MIX)
            IF CFG.BRUSH_MIX% THEN n = SELBAR_list_more%(lst(), n, SBC_BR_SMUDGE, SBC_BR_MIXRAD)
            IF SCREEN_pattern_tile_allowed% _ORELSE SCRN.patternTileMode% THEN n = SELBAR_list_add%(lst(), n, SBC_BR_TILE, SBC_BR_TILE)
        CASE TOOL_DOT: n = SELBAR_list_paint%(lst(), TRUE, TRUE)
        CASE TOOL_ERASER
            n = SELBAR_list_paint%(lst(), TRUE, FALSE)
            n = SELBAR_list_add%(lst(), n, SBC_ER_SMART, SBC_ER_SMART)
        CASE TOOL_MYPAINT
            n = n + 1: lst(n) = _IIF(CFG.MYPAINT_SIZE_FROM_BRUSH%, SBC_P_SIZE, SBC_MP_SIZE) ' (DRAW's brush size, or the brush's own)
            n = SELBAR_list_more%(lst(), n, SBC_MP_FROMBR, SBC_MP_FROMBR)
            n = SELBAR_list_add%(lst(), n, SBC_MP_OPAQUE, SBC_MP_TWIST)
            n = SELBAR_list_add%(lst(), n, SBC_MP_BRUSHES, SBC_MP_SETTINGS)
        CASE TOOL_MOVE
            n = SELBAR_list_add%(lst(), 0, SBC_MV_FLIPH, SBC_MV_FLIPV)
            n = SELBAR_list_add%(lst(), n, SBC_MV_ROTCCW, SBC_MV_ROTCW)
            n = SELBAR_list_add%(lst(), n, SBC_MV_HALF, SBC_MV_DOUBLE)
        CASE TOOL_ZOOM, TOOL_PAN
            n = SELBAR_list_add%(lst(), 0, SBC_VW_OUT, SBC_VW_100)
            n = SELBAR_list_add%(lst(), n, SBC_VW_FIT, SBC_VW_CENTER)
        CASE TOOL_SPRAY
            n = SELBAR_list_paint%(lst(), TRUE, FALSE)
            n = SELBAR_list_add%(lst(), n, SBC_SP_SPREAD, SBC_SP_DENSITY)
            IF CFG.ANTIALIAS% THEN n = n + 1: lst(n) = SBC_SP_FLOW ' (the airbrush's)
        CASE TOOL_POLYGON, TOOL_POLYGON_FILLED
            n = SELBAR_list_paint%(lst(), (CURRENT_TOOL% = TOOL_POLYGON), FALSE) ' (filled: no outline, no size or shape)
            n = SELBAR_list_add%(lst(), n, SBC_L_SNAP, SBC_LN_SNAPPX)
            n = SELBAR_list_add%(lst(), n, SBC_PL_FINISH, SBC_PL_CANCEL)
        CASE TOOL_BEZIER
            n = SELBAR_list_paint%(lst(), TRUE, FALSE)
            n = SELBAR_list_add%(lst(), n, SBC_BZ_HANDLES, SBC_BZ_CANCEL)
        CASE TOOL_LINE: n = SELBAR_list_paint%(lst(), TRUE, FALSE): n = SELBAR_list_line%(lst(), n)
        CASE TOOL_RECT: n = SELBAR_list_paint%(lst(), TRUE, FALSE): n = SELBAR_list_add%(lst(), n, SBC_RC_HDIV, SBC_RC_VDIV)
        CASE TOOL_RECT_FILLED: n = SELBAR_list_paint%(lst(), FALSE, FALSE): n = SELBAR_list_add%(lst(), n, SBC_RC_HDIV, SBC_RC_VDIV)
        CASE TOOL_ELLIPSE: n = SELBAR_list_paint%(lst(), TRUE, FALSE): n = SELBAR_list_add%(lst(), n, SBC_EL_SLICES, SBC_EL_RINGS)
        CASE TOOL_ELLIPSE_FILLED: n = SELBAR_list_paint%(lst(), FALSE, FALSE): n = SELBAR_list_add%(lst(), n, SBC_EL_SLICES, SBC_EL_RINGS)
        CASE TOOL_SS_POLYGON TO TOOL_SS_3D_TEXT: n = SELBAR_list_ss%(lst())
        CASE TOOL_FILL ' (a leading group break lays out as nothing)
            n = SELBAR_list_add%(lst(), 0, SBC_L_SAMPLE, SBC_L_SAMPLE)
            n = SELBAR_list_more%(lst(), n, SBC_FL_S0, SBC_FL_S0 + 3)
            n = SELBAR_list_add%(lst(), n, SBC_FL_TOL, SBC_FL_CONTIG)
            n = SELBAR_list_add%(lst(), n, SBC_FL_GRID, SBC_FL_ADJ)
            n = SELBAR_list_add%(lst(), n, SBC_L_BLEND, SBC_FL_B0 + 3)
        CASE TOOL_PICKER
            n = SELBAR_list_add%(lst(), 0, SBC_L_SAMPLE, SBC_L_SAMPLE)
            n = SELBAR_list_more%(lst(), n, SBC_PK_S0, SBC_PK_S0 + 2)
            n = SELBAR_list_add%(lst(), n, SBC_L_AREA, SBC_PK_SZ0 + 2)
            n = SELBAR_list_add%(lst(), n, SBC_PK_LOUPE, SBC_PK_LOUPE)
    END SELECT
    SELBAR_list% = n
END FUNCTION


''
' The shared painting set: SIZE, SHAPE (+ SOFT for round / slant), OPACITY, PIXEL
' PERFECT (brush and dot) / AA, SYMMETRY. nib = the tool draws with the brush's size and
' shape (not with a custom brush up: it draws with that); pp = PIXEL PERFECT applies.
FUNCTION SELBAR_list_paint% (lst() AS INTEGER, nib AS INTEGER, pp AS INTEGER)
    DIM n AS INTEGER, i AS INTEGER
    IF nib _ANDALSO CUSTOM_BRUSH_is_active% = 0 THEN
        n = n + 1: lst(n) = SBC_P_SIZE
        n = n + 1: lst(n) = 0
        FOR i = SBC_L_SHAPE TO SBC_P_BACKSLASH: n = n + 1: lst(n) = i: NEXT i
        IF BRUSH_SIZE.SHAPE <> BRUSH_SHAPE_SQUARE THEN n = n + 1: lst(n) = SBC_P_SOFT
        n = n + 1: lst(n) = 0
    END IF
    n = n + 1: lst(n) = SBC_P_OPACITY
    n = n + 1: lst(n) = 0
    IF pp THEN n = n + 1: lst(n) = SBC_P_PIXPERF
    n = n + 1: lst(n) = SBC_P_AA
    n = n + 1: lst(n) = 0
    FOR i = SBC_L_SYM TO SBC_P_SYM3: n = n + 1: lst(n) = i: NEXT i
    SELBAR_list_paint% = n
END FUNCTION


''
' The smart shapes: the painting set (the outline draws with the brush), KIND, OUTLINE /
' FILLED, then every option of the kind - the values the keys and the wheel change while
' dragging (SMART_SHAPES_tooltip_line*$ lists those keys).
FUNCTION SELBAR_list_ss% (lst() AS INTEGER)
    DIM n AS INTEGER, t AS INTEGER
    t = CURRENT_TOOL%
    n = SELBAR_list_paint%(lst(), (t <> TOOL_SS_3D_TEXT), FALSE)
    n = SELBAR_list_add%(lst(), n, SBC_L_KIND, SBC_SS_K9)
    IF t <> TOOL_SS_3D_TEXT THEN n = SELBAR_list_add%(lst(), n, SBC_SS_OUTLINE, SBC_SS_FILLED)
    SELECT CASE t
        CASE TOOL_SS_POLYGON
            n = SELBAR_list_add%(lst(), n, SBC_SS_SIDES, SBC_SS_PDEPTH)
            n = SELBAR_list_add%(lst(), n, SBC_SS_SNAPV, SBC_SS_LOCKROT)
        CASE TOOL_SS_PIE_DONUT: n = SELBAR_list_add%(lst(), n, SBC_SS_SLICES, SBC_SS_PIEHOLE)
        CASE TOOL_SS_ROUNDED_RECT: n = SELBAR_list_add%(lst(), n, SBC_SS_RADIUS, SBC_SS_RADIUS)
        CASE TOOL_SS_TAB
            n = SELBAR_list_add%(lst(), n, SBC_SS_RADIUS, SBC_SS_RADIUS)
            n = SELBAR_list_add%(lst(), n, SBC_L_FLAT, SBC_SS_FLAT0 + 3)
        CASE TOOL_SS_PILL: n = SELBAR_list_add%(lst(), n, SBC_SS_ROUND, SBC_SS_SEGS)
        CASE TOOL_SS_PACMAN: n = SELBAR_list_add%(lst(), n, SBC_SS_MOUTH, SBC_SS_PACHOLE)
        CASE TOOL_SS_3D_CUBE
            n = SELBAR_list_add%(lst(), n, SBC_L_DICE, SBC_SS_D0 + 6)
            n = SELBAR_list_add%(lst(), n, SBC_SS_ZDEPTH, SBC_SS_TURN)
            n = SELBAR_list_add%(lst(), n, SBC_L_LIGHT, SBC_SS_LINT)
        CASE TOOL_SS_BEVEL_RECT
            n = SELBAR_list_add%(lst(), n, SBC_SS_BEVEL, SBC_SS_BORDER)
            n = SELBAR_list_add%(lst(), n, SBC_SS_INNER, SBC_SS_OUTER)
        CASE TOOL_SS_ARROW: n = SELBAR_list_add%(lst(), n, SBC_SS_STEM, SBC_SS_THICK)
        CASE TOOL_SS_3D_TEXT
            n = SELBAR_list_add%(lst(), n, SBC_SS_ZDEPTH, SBC_SS_TURN)
            n = SELBAR_list_add%(lst(), n, SBC_L_LIGHT, SBC_SS_LINT)
    END SELECT
    SELBAR_list_ss% = n
END FUNCTION

''
' After n entries: controls a..b in the same group (no break); returns the new count.
FUNCTION SELBAR_list_more% (lst() AS INTEGER, n AS INTEGER, a AS INTEGER, b AS INTEGER)
    DIM m AS INTEGER, i AS INTEGER
    m = n
    FOR i = a TO b: m = m + 1: lst(m) = i: NEXT i
    SELBAR_list_more% = m
END FUNCTION

''
' After n entries: a group break then controls a..b; returns the new count.
FUNCTION SELBAR_list_add% (lst() AS INTEGER, n AS INTEGER, a AS INTEGER, b AS INTEGER)
    DIM m AS INTEGER, i AS INTEGER
    m = n + 1: lst(m) = 0
    FOR i = a TO b: m = m + 1: lst(m) = i: NEXT i
    SELBAR_list_add% = m
END FUNCTION

''
' The line's own controls after n entries: START / END caps, SPOKES, the snap angle.
FUNCTION SELBAR_list_line% (lst() AS INTEGER, n AS INTEGER)
    DIM m AS INTEGER
    m = SELBAR_list_add%(lst(), n, SBC_L_START, SBC_LN_SC0 + 3)
    m = SELBAR_list_add%(lst(), m, SBC_L_END, SBC_LN_EC0 + 3)
    m = SELBAR_list_add%(lst(), m, SBC_LN_SPOKES, SBC_LN_SPOKES)
    m = SELBAR_list_add%(lst(), m, SBC_L_SNAP, SBC_LN_SNAPPX)
    SELBAR_list_line% = m
END FUNCTION

''
' A snap-angle chip's degrees.
FUNCTION SELBAR_snap_deg% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_LN_SNAP15: SELBAR_snap_deg% = 15
        CASE SBC_LN_SNAP15 + 1: SELBAR_snap_deg% = 30
        CASE SBC_LN_SNAP15 + 2: SELBAR_snap_deg% = 45
        CASE SBC_LN_SNAP15 + 3: SELBAR_snap_deg% = 90
    END SELECT
END FUNCTION


''
' The selection tools' controls (the marquee and its variants), as the Selection Bar
' has always had them.
FUNCTION SELBAR_list_select% (lst() AS INTEGER)
    DIM n AS INTEGER, i AS INTEGER, v AS INTEGER
    FOR i = SBC_REPLACE TO SBC_INTERSECT: n = n + 1: lst(n) = i: NEXT i
    n = n + 1: lst(n) = 0
    n = n + 1: lst(n) = SBC_FEATHER
    n = n + 1: lst(n) = SBC_FEATHER_GO
    v = MARQUEE.VARIANT
    SELECT CASE v
        CASE TOOL_SELECT_WAND
            n = n + 1: lst(n) = 0
            FOR i = SBC_TOLERANCE TO SBC_AAEDGE: n = n + 1: lst(n) = i: NEXT i
        CASE TOOL_SELECT_FREE, TOOL_SELECT_POLY
            n = n + 1: lst(n) = 0
            n = n + 1: lst(n) = SBC_PATHSMOOTH
        CASE ELSE ' rectangle, ellipse
            n = n + 1: lst(n) = 0
            FOR i = SBC_FREE TO SBC_SIZE: n = n + 1: lst(n) = i: NEXT i
            IF CFG.SELECTION_SHAPE% <> 0 THEN
                n = n + 1: lst(n) = SBC_SHAPE_W
                n = n + 1: lst(n) = SBC_SHAPE_H
            END IF
            n = n + 1: lst(n) = SBC_CENTER
    END SELECT
    n = n + 1: lst(n) = 0
    FOR i = SBC_AMOUNT TO SBC_DESELECT: n = n + 1: lst(n) = i: NEXT i
    SELBAR_list_select% = n
END FUNCTION


''
' Lay the controls out in a bar w wide at (ox, oy): they wrap into lines (a group
' starts a line of its own when it would not fit whole beside the last). Returns the
' lines; keep = store the places (SB_*) for the render and the hit tests.
FUNCTION SELBAR_layout% (ox AS INTEGER, oy AS INTEGER, w AS INTEGER, keep AS INTEGER)
    DIM n AS INTEGER, i AS INTEGER, j AS INTEGER, id AS INTEGER, cw AS INTEGER, gw AS INTEGER
    DIM cx AS INTEGER, ly AS INTEGER, lines AS INTEGER, rowH AS INTEGER, x1 AS INTEGER, x2 AS INTEGER
    DIM lst(1 TO 1) AS INTEGER
    n = SELBAR_list%(lst())
    rowH = SELBAR_row_h%
    x1 = ox + 4: x2 = ox + w - 3
    cx = x1: ly = oy: lines = 1
    IF keep THEN SB_N = 0
    FOR i = 1 TO n
        id = lst(i)
        IF id = 0 THEN
            ' the group's whole width: a new line when it does not fit here
            gw = 0
            FOR j = i + 1 TO n
                IF lst(j) = 0 THEN EXIT FOR
                gw = gw + SELBAR_ctl_w%(lst(j)) + 2
            NEXT j
            IF cx > x1 THEN
                IF cx + 6 + gw > x2 THEN
                    cx = x1: ly = ly + rowH: lines = lines + 1
                ELSE
                    cx = cx + 6
                END IF
            END IF
        ELSE
            cw = SELBAR_ctl_w%(id)
            IF cx > x1 _ANDALSO cx + cw > x2 THEN cx = x1: ly = ly + rowH: lines = lines + 1
            IF keep _ANDALSO SB_N < SELBAR_MAX_CTL THEN
                SB_N = SB_N + 1
                SB_ID(SB_N) = id: SB_X(SB_N) = cx: SB_Y(SB_N) = ly: SB_W(SB_N) = cw
                SB_TX(SB_N) = cx + SELBAR_tw%(SELBAR_label$(id)) + 3
            END IF
            cx = cx + cw + 2
        END IF
    NEXT i
    SELBAR_layout% = lines
END FUNCTION


''
' Its height at width w (the dock: DP_H_FIXED, as the text bar).
FUNCTION SELBAR_h_for% (w AS INTEGER)
    SELBAR_h_for% = SELBAR_row_h% * SELBAR_layout%(0, 0, w, FALSE)
END FUNCTION


''
' Draw the bar into _DEST (SCRN.GUI&, or its own surface at a Scale) at its rect.
SUB SELBAR_render ()
    DIM i AS INTEGER, id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, rowH AS INTEGER
    DIM k AS INTEGER, lit AS INTEGER, fg AS _UNSIGNED LONG, bg AS _UNSIGNED LONG, t AS STRING
    DIM v AS INTEGER, lo AS INTEGER, hi AS INTEGER, fillW AS INTEGER, tx AS INTEGER
    DIM oldFont AS LONG, ty AS INTEGER
    IF SELBAR.visible = 0 _ORELSE SELBAR.w <= 0 _ORELSE SELBAR.h <= 0 THEN EXIT SUB
    LINE (SELBAR.x, SELBAR.y)-(SELBAR.x + SELBAR.w - 1, SELBAR.y + SELBAR.h - 1), THEME.TEXT_BAR_BG~&, BF
    ' its bottom border - none in a bottom row: there the row's seam is its first pixel row,
    ' so its lines start one lower (as the text bar: TEXT_BAR_render)
    DIM sbTop AS INTEGER
    IF DOCK_in_row%(DP_SELBAR) _ANDALSO DOCK_floating%(DP_SELBAR) = 0 _ANDALSO DOCK_panel_side%(DP_SELBAR) = DOCK_BOTTOM THEN
        sbTop = 1
    ELSE
        LINE (SELBAR.x + 2, SELBAR.y + SELBAR.h - 1)-(SELBAR.x + SELBAR.w - 3, SELBAR.y + SELBAR.h - 1), THEME.TEXT_BAR_BORDER~&
    END IF
    REGION_set_bounds REGION_SEL_BAR, SELBAR.x, SELBAR.y, SELBAR.w, SELBAR.h, ZORDER_PANEL ' (its footprint at a Scale: PSURF_render)
    rowH = SELBAR_row_h%
    ' too short for its lines (a short column, a small window): scroll, by whole lines
    SELBAR.contentH = rowH * SELBAR_layout%(0, 0, SELBAR.w, FALSE)
    SELBAR.scroll = _MAX(0, _MIN(SELBAR.scroll, SELBAR.contentH - SELBAR.h))
    SELBAR.lines = SELBAR_layout%(SELBAR.x, SELBAR.y + sbTop - SELBAR.scroll, SELBAR.w, TRUE)
    oldFont& = _FONT
    IF MENU_BAR.fontHandle& > 0 THEN _FONT MENU_BAR.fontHandle&
    _PRINTMODE _KEEPBACKGROUND
    ty = (rowH - _UFONTHEIGHT) \ 2
    FOR i = 1 TO SB_N
        id = SB_ID(i): x = SB_X(i): y = SB_Y(i): w = SB_W(i)
        k = SELBAR_kind%(id): t = SELBAR_label$(id)
        IF SELBAR_shown%(i) = 0 THEN _CONTINUE ' (scrolled out of the bar)
        ' a group's first control: a faint divider before it
        IF i > 1 _ANDALSO x > SELBAR.x + 4 _ANDALSO SELBAR_group_start%(id) THEN LINE (x - 4, y + 2)-(x - 4, y + rowH - 4), THEME.TEXT_BAR_BTN_BORDER~&
        IF k = 3 THEN
            v = SELBAR_val%(id): lo = SELBAR_lo%(id): hi = SELBAR_hi%(id)
            COLOR THEME.TEXT_BAR_FG~&, _RGBA32(0, 0, 0, 0)
            _UPRINTSTRING (x, y + ty), t
            tx = SB_TX(i)
            LINE (tx, y + 3)-(tx + SELBAR_TRACK_W - 1, y + rowH - 4), THEME.TEXT_BAR_BTN_BG~&, BF
            fillW = 0
            IF hi > lo THEN fillW = ((_MIN(v, hi) - lo) * (SELBAR_TRACK_W - 2) + (hi - lo) \ 2) \ (hi - lo)
            IF fillW > 0 THEN LINE (tx + 1, y + 4)-(tx + fillW, y + rowH - 5), THEME.TEXT_BAR_BTN_ACTIVE~&, BF
            IF SELBAR.hover = id _ORELSE SELBAR.drag = id THEN
                LINE (tx, y + 3)-(tx + SELBAR_TRACK_W - 1, y + rowH - 4), THEME.TEXT_BAR_FG~&, B
            ELSE
                LINE (tx, y + 3)-(tx + SELBAR_TRACK_W - 1, y + rowH - 4), THEME.TEXT_BAR_BTN_BORDER~&, B
            END IF
            _UPRINTSTRING (tx + SELBAR_TRACK_W + 3, y + ty), SELBAR_disp$(id, v)
        ELSEIF k = 5 THEN
            COLOR THEME.TEXT_BAR_FG~&, _RGBA32(0, 0, 0, 0)
            _UPRINTSTRING (x, y + ty), t
        ELSE
            lit = (k <> 4 _ANDALSO SELBAR_on%(id) <> 0)
            IF lit THEN
                bg = THEME.TEXT_BAR_BTN_ACTIVE~&: fg = THEME.TEXT_BAR_FG~&
            ELSEIF SELBAR.hover = id THEN
                bg = THEME.TEXT_BAR_BTN_HOVER~&: fg = THEME.TEXT_BAR_FG~&
            ELSE
                bg = THEME.TEXT_BAR_BTN_BG~&: fg = THEME.TEXT_BAR_BTN_FG~&
            END IF
            LINE (x, y + 1)-(x + w - 1, y + rowH - 3), bg, BF
            LINE (x, y + 1)-(x + w - 1, y + rowH - 3), THEME.TEXT_BAR_BTN_BORDER~&, B
            COLOR fg, _RGBA32(0, 0, 0, 0)
            _UPRINTSTRING (x + 4, y + ty), t
        END IF
    NEXT i
    _FONT oldFont&
END SUB


''
' Is id the first control of its group (a divider before it)?
FUNCTION SELBAR_group_start% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_FEATHER, SBC_TOLERANCE, SBC_FREE, SBC_PATHSMOOTH, SBC_AMOUNT: SELBAR_group_start% = TRUE
        CASE SBC_L_SHAPE, SBC_P_OPACITY, SBC_L_SYM: SELBAR_group_start% = TRUE
        CASE SBC_L_START, SBC_L_END, SBC_LN_SPOKES, SBC_L_SNAP, SBC_RC_HDIV, SBC_EL_SLICES, SBC_PL_FINISH, SBC_BZ_HANDLES: SELBAR_group_start% = TRUE
        CASE SBC_P_PIXPERF: SELBAR_group_start% = TRUE
        CASE SBC_L_KIND, SBC_SS_OUTLINE, SBC_SS_SIDES, SBC_SS_SNAPV, SBC_SS_SLICES, SBC_SS_RADIUS, SBC_L_FLAT, SBC_SS_ROUND, SBC_SS_MOUTH: SELBAR_group_start% = TRUE
        CASE SBC_L_DICE, SBC_SS_ZDEPTH, SBC_L_LIGHT, SBC_SS_BEVEL, SBC_SS_INNER, SBC_SS_STEM: SELBAR_group_start% = TRUE
        CASE SBC_L_SAMPLE, SBC_FL_TOL, SBC_FL_GRID, SBC_L_BLEND, SBC_SP_SPREAD, SBC_L_AREA, SBC_PK_LOUPE: SELBAR_group_start% = TRUE
        CASE SBC_BR_MIX, SBC_BR_TILE, SBC_ER_SMART, SBC_MP_OPAQUE, SBC_MP_BRUSHES, SBC_MV_ROTCCW, SBC_MV_HALF: SELBAR_group_start% = TRUE
        CASE SBC_CR_APPLY, SBC_CR_TRIM, SBC_VW_FIT: SELBAR_group_start% = TRUE
        CASE SBC_P_AA: SELBAR_group_start% = (CURRENT_TOOL% <> TOOL_BRUSH _ANDALSO CURRENT_TOOL% <> TOOL_DOT) ' (after PIXEL PERFECT: the same group)
    END SELECT
END FUNCTION


''
' The control at (mx, my) - its units - as last drawn: an index into SB_*, 0 = none.
FUNCTION SELBAR_hit% (mx AS INTEGER, my AS INTEGER)
    DIM i AS INTEGER, rowH AS INTEGER
    rowH = SELBAR_row_h%
    FOR i = 1 TO SB_N
        IF mx >= SB_X(i) _ANDALSO mx < SB_X(i) + SB_W(i) _ANDALSO my >= SB_Y(i) _ANDALSO my < SB_Y(i) + rowH _ANDALSO SELBAR_shown%(i) THEN SELBAR_hit% = i: EXIT FUNCTION
    NEXT i
END FUNCTION


''
' Is control i (an SB_ index) inside the bar - not scrolled out of it?
FUNCTION SELBAR_shown% (i AS INTEGER)
    SELBAR_shown% = (SB_Y(i) >= SELBAR.y _ANDALSO SB_Y(i) + SELBAR_row_h% <= SELBAR.y + SELBAR.h + 1) ' (+1: a bottom row's lines start one lower)
END FUNCTION


''
' Is viewport (inX, inY) on the bar? Every click / hover / pan gate asks here.
FUNCTION SELBAR_is_over_area% (inX AS INTEGER, inY AS INTEGER)
    IF SELBAR.visible = 0 _ORELSE SELBAR.w <= 0 _ORELSE SELBAR.h <= 0 THEN EXIT FUNCTION
    IF DOCK_live%(DP_SELBAR) = 0 THEN EXIT FUNCTION
    IF WZ_blocked%(DP_SELBAR, inX, inY) THEN EXIT FUNCTION ' a window in front covers it here
    IF PSURF_on%(DP_SELBAR) THEN SELBAR_is_over_area% = PSURF_in%(DP_SELBAR, inX, inY): EXIT FUNCTION
    SELBAR_is_over_area% = (inX >= SELBAR.x _ANDALSO inX < SELBAR.x + SELBAR.w _ANDALSO inY >= SELBAR.y _ANDALSO inY < SELBAR.y + SELBAR.h)
END FUNCTION


''
' Hover (viewport px): redraw when the control under it changes.
SUB SELBAR_track (inX AS INTEGER, inY AS INTEGER)
    DIM h AS INTEGER, i AS INTEGER
    IF SELBAR_is_over_area%(inX, inY) THEN
        i = SELBAR_hit%(PSURF_mx%(DP_SELBAR, inX), PSURF_my%(DP_SELBAR, inY))
        IF i THEN h = SB_ID(i)
    END IF
    IF h <> SELBAR.hover THEN SELBAR.hover = h: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' Slider SB index i set from the pointer's x (its units).
SUB SELBAR_slide (i AS INTEGER, mx AS INTEGER)
    DIM id AS INTEGER, lo AS INTEGER, hi AS INTEGER, f AS SINGLE, v AS INTEGER
    id = SB_ID(i): lo = SELBAR_lo%(id): hi = SELBAR_hi%(id)
    f = (mx - SB_TX(i)) / (SELBAR_TRACK_W - 1)
    IF f < 0 THEN f = 0
    IF f > 1 THEN f = 1
    v = lo + CINT(f * (hi - lo))
    IF v <> SELBAR_val%(id) THEN SELBAR_set id, v, FALSE
END SUB


''
' A press (viewport px): TRUE when it was on the bar (taken).
FUNCTION SELBAR_click% (inX AS INTEGER, inY AS INTEGER)
    DIM i AS INTEGER, id AS INTEGER, mx AS INTEGER, my AS INTEGER
    IF SELBAR_is_over_area%(inX, inY) = 0 THEN EXIT FUNCTION
    SELBAR_click% = TRUE
    mx = PSURF_mx%(DP_SELBAR, inX): my = PSURF_my%(DP_SELBAR, inY)
    i = SELBAR_hit%(mx, my)
    IF i = 0 THEN EXIT FUNCTION
    id = SB_ID(i)
    SELECT CASE SELBAR_kind%(id)
        CASE 3 ' a slider: its track sets it and drags (SELBAR_drag_frame); a double-click resets it
            IF mx >= SB_TX(i) - 2 _ANDALSO mx < SB_TX(i) + SELBAR_TRACK_W + 2 THEN
                IF VAL_dbl%(DP_SELBAR * 1000& + id) THEN
                    SELBAR_reset id
                ELSE
                    SELBAR.drag = id
                    SELBAR_slide i, mx
                END IF
            ELSEIF mx >= SB_TX(i) + SELBAR_TRACK_W + 2 THEN ' its value: a double-click types one
                IF VAL_dbl%(DP_SELBAR * 1000& + 100 + id) THEN
                    DIM sbv AS INTEGER, sbHi AS INTEGER
                    sbv = SELBAR_val%(id): sbHi = SELBAR_hi%(id)
                    IF id = SBC_SHAPE_W _ORELSE id = SBC_SHAPE_H THEN sbHi = 8192
                    IF id = SBC_P_SIZE THEN ' typed in px, as it reads (odd sizes: 1, 3, 5 ...)
                        sbv = BRUSH_SIZE_pixels%
                        IF VAL_type%("Tool Options", "SIZE (PX)", sbv, BRUSH_PIXEL_SIZES(BRUSH_SIZE.MIN), BRUSH_PIXEL_SIZES(BRUSH_SIZE.MAX)) THEN SELBAR_set id, (sbv + 1) \ 2, TRUE
                    ELSEIF VAL_type%("Tool Options", SELBAR_label$(id), sbv, SELBAR_lo%(id), sbHi) THEN
                        SELBAR_set id, sbv, TRUE
                    END IF
                END IF
            END IF
        CASE 5 ' a label
        CASE ELSE
            SELBAR_press id
    END SELECT
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END FUNCTION


''
' A chip, toggle or button pressed.
SUB SELBAR_press (id AS INTEGER)
    SELECT CASE id
        CASE SBC_REPLACE TO SBC_INTERSECT: CMD_execute_action SELBAR_ACT_MODE0 + id - SBC_REPLACE
        CASE SBC_FREE TO SBC_SIZE: CFG.SELECTION_SHAPE% = id - SBC_FREE: CONFIG_save
        CASE SBC_CONTIGUOUS: CFG.WAND_CONTIGUOUS% = _IIF(CFG.WAND_CONTIGUOUS%, FALSE, TRUE): CONFIG_save
        CASE SBC_MERGED: CFG.WAND_SAMPLE_MERGED% = _IIF(CFG.WAND_SAMPLE_MERGED%, FALSE, TRUE): CONFIG_save
        CASE SBC_AAEDGE: CFG.WAND_ANTIALIAS% = _IIF(CFG.WAND_ANTIALIAS%, FALSE, TRUE): CONFIG_save
        CASE SBC_CENTER: CFG.SELECTION_FROM_CENTER% = _IIF(CFG.SELECTION_FROM_CENTER%, FALSE, TRUE): CONFIG_save
        CASE SBC_FEATHER_GO: CMD_execute_action SELBAR_ACT_FEATHER
        CASE SBC_GROW: CMD_execute_action SELBAR_ACT_GROW
        CASE SBC_SHRINK: CMD_execute_action SELBAR_ACT_SHRINK
        CASE SBC_SMOOTH: CMD_execute_action SELBAR_ACT_SMOOTH
        CASE SBC_INVERT: CMD_execute_action 311
        CASE SBC_DESELECT: CMD_execute_action 307
        CASE SBC_P_ROUND: BRUSH_SIZE_set_shape BRUSH_SHAPE_ROUND, BRUSH_SIZE.SOFT
        CASE SBC_P_SQUARE: BRUSH_SIZE_set_shape BRUSH_SHAPE_SQUARE, BRUSH_SIZE.SOFT
        CASE SBC_P_SLASH: BRUSH_SIZE_set_shape BRUSH_SHAPE_SLASH, BRUSH_SIZE.SOFT
        CASE SBC_P_BACKSLASH: BRUSH_SIZE_set_shape BRUSH_SHAPE_BACKSLASH, BRUSH_SIZE.SOFT
        CASE SBC_P_PIXPERF: CMD_execute_action 609 ' (F6: turns AA off)
        CASE SBC_P_AA: CMD_execute_action 958 ' (turns PIXEL PERFECT off)
        CASE SBC_P_SYM0 TO SBC_P_SYM3: SELBAR_sym_mode id - SBC_P_SYM0
        CASE SBC_LN_SC0 TO SBC_LN_SC0 + 3: LINE_TOOL.BAR_START_CAP = id - SBC_LN_SC0: LINE_TOOL.START_CAP = LINE_TOOL.BAR_START_CAP: SCENE_DIRTY% = TRUE
        CASE SBC_LN_EC0 TO SBC_LN_EC0 + 3: LINE_TOOL.BAR_END_CAP = id - SBC_LN_EC0: LINE_TOOL.END_CAP = LINE_TOOL.BAR_END_CAP: SCENE_DIRTY% = TRUE
        CASE SBC_LN_SNAP15 TO SBC_LN_SNAP15 + 3: CFG.ANGLE_SNAP_PIXEL_ART% = FALSE: CFG.ANGLE_SNAP_DEGREES% = SELBAR_snap_deg%(id): CONFIG_save
        CASE SBC_LN_SNAPPX: CFG.ANGLE_SNAP_PIXEL_ART% = TRUE: CONFIG_save
        ' the same calls Enter / Esc / ` make (INPUT/KEYBOARD.BM)
        CASE SBC_PL_FINISH: MOUSE_handle_right_click ' (the right-click finish: closes a filled polygon and records its undo; POLY_LINE_reset alone dropped the undo)
        CASE SBC_PL_CANCEL: POLY_LINE_cancel_restore
        CASE SBC_BZ_HANDLES: BEZIER.SHOW_HANDLES% = NOT BEZIER.SHOW_HANDLES%: SCENE_DIRTY% = TRUE
        CASE SBC_BZ_COMMIT: IF BEZIER.POINT_COUNT >= 1 THEN BEZIER_commit
        CASE SBC_BZ_CANCEL: BEZIER_cancel_restore
        CASE SBC_SS_K0 TO SBC_SS_K9: SMART_SHAPES_choose TOOL_SS_POLYGON + id - SBC_SS_K0
        CASE SBC_SS_OUTLINE: SS_BAR_FILLED = FALSE
        CASE SBC_SS_FILLED: SS_BAR_FILLED = TRUE
        ' the same as ` / ~ / I / O and the digits while dragging (INPUT/KEYBOARD.BM)
        CASE SBC_SS_SNAPV: SS_POLYGON.SNAP_VERTS = _IIF(SS_POLYGON.SNAP_VERTS, FALSE, TRUE): SCENE_DIRTY% = TRUE
        CASE SBC_SS_LOCKROT: SS_POLYGON.LOCK_ROTATION = _IIF(SS_POLYGON.LOCK_ROTATION, FALSE, TRUE): SCENE_DIRTY% = TRUE
        CASE SBC_SS_FLAT0 TO SBC_SS_FLAT0 + 3: SS_TAB.FLAT_SIDE = id - SBC_SS_FLAT0: SCENE_DIRTY% = TRUE
        CASE SBC_SS_D0 TO SBC_SS_D0 + 6: SS_CUBE.DICE_TYPE = SELBAR_dice%(id): SCENE_DIRTY% = TRUE
        CASE SBC_SS_INNER, SBC_SS_OUTER
            SS_BEVEL.STYLE = id - SBC_SS_INNER
            IF SS_BEVEL.BORDER_SIZE = 0 THEN SS_BEVEL.BORDER_SIZE = 1 ' (as I / O: a style shows only with a border)
            SCENE_DIRTY% = TRUE
        CASE SBC_FL_S0 TO SBC_FL_S0 + 3: CFG.FILL_SAMPLE% = id - SBC_FL_S0: CONFIG_save
        CASE SBC_FL_CONTIG: CFG.FILL_CONTIGUOUS% = _IIF(CFG.FILL_CONTIGUOUS%, FALSE, TRUE): CONFIG_save
        CASE SBC_FL_GRID: CMD_execute_action 908 ' (Grid > Cell Fill)
        CASE SBC_FL_ADJ: CMD_execute_action 909 ' (Fill Adjust on / off)
        CASE SBC_FL_B0 TO SBC_FL_B0 + 3: CFG.GRADIENT_BLEND_SPACE% = id - SBC_FL_B0: CONFIG_save: SCENE_DIRTY% = TRUE ' (Settings > Gradient Blend)
        CASE SBC_PK_S0 TO SBC_PK_S0 + 2: CFG.PICKER_SAMPLE% = id - SBC_PK_S0: CONFIG_save
        CASE SBC_PK_SZ0 TO SBC_PK_SZ0 + 2: CFG.PICKER_SAMPLE_SIZE% = 1 + 2 * (id - SBC_PK_SZ0): CONFIG_save
        CASE SBC_BR_MIX: CMD_execute_action 2026 ' (Brush > Mix Colors)
        CASE SBC_BR_TILE: CMD_execute_action 440 ' (View > Pattern Tile Mode)
        CASE SBC_ER_SMART: ERASER_BAR_SMART = _IIF(ERASER_BAR_SMART, FALSE, TRUE)
        CASE SBC_MP_FROMBR: CMD_execute_action MYPAINT_ACT_SIZE_FROM_BRUSH
        CASE SBC_MP_BRUSHES: CMD_execute_action MYPAINT_ACT_PANEL
        CASE SBC_MP_SETTINGS: CMD_execute_action MPS_ACT_PANEL
        ' the Edit menu's (Home / End / < / > / PgDn / PgUp)
        CASE SBC_MV_FLIPH: CMD_execute_action 315
        CASE SBC_MV_FLIPV: CMD_execute_action 316
        CASE SBC_MV_ROTCCW: CMD_execute_action 320
        CASE SBC_MV_ROTCW: CMD_execute_action 319
        CASE SBC_MV_HALF: CMD_execute_action 317
        CASE SBC_MV_DOUBLE: CMD_execute_action 318
        CASE SBC_TR_APPLY: TRANSFORM_commit
        CASE SBC_TR_CANCEL: TRANSFORM_cancel
        CASE SBC_CR_APPLY: CROP_apply
        CASE SBC_CR_CANCEL: CROP_cancel
        CASE SBC_CR_TRIM: CROP_trim_to_content
        CASE SBC_CR_WHOLE: CROP_cancel: CROP_begin TRUE ' (as Image > Crop: the whole image boxed)
        CASE SBC_VW_OUT: CMD_execute_action 407
        CASE SBC_VW_IN: CMD_execute_action 406
        CASE SBC_VW_100: CMD_execute_action 405
        CASE SBC_VW_FIT: ZOOM_fit_canvas: INVALIDATE_scene
        CASE SBC_VW_CENTER: CMD_execute_action 413
    END SELECT
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' Symmetry to mode m (0-3) the way F7 gets there - cycling, so a centre the user set
' stays and one first turned on starts at the canvas centre (SYMMETRY_cycle_mode).
SUB SELBAR_sym_mode (m AS INTEGER)
    DIM g AS INTEGER
    DO WHILE SYMMETRY.MODE% <> m _ANDALSO g < 4
        SYMMETRY_cycle_mode
        g = g + 1
    LOOP
END SUB


''
' Each frame while a slider is held (MOUSE.BM): follow the pointer; on release save.
' TRUE while it holds the mouse.
FUNCTION SELBAR_drag_frame% (inX AS INTEGER, held AS INTEGER)
    DIM i AS INTEGER
    IF SELBAR.drag = 0 THEN EXIT FUNCTION
    SELBAR_drag_frame% = TRUE
    IF held = 0 _ORELSE SELBAR.visible = 0 THEN
        SELBAR.drag = 0
        CONFIG_save
        GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
        EXIT FUNCTION
    END IF
    FOR i = 1 TO SB_N
        IF SB_ID(i) = SELBAR.drag THEN SELBAR_slide i, PSURF_mx%(DP_SELBAR, inX): EXIT FUNCTION
    NEXT i
END FUNCTION


''
' The wheel over a slider: one step a notch (Shift: 10). TRUE when taken.
FUNCTION SELBAR_wheel% (inX AS INTEGER, inY AS INTEGER, delta AS INTEGER)
    DIM i AS INTEGER, id AS INTEGER
    IF delta = 0 _ORELSE SELBAR_is_over_area%(inX, inY) = 0 THEN EXIT FUNCTION
    SELBAR_wheel% = TRUE
    i = SELBAR_hit%(PSURF_mx%(DP_SELBAR, inX), PSURF_my%(DP_SELBAR, inY))
    IF i THEN id = SB_ID(i)
    IF id = 0 _ORELSE SELBAR_kind%(id) <> 3 THEN ' off a slider: scroll a bar too short for its lines
        IF SELBAR.contentH > SELBAR.h THEN
            SELBAR.scroll = _MAX(0, _MIN(SELBAR.contentH - SELBAR.h, SELBAR.scroll - SGN(delta) * SELBAR_row_h%))
            GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
        END IF
        EXIT FUNCTION
    END IF
    SELBAR_set id, SELBAR_val%(id) + VAL_wheel_step%(SGN(delta)), TRUE ' (wheel up = more; Shift 10)
END FUNCTION


''
' QA dump: SELBAR visible x y w h lines mode feather tol contig merged aa shape sw sh center smooth grow tool
' then SELBARP (the painting set) and SELBARC id x y w per control (its units).
FUNCTION SELBAR_dump$ ()
    DIM d AS STRING, i AS INTEGER, lf AS STRING
    lf = CHR$(10)
    d = "SELBAR" + DOCK_n$(SELBAR.visible <> 0) + DOCK_n$(SELBAR.x) + DOCK_n$(SELBAR.y) + DOCK_n$(SELBAR.w) + DOCK_n$(SELBAR.h) + DOCK_n$(SELBAR.lines)
    d = d + DOCK_n$(SELBAR_mode%) + DOCK_n$(CFG.SELECTION_FEATHER%) + DOCK_n$(CFG.WAND_TOLERANCE%) + DOCK_n$(CFG.WAND_CONTIGUOUS% <> 0) + DOCK_n$(CFG.WAND_SAMPLE_MERGED% <> 0) + DOCK_n$(CFG.WAND_ANTIALIAS% <> 0)
    d = d + DOCK_n$(CFG.SELECTION_SHAPE%) + DOCK_n$(CFG.SELECTION_SHAPE_W%) + DOCK_n$(CFG.SELECTION_SHAPE_H%) + DOCK_n$(CFG.SELECTION_FROM_CENTER% <> 0) + DOCK_n$(CFG.SELECTION_SMOOTH%) + DOCK_n$(CFG.SELECTION_GROW%) + DOCK_n$(CURRENT_TOOL%) + lf
    ' SELM <a selection> <soft: a partly selected pixel> <x1 y1 x2 y2 canvas px> <mask>
    DIM sx1 AS INTEGER, sy1 AS INTEGER, sx2 AS INTEGER, sy2 AS INTEGER, hasM AS INTEGER
    hasM = (MARQUEE.WAND_HAS_SELECTION <> 0 _ANDALSO MARQUEE.SELECTION_MASK < -1)
    IF hasM THEN
        sx1 = MARQUEE.WAND_MIN_X: sy1 = MARQUEE.WAND_MIN_Y: sx2 = MARQUEE.WAND_MAX_X: sy2 = MARQUEE.WAND_MAX_Y
    ELSE
        sx1 = MARQUEE.BOX.x: sy1 = MARQUEE.BOX.y: sx2 = MARQUEE.BOX.x + MARQUEE.BOX.w - 1: sy2 = MARQUEE.BOX.y + MARQUEE.BOX.h - 1
    END IF
    d = d + "SELM" + DOCK_n$(SELECTION_has_active% <> 0) + DOCK_n$(hasM _ANDALSO SELMASK_is_soft%(MARQUEE.SELECTION_MASK)) + DOCK_n$(sx1) + DOCK_n$(sy1) + DOCK_n$(sx2) + DOCK_n$(sy2) + DOCK_n$(hasM <> 0) + lf
    ' SELBARP <size index> <size px> <shape> <soft> <opacity> <pixel perfect> <aa> <symmetry> - the painting set
    d = d + "SELBARP" + DOCK_n$(BRUSH_SIZE.CURRENT) + DOCK_n$(BRUSH_SIZE_pixels%) + DOCK_n$(BRUSH_SIZE.SHAPE) + DOCK_n$(BRUSH_SIZE.SOFT) + DOCK_n$(PAINT_OPACITY%)
    d = d + DOCK_n$(BRUSH_SIZE.PIXEL_PERFECT <> 0) + DOCK_n$(CFG.ANTIALIAS% <> 0) + DOCK_n$(SYMMETRY.MODE%) + lf
    ' SELBARS <spokes> <start cap> <end cap> <snap deg> <pixel-art snap> <rect | dividers> <rect - dividers> <slices> <rings>
    ' - the shapes' values for the next one (BAR_*)
    d = d + "SELBARS" + DOCK_n$(LINE_TOOL.BAR_SPOKES) + DOCK_n$(LINE_TOOL.BAR_START_CAP) + DOCK_n$(LINE_TOOL.BAR_END_CAP) + DOCK_n$(CFG.ANGLE_SNAP_DEGREES%) + DOCK_n$(CFG.ANGLE_SNAP_PIXEL_ART% <> 0)
    d = d + DOCK_n$(RECT_TOOL.BAR_H_DIV) + DOCK_n$(RECT_TOOL.BAR_V_DIV) + DOCK_n$(ELLIPSE_TOOL.BAR_SLICES) + DOCK_n$(ELLIPSE_TOOL.BAR_RINGS) + lf
    ' SELBARSS <filled> <sides> <point depth> <snap> <lock> <pie slices> <pie hole> <rr radius> <tab radius> <tab flat>
    '   <pill round> <pill segs> <mouth> <pac hole> <dice> <cube depth> <cube tilt> <cube turn> <text depth> <text tilt>
    '   <text turn> <light az> <light el> <light %> <bevel> <border> <style> <stem> <head> <flare> <thick> - the smart shapes
    d = d + "SELBARSS" + DOCK_n$(SS_BAR_FILLED <> 0) + DOCK_n$(SS_POLYGON.SIDES) + DOCK_n$(SS_POLYGON.POINT_DEPTH) + DOCK_n$(SS_POLYGON.SNAP_VERTS <> 0) + DOCK_n$(SS_POLYGON.LOCK_ROTATION <> 0)
    d = d + DOCK_n$(SS_PIE_DONUT.SLICES) + DOCK_n$(SS_PIE_DONUT.HOLE_PCT) + DOCK_n$(SS_RR.RADIUS) + DOCK_n$(SS_TAB.RADIUS) + DOCK_n$(SS_TAB.FLAT_SIDE)
    d = d + DOCK_n$(SS_PILL.ROUNDNESS_PCT) + DOCK_n$(SS_PILL.SEGMENTS) + DOCK_n$(SS_PACMAN.MOUTH_DEG) + DOCK_n$(SS_PACMAN.HOLE_PCT) + DOCK_n$(SS_CUBE.DICE_TYPE)
    d = d + DOCK_n$(SS_CUBE.Z_DEPTH) + DOCK_n$(SS_CUBE.ROT_X) + DOCK_n$(SS_CUBE.ROT_Y) + DOCK_n$(SS_TEXT.Z_DEPTH) + DOCK_n$(SS_TEXT.ROT_X) + DOCK_n$(SS_TEXT.ROT_Y)
    d = d + DOCK_n$(CINT(SS_LIGHT.AZIMUTH)) + DOCK_n$(CINT(SS_LIGHT.ELEVATION)) + DOCK_n$(CINT(SS_LIGHT.INTENSITY * 100)) + DOCK_n$(SS_BEVEL.BEVEL_SIZE) + DOCK_n$(SS_BEVEL.BORDER_SIZE) + DOCK_n$(SS_BEVEL.STYLE)
    d = d + DOCK_n$(SS_ARROW.STEM_FATNESS_PCT) + DOCK_n$(SS_ARROW.HEAD_LEN_PCT) + DOCK_n$(SS_ARROW.HEAD_FLARE_PCT) + DOCK_n$(SS_ARROW.THICKNESS) + lf
    ' SELBARF <fill sample> <tolerance> <contiguous> <grid cell> <adjust> <blend space> <spray spread> <density> <flow>
    '   <picker sample> <picker size> <loupe zoom as read> - the fill / spray / picker
    d = d + "SELBARF" + DOCK_n$(CFG.FILL_SAMPLE%) + DOCK_n$(CFG.FILL_TOLERANCE%) + DOCK_n$(CFG.FILL_CONTIGUOUS% <> 0) + DOCK_n$(GRID.CELL_FILL% <> 0) + DOCK_n$(FILL_ADJ.ENABLED% <> 0) + DOCK_n$(CFG.GRADIENT_BLEND_SPACE%)
    d = d + DOCK_n$(CFG.SPRAY_SPREAD%) + DOCK_n$(CFG.SPRAY_DENSITY%) + DOCK_n$(CFG.SPRAY_FLOW%) + DOCK_n$(CFG.PICKER_SAMPLE%) + DOCK_n$(CFG.PICKER_SAMPLE_SIZE%) + DOCK_n$(SELBAR_val%(SBC_PK_LOUPE)) + lf
    ' SELBARM <mix> <smudge> <length> <mix radius> <tile> <eraser all layers> <mypaint size = brush> <mypaint size>
    '   <mouse pressure> <twist> <crop state> <crop box w> <crop box h> <transform> <zoom x100> - brush .. view
    d = d + "SELBARM" + DOCK_n$(CFG.BRUSH_MIX% <> 0) + DOCK_n$(CFG.BRUSH_MIX_SMUDGE%) + DOCK_n$(CFG.BRUSH_MIX_LENGTH%) + DOCK_n$(CFG.BRUSH_MIX_RADIUS%) + DOCK_n$(SCRN.patternTileMode% <> 0)
    d = d + DOCK_n$(ERASER_BAR_SMART <> 0) + DOCK_n$(CFG.MYPAINT_SIZE_FROM_BRUSH% <> 0) + DOCK_n$(CFG.MYPAINT_SIZE%) + DOCK_n$(CFG.MYPAINT_MOUSE_PRESSURE%) + DOCK_n$(CFG.MYPAINT_TWIST%)
    d = d + DOCK_n$(CROP.STATE) + DOCK_n$(MARQUEE.BOX.w) + DOCK_n$(MARQUEE.BOX.h) + DOCK_n$(TRANSFORM.ACTIVE <> 0) + DOCK_n$(CINT(SCRN.zoom! * 100)) + lf
    d = d + "SELBARV" + DOCK_n$(SELBAR.scroll) + DOCK_n$(SELBAR.contentH) + lf ' SELBARV <scrolled px> <its lines' height> (its units)
    IF SELBAR.visible THEN
        FOR i = 1 TO SB_N
            d = d + "SELBARC" + DOCK_n$(SB_ID(i)) + DOCK_n$(SB_X(i)) + DOCK_n$(SB_Y(i)) + DOCK_n$(SB_W(i)) + DOCK_n$(SB_TX(i)) + lf
        NEXT i
    END IF
    SELBAR_dump$ = d
END FUNCTION

''
' The tooltip for the control under the pointer (screen px): its id (0 = none) and, in txt,
' two lines split by CHR$(10) - what it is, how it behaves. GUI/TOOLTIP.BM
' (TOOLTIP_SRC_SEL_BAR); the tooltip uppercases it.
FUNCTION SELBAR_tip_at% (inX AS INTEGER, inY AS INTEGER, txt AS STRING)
    DIM i AS INTEGER, id AS INTEGER
    txt = ""
    IF NOT SELBAR.visible THEN EXIT FUNCTION
    IF NOT SELBAR_is_over_area%(inX, inY) THEN EXIT FUNCTION
    i = SELBAR_hit%(PSURF_mx%(DP_SELBAR, inX), PSURF_my%(DP_SELBAR, inY))
    IF i = 0 THEN EXIT FUNCTION
    id = SB_ID(i)
    txt = SELBAR_tip$(id)
    IF LEN(txt) THEN SELBAR_tip_at% = id
END FUNCTION

''
' Control id's tooltip: "what" + CHR$(10) + "how".
FUNCTION SELBAR_tip$ (id AS INTEGER)
    DIM a AS STRING, b AS STRING
    SELECT CASE id
        CASE SBC_REPLACE:    a = "Replace": b = "A new selection replaces the old one"
        CASE SBC_ADD:        a = "Add": b = "New selections add to the old one (Shift does it once)"
        CASE SBC_SUBTRACT:   a = "Subtract": b = "New selections cut out of the old one (Alt does it once)"
        CASE SBC_INTERSECT:  a = "Intersect": b = "Keep only where old and new overlap (Shift+Alt once)"
        CASE SBC_FEATHER:    a = "Feather (px)": b = "Soft edge this wide on each new selection - 0 = hard"
        CASE SBC_FEATHER_GO: a = "Apply feather": b = "Feather the current selection by the FEATHER amount"
        CASE SBC_TOLERANCE:  a = "Tolerance": b = "How far a colour may be from the clicked one (0 = exact)"
        CASE SBC_CONTIGUOUS: a = "Contiguous": b = "On: only connected pixels. Off: every match on the layer"
        CASE SBC_MERGED:     a = "Sample merged": b = "Match colours in the visible image, not just this layer"
        CASE SBC_AAEDGE:     a = "Antialias edge": b = "Soften the wand selection's edge"
        CASE SBC_FREE:       a = "Free shape": b = "Drag any width and height"
        CASE SBC_RATIO:      a = "Fixed ratio": b = "Keep the W:H proportion while dragging"
        CASE SBC_SIZE:       a = "Fixed size": b = "A box exactly W x H pixels where you press"
        CASE SBC_SHAPE_W:    a = "Width": b = "W of the fixed ratio / size (wheel: +-1, Shift: +-10)"
        CASE SBC_SHAPE_H:    a = "Height": b = "H of the fixed ratio / size (wheel: +-1, Shift: +-10)"
        CASE SBC_CENTER:     a = "From center": b = "Drag out from the press point (Ctrl flips it while held)"
        CASE SBC_PATHSMOOTH: a = "Smooth path": b = "Round a freehand / polygon outline before it selects"
        CASE SBC_AMOUNT:     a = "Amount (px)": b = "How far GROW, SHRINK and SMOOTH go"
        CASE SBC_GROW:       a = "Grow": b = "Widen the selection by AMOUNT (Ctrl+Z undoes)"
        CASE SBC_SHRINK:     a = "Shrink": b = "Narrow the selection by AMOUNT (Ctrl+Z undoes)"
        CASE SBC_SMOOTH:     a = "Smooth": b = "Round the selection's corners by AMOUNT"
        CASE SBC_INVERT:     a = "Invert": b = "Select what is not selected (Ctrl+Shift+I)"
        CASE SBC_DESELECT:   a = "Deselect": b = "Drop the selection (Ctrl+D)"
        CASE SBC_P_SIZE:     a = "Brush size (px)": b = "[ / ] step it; wheel: +-1, Shift: +-10"
        CASE SBC_P_ROUND:    a = "Round brush": b = "A round nib (\ toggles round / square)"
        CASE SBC_P_SQUARE:   a = "Square brush": b = "A square nib (\ toggles round / square)"
        CASE SBC_P_SLASH:    a = "Slant brush /": b = "A flat nib from bottom-left to top-right"
        CASE SBC_P_BACKSLASH: a = "Slant brush \": b = "A flat nib from top-left to bottom-right"
        CASE SBC_P_SOFT:     a = "Soft edge (%)": b = "Feather a round or slant nib from its centre - 0 = hard"
        CASE SBC_P_OPACITY:  a = "Opacity (%)": b = "How much paint goes on (keys 1-0 = 10-100)"
        CASE SBC_P_PIXPERF:  a = "Pixel perfect": b = "Drop the corner pixels of a 1 px stroke (F6) - turns AA off"
        CASE SBC_P_AA
            IF CURRENT_TOOL% = TOOL_SPRAY THEN
                a = "Airbrush": b = "Spray a soft cloud of fine droplets that builds up (it is AA: on for every tool)"
            ELSE
                a = "Anti-aliasing": b = "Smooth edges on lines and shapes - turns PIXEL PERFECT off"
            END IF
        CASE SBC_P_SYM0:     a = "Symmetry off": b = "No mirroring (F7 cycles the modes, F8 clears)"
        CASE SBC_P_SYM0 + 1: a = "Mirror |": b = "Mirror left / right (Ctrl+click sets the centre)"
        CASE SBC_P_SYM0 + 2: a = "Mirror +": b = "Mirror four ways (Ctrl+click sets the centre)"
        CASE SBC_P_SYM3:     a = "Mirror *": b = "Mirror eight ways (Ctrl+click sets the centre)"
        CASE SBC_LN_SC0 TO SBC_LN_SC0 + 3: a = "Start cap": b = "The shape at each new line's start (S while dragging: this line only)"
        CASE SBC_LN_EC0 TO SBC_LN_EC0 + 3: a = "End cap": b = "The shape at each new line's end (E while dragging: this line only)"
        CASE SBC_LN_SPOKES:  a = "Spokes": b = "Extra lines fanned round the start, evenly (arrows while dragging: this line only)"
        CASE SBC_LN_SNAP15 TO SBC_LN_SNAP15 + 3: a = "Snap angle": b = "Ctrl+Shift while dragging snaps the line to steps of this many degrees"
        CASE SBC_LN_SNAPPX:  a = "Pixel-art angles": b = "Ctrl+Shift snaps to clean pixel steps (1:1, 1:2, 2:1 ...)"
        CASE SBC_RC_HDIV:    a = "Divide across": b = "Vertical lines splitting each new rectangle into equal columns"
        CASE SBC_RC_VDIV:    a = "Divide down": b = "Horizontal lines splitting each new rectangle into equal rows"
        CASE SBC_EL_SLICES:  a = "Slices": b = "Lines through the centre of each new ellipse (2 x this many pie slices)"
        CASE SBC_EL_RINGS:   a = "Rings": b = "Inner ellipses, evenly spaced, in each new ellipse"
        CASE SBC_PL_FINISH:  a = "Finish": b = "End the polygon here, as a right-click"
        CASE SBC_PL_CANCEL:  a = "Cancel": b = "Drop the polygon being drawn (Esc)"
        CASE SBC_BZ_HANDLES: a = "Show handles": b = "Draw and grab the curve handles (` while a path is open)"
        CASE SBC_BZ_COMMIT:  a = "Commit": b = "Draw the path onto the layer (Enter)"
        CASE SBC_BZ_CANCEL:  a = "Cancel": b = "Drop the path being drawn (Esc)"
        CASE SBC_SS_K0 TO SBC_SS_K9: a = "Smart shape: " + SELBAR_label$(id): b = "Switch to this kind (S twice cycles the kinds)"
        CASE SBC_SS_OUTLINE: a = "Outline": b = "A left-drag draws the outline; a right-drag a filled one"
        CASE SBC_SS_FILLED:  a = "Filled": b = "A left-drag draws it filled; a right-drag the outline"
        CASE SBC_SS_SIDES:   a = "Sides": b = "How many corners (up / down or 3-9, 0-2 while dragging)"
        CASE SBC_SS_PDEPTH:  a = "Point depth (%)": b = "100 = a regular polygon, less = a star, more = a burst (left / right)"
        CASE SBC_SS_SNAPV:   a = "Grid snap": b = "Snap each corner to the grid (`)"
        CASE SBC_SS_LOCKROT: a = "No spin": b = "Keep the polygon upright while dragging round (~)"
        CASE SBC_SS_SLICES:  a = "Slices": b = "Pie slices (up / down while dragging)"
        CASE SBC_SS_PIEHOLE: a = "Hole (%)": b = "The donut hole - 0 = a pie (left / right)"
        CASE SBC_SS_RADIUS:  a = "Corner radius (px)": b = "How round the corners are (up / down while dragging)"
        CASE SBC_SS_FLAT0 TO SBC_SS_FLAT0 + 3: a = "Flat side": b = "The tab's square-cornered side (left / right while dragging)"
        CASE SBC_SS_ROUND:   a = "Roundness (%)": b = "How round the pill's ends are (up / down while dragging)"
        CASE SBC_SS_SEGS:    a = "Segments": b = "Split the pill into this many parts (left / right)"
        CASE SBC_SS_MOUTH:   a = "Mouth (degrees)": b = "How wide the mouth opens (up / down while dragging)"
        CASE SBC_SS_PACHOLE: a = "Hole (%)": b = "A hole in the middle (left / right while dragging)"
        CASE SBC_SS_D0 TO SBC_SS_D0 + 6: a = "Die": b = "The solid to draw (digits while dragging: 4 6 8 0 1 2 3)"
        CASE SBC_SS_ZDEPTH:  a = "Depth (%)": b = "How deep it reaches back (up / down while dragging)"
        CASE SBC_SS_TILT:    a = "Tilt (degrees)": b = "Turn it toward you or away (the wheel while dragging)"
        CASE SBC_SS_TURN:    a = "Turn (degrees)": b = "Turn it left or right (left / right while dragging)"
        CASE SBC_SS_LAZ:     a = "Light angle (degrees)": b = "Where the light comes from, round the shape (A / D while dragging)"
        CASE SBC_SS_LEL:     a = "Light height (degrees)": b = "How high the light is (W / S while dragging)"
        CASE SBC_SS_LINT:    a = "Light power (%)": b = "How bright the lit faces are (L + a digit while dragging)"
        CASE SBC_SS_BEVEL:   a = "Bevel (px)": b = "How wide the bevel is (up / down or the wheel while dragging)"
        CASE SBC_SS_BORDER:  a = "Border (px)": b = "A border round the bevel - 0 = none (left / right)"
        CASE SBC_SS_INNER:   a = "Inner bevel": b = "The border inside the box (I)"
        CASE SBC_SS_OUTER:   a = "Outer bevel": b = "The border outside the box (O)"
        CASE SBC_SS_STEM:    a = "Stem (%)": b = "How fat the shaft is (up / down while dragging)"
        CASE SBC_SS_HEAD:    a = "Head length (%)": b = "How long the head is (left / right while dragging)"
        CASE SBC_SS_FLARE:   a = "Head flare (%)": b = "How wide the head spreads (the wheel while dragging)"
        CASE SBC_SS_THICK:   a = "Thickness (px)": b = "How thick the whole arrow is"
        CASE SBC_FL_S0:      a = "Fill this layer": b = "Flood the colour under the click on this layer (the keys still work: Shift, F)"
        CASE SBC_FL_S0 + 1:  a = "Fill merged": b = "Read every visible layer, paint on this one (Shift+click)"
        CASE SBC_FL_S0 + 2:  a = "Fill all layers": b = "Flood each layer under the click (F held + click)"
        CASE SBC_FL_S0 + 3:  a = "Replace all": b = "Every pixel of that colour on every layer (Shift+F + click)"
        CASE SBC_FL_TOL:     a = "Tolerance": b = "How far a colour may be from the clicked one (0 = exact) - this layer / merged fills"
        CASE SBC_FL_CONTIG:  a = "Contiguous": b = "On: only pixels joined to the click. Off: every match on the layer"
        CASE SBC_FL_GRID:    a = "Grid cell fill": b = "With the grid on, a click fills the grid cell under it"
        CASE SBC_FL_ADJ:     a = "Fill adjust": b = "After a gradient / pattern fill, drag its handles before it sets"
        CASE SBC_FL_B0 TO SBC_FL_B0 + 3: a = "Gradient blend": b = "How gradient colours mix (OKLAB: no muddy middles; PIGMENT: like paint)"
        CASE SBC_SP_SPREAD:  a = "Spread (%)": b = "The spray's reach, from the brush size (100 = as the size gives)"
        CASE SBC_SP_DENSITY: a = "Density (%)": b = "How many dots / droplets a frame (100 = as the size gives)"
        CASE SBC_SP_FLOW:    a = "Flow (%)": b = "How much paint each airbrush droplet leaves - how fast it builds up"
        CASE SBC_PK_S0:      a = "Pick merged": b = "The colour you see: every visible layer"
        CASE SBC_PK_S0 + 1:  a = "Pick this layer": b = "The colour on the current layer only"
        CASE SBC_PK_S0 + 2:  a = "Pick reference": b = "The reference image's colour (holding R does it once)"
        CASE SBC_PK_SZ0 TO SBC_PK_SZ0 + 2: a = "Sample area": b = "Average this many pixels square round the point"
        CASE SBC_PK_LOUPE:   a = "Loupe zoom": b = "How far the picker's loupe magnifies (middle-click: the theme's)"
        CASE SBC_BR_MIX:     a = "Mix brush (pigment)": b = "The brush picks up the colours it crosses and smears them (Brush > Mix Colors)"
        CASE SBC_BR_SMUDGE:  a = "Smudge (%)": b = "The picked-up colour's share of each dab (0 = plain paint)"
        CASE SBC_BR_LENGTH:  a = "Smudge length (%)": b = "How long the picked-up colour lasts (0 = follows the canvas at once)"
        CASE SBC_BR_MIXRAD:  a = "Sample radius (%)": b = "How wide it samples the canvas, from the brush's radius"
        CASE SBC_BR_TILE:    a = "Pattern tile": b = "Show the canvas tiled 3 x 3 to paint seamless patterns (View menu)"
        CASE SBC_ER_SMART:   a = "Erase all layers": b = "Erase every visible layer under the brush. Shift flips it for one stroke"
        CASE SBC_MP_FROMBR:  a = "Size from the brush": b = "On: DRAW's brush size. Off: the MyPaint brush's own size, offset by SIZE"
        CASE SBC_MP_SIZE:    a = "MyPaint size": b = "The brush's own radius, up or down (middle-click: as it was made)"
        CASE SBC_MP_OPAQUE:  a = "Opaque": b = "The MyPaint brush's opacity (middle-click: the brush file's)"
        CASE SBC_MP_PRESS:   a = "Mouse pressure (%)": b = "The pressure a mouse paints with (a pen uses its own)"
        CASE SBC_MP_TWIST:   a = "Twist (degrees)": b = "The pen barrel rotation every stroke gets"
        CASE SBC_MP_BRUSHES: a = "MyPaint brushes": b = "Show the MyPaint Brushes palette"
        CASE SBC_MP_SETTINGS: a = "MyPaint brush settings": b = "Show the full MyPaint Brush Settings panel"
        CASE SBC_MV_FLIPH:   a = "Flip horizontal": b = "The selection, or the layer (Home)"
        CASE SBC_MV_FLIPV:   a = "Flip vertical": b = "The selection, or the layer (End)"
        CASE SBC_MV_ROTCCW:  a = "Rotate 90 CCW": b = "The selection, or the layer (<)"
        CASE SBC_MV_ROTCW:   a = "Rotate 90 CW": b = "The selection, or the layer (>)"
        CASE SBC_MV_HALF:    a = "Scale 50%": b = "The selection, or the layer (PgDn)"
        CASE SBC_MV_DOUBLE:  a = "Scale 2x": b = "The selection, or the layer (PgUp)"
        CASE SBC_TR_APPLY:   a = "Apply the transform": b = "Commit it (Enter)"
        CASE SBC_TR_CANCEL:  a = "Cancel the transform": b = "Put it back as it was (Esc)"
        CASE SBC_CR_W:       a = "Crop width (px)": b = "The crop box's width (middle-click: the canvas's)"
        CASE SBC_CR_H:       a = "Crop height (px)": b = "The crop box's height (middle-click: the canvas's)"
        CASE SBC_CR_APPLY:   a = "Apply the crop": b = "Cut the canvas to the box (Enter)"
        CASE SBC_CR_CANCEL:  a = "Cancel the crop": b = "Leave the canvas as it is (Esc)"
        CASE SBC_CR_TRIM:    a = "Trim to the artwork": b = "Crop to every visible layer's pixels (double-click the Crop button)"
        CASE SBC_CR_WHOLE:   a = "Box the whole image": b = "Start again with the whole canvas boxed - drag the edges in or out"
        CASE SBC_VW_OUT:     a = "Zoom out": b = "Ctrl+-"
        CASE SBC_VW_IN:      a = "Zoom in": b = "Ctrl+="
        CASE SBC_VW_100:     a = "Zoom 100%": b = "Ctrl+0"
        CASE SBC_VW_FIT:     a = "Fit the canvas": b = "Zoom so the whole canvas shows"
        CASE SBC_VW_CENTER:  a = "Center the canvas": b = "View > Reset Canvas"
    END SELECT
    IF LEN(a) THEN SELBAR_tip$ = a + CHR$(10) + b
END FUNCTION
