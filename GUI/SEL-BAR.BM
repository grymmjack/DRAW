''
' DRAW - GUI/SEL-BAR.BM - the Selection Bar (GUI/SEL-BAR.BI).
'
$INCLUDEONCE

''
' Should the bar show: a selection tool, View > Selection Bar on, the chrome not
' hidden by F11 - the dock lays it out only then (DOCK_panel_shown%).
FUNCTION SELBAR_wanted% ()
    IF SCRN.textBarHiddenByToggleAll% THEN EXIT FUNCTION ' (F11 holds the tool bars off)
    IF CFG.SELECTION_BAR% = 0 THEN EXIT FUNCTION
    SELBAR_wanted% = (CURRENT_TOOL% = TOOL_MARQUEE)
END FUNCTION


''
' The mode a selection tool uses with no modifier held (MOUSE.BM): the bar's chips.
FUNCTION SELBAR_mode% ()
    DIM m AS INTEGER
    m = CFG.SELECTION_MODE%
    IF m < SEL_MODE_REPLACE _ORELSE m > SEL_MODE_INTERSECT THEN m = SEL_MODE_REPLACE
    SELBAR_mode% = m
END FUNCTION


''
' Text width in the bar's font (the menu bar's).
FUNCTION SELBAR_tw% (t AS STRING)
    IF MENU_BAR.fontHandle& > 0 THEN
        SELBAR_tw% = _UPRINTWIDTH(t, 0, MENU_BAR.fontHandle&)
    ELSE
        SELBAR_tw% = LEN(t) * 8
    END IF
END FUNCTION


FUNCTION SELBAR_row_h% ()
    DIM h AS INTEGER
    h = THEME.TEXT_BAR_ROW_HEIGHT%
    IF h < 10 THEN h = 14
    SELBAR_row_h% = h
END FUNCTION


''
' 1 = a chip of a group (one lit), 2 = an on / off toggle, 3 = a slider, 4 = a button.
FUNCTION SELBAR_kind% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_REPLACE TO SBC_INTERSECT, SBC_FREE TO SBC_SIZE: SELBAR_kind% = 1
        CASE SBC_CONTIGUOUS, SBC_MERGED, SBC_AAEDGE, SBC_CENTER: SELBAR_kind% = 2
        CASE SBC_FEATHER, SBC_TOLERANCE, SBC_SHAPE_W, SBC_SHAPE_H, SBC_PATHSMOOTH, SBC_AMOUNT: SELBAR_kind% = 3
        CASE ELSE: SELBAR_kind% = 4
    END SELECT
END FUNCTION


FUNCTION SELBAR_label$ (id AS INTEGER)
    DIM t AS STRING
    SELECT CASE id
        CASE SBC_REPLACE: t = "REPLACE"
        CASE SBC_ADD: t = "ADD"
        CASE SBC_SUBTRACT: t = "SUBTRACT"
        CASE SBC_INTERSECT: t = "INTERSECT"
        CASE SBC_FEATHER: t = "FEATHER"
        CASE SBC_FEATHER_GO: t = "APPLY"
        CASE SBC_TOLERANCE: t = "TOLERANCE"
        CASE SBC_CONTIGUOUS: t = "CONTIGUOUS"
        CASE SBC_MERGED: t = "SAMPLE MERGED"
        CASE SBC_AAEDGE: t = "AA EDGE"
        CASE SBC_FREE: t = "FREE"
        CASE SBC_RATIO: t = "RATIO"
        CASE SBC_SIZE: t = "SIZE"
        CASE SBC_SHAPE_W: t = "W"
        CASE SBC_SHAPE_H: t = "H"
        CASE SBC_CENTER: t = "FROM CENTER"
        CASE SBC_PATHSMOOTH: t = "SMOOTH PATH"
        CASE SBC_AMOUNT: t = "AMOUNT"
        CASE SBC_GROW: t = "GROW"
        CASE SBC_SHRINK: t = "SHRINK"
        CASE SBC_SMOOTH: t = "SMOOTH"
        CASE SBC_INVERT: t = "INVERT"
        CASE SBC_DESELECT: t = "DESELECT"
    END SELECT
    SELBAR_label$ = t
END FUNCTION


''
' A chip / toggle lit?
FUNCTION SELBAR_on% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_REPLACE TO SBC_INTERSECT: SELBAR_on% = (SELBAR_mode% = id - SBC_REPLACE)
        CASE SBC_FREE TO SBC_SIZE: SELBAR_on% = (CFG.SELECTION_SHAPE% = id - SBC_FREE)
        CASE SBC_CONTIGUOUS: SELBAR_on% = (CFG.WAND_CONTIGUOUS% <> 0)
        CASE SBC_MERGED: SELBAR_on% = (CFG.WAND_SAMPLE_MERGED% <> 0)
        CASE SBC_AAEDGE: SELBAR_on% = (CFG.WAND_ANTIALIAS% <> 0)
        CASE SBC_CENTER: SELBAR_on% = (CFG.SELECTION_FROM_CENTER% <> 0)
    END SELECT
END FUNCTION


''
' A slider's value and range.
FUNCTION SELBAR_val% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_FEATHER: SELBAR_val% = CFG.SELECTION_FEATHER%
        CASE SBC_TOLERANCE: SELBAR_val% = CFG.WAND_TOLERANCE%
        CASE SBC_SHAPE_W: SELBAR_val% = CFG.SELECTION_SHAPE_W%
        CASE SBC_SHAPE_H: SELBAR_val% = CFG.SELECTION_SHAPE_H%
        CASE SBC_PATHSMOOTH: SELBAR_val% = CFG.SELECTION_SMOOTH%
        CASE SBC_AMOUNT: SELBAR_val% = CFG.SELECTION_GROW%
    END SELECT
END FUNCTION

FUNCTION SELBAR_lo% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_SHAPE_W, SBC_SHAPE_H, SBC_AMOUNT: SELBAR_lo% = 1
    END SELECT
END FUNCTION

FUNCTION SELBAR_hi% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_FEATHER, SBC_AMOUNT: SELBAR_hi% = 64
        CASE SBC_TOLERANCE: SELBAR_hi% = 255
        CASE SBC_SHAPE_W, SBC_SHAPE_H: SELBAR_hi% = 512 ' (the slider's reach; DRAW.cfg takes up to 8192)
        CASE SBC_PATHSMOOTH: SELBAR_hi% = 4
    END SELECT
END FUNCTION


''
' Set slider id to v (clamped); saved to DRAW.cfg when save.
SUB SELBAR_set (id AS INTEGER, v AS INTEGER, save AS INTEGER)
    DIM n AS INTEGER
    n = v
    IF n < SELBAR_lo%(id) THEN n = SELBAR_lo%(id)
    IF id = SBC_SHAPE_W _ORELSE id = SBC_SHAPE_H THEN
        IF n > 8192 THEN n = 8192
    ELSEIF n > SELBAR_hi%(id) THEN
        n = SELBAR_hi%(id)
    END IF
    SELECT CASE id
        CASE SBC_FEATHER: CFG.SELECTION_FEATHER% = n
        CASE SBC_TOLERANCE: CFG.WAND_TOLERANCE% = n
        CASE SBC_SHAPE_W: CFG.SELECTION_SHAPE_W% = n
        CASE SBC_SHAPE_H: CFG.SELECTION_SHAPE_H% = n
        CASE SBC_PATHSMOOTH: CFG.SELECTION_SMOOTH% = n
        CASE SBC_AMOUNT: CFG.SELECTION_GROW% = n
    END SELECT
    IF save THEN CONFIG_save
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' Slider id back to its factory default (the universal value input: a
' middle-click, or a double-click on its track).
SUB SELBAR_reset (id AS INTEGER)
    DIM r AS INTEGER
    SELECT CASE id
        CASE SBC_FEATHER: r = VAL_apply%(CFG.SELECTION_FEATHER%, VAL_OP_RESET, 0, SELBAR_lo%(id), SELBAR_hi%(id))
        CASE SBC_TOLERANCE: r = VAL_apply%(CFG.WAND_TOLERANCE%, VAL_OP_RESET, 0, SELBAR_lo%(id), SELBAR_hi%(id))
        CASE SBC_SHAPE_W: r = VAL_apply%(CFG.SELECTION_SHAPE_W%, VAL_OP_RESET, 0, 1, 8192)
        CASE SBC_SHAPE_H: r = VAL_apply%(CFG.SELECTION_SHAPE_H%, VAL_OP_RESET, 0, 1, 8192)
        CASE SBC_PATHSMOOTH: r = VAL_apply%(CFG.SELECTION_SMOOTH%, VAL_OP_RESET, 0, SELBAR_lo%(id), SELBAR_hi%(id))
        CASE SBC_AMOUNT: r = VAL_apply%(CFG.SELECTION_GROW%, VAL_OP_RESET, 0, SELBAR_lo%(id), SELBAR_hi%(id))
    END SELECT
    IF r THEN CONFIG_save
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' A middle-click (viewport px) on a slider or its value: its default. TRUE when taken.
FUNCTION SELBAR_middle% (inX AS INTEGER, inY AS INTEGER)
    DIM i AS INTEGER
    IF SELBAR.visible = 0 _ORELSE SELBAR_is_over_area%(inX, inY) = 0 THEN EXIT FUNCTION
    SELBAR_middle% = TRUE
    i = SELBAR_hit%(PSURF_mx%(DP_SELBAR, inX), PSURF_my%(DP_SELBAR, inY))
    IF i = 0 THEN EXIT FUNCTION
    IF SELBAR_kind%(SB_ID(i)) = 3 THEN SELBAR_reset SB_ID(i)
END FUNCTION

''
' A control's width (its units).
FUNCTION SELBAR_ctl_w% (id AS INTEGER)
    IF SELBAR_kind%(id) = 3 THEN
        SELBAR_ctl_w% = SELBAR_tw%(SELBAR_label$(id)) + 3 + SELBAR_TRACK_W + 3 + SELBAR_tw%(_TRIM$(STR$(SELBAR_hi%(id))))
    ELSE
        SELBAR_ctl_w% = SELBAR_tw%(SELBAR_label$(id)) + 8
    END IF
END FUNCTION


''
' The controls for the current selection tool, in order (0 = a group break), into
' lst(); returns how many.
FUNCTION SELBAR_list% (lst() AS INTEGER)
    DIM n AS INTEGER, i AS INTEGER, v AS INTEGER
    REDIM lst(1 TO 32) AS INTEGER
    FOR i = SBC_REPLACE TO SBC_INTERSECT: n = n + 1: lst(n) = i: NEXT i
    n = n + 1: lst(n) = 0
    n = n + 1: lst(n) = SBC_FEATHER
    n = n + 1: lst(n) = SBC_FEATHER_GO
    v = MARQUEE.VARIANT
    SELECT CASE v
        CASE TOOL_SELECT_WAND
            n = n + 1: lst(n) = 0
            FOR i = SBC_TOLERANCE TO SBC_AAEDGE: n = n + 1: lst(n) = i: NEXT i
        CASE TOOL_SELECT_FREE, TOOL_SELECT_POLY
            n = n + 1: lst(n) = 0
            n = n + 1: lst(n) = SBC_PATHSMOOTH
        CASE ELSE ' rectangle, ellipse
            n = n + 1: lst(n) = 0
            FOR i = SBC_FREE TO SBC_SIZE: n = n + 1: lst(n) = i: NEXT i
            IF CFG.SELECTION_SHAPE% <> 0 THEN
                n = n + 1: lst(n) = SBC_SHAPE_W
                n = n + 1: lst(n) = SBC_SHAPE_H
            END IF
            n = n + 1: lst(n) = SBC_CENTER
    END SELECT
    n = n + 1: lst(n) = 0
    FOR i = SBC_AMOUNT TO SBC_DESELECT: n = n + 1: lst(n) = i: NEXT i
    SELBAR_list% = n
END FUNCTION


''
' Lay the controls out in a bar w wide at (ox, oy): they wrap into lines (a group
' starts a line of its own when it would not fit whole beside the last). Returns the
' lines; keep = store the places (SB_*) for the render and the hit tests.
FUNCTION SELBAR_layout% (ox AS INTEGER, oy AS INTEGER, w AS INTEGER, keep AS INTEGER)
    DIM n AS INTEGER, i AS INTEGER, j AS INTEGER, id AS INTEGER, cw AS INTEGER, gw AS INTEGER
    DIM cx AS INTEGER, ly AS INTEGER, lines AS INTEGER, rowH AS INTEGER, x1 AS INTEGER, x2 AS INTEGER
    DIM lst(1 TO 1) AS INTEGER
    n = SELBAR_list%(lst())
    rowH = SELBAR_row_h%
    x1 = ox + 4: x2 = ox + w - 3
    cx = x1: ly = oy: lines = 1
    IF keep THEN SB_N = 0
    FOR i = 1 TO n
        id = lst(i)
        IF id = 0 THEN
            ' the group's whole width: a new line when it does not fit here
            gw = 0
            FOR j = i + 1 TO n
                IF lst(j) = 0 THEN EXIT FOR
                gw = gw + SELBAR_ctl_w%(lst(j)) + 2
            NEXT j
            IF cx > x1 THEN
                IF cx + 6 + gw > x2 THEN
                    cx = x1: ly = ly + rowH: lines = lines + 1
                ELSE
                    cx = cx + 6
                END IF
            END IF
        ELSE
            cw = SELBAR_ctl_w%(id)
            IF cx > x1 _ANDALSO cx + cw > x2 THEN cx = x1: ly = ly + rowH: lines = lines + 1
            IF keep _ANDALSO SB_N < 32 THEN
                SB_N = SB_N + 1
                SB_ID(SB_N) = id: SB_X(SB_N) = cx: SB_Y(SB_N) = ly: SB_W(SB_N) = cw
                SB_TX(SB_N) = cx + SELBAR_tw%(SELBAR_label$(id)) + 3
            END IF
            cx = cx + cw + 2
        END IF
    NEXT i
    SELBAR_layout% = lines
END FUNCTION


''
' Its height at width w (the dock: DP_H_FIXED, as the text bar).
FUNCTION SELBAR_h_for% (w AS INTEGER)
    SELBAR_h_for% = SELBAR_row_h% * SELBAR_layout%(0, 0, w, FALSE)
END FUNCTION


''
' Draw the bar into _DEST (SCRN.GUI&, or its own surface at a Scale) at its rect.
SUB SELBAR_render ()
    DIM i AS INTEGER, id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, rowH AS INTEGER
    DIM k AS INTEGER, lit AS INTEGER, fg AS _UNSIGNED LONG, bg AS _UNSIGNED LONG, t AS STRING
    DIM v AS INTEGER, lo AS INTEGER, hi AS INTEGER, fillW AS INTEGER, tx AS INTEGER
    DIM oldFont AS LONG, ty AS INTEGER
    IF SELBAR.visible = 0 _ORELSE SELBAR.w <= 0 _ORELSE SELBAR.h <= 0 THEN EXIT SUB
    LINE (SELBAR.x, SELBAR.y)-(SELBAR.x + SELBAR.w - 1, SELBAR.y + SELBAR.h - 1), THEME.TEXT_BAR_BG~&, BF
    LINE (SELBAR.x + 2, SELBAR.y + SELBAR.h - 1)-(SELBAR.x + SELBAR.w - 3, SELBAR.y + SELBAR.h - 1), THEME.TEXT_BAR_BORDER~&
    REGION_set_bounds REGION_SEL_BAR, SELBAR.x, SELBAR.y, SELBAR.w, SELBAR.h, ZORDER_PANEL ' (its footprint at a Scale: PSURF_render)
    SELBAR.lines = SELBAR_layout%(SELBAR.x, SELBAR.y, SELBAR.w, TRUE)
    rowH = SELBAR_row_h%
    oldFont& = _FONT
    IF MENU_BAR.fontHandle& > 0 THEN _FONT MENU_BAR.fontHandle&
    _PRINTMODE _KEEPBACKGROUND
    ty = (rowH - _UFONTHEIGHT) \ 2
    FOR i = 1 TO SB_N
        id = SB_ID(i): x = SB_X(i): y = SB_Y(i): w = SB_W(i)
        k = SELBAR_kind%(id): t = SELBAR_label$(id)
        ' a group's first control: a faint divider before it
        IF i > 1 _ANDALSO x > SELBAR.x + 4 _ANDALSO SELBAR_group_start%(id) THEN LINE (x - 4, y + 2)-(x - 4, y + rowH - 4), THEME.TEXT_BAR_BTN_BORDER~&
        IF k = 3 THEN
            v = SELBAR_val%(id): lo = SELBAR_lo%(id): hi = SELBAR_hi%(id)
            COLOR THEME.TEXT_BAR_FG~&, _RGBA32(0, 0, 0, 0)
            _UPRINTSTRING (x, y + ty), t
            tx = SB_TX(i)
            LINE (tx, y + 3)-(tx + SELBAR_TRACK_W - 1, y + rowH - 4), THEME.TEXT_BAR_BTN_BG~&, BF
            fillW = 0
            IF hi > lo THEN fillW = ((_MIN(v, hi) - lo) * (SELBAR_TRACK_W - 2) + (hi - lo) \ 2) \ (hi - lo)
            IF fillW > 0 THEN LINE (tx + 1, y + 4)-(tx + fillW, y + rowH - 5), THEME.TEXT_BAR_BTN_ACTIVE~&, BF
            IF SELBAR.hover = id _ORELSE SELBAR.drag = id THEN
                LINE (tx, y + 3)-(tx + SELBAR_TRACK_W - 1, y + rowH - 4), THEME.TEXT_BAR_FG~&, B
            ELSE
                LINE (tx, y + 3)-(tx + SELBAR_TRACK_W - 1, y + rowH - 4), THEME.TEXT_BAR_BTN_BORDER~&, B
            END IF
            _UPRINTSTRING (tx + SELBAR_TRACK_W + 3, y + ty), _TRIM$(STR$(v))
        ELSE
            lit = (k <> 4 _ANDALSO SELBAR_on%(id) <> 0)
            IF lit THEN
                bg = THEME.TEXT_BAR_BTN_ACTIVE~&: fg = THEME.TEXT_BAR_FG~&
            ELSEIF SELBAR.hover = id THEN
                bg = THEME.TEXT_BAR_BTN_HOVER~&: fg = THEME.TEXT_BAR_FG~&
            ELSE
                bg = THEME.TEXT_BAR_BTN_BG~&: fg = THEME.TEXT_BAR_BTN_FG~&
            END IF
            LINE (x, y + 1)-(x + w - 1, y + rowH - 3), bg, BF
            LINE (x, y + 1)-(x + w - 1, y + rowH - 3), THEME.TEXT_BAR_BTN_BORDER~&, B
            COLOR fg, _RGBA32(0, 0, 0, 0)
            _UPRINTSTRING (x + 4, y + ty), t
        END IF
    NEXT i
    _FONT oldFont&
END SUB


''
' Is id the first control of its group (a divider before it)?
FUNCTION SELBAR_group_start% (id AS INTEGER)
    SELECT CASE id
        CASE SBC_FEATHER, SBC_TOLERANCE, SBC_FREE, SBC_PATHSMOOTH, SBC_AMOUNT: SELBAR_group_start% = TRUE
    END SELECT
END FUNCTION


''
' The control at (mx, my) - its units - as last drawn: an index into SB_*, 0 = none.
FUNCTION SELBAR_hit% (mx AS INTEGER, my AS INTEGER)
    DIM i AS INTEGER, rowH AS INTEGER
    rowH = SELBAR_row_h%
    FOR i = 1 TO SB_N
        IF mx >= SB_X(i) _ANDALSO mx < SB_X(i) + SB_W(i) _ANDALSO my >= SB_Y(i) _ANDALSO my < SB_Y(i) + rowH THEN SELBAR_hit% = i: EXIT FUNCTION
    NEXT i
END FUNCTION


''
' Is viewport (inX, inY) on the bar? Every click / hover / pan gate asks here.
FUNCTION SELBAR_is_over_area% (inX AS INTEGER, inY AS INTEGER)
    IF SELBAR.visible = 0 _ORELSE SELBAR.w <= 0 _ORELSE SELBAR.h <= 0 THEN EXIT FUNCTION
    IF DOCK_live%(DP_SELBAR) = 0 THEN EXIT FUNCTION
    IF WZ_blocked%(DP_SELBAR, inX, inY) THEN EXIT FUNCTION ' a window in front covers it here
    IF PSURF_on%(DP_SELBAR) THEN SELBAR_is_over_area% = PSURF_in%(DP_SELBAR, inX, inY): EXIT FUNCTION
    SELBAR_is_over_area% = (inX >= SELBAR.x _ANDALSO inX < SELBAR.x + SELBAR.w _ANDALSO inY >= SELBAR.y _ANDALSO inY < SELBAR.y + SELBAR.h)
END FUNCTION


''
' Hover (viewport px): redraw when the control under it changes.
SUB SELBAR_track (inX AS INTEGER, inY AS INTEGER)
    DIM h AS INTEGER, i AS INTEGER
    IF SELBAR_is_over_area%(inX, inY) THEN
        i = SELBAR_hit%(PSURF_mx%(DP_SELBAR, inX), PSURF_my%(DP_SELBAR, inY))
        IF i THEN h = SB_ID(i)
    END IF
    IF h <> SELBAR.hover THEN SELBAR.hover = h: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' Slider SB index i set from the pointer's x (its units).
SUB SELBAR_slide (i AS INTEGER, mx AS INTEGER)
    DIM id AS INTEGER, lo AS INTEGER, hi AS INTEGER, f AS SINGLE, v AS INTEGER
    id = SB_ID(i): lo = SELBAR_lo%(id): hi = SELBAR_hi%(id)
    f = (mx - SB_TX(i)) / (SELBAR_TRACK_W - 1)
    IF f < 0 THEN f = 0
    IF f > 1 THEN f = 1
    v = lo + CINT(f * (hi - lo))
    IF v <> SELBAR_val%(id) THEN SELBAR_set id, v, FALSE
END SUB


''
' A press (viewport px): TRUE when it was on the bar (taken).
FUNCTION SELBAR_click% (inX AS INTEGER, inY AS INTEGER)
    DIM i AS INTEGER, id AS INTEGER, mx AS INTEGER, my AS INTEGER
    IF SELBAR_is_over_area%(inX, inY) = 0 THEN EXIT FUNCTION
    SELBAR_click% = TRUE
    mx = PSURF_mx%(DP_SELBAR, inX): my = PSURF_my%(DP_SELBAR, inY)
    i = SELBAR_hit%(mx, my)
    IF i = 0 THEN EXIT FUNCTION
    id = SB_ID(i)
    SELECT CASE SELBAR_kind%(id)
        CASE 3 ' a slider: its track sets it and drags (SELBAR_drag_frame); a double-click resets it
            IF mx >= SB_TX(i) - 2 _ANDALSO mx < SB_TX(i) + SELBAR_TRACK_W + 2 THEN
                IF VAL_dbl%(DP_SELBAR * 1000& + id) THEN
                    SELBAR_reset id
                ELSE
                    SELBAR.drag = id
                    SELBAR_slide i, mx
                END IF
            ELSEIF mx >= SB_TX(i) + SELBAR_TRACK_W + 2 THEN ' its value: a double-click types one
                IF VAL_dbl%(DP_SELBAR * 1000& + 100 + id) THEN
                    DIM sbv AS INTEGER, sbHi AS INTEGER
                    sbv = SELBAR_val%(id): sbHi = SELBAR_hi%(id)
                    IF id = SBC_SHAPE_W _ORELSE id = SBC_SHAPE_H THEN sbHi = 8192
                    IF VAL_type%("Tool Options", SELBAR_label$(id), sbv, SELBAR_lo%(id), sbHi) THEN SELBAR_set id, sbv, TRUE
                END IF
            END IF
        CASE ELSE
            SELBAR_press id
    END SELECT
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END FUNCTION


''
' A chip, toggle or button pressed.
SUB SELBAR_press (id AS INTEGER)
    SELECT CASE id
        CASE SBC_REPLACE TO SBC_INTERSECT: CMD_execute_action SELBAR_ACT_MODE0 + id - SBC_REPLACE
        CASE SBC_FREE TO SBC_SIZE: CFG.SELECTION_SHAPE% = id - SBC_FREE: CONFIG_save
        CASE SBC_CONTIGUOUS: CFG.WAND_CONTIGUOUS% = _IIF(CFG.WAND_CONTIGUOUS%, FALSE, TRUE): CONFIG_save
        CASE SBC_MERGED: CFG.WAND_SAMPLE_MERGED% = _IIF(CFG.WAND_SAMPLE_MERGED%, FALSE, TRUE): CONFIG_save
        CASE SBC_AAEDGE: CFG.WAND_ANTIALIAS% = _IIF(CFG.WAND_ANTIALIAS%, FALSE, TRUE): CONFIG_save
        CASE SBC_CENTER: CFG.SELECTION_FROM_CENTER% = _IIF(CFG.SELECTION_FROM_CENTER%, FALSE, TRUE): CONFIG_save
        CASE SBC_FEATHER_GO: CMD_execute_action SELBAR_ACT_FEATHER
        CASE SBC_GROW: CMD_execute_action SELBAR_ACT_GROW
        CASE SBC_SHRINK: CMD_execute_action SELBAR_ACT_SHRINK
        CASE SBC_SMOOTH: CMD_execute_action SELBAR_ACT_SMOOTH
        CASE SBC_INVERT: CMD_execute_action 311
        CASE SBC_DESELECT: CMD_execute_action 307
    END SELECT
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' Each frame while a slider is held (MOUSE.BM): follow the pointer; on release save.
' TRUE while it holds the mouse.
FUNCTION SELBAR_drag_frame% (inX AS INTEGER, inY AS INTEGER, held AS INTEGER)
    DIM i AS INTEGER
    IF SELBAR.drag = 0 THEN EXIT FUNCTION
    SELBAR_drag_frame% = TRUE
    IF held = 0 _ORELSE SELBAR.visible = 0 THEN
        SELBAR.drag = 0
        CONFIG_save
        GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
        EXIT FUNCTION
    END IF
    FOR i = 1 TO SB_N
        IF SB_ID(i) = SELBAR.drag THEN SELBAR_slide i, PSURF_mx%(DP_SELBAR, inX): EXIT FUNCTION
    NEXT i
END FUNCTION


''
' The wheel over a slider: one step a notch (Shift: 10). TRUE when taken.
FUNCTION SELBAR_wheel% (inX AS INTEGER, inY AS INTEGER, delta AS INTEGER)
    DIM i AS INTEGER, id AS INTEGER, st AS INTEGER
    IF delta = 0 _ORELSE SELBAR_is_over_area%(inX, inY) = 0 THEN EXIT FUNCTION
    SELBAR_wheel% = TRUE
    i = SELBAR_hit%(PSURF_mx%(DP_SELBAR, inX), PSURF_my%(DP_SELBAR, inY))
    IF i = 0 THEN EXIT FUNCTION
    id = SB_ID(i)
    IF SELBAR_kind%(id) <> 3 THEN EXIT FUNCTION
    SELBAR_set id, SELBAR_val%(id) + VAL_wheel_step%(SGN(delta)), TRUE ' (wheel up = more; Shift 10)
END FUNCTION


''
' QA dump: SELBAR visible x y w h lines mode feather tol contig merged aa shape sw sh center smooth grow
' then SELBARC id x y w per control (its units).
FUNCTION SELBAR_dump$ ()
    DIM d AS STRING, i AS INTEGER, lf AS STRING
    lf = CHR$(10)
    d = "SELBAR" + DOCK_n$(SELBAR.visible <> 0) + DOCK_n$(SELBAR.x) + DOCK_n$(SELBAR.y) + DOCK_n$(SELBAR.w) + DOCK_n$(SELBAR.h) + DOCK_n$(SELBAR.lines)
    d = d + DOCK_n$(SELBAR_mode%) + DOCK_n$(CFG.SELECTION_FEATHER%) + DOCK_n$(CFG.WAND_TOLERANCE%) + DOCK_n$(CFG.WAND_CONTIGUOUS% <> 0) + DOCK_n$(CFG.WAND_SAMPLE_MERGED% <> 0) + DOCK_n$(CFG.WAND_ANTIALIAS% <> 0)
    d = d + DOCK_n$(CFG.SELECTION_SHAPE%) + DOCK_n$(CFG.SELECTION_SHAPE_W%) + DOCK_n$(CFG.SELECTION_SHAPE_H%) + DOCK_n$(CFG.SELECTION_FROM_CENTER% <> 0) + DOCK_n$(CFG.SELECTION_SMOOTH%) + DOCK_n$(CFG.SELECTION_GROW%) + lf
    ' SELM <a selection> <soft: a partly selected pixel> <x1 y1 x2 y2 canvas px> <mask>
    DIM sx1 AS INTEGER, sy1 AS INTEGER, sx2 AS INTEGER, sy2 AS INTEGER, hasM AS INTEGER
    hasM = (MARQUEE.WAND_HAS_SELECTION <> 0 _ANDALSO MARQUEE.SELECTION_MASK < -1)
    IF hasM THEN
        sx1 = MARQUEE.WAND_MIN_X: sy1 = MARQUEE.WAND_MIN_Y: sx2 = MARQUEE.WAND_MAX_X: sy2 = MARQUEE.WAND_MAX_Y
    ELSE
        sx1 = MARQUEE.BOX.x: sy1 = MARQUEE.BOX.y: sx2 = MARQUEE.BOX.x + MARQUEE.BOX.w - 1: sy2 = MARQUEE.BOX.y + MARQUEE.BOX.h - 1
    END IF
    d = d + "SELM" + DOCK_n$(SELECTION_has_active% <> 0) + DOCK_n$(hasM _ANDALSO SELMASK_is_soft%(MARQUEE.SELECTION_MASK)) + DOCK_n$(sx1) + DOCK_n$(sy1) + DOCK_n$(sx2) + DOCK_n$(sy2) + DOCK_n$(hasM <> 0) + lf
    IF SELBAR.visible THEN
        FOR i = 1 TO SB_N
            d = d + "SELBARC" + DOCK_n$(SB_ID(i)) + DOCK_n$(SB_X(i)) + DOCK_n$(SB_Y(i)) + DOCK_n$(SB_W(i)) + DOCK_n$(SB_TX(i)) + lf
        NEXT i
    END IF
    SELBAR_dump$ = d
END FUNCTION

''
' The tooltip for the control under the pointer (screen px): its id (0 = none) and, in txt,
' two lines split by CHR$(10) - what it is, how it behaves. GUI/TOOLTIP.BM
' (TOOLTIP_SRC_SEL_BAR); the tooltip uppercases it.
FUNCTION SELBAR_tip_at% (inX AS INTEGER, inY AS INTEGER, txt AS STRING)
    DIM i AS INTEGER, id AS INTEGER
    txt = ""
    IF NOT SELBAR.visible THEN EXIT FUNCTION
    IF NOT SELBAR_is_over_area%(inX, inY) THEN EXIT FUNCTION
    i = SELBAR_hit%(PSURF_mx%(DP_SELBAR, inX), PSURF_my%(DP_SELBAR, inY))
    IF i = 0 THEN EXIT FUNCTION
    id = SB_ID(i)
    txt = SELBAR_tip$(id)
    IF LEN(txt) THEN SELBAR_tip_at% = id
END FUNCTION

''
' Control id's tooltip: "what" + CHR$(10) + "how".
FUNCTION SELBAR_tip$ (id AS INTEGER)
    DIM a AS STRING, b AS STRING
    SELECT CASE id
        CASE SBC_REPLACE:    a = "Replace": b = "A new selection replaces the old one"
        CASE SBC_ADD:        a = "Add": b = "New selections add to the old one (Shift does it once)"
        CASE SBC_SUBTRACT:   a = "Subtract": b = "New selections cut out of the old one (Alt does it once)"
        CASE SBC_INTERSECT:  a = "Intersect": b = "Keep only where old and new overlap (Shift+Alt once)"
        CASE SBC_FEATHER:    a = "Feather (px)": b = "Soft edge this wide on each new selection - 0 = hard"
        CASE SBC_FEATHER_GO: a = "Apply feather": b = "Feather the current selection by the FEATHER amount"
        CASE SBC_TOLERANCE:  a = "Tolerance": b = "How far a colour may be from the clicked one (0 = exact)"
        CASE SBC_CONTIGUOUS: a = "Contiguous": b = "On: only connected pixels. Off: every match on the layer"
        CASE SBC_MERGED:     a = "Sample merged": b = "Match colours in the visible image, not just this layer"
        CASE SBC_AAEDGE:     a = "Antialias edge": b = "Soften the wand selection's edge"
        CASE SBC_FREE:       a = "Free shape": b = "Drag any width and height"
        CASE SBC_RATIO:      a = "Fixed ratio": b = "Keep the W:H proportion while dragging"
        CASE SBC_SIZE:       a = "Fixed size": b = "A box exactly W x H pixels where you press"
        CASE SBC_SHAPE_W:    a = "Width": b = "W of the fixed ratio / size (wheel: +-1, Shift: +-10)"
        CASE SBC_SHAPE_H:    a = "Height": b = "H of the fixed ratio / size (wheel: +-1, Shift: +-10)"
        CASE SBC_CENTER:     a = "From center": b = "Drag out from the press point (Ctrl flips it while held)"
        CASE SBC_PATHSMOOTH: a = "Smooth path": b = "Round a freehand / polygon outline before it selects"
        CASE SBC_AMOUNT:     a = "Amount (px)": b = "How far GROW, SHRINK and SMOOTH go"
        CASE SBC_GROW:       a = "Grow": b = "Widen the selection by AMOUNT (Ctrl+Z undoes)"
        CASE SBC_SHRINK:     a = "Shrink": b = "Narrow the selection by AMOUNT (Ctrl+Z undoes)"
        CASE SBC_SMOOTH:     a = "Smooth": b = "Round the selection's corners by AMOUNT"
        CASE SBC_INVERT:     a = "Invert": b = "Select what is not selected (Ctrl+Shift+I)"
        CASE SBC_DESELECT:   a = "Deselect": b = "Drop the selection (Ctrl+D)"
    END SELECT
    IF LEN(a) THEN SELBAR_tip$ = a + CHR$(10) + b
END FUNCTION
