''
' DRAW - GUI/WORKSPACE-APPLY.BM
' =============================================================================
' Workspace overlay: apply / restore / CONFIG_save guard / F11 reveal /
' deferred [START]. See GUI/WORKSPACE-APPLY.BI.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE


''
' Live visibility of a chrome element.
FUNCTION WS_el_get% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_MENUBAR:          WS_el_get% = (SCRN.showMenubar% <> 0 _ANDALSO MENU_BAR.visible% <> 0)
        CASE WS_EL_TOOLBOX:          WS_el_get% = (SCRN.showToolbar% <> 0)
        CASE WS_EL_LAYER_PANEL:      WS_el_get% = (LAYER_PANEL.visible% <> 0)
        CASE WS_EL_EDIT_BAR:         WS_el_get% = (SCRN.showEditBar% <> 0)
        CASE WS_EL_ADVANCED_BAR:     WS_el_get% = (SCRN.showAdvBar% <> 0)
        CASE WS_EL_STATUS_BAR:       WS_el_get% = (SCRN.showStatus% <> 0)
        CASE WS_EL_PREVIEW:          WS_el_get% = (PREVIEW.visible% <> 0)
        CASE WS_EL_COLOR_MIXER:      WS_el_get% = (COLORMIXER.visible% <> 0)
        CASE WS_EL_CHARMAP:          WS_el_get% = (SCRN.showCharMap% <> 0)
        CASE WS_EL_COLOR_SPACE_3D:   WS_el_get% = (CS3D.visible% <> 0)
        CASE WS_EL_ADV_COLOR_PICKER: WS_el_get% = (ADVCP.visible% <> 0)
        CASE WS_EL_PEN_PANEL:        WS_el_get% = (PENP.visible% <> 0)
        CASE WS_EL_BROWSER:          WS_el_get% = (BROWSER.visible% <> 0)
    END SELECT
END FUNCTION


''
' ManuallyHidden flag of an element (FALSE where the element has none).
FUNCTION WS_el_get_mh% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_MENUBAR:      WS_el_get_mh% = SCRN.menubarManuallyHidden%
        CASE WS_EL_TOOLBOX:      WS_el_get_mh% = SCRN.toolbarManuallyHidden%
        CASE WS_EL_LAYER_PANEL:  WS_el_get_mh% = SCRN.layerPanelManuallyHidden%
        CASE WS_EL_EDIT_BAR:     WS_el_get_mh% = SCRN.editBarManuallyHidden%
        CASE WS_EL_ADVANCED_BAR: WS_el_get_mh% = SCRN.advBarManuallyHidden%
        CASE WS_EL_STATUS_BAR:   WS_el_get_mh% = SCRN.statusManuallyHidden%
        CASE WS_EL_PREVIEW:      WS_el_get_mh% = SCRN.previewManuallyHidden%
        CASE WS_EL_COLOR_MIXER:  WS_el_get_mh% = SCRN.colorMixerManuallyHidden%
        CASE WS_EL_CHARMAP:      WS_el_get_mh% = SCRN.charMapManuallyHidden%
        CASE WS_EL_BROWSER:      WS_el_get_mh% = SCRN.browserManuallyHidden%
    END SELECT
END FUNCTION


SUB WS_el_set_mh (el AS INTEGER, v AS INTEGER)
    SELECT CASE el
        CASE WS_EL_MENUBAR:      SCRN.menubarManuallyHidden% = v
        CASE WS_EL_TOOLBOX:      SCRN.toolbarManuallyHidden% = v
        CASE WS_EL_LAYER_PANEL:  SCRN.layerPanelManuallyHidden% = v
        CASE WS_EL_EDIT_BAR:     SCRN.editBarManuallyHidden% = v
        CASE WS_EL_ADVANCED_BAR: SCRN.advBarManuallyHidden% = v
        CASE WS_EL_STATUS_BAR:   SCRN.statusManuallyHidden% = v
        CASE WS_EL_PREVIEW:      SCRN.previewManuallyHidden% = v
        CASE WS_EL_COLOR_MIXER:  SCRN.colorMixerManuallyHidden% = v
        CASE WS_EL_CHARMAP:      SCRN.charMapManuallyHidden% = v
        CASE WS_EL_BROWSER:      SCRN.browserManuallyHidden% = v
    END SELECT
END SUB


''
' TRUE when the element's visibility is persisted in a CFG *_VISIBLE field.
FUNCTION WS_el_has_cfg% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_EDIT_BAR, WS_EL_ADVANCED_BAR, WS_EL_PREVIEW, WS_EL_COLOR_MIXER, WS_EL_CHARMAP, WS_EL_COLOR_SPACE_3D, WS_EL_ADV_COLOR_PICKER, WS_EL_PEN_PANEL, WS_EL_BROWSER
            WS_el_has_cfg% = TRUE
    END SELECT
END FUNCTION


FUNCTION WS_el_get_cfg% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_EDIT_BAR:         WS_el_get_cfg% = CFG.EDIT_BAR_VISIBLE%
        CASE WS_EL_ADVANCED_BAR:     WS_el_get_cfg% = CFG.ADV_BAR_VISIBLE%
        CASE WS_EL_PREVIEW:          WS_el_get_cfg% = CFG.PREVIEW_VISIBLE%
        CASE WS_EL_COLOR_MIXER:      WS_el_get_cfg% = CFG.COLOR_MIXER_VISIBLE%
        CASE WS_EL_CHARMAP:          WS_el_get_cfg% = CFG.CHARMAP_VISIBLE%
        CASE WS_EL_COLOR_SPACE_3D:   WS_el_get_cfg% = CFG.COLOR_SPACE_3D_VISIBLE%
        CASE WS_EL_ADV_COLOR_PICKER: WS_el_get_cfg% = CFG.ADV_COLOR_PICKER_VISIBLE%
        CASE WS_EL_PEN_PANEL:        WS_el_get_cfg% = CFG.PEN_PANEL_VISIBLE%
        CASE WS_EL_BROWSER:          WS_el_get_cfg% = CFG.BROWSER_VISIBLE%
    END SELECT
END FUNCTION


SUB WS_el_set_cfg (el AS INTEGER, v AS INTEGER)
    SELECT CASE el
        CASE WS_EL_EDIT_BAR:         CFG.EDIT_BAR_VISIBLE% = v
        CASE WS_EL_ADVANCED_BAR:     CFG.ADV_BAR_VISIBLE% = v
        CASE WS_EL_PREVIEW:          CFG.PREVIEW_VISIBLE% = v
        CASE WS_EL_COLOR_MIXER:      CFG.COLOR_MIXER_VISIBLE% = v
        CASE WS_EL_CHARMAP:          CFG.CHARMAP_VISIBLE% = v
        CASE WS_EL_COLOR_SPACE_3D:   CFG.COLOR_SPACE_3D_VISIBLE% = v
        CASE WS_EL_ADV_COLOR_PICKER: CFG.ADV_COLOR_PICKER_VISIBLE% = v
        CASE WS_EL_PEN_PANEL:        CFG.PEN_PANEL_VISIBLE% = v
        CASE WS_EL_BROWSER:          CFG.BROWSER_VISIBLE% = v
    END SELECT
END SUB


''
' Show or hide one element the way its own toggle would (first-show init,
' auto-positioning), without CONFIG_save. A hide sets ManuallyHidden so the
' auto-hide restore leaves it alone; a show clears it.
SUB WS_el_set (el AS INTEGER, wantVis AS INTEGER)
    DIM v AS INTEGER
    v = (wantVis <> 0)
    SELECT CASE el
        CASE WS_EL_MENUBAR
            SCRN.showMenubar% = v
            MENU_BAR.visible% = v
            IF v = 0 THEN MENUBAR_close_all
        CASE WS_EL_TOOLBOX
            SCRN.showToolbar% = v
        CASE WS_EL_LAYER_PANEL
            LAYER_PANEL.visible% = v
        CASE WS_EL_EDIT_BAR
            SCRN.showEditBar% = v
            EDIT_BAR.visible% = v
        CASE WS_EL_ADVANCED_BAR
            SCRN.showAdvBar% = v
            ADV_BAR.visible% = v
        CASE WS_EL_STATUS_BAR
            SCRN.showStatus% = v
        CASE WS_EL_CHARMAP
            ' The char map cannot show a TheDraw face (same refusal as CHARMAP_toggle)
            IF v _ANDALSO TDF_font_is_active% THEN EXIT SUB
            SCRN.showCharMap% = v
            CHARMAP.visible% = v
            IF v _ANDALSO CHARMAP.cacheValid% = 0 THEN CHARMAP_rebuild_cache
            CHARMAP_NEEDS_REDRAW% = TRUE
        CASE WS_EL_PREVIEW
            IF WS_el_get%(el) <> v THEN PREVIEW_toggle
        CASE WS_EL_COLOR_MIXER
            IF WS_el_get%(el) <> v THEN COLORMIXER_toggle
        CASE WS_EL_COLOR_SPACE_3D
            IF WS_el_get%(el) <> v THEN CS3D_toggle
        CASE WS_EL_ADV_COLOR_PICKER
            IF WS_el_get%(el) <> v THEN ADVCP_toggle
        CASE WS_EL_PEN_PANEL
            IF WS_el_get%(el) <> v THEN PENP_toggle
        CASE WS_EL_BROWSER
            IF WS_el_get%(el) <> v THEN BROWSER_toggle
    END SELECT
    WS_el_set_mh el, _NEGATE v
END SUB


''
' Dock edge of an element as "LEFT"/"RIGHT" (the CFG field is the source).
FUNCTION WS_dk_get$ (dk AS INTEGER)
    SELECT CASE dk
        CASE WS_DK_TOOLBOX:      WS_dk_get$ = UCASE$(_TRIM$(CFG.TOOLBOX_DOCK_EDGE))
        CASE WS_DK_LAYER_PANEL:  WS_dk_get$ = UCASE$(_TRIM$(CFG.LAYERS_PANEL_DOCK_EDGE))
        CASE WS_DK_EDIT_BAR:     WS_dk_get$ = UCASE$(_TRIM$(CFG.EDIT_BAR_DOCK_POSITION$))
        CASE WS_DK_ADVANCED_BAR: WS_dk_get$ = UCASE$(_TRIM$(CFG.ADV_BAR_DOCK_POSITION$))
        CASE WS_DK_CHARMAP:      WS_dk_get$ = UCASE$(_TRIM$(CFG.CHARMAP_PANEL_DOCK_EDGE$))
    END SELECT
END FUNCTION


''
' Set only the CFG dock field (what CONFIG_save writes).
SUB WS_dk_set_cfg (dk AS INTEGER, edge AS STRING)
    SELECT CASE dk
        CASE WS_DK_TOOLBOX:      CFG.TOOLBOX_DOCK_EDGE = edge
        CASE WS_DK_LAYER_PANEL:  CFG.LAYERS_PANEL_DOCK_EDGE = edge
        CASE WS_DK_EDIT_BAR:     CFG.EDIT_BAR_DOCK_POSITION$ = edge
        CASE WS_DK_ADVANCED_BAR: CFG.ADV_BAR_DOCK_POSITION$ = edge
        CASE WS_DK_CHARMAP:      CFG.CHARMAP_PANEL_DOCK_EDGE$ = edge
    END SELECT
END SUB


''
' Dock an element live (CFG field + the panel's own dockSide).
SUB WS_dk_set (dk AS INTEGER, edge AS STRING)
    DIM e AS STRING
    e = UCASE$(_TRIM$(edge))
    IF e <> "LEFT" _ANDALSO e <> "RIGHT" THEN EXIT SUB
    WS_dk_set_cfg dk, e
    SELECT CASE dk
        CASE WS_DK_EDIT_BAR
            IF e = "LEFT" THEN EDIT_BAR.dockSide% = EDITBAR_DOCK_LEFT ELSE EDIT_BAR.dockSide% = EDITBAR_DOCK_RIGHT
        CASE WS_DK_ADVANCED_BAR
            IF e = "LEFT" THEN ADV_BAR.dockSide% = ADVBAR_DOCK_LEFT ELSE ADV_BAR.dockSide% = ADVBAR_DOCK_RIGHT
        CASE WS_DK_CHARMAP
            IF e = "LEFT" THEN CHARMAP.dockSide% = CHARMAP_DOCK_LEFT ELSE CHARMAP.dockSide% = CHARMAP_DOCK_RIGHT
    END SELECT
END SUB


''
' SHOW/HIDE/KEEP (also TRUE/FALSE/ON/OFF/1/0) -> 1 show, 0 hide, -1 keep.
FUNCTION WS_parse_vis% (v AS STRING)
    SELECT CASE UCASE$(_TRIM$(v))
        CASE "SHOW", "TRUE", "ON", "1", "YES": WS_parse_vis% = 1
        CASE "HIDE", "FALSE", "OFF", "0", "NO": WS_parse_vis% = 0
        CASE ELSE: WS_parse_vis% = -1
    END SELECT
END FUNCTION


''
' Tool name (workspace files, [START] TOOL=, later [TOOLBOX]/[KEYS]) ->
' the action that selects it; 0 = unknown.
FUNCTION WS_tool_action% (toolName AS STRING)
    SELECT CASE LCASE$(_TRIM$(toolName))
        CASE "brush":                       WS_tool_action% = 101
        CASE "dot", "pset":                 WS_tool_action% = 102
        CASE "fill", "paint":               WS_tool_action% = 103
        CASE "picker", "eyedropper":        WS_tool_action% = 104
        CASE "line":                        WS_tool_action% = 105
        CASE "polygon":                     WS_tool_action% = 106
        CASE "polygon-filled":              WS_tool_action% = 107
        CASE "rect", "rectangle":           WS_tool_action% = 108
        CASE "rect-filled":                 WS_tool_action% = 109
        CASE "ellipse", "circle":           WS_tool_action% = 110
        CASE "ellipse-filled":              WS_tool_action% = 111
        CASE "marquee", "select":           WS_tool_action% = 112
        CASE "move":                        WS_tool_action% = 113
        CASE "text":                        WS_tool_action% = 114
        CASE "wand", "magic-wand":          WS_tool_action% = 117
        CASE "eraser":                      WS_tool_action% = 118
        CASE "marquee-free", "lasso":       WS_tool_action% = 119
        CASE "marquee-poly":                WS_tool_action% = 120
        CASE "marquee-ellipse":             WS_tool_action% = 121
        CASE "bezier":                      WS_tool_action% = 122
        CASE "zoom":                        WS_tool_action% = 1701
        CASE "spray":                       WS_tool_action% = 1702
        CASE "smart-shapes":                WS_tool_action% = 1706
    END SELECT
END FUNCTION


''
' Capture the user's current value of each [OPTIONS] key by writing the live
' config to a scratch file (CONFIG_save, unguarded) and reading it back - the
' exact text CONFIG_apply_key% accepts, for every key, with no per-key getter.
SUB WS_capture_option_origs ()
    DIM realPath AS STRING, tmpPath AS STRING, fh AS INTEGER, ln AS STRING
    DIM eq AS INTEGER, k AS STRING, i AS INTEGER
    IF WS_OPT_N = 0 THEN EXIT SUB
    realPath = CONFIG_FILE_PATH$
    tmpPath = PATHS_cache$("workspace-cfg-snapshot.tmp")
    CONFIG_FILE_PATH$ = tmpPath
    WS_GUARD_BYPASS = TRUE
    CONFIG_save
    WS_GUARD_BYPASS = FALSE
    CONFIG_FILE_PATH$ = realPath
    IF _FILEEXISTS(tmpPath) = 0 THEN EXIT SUB
    fh = FREEFILE
    OPEN tmpPath FOR INPUT AS #fh
    DO WHILE NOT EOF(fh)
        LINE INPUT #fh, ln
        eq = INSTR(ln, "=")
        IF eq < 2 THEN _CONTINUE
        k = UCASE$(_TRIM$(LEFT$(ln, eq - 1)))
        FOR i = 1 TO WS_OPT_N
            IF WS_OPT_HAD(i) = 0 _ANDALSO WS_OPT_KEY(i) = k THEN
                WS_OPT_ORIG(i) = _TRIM$(MID$(ln, eq + 1))
                WS_OPT_HAD(i) = TRUE
            END IF
        NEXT i
    LOOP
    CLOSE #fh
    KILL tmpPath
END SUB


SUB WS_refresh ()
    INVALIDATE_scene
    STATUS_NEEDS_REDRAW% = TRUE
END SUB


''
' Leave the active workspace: every touched element back to the user's state.
SUB WS_restore ()
    DIM el AS INTEGER, dk AS INTEGER, i AS INTEGER, ok AS INTEGER
    IF WS_ACTIVE = 0 THEN EXIT SUB
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) THEN
            WS_el_set el, WS_EL_SNAP_VIS(el)
            WS_el_set_mh el, WS_EL_SNAP_MH(el)
            IF WS_el_has_cfg%(el) THEN WS_el_set_cfg el, WS_EL_SNAP_CFG(el)
            WS_EL_TOUCHED(el) = FALSE
        END IF
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_TOUCHED(dk) THEN
            WS_dk_set dk, WS_DK_SNAP(dk)
            WS_DK_TOUCHED(dk) = FALSE
        END IF
    NEXT dk
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_HAD(i) THEN ok = CONFIG_apply_key%(WS_OPT_KEY(i), WS_OPT_ORIG(i))
    NEXT i
    WS_OPT_N = 0
    WS_ACTIVE = FALSE
    WS_REVEALED = FALSE
    WS_START_PENDING = FALSE
    WS_ACTIVE_ID = WS_DEFAULT_ID$
    WS_ACTIVE_TITLE = "Default"
    _LOGINFO "WORKSPACE: restored the user's layout"
    WS_refresh
END SUB


''
' Switch to a workspace (id or title). Leaves the current one first, so
' switching never stacks overlays. Default = just leave. Remembers the
' choice in CFG.WORKSPACE. Returns FALSE (and flashes why) when the
' workspace can't be found.
FUNCTION WS_apply% (idOrTitle AS STRING)
    DIM idx AS INTEGER, i AS INTEGER, el AS INTEGER, dk AS INTEGER, ok AS INTEGER
    DIM k AS STRING, v AS STRING, want AS INTEGER, matched AS INTEGER

    idx = WS_find%(idOrTitle)
    IF idx = 0 THEN
        STATUS_flash "No workspace named '" + idOrTitle + "'"
        _LOGWARN "WORKSPACE: no workspace named '" + idOrTitle + "'"
        EXIT FUNCTION
    END IF

    WS_restore

    IF WS_is_default%(WS_LIST(idx).id) THEN
        IF WS_NO_REMEMBER = 0 THEN CFG.WORKSPACE$ = WS_DEFAULT_ID$
        CONFIG_save
        STATUS_flash "Workspace: Default"
        WS_apply% = TRUE
        EXIT FUNCTION
    END IF

    IF WS_resolve%(WS_LIST(idx).id) = 0 THEN
        STATUS_flash "Workspace: " + WS_LAST_ERROR
        EXIT FUNCTION
    END IF

    ' 1. Snapshot the user's state for everything this workspace names
    FOR el = 1 TO WS_EL_COUNT
        WS_EL_TOUCHED(el) = FALSE
        want = WS_parse_vis%(WS_get$("CHROME." + WS_EL_NAME(el), "KEEP"))
        IF want >= 0 THEN
            WS_EL_TOUCHED(el) = TRUE
            WS_EL_WANT(el) = (want = 1)
            WS_EL_SNAP_VIS(el) = WS_el_get%(el)
            WS_EL_SNAP_MH(el) = WS_el_get_mh%(el)
            IF WS_el_has_cfg%(el) THEN WS_EL_SNAP_CFG(el) = WS_el_get_cfg%(el)
        END IF
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        WS_DK_TOUCHED(dk) = FALSE
        v = UCASE$(WS_get$("CHROME." + WS_DK_NAME(dk), ""))
        IF v = "LEFT" _ORELSE v = "RIGHT" THEN
            WS_DK_TOUCHED(dk) = TRUE
            WS_DK_WANT(dk) = v
            WS_DK_SNAP(dk) = WS_dk_get$(dk)
        END IF
    NEXT dk
    WS_OPT_N = 0
    i = 0
    DO
        i = WS_next_in_section%("OPTIONS", i)
        IF i = 0 THEN EXIT DO
        IF WS_OPT_N >= WS_MAX_OPTS THEN EXIT DO
        WS_OPT_N = WS_OPT_N + 1
        WS_OPT_KEY(WS_OPT_N) = WS_res_key_part$(i)
        WS_OPT_VAL(WS_OPT_N) = WS_RES_VAL(i)
        WS_OPT_ORIG(WS_OPT_N) = ""
        WS_OPT_HAD(WS_OPT_N) = FALSE
    LOOP
    WS_capture_option_origs

    ' Keys the overlay does not handle yet are reported once, not silently dropped
    i = 0
    DO
        i = WS_next_in_section%("CHROME", i)
        IF i = 0 THEN EXIT DO
        k = WS_res_key_part$(i)
        matched = FALSE
        FOR el = 1 TO WS_EL_COUNT
            IF WS_EL_NAME(el) = k THEN matched = TRUE
        NEXT el
        FOR dk = 1 TO WS_DK_COUNT
            IF WS_DK_NAME(dk) = k THEN matched = TRUE
        NEXT dk
        IF matched = 0 THEN _LOGINFO "WORKSPACE: [CHROME] " + k + " is not applied yet (later phase) - ignored"
    LOOP

    ' 2. Apply (the guard is live from here, so any CONFIG_save keeps user values)
    WS_ACTIVE = TRUE
    WS_REVEALED = FALSE
    WS_ACTIVE_ID = WS_LIST(idx).id
    WS_ACTIVE_TITLE = WS_LIST(idx).title
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) THEN WS_el_set el, WS_EL_WANT(el)
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_TOUCHED(dk) THEN WS_dk_set dk, WS_DK_WANT(dk)
    NEXT dk
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_HAD(i) THEN
            ok = CONFIG_apply_key%(WS_OPT_KEY(i), WS_OPT_VAL(i))
            IF ok = 0 THEN _LOGWARN "WORKSPACE: [OPTIONS] " + WS_OPT_KEY(i) + " not accepted"
        ELSE
            _LOGWARN "WORKSPACE: [OPTIONS] unknown key " + WS_OPT_KEY(i) + " - ignored"
        END IF
    NEXT i
    WS_START_PENDING = TRUE

    IF WS_NO_REMEMBER = 0 THEN CFG.WORKSPACE$ = WS_ACTIVE_ID
    CONFIG_save
    _LOGINFO "WORKSPACE: applied '" + WS_ACTIVE_ID + "' (" + WS_ACTIVE_TITLE + ")"
    STATUS_flash "Workspace: " + WS_ACTIVE_TITLE + "   (Ctrl+Shift+W switch, F11 show all)"
    WS_refresh
    WS_apply% = TRUE
END FUNCTION


''
' CONFIG_save calls this before writing: the fields the overlay touched get
' the user's own values for the duration of the write.
SUB WS_cfg_guard_begin ()
    DIM el AS INTEGER, dk AS INTEGER, i AS INTEGER, ok AS INTEGER
    IF WS_ACTIVE = 0 _ORELSE WS_GUARD_BYPASS _ORELSE WS_GUARD_ON THEN EXIT SUB
    WS_GUARD_ON = TRUE
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) _ANDALSO WS_el_has_cfg%(el) THEN
            WS_EL_HOLD_CFG(el) = WS_el_get_cfg%(el)
            WS_el_set_cfg el, WS_EL_SNAP_CFG(el)
        END IF
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_TOUCHED(dk) THEN
            WS_DK_HOLD(dk) = WS_dk_get$(dk)
            WS_dk_set_cfg dk, WS_DK_SNAP(dk)
        END IF
    NEXT dk
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_HAD(i) THEN ok = CONFIG_apply_key%(WS_OPT_KEY(i), WS_OPT_ORIG(i))
    NEXT i
END SUB


''
' ...and after: the overlay's live values come back.
SUB WS_cfg_guard_end ()
    DIM el AS INTEGER, dk AS INTEGER, i AS INTEGER, ok AS INTEGER
    IF WS_GUARD_ON = 0 THEN EXIT SUB
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) _ANDALSO WS_el_has_cfg%(el) THEN WS_el_set_cfg el, WS_EL_HOLD_CFG(el)
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_TOUCHED(dk) THEN WS_dk_set_cfg dk, WS_DK_HOLD(dk)
    NEXT dk
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_HAD(i) THEN ok = CONFIG_apply_key%(WS_OPT_KEY(i), WS_OPT_VAL(i))
    NEXT i
    WS_GUARD_ON = FALSE
END SUB


''
' F11 inside a workspace that hides something: first press shows what the
' workspace hid, second press hides it again. Returns FALSE when F11 should
' do its normal toggle-all (no workspace, or it hides nothing).
FUNCTION WS_f11% ()
    DIM el AS INTEGER, hidesAny AS INTEGER
    IF WS_ACTIVE = 0 THEN EXIT FUNCTION
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) _ANDALSO WS_EL_WANT(el) = 0 THEN hidesAny = TRUE
    NEXT el
    IF hidesAny = 0 THEN EXIT FUNCTION
    WS_REVEALED = _NEGATE WS_REVEALED
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) _ANDALSO WS_EL_WANT(el) = 0 THEN
            ' Reveal what the workspace hid only if the user had it showing
            ' (or it is fixed chrome with no saved state of its own)
            IF WS_REVEALED THEN
                IF WS_EL_SNAP_VIS(el) _ORELSE WS_el_has_cfg%(el) = 0 THEN WS_el_set el, TRUE
            ELSE
                WS_el_set el, FALSE
            END IF
        END IF
    NEXT el
    IF WS_REVEALED THEN
        STATUS_flash "Workspace " + WS_ACTIVE_TITLE + ": showing everything (F11 hides it again)"
    ELSE
        STATUS_flash "Workspace: " + WS_ACTIVE_TITLE
    END IF
    WS_refresh
    WS_f11% = TRUE
END FUNCTION


''
' Parse "#RRGGBB" / "RRGGBB" / "#RRGGBBAA" -> color; returns FALSE when bad.
FUNCTION WS_parse_color% (s AS STRING, outColor AS _UNSIGNED LONG)
    DIM h AS STRING, i AS INTEGER, ch AS STRING
    h = UCASE$(_TRIM$(s))
    IF LEFT$(h, 1) = "#" THEN h = MID$(h, 2)
    IF LEN(h) <> 6 _ANDALSO LEN(h) <> 8 THEN EXIT FUNCTION
    FOR i = 1 TO LEN(h)
        ch = MID$(h, i, 1)
        IF INSTR("0123456789ABCDEF", ch) = 0 THEN EXIT FUNCTION
    NEXT i
    IF LEN(h) = 6 THEN
        outColor = _RGB32(VAL("&H" + MID$(h, 1, 2)), VAL("&H" + MID$(h, 3, 2)), VAL("&H" + MID$(h, 5, 2)))
    ELSE
        outColor = _RGBA32(VAL("&H" + MID$(h, 1, 2)), VAL("&H" + MID$(h, 3, 2)), VAL("&H" + MID$(h, 5, 2)), VAL("&H" + MID$(h, 7, 2)))
    END IF
    WS_parse_color% = TRUE
END FUNCTION


''
' [START]: TOOL, FG, ZOOM (FIT or a percent; 100 = 1:1). Runs once, after a
' render has laid out the new chrome.
SUB WS_apply_start ()
    DIM t AS STRING, act AS INTEGER, c AS _UNSIGNED LONG, z AS STRING, zf AS SINGLE, i AS INTEGER
    WS_START_PENDING = FALSE
    IF WS_ACTIVE = 0 THEN EXIT SUB

    t = WS_get$("START.TOOL", "")
    IF LEN(t) THEN
        act = WS_tool_action%(t)
        IF act THEN CMD_execute_action act ELSE _LOGWARN "WORKSPACE: [START] unknown TOOL " + t
    END IF

    IF WS_parse_color%(WS_get$("START.FG", ""), c) THEN
        PAINT_COLOR~& = c
        PAL_FG_IS_TRANSPARENT% = (_ALPHA32(c) = 0)
        FOR i = 0 TO PAL_COLOR_COUNT - 1
            IF PAL(i).value = c THEN PAL_FG_IDX% = i: EXIT FOR
        NEXT i
    END IF

    z = UCASE$(WS_get$("START.ZOOM", ""))
    IF z = "FIT" THEN
        SCREEN_compute_layout
        ZOOM_fit_canvas
    ELSEIF VAL(z) > 0 THEN
        zf = VAL(z) / 100
        IF zf < SCRN.zoomMin! THEN zf = SCRN.zoomMin!
        IF zf > SCRN.zoomMax! THEN zf = SCRN.zoomMax!
        SCRN.zoom! = zf
        SCRN.offsetX% = 0
        SCRN.offsetY% = 0
    END IF
    WS_refresh
END SUB


''
' Per frame (after render): run a pending [START] once the command-line file
' (if any) has loaded, so the zoom fits the real document.
SUB WS_tick ()
    IF WS_START_PENDING = 0 THEN EXIT SUB
    IF LEN(CMDLINE_PENDING_FILE$) THEN EXIT SUB
    WS_apply_start
END SUB


''
' Startup: reopen in the remembered workspace (CFG.WORKSPACE).
SUB WS_startup ()
    DIM ok AS INTEGER, i AS INTEGER
    WS_scan
    ' --workspace NAME: this run only (CFG.WORKSPACE keeps the remembered one)
    FOR i = 1 TO _COMMANDCOUNT - 1
        IF LCASE$(_TRIM$(COMMAND$(i))) = "--workspace" THEN WS_CLI_NAME = _TRIM$(COMMAND$(i + 1))
    NEXT i
    IF LEN(WS_CLI_NAME) THEN
        WS_NO_REMEMBER = TRUE
        ok = WS_apply%(WS_CLI_NAME)
        WS_NO_REMEMBER = FALSE
    ELSEIF WS_is_default%(CFG.WORKSPACE$) = 0 THEN
        ok = WS_apply%(CFG.WORKSPACE$)
        IF ok = 0 THEN CFG.WORKSPACE$ = WS_DEFAULT_ID$
    END IF
    WS_sync_commands
    MENUBAR_rebuild
END SUB


''
' Rebuild the command palette's "Workspace: <name>" entries from WS_LIST
' (dropping the old ones first); the active one shows "active" as its hotkey.
SUB WS_sync_commands ()
    DIM i AS INTEGER, j AS INTEGER, a AS INTEGER
    j = 0
    FOR i = 0 TO CMD_COUNT - 1
        a = CMD_LIST(i).action_id
        IF a > WS_ACT_SLOT0 _ANDALSO a <= WS_ACT_SLOT0 + WS_MAX THEN _CONTINUE
        IF j <> i THEN CMD_LIST(j) = CMD_LIST(i)
        j = j + 1
    NEXT i
    CMD_COUNT = j
    FOR i = 1 TO WS_COUNT
        IF WS_LIST(i).id = WS_ACTIVE_ID THEN
            CMD_register WS_CMD_PREFIX$ + WS_LIST(i).title, "active", CMD_CAT_VIEW, WS_ACT_SLOT0 + i
        ELSE
            CMD_register WS_CMD_PREFIX$ + WS_LIST(i).title, "", CMD_CAT_VIEW, WS_ACT_SLOT0 + i
        END IF
    NEXT i
END SUB


''
' The escape hatch: the command palette, pre-filtered to the workspaces with
' the active one highlighted. Typing narrows it ("ann" -> Annotate).
SUB WS_open_switcher ()
    DIM i AS INTEGER, q AS STRING
    WS_sync_commands
    CMD_show_palette
    q = WS_CMD_PREFIX$
    CMD_PALETTE.search = q
    CMD_PALETTE.search_len = LEN(q)
    CMD_update_search
    FOR i = 0 TO CMD_PALETTE.result_count - 1
        IF RTRIM$(CMD_LIST(CMD_RESULTS(i)).hotkey) = "active" THEN CMD_PALETTE.hover = i: EXIT FOR
    NEXT i
    GUI_NEEDS_REDRAW% = TRUE
END SUB


''
' Rescan workspace files; the menu and palette follow. A workspace whose
' file disappeared is left.
SUB WS_reload ()
    DIM activeId AS STRING
    activeId = WS_ACTIVE_ID
    WS_scan
    IF WS_ACTIVE _ANDALSO WS_find%(activeId) = 0 THEN WS_restore
    WS_sync_commands
    MENUBAR_rebuild
    STATUS_flash "Workspaces reloaded:" + STR$(WS_COUNT)
END SUB


''
' Dispatch actions 2400-2449.
SUB WS_action (act AS INTEGER)
    DIM ok AS INTEGER, d AS STRING, n AS INTEGER
    SELECT CASE act
        CASE WS_ACT_SWITCHER
            WS_open_switcher
        CASE WS_ACT_CONFIGURE
            ' The configurator dialog arrives in W6; until then the files are the editor
            STATUS_flash "Workspace configurator is coming - edit the .workspace files for now (folder opened)"
            WS_action WS_ACT_FOLDER
        CASE WS_ACT_FOLDER
            d = WS_user_dir$
            PATHS_ensure_dir d + PATHS_sep$
            ok = PATHS_open_in_file_manager%(d)
        CASE WS_ACT_RELOAD
            WS_reload
        CASE WS_ACT_LEAVE
            ok = WS_apply%(WS_DEFAULT_ID$)
        CASE WS_ACT_SLOT0 + 1 TO WS_ACT_SLOT0 + WS_MAX
            n = act - WS_ACT_SLOT0
            IF n <= WS_COUNT THEN ok = WS_apply%(WS_LIST(n).id)
    END SELECT
    WS_sync_commands
END SUB


''
' Menu checkmark for a workspace slot action.
FUNCTION WS_slot_is_active% (act AS INTEGER)
    DIM n AS INTEGER
    n = act - WS_ACT_SLOT0
    IF n < 1 _ORELSE n > WS_COUNT THEN EXIT FUNCTION
    WS_slot_is_active% = (WS_LIST(n).id = WS_ACTIVE_ID)
END FUNCTION


''
' Status-bar badge text ("" when Default is active).
FUNCTION WS_badge$ ()
    IF WS_ACTIVE = 0 THEN EXIT FUNCTION
    WS_badge$ = "[WS: " + WS_ACTIVE_TITLE + "]"
END FUNCTION
