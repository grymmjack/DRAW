''
' DRAW - GUI/WORKSPACE-APPLY.BM
' =============================================================================
' Workspace overlay: apply / restore / CONFIG_save guard / F11 reveal /
' deferred [START]. See GUI/WORKSPACE-APPLY.BI.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE


''
' Live visibility of a chrome element.
FUNCTION WS_el_get% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_MENUBAR:          WS_el_get% = (SCRN.showMenubar% <> 0 _ANDALSO MENU_BAR.visible% <> 0)
        CASE WS_EL_TOOLBOX:          WS_el_get% = (SCRN.showToolbar% <> 0)
        CASE WS_EL_LAYER_PANEL:      WS_el_get% = (LAYER_PANEL.visible% <> 0)
        CASE WS_EL_EDIT_BAR:         WS_el_get% = (SCRN.showEditBar% <> 0)
        CASE WS_EL_ADVANCED_BAR:     WS_el_get% = (SCRN.showAdvBar% <> 0)
        CASE WS_EL_STATUS_BAR:       WS_el_get% = (SCRN.showStatus% <> 0)
        CASE WS_EL_PREVIEW:          WS_el_get% = (PREVIEW.visible% <> 0)
        CASE WS_EL_COLOR_MIXER:      WS_el_get% = (COLORMIXER.visible% <> 0)
        CASE WS_EL_CHARMAP:          WS_el_get% = (SCRN.showCharMap% <> 0)
        CASE WS_EL_COLOR_SPACE_3D:   WS_el_get% = (CS3D.visible% <> 0)
        CASE WS_EL_ADV_COLOR_PICKER: WS_el_get% = (ADVCP.visible% <> 0)
        CASE WS_EL_PEN_PANEL:        WS_el_get% = (PENP.visible% <> 0)
        CASE WS_EL_BROWSER:          WS_el_get% = (BROWSER.visible% <> 0)
        CASE WS_EL_ORGANIZER:        WS_el_get% = (ORGANIZER.visible% <> 0)
        CASE WS_EL_DRAWER:           WS_el_get% = (DRAWER.visible% <> 0)
        CASE WS_EL_PALETTE_STRIP:    WS_el_get% = (PALETTE_STRIP_HIDDEN = 0)
        CASE WS_EL_ANIM_PANEL:       WS_el_get% = (ANIMP.visible <> 0)
        CASE WS_EL_SWATCHES:         WS_el_get% = (SWP.visible <> 0)
    END SELECT
END FUNCTION


''
' ManuallyHidden flag of an element (FALSE where the element has none).
FUNCTION WS_el_get_mh% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_MENUBAR:      WS_el_get_mh% = SCRN.menubarManuallyHidden%
        CASE WS_EL_TOOLBOX:      WS_el_get_mh% = SCRN.toolbarManuallyHidden%
        CASE WS_EL_LAYER_PANEL:  WS_el_get_mh% = SCRN.layerPanelManuallyHidden%
        CASE WS_EL_EDIT_BAR:     WS_el_get_mh% = SCRN.editBarManuallyHidden%
        CASE WS_EL_ADVANCED_BAR: WS_el_get_mh% = SCRN.advBarManuallyHidden%
        CASE WS_EL_STATUS_BAR:   WS_el_get_mh% = SCRN.statusManuallyHidden%
        CASE WS_EL_PREVIEW:      WS_el_get_mh% = SCRN.previewManuallyHidden%
        CASE WS_EL_COLOR_MIXER:  WS_el_get_mh% = SCRN.colorMixerManuallyHidden%
        CASE WS_EL_CHARMAP:      WS_el_get_mh% = SCRN.charMapManuallyHidden%
        CASE WS_EL_BROWSER:      WS_el_get_mh% = SCRN.browserManuallyHidden%
    END SELECT
END FUNCTION


SUB WS_el_set_mh (el AS INTEGER, v AS INTEGER)
    SELECT CASE el
        CASE WS_EL_MENUBAR:      SCRN.menubarManuallyHidden% = v
        CASE WS_EL_TOOLBOX:      SCRN.toolbarManuallyHidden% = v
        CASE WS_EL_LAYER_PANEL:  SCRN.layerPanelManuallyHidden% = v
        CASE WS_EL_EDIT_BAR:     SCRN.editBarManuallyHidden% = v
        CASE WS_EL_ADVANCED_BAR: SCRN.advBarManuallyHidden% = v
        CASE WS_EL_STATUS_BAR:   SCRN.statusManuallyHidden% = v
        CASE WS_EL_PREVIEW:      SCRN.previewManuallyHidden% = v
        CASE WS_EL_COLOR_MIXER:  SCRN.colorMixerManuallyHidden% = v
        CASE WS_EL_CHARMAP:      SCRN.charMapManuallyHidden% = v
        CASE WS_EL_BROWSER:      SCRN.browserManuallyHidden% = v
    END SELECT
END SUB


''
' TRUE when the element's visibility is persisted in a CFG *_VISIBLE field.
FUNCTION WS_el_has_cfg% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_EDIT_BAR, WS_EL_ADVANCED_BAR, WS_EL_PREVIEW, WS_EL_COLOR_MIXER, WS_EL_CHARMAP, WS_EL_COLOR_SPACE_3D, WS_EL_ADV_COLOR_PICKER, WS_EL_PEN_PANEL, WS_EL_BROWSER, WS_EL_ANIM_PANEL, WS_EL_SWATCHES
            WS_el_has_cfg% = TRUE
    END SELECT
END FUNCTION


FUNCTION WS_el_get_cfg% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_EDIT_BAR:         WS_el_get_cfg% = CFG.EDIT_BAR_VISIBLE%
        CASE WS_EL_ADVANCED_BAR:     WS_el_get_cfg% = CFG.ADV_BAR_VISIBLE%
        CASE WS_EL_PREVIEW:          WS_el_get_cfg% = CFG.PREVIEW_VISIBLE%
        CASE WS_EL_COLOR_MIXER:      WS_el_get_cfg% = CFG.COLOR_MIXER_VISIBLE%
        CASE WS_EL_CHARMAP:          WS_el_get_cfg% = CFG.CHARMAP_VISIBLE%
        CASE WS_EL_COLOR_SPACE_3D:   WS_el_get_cfg% = CFG.COLOR_SPACE_3D_VISIBLE%
        CASE WS_EL_ADV_COLOR_PICKER: WS_el_get_cfg% = CFG.ADV_COLOR_PICKER_VISIBLE%
        CASE WS_EL_PEN_PANEL:        WS_el_get_cfg% = CFG.PEN_PANEL_VISIBLE%
        CASE WS_EL_BROWSER:          WS_el_get_cfg% = CFG.BROWSER_VISIBLE%
        CASE WS_EL_ANIM_PANEL:       WS_el_get_cfg% = CFG.ANIM_PANEL_VISIBLE%
        CASE WS_EL_SWATCHES:         WS_el_get_cfg% = CFG.SWATCHES_VISIBLE%
    END SELECT
END FUNCTION


SUB WS_el_set_cfg (el AS INTEGER, v AS INTEGER)
    SELECT CASE el
        CASE WS_EL_EDIT_BAR:         CFG.EDIT_BAR_VISIBLE% = v
        CASE WS_EL_ADVANCED_BAR:     CFG.ADV_BAR_VISIBLE% = v
        CASE WS_EL_PREVIEW:          CFG.PREVIEW_VISIBLE% = v
        CASE WS_EL_COLOR_MIXER:      CFG.COLOR_MIXER_VISIBLE% = v
        CASE WS_EL_CHARMAP:          CFG.CHARMAP_VISIBLE% = v
        CASE WS_EL_COLOR_SPACE_3D:   CFG.COLOR_SPACE_3D_VISIBLE% = v
        CASE WS_EL_ADV_COLOR_PICKER: CFG.ADV_COLOR_PICKER_VISIBLE% = v
        CASE WS_EL_PEN_PANEL:        CFG.PEN_PANEL_VISIBLE% = v
        CASE WS_EL_BROWSER:          CFG.BROWSER_VISIBLE% = v
        CASE WS_EL_ANIM_PANEL:       CFG.ANIM_PANEL_VISIBLE% = v
        CASE WS_EL_SWATCHES:         CFG.SWATCHES_VISIBLE% = v
    END SELECT
END SUB


''
' Show or hide one element the way its own toggle would (first-show init,
' auto-positioning), without CONFIG_save. A hide sets ManuallyHidden so the
' auto-hide restore leaves it alone; a show clears it.
SUB WS_el_set (el AS INTEGER, wantVis AS INTEGER)
    DIM v AS INTEGER
    v = (wantVis <> 0)
    SELECT CASE el
        CASE WS_EL_MENUBAR
            SCRN.showMenubar% = v
            MENU_BAR.visible% = v
            IF v = 0 THEN MENUBAR_close_all
        CASE WS_EL_TOOLBOX
            SCRN.showToolbar% = v
        CASE WS_EL_LAYER_PANEL
            LAYER_PANEL.visible% = v
        CASE WS_EL_EDIT_BAR
            SCRN.showEditBar% = v
            EDIT_BAR.visible% = v
        CASE WS_EL_ADVANCED_BAR
            SCRN.showAdvBar% = v
            ADV_BAR.visible% = v
        CASE WS_EL_STATUS_BAR
            SCRN.showStatus% = v
        CASE WS_EL_CHARMAP
            ' The char map cannot show a TheDraw face (same refusal as CHARMAP_toggle)
            IF v _ANDALSO TDF_font_is_active% THEN EXIT SUB
            SCRN.showCharMap% = v
            CHARMAP.visible% = v
            IF v _ANDALSO CHARMAP.cacheValid% = 0 THEN CHARMAP_rebuild_cache
            CHARMAP_NEEDS_REDRAW% = TRUE
        CASE WS_EL_PREVIEW
            IF WS_el_get%(el) <> v THEN PREVIEW_toggle
        CASE WS_EL_COLOR_MIXER
            IF WS_el_get%(el) <> v THEN COLORMIXER_toggle
        CASE WS_EL_COLOR_SPACE_3D
            IF WS_el_get%(el) <> v THEN CS3D_toggle
        CASE WS_EL_ADV_COLOR_PICKER
            IF WS_el_get%(el) <> v THEN ADVCP_toggle
        CASE WS_EL_PEN_PANEL
            IF WS_el_get%(el) <> v THEN PENP_toggle
        CASE WS_EL_ANIM_PANEL
            IF WS_el_get%(el) <> v THEN ANIMP_toggle
        CASE WS_EL_SWATCHES
            IF WS_el_get%(el) <> v THEN SWP_toggle
        CASE WS_EL_BROWSER
            IF WS_el_get%(el) <> v THEN BROWSER_toggle
        CASE WS_EL_ORGANIZER
            ORGANIZER.visible% = v
        CASE WS_EL_DRAWER
            DRAWER.visible% = v
        CASE WS_EL_PALETTE_STRIP
            PALETTE_STRIP_HIDDEN = _NEGATE v
    END SELECT
    WS_el_set_mh el, _NEGATE v
END SUB


''
' Dock edge of an element as "LEFT"/"RIGHT" (the CFG field is the source).
FUNCTION WS_dk_get$ (dk AS INTEGER)
    SELECT CASE dk
        CASE WS_DK_TOOLBOX:      WS_dk_get$ = UCASE$(_TRIM$(CFG.TOOLBOX_DOCK_EDGE))
        CASE WS_DK_LAYER_PANEL:  WS_dk_get$ = UCASE$(_TRIM$(CFG.LAYERS_PANEL_DOCK_EDGE))
        CASE WS_DK_EDIT_BAR:     WS_dk_get$ = UCASE$(_TRIM$(CFG.EDIT_BAR_DOCK_POSITION$))
        CASE WS_DK_ADVANCED_BAR: WS_dk_get$ = UCASE$(_TRIM$(CFG.ADV_BAR_DOCK_POSITION$))
        CASE WS_DK_CHARMAP:      WS_dk_get$ = UCASE$(_TRIM$(CFG.CHARMAP_PANEL_DOCK_EDGE$))
    END SELECT
END FUNCTION


''
' Set only the CFG dock field (what CONFIG_save writes).
SUB WS_dk_set_cfg (dk AS INTEGER, edge AS STRING)
    SELECT CASE dk
        CASE WS_DK_TOOLBOX:      CFG.TOOLBOX_DOCK_EDGE = edge
        CASE WS_DK_LAYER_PANEL:  CFG.LAYERS_PANEL_DOCK_EDGE = edge
        CASE WS_DK_EDIT_BAR:     CFG.EDIT_BAR_DOCK_POSITION$ = edge
        CASE WS_DK_ADVANCED_BAR: CFG.ADV_BAR_DOCK_POSITION$ = edge
        CASE WS_DK_CHARMAP:      CFG.CHARMAP_PANEL_DOCK_EDGE$ = edge
    END SELECT
END SUB


''
' Dock an element live (CFG field + the panel's own dockSide).
SUB WS_dk_set (dk AS INTEGER, edge AS STRING)
    DIM e AS STRING
    e = UCASE$(_TRIM$(edge))
    IF e <> "LEFT" _ANDALSO e <> "RIGHT" THEN EXIT SUB
    WS_dk_set_cfg dk, e
    SELECT CASE dk
        CASE WS_DK_EDIT_BAR
            IF e = "LEFT" THEN EDIT_BAR.dockSide% = EDITBAR_DOCK_LEFT ELSE EDIT_BAR.dockSide% = EDITBAR_DOCK_RIGHT
        CASE WS_DK_ADVANCED_BAR
            IF e = "LEFT" THEN ADV_BAR.dockSide% = ADVBAR_DOCK_LEFT ELSE ADV_BAR.dockSide% = ADVBAR_DOCK_RIGHT
        CASE WS_DK_CHARMAP
            IF e = "LEFT" THEN CHARMAP.dockSide% = CHARMAP_DOCK_LEFT ELSE CHARMAP.dockSide% = CHARMAP_DOCK_RIGHT
    END SELECT
END SUB


''
' SHOW/HIDE/KEEP (also TRUE/FALSE/ON/OFF/1/0) -> 1 show, 0 hide, -1 keep.
FUNCTION WS_parse_vis% (v AS STRING)
    SELECT CASE UCASE$(_TRIM$(v))
        CASE "SHOW", "TRUE", "ON", "1", "YES": WS_parse_vis% = 1
        CASE "HIDE", "FALSE", "OFF", "0", "NO": WS_parse_vis% = 0
        CASE ELSE: WS_parse_vis% = -1
    END SELECT
END FUNCTION


''
' Tool name (workspace files, [START] TOOL=, later [TOOLBOX]/[KEYS]) ->
' the action that selects it; 0 = unknown.
FUNCTION WS_tool_action% (toolName AS STRING)
    SELECT CASE LCASE$(_TRIM$(toolName))
        CASE "brush":                       WS_tool_action% = 101
        CASE "dot", "pset":                 WS_tool_action% = 102
        CASE "fill", "paint":               WS_tool_action% = 103
        CASE "picker", "eyedropper":        WS_tool_action% = 104
        CASE "line":                        WS_tool_action% = 105
        CASE "polygon":                     WS_tool_action% = 106
        CASE "polygon-filled":              WS_tool_action% = 107
        CASE "rect", "rectangle":           WS_tool_action% = 108
        CASE "rect-filled":                 WS_tool_action% = 109
        CASE "ellipse", "circle":           WS_tool_action% = 110
        CASE "ellipse-filled":              WS_tool_action% = 111
        CASE "marquee", "select":           WS_tool_action% = 112
        CASE "move":                        WS_tool_action% = 113
        CASE "text":                        WS_tool_action% = 114
        CASE "wand", "magic-wand":          WS_tool_action% = 117
        CASE "eraser":                      WS_tool_action% = 118
        CASE "marquee-free", "lasso":       WS_tool_action% = 119
        CASE "marquee-poly":                WS_tool_action% = 120
        CASE "marquee-ellipse":             WS_tool_action% = 121
        CASE "bezier":                      WS_tool_action% = 122
        CASE "zoom":                        WS_tool_action% = 1701
        CASE "spray":                       WS_tool_action% = 1702
        CASE "smart-shapes":                WS_tool_action% = 1706
        CASE "crop":                        WS_tool_action% = 1802 ' crop to selection, else interactive crop
        CASE "arrow":                       WS_tool_action% = 2453 ' GUI/ANNOTATE
        CASE "highlight", "highlighter":    WS_tool_action% = 2454
        CASE "redact":                      WS_tool_action% = 2455
        CASE "callout":                     WS_tool_action% = 2456
        CASE "callout-reset":               WS_tool_action% = 2457
        CASE "quick-save":                  WS_tool_action% = 2451
        CASE "done":                        WS_tool_action% = 2452
        CASE "copy-image", "copy-merged":   WS_tool_action% = 322
        CASE "capture":                     WS_tool_action% = 2450
    END SELECT
END FUNCTION


''
' Capture the user's current value of each [OPTIONS] key by writing the live
' config to a scratch file (CONFIG_save, unguarded) and reading it back - the
' exact text CONFIG_apply_key% accepts, for every key, with no per-key getter.
SUB WS_capture_option_origs ()
    DIM realPath AS STRING, tmpPath AS STRING, fh AS INTEGER, ln AS STRING
    DIM eq AS INTEGER, k AS STRING, i AS INTEGER
    IF WS_OPT_N = 0 THEN EXIT SUB
    realPath = CONFIG_FILE_PATH$
    tmpPath = PATHS_cache$("workspace-cfg-snapshot.tmp")
    CONFIG_FILE_PATH$ = tmpPath
    WS_GUARD_BYPASS = TRUE
    CONFIG_save
    WS_GUARD_BYPASS = FALSE
    CONFIG_FILE_PATH$ = realPath
    IF _FILEEXISTS(tmpPath) = 0 THEN EXIT SUB
    fh = FREEFILE
    OPEN tmpPath FOR INPUT AS #fh
    DO WHILE NOT EOF(fh)
        LINE INPUT #fh, ln
        eq = INSTR(ln, "=")
        IF eq < 2 THEN _CONTINUE
        k = UCASE$(_TRIM$(LEFT$(ln, eq - 1)))
        FOR i = 1 TO WS_OPT_N
            IF WS_OPT_HAD(i) = 0 _ANDALSO WS_OPT_KEY(i) = k THEN
                WS_OPT_ORIG(i) = _TRIM$(MID$(ln, eq + 1))
                WS_OPT_HAD(i) = TRUE
            END IF
        NEXT i
    LOOP
    CLOSE #fh
    KILL tmpPath
END SUB


SUB WS_refresh ()
    INVALIDATE_scene
    STATUS_NEEDS_REDRAW% = TRUE
END SUB


''
' Leave the active workspace: every touched element back to the user's state.
SUB WS_restore ()
    DIM el AS INTEGER, dk AS INTEGER, i AS INTEGER, ok AS INTEGER
    IF WS_ACTIVE = 0 THEN EXIT SUB
    IF UIALL_HIDDEN THEN UIALL_show ' F11's hidden UI is not the user's layout
    WS_panels_poll TRUE ' a panel change made in the workspace goes into it before the user's own state comes back
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) THEN
            WS_el_set el, WS_EL_SNAP_VIS(el)
            WS_el_set_mh el, WS_EL_SNAP_MH(el)
            IF WS_el_has_cfg%(el) THEN WS_el_set_cfg el, WS_EL_SNAP_CFG(el)
            WS_EL_TOUCHED(el) = FALSE
        END IF
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_TOUCHED(dk) THEN
            WS_dk_set dk, WS_DK_SNAP(dk)
            WS_DK_TOUCHED(dk) = FALSE
        END IF
    NEXT dk
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_HAD(i) THEN ok = CONFIG_apply_key%(WS_OPT_KEY(i), WS_OPT_ORIG(i))
    NEXT i
    WS_OPT_N = 0
    IF WS_TB_TOUCHED THEN TOOLBAR_layout_restore
    WS_TB_TOUCHED = FALSE
    IF WS_LW_TOUCHED THEN LAYER_PANEL.width% = CFG.LAYER_PANEL_WIDTH%
    WS_LW_TOUCHED = FALSE
    IF WS_DOCK_TOUCHED THEN DOCK_load_snapshot WS_DOCK_USER_SNAP
    WS_DOCK_TOUCHED = FALSE
    IF WS_PANELS_ON THEN WS_panels_push ' the user's own scales, zooms and panel settings (restored above)
    IF WS_WIN_TOUCHED _ORELSE WS_PANELS_ON THEN DOCK_native_from_cfg ' the user's own window places (restored above)
    WS_WIN_TOUCHED = FALSE
    WS_PANELS_ON = FALSE
    IF WS_BARS_TOUCHED THEN WS_bars_reset
    WS_BARS_TOUCHED = FALSE
    IF WS_KEY_N > 0 THEN WS_keys_reset
    IF WS_MENUS_TOUCHED THEN
        MENU_FILTER_ROOTS$ = ""
        MENU_FILTER_ITEMS$ = ""
    END IF
    IF WS_MENUS_TOUCHED _ORELSE WS_CMD_HK_N > 0 THEN MENUBAR_rebuild
    WS_CMD_HK_N = 0
    WS_MENUS_TOUCHED = FALSE
    WS_ACTIVE = FALSE
    WS_REVEALED = FALSE
    WS_START_PENDING = FALSE
    WS_ACTIVE_ID = WS_DEFAULT_ID$
    WS_ACTIVE_TITLE = "Default"
    _LOGINFO "WORKSPACE: restored the user's layout"
    WS_refresh
END SUB


''
' Switch to a workspace (id or title). Leaves the current one first, so
' switching never stacks overlays. Default = just leave. Remembers the
' choice in CFG.WORKSPACE. Returns FALSE (and flashes why) when the
' workspace can't be found.
FUNCTION WS_apply% (idOrTitle AS STRING)
    DIM idx AS INTEGER, i AS INTEGER, el AS INTEGER, dk AS INTEGER, ok AS INTEGER
    DIM k AS STRING, v AS STRING, want AS INTEGER, matched AS INTEGER, wantId AS STRING

    idx = WS_find%(idOrTitle)
    IF idx = 0 THEN
        STATUS_flash "No workspace named '" + idOrTitle + "'"
        _LOGWARN "WORKSPACE: no workspace named '" + idOrTitle + "'"
        EXIT FUNCTION
    END IF
    IF UIALL_HIDDEN THEN UIALL_show ' (a workspace snapshots what is showing: not F11's hidden UI)

    wantId = WS_LIST(idx).id
    WS_restore
    idx = WS_find%(wantId) ' (leaving may have saved a panel change: the list was scanned again)
    IF idx = 0 THEN EXIT FUNCTION

    IF WS_is_default%(WS_LIST(idx).id) THEN
        IF WS_NO_REMEMBER = 0 THEN CFG.WORKSPACE$ = WS_DEFAULT_ID$
        CONFIG_save
        STATUS_flash "Workspace: Default"
        WS_apply% = TRUE
        EXIT FUNCTION
    END IF

    IF WS_resolve%(WS_LIST(idx).id) = 0 THEN
        STATUS_flash "Workspace: " + WS_LAST_ERROR
        EXIT FUNCTION
    END IF

    ' 1. Snapshot the user's state for everything this workspace names
    ' Every element and dock side belongs to the workspace while it is active
    ' (a KEEP / unnamed one starts as it is now): a panel shown, hidden or moved
    ' here is the workspace's (remembered in its file), never DRAW.cfg's, and
    ' leaving puts the user's own back.
    FOR el = 1 TO WS_EL_COUNT
        want = WS_parse_vis%(WS_get$("CHROME." + WS_EL_NAME(el), "KEEP"))
        WS_EL_TOUCHED(el) = TRUE
        WS_EL_NAMED(el) = (want >= 0)
        IF want >= 0 THEN WS_EL_WANT(el) = (want = 1) ELSE WS_EL_WANT(el) = WS_el_get%(el)
        WS_EL_SNAP_VIS(el) = WS_el_get%(el)
        WS_EL_SNAP_MH(el) = WS_el_get_mh%(el)
        IF WS_el_has_cfg%(el) THEN WS_EL_SNAP_CFG(el) = WS_el_get_cfg%(el)
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        v = UCASE$(WS_get$("CHROME." + WS_DK_NAME(dk), ""))
        WS_DK_TOUCHED(dk) = TRUE
        WS_DK_SNAP(dk) = WS_dk_get$(dk)
        WS_DK_NAMED(dk) = (v = "LEFT" _ORELSE v = "RIGHT")
        IF WS_DK_NAMED(dk) THEN WS_DK_WANT(dk) = v ELSE WS_DK_WANT(dk) = WS_DK_SNAP(dk)
    NEXT dk
    WS_OPT_N = 0
    i = 0
    DO
        i = WS_next_in_section%("OPTIONS", i)
        IF i = 0 THEN EXIT DO
        IF WS_OPT_N >= WS_MAX_OPTS THEN EXIT DO
        WS_OPT_N = WS_OPT_N + 1
        WS_OPT_KEY(WS_OPT_N) = WS_res_key_part$(i)
        WS_OPT_VAL(WS_OPT_N) = WS_RES_VAL(i)
        WS_OPT_ORIG(WS_OPT_N) = ""
        WS_OPT_HAD(WS_OPT_N) = FALSE
        WS_OPT_KIND(WS_OPT_N) = WS_OK_OPTION
    LOOP
    ' [WINDOWS] - the floating windows' places (Save Current Layout): DRAW.cfg
    ' keys like [OPTIONS], so the guard keeps them out of the user's file and
    ' leaving puts the user's own back
    WS_WIN_TOUCHED = FALSE
    i = 0
    DO
        i = WS_next_in_section%("WINDOWS", i)
        IF i = 0 THEN EXIT DO
        IF WS_OPT_N >= WS_MAX_OPTS THEN EXIT DO
        WS_OPT_N = WS_OPT_N + 1
        WS_OPT_KEY(WS_OPT_N) = WS_res_key_part$(i)
        WS_OPT_VAL(WS_OPT_N) = WS_RES_VAL(i)
        WS_OPT_ORIG(WS_OPT_N) = ""
        WS_OPT_HAD(WS_OPT_N) = FALSE
        WS_OPT_KIND(WS_OPT_N) = WS_OK_WINDOW
        WS_WIN_TOUCHED = TRUE
    LOOP
    ' [PANELS] and every other panel / window key (WS_panels_add): the
    ' workspace's own value, or the live one - all kept out of DRAW.cfg, put
    ' back on leaving, and a change made here is saved into the workspace
    WS_panels_pull
    WS_panels_add
    WS_capture_option_origs
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_KIND(i) >= WS_OK_PANEL _ANDALSO LEN(WS_OPT_VAL(i)) = 0 THEN WS_OPT_VAL(i) = WS_OPT_ORIG(i)
    NEXT i

    ' Keys the overlay does not handle yet are reported once, not silently dropped
    i = 0
    DO
        i = WS_next_in_section%("CHROME", i)
        IF i = 0 THEN EXIT DO
        k = WS_res_key_part$(i)
        matched = FALSE
        FOR el = 1 TO WS_EL_COUNT
            IF WS_EL_NAME(el) = k THEN matched = TRUE
        NEXT el
        FOR dk = 1 TO WS_DK_COUNT
            IF WS_DK_NAME(dk) = k THEN matched = TRUE
        NEXT dk
        IF k = "LAYER_PANEL_WIDTH" THEN matched = TRUE
        IF matched = 0 THEN _LOGINFO "WORKSPACE: [CHROME] " + k + " is not applied yet (later phase) - ignored"
    LOOP

    ' 2. Apply (the guard is live from here, so any CONFIG_save keeps user values)
    WS_ACTIVE = TRUE
    WS_REVEALED = FALSE
    WS_ACTIVE_ID = WS_LIST(idx).id
    WS_ACTIVE_TITLE = WS_LIST(idx).title
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_NAMED(el) THEN WS_el_set el, WS_EL_WANT(el)
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_NAMED(dk) THEN WS_dk_set dk, WS_DK_WANT(dk)
    NEXT dk
    WS_apply_toolbox
    WS_apply_bars
    WS_apply_dock
    WS_dock_keys_from_tree ' an arranged tree places the panels: the side keys follow it
    v = WS_get$("CHROME.LAYER_PANEL_WIDTH", "")
    IF VAL(v) > 0 THEN
        LAYER_PANEL.width% = LAYERS_clamp_width%(VAL(v))
        WS_LW_TOUCHED = TRUE
    END IF
    WS_apply_keys
    WS_apply_menus
    WS_relabel_hotkeys
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_HAD(i) THEN
            IF WS_OPT_KIND(i) < WS_OK_PANEL _ORELSE WS_OPT_VAL(i) <> WS_OPT_ORIG(i) THEN
                ok = CONFIG_apply_key%(WS_OPT_KEY(i), WS_OPT_VAL(i))
                IF ok = 0 THEN _LOGWARN "WORKSPACE: [OPTIONS] " + WS_OPT_KEY(i) + " not accepted"
            END IF
        ELSEIF WS_OPT_KIND(i) < WS_OK_PANEL THEN
            _LOGWARN "WORKSPACE: [OPTIONS] unknown key " + WS_OPT_KEY(i) + " - ignored"
        END IF
    NEXT i
    WS_panels_push ' the panels take their scales, zooms and settings
    DOCK_native_from_cfg ' the floating windows to their saved places
    WS_POLL_BASE = TRUE: WS_POLL_WANT = TRUE ' the first look records what is live now
    WS_START_PENDING = TRUE

    IF WS_NO_REMEMBER = 0 THEN CFG.WORKSPACE$ = WS_ACTIVE_ID
    CONFIG_save
    _LOGINFO "WORKSPACE: applied '" + WS_ACTIVE_ID + "' (" + WS_ACTIVE_TITLE + ")"
    STATUS_flash "Workspace: " + WS_ACTIVE_TITLE + "   (Ctrl+Shift+W switch, F11 show all)"
    WS_refresh
    WS_apply% = TRUE
END FUNCTION


''
' CONFIG_save calls this before writing: the fields the overlay touched get
' the user's own values for the duration of the write.
SUB WS_cfg_guard_begin ()
    DIM el AS INTEGER, dk AS INTEGER, i AS INTEGER, ok AS INTEGER
    IF WS_ACTIVE = 0 _ORELSE WS_GUARD_BYPASS _ORELSE WS_GUARD_ON THEN EXIT SUB
    WS_GUARD_ON = TRUE
    WS_POLL_WANT = TRUE ' (a panel setting may have just changed: WS_panels_poll looks)
    WS_CFG_LIVE = CFG ' everything live, so _end puts back what is live now (an option toggled since included)
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) _ANDALSO WS_el_has_cfg%(el) THEN
            WS_EL_HOLD_CFG(el) = WS_el_get_cfg%(el)
            WS_el_set_cfg el, WS_EL_SNAP_CFG(el)
        END IF
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_TOUCHED(dk) THEN
            WS_DK_HOLD(dk) = WS_dk_get$(dk)
            WS_dk_set_cfg dk, WS_DK_SNAP(dk)
        END IF
    NEXT dk
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_HAD(i) THEN ok = CONFIG_apply_key%(WS_OPT_KEY(i), WS_OPT_ORIG(i))
    NEXT i
END SUB


''
' ...and after: the overlay's live values come back.
SUB WS_cfg_guard_end ()
    DIM el AS INTEGER, dk AS INTEGER, i AS INTEGER, ok AS INTEGER
    IF WS_GUARD_ON = 0 THEN EXIT SUB
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) _ANDALSO WS_el_has_cfg%(el) THEN WS_el_set_cfg el, WS_EL_HOLD_CFG(el)
    NEXT el
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_TOUCHED(dk) THEN WS_dk_set_cfg dk, WS_DK_HOLD(dk)
    NEXT dk
    ' the options as they are live now - not the workspace file's values, which
    ' would undo a toggle made inside the workspace (the lightbox in Animate)
    CFG = WS_CFG_LIVE
    WS_GUARD_ON = FALSE
END SUB


''
' F11 inside a workspace that hides something: first press shows what the
' workspace hid, second press hides it again. Returns FALSE when F11 should
' do its normal toggle-all (no workspace, or it hides nothing).
FUNCTION WS_f11% ()
    DIM el AS INTEGER, hidesAny AS INTEGER
    IF WS_ACTIVE = 0 THEN EXIT FUNCTION
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) _ANDALSO WS_EL_WANT(el) = 0 THEN hidesAny = TRUE
    NEXT el
    IF hidesAny = 0 THEN EXIT FUNCTION
    WS_REVEALED = _NEGATE WS_REVEALED
    FOR el = 1 TO WS_EL_COUNT
        IF WS_EL_TOUCHED(el) _ANDALSO WS_EL_WANT(el) = 0 THEN
            ' Reveal what the workspace hid only if the user had it showing
            ' (or it is fixed chrome with no saved state of its own)
            IF WS_REVEALED THEN
                IF WS_EL_SNAP_VIS(el) _ORELSE WS_el_has_cfg%(el) = 0 THEN WS_el_set el, TRUE
            ELSE
                WS_el_set el, FALSE
            END IF
        END IF
    NEXT el
    IF WS_REVEALED THEN
        STATUS_flash "Workspace " + WS_ACTIVE_TITLE + ": showing everything (F11 hides it again)"
    ELSE
        STATUS_flash "Workspace: " + WS_ACTIVE_TITLE
    END IF
    WS_refresh
    WS_f11% = TRUE
END FUNCTION


''
' Parse "#RRGGBB" / "RRGGBB" / "#RRGGBBAA" -> color; returns FALSE when bad.
FUNCTION WS_parse_color% (s AS STRING, outColor AS _UNSIGNED LONG)
    DIM h AS STRING, i AS INTEGER, ch AS STRING
    h = UCASE$(_TRIM$(s))
    IF LEFT$(h, 1) = "#" THEN h = MID$(h, 2)
    IF LEN(h) <> 6 _ANDALSO LEN(h) <> 8 THEN EXIT FUNCTION
    FOR i = 1 TO LEN(h)
        ch = MID$(h, i, 1)
        IF INSTR("0123456789ABCDEF", ch) = 0 THEN EXIT FUNCTION
    NEXT i
    IF LEN(h) = 6 THEN
        outColor = _RGB32(VAL("&H" + MID$(h, 1, 2)), VAL("&H" + MID$(h, 3, 2)), VAL("&H" + MID$(h, 5, 2)))
    ELSE
        outColor = _RGBA32(VAL("&H" + MID$(h, 1, 2)), VAL("&H" + MID$(h, 3, 2)), VAL("&H" + MID$(h, 5, 2)), VAL("&H" + MID$(h, 7, 2)))
    END IF
    WS_parse_color% = TRUE
END FUNCTION


''
' [START]: TOOL, FG, ZOOM (FIT or a percent; 100 = 1:1). Runs once, after a
' render has laid out the new chrome.
SUB WS_apply_start ()
    DIM t AS STRING, act AS INTEGER, c AS _UNSIGNED LONG, z AS STRING, zf AS SINGLE, i AS INTEGER
    WS_START_PENDING = FALSE
    IF WS_ACTIVE = 0 THEN EXIT SUB

    t = WS_get$("START.TOOL", "")
    IF LEN(t) THEN
        act = WS_tool_action%(t)
        IF act THEN CMD_execute_action act ELSE _LOGWARN "WORKSPACE: [START] unknown TOOL " + t
    END IF

    IF WS_parse_color%(WS_get$("START.FG", ""), c) THEN
        PAINT_COLOR~& = c
        PAL_FG_IS_TRANSPARENT% = (_ALPHA32(c) = 0)
        FOR i = 0 TO PAL_COLOR_COUNT - 1
            IF PAL(i).value = c THEN PAL_FG_IDX% = i: EXIT FOR
        NEXT i
    END IF

    z = UCASE$(WS_get$("START.ZOOM", ""))
    IF z = "FIT" THEN
        SCREEN_compute_layout
        ZOOM_fit_canvas
    ELSEIF VAL(z) > 0 THEN
        zf = VAL(z) / 100
        IF zf < SCRN.zoomMin! THEN zf = SCRN.zoomMin!
        IF zf > SCRN.zoomMax! THEN zf = SCRN.zoomMax!
        SCRN.zoom! = zf
        SCRN.offsetX% = 0
        SCRN.offsetY% = 0
    END IF
    WS_refresh
END SUB


''
' Per frame (after render): run a pending [START] once the command-line file
' (if any) has loaded, so the zoom fits the real document.
SUB WS_tick ()
    WS_panels_tick
    IF WS_START_PENDING = 0 THEN EXIT SUB
    IF LEN(CMDLINE_PENDING_FILE$) THEN EXIT SUB
    WS_apply_start
END SUB


''
' Startup: reopen in the remembered workspace (CFG.WORKSPACE).
SUB WS_startup ()
    DIM ok AS INTEGER, i AS INTEGER
    WS_scan
    ' --workspace NAME: this run only (CFG.WORKSPACE keeps the remembered one)
    FOR i = 1 TO _COMMANDCOUNT - 1
        IF LCASE$(_TRIM$(COMMAND$(i))) = "--workspace" THEN WS_CLI_NAME = _TRIM$(COMMAND$(i + 1))
    NEXT i
    IF LEN(WS_CLI_NAME) THEN
        WS_NO_REMEMBER = TRUE
        ok = WS_apply%(WS_CLI_NAME)
        WS_NO_REMEMBER = FALSE
    ELSEIF WS_is_default%(CFG.WORKSPACE$) = 0 THEN
        ok = WS_apply%(CFG.WORKSPACE$)
        IF ok = 0 THEN CFG.WORKSPACE$ = WS_DEFAULT_ID$
    END IF
    WS_sync_commands
    MENUBAR_rebuild
END SUB


''
' Rebuild the command palette's "Workspace: <name>" entries from WS_LIST
' (dropping the old ones first); the active one shows "active" as its hotkey.
SUB WS_sync_commands ()
    DIM i AS INTEGER, j AS INTEGER, a AS INTEGER
    j = 0
    FOR i = 0 TO CMD_COUNT - 1
        a = CMD_LIST(i).action_id
        IF a > WS_ACT_SLOT0 _ANDALSO a <= WS_ACT_SLOT0 + WS_MAX THEN _CONTINUE
        IF j <> i THEN CMD_LIST(j) = CMD_LIST(i)
        j = j + 1
    NEXT i
    CMD_COUNT = j
    FOR i = 1 TO WS_COUNT
        IF WS_LIST(i).id = WS_ACTIVE_ID THEN
            CMD_register WS_CMD_PREFIX$ + WS_LIST(i).title, "active", CMD_CAT_VIEW, WS_ACT_SLOT0 + i
        ELSE
            CMD_register WS_CMD_PREFIX$ + WS_LIST(i).title, "", CMD_CAT_VIEW, WS_ACT_SLOT0 + i
        END IF
    NEXT i
END SUB


''
' The escape hatch: the command palette, pre-filtered to the workspaces with
' the active one highlighted. Typing narrows it ("ann" -> Annotate).
SUB WS_open_switcher ()
    DIM i AS INTEGER, q AS STRING
    WS_sync_commands
    CMD_show_palette
    q = UCASE$(WS_CMD_PREFIX$) ' (shown in caps; the palette retries an all-caps query ignoring case)
    CMD_PALETTE.search = q
    CMD_PALETTE.search_len = LEN(q)
    CMD_update_search
    FOR i = 0 TO CMD_PALETTE.result_count - 1
        IF RTRIM$(CMD_LIST(CMD_RESULTS(i)).hotkey) = "active" THEN CMD_PALETTE.hover = i: EXIT FOR
    NEXT i
    GUI_NEEDS_REDRAW% = TRUE
END SUB


''
' Rescan workspace files; the menu and palette follow. A workspace whose
' file disappeared is left.
SUB WS_reload ()
    DIM activeId AS STRING
    activeId = WS_ACTIVE_ID
    WS_scan
    IF WS_ACTIVE _ANDALSO WS_find%(activeId) = 0 THEN WS_restore
    WS_sync_commands
    MENUBAR_rebuild
    STATUS_flash "Workspaces reloaded:" + STR$(WS_COUNT)
END SUB


''
' Dispatch actions 2400-2449.
SUB WS_action (act AS INTEGER)
    DIM ok AS INTEGER, d AS STRING, n AS INTEGER
    SELECT CASE act
        CASE WS_ACT_SWITCHER
            WS_open_switcher
        CASE WS_ACT_CONFIGURE
            WSC_show_dialog ' GUI/WORKSPACE-CONFIG
        CASE WS_ACT_FOLDER
            d = WS_user_dir$
            PATHS_ensure_dir d + PATHS_sep$
            ok = PATHS_open_in_file_manager%(d)
        CASE WS_ACT_RELOAD
            WS_reload
        CASE WS_ACT_LEAVE
            ok = WS_apply%(WS_DEFAULT_ID$)
        CASE WS_ACT_SAVE_AS
            WSC_save_layout_as ' GUI/WORKSPACE-CONFIG
        CASE WS_ACT_UPDATE
            WSC_update_from_layout
        CASE WS_ACT_REVEAL
            IF WS_f11% = 0 THEN STATUS_flash "Shift+F11: this workspace hides nothing (F11 hides all UI)"
        CASE WS_ACT_SLOT0 + 1 TO WS_ACT_SLOT0 + WS_MAX
            n = act - WS_ACT_SLOT0
            IF n <= WS_COUNT THEN ok = WS_apply%(WS_LIST(n).id)
    END SELECT
    WS_sync_commands
END SUB


''
' Menu checkmark for a workspace slot action.
FUNCTION WS_slot_is_active% (act AS INTEGER)
    DIM n AS INTEGER
    n = act - WS_ACT_SLOT0
    IF n < 1 _ORELSE n > WS_COUNT THEN EXIT FUNCTION
    WS_slot_is_active% = (WS_LIST(n).id = WS_ACTIVE_ID)
END FUNCTION


''
' Status-bar badge text ("" when Default is active).
FUNCTION WS_badge$ ()
    IF WS_ACTIVE = 0 THEN EXIT FUNCTION
    WS_badge$ = "[WS: " + WS_ACTIVE_TITLE + "]"
END FUNCTION



''
' [TOOLBOX]: BUTTONS= (order + which buttons), COLUMNS=, ICON.<name>=file.
SUB WS_apply_toolbox ()
    DIM btns AS STRING, cols AS INTEGER, used AS INTEGER, i AS INTEGER, k AS STRING
    WS_TB_TOUCHED = FALSE
    cols = VAL(WS_get$("TOOLBOX.COLUMNS", "0"))
    btns = WS_get$("TOOLBOX.BUTTONS", "")
    IF LEN(btns) THEN
        used = TOOLBAR_layout_apply%(btns, cols)
        IF used THEN WS_TB_TOUCHED = TRUE
    ELSEIF cols > 0 THEN
        ' COLUMNS alone: the default buttons, re-flowed
        TB_WANT_COLS = _MIN(cols, 8)
        TB_LIVE_COLS = TB_WANT_COLS
        TB_LIVE_ROWS = (TB_LIVE_COUNT + TB_LIVE_COLS - 1) \ TB_LIVE_COLS
        WS_TB_TOUCHED = TRUE
    END IF
    i = 0
    DO
        i = WS_next_in_section%("TOOLBOX", i)
        IF i = 0 THEN EXIT DO
        k = WS_res_key_part$(i)
        IF LEFT$(k, 5) = "ICON." THEN
            IF TOOLBAR_icon_override%(MID$(k, 6), WS_RES_VAL(i)) THEN
                WS_TB_TOUCHED = TRUE
            ELSE
                _LOGWARN "WORKSPACE: [TOOLBOX] " + k + "=" + WS_RES_VAL(i) + " - unknown button or image"
            END IF
        END IF
    LOOP
END SUB


''
' DRAWER_save_state_binary: the drawer visibility to write into a document -
' the user's own when a workspace is hiding/showing it.
FUNCTION WS_drawer_file_visible% ()
    IF WS_ACTIVE _ANDALSO WS_EL_TOUCHED(WS_EL_DRAWER) THEN
        WS_drawer_file_visible% = WS_EL_SNAP_VIS(WS_EL_DRAWER)
    ELSE
        WS_drawer_file_visible% = DRAWER.visible%
    END IF
END FUNCTION


''
' DRAWER_load_state_binary: a document just set the drawer visibility. That
' becomes the user's value to restore; the workspace's stays live.
SUB WS_on_drawer_loaded ()
    IF WS_ACTIVE = 0 _ORELSE WS_EL_TOUCHED(WS_EL_DRAWER) = 0 THEN EXIT SUB
    WS_EL_SNAP_VIS(WS_EL_DRAWER) = (DRAWER.visible% <> 0)
    IF WS_REVEALED = 0 THEN DRAWER.visible% = WS_EL_WANT(WS_EL_DRAWER)
END SUB



' =============================================================================
' [EDIT_BAR] / [ADVANCED_BAR] BUTTONS= and [ORGANIZER] WIDGETS=: which buttons
' show (the bars keep their own order; dividers appear only between shown
' groups). Names below, or a numeric action id.
' =============================================================================

FUNCTION WS_editbar_name$ (act AS INTEGER)
    SELECT CASE act
        CASE 301: WS_editbar_name$ = "undo"
        CASE 302: WS_editbar_name$ = "redo"
        CASE 304: WS_editbar_name$ = "cut"
        CASE 303: WS_editbar_name$ = "copy"
        CASE 322: WS_editbar_name$ = "copy-merged"
        CASE 305: WS_editbar_name$ = "paste"
        CASE 312: WS_editbar_name$ = "paste-in-place"
        CASE 323: WS_editbar_name$ = "cut-to-layer"
        CASE 321: WS_editbar_name$ = "copy-to-layer"
        CASE 308: WS_editbar_name$ = "clear"
        CASE 313: WS_editbar_name$ = "fill-fg"
        CASE 314: WS_editbar_name$ = "fill-bg"
        CASE 324: WS_editbar_name$ = "stroke"
        CASE 315: WS_editbar_name$ = "flip-h"
        CASE 316: WS_editbar_name$ = "flip-v"
        CASE 317: WS_editbar_name$ = "scale-down"
        CASE 318: WS_editbar_name$ = "scale-up"
        CASE 319: WS_editbar_name$ = "rotate-cw"
        CASE 320: WS_editbar_name$ = "rotate-ccw"
        CASE 910: WS_editbar_name$ = "smart-guides"
        CASE 911: WS_editbar_name$ = "smart-guides-snap"
        CASE 959: WS_editbar_name$ = "edge-mode"
        CASE 1803: WS_editbar_name$ = "flip-canvas-h"
        CASE 1804: WS_editbar_name$ = "flip-canvas-v"
    END SELECT
END FUNCTION

FUNCTION WS_advbar_name$ (act AS INTEGER)
    SELECT CASE act
        CASE 434: WS_advbar_name$ = "preview"
        CASE 435: WS_advbar_name$ = "edit-bar"
        CASE 2050: WS_advbar_name$ = "char-map"
        CASE 2053: WS_advbar_name$ = "char-grid"
        CASE 2054: WS_advbar_name$ = "char-grid-snap"
        CASE 440: WS_advbar_name$ = "tile-mode"
        CASE 908: WS_advbar_name$ = "grid-cell-fill"
        CASE 907: WS_advbar_name$ = "grid-brush-size"
        CASE 909: WS_advbar_name$ = "fill-adjust"
        CASE 607: WS_advbar_name$ = "brush-edges"
        CASE 414: WS_advbar_name$ = "angle-snap"
        CASE 2020: WS_advbar_name$ = "grayscale"
        CASE 1501: WS_advbar_name$ = "ref-on"
        CASE 1502: WS_advbar_name$ = "ref-load"
        CASE 1503: WS_advbar_name$ = "ref-clear"
        CASE 1504: WS_advbar_name$ = "ref-adjust"
        CASE 1901: WS_advbar_name$ = "align-left"
        CASE 1902: WS_advbar_name$ = "align-center"
        CASE 1903: WS_advbar_name$ = "align-right"
        CASE 1904: WS_advbar_name$ = "align-top"
        CASE 1905: WS_advbar_name$ = "align-middle"
        CASE 1906: WS_advbar_name$ = "align-bottom"
        CASE 1907: WS_advbar_name$ = "distribute-h"
        CASE 1908: WS_advbar_name$ = "distribute-v"
    END SELECT
END FUNCTION

FUNCTION WS_org_name$ (idx AS INTEGER)
    SELECT CASE idx
        CASE ORG_COLOR_MIXER:   WS_org_name$ = "color-mixer"
        CASE ORG_CANVAS_OPS:    WS_org_name$ = "canvas-ops"
        CASE ORG_BRUSH_SIZE:    WS_org_name$ = "brush-size"
        CASE ORG_PATTERN_MODE:  WS_org_name$ = "pattern-mode"
        CASE ORG_PALETTE_OPS:   WS_org_name$ = "palette-ops"
        CASE ORG_TRANSFORM_OPS: WS_org_name$ = "transform-ops"
        CASE ORG_GRADIENT_MODE: WS_org_name$ = "gradient-mode"
        CASE ORG_SYMMETRY_MODE: WS_org_name$ = "symmetry"
        CASE ORG_GRID_VIS:      WS_org_name$ = "grid"
        CASE ORG_GRID_SNAP:     WS_org_name$ = "grid-snap"
        CASE ORG_COLOR_MODE:    WS_org_name$ = "color-mode"
    END SELECT
END FUNCTION


''
' TRUE when comma list lst names <nm> or the action id <act>.
FUNCTION WS_list_has% (lst AS STRING, nm AS STRING, act AS INTEGER)
    DIM i AS INTEGER, it AS STRING
    FOR i = 1 TO WS_list_count%(lst)
        it = LCASE$(WS_list_item$(lst, i))
        IF LEN(nm) _ANDALSO it = nm THEN WS_list_has% = TRUE: EXIT FUNCTION
        IF act <> 0 _ANDALSO VAL(it) = act _ANDALSO LEN(it) THEN WS_list_has% = TRUE: EXIT FUNCTION
    NEXT i
END FUNCTION


SUB WS_bars_reset ()
    DIM i AS INTEGER
    BL_set_default BL_EDITBAR ' the bars' own buttons, in their own order (GUI/BUTTON-LIST)
    BL_set_default BL_ADVBAR
    FOR i = 0 TO ORG_WIDGET_COUNT - 1: ORG_HIDDEN(i) = FALSE: NEXT i
    EDITBAR_NCOLS = 0: ADVBAR_NCOLS = 0 ' back to DRAW.cfg's columns
    INVALIDATE_scene
END SUB


''
' A bar's list from a workspace: ORDER= is the list as given (any order,
' | dividers, cmd:<id>); BUTTONS= (the older form) keeps the bar's own order
' and shows the named buttons, with a divider only between two groups that
' each kept a button. TRUE when the section set either.
FUNCTION WS_apply_bar_list% (panel AS INTEGER, sec AS STRING)
    DIM lst AS STRING, i AS INTEGER, j AS INTEGER, n AS INTEGER, ok AS INTEGER, groupHas AS INTEGER, anyBefore AS INTEGER, nm AS STRING
    DIM keep(0 TO BL_MAX - 1) AS INTEGER
    lst = WS_get$(sec + ".ORDER", "")
    IF LEN(lst) THEN
        n = BL_from_csv%(panel, lst)
        WS_apply_bar_list% = TRUE
        EXIT FUNCTION
    END IF
    lst = WS_get$(sec + ".BUTTONS", "")
    IF LEN(lst) = 0 THEN EXIT FUNCTION
    BL_set_default panel
    n = BL_N(panel)
    FOR i = 0 TO n - 1
        IF BL(panel, i).kind = BL_CMD THEN
            nm = BL_entry_name$(BL_CMD, BL(panel, i).id)
            keep(i) = WS_list_has%(lst, nm, BL(panel, i).id)
        END IF
    NEXT i
    anyBefore = FALSE
    FOR i = 0 TO n - 1
        IF BL(panel, i).kind = BL_DIV THEN
            groupHas = FALSE
            FOR j = i + 1 TO n - 1
                IF BL(panel, j).kind = BL_DIV THEN EXIT FOR
                IF keep(j) THEN groupHas = TRUE
            NEXT j
            keep(i) = (anyBefore _ANDALSO groupHas)
        ELSEIF keep(i) THEN
            anyBefore = TRUE
        END IF
    NEXT i
    FOR i = n - 1 TO 0 STEP -1
        IF keep(i) = 0 THEN BL_remove panel, i
    NEXT i
    WS_apply_bar_list% = TRUE
END FUNCTION


SUB WS_apply_bars ()
    DIM lst AS STRING, i AS INTEGER, j AS INTEGER, groupHas AS INTEGER, anyBefore AS INTEGER
    WS_BARS_TOUCHED = FALSE

    IF WS_apply_bar_list%(BL_EDITBAR, "EDIT_BAR") THEN WS_BARS_TOUCHED = TRUE
    IF WS_apply_bar_list%(BL_ADVBAR, "ADVANCED_BAR") THEN WS_BARS_TOUCHED = TRUE

    IF VAL(WS_get$("EDIT_BAR.COLUMNS", "0")) > 0 THEN EDITBAR_NCOLS = VAL(WS_get$("EDIT_BAR.COLUMNS", "0")): WS_BARS_TOUCHED = TRUE
    IF VAL(WS_get$("ADVANCED_BAR.COLUMNS", "0")) > 0 THEN ADVBAR_NCOLS = VAL(WS_get$("ADVANCED_BAR.COLUMNS", "0")): WS_BARS_TOUCHED = TRUE

    lst = WS_get$("ORGANIZER.WIDGETS", "")
    IF LEN(lst) THEN
        FOR i = 0 TO ORG_WIDGET_COUNT - 1
            ORG_HIDDEN(i) = _NEGATE WS_list_has%(lst, WS_org_name$(i), -1)
        NEXT i
        WS_BARS_TOUCHED = TRUE
    END IF
    IF WS_BARS_TOUCHED THEN INVALIDATE_scene
END SUB



''
' [MENUS] ROOTS= (root menus to keep, by label) and HIDE_ITEMS= (action ids or
' labels to drop inside the kept menus). Applied by rebuilding the menu table;
' hidden things stay reachable through the command palette and their keys.
SUB WS_apply_menus ()
    DIM roots AS STRING, items AS STRING, i AS INTEGER, known AS INTEGER, it AS STRING
    WS_MENUS_TOUCHED = FALSE
    roots = UCASE$(WS_get$("MENUS.ROOTS", ""))
    items = WS_get$("MENUS.HIDE_ITEMS", "")
    ' a ROOTS list naming no real menu would leave an empty bar: ignore it
    IF LEN(roots) THEN
        FOR i = 1 TO WS_list_count%(roots)
            it = WS_list_item$(roots, i)
            SELECT CASE it
                CASE "FILE", "EDIT", "VIEW", "SELECT", "TOOLS", "BRUSH", "LAYER", "PALETTE", "IMAGE", "EFFECTS", "AI", "ANIM", "HELP", "AUDIO": known = TRUE
            END SELECT
        NEXT i
        IF known = 0 THEN
            _LOGWARN "WORKSPACE: [MENUS] ROOTS=" + roots + " names no menu - ignored (use [CHROME] MENUBAR=HIDE to hide the bar)"
            roots = ""
        END IF
    END IF
    IF LEN(roots) = 0 _ANDALSO LEN(items) = 0 THEN EXIT SUB
    MENU_FILTER_ROOTS$ = roots
    MENU_FILTER_ITEMS$ = items
    MENUBAR_rebuild
    WS_MENUS_TOUCHED = TRUE
END SUB



' =============================================================================
' [KEYS] - single-key overlay (key=tool name | action id). Lives in the
' dispatcher (INPUT_dispatch_frame -> WS_key_action%) ahead of the binding
' table; never fires while typing, in a dialog/menu/palette, with Ctrl/Alt,
' during a stroke or chord.
' =============================================================================

''
' A [KEYS] value -> action id: a number, a tool name (WS_tool_action%), 0 = bad.
FUNCTION WS_key_value_action% (v AS STRING)
    DIM t AS STRING
    t = LCASE$(_TRIM$(v))
    IF LEN(t) = 0 THEN EXIT FUNCTION
    IF VAL(t) > 0 THEN WS_key_value_action% = VAL(t): EXIT FUNCTION
    WS_key_value_action% = WS_tool_action%(t)
END FUNCTION


SUB WS_apply_keys ()
    DIM i AS INTEGER, k AS STRING, a AS INTEGER, m AS INTEGER, lk AS STRING
    WS_KEY_N = 0
    i = 0
    DO
        i = WS_next_in_section%("KEYS", i)
        IF i = 0 THEN EXIT DO
        k = WS_res_key_part$(i)
        ' ctrl+ / alt+ prefixes; named keys enter, space, tab
        m = 0
        DO
            lk = LCASE$(k)
            IF LEFT$(lk, 5) = "ctrl+" THEN
                m = m OR MOD_CTRL: k = MID$(k, 6)
            ELSEIF LEFT$(lk, 4) = "alt+" THEN
                m = m OR MOD_ALT: k = MID$(k, 5)
            ELSE
                EXIT DO
            END IF
        LOOP
        SELECT CASE LCASE$(k)
            CASE "enter", "return": k = CHR$(13)
            CASE "space": k = " "
            CASE "tab": k = CHR$(9)
        END SELECT
        IF m <> 0 _ANDALSO LEN(k) = 1 THEN k = LCASE$(k) ' ctrl+S = ctrl+s (Shift is separate)
        IF LEN(k) <> 1 THEN
            _LOGWARN "WORKSPACE: [KEYS] '" + WS_res_key_part$(i) + "' - use one key (a, R, 1), ctrl+key, alt+key, enter, space or tab"
            _CONTINUE
        END IF
        a = WS_key_value_action%(WS_RES_VAL(i))
        IF a = 0 THEN
            _LOGINFO "WORKSPACE: [KEYS] " + k + "=" + WS_RES_VAL(i) + " - no such tool/action (yet) - skipped"
            _CONTINUE
        END IF
        IF WS_KEY_N >= WS_MAX_KEYS THEN EXIT DO
        WS_KEY_N = WS_KEY_N + 1
        WS_KEY_CH(WS_KEY_N) = k
        WS_KEY_ACT(WS_KEY_N) = a
        WS_KEY_MODS(WS_KEY_N) = m
    LOOP
END SUB


SUB WS_keys_reset ()
    DIM i AS INTEGER
    WS_KEY_N = 0
    ' command palette hotkeys back (static entries keep their indices)
    FOR i = 0 TO WS_CMD_HK_N - 1
        IF i < CMD_COUNT THEN CMD_LIST(i).hotkey = WS_CMD_HK_SAVE(i)
    NEXT i
END SUB


''
' The workspace action for a key press, or 0 (let the binding table have it).
FUNCTION WS_key_action% (keycode AS LONG, mods AS INTEGER, ctx AS _UNSIGNED _INTEGER64)
    DIM ch AS STRING, i AS INTEGER, kc AS LONG, evMods AS INTEGER
    IF WS_KEY_N = 0 _ORELSE WS_ACTIVE = 0 THEN EXIT FUNCTION
    evMods = mods AND (MOD_CTRL OR MOD_ALT)
    IF (ctx AND (CTX_TEXT_ACTIVE OR CTX_FILE_DIALOG_OPEN OR CTX_SETTINGS_OPEN OR CTX_POPUP_MENU_OPEN OR CTX_COMMAND_PALETTE_OPEN OR CTX_TRANSFORM_ACTIVE OR CTX_DRAWING_IN_PROGRESS OR CTX_OVER_DIALOG)) <> 0 THEN EXIT FUNCTION
    IF (ctx AND (CTX_G_HELD OR CTX_M_HELD OR CTX_Z_HELD OR CTX_E_HELD OR CTX_F_HELD OR CTX_W_HELD OR CTX_SPACE_HELD OR CTX_SS_DRAGGING)) <> 0 THEN EXIT FUNCTION
    IF MENU_BAR.openMenu% >= 0 THEN EXIT FUNCTION
    IF MOUSE.B1% _ORELSE MOUSE.B2% THEN EXIT FUNCTION ' never switch tools mid-stroke
    kc = keycode
    IF kc = 10 THEN kc = 13 ' Ctrl+Enter can arrive as LF
    IF kc <> 13 _ANDALSO kc <> 9 _ANDALSO (kc < 32 _ORELSE kc > 126) THEN EXIT FUNCTION
    ' letters: case comes from Shift (events may carry either case code)
    IF kc >= 65 _ANDALSO kc <= 90 THEN kc = kc + 32
    ch = CHR$(kc)
    IF kc >= 97 _ANDALSO kc <= 122 _ANDALSO (mods AND MOD_SHIFT) <> 0 THEN ch = UCASE$(ch)
    FOR i = 1 TO WS_KEY_N
        IF WS_KEY_CH(i) = ch _ANDALSO WS_KEY_MODS(i) = evMods THEN WS_key_action% = WS_KEY_ACT(i): EXIT FUNCTION
    NEXT i
END FUNCTION


''
' TRUE when the workspace maps this letter (either case): its held-chord
' context (M/Z/E/F/W held) is then not raised, so the key is just the key.
FUNCTION WS_key_mapped% (lowerAscii AS INTEGER)
    DIM i AS INTEGER
    IF WS_KEY_N = 0 _ORELSE WS_ACTIVE = 0 THEN EXIT FUNCTION
    FOR i = 1 TO WS_KEY_N
        IF WS_KEY_MODS(i) = 0 _ANDALSO LCASE$(WS_KEY_CH(i)) = CHR$(lowerAscii) THEN WS_key_mapped% = TRUE: EXIT FUNCTION
    NEXT i
END FUNCTION


''
' Hotkey label for a workspace key, as menus show them ("R", "Shift+R").
FUNCTION WS_key_label$ (k AS STRING)
    DIM lbl AS STRING
    IF k >= "A" _ANDALSO k <= "Z" THEN
        lbl = "Shift+" + k
    ELSEIF k = CHR$(13) THEN
        lbl = "Enter"
    ELSEIF k = " " THEN
        lbl = "Space"
    ELSEIF k = CHR$(9) THEN
        lbl = "Tab"
    ELSE
        lbl = UCASE$(k)
    END IF
    WS_key_label$ = lbl
END FUNCTION


''
' Label for workspace key i, with its Ctrl/Alt ("Ctrl+S").
FUNCTION WS_key_full_label$ (i AS INTEGER)
    DIM p AS STRING
    IF WS_KEY_MODS(i) AND MOD_CTRL THEN p = p + "Ctrl+"
    IF WS_KEY_MODS(i) AND MOD_ALT THEN p = p + "Alt+"
    WS_key_full_label$ = p + WS_key_label$(WS_KEY_CH(i))
END FUNCTION


''
' New hotkey text for an entry that shows <hk> for action <act> while the
' key overlay is on: its workspace key, "" when its old key now does
' something else, or unchanged.
FUNCTION WS_relabel$ (hk AS STRING, act AS INTEGER)
    DIM i AS INTEGER, t AS STRING
    t = _TRIM$(hk)
    FOR i = 1 TO WS_KEY_N
        IF WS_KEY_ACT(i) = act THEN WS_relabel$ = WS_key_full_label$(i): EXIT FUNCTION
    NEXT i
    FOR i = 1 TO WS_KEY_N
        IF UCASE$(t) = UCASE$(WS_key_full_label$(i)) THEN WS_relabel$ = "": EXIT FUNCTION
    NEXT i
    WS_relabel$ = hk
END FUNCTION


''
' Menus + command palette show the workspace's keys (MENUBAR_rebuild calls
' this too, so a rebuild keeps them).
SUB WS_relabel_hotkeys ()
    DIM i AS INTEGER
    IF WS_KEY_N = 0 _ORELSE WS_ACTIVE = 0 THEN EXIT SUB
    IF WS_CMD_HK_N = 0 THEN
        WS_CMD_HK_N = _MIN(CMD_COUNT, UBOUND(WS_CMD_HK_SAVE) + 1)
        FOR i = 0 TO WS_CMD_HK_N - 1
            WS_CMD_HK_SAVE(i) = CMD_LIST(i).hotkey
        NEXT i
    END IF
    FOR i = 0 TO WS_CMD_HK_N - 1
        CMD_LIST(i).hotkey = WS_relabel$(RTRIM$(WS_CMD_HK_SAVE(i)), CMD_LIST(i).action_id)
    NEXT i
    WS_menu_hotkeys_apply
END SUB


SUB WS_menu_hotkeys_apply ()
    DIM i AS INTEGER
    IF WS_KEY_N = 0 _ORELSE WS_ACTIVE = 0 THEN EXIT SUB
    FOR i = 0 TO MENU_ITEM_COUNT% - 1
        IF MENU_ITEMS(i).actionId% > 0 THEN MENU_ITEMS(i).hotkey = WS_relabel$(RTRIM$(MENU_ITEMS(i).hotkey), MENU_ITEMS(i).actionId%)
    NEXT i
END SUB



''
' Called from INPUT's key edge detection: the binding table only watches keys
' that have bindings, so a workspace key without one (Enter for Ctrl+Enter)
' would never produce an event. Same guards and one-event-per-key-per-frame
' rule as the table loop.
SUB WS_detect_keys ()
    DIM i AS INTEGER, kc AS LONG, down AS INTEGER
    FOR i = 1 TO WS_KEY_N
        kc = ASC(LCASE$(WS_KEY_CH(i)))
        down = (_KEYDOWN(kc) <> 0)
        IF kc >= 97 _ANDALSO kc <= 122 THEN
            IF _KEYDOWN(kc - 32) THEN down = TRUE
        END IF
        IF down _ANDALSO WS_KEY_DOWN_LAST(i) = 0 _ANDALSO CMD_PALETTE.visible% = 0 _ANDALSO KEYBOARD_SUPPRESS_FRAMES% <= 0 THEN
            IF INPUT_KC_ENQUEUED(kc) <> INPUT_KC_FRAME THEN
                INPUT_enqueue_event EVT_KEY_PRESS, REGION_GLOBAL, kc, 0, 0, MOUSE.RAW_X%, MOUSE.RAW_Y%, MOUSE.X%, MOUSE.Y%, 0.0, 0.0, DEVICE_KEYBOARD, 0
                INPUT_KC_ENQUEUED(kc) = INPUT_KC_FRAME
            END IF
        END IF
        WS_KEY_DOWN_LAST(i) = down
    NEXT i
END SUB


''
' [DOCK] / [FLOAT]: the workspace's own arrangement replaces yours for its
' duration. A workspace without [DOCK] that moves panels between sides
' (*_DOCK keys) gets the classic default tree over a custom one, so its sides
' apply. Either way WS_restore puts your arrangement back.
SUB WS_apply_dock ()
    DIM snap AS STRING, i AS INTEGER, k AS STRING, dk AS INTEGER, anySide AS INTEGER
    i = 0
    DO
        i = WS_next_in_section%("DOCK", i)
        IF i = 0 THEN EXIT DO
        snap = snap + WS_res_key_part$(i) + "=" + WS_RES_VAL(i) + CHR$(10)
    LOOP
    i = 0
    DO
        i = WS_next_in_section%("FLOAT", i)
        IF i = 0 THEN EXIT DO
        snap = snap + "FLOAT." + LCASE$(WS_res_key_part$(i)) + "=" + WS_RES_VAL(i) + CHR$(10)
    LOOP
    ' the user's arrangement always comes back on leaving: a panel moved here
    ' belongs to the workspace
    ' (a tree not built yet snapshots as CUSTOM=0: rebuilt from the keys)
    WS_DOCK_USER_SNAP = DOCK_snapshot$
    WS_DOCK_TOUCHED = TRUE
    IF LEN(snap) THEN
        DOCK_load_snapshot "CUSTOM=1" + CHR$(10) + snap
        IF LEN(DOCK_PARSE_NOTE) THEN _LOGWARN "WORKSPACE: [DOCK] skipped" + DOCK_PARSE_NOTE
        EXIT SUB
    END IF
    FOR dk = 1 TO WS_DK_COUNT
        IF WS_DK_NAMED(dk) THEN anySide = TRUE
    NEXT dk
    IF anySide _ANDALSO DOCK_CUSTOM THEN
        DOCK_CUSTOM = FALSE
        DOCK_READY = FALSE
    END IF
END SUB


' =============================================================================
' Panel state in a workspace (2026-11-14): scales, zooms, sizes, places and
' each panel's own settings. While a workspace is active every key below is
' in the overlay (WS_OPT_* with WS_OK_PANEL / WS_OK_WINLIVE): DRAW.cfg keeps
' the user's own values (the guard), leaving puts them back, and a change made
' in the workspace is saved into it ([PANELS] / [WINDOWS]) by WS_panels_poll.
' Save Current Layout writes them all (WSC_capture_layout), so a saved
' workspace comes back exactly as it was.
' =============================================================================

''
' Every panel's own DRAW.cfg keys a workspace keeps: scales, zooms, columns,
' views and the settings in each panel's menu. Not here: visibility ([CHROME]),
' dock sides / columns / the layers width ([CHROME] / [TOOLBOX] / bars), the
' floating windows' places (WS_window_keys$) and folders / paths of files.
FUNCTION WS_panel_keys$ ()
    DIM s AS STRING
    s = "TOOLBOX_PANEL_SCALE,ORGANIZER_PANEL_SCALE,DRAWER_PANEL_SCALE,DRAWER_BIN_COLS,DRAWER_ROW_BIN_ROWS,DRAWER_MINI_PALETTE"
    s = s + ",LAYER_PANEL_SCALE,LAYER_PANEL_BAR,LAYER_THUMBNAILS,LAYER_THUMBNAIL_FIT,LAYER_THUMBNAIL_MIN_CROP"
    s = s + ",EDIT_BAR_SCALE,ADV_BAR_SCALE,CHARMAP_PANEL_SCALE,CHARMAP_ZOOM_LEVEL,CHARMAP_CELLS_PER_ROW"
    s = s + ",WORKFLOW_PANEL_SCALE,TEXT_BAR_SCALE,WORKFLOW_BAR,LAYOUT_LOCKED"
    s = s + ",PALETTE_MAX_ROWS,PALETTE_MAX_CHIPS_PER_ROW,PALETTE_CHIP_HEIGHT,PALETTE_CHIP_WIDTH,PALETTE_STRIP_EDGE"
    s = s + ",PREVIEW_SCALE,PREVIEW_ZOOM,PREVIEW_FOLLOW,PREVIEW_MODE,PREVIEW_COLOR_PICK,PREVIEW_BIN_QUICK_LOOK,PREVIEW_SHOWS_FRAME,PREVIEW_FLOAT_IMAGE_PATH"
    s = s + ",COLOR_MIXER_SCALE,COLOR_MIXER_MORE"
    s = s + ",ADV_COLOR_PICKER_SCALE,ADV_COLOR_PICKER_BG_COLOR,ADV_COLOR_PICKER_BG_CUSTOM,ADV_COLOR_PICKER_HISTORY,ADV_COLOR_PICKER_HUE_NEIGHBORS"
    s = s + ",ADV_COLOR_PICKER_QUANTIZE,ADV_COLOR_PICKER_QUANTIZE_BAR,ADV_COLOR_PICKER_RING,ADV_COLOR_PICKER_SHADE_CURVE,ADV_COLOR_PICKER_SHADE_LABELS"
    s = s + ",ADV_COLOR_PICKER_SHADE_PATCHES,ADV_COLOR_PICKER_SHADE_PRESET,ADV_COLOR_PICKER_SHADE_SPREAD_H,ADV_COLOR_PICKER_SHADE_SPREAD_S"
    s = s + ",ADV_COLOR_PICKER_SHADE_SPREAD_V,ADV_COLOR_PICKER_VARIATIONS,ADV_COLOR_PICKER_WARMCOOL"
    s = s + ",COLOR_SPACE_3D_SCALE,COLOR_SPACE_3D_SPACE,COLOR_SPACE_3D_VIEW,COLOR_SPACE_3D_SLICE,COLOR_SPACE_3D_SLICE_ON"
    s = s + ",COLOR_SPACE_3D_YAW,COLOR_SPACE_3D_PITCH,COLOR_SPACE_3D_ZOOM,PEN_PANEL_SCALE,ANIM_PANEL_SCALE"
    s = s + ",SWATCHES_SCALE,SWATCHES_SET,SWATCHES_COLS,SWATCHES_VIEW,SWATCHES_CELL,SWATCHES_GAP,SWATCHES_BORDER"
    s = s + ",SWATCHES_SQUARE,SWATCHES_STRETCH,SWATCHES_BLACK_SPACERS,SWATCHES_RECENT"
    s = s + ",BROWSER_SCALE,BROWSER_DEFAULT_VIEW_MODE,BROWSER_DEFAULT_ZOOM_LEVEL,BROWSER_DEFAULT_SORT_TYPE,BROWSER_DEFAULT_SORT_ORDER,BROWSER_DEFAULT_PREVIEW_OPEN"
    s = s + ",XSHEET,XSHEET_SIZE,XSHEET_ROWS,XSHEET_ZOOM,XSHEET_FIT_ALL,XSHEET_NAME_WIDTH,XSHEET_LANE_THUMBS"
    s = s + ",LIGHTBOX_STRIP_SIZE,LIGHTBOX_STRIP_CELL,LIGHTBOX_STRIP_FLOW,LIGHTBOX_STRIP_MIN_CELL,LIGHTBOX_PANES,LIGHTBOX"
    s = s + ",PREVIEW_PAN_X,PREVIEW_PAN_Y,PALETTE_MIN_ROWS,PALETTE_CHIPS_ROW_THRESHOLD"
    s = s + ",SWATCHES_LIVE_EDIT,SWATCHES_OVERWRITE,WORKFLOW_BUTTONS,SNAP_PANEL_EDGES"
    s = s + ",PEN_PRESSURE,PEN_PRESSURE_SIZE,PEN_MIN_SIZE,PEN_PRESSURE_CURVE,PEN_PRESSURE_MIX,PEN_MIX_MIN,PEN_PRESSURE_OPACITY,PEN_MIN_OPACITY,PEN_TIP_THRESHOLD"
    s = s + ",PEN_STAB,PEN_STAB_MODE,PEN_STAB_AMOUNT,PEN_STAB_CATCHUP,PEN_STAB_GUIDE_LINE,PEN_STAB_GUIDE_CURSOR,PEN_STAB_GUIDE_COLOR"
    s = s + ",PEN_PROC,PEN_PROC_MODE,PEN_PROC_AMOUNT,PEN_SPEED,PEN_SPEED_SLOW,PEN_SPEED_FAST,PEN_SPEED_FAST_AT,PEN_SPEED_SMOOTH,PEN_PANEL_TAB"
    s = s + ",BROWSER_SHOW_HIDDEN,BROWSER_PLACES_MIN_W,BROWSER_PREVIEW_MIN_W"
    WS_panel_keys$ = s
END FUNCTION


''
' The floating native windows' places and sizes ([WINDOWS], DOCK_native_cfg_lines$).
FUNCTION WS_window_keys$ ()
    DIM s AS STRING
    s = "PREVIEW_X,PREVIEW_Y,PREVIEW_W,PREVIEW_H,COLOR_MIXER_X,COLOR_MIXER_Y,ADV_COLOR_PICKER_X,ADV_COLOR_PICKER_Y"
    s = s + ",COLOR_SPACE_3D_X,COLOR_SPACE_3D_Y,PEN_PANEL_X,PEN_PANEL_Y,ANIM_PANEL_X,ANIM_PANEL_Y"
    s = s + ",SWATCHES_X,SWATCHES_Y,SWATCHES_W,SWATCHES_H,BROWSER_POS_X,BROWSER_POS_Y,BROWSER_WIDTH,BROWSER_HEIGHT"
    WS_window_keys$ = s
END FUNCTION


''
' A [WINDOWS] key of a window that is docked now: its place is the dock's
' ([DOCK]), and the floating place the cfg holds then is whatever the dock
' last wrote there - not kept.
FUNCTION WS_window_key_docked% (k AS STRING)
    DIM id AS INTEGER
    IF LEFT$(k, 8) = "PREVIEW_" THEN id = DP_PREVIEW
    IF LEFT$(k, 12) = "COLOR_MIXER_" THEN id = DP_MIXER
    IF LEFT$(k, 17) = "ADV_COLOR_PICKER_" THEN id = DP_ADVCP
    IF LEFT$(k, 15) = "COLOR_SPACE_3D_" THEN id = DP_CS3D
    IF LEFT$(k, 10) = "PEN_PANEL_" THEN id = DP_PEN
    IF LEFT$(k, 11) = "ANIM_PANEL_" THEN id = DP_ANIM
    IF LEFT$(k, 9) = "SWATCHES_" THEN id = DP_SWATCH
    IF LEFT$(k, 8) = "BROWSER_" THEN id = DP_BROWSER
    IF id = 0 THEN EXIT FUNCTION
    IF DPANEL(id).slot <> 0 THEN WS_window_key_docked% = TRUE
END FUNCTION


FUNCTION WS_opt_find% (k AS STRING)
    DIM i AS INTEGER
    FOR i = 1 TO WS_OPT_N
        IF WS_OPT_KEY(i) = k THEN WS_opt_find% = i: EXIT FUNCTION
    NEXT i
END FUNCTION


''
' WS_apply%: put every panel / window key the workspace's [OPTIONS] /
' [WINDOWS] did not name into the overlay - its [PANELS] value, or "" (the
' live value, filled in once the originals are read).
SUB WS_panels_add ()
    DIM lst AS STRING, n AS INTEGER, k AS STRING, pass AS INTEGER, j AS INTEGER
    FOR pass = 1 TO 2
        IF pass = 1 THEN lst = WS_panel_keys$ ELSE lst = WS_window_keys$
        FOR n = 1 TO WS_list_count%(lst)
            k = WS_list_item$(lst, n)
            IF WS_opt_find%(k) = 0 _ANDALSO WS_OPT_N < WS_MAX_OPTS THEN
                WS_OPT_N = WS_OPT_N + 1
                j = WS_OPT_N
                WS_OPT_KEY(j) = k
                IF pass = 1 THEN
                    WS_OPT_VAL(j) = WS_get$("PANELS." + k, "")
                    WS_OPT_KIND(j) = WS_OK_PANEL
                ELSE
                    WS_OPT_VAL(j) = ""
                    WS_OPT_KIND(j) = WS_OK_WINLIVE
                END IF
                WS_OPT_ORIG(j) = ""
                WS_OPT_HAD(j) = FALSE
                WS_OPT_SEEN(j) = ""
            END IF
        NEXT n
    NEXT pass
    WS_PANELS_ON = TRUE
END SUB


''
' Panel state that lives in the panels, not in CFG, until DRAW exits
' (MAIN_shutdown copies it): copy it into CFG now.
SUB WS_panels_pull ()
    DIM z AS INTEGER
    IF PREVIEW.zoom! > 0 THEN CFG.PREVIEW_ZOOM! = PREVIEW.zoom!
    CFG.PREVIEW_FOLLOW% = PREVIEW.followPointer%
    IF BROWSER.initialized% THEN
        CFG.BROWSER_DEFAULT_VIEW_MODE% = FD_CFG.viewMode
        z = FD_CFG.thumbSize \ 32
        IF z < 1 THEN z = 1
        IF z > 8 THEN z = 8
        CFG.BROWSER_DEFAULT_ZOOM_LEVEL% = z
        CFG.BROWSER_DEFAULT_SORT_TYPE% = FD_CFG.sortField
        IF FD_CFG.sortAscending THEN CFG.BROWSER_DEFAULT_SORT_ORDER% = 0 ELSE CFG.BROWSER_DEFAULT_SORT_ORDER% = 1
        IF FD_CFG.showPreview THEN CFG.BROWSER_DEFAULT_PREVIEW_OPEN% = TRUE ELSE CFG.BROWSER_DEFAULT_PREVIEW_OPEN% = FALSE
    ELSEIF BROWSER.settingsLoaded% THEN
        CFG.BROWSER_DEFAULT_VIEW_MODE% = BROWSER.viewMode%
        CFG.BROWSER_DEFAULT_ZOOM_LEVEL% = BROWSER.zoomLevel%
        CFG.BROWSER_DEFAULT_SORT_TYPE% = BROWSER.sortType%
        CFG.BROWSER_DEFAULT_SORT_ORDER% = BROWSER.sortOrder%
        CFG.BROWSER_DEFAULT_PREVIEW_OPEN% = BROWSER.previewOpen%
    END IF
END SUB


''
' After a workspace's (or the user's own) panel values went into CFG: the
' panels take them now - their scales, zooms and settings - and relayout.
SUB WS_panels_push ()
    DIM pvMode AS INTEGER, pvFollow AS INTEGER, pvZoom AS SINGLE, pvPath AS STRING, img AS LONG
    DIM oldThumb AS INTEGER, ti AS INTEGER

    SCALE_resolve_widgets SCRN.displayScale% ' the Preview's / Browser's own scales

    ' Preview: mode (and its reference image), follow, zoom, quick look, picking
    pvMode = CFG.PREVIEW_MODE%: pvFollow = CFG.PREVIEW_FOLLOW%: pvZoom = CFG.PREVIEW_ZOOM!: pvPath = CFG.PREVIEW_FLOAT_IMAGE_PATH$
    IF pvMode = PREVIEW_MODE_FLOAT THEN
        IF LEN(pvPath) _ANDALSO pvPath <> PREVIEW.floatImagePath$ _ANDALSO _FILEEXISTS(pvPath) THEN
            img = _LOADIMAGE(pvPath, 32)
            IF img < -1 THEN
                IF PREVIEW.floatImage& < -1 THEN _FREEIMAGE PREVIEW.floatImage&
                PREVIEW.floatImage& = img
                PREVIEW.floatImageW% = _WIDTH(img): PREVIEW.floatImageH% = _HEIGHT(img)
                PREVIEW.floatImagePath$ = pvPath
                PREVIEW.floatImageDepth% = 32
            END IF
        END IF
        IF PREVIEW.mode% <> PREVIEW_MODE_FLOAT THEN PREVIEW_set_floating_mode
    ELSE
        IF PREVIEW.mode% <> PREVIEW_MODE_FOLLOW THEN PREVIEW_set_follow_mode
    END IF
    CFG.PREVIEW_MODE% = pvMode: CFG.PREVIEW_FOLLOW% = pvFollow: CFG.PREVIEW_ZOOM! = pvZoom: CFG.PREVIEW_FLOAT_IMAGE_PATH$ = pvPath
    PREVIEW.followPointer% = pvFollow
    IF pvZoom > 0 THEN PREVIEW.zoom! = pvZoom
    PREVIEW.panX! = CFG.PREVIEW_PAN_X!: PREVIEW.panY! = CFG.PREVIEW_PAN_Y!
    PREVIEW.colorPickEnabled% = CFG.PREVIEW_COLOR_PICK%
    PREVIEW.binQuickLookEnabled% = CFG.PREVIEW_BIN_QUICK_LOOK%

    ' Color Mixer (MORE), Advanced Color Picker (shade line-set; the rest is read each render)
    IF COLORMIXER.initialized% THEN COLORMIXER_relayout
    IF ADVCP.initialized% THEN ADVCP_apply_shade_config

    ' 3D Color Space: space, view, slice, rotation, zoom
    IF CS3D.initialized% THEN
        IF C3D_STATE.spaceId <> CFG.COLOR_SPACE_3D_SPACE% THEN C3D_set_space CFG.COLOR_SPACE_3D_SPACE%
        IF C3D_STATE.viewMode <> CFG.COLOR_SPACE_3D_VIEW% THEN C3D_set_view CFG.COLOR_SPACE_3D_VIEW%
        C3D_set_slice CFG.COLOR_SPACE_3D_SLICE_ON%, CFG.COLOR_SPACE_3D_SLICE% / 100!
        C3D_set_rotation CFG.COLOR_SPACE_3D_YAW%, CFG.COLOR_SPACE_3D_PITCH%, CFG.COLOR_SPACE_3D_ZOOM% / 100!
    END IF

    ' Swatches: the set shown, its gap (the rest is read as it lays out)
    IF SWP.initialized THEN
        IF SWP.setKey <> CFG.SWATCHES_SET THEN SWP_load_set CFG.SWATCHES_SET
        SWP.gap = CFG.SWATCHES_GAP%
        SWP_relayout
        SWP_compute_display_size
    END IF

    ' Character map: cells per row
    IF CFG.CHARMAP_CELLS_PER_ROW% >= CHARMAP_MIN_CELLS_PER_ROW _ANDALSO CFG.CHARMAP_CELLS_PER_ROW% <= CHARMAP_MAX_CELLS_PER_ROW THEN CHARMAP.cellsPerRow% = CFG.CHARMAP_CELLS_PER_ROW%

    ' Browser: view, thumbnail zoom, sort, preview pane
    oldThumb = FD_CFG.thumbSize
    BROWSER_apply_defaults
    IF BROWSER.initialized% _ANDALSO FD_CFG.thumbSize <> oldThumb THEN
        FD_THUMB_invalidate_all
        FOR ti = 0 TO FD_STATE.entryCount - 1
            IF FD_entries(ti).thumbState = FD_THUMB_LOADED _ORELSE FD_entries(ti).thumbState = FD_THUMB_LOADING THEN
                FD_entries(ti).thumbHandle = -1
                FD_entries(ti).thumbState = FD_THUMB_PENDING
            END IF
        NEXT ti
        FD_FS_recalc_scroll
        IF FD_STATE.scrollOffset > FD_STATE.maxScroll THEN FD_STATE.scrollOffset = FD_STATE.maxScroll
    END IF

    ' everything else (scales, bin zoom, X-sheet, lightbox, colour strip,
    ' layer thumbnails, the workflow panel's buttons (WF_sync), pen pressure)
    ' is read from CFG as it lays out
    PALETTE_STRIP_Y% = SCRN.h& - THEME.STATUS_height% - PALETTE_STRIP_get_height%
    SCENE_DIRTY% = TRUE
    SCREEN_compute_layout
    FPANEL_clamp_all
    IF BROWSER.initialized% _ANDALSO BROWSER.docked% = 0 THEN
        BROWSER_compute_display_size
        BROWSER_clamp_size
        BROWSER_clamp_to_work_area
        BROWSER_sync_fd_from_display
    END IF
    GUI_NEEDS_REDRAW% = TRUE
    STATUS_NEEDS_REDRAW% = TRUE
    FRAME_IDLE% = FALSE
    INVALIDATE_scene
END SUB


''
' Every frame (WS_tick): a click / drag that ended, or a CONFIG_save, may
' have changed a panel - look a few frames later, with no button held.
SUB WS_panels_tick ()
    STATIC oldB AS INTEGER, oldSW AS INTEGER
    DIM b AS INTEGER
    IF WS_ACTIVE = 0 _ORELSE WS_PANELS_ON = 0 THEN EXIT SUB
    b = ABS(MOUSE.B1 <> 0) + 2 * ABS(MOUSE.B2 <> 0) + 4 * ABS(MOUSE.B3 <> 0)
    IF b = 0 _ANDALSO oldB <> 0 THEN WS_POLL_WANT = TRUE
    IF MOUSE.SW <> 0 _ORELSE oldSW <> 0 THEN WS_POLL_WANT = TRUE ' a wheel turn (a zoom)
    oldB = b: oldSW = MOUSE.SW
    IF WS_POLL_FRAME < 32000 THEN WS_POLL_FRAME = WS_POLL_FRAME + 1
    IF WS_POLL_WANT = 0 _ORELSE b <> 0 THEN EXIT SUB
    IF WS_POLL_FRAME < 6 THEN EXIT SUB
    WS_panels_poll FALSE
END SUB


''
' Remember: the whole live layout (WS_layout_state$ - every panel's presence,
' dock side, the arrangement, columns, widths, window places and every panel
' setting) compared with what was last seen; any difference saves the whole
' layout into the active workspace (a built-in gets a user copy, as a dragged
' dock edge does). force: look even if nothing asked. The first look after an
' apply only records (WS_POLL_BASE).
SUB WS_panels_poll (force AS INTEGER)
    DIM st AS STRING
    IF WS_ACTIVE = 0 _ORELSE WS_PANELS_ON = 0 _ORELSE WS_GUARD_ON THEN EXIT SUB
    IF force = 0 _ANDALSO WS_POLL_WANT = 0 THEN EXIT SUB
    WS_POLL_WANT = FALSE
    WS_POLL_FRAME = 0
    st = WS_layout_state$
    IF WS_POLL_BASE THEN
        WS_STATE_SEEN = st
        WS_POLL_BASE = FALSE
        EXIT SUB
    END IF
    IF st = WS_STATE_SEEN THEN EXIT SUB
    WS_STATE_SEEN = st
    WS_remember_save
END SUB


''
' Write the whole live layout into the active workspace's file (its buttons,
' menus, keys, options and [START] stay as they are). The configurator's
' editor store is kept as it was (the save borrows it).
SUB WS_remember_save ()
    DIM idx AS INTEGER, ok AS INTEGER, i AS INTEGER, el AS INTEGER, sN AS INTEGER, sId AS STRING, sSel AS INTEGER, sDirty AS INTEGER, sRe AS INTEGER
    DIM sK(1 TO WSC_MAX_KV) AS STRING, sV(1 TO WSC_MAX_KV) AS STRING
    idx = WS_find%(WS_ACTIVE_ID)
    IF idx = 0 _ORELSE WS_is_default%(WS_ACTIVE_ID) THEN EXIT SUB
    sN = WSC_N: sId = WSC_ID: sSel = WSC.sel: sDirty = WSC.dirty: sRe = WSC.reapply
    FOR i = 1 TO sN: sK(i) = WSC_K(i): sV(i) = WSC_V(i): NEXT i
    WSC_load idx
    WSC_capture_layout
    ok = WSC_save%
    ok = WS_resolve%(WS_ACTIVE_ID)
    WSC_N = sN: WSC_ID = sId: WSC.sel = sSel: WSC.dirty = sDirty: WSC.reapply = sRe
    FOR i = 1 TO sN: WSC_K(i) = sK(i): WSC_V(i) = sV(i): NEXT i
    ' what the workspace shows is what it wants now (Shift+F11 reveals against it)
    FOR el = 1 TO WS_EL_COUNT
        WS_EL_WANT(el) = WS_el_vis_kept%(el)
        WS_EL_NAMED(el) = TRUE
    NEXT el
    WS_POLL_SAVES = WS_POLL_SAVES + 1
    _LOGINFO "WORKSPACE: layout remembered in '" + WS_ACTIVE_ID + "'"
END SUB


''
' The element's visibility as the workspace keeps it: what F11 hid counts as
' it was, and what Shift+F11 revealed as the workspace hides it.
FUNCTION WS_el_vis_kept% (el AS INTEGER)
    IF UIALL_HIDDEN _ANDALSO UIALL_el_on%(el) THEN WS_el_vis_kept% = (UIALL_VIS(el) <> 0): EXIT FUNCTION
    IF WS_ACTIVE _ANDALSO WS_REVEALED _ANDALSO WS_EL_TOUCHED(el) _ANDALSO WS_EL_WANT(el) = 0 THEN EXIT FUNCTION
    WS_el_vis_kept% = (WS_el_get%(el) <> 0)
END FUNCTION


''
' WS_DK_* -> the dock panel it moves.
FUNCTION WS_dk_panel% (dk AS INTEGER)
    SELECT CASE dk
        CASE WS_DK_TOOLBOX:      WS_dk_panel% = DP_TOOLBOX
        CASE WS_DK_LAYER_PANEL:  WS_dk_panel% = DP_LAYERS
        CASE WS_DK_EDIT_BAR:     WS_dk_panel% = DP_EDITBAR
        CASE WS_DK_ADVANCED_BAR: WS_dk_panel% = DP_ADVBAR
        CASE WS_DK_CHARMAP:      WS_dk_panel% = DP_CHARMAP
    END SELECT
END FUNCTION


''
' The side a dock element is really on (the arranged tree, else its key).
FUNCTION WS_dk_side_now$ (dk AS INTEGER)
    IF DOCK_side_now%(WS_dk_panel%(dk)) = DOCK_RIGHT THEN WS_dk_side_now$ = "RIGHT" ELSE WS_dk_side_now$ = "LEFT"
END FUNCTION


''
' After a workspace's [DOCK] tree went in: each docked panel's side key says
' the side the tree put it on (the toolbox's flyouts, View > Layout and a
' later stock tree read the keys). The guard keeps them out of DRAW.cfg.
SUB WS_dock_keys_from_tree ()
    DIM dk AS INTEGER, sd AS INTEGER
    IF DOCK_CUSTOM = 0 _ORELSE DOCK_READY = 0 THEN EXIT SUB
    FOR dk = 1 TO WS_DK_COUNT
        sd = DOCK_panel_side%(WS_dk_panel%(dk))
        IF sd = DOCK_LEFT _ORELSE sd = DOCK_RIGHT THEN DOCK_key_set WS_dk_panel%(dk), sd
    NEXT dk
END SUB


''
' The whole live layout as a workspace would store it (Save Current Layout):
' "SECTION.KEY=value" lines, LF-separated. The editor store is borrowed and
' put back.
FUNCTION WS_layout_state$ ()
    DIM i AS INTEGER, r AS STRING, sN AS INTEGER, sId AS STRING
    DIM sK(1 TO WSC_MAX_KV) AS STRING, sV(1 TO WSC_MAX_KV) AS STRING
    sN = WSC_N: sId = WSC_ID
    FOR i = 1 TO sN: sK(i) = WSC_K(i): sV(i) = WSC_V(i): NEXT i
    WSC_N = 0
    WSC_capture_layout
    FOR i = 1 TO WSC_N
        IF LEN(WSC_V(i)) THEN r = r + WSC_K(i) + "=" + WSC_V(i) + CHR$(10)
    NEXT i
    WSC_N = sN: WSC_ID = sId
    FOR i = 1 TO sN: WSC_K(i) = sK(i): WSC_V(i) = sV(i): NEXT i
    WS_layout_state$ = r
END FUNCTION


''
' QA (DOCK_DUMP=): a request file <dump>.wsreq asks for the live layout in
' <dump>.ws (WS_layout_state$, then "WSA <active id>").
SUB WS_state_dump_check ()
    DIM fh AS INTEGER, req AS STRING, outF AS STRING
    IF LEN(DOCK_DUMP_PATH) = 0 THEN EXIT SUB
    req = DOCK_DUMP_PATH + ".wsreq"
    IF _FILEEXISTS(req) = 0 THEN EXIT SUB
    KILL req
    outF = DOCK_DUMP_PATH + ".ws"
    fh = FREEFILE
    OPEN outF + ".tmp" FOR OUTPUT AS #fh
    PRINT #fh, WS_layout_state$;
    PRINT #fh, "WSA=" + _IIF(WS_ACTIVE <> 0, WS_ACTIVE_ID, "default")
    CLOSE #fh
    IF _FILEEXISTS(outF) THEN KILL outF
    NAME outF + ".tmp" AS outF
END SUB


''
' Save Current Layout: every panel key as it is live, as [PANELS].
SUB WSC_capture_panels ()
    DIM i AS INTEGER, lst AS STRING, wlst AS STRING, n AS INTEGER, k AS STRING, wl AS STRING
    DIM realPath AS STRING, tmpPath AS STRING, fh AS INTEGER, ln AS STRING, eq AS INTEGER
    FOR i = WSC_N TO 1 STEP -1
        IF LEFT$(WSC_K(i), 7) = "PANELS." _ORELSE LEFT$(WSC_K(i), 8) = "WINDOWS." THEN WSC_set WSC_K(i), ""
    NEXT i
    WS_panels_pull
    lst = "," + WS_panel_keys$ + ","
    wlst = "," + WS_window_keys$ + ","
    realPath = CONFIG_FILE_PATH$
    tmpPath = PATHS_cache$("workspace-cfg-capture.tmp")
    CONFIG_FILE_PATH$ = tmpPath
    WS_GUARD_BYPASS = TRUE
    CONFIG_save
    WS_GUARD_BYPASS = FALSE
    CONFIG_FILE_PATH$ = realPath
    IF _FILEEXISTS(tmpPath) = 0 THEN EXIT SUB
    fh = FREEFILE
    OPEN tmpPath FOR INPUT AS #fh
    DO WHILE NOT EOF(fh)
        LINE INPUT #fh, ln
        eq = INSTR(ln, "=")
        IF eq < 2 THEN _CONTINUE
        k = UCASE$(_TRIM$(LEFT$(ln, eq - 1)))
        IF INSTR(lst, "," + k + ",") THEN WSC_set "PANELS." + k, _TRIM$(MID$(ln, eq + 1))
        IF INSTR(wlst, "," + k + ",") _ANDALSO WS_window_key_docked%(k) = 0 THEN WSC_set "WINDOWS." + k, _TRIM$(MID$(ln, eq + 1))
    LOOP
    CLOSE #fh
    KILL tmpPath
    ' the windows on screen now: their live places
    wl = DOCK_native_cfg_lines$
    n = DOCK_fields%(wl, CHR$(10))
    FOR i = 1 TO n
        ln = DOCK_field$(wl, CHR$(10), i)
        eq = INSTR(ln, "=")
        IF eq > 1 THEN WSC_set "WINDOWS." + UCASE$(LEFT$(ln, eq - 1)), MID$(ln, eq + 1)
    NEXT i
END SUB


' =============================================================================
' F11 - Toggle All UI (action 403)
' =============================================================================

''
' The elements F11 hides. The organizer, drawer and workflow buttons go with
' the toolbox, and the colour strip with the status bar, so their own state is
' left alone.
FUNCTION UIALL_el_on% (el AS INTEGER)
    SELECT CASE el
        CASE WS_EL_ORGANIZER, WS_EL_DRAWER, WS_EL_PALETTE_STRIP
        CASE ELSE: UIALL_el_on% = TRUE
    END SELECT
END FUNCTION


''
' Show / hide one element by its live fields only. Not the panels' toggles:
' they write CFG.*_VISIBLE, so a CONFIG_save while hidden would keep it hidden.
SUB UIALL_set (el AS INTEGER, wantVis AS INTEGER)
    DIM v AS INTEGER
    v = (wantVis <> 0)
    SELECT CASE el
        CASE WS_EL_PREVIEW
            PREVIEW.visible% = v: SCRN.showPreviewWindow% = v
            IF v _ANDALSO PREVIEW.positioned% = 0 THEN PREVIEW_auto_position
        CASE WS_EL_COLOR_MIXER
            SCRN.showColorMixer% = v: COLORMIXER.visible% = v
        CASE WS_EL_COLOR_SPACE_3D
            CS3D.visible% = v
            IF v _ANDALSO CS3D.positioned% = 0 THEN CS3D_auto_position
        CASE WS_EL_ADV_COLOR_PICKER
            ADVCP.visible% = v
            IF v _ANDALSO ADVCP.positioned% = 0 THEN ADVCP_auto_position
        CASE WS_EL_PEN_PANEL
            PENP.visible% = v
            IF v _ANDALSO PENP.positioned% = 0 THEN PENP_auto_position
        CASE WS_EL_ANIM_PANEL
            ANIMP.visible = v
            IF v _ANDALSO ANIMP.positioned = 0 THEN ANIMP_auto_position
        CASE WS_EL_SWATCHES
            IF v = 0 THEN SWP_menu_close
            SWP.visible = v
            IF v THEN
                SWP_ensure_initialized
                IF SWP.positioned = 0 THEN SWP_auto_position
            END IF
        CASE WS_EL_BROWSER
            SCRN.showBrowser% = v: BROWSER.visible% = v
            IF v _ANDALSO BROWSER.positioned% = 0 THEN BROWSER_auto_position
        CASE ELSE
            WS_el_set el, v ' the docked chrome: plain fields there too
            EXIT SUB
    END SELECT
    WS_el_set_mh el, _NEGATE v
END SUB


''
' F11. Hidden by F11 -> put back exactly what was showing. Otherwise, with
' something showing -> remember it all and hide it; with nothing showing (all
' hidden by hand) -> show the basic chrome, as F11 always did.
SUB UIALL_toggle ()
    DIM el AS INTEGER, anyVis AS INTEGER
    IF UIALL_HIDDEN THEN
        UIALL_show
        EXIT SUB
    END IF
    FOR el = 1 TO WS_EL_COUNT
        IF UIALL_el_on%(el) THEN IF WS_el_get%(el) THEN anyVis = TRUE
    NEXT el
    IF anyVis _ORELSE TEXT_BAR.visible% _ORELSE TBED.visible THEN
        UIALL_hide
    ELSE
        FOR el = 1 TO WS_EL_COUNT
            SELECT CASE el
                CASE WS_EL_MENUBAR, WS_EL_TOOLBOX, WS_EL_LAYER_PANEL, WS_EL_STATUS_BAR: UIALL_set el, TRUE
            END SELECT
        NEXT el
        SCREEN_compute_layout
    END IF
    GUI_NEEDS_REDRAW% = TRUE: SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
END SUB


SUB UIALL_hide ()
    DIM el AS INTEGER
    IF UIALL_HIDDEN THEN EXIT SUB
    FOR el = 1 TO WS_EL_COUNT
        UIALL_VIS(el) = WS_el_get%(el)
        UIALL_MH(el) = WS_el_get_mh%(el)
    NEXT el
    MENUBAR_close_all
    IF PSM.isOpen THEN PSM_close
    DOCK_UI.menuOpen = FALSE ' (the dock handle menu)
    FOR el = 1 TO WS_EL_COUNT
        IF UIALL_el_on%(el) THEN UIALL_set el, FALSE
    NEXT el
    SCRN.textBarHiddenByToggleAll% = TRUE ' (the text bar comes and goes with the text tool: held off while hidden)
    TEXT_BAR.visible% = FALSE
    UIALL_TBED = (TBED.visible <> 0)
    IF UIALL_TBED THEN TBED_close
    UIALL_HIDDEN = TRUE
    SCREEN_compute_layout
    GUI_NEEDS_REDRAW% = TRUE: SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' Put back what F11 hid: each element as it was (shown, or hidden with its
' ManuallyHidden flag). Something shown by hand meanwhile stays shown.
SUB UIALL_show ()
    DIM el AS INTEGER
    IF UIALL_HIDDEN = 0 THEN EXIT SUB
    UIALL_HIDDEN = FALSE
    FOR el = 1 TO WS_EL_COUNT
        IF UIALL_el_on%(el) THEN
            IF UIALL_VIS(el) THEN
                UIALL_set el, TRUE
            ELSEIF WS_el_get%(el) = 0 THEN
                WS_el_set_mh el, UIALL_MH(el)
            END IF
        END IF
    NEXT el
    SCRN.textBarHiddenByToggleAll% = FALSE
    IF UIALL_TBED THEN UIALL_TBED = FALSE: TBED_open TBED.tab
    SCREEN_compute_layout
    GUI_NEEDS_REDRAW% = TRUE: SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
END SUB
