''
' DRAW - GUI/POINTER.BM
' =============================================================================
' Pointer subs and functions.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Initializes the pointer
' 
SUB POINTER_init ()
    _MOUSEHIDE
    POINTER.W%           = 4
    POINTER.H%           = 4
    POINTER.C~&          = PAL_color(4) ' Default to red (EGA color 4)
    POINTER.O%           = 7
    POINTER.OC~&         = POINTER.C~&
    POINTER.CURSOR_ID%   = CURSOR_NULL
    POINTER.CURSOR_FLIP% = 0
    POINTER.PREV_DRAW_X% = -9999
    POINTER.PREV_DRAW_Y% = -9999
    POINTER.PREV_HW_CURSOR_ID%    = -999
    POINTER.PREV_HW_CURSOR_SCALE% = 0
    POINTER.HW_ICON_ACTIVE%       = FALSE
    CURSOR_init
    IF SCRN.w& > 640 THEN 
        POINTER.W% = POINTER.W% * 2
        POINTER.H% = POINTER.H% * 2
    END IF
END SUB


''
' Cursor policy (post hardware-cursor refactor, GLFW-only):
'   * Every cursor with theme art (all CURSOR_* slots 0..CURSOR_COUNT, incl. the
'     UI arrow, resize, brush, spray) is drawn by the OS HARDWARE cursor via
'     _MOUSECURSOR — render-free, no per-frame software repaint.
'   * The two art-less procedural states use OS-stock cursors (also render-free):
'     shape tools (line/rect/ellipse) = "CROSSHAIR", text tool = "TEXT".
'   * POINTER_draw no longer paints an icon (see USING_SYSTEM_CURSOR% guards); it
'     only adds canvas-aware feedback (brush/spray rings, picker loupe, overlays).

''
' Render the pointer by building its visual state, selecting between OS
' system cursor and custom PNG cursor, then drawing the result.
'
SUB POINTER_render ()
    IF POINTER.HIDDEN THEN
        ' Brush cursors disabled — show OS arrow so user isn't blind
        IF _TRIM$(POINTER.PREV_SYS_CURSOR$) <> "DEFAULT" THEN
            _MOUSESHOW "DEFAULT"
            POINTER.PREV_SYS_CURSOR$ = "DEFAULT"
        END IF
        POINTER.USING_SYSTEM_CURSOR% = TRUE
        EXIT SUB
    END IF
    POINTER_build
    POINTER.DENIED_OVERLAY% = FALSE

    ' --- "Cannot draw here": drawing tool over a group header layer ---
    '
    ' Groups hold no pixels of their own, so these tools would do nothing. Say
    ' so with the cursor rather than letting the stroke silently vanish.
    '
    ' Gated on CURSOR_ID <> CURSOR_NULL, which POINTER_build sets for every UI
    ' area (toolbar, menus, panels). That is what lets the normal cursors pass
    ' through where they are still legal — only the canvas is overridden.
    '
    ' Tools NOT listed stay untouched on purpose: move, picker, zoom, pan and
    ' marquee all remain legal on a group.
    '
    ' CURSOR_DENIED has theme art (cursor-denied-large.png), so it installs as an
    ' OS hardware cursor like any other slot below.
    IF POINTER.CURSOR_ID% <> CURSOR_NULL THEN
        IF CURRENT_LAYER% >= 1 AND CURRENT_LAYER% <= MAX_LAYERS THEN
            IF LAYERS(CURRENT_LAYER%).layerType% = LAYER_TYPE_GROUP THEN
                SELECT CASE CURRENT_TOOL%
                    CASE TOOL_BRUSH, TOOL_DOT, TOOL_SPRAY, TOOL_LINE, TOOL_RECT, TOOL_RECT_FILLED, TOOL_ELLIPSE, TOOL_ELLIPSE_FILLED, TOOL_ERASER, TOOL_FILL, TOOL_POLYGON, TOOL_POLYGON_FILLED, TOOL_SS_POLYGON, TOOL_SS_PIE_DONUT, TOOL_SS_ROUNDED_RECT, TOOL_SS_TAB, TOOL_SS_PILL, TOOL_SS_PACMAN, TOOL_SS_3D_CUBE, TOOL_SS_BEVEL_RECT, TOOL_SS_ARROW
                        ' Auto-add turns the attempt into a legal draw, so the
                        ' cursor must not claim it is forbidden.
                        IF NOT CFG.GROUP_DRAW_AUTO_LAYER% THEN
                            ' Every cursor is now OS/hardware-drawn, so nothing can be
                            ' stamped on top of it — a forbidden action always shows the
                            ' standalone large "denied" X (itself a hardware cursor).
                            POINTER.CURSOR_ID%      = CURSOR_DENIED
                            POINTER.DENIED_OVERLAY% = FALSE
                        END IF
                END SELECT
            END IF
        END IF
    END IF

    ' Decide: OS system cursor or hidden (custom drawn) cursor.
    ' CURSOR_NULL = UI areas — always system (arrow at display rate).
    ' Every cursor is OS-drawn now (render-free — the compositor moves it, so a bare
    ' mouse move repaints nothing):
    '   CURSOR_NULL (UI chrome) -> native OS arrow ("DEFAULT")
    '   CURSOR_ID = -1          -> art-less procedural states: TOOL_TEXT = I-beam,
    '                              shape tools (line/rect/ellipse) = crosshair (OS-stock)
    '   any slot 0..CURSOR_COUNT-> OS HARDWARE cursor (_MOUSECURSOR) from its theme PNG
    DIM sysCur AS STRING
    IF POINTER.CURSOR_ID% = CURSOR_NULL THEN
        sysCur$ = "DEFAULT"
    ELSEIF POINTER.CURSOR_ID% = -1 THEN
        IF CURRENT_TOOL% = TOOL_TEXT THEN
            sysCur$ = "TEXT"
        ELSE
            sysCur$ = "CROSSHAIR"
            ' Hide entirely when painting with brush edges off — the stroke is enough.
            IF NOT BRUSH_SIZE.PREVIEW AND MOUSE.B1% THEN sysCur$ = ""
        END IF
    END IF

    IF sysCur$ <> "" THEN
        ' OS-stock cursor (native arrow / crosshair / I-beam) — dedup the _MOUSESHOW.
        IF _TRIM$(POINTER.PREV_SYS_CURSOR$) <> sysCur$ THEN
            _MOUSESHOW sysCur$
            POINTER.PREV_SYS_CURSOR$ = sysCur$
        END IF
        POINTER.USING_SYSTEM_CURSOR% = TRUE
        POINTER.PREV_HW_CURSOR_ID%   = -999 ' left the HW path; force re-set on return
    ELSE
        ' Any slotted cursor (0..CURSOR_COUNT) -> OS HARDWARE cursor from its theme PNG.
        DIM hwSet AS INTEGER
        hwSet% = FALSE
        IF POINTER.CURSOR_ID% >= 0 AND POINTER.CURSOR_ID% <= CURSOR_COUNT THEN
            IF CURSOR_ensure_hw%(POINTER.CURSOR_ID%) THEN
                DIM hwScale AS INTEGER
                hwScale% = SCRN.displayScale%
                ' _MOUSECURSOR recreates the OS cursor each call — only on change.
                IF POINTER.PREV_HW_CURSOR_ID% <> POINTER.CURSOR_ID% OR POINTER.PREV_HW_CURSOR_SCALE% <> hwScale% THEN
                    _MOUSECURSOR CURSORS(POINTER.CURSOR_ID%).hw_img&, (CURSORS(POINTER.CURSOR_ID%).hw_hx%, CURSORS(POINTER.CURSOR_ID%).hw_hy%)
                    POINTER.PREV_HW_CURSOR_ID%    = POINTER.CURSOR_ID%
                    POINTER.PREV_HW_CURSOR_SCALE% = hwScale%
                    POINTER.PREV_SYS_CURSOR$      = "HWCUR"
                END IF
                POINTER.USING_SYSTEM_CURSOR% = TRUE
                hwSet% = TRUE
            END IF
        END IF
        IF NOT hwSet% THEN
            ' No hardware art for this slot (shouldn't happen) — hide the OS cursor.
            IF _TRIM$(POINTER.PREV_SYS_CURSOR$) <> "" THEN
                _MOUSEHIDE
                POINTER.PREV_SYS_CURSOR$ = ""
            END IF
            POINTER.USING_SYSTEM_CURSOR% = FALSE
            POINTER.PREV_HW_CURSOR_ID%   = -999
        END IF
    END IF

    ' Can a bare mouse move skip rendering entirely this frame? Only when the OS
    ' draws the pointer (hardware/system cursor), the tool has NO per-frame
    ' software feedback that tracks the pointer (excludes brush/spray rings, the
    ' picker loupe, shape/marquee crosshairs, SHIFT crosshair), and we are not
    ' painting. UI chrome (CURSOR_NULL) is excluded so hover highlights still draw.
    POINTER.HW_ICON_ACTIVE% = FALSE
    IF POINTER.USING_SYSTEM_CURSOR% AND NOT MOUSE.B1% AND NOT MODIFIERS.shift% THEN
        SELECT CASE POINTER.CURSOR_ID%
            CASE CURSOR_FILL, CURSOR_ZOOM, CURSOR_MOVE, CURSOR_HAND, CURSOR_MARQUEE, CURSOR_WAND, CURSOR_MARQUEE_RECT, CURSOR_MARQUEE_FREE, CURSOR_MARQUEE_POLY, CURSOR_MARQUEE_ELLIP
                POINTER.HW_ICON_ACTIVE% = TRUE
        END SELECT
    END IF

    POINTER_draw
END SUB


''
' Hide the custom pointer before opening a native dialog.
' Renders one frame without the pointer, waits briefly so the
' user sees the pointer disappear, then shows the system cursor.
'
SUB POINTER_hide_for_dialog ()
    POINTER.HIDDEN = TRUE
    ' Render a frame so the custom pointer vanishes on-screen
    SCREEN_render
    ' Brief delay so the pointerless frame is visible before
    ' the OS dialog steals focus and backgrounds QB64PE
    _DELAY 0.15
    _MOUSESHOW
    POINTER.PREV_SYS_CURSOR$ = "DEFAULT" ' Track that OS cursor is now visible
END SUB


''
' Restore the custom pointer after a native dialog closes.
' Hides the system cursor and re-enables custom pointer rendering.
'
SUB POINTER_show_after_dialog ()
    _MOUSEHIDE
    POINTER.PREV_SYS_CURSOR$ = "" ' Track that OS cursor is now hidden
    POINTER.HIDDEN           = FALSE
    ' Reset to null (arrow) cursor after dialog so the tool-specific
    ' cursor doesn't flash before the user moves the mouse
    POINTER.CURSOR_ID% = CURSOR_NULL
END SUB


''
' Force the next POINTER_render to re-issue the OS cursor call (_MOUSECURSOR /
' _MOUSESHOW). Recreating the GLFW window/surface — ANY runtime `SCREEN _NEWIMAGE`
' (opening a file, PSD/ASE import, display-scale change, viewport resize) — silently
' drops the OS hardware cursor. POINTER_render's on-change guards (PREV_HW_CURSOR_ID /
' PREV_SYS_CURSOR) would otherwise skip re-applying it, since the cursor id itself
' didn't change, so the pointer stays invisible until the id changes OR the pointer
' leaves and re-enters the window (GLFW re-evaluates the cursor on enter). Symptom:
' the pointer vanishes after Alt+1-9 quick-open until you wiggle it off-window and back.
' Call this immediately after any such SCREEN _NEWIMAGE.
'
SUB POINTER_invalidate_os_cursor ()
    POINTER.PREV_HW_CURSOR_ID%    = -999
    POINTER.PREV_HW_CURSOR_SCALE% = -999
    POINTER.PREV_SYS_CURSOR$      = CHR$(1)   ' sentinel: matches no real cursor name -> forces re-apply
END SUB


''
' Builds the pointer
' 
SUB POINTER_build ()
    DIM mx AS INTEGER, my AS INTEGER
    DIM AS INTEGER TB_RIGHT, TB_LEFT
    
    ' Calculate toolbar position dynamically to align to right edge of screen
    TB_RIGHT = SCRN.w& - TB_BTN_W - 1               ' Right column              : 1px from right edge
    TB_LEFT  = TB_RIGHT - TB_BTN_W - TB_BTN_PADDING ' Left column : to the left of right column
    
    ' Use viewport coordinates (already divided by displayScale in MOUSE_drain_update_state)
    mx% = MOUSE.RAW_X%
    my% = MOUSE.RAW_Y%

    ' Active preview-window resize drag wins over every region check below: the
    ' cursor can lead the growing window past its own footprint (PREVIEW_hit_window%
    ' goes false) or wander over the canvas/chrome mid-drag. Lock the cursor to the
    ' grabbed resize edge so it stays correct, and the overlay pass
    ' (POINTER_render_cursor_overlay) redraws it ON TOP of the preview window since
    ' it too honors PREVIEW.resizing%.
    IF PREVIEW.resizing% THEN
        POINTER.CURSOR_FLIP% = 0
        SELECT CASE PREVIEW.resizeEdge%
            CASE 1, 5 ' N, S
                POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
            CASE 3, 7 ' E, W
                POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
            CASE 8    ' NW
                POINTER.CURSOR_ID% = CURSOR_RESIZE_CORNER : POINTER.CURSOR_FLIP% = 0
            CASE 2    ' NE
                POINTER.CURSOR_ID% = CURSOR_RESIZE_CORNER : POINTER.CURSOR_FLIP% = 1
            CASE 4    ' SE
                POINTER.CURSOR_ID% = CURSOR_RESIZE_CORNER : POINTER.CURSOR_FLIP% = 3
            CASE 6    ' SW
                POINTER.CURSOR_ID% = CURSOR_RESIZE_CORNER : POINTER.CURSOR_FLIP% = 2
        END SELECT
        EXIT SUB
    END IF

    IF DRAWER.contextMenuOpen% OR LAYER_PANEL.blendPopupOpen% OR LAYER_PANEL.ctxMenuOpen% OR CMD_PALETTE.visible THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Subtool flyout (e.g. Smart Shapes) is open — always show arrow over its strip
    IF SUBTOOL_FLYOUT.ACTIVE THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF
    
    ' --- UI area checks: use null (arrow) cursor ---
    
    ' Check if mouse is over toolbar area
    IF SCRN.showToolbar% AND TOOLBAR_is_over_area%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if mouse is over organizer area (beneath toolbar)
    IF SCRN.showToolbar% AND ORGANIZER_is_over_area%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    IF DRAWER_is_over_area%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if mouse is over edit bar
    IF SCRN.showEditBar% AND EDITBAR_is_over_area%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if mouse is over advanced bar
    IF SCRN.showAdvBar% AND ADVBAR_is_over_area%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if mouse is over character map
    IF SCRN.showCharMap% AND CHARMAP_is_over_area%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if mouse is over text formatting bar or its open dropdowns
    IF TEXT_BAR.visible% THEN
        IF TEXT_BAR_in_bounds%(mx%, my%) THEN
            POINTER.CURSOR_ID% = CURSOR_NULL
            EXIT SUB
        END IF
        IF TEXT_BAR.fontDropdownOpen% OR TEXT_BAR.sizeDropdownOpen% OR TEXT_BAR.styleDropdownOpen% THEN
            POINTER.CURSOR_ID% = CURSOR_NULL
            EXIT SUB
        END IF
    END IF
    
    ' Check if mouse is over layer panel
    IF LAYER_PANEL.visible% AND mx% >= LAYER_PANEL.panelX1% AND mx% <= LAYER_PANEL.panelX2% THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF
    
    ' Check if mouse is over menu bar area (top MENU_BAR_HEIGHT pixels in the bar region)
    IF SCRN.showMenubar% AND MENU_BAR.visible% THEN
        IF my% < MENU_BAR_HEIGHT AND mx% >= MENU_BAR.barX% THEN
            POINTER.CURSOR_ID% = CURSOR_NULL
            EXIT SUB
        END IF
        ' Check if submenu is open and mouse is over it
        IF MENUBAR_submenu_in_bounds%(mx%, my%) THEN
            POINTER.CURSOR_ID% = CURSOR_NULL
            EXIT SUB
        END IF
        ' Check if a category FLYOUT (e.g. EFFECTS > ADJUST children) is open and the
        ' mouse is over it — its bounds are separate from the main dropdown's.
        IF MENU_BAR.genOpen% AND MENU_BAR.genW% > 0 AND MENU_BAR.genH% > 0 THEN
            IF mx% >= MENU_BAR.genX% AND mx% < MENU_BAR.genX% + MENU_BAR.genW% _
                AND my% >= MENU_BAR.genY% AND my% < MENU_BAR.genY% + MENU_BAR.genH% THEN
                POINTER.CURSOR_ID% = CURSOR_NULL
                EXIT SUB
            END IF
        END IF
        ' Check if recent files submenu is open and mouse is over it
        IF MENU_BAR.recentOpen% AND MENU_BAR.recentW% > 0 AND MENU_BAR.recentH% > 0 THEN
            IF mx% >= MENU_BAR.recentX% AND mx% < MENU_BAR.recentX% + MENU_BAR.recentW% _
                AND my% >= MENU_BAR.recentY% AND my% < MENU_BAR.recentY% + MENU_BAR.recentH% THEN
                POINTER.CURSOR_ID% = CURSOR_NULL
                EXIT SUB
            END IF
        END IF
        ' Check if random track submenu is open and mouse is over it
        IF MENU_BAR.randomOpen% AND MENU_BAR.randomW% > 0 AND MENU_BAR.randomH% > 0 THEN
            IF mx% >= MENU_BAR.randomX% AND mx% < MENU_BAR.randomX% + MENU_BAR.randomW% _
                AND my% >= MENU_BAR.randomY% AND my% < MENU_BAR.randomY% + MENU_BAR.randomH% THEN
                POINTER.CURSOR_ID% = CURSOR_NULL
                EXIT SUB
            END IF
        END IF
        ' Check if transform submenu is open and mouse is over it
        IF MENU_BAR.transformOpen% AND MENU_BAR.transformW% > 0 AND MENU_BAR.transformH% > 0 THEN
            IF mx% >= MENU_BAR.transformX% AND mx% < MENU_BAR.transformX% + MENU_BAR.transformW% _
                AND my% >= MENU_BAR.transformY% AND my% < MENU_BAR.transformY% + MENU_BAR.transformH% THEN
                POINTER.CURSOR_ID% = CURSOR_NULL
                EXIT SUB
            END IF
        END IF
        ' Check if layout submenu is open and mouse is over it
        IF MENU_BAR.layoutOpen% AND MENU_BAR.layoutW% > 0 AND MENU_BAR.layoutH% > 0 THEN
            IF mx% >= MENU_BAR.layoutX% AND mx% < MENU_BAR.layoutX% + MENU_BAR.layoutW% _
                AND my% >= MENU_BAR.layoutY% AND my% < MENU_BAR.layoutY% + MENU_BAR.layoutH% THEN
                POINTER.CURSOR_ID% = CURSOR_NULL
                EXIT SUB
            END IF
        END IF
        ' Check if preview window submenu is open and mouse is over it
        IF MENU_BAR.pvwOpen% AND MENU_BAR.pvwW% > 0 AND MENU_BAR.pvwH% > 0 THEN
            IF mx% >= MENU_BAR.pvwX% AND mx% < MENU_BAR.pvwX% + MENU_BAR.pvwW% _
                AND my% >= MENU_BAR.pvwY% AND my% < MENU_BAR.pvwY% + MENU_BAR.pvwH% THEN
                POINTER.CURSOR_ID% = CURSOR_NULL
                EXIT SUB
            END IF
        END IF
        ' Check if preview window recent sub-submenu is open and mouse is over it
        IF MENU_BAR.pvwRecentOpen% THEN
            IF MENU_BAR.pvwRecentW% > 0 AND MENU_BAR.pvwRecentH% > 0 THEN
                IF mx% >= MENU_BAR.pvwRecentX% AND mx% < MENU_BAR.pvwRecentX% + MENU_BAR.pvwRecentW% _
                    AND my% >= MENU_BAR.pvwRecentY% AND my% < MENU_BAR.pvwRecentY% + MENU_BAR.pvwRecentH% THEN
                    POINTER.CURSOR_ID% = CURSOR_NULL
                    EXIT SUB
                END IF
            ELSE
                ' First frame: bounds not yet computed by render — hide cursor
                ' since the submenu is about to appear at the mouse position
                POINTER.CURSOR_ID% = CURSOR_NULL
                EXIT SUB
            END IF
        END IF
        ' Check if export-as submenu is open and mouse is over it
        IF MENU_BAR.exportOpen% AND MENU_BAR.exportW% > 0 AND MENU_BAR.exportH% > 0 THEN
            IF mx% >= MENU_BAR.exportX% AND mx% < MENU_BAR.exportX% + MENU_BAR.exportW% _
                AND my% >= MENU_BAR.exportY% AND my% < MENU_BAR.exportY% + MENU_BAR.exportH% THEN
                POINTER.CURSOR_ID% = CURSOR_NULL
                EXIT SUB
            END IF
        END IF
    END IF

    ' Check if mouse is over status bar or palette strip
    IF SCRN.showStatus% THEN
        DIM strip_top_build AS INTEGER
        strip_top_build% = SCRN.h& - THEME.STATUS_height% - PALETTE_STRIP_get_height%
        IF my% >= strip_top_build% THEN
            POINTER.CURSOR_ID% = CURSOR_NULL
            EXIT SUB
        END IF
    END IF
    
    ' Check if palette menu is visible
    IF PALETTE_MENU_VISIBLE% THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if mouse is over scrollbars
    IF SCROLLBAR_in_bounds%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if mouse is over Browser panel.
    ' Set resize cursors on edges; OS arrow elsewhere.
    IF BROWSER.visible% AND NOT BROWSER.autoHidden% AND BROWSER_hit_window%(mx%, my%) THEN
        DIM browserEdge AS INTEGER
        DIM bNativeX    AS INTEGER, bNativeY AS INTEGER
        IF BROWSER.renderScale! > 0 THEN
            bNativeX% = INT(CSNG(mx% - BROWSER.dispX%) / BROWSER.renderScale! + 0.5)
            bNativeY% = INT(CSNG(my% - BROWSER.dispY%) / BROWSER.renderScale! + 0.5)
        END IF
        browserEdge%         = FD_INPUT_hit_resize_edge%(bNativeX%, bNativeY%)
        POINTER.CURSOR_FLIP% = 0
        SELECT CASE browserEdge%
            CASE FD_RESIZE_N, FD_RESIZE_S
                POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
            CASE FD_RESIZE_E, FD_RESIZE_W
                POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
            CASE FD_RESIZE_NW, FD_RESIZE_SE
                POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                POINTER.CURSOR_FLIP% = 0
            CASE FD_RESIZE_NE, FD_RESIZE_SW
                POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                POINTER.CURSOR_FLIP% = 1
            CASE ELSE
                POINTER.CURSOR_ID% = CURSOR_NULL
        END SELECT
        EXIT SUB
    END IF

    ' Check if mouse is over Color Mixer panel — treat as UI so OS arrow cursor
    ' shows on top of it (the panel renders directly to screen 0 after the
    ' canvas upscale, so any custom PNG cursor drawn into SCRN.CANVAS& would be
    ' covered by the mixer otherwise).
    IF COLORMIXER.visible% AND NOT COLORMIXER.autoHidden% AND COLORMIXER_hit_window%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if mouse is over preview window
    IF PREVIEW.visible% AND NOT PREVIEW.autoHidden% AND NOT PREVIEW.minimized% AND PREVIEW_hit_window%(mx%, my%) THEN
        ' Resize edges checked FIRST (overlap with title bar zone)
        DIM prevEdge AS INTEGER : prevEdge% = PREVIEW_hit_resize_edge%(mx%, my%)
        POINTER.CURSOR_FLIP% = 0
        SELECT CASE prevEdge%
            CASE 1, 5 ' N, S
                POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
                EXIT SUB
            CASE 3, 7 ' E, W
                POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
                EXIT SUB
            CASE 8    ' NW (top-left diagonal)
                POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                POINTER.CURSOR_FLIP% = 0
                EXIT SUB
            CASE 2    ' NE (top-right diagonal)
                POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                POINTER.CURSOR_FLIP% = 1
                EXIT SUB
            CASE 4    ' SE (bottom-right diagonal)
                POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                POINTER.CURSOR_FLIP% = 3
                EXIT SUB
            CASE 6    ' SW (bottom-left diagonal)
                POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                POINTER.CURSOR_FLIP% = 2
                EXIT SUB
        END SELECT
        ' Title bar area (not on resize edge) → arrow cursor
        IF my% < PREVIEW.y% + THEME.PREVIEW_title_height% THEN
            POINTER.CURSOR_ID% = CURSOR_NULL
            EXIT SUB
        END IF
        ' Content area: dropper cursor when ALT-picker is active, else hand (pan)
        IF MODIFIERS.alt% AND CURRENT_TOOL% = TOOL_PICKER AND PICKER.ACTIVE% AND PREVIEW.colorPickEnabled% THEN
            POINTER.CURSOR_ID% = CURSOR_DROPPER
        ELSE
            POINTER.CURSOR_ID% = CURSOR_HAND
        END IF
        EXIT SUB
    END IF
    ' Minimized preview window → arrow cursor
    IF PREVIEW.visible% AND NOT PREVIEW.autoHidden% AND PREVIEW.minimized% AND PREVIEW_hit_window%(mx%, my%) THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF
    
    ' Transform overlay active: use system arrow cursor over canvas
    IF TRANSFORM.ACTIVE THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF

    ' Check if NULL tool is active
    IF CURRENT_TOOL% = TOOL_NULL THEN
        POINTER.CURSOR_ID% = CURSOR_NULL
        EXIT SUB
    END IF
    
    ' --- Pan mode: use hand cursor ---
    ' Block spacebar pan cursor when text tool is active (SPACE needed for typing)
    DIM allowSpacePanCursor AS INTEGER
    allowSpacePanCursor% = NOT (CURRENT_TOOL% = TOOL_TEXT AND TEXT.ACTIVE)
    
    IF (_KEYDOWN(32) AND allowSpacePanCursor%) OR MOUSE.B3% THEN ' Spacebar or MMB - pan mode
        POINTER.CURSOR_ID% = CURSOR_HAND
        EXIT SUB
    END IF
    
    ' Image Import mode - must check BEFORE tool-specific cursors so import
    ' resize/hand cursors show regardless of which tool was active when import started
    IF IMG_IMPORT.STATE > IMPORT_STATE_IDLE THEN
        POINTER.CURSOR_FLIP% = 0
        IF IMG_IMPORT.RESIZING THEN
            SELECT CASE IMG_IMPORT.RESIZE_HANDLE
                CASE 1    ' TL corner (NW-SE)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 0
                CASE 3    ' TR corner (NE-SW, flip horizontal)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 1
                CASE 6    ' BL corner (NW-SE, flip vertical)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 2
                CASE 8    ' BR corner (NE-SW, flip both)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 3
                CASE 2, 7 ' Top/Bottom edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
                CASE 4, 5 ' Left/Right edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
                CASE ELSE
                    POINTER.CURSOR_ID% = CURSOR_HAND
            END SELECT
        ELSEIF IMG_IMPORT.PANNING THEN
            POINTER.CURSOR_ID% = CURSOR_HAND
        ELSEIF IMG_IMPORT.HOVER_HANDLE > 0 THEN
            SELECT CASE IMG_IMPORT.HOVER_HANDLE
                CASE 1    ' TL corner (NW-SE)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 0
                CASE 3    ' TR corner (NE-SW, flip horizontal)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 1
                CASE 6    ' BL corner (NW-SE, flip vertical)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 2
                CASE 8    ' BR corner (NE-SW, flip both)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 3
                CASE 2, 7 ' Top/Bottom edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
                CASE 4, 5 ' Left/Right edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
                CASE ELSE
                    POINTER.CURSOR_ID% = CURSOR_HAND
            END SELECT
        ELSE
            POINTER.CURSOR_ID% = CURSOR_HAND
        END IF
        EXIT SUB
    END IF

    ' --- Tool-specific cursors ---
    
    ' Pan tool
    IF CURRENT_TOOL% = TOOL_PAN THEN
        POINTER.CURSOR_ID% = CURSOR_HAND
        EXIT SUB
    END IF
    
    ' Zoom tool
    IF CURRENT_TOOL% = TOOL_ZOOM THEN
        POINTER.CURSOR_ID% = CURSOR_ZOOM
        EXIT SUB
    END IF
    
    ' Fill tool
    IF CURRENT_TOOL% = TOOL_FILL THEN
        POINTER.CURSOR_ID% = CURSOR_FILL
        EXIT SUB
    END IF
    
    ' Picker / Dropper tool
    IF CURRENT_TOOL% = TOOL_PICKER THEN
        POINTER.CURSOR_ID% = CURSOR_DROPPER
        EXIT SUB
    END IF
    
    ' Marquee tool (or magic wand mode) - with resize cursor support
    IF CURRENT_TOOL% = TOOL_MARQUEE THEN
        POINTER.CURSOR_FLIP% = 0 ' Reset flip
        IF MARQUEE.MAGIC_WAND_MODE% THEN
            POINTER.CURSOR_ID% = CURSOR_WAND
        ELSEIF MARQUEE.RESIZING% THEN
            ' Currently dragging a resize handle
            SELECT CASE MARQUEE.RESIZE_HANDLE%
                CASE 1    ' TL corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 0
                CASE 3    ' TR corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 1
                CASE 8    ' BR corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 3
                CASE 6    ' BL corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 2
                CASE 2, 7 ' Top/Bottom edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
                CASE 4, 5 ' Left/Right edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
                CASE ELSE
                    POINTER.CURSOR_ID% = POINTER_marquee_cursor_for_variant%
            END SELECT
        ELSEIF MARQUEE.ACTIVE% THEN
            ' Hover detection over handles
            DIM marq_hover AS INTEGER
            marq_hover% = MARQUEE_get_handle_at%(MOUSE.UNSNAPPED_X%, MOUSE.UNSNAPPED_Y%)
            SELECT CASE marq_hover%
                CASE 1    ' TL corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 0
                CASE 3    ' TR corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 1
                CASE 8    ' BR corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 3
                CASE 6    ' BL corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 2
                CASE 2, 7 ' Top/Bottom edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
                CASE 4, 5 ' Left/Right edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
                CASE ELSE
                    POINTER.CURSOR_ID% = POINTER_marquee_cursor_for_variant%
            END SELECT
        ELSE
            POINTER.CURSOR_ID% = POINTER_marquee_cursor_for_variant%
        END IF
        EXIT SUB
    END IF
    
    ' Move tool - pick cursor based on handle being hovered/dragged
    IF CURRENT_TOOL% = TOOL_MOVE THEN
        POINTER.CURSOR_FLIP% = 0 ' Reset flip
        IF MOVE.ACTIVE AND MOVE.TRANSFORMING THEN
            ' Currently dragging a handle - cursor based on MOVE.HANDLE
            SELECT CASE MOVE.HANDLE
                CASE 0 ' Center - move
                    POINTER.CURSOR_ID% = CURSOR_MOVE
                CASE 1 ' TL corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 0 ' No flip (default orientation)
                CASE 2 ' TR corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 1 ' Flip horizontal
                CASE 3 ' BR corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 3 ' Flip both
                CASE 4 ' BL corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 2 ' Flip vertical
                CASE 5, 7 ' Top/Bottom edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
                CASE 6, 8 ' Right/Left edge
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
                CASE ELSE
                    POINTER.CURSOR_ID% = CURSOR_MOVE
            END SELECT
        ELSEIF MOVE.ACTIVE AND MARQUEE.ACTIVE% THEN
            ' Selection exists - check which handle mouse is hovering
            DIM hover_handle AS INTEGER
            hover_handle% = MARQUEE_get_handle_at%(MOUSE.UNSNAPPED_X%, MOUSE.UNSNAPPED_Y%)
            SELECT CASE hover_handle%
                CASE 0    ' No handle / interior
                    POINTER.CURSOR_ID% = CURSOR_MOVE
                CASE 1    ' TL corner
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 0
                CASE 3    ' TR corner (MARQUEE numbering)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 1
                CASE 8    ' BR corner (MARQUEE numbering)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 3
                CASE 6    ' BL corner (MARQUEE numbering)
                    POINTER.CURSOR_ID%   = CURSOR_RESIZE_CORNER
                    POINTER.CURSOR_FLIP% = 2
                CASE 2, 7 ' Top/Bottom edge (MARQUEE numbering)
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_VERT
                CASE 4, 5 ' Left/Right edge (MARQUEE numbering)
                    POINTER.CURSOR_ID% = CURSOR_RESIZE_HORIZ
                CASE ELSE
                    POINTER.CURSOR_ID% = CURSOR_MOVE
            END SELECT
        ELSE
            POINTER.CURSOR_ID% = CURSOR_MOVE
        END IF
        EXIT SUB
    END IF
    
    ' Text tool - keep procedural I-beam (no PNG for this)
    IF CURRENT_TOOL% = TOOL_TEXT THEN
        POINTER.CURSOR_ID% = -1 ' No PNG cursor, use procedural
        EXIT SUB
    END IF
    
    ' Line/Polygon/Rect/Ellipse tools - keep procedural crosshair (no PNG for these)
    IF CURRENT_TOOL% = TOOL_LINE OR CURRENT_TOOL% = TOOL_POLYGON OR CURRENT_TOOL% = TOOL_POLYGON_FILLED OR CURRENT_TOOL% = TOOL_RECT OR CURRENT_TOOL% = TOOL_RECT_FILLED OR CURRENT_TOOL% = TOOL_ELLIPSE OR CURRENT_TOOL% = TOOL_ELLIPSE_FILLED THEN
        POINTER.CURSOR_ID% = -1 ' No PNG cursor, use procedural
        EXIT SUB
    END IF
    
    ' Brush / Dot / Eraser tool - use brush cursor when showing arrow, procedural for brush preview
    IF CURRENT_TOOL% = TOOL_BRUSH OR CURRENT_TOOL% = TOOL_DOT OR CURRENT_TOOL% = TOOL_ERASER THEN
        POINTER.CURSOR_ID% = CURSOR_BRUSH
        EXIT SUB
    END IF
    
    ' Pan tool - use hand cursor
    IF CURRENT_TOOL% = TOOL_PAN THEN
        POINTER.CURSOR_ID% = CURSOR_HAND
        EXIT SUB
    END IF
    
    ' Spray tool - use spray cursor
    IF CURRENT_TOOL% = TOOL_SPRAY THEN
        POINTER.CURSOR_ID% = CURSOR_SPRAY
        EXIT SUB
    END IF
    
    ' Crop tool - use marquee cursor
    IF CURRENT_TOOL% = TOOL_CROP THEN
        POINTER.CURSOR_ID% = CURSOR_MARQUEE
        EXIT SUB
    END IF
    
    ' Default fallback - crosshair/square
    POINTER.CURSOR_ID% = -1 ' procedural default
    POINTER.S$         = "C" + STR$(PAL_color(POINTER.O%)) _
              + "D"  + ns$(POINTER.H%) _ 
              + "R"  + ns$(POINTER.W%) _ 
              + "H"  + ns$(POINTER.H%) _ 
              + "B" _
              + "M+" + ns$(POINTER.W%\2) _
              + ",+" + ns$(POINTER.H%) _
              + "F"  + ns$(POINTER.W%\2)
    IF POINTER.C~& <> 0 THEN 'fill POINTER if not 0 else color is black do not.
        POINTER.S$ = POINTER.S$ _
                  + "B" _
                  + "M-" + ns$(POINTER.W%\2) _
                  + ",-" + ns$(POINTER.H% - 1) _
                  + "P"  + STR$(POINTER.C~&) _
                  + ","  + STR$(PAL_color(POINTER.O%))
    END IF
END SUB


''
' Draw panning cursor (hand PNG or procedural fallback).
' @param mx INTEGER Screen X coordinate to draw the cursor at
' @param my INTEGER Screen Y coordinate to draw the cursor at
'


''
' Draw UI area cursor (arrow PNG or procedural fallback).
' Used when hovering over toolbar, layer panel, status bar, palette menu, or NULL tool.
' @param mx INTEGER Screen X coordinate to draw the cursor at
' @param my INTEGER Screen Y coordinate to draw the cursor at
'


''
' Draw custom brush cursor (scaled brush preview + outline + center crosshair).
' @param mx INTEGER Screen X coordinate for the brush center
' @param my INTEGER Screen Y coordinate for the brush center
'
SUB POINTER_draw_custom_brush (mx AS INTEGER, my AS INTEGER)
    DIM brush_x  AS INTEGER, brush_y AS INTEGER
    DIM scaled_w AS INTEGER, scaled_h AS INTEGER

    scaled_w% = CUSTOM_BRUSH.WIDTH% * SCRN.zoom!
    scaled_h% = CUSTOM_BRUSH.HEIGHT% * SCRN.zoom!

    brush_x% = mx% - scaled_w% \ 2
    brush_y% = my% - scaled_h% \ 2

    CUSTOM_BRUSH_render_scaled brush_x%, brush_y%, SCRN.CANVAS&, SCRN.zoom!

    IF BRUSH_SIZE.PREVIEW AND CUSTOM_BRUSH.SHOW_OUTLINE% THEN
        DIM outline_x1 AS INTEGER, outline_y1 AS INTEGER
        DIM outline_x2 AS INTEGER, outline_y2 AS INTEGER
        outline_x1% = brush_x%
        outline_y1% = brush_y%
        outline_x2% = brush_x% + scaled_w% - 1
        outline_y2% = brush_y% + scaled_h% - 1

        LINE (outline_x1% - 1, outline_y1% - 1)-(outline_x2% + 1, outline_y2% + 1), _RGBA32(0, 0, 0, 128), B
        LINE (outline_x1%, outline_y1%)-(outline_x2%, outline_y2%), _RGBA32(255, 255, 255, 200), B
    END IF

    LINE (mx% - 3, my%)-(mx% - 1, my%), _RGBA32(255, 255, 255, 240)
    LINE (mx% + 1, my%)-(mx% + 3, my%), _RGBA32(255, 255, 255, 240)
    LINE (mx%, my% - 3)-(mx%, my% - 1), _RGBA32(255, 255, 255, 240)
    LINE (mx%, my% + 1)-(mx%, my% + 3), _RGBA32(255, 255, 255, 240)
    PSET (mx%, my%), _RGBA32(255, 0, 0, 255)
END SUB


''
' Draw shape tool cursor (X-shaped crosshair with color center dot).
' Used for line, polygon, rect, ellipse tools.
' @param mx INTEGER Screen X coordinate for the crosshair center
' @param my INTEGER Screen Y coordinate for the crosshair center
'


''
' Draw picker tool cursor (dropper PNG or procedural crosshair fallback).
' @param mx INTEGER Screen X coordinate to draw the cursor at
' @param my INTEGER Screen Y coordinate to draw the cursor at
'


''
' Draw brush/dot tool preview (circle or square, scanline fill).
' @param mx INTEGER Screen X coordinate for the brush preview center
' @param my INTEGER Screen Y coordinate for the brush preview center
' @param is_painting INTEGER TRUE when actively painting; hides center crosshair during strokes
'
SUB POINTER_draw_brush_preview (mx AS INTEGER, my AS INTEGER, is_painting AS INTEGER)
    DIM pixel_size    AS INTEGER, half AS INTEGER
    DIM radius        AS INTEGER
    DIM r             AS INTEGER, g AS INTEGER, b AS INTEGER
    DIM cy            AS INTEGER
    DIM r_sq          AS SINGLE
    DIM isTransparent AS INTEGER

    pixel_size% = INT(BRUSH_SIZE_pixels% * SCRN.zoom!)
    IF pixel_size% < 1 THEN pixel_size% = 1
    isTransparent% = (_ALPHA32(PAINT_COLOR~&) = 0)

    if BRUSH_SIZE.PREVIEW THEN
        IF BRUSH_SIZE.SHAPE = 0 THEN
            radius% = pixel_size% \ 2
            IF isTransparent% THEN
                CIRCLE (mx%, my%), radius% + 1, THEME.TOOL_PREVIEW_transparent_outline~&
                CIRCLE (mx%, my%), radius%, THEME.TOOL_PREVIEW_transparent_fg~&
            ELSE
                CIRCLE (mx%, my%), radius% + 1, _RGBA32(32, 32, 32, 84)
                CIRCLE (mx%, my%), radius%, _RGBA32(255, 255, 255, 84)

                ' Only fill the circle when actively painting — outline is
                ' sufficient for hover and avoids expensive scanline fill
                ' at large brush sizes every cursor-move frame.
                IF is_painting% THEN
                    r% = _RED32(PAINT_COLOR~&)
                    g% = _GREEN32(PAINT_COLOR~&)
                    b% = _BLUE32(PAINT_COLOR~&)
                    DIM fill_c AS _UNSIGNED LONG
                    fill_c~& = _RGBA32(r%, g%, b%, 120)
                    r_sq!    = (radius% - 0.5) * (radius% - 0.5)
                    FOR cy% = my% - radius% TO my% + radius%
                        DIM dy_sq  AS SINGLE
                        DIM scan_w AS INTEGER
                        dy_sq! = (cy% - my%) * (cy% - my%)
                        IF dy_sq! > r_sq! THEN _CONTINUE
                        scan_w% = INT(SQR(r_sq! - dy_sq!))
                        LINE (mx% - scan_w%, cy%)-(mx% + scan_w%, cy%), fill_c~&
                    NEXT cy%
                END IF
            END IF
        ELSE
            half% = pixel_size% \ 2
            IF isTransparent% THEN
                LINE (mx% - half% - 1, my% - half% - 1)-(mx% + half% + 1, my% + half% + 1), THEME.TOOL_PREVIEW_transparent_outline~&, B
                LINE (mx% - half%, my% - half%)-(mx% + half%, my% + half%), THEME.TOOL_PREVIEW_transparent_fg~&, B
            ELSE
                LINE (mx% - half% - 1, my% - half% - 1)-(mx% + half% + 1, my% + half% + 1), _RGBA32(32, 32, 32, 84), B
                LINE (mx% - half%, my% - half%)-(mx% + half%, my% + half%), _RGBA32(255, 255, 255, 84), B

                IF is_painting% THEN
                    r% = _RED32(PAINT_COLOR~&)
                    g% = _GREEN32(PAINT_COLOR~&)
                    b% = _BLUE32(PAINT_COLOR~&)
                    LINE (mx% - half%, my% - half%)-(mx% + half%, my% + half%), _RGBA32(r%, g%, b%, 120), BF
                END IF
            END IF
        END IF

        IF NOT is_painting% THEN
            LINE (mx% - 3, my%)-(mx% + 3, my%), _RGBA32(32, 32, 32, 84)
            LINE (mx%, my% - 3)-(mx%, my% + 3), _RGBA32(32, 32, 32, 84)
            LINE (mx% - 2, my%)-(mx% + 2, my%), _RGBA32(255, 255, 255, 84)
            LINE (mx%, my% - 2)-(mx%, my% + 2), _RGBA32(255, 255, 255, 84)
        END IF
    ELSE
        IF pixel_size% = 1 THEN
            PSET (mx%, my%), _RGBA32(255, 255, 255, 128)
            PSET (mx% - 1, my%), _RGBA32(0, 0, 0, 64)
            PSET (mx% + 1, my%), _RGBA32(0, 0, 0, 64)
            PSET (mx%, my% - 1), _RGBA32(0, 0, 0, 64)
            PSET (mx%, my% + 1), _RGBA32(0, 0, 0, 64)
        ELSEIF pixel_size% = 3 AND BRUSH_SIZE.SHAPE = 0 THEN
            LINE (mx%, my% - 1)-(mx%, my% + 1), PAINT_COLOR~&
            LINE (mx% - 1, my%)-(mx% + 1, my%), PAINT_COLOR~&
        ELSE
            IF BRUSH_SIZE.SHAPE = 0 THEN
                ' Scanline circle fill (no-preview mode)
                radius% = pixel_size% \ 2
                r_sq!   = (radius% - 0.5) * (radius% - 0.5)
                FOR cy% = my% - radius% TO my% + radius%
                    DIM dy_sq2  AS SINGLE
                    DIM scan_w2 AS INTEGER
                    dy_sq2! = (cy% - my%) * (cy% - my%)
                    IF dy_sq2! > r_sq! THEN _CONTINUE
                    scan_w2% = INT(SQR(r_sq! - dy_sq2!))
                    LINE (mx% - scan_w2%, cy%)-(mx% + scan_w2%, cy%), PAINT_COLOR~&
                NEXT cy%
            ELSE
                half% = pixel_size% \ 2
                LINE (mx% - half%, my% - half%)-(mx% + half%, my% + half%), PAINT_COLOR~&, BF
            END IF
        END IF
    END IF
END SUB


''
' Draw spray tool preview (circle outline + dot pattern).
' @param mx INTEGER Screen X coordinate for the spray radius center
' @param my INTEGER Screen Y coordinate for the spray radius center
' @param is_painting INTEGER TRUE when actively spraying; hides center crosshair during strokes
'
SUB POINTER_draw_spray_preview (mx AS INTEGER, my AS INTEGER, is_painting AS INTEGER)
    DIM spray_radius AS INTEGER

    ' Get radius from brush size system (matches SPRAY_on formula)
    spray_radius% = INT((BRUSH_PIXEL_SIZES(BRUSH_SIZE.CURRENT) * 2 + 2) * SCRN.zoom!)
    IF spray_radius% < 4 THEN spray_radius% = 4

    ' Draw circle outline only (no fill dots) — lightweight and sufficient
    CIRCLE (mx%, my%), spray_radius% + 1, _RGBA32(32, 32, 32, 84)
    CIRCLE (mx%, my%), spray_radius%, _RGBA32(255, 255, 255, 84)

    ' Draw center crosshair when not painting
    IF NOT is_painting% THEN
        LINE (mx% - 3, my%)-(mx% + 3, my%), _RGBA32(32, 32, 32, 84)
        LINE (mx%, my% - 3)-(mx%, my% + 3), _RGBA32(32, 32, 32, 84)
        LINE (mx% - 2, my%)-(mx% + 2, my%), _RGBA32(255, 255, 255, 84)
        LINE (mx%, my% - 2)-(mx%, my% + 2), _RGBA32(255, 255, 255, 84)
    END IF
END SUB


''
' Draw marquee tool cursor (PNG with flip support or procedural fallback).
' @param mx INTEGER Screen X coordinate to draw the cursor at
' @param my INTEGER Screen Y coordinate to draw the cursor at
'


''
' Draw move tool cursor (PNG with flip support or procedural 4-dir arrows fallback).
' @param mx INTEGER Screen X coordinate to draw the cursor at
' @param my INTEGER Screen Y coordinate to draw the cursor at
'


''
' Draw fill tool cursor (PNG bucket or procedural fallback).
' @param mx INTEGER Screen X coordinate to draw the cursor at
' @param my INTEGER Screen Y coordinate to draw the cursor at
'


''
' Draw arrow cursor overlay for brush/spray tools (PNG brush arrow or procedural fallback).
' Determines whether arrow should be shown based on tool state and painting status.
' @param mx INTEGER Screen X coordinate to draw the arrow overlay at
' @param my INTEGER Screen Y coordinate to draw the arrow overlay at
' @param is_painting INTEGER TRUE when actively painting; suppresses arrow for brush/dot/eraser/spray tools
'


''
' Draws the pointer
' 
''
' Stamp the small "denied" badge over whatever tool cursor was just drawn.
'
' Only fires when POINTER_render decided on the COMPOSITE presentation — i.e.
' the tool has its own art worth keeping. Position comes from the host cursor's
' denied_dx/denied_dy in the theme, measured from the mouse point rather than
' the image corner so it lands consistently whatever that cursor's hotspot is.
'
' @param mx INTEGER Mouse X (raw screen)
' @param my INTEGER Mouse Y (raw screen)
'


' Maps the active marquee variant to its cursor slot (all hardware-drawn).
FUNCTION POINTER_marquee_cursor_for_variant% ()
    SELECT CASE MARQUEE.VARIANT
        CASE TOOL_SELECT_RECT    : POINTER_marquee_cursor_for_variant% = CURSOR_MARQUEE_RECT
        CASE TOOL_SELECT_FREE    : POINTER_marquee_cursor_for_variant% = CURSOR_MARQUEE_FREE
        CASE TOOL_SELECT_POLY    : POINTER_marquee_cursor_for_variant% = CURSOR_MARQUEE_POLY
        CASE TOOL_SELECT_ELLIPSE : POINTER_marquee_cursor_for_variant% = CURSOR_MARQUEE_ELLIP
        CASE TOOL_SELECT_WAND    : POINTER_marquee_cursor_for_variant% = CURSOR_WAND
        CASE ELSE                : POINTER_marquee_cursor_for_variant% = CURSOR_MARQUEE
    END SELECT
END FUNCTION

SUB POINTER_draw ()
    ' The pointer ICON is drawn by the OS now (hardware cursor via _MOUSECURSOR, or
    ' OS-stock crosshair/I-beam) — render-free. This SUB only adds the canvas-aware
    ' FEEDBACK a fixed cursor bitmap can't express: brush/spray footprint rings and
    ' the custom-brush stamp. (The picker loupe and SHIFT crosshair render elsewhere.)
    DIM oldDest AS LONG, is_painting AS INTEGER, mx AS INTEGER, my AS INTEGER

    ' No canvas feedback while panning, over UI chrome, over the preview window, or
    ' during image-import placement.
    IF SCRN.panning% THEN EXIT SUB
    IF POINTER.CURSOR_ID% = CURSOR_NULL THEN EXIT SUB
    IF PREVIEW.visible% AND NOT PREVIEW.autoHidden% AND (PREVIEW_hit_window%(MOUSE.RAW_X%, MOUSE.RAW_Y%) OR PREVIEW.resizing%) THEN EXIT SUB
    IF IMG_IMPORT.STATE > IMPORT_STATE_IDLE THEN EXIT SUB

    oldDest& = _DEST
    _DEST SCRN.CANVAS&
    _BLEND SCRN.CANVAS&
    mx% = MOUSE.RAW_X%
    my% = MOUSE.RAW_Y%
    is_painting% = MOUSE.B1%

    ' Custom-brush stamp for drawing / unfilled-shape tools.
    IF CUSTOM_BRUSH_is_active% THEN
        SELECT CASE CURRENT_TOOL%
            CASE TOOL_DOT, TOOL_BRUSH, TOOL_SPRAY, TOOL_LINE, TOOL_POLYGON, TOOL_RECT, TOOL_ELLIPSE, TOOL_RECT_FILLED, TOOL_ELLIPSE_FILLED, TOOL_POLYGON_FILLED
                POINTER_draw_custom_brush mx%, my%
                _DEST oldDest&
                EXIT SUB
        END SELECT
    END IF

    ' Brush / spray footprint rings (size + position aid).
    SELECT CASE CURRENT_TOOL%
        CASE TOOL_BRUSH, TOOL_DOT, TOOL_ERASER
            POINTER_draw_brush_preview mx%, my%, is_painting%
        CASE TOOL_SPRAY
            POINTER_draw_spray_preview mx%, my%, is_painting%
    END SELECT

    _DEST oldDest&
END SUB


''
' Updates the pointer
' 
SUB POINTER_update ()
    POINTER.C~& = PAINT_COLOR~&
END SUB


''
' Draws dotted crosshair cursor for marquee tool
' - 8x8 dotted crosshair
' - Semi-transparent (33% opaque = 84/255 alpha)
' - White with black outline like brush cursor
'

''
' Draw I-beam cursor for text tool
'


''
' Returns the variant-specific marquee cursor index based on MARQUEE.VARIANT.
' Maps each selection sub-tool to its dedicated crosshair cursor PNG.
' Falls back to generic CURSOR_MARQUEE if variant is unrecognized.
' @return INTEGER - Cursor index constant for the active marquee variant
'


''
' Returns the padding (in canvas pixels) around the pointer position needed
' for the dirty-rect fast path. Accounts for cursor type and brush preview size.
' @return INTEGER - Padding in pixels for the dirty-rect calculation
'
FUNCTION POINTER_get_dirty_pad% ()
    DIM pad AS INTEGER
    pad% = 32 ' Default: covers PNG cursors + overlays (max ~21px cursor + color chips)

    ' Brush / Dot / Eraser tool: circle preview radius = BRUSH_SIZE_pixels * zoom / 2
    IF CURRENT_TOOL% = TOOL_BRUSH OR CURRENT_TOOL% = TOOL_DOT OR CURRENT_TOOL% = TOOL_ERASER THEN
        DIM bp AS INTEGER
        bp% = INT(BRUSH_SIZE_pixels% * SCRN.zoom! / 2) + 4
        IF bp% > pad% THEN pad% = bp%
    END IF

    ' Spray tool: same radius calculation as spray preview
    IF CURRENT_TOOL% = TOOL_SPRAY THEN
        DIM sp AS INTEGER
        sp% = INT((BRUSH_PIXEL_SIZES(BRUSH_SIZE.CURRENT) * 2 + 2) * SCRN.zoom!) + 4
        IF sp% > pad% THEN pad% = sp%
    END IF

    ' Custom brush: scaled stamp preview
    IF CUSTOM_BRUSH_is_active% THEN
        DIM cbw AS INTEGER, cbh AS INTEGER
        cbw% = INT(CUSTOM_BRUSH.WIDTH% * SCRN.zoom! / 2) + 4
        cbh% = INT(CUSTOM_BRUSH.HEIGHT% * SCRN.zoom! / 2) + 4
        IF cbw% > pad% THEN pad% = cbw%
        IF cbh% > pad% THEN pad% = cbh%
    END IF

    POINTER_get_dirty_pad% = pad%
END FUNCTION


