''
' DRAW - GUI/PANEL-SURFACE.BM
' =============================================================================
' Panel surfaces - see GUI/PANEL-SURFACE.BI for the model.
' =============================================================================
$INCLUDEONCE

''
' Does dock panel id draw into its own surface (a Scale that is not its Auto)?
FUNCTION PSURF_on% (id AS INTEGER)
    DIM s AS SINGLE
    IF id < 1 _ORELSE id > PSURF_N THEN EXIT FUNCTION
    IF FPANEL_has_scale%(id) = 0 THEN EXIT FUNCTION
    s = FPANEL_scale_set!(id)
    IF s = 0 THEN EXIT FUNCTION
    PSURF_on% = (s <> FPANEL_auto_scale%(id))
END FUNCTION


FUNCTION PSURF_ds% ()
    DIM ds AS INTEGER
    ds = SCRN.displayScale%: IF ds < 1 THEN ds = 1
    PSURF_ds% = ds
END FUNCTION


''
' Screen px a panel unit of panel id (its Scale over its unit: a unit is one
' viewport px of the panel drawn at Auto, which is PSURF_unit_k% screen px).
FUNCTION PSURF_k% (id AS INTEGER)
    PSURF_k% = INT(PSURF_kf!(id))
END FUNCTION

' ... with a half step (1.5, 2.5 ..: FPANEL_half_ok%) - all the unit math
' goes through this one
FUNCTION PSURF_kf! (id AS INTEGER)
    DIM k AS SINGLE
    k = FPANEL_scale_f!(id)
    IF k < 1 THEN k = 1
    PSURF_kf! = k
END FUNCTION


''
' Panel units -> viewport px (rounded up: the footprint holds every unit)
FUNCTION PSURF_v% (id AS INTEGER, u AS INTEGER)
    IF PSURF_on%(id) = 0 THEN PSURF_v% = u: EXIT FUNCTION
    PSURF_v% = -INT(-(CLNG(u) * PSURF_kf!(id)) / PSURF_ds%)
END FUNCTION


''
' The widget scale a toolbox-family panel draws at: its own (1-4) at Auto,
' 1 at its own Scale (a unit is then one icon px, k screen px).
FUNCTION PSURF_unit_scale% (id AS INTEGER, autoScale AS INTEGER)
    DIM s AS INTEGER
    IF PSURF_on%(id) THEN PSURF_unit_scale% = 1: EXIT FUNCTION
    s = autoScale: IF s < 1 THEN s = 1
    IF s > 4 THEN s = 4
    PSURF_unit_scale% = s
END FUNCTION

FUNCTION TOOLBAR_scale% ()
    TOOLBAR_scale% = PSURF_unit_scale%(DP_TOOLBOX, CFG.TOOLBAR_SCALE%)
END FUNCTION

FUNCTION ORGANIZER_scale% ()
    ORGANIZER_scale% = PSURF_unit_scale%(DP_ORGANIZER, USCALE.organizer%)
END FUNCTION

FUNCTION DRAWER_scale% ()
    DRAWER_scale% = PSURF_unit_scale%(DP_DRAWER, USCALE.drawer%)
END FUNCTION


''
' Units of panel a -> units of panel b (through the viewport: the toolbox,
' organizer and drawer share a column width).
FUNCTION PSURF_u_of% (b AS INTEGER, a AS INTEGER, u AS INTEGER)
    PSURF_u_of% = PSURF_u%(b, PSURF_v%(a, u))
END FUNCTION


''
' Viewport px -> panel units (rounded down: never past the footprint)
FUNCTION PSURF_u% (id AS INTEGER, v AS INTEGER)
    IF PSURF_on%(id) = 0 THEN PSURF_u% = v: EXIT FUNCTION
    PSURF_u% = INT(CLNG(v) * PSURF_ds% / PSURF_kf!(id))
END FUNCTION


''
' The dock gave panel id the viewport rect (x, y, w, h): its footprint; the
' panel lays out in uw x uh units from (x, y).
SUB PSURF_set_rect (id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    IF id < 1 _ORELSE id > PSURF_N THEN EXIT SUB
    PSURF(id).vx = x: PSURF(id).vy = y: PSURF(id).vw = w: PSURF(id).vh = h
    PSURF(id).uw = PSURF_u%(id, w): PSURF(id).uh = PSURF_u%(id, h)
END SUB


''
' The pointer's window position on one axis for viewport coord raw (the live
' window position when raw is the pointer's own, else raw's middle).
FUNCTION PSURF_win% (raw AS INTEGER, liveRaw AS INTEGER, liveWin AS INTEGER)
    DIM ds AS INTEGER
    ds = PSURF_ds%
    IF raw = liveRaw _ANDALSO liveWin \ ds = raw THEN PSURF_win% = liveWin ELSE PSURF_win% = raw * ds + ds \ 2
END FUNCTION


''
' Viewport x / y of the pointer -> panel id's units (unchanged when id draws
' into the viewport).
FUNCTION PSURF_mx% (id AS INTEGER, rawX AS INTEGER)
    IF PSURF_on%(id) = 0 THEN PSURF_mx% = rawX: EXIT FUNCTION
    PSURF_mx% = PSURF(id).vx + INT((PSURF_win%(rawX, MOUSE.RAW_X%, MOUSE.WIN_X%) - CLNG(PSURF(id).vx) * PSURF_ds%) / PSURF_kf!(id))
END FUNCTION

FUNCTION PSURF_my% (id AS INTEGER, rawY AS INTEGER)
    IF PSURF_on%(id) = 0 THEN PSURF_my% = rawY: EXIT FUNCTION
    PSURF_my% = PSURF(id).vy + INT((PSURF_win%(rawY, MOUSE.RAW_Y%, MOUSE.WIN_Y%) - CLNG(PSURF(id).vy) * PSURF_ds%) / PSURF_kf!(id))
END FUNCTION


''
' A rect of panel id in units -> viewport px (tooltips, the toolbar editor's
' marks, QA dumps).
SUB PSURF_rect_to_view (id AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    DIM k AS SINGLE, ds AS INTEGER, x2 AS LONG, y2 AS LONG
    IF PSURF_on%(id) = 0 _ORELSE w <= 0 _ORELSE h <= 0 THEN EXIT SUB ' (not drawn: left as it is)
    k = PSURF_kf!(id): ds = PSURF_ds%
    x2 = x + w: y2 = y + h
    x = PSURF(id).vx + INT(CLNG(x - PSURF(id).vx) * k / ds)
    y = PSURF(id).vy + INT(CLNG(y - PSURF(id).vy) * k / ds)
    w = -INT(-(CLNG(PSURF(id).vx) * ds + (x2 - PSURF(id).vx) * k) / ds) - x
    h = -INT(-(CLNG(PSURF(id).vy) * ds + (y2 - PSURF(id).vy) * k) / ds) - y
END SUB


''
' A font about to be freed: no panel surface (nor the current destination)
' may still have it as its font - _FREEFONT of a bound font is an error.
SUB PSURF_font_release (f AS LONG)
    DIM id AS INTEGER
    IF f <= 16 THEN EXIT SUB
    FOR id = 1 TO PSURF_N
        IF PSURF(id).img < -1 THEN
            IF _FONT(PSURF(id).img) = f THEN _FONT 16, PSURF(id).img
        END IF
    NEXT id
    IF _FONT = f THEN _FONT 16
END SUB


''
' Is viewport (mx, my) on panel id's footprint?
FUNCTION PSURF_in% (id AS INTEGER, mx AS INTEGER, my AS INTEGER)
    PSURF_in% = (mx >= PSURF(id).vx _ANDALSO mx < PSURF(id).vx + PSURF(id).vw _ANDALSO my >= PSURF(id).vy _ANDALSO my < PSURF(id).vy + PSURF(id).vh)
END FUNCTION


''
' The background a panel's footprint shows in the viewport (under its surface).
FUNCTION PSURF_bg~& (id AS INTEGER)
    SELECT CASE id
        CASE DP_LAYERS: PSURF_bg~& = THEME.LAYER_PANEL_bg~&
        CASE DP_TOOLBOX, DP_ORGANIZER, DP_WORKFLOW: PSURF_bg~& = THEME.TOOLBAR_bg~&
        CASE DP_DRAWER: PSURF_bg~& = THEME.BINS_BG_COLOR~&
        CASE DP_CHARMAP: PSURF_bg~& = THEME.CHARMAP_BG~&
        CASE ELSE: PSURF_bg~& = THEME.EDIT_BAR_BG_COLOR~&
    END SELECT
END FUNCTION


''
' Draw dock panel id: into the current destination (Auto), or into its own
' surface at its Scale, leaving its footprint here filled with its background.
SUB PSURF_render (id AS INTEGER)
    DIM oldDest AS LONG, oldFont AS LONG, needW AS INTEGER, needH AS INTEGER, rg AS INTEGER
    IF PSURF_on%(id) = 0 THEN
        IF id >= 1 _ANDALSO id <= PSURF_N THEN
            PSURF(id).ready = FALSE
            HSC_free id
        END IF
        DOCK_render_panel_content id
        EXIT SUB
    END IF
    IF PSURF(id).uw < 1 _ORELSE PSURF(id).uh < 1 THEN EXIT SUB
    oldDest = _DEST: oldFont = _FONT
    needW = PSURF(id).vx + PSURF(id).uw: needH = PSURF(id).vy + PSURF(id).uh
    IF PSURF(id).img < -1 THEN
        IF _WIDTH(PSURF(id).img) < needW _ORELSE _HEIGHT(PSURF(id).img) < needH THEN _FREEIMAGE PSURF(id).img: PSURF(id).img = 0
    END IF
    IF PSURF(id).img >= -1 THEN PSURF(id).img = _NEWIMAGE(_MAX(needW, 16), _MAX(needH, 16), 32)
    _DEST PSURF(id).img
    _FONT oldFont
    LINE (PSURF(id).vx, PSURF(id).vy)-(needW - 1, needH - 1), PSURF_bg~&(id), BF
    DOCK_render_panel_content id
    _DEST oldDest: _FONT oldFont
    ' the viewport keeps the footprint: background, and the hit region
    LINE (PSURF(id).vx, PSURF(id).vy)-(PSURF(id).vx + PSURF(id).vw - 1, PSURF(id).vy + PSURF(id).vh - 1), PSURF_bg~&(id), BF
    rg = DOCK_panel_region%(id)
    IF rg > 0 THEN
        REGION_BOUNDS_TABLE(rg).x = PSURF(id).vx: REGION_BOUNDS_TABLE(rg).y = PSURF(id).vy
        REGION_BOUNDS_TABLE(rg).w = PSURF(id).vw: REGION_BOUNDS_TABLE(rg).h = PSURF(id).vh
    END IF
    PSURF(id).k = PSURF_kf!(id)
    PSURF(id).ready = TRUE
    PSURF(id).sdirty = TRUE
END SUB


''
' Panel id's surface onto the window (screen 0), over its footprint.
SUB PSURF_blit (id AS INTEGER)
    DIM sx AS SINGLE, sy AS SINGLE, x0 AS LONG, y0 AS LONG, fw AS LONG, fh AS LONG
    DIM k AS SINGLE, uw AS INTEGER, uh AS INTEGER, oldDest AS LONG
    IF id < 1 _ORELSE id > PSURF_N THEN EXIT SUB
    IF PSURF(id).ready = 0 _ORELSE PSURF(id).img >= -1 THEN EXIT SUB
    IF PSURF_on%(id) = 0 _ORELSE DOCK_live%(id) = 0 THEN EXIT SUB
    IF SCRN.w& < 1 _ORELSE SCRN.h& < 1 THEN EXIT SUB
    sx = _WIDTH(0) / SCRN.w&: sy = _HEIGHT(0) / SCRN.h&
    k = PSURF(id).k: IF k < 1 THEN k = 1
    x0 = INT(PSURF(id).vx * sx): y0 = INT(PSURF(id).vy * sy)
    fw = INT((PSURF(id).vx + PSURF(id).vw) * sx) - x0
    fh = INT((PSURF(id).vy + PSURF(id).vh) * sy) - y0
    uw = _MIN(PSURF(id).uw, INT(fw / k)): uh = _MIN(PSURF(id).uh, INT(fh / k))
    ' a half step: an even count of units, so they span whole screen px and the
    ' stretch is exactly k (unit u = screen px INT(u * k) .., as PSURF_mx% reads)
    IF uw * k <> INT(uw * k) THEN uw = uw - 1
    IF uh * k <> INT(uh * k) THEN uh = uh - 1
    IF uw < 1 _ORELSE uh < 1 THEN EXIT SUB
    oldDest = _DEST
    HSC_put id, PSURF(id).img, PSURF(id).vx, PSURF(id).vy, uw, uh, x0, y0, CLNG(uw * k), CLNG(uh * k), _IIF(PSURF(id).sdirty, 1, 2)
    PSURF(id).sdirty = FALSE
    _DEST oldDest
END SUB


''
' Copy the source rect (sx, sy, sw, sh) of src onto the window (screen 0) at (dx, dy),
' dw x dh screen px - every panel and native window at its own Scale comes through
' here. A whole step is a plain stretch (as before); a half step (1.5x, 2.5x ..: Rick
' 2026-11-18, the Tiny5 text "crunchy looking" at nearest - "can we use bicubic scale
' on .5 sizes?") is resampled by native/halfscale (CFG.PANEL_HALF_FILTER: 1 BICUBIC,
' 2 SHARP = nearest to the next whole scale, then bicubic down; 0 NEAREST = the plain
' stretch). The result is kept in HSC_IMG(slot) and redone only when the source
' changed: mode 0 = compare it with HSC_COPY(slot), 1 = it did change, 2 = it did not
' (the dock panels know: PSURF(id).sdirty). Slot 0 = no cache (small pieces).
SUB HSC_put (slot AS INTEGER, src AS LONG, sx AS LONG, sy AS LONG, sw AS LONG, sh AS LONG, dx AS LONG, dy AS LONG, dw AS LONG, dh AS LONG, mode AS INTEGER)
    DIM changed AS INTEGER, pre AS LONG, k AS SINGLE, ms AS _MEM, md AS _MEM
    DECLARE LIBRARY "../native/halfscale"
        SUB gj_halfscale (BYVAL dst AS _OFFSET, BYVAL dw AS LONG, BYVAL dh AS LONG, BYVAL src AS _OFFSET, BYVAL sstride AS LONG, BYVAL sx AS LONG, BYVAL sy AS LONG, BYVAL sw AS LONG, BYVAL sh AS LONG, BYVAL pre AS LONG)
        FUNCTION gj_region_changed& (BYVAL src AS _OFFSET, BYVAL sstride AS LONG, BYVAL sx AS LONG, BYVAL sy AS LONG, BYVAL sw AS LONG, BYVAL sh AS LONG, BYVAL copy AS _OFFSET)
    END DECLARE
    IF src >= -1 _ORELSE sw < 1 _ORELSE sh < 1 _ORELSE dw < 1 _ORELSE dh < 1 THEN EXIT SUB
    IF THEMEED.started THEN THEMEED_hsc_note THEMEED_hsc_region%(slot), src, sx, sy, sw, sh, dx, dy, dw, dh ' Theme Edit: where its parts went (CFG/THEME-EDIT)
    IF CFG.PANEL_HALF_FILTER% = 0 _ORELSE slot < 0 _ORELSE slot > HSC_N _ORELSE ((dw MOD sw) = 0 _ANDALSO (dh MOD sh) = 0) THEN
        _PUTIMAGE (dx, dy)-(dx + dw - 1, dy + dh - 1), src, 0, (sx, sy)-(sx + sw - 1, sy + sh - 1)
        EXIT SUB
    END IF
    pre = 1
    IF CFG.PANEL_HALF_FILTER% = 2 THEN k = dw / sw: pre = -INT(-k)
    IF slot = 0 THEN ' small pieces drawn several a frame (flyout icons, dropdown boxes): no cache
        DIM tmp AS LONG
        tmp = _NEWIMAGE(dw, dh, 32)
        IF tmp >= -1 THEN EXIT SUB
        ms = _MEMIMAGE(src): md = _MEMIMAGE(tmp)
        gj_halfscale md.OFFSET, dw, dh, ms.OFFSET, _WIDTH(src), sx, sy, sw, sh, pre
        _MEMFREE ms: _MEMFREE md
        _PUTIMAGE (dx, dy), tmp, 0
        _FREEIMAGE tmp
        EXIT SUB
    END IF
    changed = (mode = 1)
    IF HSC_IMG(slot) < -1 THEN
        IF _WIDTH(HSC_IMG(slot)) <> dw _ORELSE _HEIGHT(HSC_IMG(slot)) <> dh THEN _FREEIMAGE HSC_IMG(slot): HSC_IMG(slot) = 0
    END IF
    IF HSC_IMG(slot) >= -1 THEN
        HSC_IMG(slot) = _NEWIMAGE(dw, dh, 32)
        IF HSC_IMG(slot) >= -1 THEN HSC_IMG(slot) = 0: EXIT SUB
        changed = TRUE
    END IF
    IF mode = 0 THEN
        IF HSC_COPY(slot) < -1 THEN
            IF _WIDTH(HSC_COPY(slot)) <> sw _ORELSE _HEIGHT(HSC_COPY(slot)) <> sh THEN _FREEIMAGE HSC_COPY(slot): HSC_COPY(slot) = 0
        END IF
        IF HSC_COPY(slot) >= -1 THEN
            HSC_COPY(slot) = _NEWIMAGE(sw, sh, 32)
            IF HSC_COPY(slot) >= -1 THEN HSC_COPY(slot) = 0: EXIT SUB
            changed = TRUE
        END IF
        ms = _MEMIMAGE(src): md = _MEMIMAGE(HSC_COPY(slot))
        IF gj_region_changed&(ms.OFFSET, _WIDTH(src), sx, sy, sw, sh, md.OFFSET) THEN changed = TRUE
        _MEMFREE ms: _MEMFREE md
    END IF
    IF changed THEN
        ms = _MEMIMAGE(src): md = _MEMIMAGE(HSC_IMG(slot))
        gj_halfscale md.OFFSET, dw, dh, ms.OFFSET, _WIDTH(src), sx, sy, sw, sh, pre
        _MEMFREE ms: _MEMFREE md
    END IF
    _PUTIMAGE (dx, dy), HSC_IMG(slot), 0
END SUB

' A slot's pictures, freed (its panel back at a whole step / hidden)
SUB HSC_free (slot AS INTEGER)
    IF slot < 1 _ORELSE slot > HSC_N THEN EXIT SUB
    IF HSC_IMG(slot) < -1 THEN _FREEIMAGE HSC_IMG(slot)
    IF HSC_COPY(slot) < -1 THEN _FREEIMAGE HSC_COPY(slot)
    HSC_IMG(slot) = 0: HSC_COPY(slot) = 0
END SUB


''
' Every docked (not floating) panel's surface onto the window - the floating
' ones go in their z order (SCREEN_render_windows).
SUB PSURF_blit_docked ()
    DIM id AS INTEGER, c AS INTEGER, sx AS INTEGER, ds AS INTEGER, oldDest AS LONG
    ds = PSURF_ds%
    FOR id = 1 TO PSURF_N
        IF DOCK_floating%(id) = 0 _ANDALSO PSURF(id).ready _ANDALSO PSURF_on%(id) _ANDALSO DOCK_live%(id) THEN
            PSURF_blit id
            ' its column's seam (the one line on the column's inner edge) back
            ' over it, as for the docked native windows (DOCK_render_native_seams)
            IF DPANEL(id).slot > 0 THEN
                c = DOCK_SLOT(DPANEL(id).slot).col
                IF DOCK_seam_x%(c, sx) THEN
                    IF sx >= PSURF(id).vx _ANDALSO sx < PSURF(id).vx + PSURF(id).vw THEN
                        oldDest = _DEST: _DEST 0
                        LINE (CLNG(sx) * ds, CLNG(PSURF(id).vy) * ds)-(CLNG(sx) * ds + ds - 1, CLNG(PSURF(id).vy + PSURF(id).vh) * ds - 1), DOCK_seam_color~&(c), BF
                        _DEST oldDest
                    END IF
                END IF
                ' a top / bottom row's seam too (its canvas-side pixel row is
                ' inside the slot: a Toolbox at its own Scale painted over it -
                ' Rick's GJ2 / GRAFX2 workspaces, workspace-builtins-load.sh)
                IF DOCK_row_seam_y%(c, sx) THEN
                    IF sx >= PSURF(id).vy _ANDALSO sx < PSURF(id).vy + PSURF(id).vh THEN
                        oldDest = _DEST: _DEST 0
                        LINE (CLNG(PSURF(id).vx) * ds, CLNG(sx) * ds)-(CLNG(PSURF(id).vx + PSURF(id).vw) * ds - 1, CLNG(sx) * ds + ds - 1), DOCK_seam_color~&(c), BF
                        _DEST oldDest
                    END IF
                END IF
            END IF
        END IF
    NEXT id
END SUB
