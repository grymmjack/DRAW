''
' DRAW - GUI/PALETTE-STRIP.BM
' =============================================================================
' Palette strip GUI component implementation.
'
' Layout: [<] [color swatches...] [>] [palette name v]
' - Arrows scroll colors within current palette
' - Clicking palette name opens dropdown menu to select palette
' - Mouse wheel over strip scrolls colors
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE


''
' The x range a horizontal strip spans: the whole window at the bottom (the
' full-height columns end above it); under the menu bar at the top, between
' the full-height columns like the menu bar itself.
SUB PALETTE_STRIP_hspan (x1 AS INTEGER, x2 AS INTEGER)
    x1 = 0: x2 = SCRN.w& - 1
    IF PALETTE_STRIP_edge% = PSTRIP_TOP _ANDALSO DOCK_MENU_RX > DOCK_MENU_LX THEN x1 = DOCK_MENU_LX: x2 = DOCK_MENU_RX
END SUB

''
' Where the strip docks (CFG.PALETTE_STRIP_EDGE, PSTRIP_*).
FUNCTION PALETTE_STRIP_edge% ()
    DIM e AS INTEGER
    e = CFG.PALETTE_STRIP_EDGE%
    IF e < PSTRIP_BOTTOM _ORELSE e > PSTRIP_RIGHT THEN e = PSTRIP_BOTTOM
    PALETTE_STRIP_edge% = e
END FUNCTION

''
' Is the strip on screen (it shows with the status bar, unless a workspace hid it)?
FUNCTION PALETTE_STRIP_on% ()
    PALETTE_STRIP_on% = (PALETTE_STRIP_HIDDEN = 0 _ANDALSO PALETTE_STRIP_VISIBLE% <> 0 _ANDALSO SCRN.showStatus% <> 0)
END FUNCTION

''
' Left edge of the palette-name dropdown area on a horizontal strip. It lines
' up with the layer panel's left edge when that panel is docked on the right,
' so the name gets the panel's full width (and reads as part of that column);
' otherwise a fixed 100px area at the strip's right end.
'
FUNCTION PALETTE_STRIP_name_x% ()
    DIM x1 AS INTEGER, x2 AS INTEGER, nx AS INTEGER
    PALETTE_STRIP_hspan x1, x2
    nx% = x2 + 1 - 100
    IF LAYER_PANEL.visible% _ANDALSO LAYER_PANEL.panelX1% > (x1 + x2) \ 2 _ANDALSO LAYER_PANEL.panelX1% < nx% THEN
        nx% = LAYER_PANEL.panelX1%
    END IF
    PALETTE_STRIP_name_x% = nx%
END FUNCTION

''
' Width of the palette-name dropdown area (strip right end minus its left).
'
FUNCTION PALETTE_STRIP_name_w% ()
    DIM x1 AS INTEGER, x2 AS INTEGER
    PALETTE_STRIP_hspan x1, x2
    PALETTE_STRIP_name_w% = x2 + 1 - PALETTE_STRIP_name_x%
END FUNCTION

''
' The chips that fit avail px of a line (cell = one chip + its 1px gap), the
' palette's colour count over them, and how many lines (rows - or a side
' strip's columns): the config's MAX_CHIPS_PER_ROW / MIN_ROWS / MAX_ROWS,
' turned sideways for a side strip.
SUB PALETTE_STRIP_fit (avail AS INTEGER, cell AS INTEGER, perLine AS INTEGER, lines AS INTEGER)
    DIM n AS INTEGER
    n = PALETTE_LOADER_get_color_count%
    IF n < 1 THEN n = 1
    IF cell < 1 THEN cell = 1
    perLine = avail \ cell
    IF perLine > CFG.PALETTE_MAX_CHIPS_PER_ROW% THEN perLine = CFG.PALETTE_MAX_CHIPS_PER_ROW%
    IF perLine < 1 THEN perLine = 1
    lines = ((n - 1) \ perLine) + 1
    IF lines < CFG.PALETTE_MIN_ROWS% THEN lines = CFG.PALETTE_MIN_ROWS%
    IF lines > CFG.PALETTE_MAX_ROWS% THEN lines = CFG.PALETTE_MAX_ROWS%
    IF lines < 1 THEN lines = 1
END SUB

''
' A horizontal strip's height (top or bottom), whatever edge it is on now.
FUNCTION PALETTE_STRIP_band_h% ()
    DIM x1 AS INTEGER, x2 AS INTEGER, pl AS INTEGER, ln AS INTEGER
    PALETTE_STRIP_hspan x1, x2
    PALETTE_STRIP_fit (x2 - x1 + 1) - (PALETTE_STRIP_ARROW_WIDTH * 2) - PALETTE_STRIP_name_w% - 12, CFG.PALETTE_CHIP_WIDTH% + 1, pl, ln
    PALETTE_STRIP_band_h% = ln * (CFG.PALETTE_CHIP_HEIGHT% + 1) + 3
END FUNCTION

''
' The height the strip takes at the BOTTOM (above the status bar) - 0 when it
' is docked elsewhere. Every layout caller reserves this much under the canvas.
' @return INTEGER - Height in pixels
'
FUNCTION PALETTE_STRIP_get_height% ()
    IF PALETTE_STRIP_HIDDEN THEN EXIT FUNCTION ' every layout caller then reserves nothing
    IF PALETTE_STRIP_edge% <> PSTRIP_BOTTOM THEN EXIT FUNCTION
    PALETTE_STRIP_get_height% = PALETTE_STRIP_band_h%
END FUNCTION

''
' The height the strip takes under the menu bar (docked at the TOP), else 0.
FUNCTION PALETTE_STRIP_top_h% ()
    IF PALETTE_STRIP_on% = 0 _ORELSE PALETTE_STRIP_edge% <> PSTRIP_TOP THEN EXIT FUNCTION
    PALETTE_STRIP_top_h% = PALETTE_STRIP_band_h%
END FUNCTION

''
' A side strip's top / bottom: under the menu bar (or from the window's top when
' a full-height column keeps the menu bar off that edge), down to the status bar.
SUB PALETTE_STRIP_vspan (edge AS INTEGER, y1 AS INTEGER, y2 AS INTEGER)
    y1 = 0
    IF SCRN.showMenubar% _ANDALSO MENU_BAR.visible% THEN
        IF edge = PSTRIP_LEFT _ANDALSO DOCK_MENU_LX <= 0 THEN y1 = MENU_BAR_HEIGHT
        IF edge = PSTRIP_RIGHT _ANDALSO DOCK_MENU_RX >= SCRN.w& - 1 THEN y1 = MENU_BAR_HEIGHT
    END IF
    y2 = SCRN.h& - 1
    IF SCRN.showStatus% THEN y2 = SCRN.h& - THEME.STATUS_height% - 1
END SUB

''
' A side strip's width: its columns of chips (the rows setting, sideways) at
' the chip width - never narrower than its scroll buttons. 0 on any other edge
' (or off): the docks lay out inside it (DOCK_WX1 / DOCK_WX2).
FUNCTION PALETTE_STRIP_side_w% ()
    DIM e AS INTEGER, y1 AS INTEGER, y2 AS INTEGER, pl AS INTEGER, ln AS INTEGER, w AS INTEGER
    IF PALETTE_STRIP_on% = 0 THEN EXIT FUNCTION
    e = PALETTE_STRIP_edge%
    IF e <> PSTRIP_LEFT _ANDALSO e <> PSTRIP_RIGHT THEN EXIT FUNCTION
    PALETTE_STRIP_vspan e, y1, y2
    PALETTE_STRIP_fit (y2 - y1 + 1) - PSTRIP_NAME_H - PSTRIP_ARROW_H * 2 - 6, CFG.PALETTE_CHIP_HEIGHT% + 1, pl, ln
    w = ln * (CFG.PALETTE_CHIP_WIDTH% + 1) + 3
    IF w < 20 THEN w = 20
    PALETTE_STRIP_side_w% = w
END FUNCTION
FUNCTION PALETTE_STRIP_left_w% ()
    IF PALETTE_STRIP_edge% = PSTRIP_LEFT THEN PALETTE_STRIP_left_w% = PALETTE_STRIP_side_w%
END FUNCTION
FUNCTION PALETTE_STRIP_right_w% ()
    IF PALETTE_STRIP_edge% = PSTRIP_RIGHT THEN PALETTE_STRIP_right_w% = PALETTE_STRIP_side_w%
END FUNCTION

''
' Lay the strip out for this frame (SCREEN_compute_layout, after the docks):
' PSG - its rect, its chip grid, scroll buttons and dropdown. Everything that
' draws or hit-tests the strip reads PSG, so they can never disagree.
SUB PALETTE_STRIP_geom ()
    DIM e AS INTEGER, x1 AS INTEGER, x2 AS INTEGER, y1 AS INTEGER, y2 AS INTEGER, n AS INTEGER
    DIM pl AS INTEGER, ln AS INTEGER, avail AS INTEGER
    PSG.shown = PALETTE_STRIP_on%
    e = PALETTE_STRIP_edge%
    PSG.edge = e
    PSG.vert = (e = PSTRIP_LEFT _ORELSE e = PSTRIP_RIGHT)
    PSG.sw = CFG.PALETTE_CHIP_WIDTH%: PSG.sh = CFG.PALETTE_CHIP_HEIGHT%
    n = PALETTE_LOADER_get_color_count%
    IF n < 1 THEN n = 1
    IF PSG.vert THEN
        PALETTE_STRIP_vspan e, y1, y2
        PSG.w = PALETTE_STRIP_side_w%
        IF PSG.w < 1 THEN PSG.w = 20
        IF e = PSTRIP_LEFT THEN PSG.x = 0 ELSE PSG.x = SCRN.w& - PSG.w
        PSG.y = y1: PSG.h = y2 - y1 + 1
        ' the dropdown on top, then the up button, the chips, the down button
        PSG.nx = PSG.x + 1: PSG.ny = PSG.y + 1: PSG.nw = PSG.w - 2: PSG.nh = PSTRIP_NAME_H
        PSG.a1x = PSG.x + 1: PSG.a1y = PSG.ny + PSG.nh + 1: PSG.a1w = PSG.w - 2: PSG.a1h = PSTRIP_ARROW_H
        PSG.cx0 = PSG.x + 2: PSG.cy0 = PSG.a1y + PSG.a1h + 1
        avail = (PSG.y + PSG.h) - PSG.cy0 - PSTRIP_ARROW_H - 2
        PALETTE_STRIP_fit avail, PSG.sh + 1, pl, ln
        ln = (PSG.w - 3) \ (PSG.sw + 1) ' the columns the width holds (side_w% made it)
        IF ln < 1 THEN ln = 1
        PSG.perLine = pl: PSG.lines = ln
        PSG.a2x = PSG.a1x: PSG.a2y = PSG.cy0 + pl * (PSG.sh + 1) + 1: PSG.a2w = PSG.a1w: PSG.a2h = PSTRIP_ARROW_H
    ELSE
        PALETTE_STRIP_hspan x1, x2
        PSG.x = x1: PSG.w = x2 - x1 + 1
        PSG.h = PALETTE_STRIP_band_h%
        IF e = PSTRIP_TOP THEN
            PSG.y = 0
            IF SCRN.showMenubar% _ANDALSO MENU_BAR.visible% THEN PSG.y = MENU_BAR_HEIGHT
        ELSE
            PSG.y = SCRN.h& - THEME.STATUS_height% - PSG.h
        END IF
        PALETTE_STRIP_fit PSG.w - (PALETTE_STRIP_ARROW_WIDTH * 2) - PALETTE_STRIP_name_w% - 12, PSG.sw + 1, pl, ln
        PSG.perLine = pl: PSG.lines = ln
        PSG.a1x = PSG.x + 2: PSG.a1y = PSG.y + 1: PSG.a1w = PALETTE_STRIP_ARROW_WIDTH: PSG.a1h = PSG.h - 1
        PSG.cx0 = PSG.a1x + PALETTE_STRIP_ARROW_WIDTH + 2: PSG.cy0 = PSG.y + 2
        PSG.a2x = PSG.cx0 + pl * (PSG.sw + 1) + 2: PSG.a2y = PSG.a1y: PSG.a2w = PALETTE_STRIP_ARROW_WIDTH: PSG.a2h = PSG.a1h
        PSG.nx = PALETTE_STRIP_name_x%: PSG.ny = PSG.y: PSG.nw = (PSG.x + PSG.w - 4) - PSG.nx: PSG.nh = PSG.h
    END IF
    PSG.shownN = PSG.perLine * PSG.lines
    IF PSG.shownN > n THEN PSG.shownN = n
    ' Every color fits: no scrolling, so no arrows (the chips keep their place)
    ' and no rotated view left over from an earlier scroll.
    PSG.allFit = (PSG.perLine * PSG.lines >= n)
    PALETTE_STRIP_ALL_FIT% = PSG.allFit
    IF PSG.allFit THEN PALETTE_STRIP_SCROLL_OFFSET% = 0
    PALETTE_STRIP_Y% = PSG.y
END SUB

''
' The top-left of the strip's i-th shown chip (0-based, before the scroll).
SUB PALETTE_STRIP_chip_xy (i AS INTEGER, x AS INTEGER, y AS INTEGER)
    IF PSG.vert THEN
        x = PSG.cx0 + (i \ PSG.perLine) * (PSG.sw + 1)
        y = PSG.cy0 + (i MOD PSG.perLine) * (PSG.sh + 1)
    ELSE
        x = PSG.cx0 + (i MOD PSG.perLine) * (PSG.sw + 1)
        y = PSG.cy0 + (i \ PSG.perLine) * (PSG.sh + 1)
    END IF
END SUB

''
' The shown chip (0-based, before the scroll) at (x, y), or -1. Across the
' lines a point in the strip's margin counts for the nearest line.
FUNCTION PALETTE_STRIP_chip_at% (x AS INTEGER, y AS INTEGER)
    DIM a AS INTEGER, b AS INTEGER, i AS INTEGER
    PALETTE_STRIP_chip_at% = -1
    IF PSG.shown = 0 _ORELSE PSG.perLine < 1 THEN EXIT FUNCTION
    IF PALETTE_STRIP_in_bounds%(x, y) = 0 THEN EXIT FUNCTION
    IF PSG.vert THEN
        IF y < PSG.cy0 _ORELSE y >= PSG.cy0 + PSG.perLine * (PSG.sh + 1) THEN EXIT FUNCTION
        a = (x - PSG.cx0) \ (PSG.sw + 1) ' column
        IF x < PSG.cx0 THEN a = 0
        IF a >= PSG.lines THEN EXIT FUNCTION
        b = (y - PSG.cy0) \ (PSG.sh + 1)
        i = a * PSG.perLine + b
    ELSE
        IF x < PSG.cx0 _ORELSE x >= PSG.cx0 + PSG.perLine * (PSG.sw + 1) THEN EXIT FUNCTION
        a = (y - PSG.cy0) \ (PSG.sh + 1) ' row
        IF y < PSG.cy0 THEN a = 0
        IF a >= PSG.lines THEN a = PSG.lines - 1
        b = (x - PSG.cx0) \ (PSG.sw + 1)
        i = a * PSG.perLine + b
    END IF
    IF i >= 0 _ANDALSO i < PSG.shownN THEN PALETTE_STRIP_chip_at% = i
END FUNCTION

''
' The palette index under (x, y) on the strip, or -1 (the scroll applied).
FUNCTION PALETTE_STRIP_index_at% (x AS INTEGER, y AS INTEGER)
    DIM i AS INTEGER, n AS INTEGER
    PALETTE_STRIP_index_at% = -1
    n = PALETTE_LOADER_get_color_count%
    IF n < 1 THEN EXIT FUNCTION
    i = PALETTE_STRIP_chip_at%(x, y)
    IF i < 0 THEN EXIT FUNCTION
    PALETTE_STRIP_index_at% = (PALETTE_STRIP_SCROLL_OFFSET% + i) MOD n
END FUNCTION

''
' Over the strip's scroll-back (1) / scroll-on (2) button, else 0. None while
' every colour fits.
FUNCTION PALETTE_STRIP_arrow_at% (x AS INTEGER, y AS INTEGER)
    IF PSG.shown = 0 _ORELSE PSG.allFit THEN EXIT FUNCTION
    IF x >= PSG.a1x _ANDALSO x < PSG.a1x + PSG.a1w _ANDALSO y >= PSG.a1y _ANDALSO y < PSG.a1y + PSG.a1h THEN PALETTE_STRIP_arrow_at% = 1: EXIT FUNCTION
    IF x >= PSG.a2x _ANDALSO x < PSG.a2x + PSG.a2w _ANDALSO y >= PSG.a2y _ANDALSO y < PSG.a2y + PSG.a2h THEN PALETTE_STRIP_arrow_at% = 2
END FUNCTION


''
' Initialize palette strip
'
SUB PALETTE_STRIP_init ()
    DIM uiFontSize AS INTEGER
    PALETTE_STRIP_VISIBLE%        = -1 ' True
    PALETTE_STRIP_HOVER_IDX%      = -1
    PALETTE_STRIP_PREV_HOVER_IDX% = -1
    PALETTE_STRIP_SCROLL_OFFSET%  = 0
    
    ' Position above status bar (will be recalculated in render)
    PALETTE_STRIP_Y% = SCRN.h& - THEME.STATUS_height% - PALETTE_STRIP_get_height%
    
    ' Load Tiny5 font for palette strip
    IF PALETTE_STRIP_FONT& > 16 THEN _FREEFONT PALETTE_STRIP_FONT&
    uiFontSize% = THEME.GLOBAL_FONT_SIZE%
    IF uiFontSize% < 1 THEN uiFontSize% = 8
    PALETTE_STRIP_FONT& = _LOADFONT(THEME_font_path$(THEME.GLOBAL_FONT_FILE$), uiFontSize%)
    IF PALETTE_STRIP_FONT& <= 0 THEN PALETTE_STRIP_FONT& = 16 ' Fallback
    
    ' Initialize menu state
    PALETTE_MENU_VISIBLE% = 0
    PALETTE_MENU_SCROLL%  = 0
    PALETTE_MENU_HOVER%   = -1
END SUB


''
' Render the palette strip
'
SUB PALETTE_STRIP_render ()
    IF PALETTE_STRIP_HIDDEN THEN EXIT SUB
    IF NOT PALETTE_STRIP_VISIBLE% THEN EXIT SUB
    IF PSG.w < 1 _ORELSE PSG.h < 1 THEN PALETTE_STRIP_geom ' (before the first layout)
    
    DIM AS INTEGER x, i, sw, sh, pal_count
    DIM AS _UNSIGNED LONG bg_color, fg_color, arrow_color, hover_color
    DIM pal_name AS STRING
    DIM old_font AS LONG
    
    REGION_set_bounds REGION_PALETTE_STRIP, PSG.x, PSG.y, PSG.w, PSG.h, ZORDER_PANEL
    
    ' Use fixed gray colors for UI (not affected by palette changes)
    bg_color~&    = THEME.PALETTE_STRIP_bg~&
    fg_color~&    = THEME.PALETTE_STRIP_fg~&
    arrow_color~& = THEME.PALETTE_STRIP_arrow_fg~&
    hover_color~& = THEME.PALETTE_STRIP_hover_fg~&
    
    sw% = PSG.sw: sh% = PSG.sh
    pal_count% = PALETTE_LOADER_get_color_count%
    IF pal_count% < 1 THEN pal_count% = 1  ' Minimum 1 to avoid division issues
    pal_name$ = PALETTE_LOADER_get_name$
    
    ' Use raw mouse coordinates for hover detection (GUI uses screen coords, not canvas coords)
    DIM rawMX        AS INTEGER, rawMY AS INTEGER
    DIM mouseInStrip AS INTEGER
    rawMX% = MOUSE.RAW_X%
    rawMY% = MOUSE.RAW_Y%
    ' Only show hover effects if mouse is actually within the palette strip area
    mouseInStrip% = PALETTE_STRIP_in_bounds%(rawMX%, rawMY%)
    
    _DEST SCRN.GUI&
    old_font& = _FONT
    _FONT PALETTE_STRIP_FONT&
    
    ' Background, and the one separator line on its canvas side
    LINE (PSG.x, PSG.y)-(PSG.x + PSG.w - 1, PSG.y + PSG.h - 1), bg_color~&, BF
    SELECT CASE PSG.edge
        CASE PSTRIP_TOP:   LINE (PSG.x, PSG.y + PSG.h - 1)-(PSG.x + PSG.w - 1, PSG.y + PSG.h - 1), THEME.PALETTE_STRIP_separator~&
        CASE PSTRIP_LEFT:  LINE (PSG.x + PSG.w - 1, PSG.y)-(PSG.x + PSG.w - 1, PSG.y + PSG.h - 1), THEME.PALETTE_STRIP_separator~&
        CASE PSTRIP_RIGHT: LINE (PSG.x, PSG.y)-(PSG.x, PSG.y + PSG.h - 1), THEME.PALETTE_STRIP_separator~&
        CASE ELSE:         LINE (PSG.x, PSG.y)-(PSG.x + PSG.w - 1, PSG.y), THEME.PALETTE_STRIP_separator~&
    END SELECT
    
    ' The scroll buttons [<] [>] (a side strip: up / down)
    DIM ab AS INTEGER, ax AS INTEGER, ay AS INTEGER, aw AS INTEGER, ah AS INTEGER, glyph AS STRING
    IF NOT PALETTE_STRIP_ALL_FIT% THEN
        FOR ab = 1 TO 2
            IF ab = 1 THEN
                ax = PSG.a1x: ay = PSG.a1y: aw = PSG.a1w: ah = PSG.a1h
                IF PSG.vert THEN glyph = CHR$(30) ELSE glyph = CHR$(17)
            ELSE
                ax = PSG.a2x: ay = PSG.a2y: aw = PSG.a2w: ah = PSG.a2h
                IF PSG.vert THEN glyph = CHR$(31) ELSE glyph = CHR$(16)
            END IF
            IF mouseInStrip% _ANDALSO PALETTE_STRIP_arrow_at%(rawMX%, rawMY%) = ab THEN
                LINE (ax, ay)-(ax + aw - 1, ay + ah - 1), THEME.PALETTE_STRIP_button_hover_bg~&, BF
                COLOR hover_color~&, THEME.PALETTE_STRIP_button_hover_bg~&
            ELSE
                COLOR arrow_color~&, bg_color~&
            END IF
            IF PSG.vert THEN
                _UPRINTSTRING (ax + (aw - _UPRINTWIDTH(glyph)) \ 2, ay + (ah \ 2) - 3), glyph
            ELSE
                _UPRINTSTRING (ax + 4, PSG.y + (PSG.h \ 2) - 3), glyph ' (arrow x + 4: as before)
            END IF
        NEXT ab
    END IF

    ' Which chips get the FG / BG frame: only one whose color IS the current
    ' FG / BG. PAL_FG_IDX% keeps pointing at the last chip clicked, so after a
    ' color panel / picker sets a color that is not in the palette the old
    ' chip must not stay framed; if the color is elsewhere in the palette,
    ' frame that chip instead.
    DIM fgShow AS INTEGER, bgShow AS INTEGER
    fgShow% = PALETTE_STRIP_chip_for_color%(PAL_FG_IDX%, PAINT_COLOR~&, PAL_FG_IS_TRANSPARENT%, pal_count%)
    bgShow% = PALETTE_STRIP_chip_for_color%(PAL_BG_IDX%, PAINT_BG_COLOR~&, PAL_BG_IS_TRANSPARENT%, pal_count%)

    ' Color Ops: middle-drag delete range preview
    DIM delLo AS INTEGER, delHi AS INTEGER
    delLo% = -1 : delHi% = -2
    IF PALETTE_OPS.ACTIVE% _ANDALSO PALETTE_OPS.DEL_DRAG% _ANDALSO PALETTE_OPS.DEL_START% >= 0 THEN
        delLo% = PALETTE_OPS.DEL_START% : delHi% = PALETTE_OPS.DEL_END%
        IF delHi% < delLo% THEN SWAP delLo%, delHi%
        IF PALETTE_OPS.DEL_SHIFT% THEN delLo% = -1 : delHi% = -2 ' Shift+M = insert, not delete
    END IF

    ' Draw color swatches (dynamic rows based on palette size)
    PCYC_refresh_blocked ' chips that cannot cycle (duplicate color) get a checker band
    
    ' Suppress hover when palette menu is open and mouse is over the menu
    DIM stripHoverOK AS INTEGER, hoverChip AS INTEGER
    stripHoverOK% = TRUE
    IF PALETTE_MENU_VISIBLE% AND PALETTE_MENU_in_bounds%(rawMX%, rawMY%) THEN stripHoverOK% = FALSE
    hoverChip% = -1
    IF stripHoverOK% _ANDALSO mouseInStrip% THEN hoverChip% = PALETTE_STRIP_chip_at%(rawMX%, rawMY%)

    DIM swatch_y AS INTEGER
    FOR i% = 0 TO PSG.shownN - 1
        DIM pal_idx AS INTEGER
        pal_idx% = (PALETTE_STRIP_SCROLL_OFFSET% + i%) MOD pal_count%
        PALETTE_STRIP_chip_xy i%, x%, swatch_y%
        
        ' Draw swatch (while palette cycling runs, a chip in a range shows the
        ' color currently rotated into it - identity otherwise)
        LINE (x%, swatch_y%)-(x% + sw% - 1, swatch_y% + sh% - 1), PAL(PCYC_display_index%(pal_idx%)).value~&, BF
        PCYC_draw_band pal_idx%, x%, swatch_y%, sw%, sh% ' color cycling range band (if any)
        
        ' Draw selection indicator for FG/BG colors (only if not transparent)
        ' pal_idx% is already the correct absolute palette index at this visible position
        IF pal_idx% = fgShow% THEN
            ' Foreground color - white outline for visibility
            LINE (x%, swatch_y%)-(x% + sw% - 1, swatch_y% + sh% - 1), THEME.PALETTE_STRIP_sel_border_outer~&, B
            LINE (x% + 1, swatch_y% + 1)-(x% + sw% - 2, swatch_y% + sh% - 2), THEME.PALETTE_STRIP_sel_border_inner~&, B
        END IF
        IF pal_idx% = bgShow% THEN
            ' Background color - dark grey outline for visibility
            LINE (x%, swatch_y%)-(x% + sw% - 1, swatch_y% + sh% - 1), THEME.PALETTE_STRIP_inact_border_outer~&, B
            LINE (x% + 1, swatch_y% + 1)-(x% + sw% - 2, swatch_y% + sh% - 2), THEME.PALETTE_STRIP_inact_border_inner~&, B
        END IF
        
        ' Hover highlight (use raw screen coords, only if mouse is in strip)
        IF i% = hoverChip% THEN
            PALETTE_STRIP_HOVER_IDX% = pal_idx%
            LINE (x%, swatch_y%)-(x% + sw% - 1, swatch_y% + sh% - 1), THEME.PALETTE_STRIP_sel_border_outer~&, B
        END IF

        ' Palette Ops: draw red mark dot on marked colors
        IF PALETTE_OPS.ACTIVE% AND PALETTE_OPS_MARKED(pal_idx%) THEN
            DIM dotX AS INTEGER, dotY AS INTEGER
            dotX% = x% + sw% - 4
            dotY% = swatch_y% + 1
            LINE (dotX%, dotY%)-(dotX% + 2, dotY% + 2), _RGB32(255, 0, 0), BF
        END IF

        ' Color Ops: selected chip (edited by the color panels) — yellow frame
        IF PALETTE_OPS.ACTIVE% _ANDALSO pal_idx% = PALETTE_OPS.SEL_IDX% THEN
            LINE (x%, swatch_y%)-(x% + sw% - 1, swatch_y% + sh% - 1), _RGB32(255, 210, 0), B
            LINE (x% + 1, swatch_y% + 1)-(x% + sw% - 2, swatch_y% + sh% - 2), _RGB32(255, 210, 0), B
            LINE (x% + 2, swatch_y% + 2)-(x% + sw% - 3, swatch_y% + sh% - 3), _RGB32(0, 0, 0), B
        END IF

        ' Color Ops: chips in the middle-drag delete range — red frame + cross
        IF pal_idx% >= delLo% _ANDALSO pal_idx% <= delHi% THEN
            LINE (x%, swatch_y%)-(x% + sw% - 1, swatch_y% + sh% - 1), _RGB32(255, 40, 40), B
            LINE (x% + 2, swatch_y% + 2)-(x% + sw% - 3, swatch_y% + sh% - 3), _RGB32(255, 40, 40)
            LINE (x% + 2, swatch_y% + sh% - 3)-(x% + sw% - 3, swatch_y% + 2), _RGB32(255, 40, 40)
        END IF

        ' Palette Ops: draw drag destination indicator (before the chip: left of
        ' it, or above it in a side strip)
        IF PALETTE_OPS.ACTIVE% AND PALETTE_OPS.DRAG_ACTIVE% AND pal_idx% = PALETTE_OPS.DRAG_DST_IDX% THEN
            IF PSG.vert THEN
                LINE (x%, swatch_y% - 1)-(x% + sw% - 1, swatch_y% - 1), _RGB32(255, 255, 0)
            ELSE
                LINE (x% - 1, swatch_y%)-(x% - 1, swatch_y% + sh% - 1), _RGB32(255, 255, 0)
            END IF
        END IF
    NEXT i%
    
    ' Draw palette name with dropdown indicator - clickable to open menu
    DIM name_hover AS INTEGER
    name_hover% = mouseInStrip% _ANDALSO PALETTE_STRIP_dropdown_in_bounds%(rawMX%, rawMY%)
    IF name_hover% THEN
        IF PSG.vert THEN
            LINE (PSG.nx, PSG.ny)-(PSG.nx + PSG.nw - 1, PSG.ny + PSG.nh - 1), THEME.PALETTE_STRIP_button_hover_bg~&, BF
        ELSE
            LINE (PSG.nx - 2, PSG.y + 1)-(PSG.nx + PSG.nw, PSG.y + PSG.h - 1), THEME.PALETTE_STRIP_button_hover_bg~&, BF
        END IF
        COLOR hover_color~&, THEME.PALETTE_STRIP_button_hover_bg~&
    ELSE
        COLOR fg_color~&, bg_color~&
    END IF
    
    DIM info_str       AS STRING
    DIM display_name   AS STRING
    ' Fit the name to the area by measured width (strip font), leaving room
    ' for the " v" dropdown indicator; trim with "..." only when it overflows
    ' (a narrow side strip may only have room for the arrow).
    DIM nameRoom AS INTEGER
    nameRoom% = PSG.nw - _UPRINTWIDTH(" " + CHR$(31)) - 2
    display_name$ = pal_name$
    IF _UPRINTWIDTH(display_name$) > nameRoom% THEN
        DO WHILE LEN(display_name$) > 1 _ANDALSO _UPRINTWIDTH(display_name$ + "...") > nameRoom%
            display_name$ = LEFT$(display_name$, LEN(display_name$) - 1)
        LOOP
        display_name$ = RTRIM$(display_name$) + "..."
        IF _UPRINTWIDTH(display_name$) > nameRoom% THEN display_name$ = ""
    END IF
    IF LEN(display_name$) THEN info_str$ = display_name$ + " " + CHR$(31) ELSE info_str$ = CHR$(31)
    IF PSG.vert THEN
        _UPRINTSTRING (PSG.nx + 1, PSG.ny + (PSG.nh \ 2) - 3), info_str$
    ELSE
        _UPRINTSTRING (PSG.nx, PSG.y + (PSG.h \ 2) - 3), info_str$
    END IF
    
    ' Store menu position for dropdown (the chip column widens the menu when
    ' CFG.PALETTE_MENU_SHOW_CHIPS is on)
    DIM strip_chip_w AS INTEGER
    strip_chip_w% = PALETTE_MENU_chip_w%
    IF strip_chip_w% > 0 THEN
        PALETTE_MENU_W% = PALETTE_MENU_NAME_COL_W + PALETTE_MENU_CHIP_GAP + _
                          (PALETTE_PREVIEW_CHIPS_PER_ROW * strip_chip_w%) + PALETTE_MENU_MORE_COL_W
    ELSE
        PALETTE_MENU_W% = PALETTE_MENU_MIN_WIDTH
    END IF
    ' Left-aligned with the name area (the layer panel's edge); pulled left
    ' only if it would run off the right edge. A side strip's opens beside it.
    SELECT CASE PSG.edge
        CASE PSTRIP_LEFT: PALETTE_MENU_X% = PSG.x + PSG.w
        CASE PSTRIP_RIGHT: PALETTE_MENU_X% = PSG.x - PALETTE_MENU_W%
        CASE ELSE: PALETTE_MENU_X% = PSG.nx
    END SELECT
    IF PALETTE_MENU_X% + PALETTE_MENU_W% > SCRN.w& - 4 THEN PALETTE_MENU_X% = SCRN.w& - PALETTE_MENU_W% - 4
    IF PALETTE_MENU_X% < 2 THEN PALETTE_MENU_X% = 2
    
    _FONT old_font&

    ' Play hover sound when hovering over a new color swatch
    IF PALETTE_STRIP_HOVER_IDX% >= 0 AND PALETTE_STRIP_HOVER_IDX% <> PALETTE_STRIP_PREV_HOVER_IDX% THEN
        SOUND_play SND_MENU_HOVER
    END IF
    PALETTE_STRIP_PREV_HOVER_IDX% = PALETTE_STRIP_HOVER_IDX%

    ' Palette menu is rendered separately AFTER menubar in RENDER_gui_elements
    ' to ensure correct z-order (palette menu on top of menubar)
END SUB


''
' Handle mouse click on palette strip
' @param x INTEGER - Mouse X position
' @param y INTEGER - Mouse Y position
'
SUB PALETTE_STRIP_handle_click (x AS INTEGER, y AS INTEGER)
    IF PALETTE_STRIP_HIDDEN THEN EXIT SUB
    ' First check if menu is visible and clicked
    IF PALETTE_MENU_VISIBLE% THEN
        IF PALETTE_MENU_in_bounds%(x%, y%) THEN
            PALETTE_MENU_handle_click x%, y%
            EXIT SUB
        ELSE
            ' Clicked outside menu - close it
            PALETTE_MENU_hide
            ' If click was on the trigger area that opened the menu, just exit (don't reopen)
            IF PALETTE_STRIP_dropdown_in_bounds%(x%, y%) THEN EXIT SUB
        END IF
    END IF
    
    IF NOT PALETTE_STRIP_VISIBLE% THEN EXIT SUB
    IF NOT PALETTE_STRIP_in_bounds%(x%, y%) THEN EXIT SUB
    
    DIM pal_count AS INTEGER, onChip AS INTEGER
    pal_count% = PALETTE_LOADER_get_color_count%
    IF pal_count% < 1 THEN pal_count% = 1
    
    ' The scroll buttons (no arrows when every color fits); a right-click on one
    ' opens the strip's menu (Rick 2026-11-16), like the empty chip places
    IF PALETTE_STRIP_arrow_at%(x%, y%) > 0 _ANDALSO MOUSE.B2% <> 0 _ANDALSO MOUSE.B1% = 0 THEN PSM_open x%, y%: EXIT SUB
    SELECT CASE PALETTE_STRIP_arrow_at%(x%, y%)
        CASE 1
            PALETTE_STRIP_SCROLL_OFFSET% = PALETTE_STRIP_SCROLL_OFFSET% - 1
            IF PALETTE_STRIP_SCROLL_OFFSET% < 0 THEN PALETTE_STRIP_SCROLL_OFFSET% = pal_count% - 1
            GUI_NEEDS_REDRAW% = TRUE
            EXIT SUB
        CASE 2
            PALETTE_STRIP_SCROLL_OFFSET% = PALETTE_STRIP_SCROLL_OFFSET% + 1
            IF PALETTE_STRIP_SCROLL_OFFSET% >= pal_count% THEN PALETTE_STRIP_SCROLL_OFFSET% = 0
            GUI_NEEDS_REDRAW% = TRUE
            EXIT SUB
    END SELECT
    
    ' Check palette name area - open dropdown menu
    IF PALETTE_STRIP_dropdown_in_bounds%(x%, y%) THEN
        IF PALETTE_MENU_VISIBLE% THEN
            PALETTE_MENU_hide
        ELSE
            PALETTE_MENU_show
        END IF
        GUI_NEEDS_REDRAW% = TRUE
        EXIT SUB
    END IF
    
    ' Check color swatches
    DIM pal_idx AS INTEGER
    pal_idx% = PALETTE_STRIP_index_at%(x%, y%)
    IF pal_idx% >= 0 THEN
        IF pal_idx% < pal_count% THEN
            onChip% = TRUE
            ' Left click = set foreground, Right click = set background
            ' Use explicit check to prevent both from triggering
            IF MOUSE.B1% AND NOT MOUSE.B2% THEN
                PAL_FG_IS_TRANSPARENT% = FALSE ' Clear transparent flag
                PAL_FG_IDX%            = pal_idx%
                PAINT_COLOR~&          = PAL(pal_idx%).value~&
                SOUND_play SND_TOOL_SELECT
                ' Auto-enable recolor when a custom brush is active (brush mode only).
                ' Pattern mode tiles the original image — recolor would map all
                ' opaque pixels to a single FG color, destroying the pattern.
                IF CUSTOM_BRUSH.ACTIVE% AND DRAWER.mode% = DRAWER_MODE_BRUSH AND DRAWER.brushSelected% > 0 THEN
                    CUSTOM_BRUSH.RECOLOR_MODE% = TRUE
                END IF
                GUI_NEEDS_REDRAW% = TRUE
            ELSEIF MOUSE.B2% AND NOT MOUSE.B1% THEN
                PAL_BG_IS_TRANSPARENT% = FALSE ' Clear transparent flag
                PAL_BG_IDX%            = pal_idx%
                PAINT_BG_COLOR~&       = PAL(pal_idx%).value~&
                SOUND_play SND_TOOL_SELECT
                GUI_NEEDS_REDRAW% = TRUE
            END IF
        END IF
    END IF
    ' a right-click on no color (the empty chip places, the gaps): the size menu
    IF onChip% = 0 _ANDALSO MOUSE.B2% <> 0 _ANDALSO MOUSE.B1% = 0 THEN PSM_open x%, y%
END SUB


''
' Redraw the strip when FG / BG change from anywhere (color panels, picker,
' hex input...). Those only ask for a status-bar refresh, which skips the
' strip, so the chip frames (PALETTE_STRIP_chip_for_color%) would go stale.
' Called once per main-loop frame.
'
SUB PALETTE_STRIP_watch_colors ()
    STATIC lastFG AS _UNSIGNED LONG, lastBG AS _UNSIGNED LONG, lastFT AS INTEGER, lastBT AS INTEGER
    IF PAINT_COLOR~& <> lastFG~& OR PAINT_BG_COLOR~& <> lastBG~& OR PAL_FG_IS_TRANSPARENT% <> lastFT% OR PAL_BG_IS_TRANSPARENT% <> lastBT% THEN
        lastFG~& = PAINT_COLOR~& : lastBG~& = PAINT_BG_COLOR~&
        lastFT% = PAL_FG_IS_TRANSPARENT% : lastBT% = PAL_BG_IS_TRANSPARENT%
        GUI_NEEDS_REDRAW% = TRUE
        FRAME_IDLE%       = FALSE
    END IF
END SUB


''
' The chip to frame for a FG/BG color: idxHint when that chip IS the color,
' else the first chip with exactly that color, else -1 (no frame).
'
FUNCTION PALETTE_STRIP_chip_for_color% (idxHint AS INTEGER, c AS _UNSIGNED LONG, isTransparent AS INTEGER, palCount AS INTEGER)
    PALETTE_STRIP_chip_for_color% = -1
    IF isTransparent% THEN EXIT FUNCTION
    DIM rgb AS _UNSIGNED LONG : rgb~& = c~& AND &HFFFFFF
    IF idxHint% >= 0 _ANDALSO idxHint% < palCount% THEN
        IF (PAL(idxHint%).value~& AND &HFFFFFF) = rgb~& _ANDALSO (PAL(idxHint%).value~& AND &HFF000000~&) <> 0 THEN
            PALETTE_STRIP_chip_for_color% = idxHint%
            EXIT FUNCTION
        END IF
    END IF
    DIM i AS INTEGER
    FOR i% = 0 TO palCount% - 1
        IF (PAL(i%).value~& AND &HFFFFFF) = rgb~& _ANDALSO (PAL(i%).value~& AND &HFF000000~&) <> 0 THEN
            PALETTE_STRIP_chip_for_color% = i%
            EXIT FUNCTION
        END IF
    NEXT i%
END FUNCTION


''
' Actions 520-523 (Deluxe Paint [ ] { }): the FG (or BG) color becomes the
' palette's previous / next color, wrapping round. From the chip the color is
' on (PAL_FG_IDX% when it still matches), else the first / last chip.
'
SUB PALETTE_STRIP_step_color (toBG AS INTEGER, dir AS INTEGER)
    DIM n AS INTEGER, cur AS INTEGER
    n% = PAL_COLOR_COUNT%
    IF n% < 1 THEN EXIT SUB
    IF toBG% THEN
        cur% = PALETTE_STRIP_chip_for_color%(PAL_BG_IDX%, PAINT_BG_COLOR~&, PAL_BG_IS_TRANSPARENT%, n%)
    ELSE
        cur% = PALETTE_STRIP_chip_for_color%(PAL_FG_IDX%, PAINT_COLOR~&, PAL_FG_IS_TRANSPARENT%, n%)
    END IF
    IF cur% < 0 THEN
        cur% = _IIF(dir% > 0, 0, n% - 1)
    ELSE
        cur% = (cur% + dir% + n%) MOD n%
    END IF
    IF toBG% THEN
        PAL_BG_IS_TRANSPARENT% = FALSE
        PAL_BG_IDX%            = cur%
        PAINT_BG_COLOR~&       = PAL(cur%).value~&
    ELSE
        PAL_FG_IS_TRANSPARENT% = FALSE
        PAL_FG_IDX%            = cur%
        PAINT_COLOR~&          = PAL(cur%).value~&
        IF CUSTOM_BRUSH.ACTIVE% AND DRAWER.mode% = DRAWER_MODE_BRUSH AND DRAWER.brushSelected% > 0 THEN CUSTOM_BRUSH.RECOLOR_MODE% = TRUE
    END IF
    STATUS_NEEDS_REDRAW% = TRUE : GUI_NEEDS_REDRAW% = TRUE : FRAME_IDLE% = FALSE
END SUB


''
' Handle mouse wheel on palette strip - scroll colors
' @param direction INTEGER - Wheel direction (positive = up/left, negative = down/right)
'
SUB PALETTE_STRIP_handle_wheel (direction AS INTEGER)
    IF PALETTE_STRIP_HIDDEN THEN EXIT SUB
    IF NOT PALETTE_STRIP_VISIBLE% THEN EXIT SUB
    
    ' If menu is visible, ALWAYS scroll the menu (regardless of mouse position)
    IF PALETTE_MENU_VISIBLE% THEN
        PALETTE_MENU_handle_wheel direction%
        EXIT SUB
    END IF
    
    ' Only handle if mouse is over palette strip (use raw screen coords)
    IF NOT PALETTE_STRIP_in_bounds%(MOUSE.RAW_X%, MOUSE.RAW_Y%) THEN EXIT SUB
    IF PALETTE_STRIP_ALL_FIT% THEN EXIT SUB ' every color is visible — nothing to scroll
    
    DIM pal_count AS INTEGER
    pal_count% = PALETTE_LOADER_get_color_count%
    IF pal_count% < 1 THEN pal_count% = 1
    
    ' Determine scroll amount: SHIFT or CTRL = one page (max chips per row), otherwise 1
    DIM scroll_amount AS INTEGER
    scroll_amount% = 1
    IF MODIFIERS.shift% OR MODIFIERS.ctrl% THEN
        scroll_amount% = CFG.PALETTE_MAX_CHIPS_PER_ROW%
        IF scroll_amount% < 1 THEN scroll_amount% = 1
    END IF
    
    IF direction% > 0 THEN
        PALETTE_STRIP_SCROLL_OFFSET% = PALETTE_STRIP_SCROLL_OFFSET% - scroll_amount% ' wheel up
    ELSE
        PALETTE_STRIP_SCROLL_OFFSET% = PALETTE_STRIP_SCROLL_OFFSET% + scroll_amount% ' wheel down
    END IF
    ' BUG-44 [CRASH]: normalize into [0, pal_count-1] with a real modulo, not the old one-shot
    ' +/- wrap. A page scroll (amount 32/64) on a small palette (16 colors — the norm) left the
    ' offset NEGATIVE, and render's PAL((offset+i) MOD pal_count) then read PAL(-n) → subscript
    ' out of range (crash), since QB64 MOD keeps the dividend's sign.
    IF pal_count% > 0 THEN
        PALETTE_STRIP_SCROLL_OFFSET% = ((PALETTE_STRIP_SCROLL_OFFSET% MOD pal_count%) + pal_count%) MOD pal_count%
    ELSE
        PALETTE_STRIP_SCROLL_OFFSET% = 0
    END IF
    GUI_NEEDS_REDRAW% = TRUE
END SUB


''
' Check if coordinates are within palette strip bounds
' @param x INTEGER - X position
' @param y INTEGER - Y position
' @return INTEGER - True if in bounds
'
FUNCTION PALETTE_STRIP_in_bounds% (x AS INTEGER, y AS INTEGER)
    IF PALETTE_STRIP_HIDDEN THEN EXIT FUNCTION
    IF PSG.w < 1 _ORELSE PSG.h < 1 THEN EXIT FUNCTION ' (not laid out yet)
    PALETTE_STRIP_in_bounds% = (x% >= PSG.x _ANDALSO x% < PSG.x + PSG.w _ANDALSO y% >= PSG.y _ANDALSO y% < PSG.y + PSG.h)
END FUNCTION


''
' Check if coordinates are within palette dropdown button bounds (name area)
' @param x INTEGER - X position
' @param y INTEGER - Y position
' @return INTEGER - True if over dropdown button area
'
FUNCTION PALETTE_STRIP_dropdown_in_bounds% (x AS INTEGER, y AS INTEGER)
    IF PALETTE_STRIP_HIDDEN THEN EXIT FUNCTION
    IF PALETTE_STRIP_in_bounds%(x%, y%) = 0 THEN EXIT FUNCTION
    PALETTE_STRIP_dropdown_in_bounds% = (x% >= PSG.nx _ANDALSO x% < PSG.nx + PSG.nw _ANDALSO y% >= PSG.ny _ANDALSO y% < PSG.ny + PSG.nh)
END FUNCTION


''
' Show palette selection menu
'
SUB PALETTE_MENU_show ()
    PALETTE_MENU_VISIBLE% = -1
    ' Close any open menubar dropdown to avoid overlap conflicts
    IF MENUBAR_is_open% THEN MENUBAR_close_all
    ' Only set hover to current index if using a real GPL palette (not embedded)
    IF PALETTE_EMBEDDED_ACTIVE% THEN
        PALETTE_MENU_HOVER% = -1 ' No selection for embedded palettes
    ELSE
        PALETTE_MENU_HOVER% = PALETTE_LOADER_CURRENT_IDX%
    END IF
    GUI_NEEDS_REDRAW% = TRUE
    SCENE_DIRTY%      = TRUE
    
    ' Position menu above the palette strip
    DIM menu_item_h      AS INTEGER
    DIM max_visible      AS INTEGER
    DIM available_height AS INTEGER
    
    menu_item_h% = THEME.PALETTE_MENU_item_height%
    IF menu_item_h% < 1 THEN menu_item_h% = 12
    
    ' Calculate available height: from below the menubar down to a bottom
    ' strip (opening upward), or from a top strip's bottom / a side strip's
    ' dropdown down to the status bar (opening downward)
    DIM top_margin AS INTEGER, bot_limit AS INTEGER, opensDown AS INTEGER
    IF SCRN.showMenubar% AND MENU_BAR.visible% THEN
        top_margin% = MENU_BAR_HEIGHT + 2
    ELSE
        top_margin% = 4
    END IF
    bot_limit% = SCRN.h& - 4
    IF SCRN.showStatus% THEN bot_limit% = SCRN.h& - THEME.STATUS_height% - 2
    opensDown% = (PSG.edge <> PSTRIP_BOTTOM)
    SELECT CASE PSG.edge
        CASE PSTRIP_TOP: top_margin% = PSG.y + PSG.h
        CASE PSTRIP_LEFT, PSTRIP_RIGHT: top_margin% = PSG.ny
    END SELECT
    IF opensDown% THEN available_height% = bot_limit% - top_margin% ELSE available_height% = PALETTE_STRIP_Y% - top_margin%
    max_visible%      = available_height% \ menu_item_h%
    IF max_visible% > PALETTE_LOADER_COUNT% THEN max_visible% = PALETTE_LOADER_COUNT%
    IF max_visible% < 5 THEN max_visible% = 5  ' Minimum 5 items
    
    PALETTE_MENU_H% = max_visible% * menu_item_h% + 4
    IF opensDown% THEN
        PALETTE_MENU_Y% = top_margin%
        IF PALETTE_MENU_Y% + PALETTE_MENU_H% > bot_limit% THEN PALETTE_MENU_Y% = bot_limit% - PALETTE_MENU_H%
    ELSE
        PALETTE_MENU_Y% = PALETTE_STRIP_Y% - PALETTE_MENU_H%
    END IF
    
    ' Ensure menu stays on screen (below menubar if visible)
    IF PALETTE_MENU_Y% < top_margin% THEN PALETTE_MENU_Y% = top_margin%
    
    ' Scroll to show currently selected palette (center it if possible)
    ' Only if using a real GPL palette (not embedded)
    IF NOT PALETTE_EMBEDDED_ACTIVE% THEN
        DIM half_visible AS INTEGER
        half_visible%        = max_visible% \ 2
        PALETTE_MENU_SCROLL% = PALETTE_LOADER_CURRENT_IDX% - half_visible%
        
        ' Clamp scroll to valid range
        IF PALETTE_MENU_SCROLL% < 0 THEN PALETTE_MENU_SCROLL% = 0
        IF PALETTE_MENU_SCROLL% > PALETTE_LOADER_COUNT% - max_visible% THEN
            PALETTE_MENU_SCROLL% = PALETTE_LOADER_COUNT% - max_visible%
        END IF
        IF PALETTE_MENU_SCROLL% < 0 THEN PALETTE_MENU_SCROLL% = 0
    ELSE
        ' Embedded palette - start at top
        PALETTE_MENU_SCROLL% = 0
    END IF
END SUB


''
' Hide palette selection menu
'
SUB PALETTE_MENU_hide ()
    PALETTE_MENU_VISIBLE% = 0
    GUI_NEEDS_REDRAW%     = TRUE
    SCENE_DIRTY%          = TRUE
END SUB


''
' Width in pixels of one color chip in the palette dropdown.
' Returns 0 when chips are disabled, or when the screen is too narrow to fit a
' full 32-chip row at the minimum chip size (the menu then falls back to the
' plain name-only layout).
' @return INTEGER - Chip width in pixels, or 0 for "no chip column"
'
FUNCTION PALETTE_MENU_chip_w% ()
    PALETTE_MENU_chip_w% = 0
    ' Compare against 0 rather than using NOT — QB64-PE's NOT is BITWISE, so a
    ' config value of 1 (not -1) makes NOT 1 = -2, which is truthy, and chips
    ' would silently never render. Any non-zero value means "on".
    IF CFG.PALETTE_MENU_SHOW_CHIPS% = 0 THEN EXIT FUNCTION

    DIM avail AS LONG
    avail& = SCRN.w& - 8 - PALETTE_MENU_NAME_COL_W - PALETTE_MENU_CHIP_GAP - PALETTE_MENU_MORE_COL_W
    IF avail& < PALETTE_PREVIEW_CHIPS_PER_ROW * PALETTE_MENU_CHIP_W_MIN THEN EXIT FUNCTION

    DIM cw AS INTEGER
    cw% = avail& \ PALETTE_PREVIEW_CHIPS_PER_ROW
    IF cw% > PALETTE_MENU_CHIP_W_MAX THEN cw% = PALETTE_MENU_CHIP_W_MAX
    PALETTE_MENU_chip_w% = cw%
END FUNCTION


''
' Draw the color chip preview for one palette dropdown row.
' Up to PALETTE_PREVIEW_MAX_CHIPS chips are drawn, PALETTE_PREVIEW_CHIPS_PER_ROW
' across; palettes with more colors than fit get an "...and N more" label.
' Colors come from the live PAL() array for the active palette, from
' PALETTE_DOC_COLORS for the [DOCUMENT] row, and from the lazily-parsed
' PALETTE_PREVIEW_* cache for everything else.
'
' @param idx INTEGER Palette index, or -2 for the [DOCUMENT] row
' @param chipX INTEGER Left X of the chip column
' @param rowY INTEGER Top Y of the menu row
' @param rowH INTEGER Height of the menu row
' @param chipW INTEGER Chip width in pixels (from PALETTE_MENU_chip_w%)
' @param labelFg _UNSIGNED LONG Text color for the "...and N more" label
'
SUB PALETTE_MENU_draw_chips (idx AS INTEGER, chipX AS INTEGER, rowY AS INTEGER, rowH AS INTEGER, chipW AS INTEGER, labelFg AS _UNSIGNED LONG)
    IF chipW% < 1 THEN EXIT SUB

    DIM chips(0 TO PALETTE_PREVIEW_MAX_CHIPS - 1) AS _UNSIGNED LONG
    DIM shown AS INTEGER, total AS INTEGER, i AS INTEGER
    shown% = 0
    total% = 0

    IF idx% = -2 THEN
        ' [DOCUMENT] row — colors snapshotted from the loaded .draw file
        total% = PALETTE_DOC_COUNT%
        shown% = total%
        IF shown% > PALETTE_PREVIEW_MAX_CHIPS THEN shown% = PALETTE_PREVIEW_MAX_CHIPS
        FOR i% = 0 TO shown% - 1
            chips~&(i%) = PALETTE_DOC_COLORS(i%)
        NEXT i%
    ELSEIF idx% = PALETTE_LOADER_CURRENT_IDX% AND NOT PALETTE_EMBEDDED_ACTIVE% THEN
        ' Active palette — read live so palette edits show up immediately
        total% = PAL_COLOR_COUNT%
        shown% = total%
        IF shown% > PALETTE_PREVIEW_MAX_CHIPS THEN shown% = PALETTE_PREVIEW_MAX_CHIPS
        FOR i% = 0 TO shown% - 1
            chips~&(i%) = PAL(i%).value~&
        NEXT i%
    ELSE
        IF NOT PALETTE_PREVIEW_ensure%(idx%) THEN EXIT SUB
        shown% = PALETTE_PREVIEW_SHOWN(idx%)
        total% = PALETTE_PREVIEW_TOTAL(idx%)
        FOR i% = 0 TO shown% - 1
            chips~&(i%) = PALETTE_PREVIEW_COLORS(idx%, i%)
        NEXT i%
    END IF

    IF shown% < 1 THEN EXIT SUB

    ' One chip row up to 32 colors, a second stacked row beyond that
    DIM chipRows AS INTEGER, chipH AS INTEGER
    IF shown% > PALETTE_PREVIEW_CHIPS_PER_ROW THEN chipRows% = 2 ELSE chipRows% = 1
    chipH% = (rowH% - 2) \ chipRows%
    IF chipH% > PALETTE_MENU_CHIP_H_MAX THEN chipH% = PALETTE_MENU_CHIP_H_MAX
    IF chipH% < 1 THEN chipH% = 1

    ' Center the chip block vertically in the row
    DIM chipTop AS INTEGER
    chipTop% = rowY% + ((rowH% - (chipRows% * chipH%)) \ 2)

    DIM cx AS INTEGER, cy AS INTEGER, col AS INTEGER, rw AS INTEGER
    FOR i% = 0 TO shown% - 1
        col% = i% MOD PALETTE_PREVIEW_CHIPS_PER_ROW
        rw%  = i% \ PALETTE_PREVIEW_CHIPS_PER_ROW
        cx%  = chipX% + (col% * chipW%)
        cy%  = chipTop% + (rw% * chipH%)
        LINE (cx%, cy%)-(cx% + chipW% - 1, cy% + chipH% - 1), chips~&(i%), BF
    NEXT i%

    ' Emphasize that the palette has colors the preview could not show
    IF total% > shown% THEN
        DIM moreLbl AS STRING
        moreLbl$ = "...AND " + _TRIM$(STR$(total% - shown%)) + " MORE"
        COLOR labelFg~&, _RGBA32(0, 0, 0, 0)
        _UPRINTSTRING (chipX% + (PALETTE_PREVIEW_CHIPS_PER_ROW * chipW%) + 4, rowY% + 2), moreLbl$
    END IF
END SUB


''
' Render palette selection dropdown menu
'
SUB PALETTE_MENU_render ()
    IF NOT PALETTE_MENU_VISIBLE% THEN EXIT SUB
    
    DIM AS INTEGER i, y, menu_item_h, max_visible, visible_count, start_idx
    DIM AS _UNSIGNED LONG bg_color, fg_color, hover_bg, sel_bg
    DIM old_font AS LONG
    DIM pal_name AS STRING
    
    menu_item_h% = THEME.PALETTE_MENU_item_height%
    IF menu_item_h% < 1 THEN menu_item_h% = 12
    ' Calculate max visible from current menu height
    max_visible% = (PALETTE_MENU_H% - 4) \ menu_item_h%
    
    bg_color~& = THEME.PALETTE_MENU_bg~&
    fg_color~& = THEME.PALETTE_MENU_fg~&
    hover_bg~& = THEME.PALETTE_MENU_hover_bg~&
    sel_bg~&   = THEME.PALETTE_MENU_selected_bg~&
    
    ' Chip column geometry — chip_w = 0 means the name-only layout
    DIM chip_w AS INTEGER, chip_x AS INTEGER
    chip_w% = PALETTE_MENU_chip_w%
    chip_x% = PALETTE_MENU_X% + PALETTE_MENU_NAME_COL_W + PALETTE_MENU_CHIP_GAP
    ' Budget the .GPL parsing so one frame never stalls on dozens of files
    PALETTE_PREVIEW_BUDGET%  = 8
    PALETTE_PREVIEW_PENDING% = FALSE

    visible_count% = PALETTE_LOADER_COUNT%
    ' Reserve 1 row for [DOCUMENT] entry + separator when it exists
    DIM doc_rows_reserved AS INTEGER
    doc_rows_reserved% = 0
    IF PALETTE_DOC_EXISTS% THEN doc_rows_reserved% = 1
    IF visible_count% > max_visible% - doc_rows_reserved% THEN visible_count% = max_visible% - doc_rows_reserved%
    start_idx% = PALETTE_MENU_SCROLL%
    
    _DEST SCRN.GUI&
    old_font& = _FONT
    _FONT PALETTE_STRIP_FONT&
    
    ' Draw menu background with border
    LINE (PALETTE_MENU_X% - 1, PALETTE_MENU_Y% - 1)-(PALETTE_MENU_X% + PALETTE_MENU_W%, PALETTE_MENU_Y% + PALETTE_MENU_H%), THEME.PALETTE_MENU_border~&, BF
    LINE (PALETTE_MENU_X%, PALETTE_MENU_Y%)-(PALETTE_MENU_X% + PALETTE_MENU_W% - 1, PALETTE_MENU_Y% + PALETTE_MENU_H% - 1), bg_color~&, BF
    IF THEMEED.started THEN THEMEED_seen SCRN.GUI&, "OVER", "PALMENU", "PALETTE MENU", PALETTE_MENU_X% - 1, PALETTE_MENU_Y% - 1, PALETTE_MENU_W% + 2, PALETTE_MENU_H% + 2, "@PALETTE_MENU_render" ' Theme Edit (CFG/THEME-EDIT)
    
    ' --- [DOCUMENT] palette entry at top of menu ---
    DIM doc_offset AS INTEGER
    doc_offset% = 0
    IF PALETTE_DOC_EXISTS% THEN
        DIM doc_y          AS INTEGER
        doc_y% = PALETTE_MENU_Y% + 2
        IF THEMEED.started THEN THEMEED_seen SCRN.GUI&, "PALMENU", "PALMENU:DOC", "ITEM [DOCUMENT]", PALETTE_MENU_X% + 1, doc_y%, PALETTE_MENU_W% - 2, menu_item_h%, "@PALETTE_MENU_render"
        DIM doc_is_current AS INTEGER
        doc_is_current% = (PALETTE_EMBEDDED_ACTIVE% AND PALETTE_EMBEDDED_NAME$ = "[DOCUMENT]")
        DIM doc_hover      AS INTEGER
        doc_hover% = (MOUSE.RAW_X% >= PALETTE_MENU_X% AND MOUSE.RAW_X% < PALETTE_MENU_X% + PALETTE_MENU_W% AND _
                      MOUSE.RAW_Y% >= doc_y% AND MOUSE.RAW_Y% < doc_y% + menu_item_h%)
        IF doc_hover% THEN
            PALETTE_MENU_HOVER% = -2 ' Special sentinel for [DOCUMENT]
            LINE (PALETTE_MENU_X% + 1, doc_y%)-(PALETTE_MENU_X% + PALETTE_MENU_W% - 2, doc_y% + menu_item_h% - 1), hover_bg~&, BF
        ELSEIF doc_is_current% THEN
            LINE (PALETTE_MENU_X% + 1, doc_y%)-(PALETTE_MENU_X% + PALETTE_MENU_W% - 2, doc_y% + menu_item_h% - 1), sel_bg~&, BF
        END IF
        IF doc_is_current% THEN
            COLOR _RGB32(255, 255, 255), _RGBA32(0, 0, 0, 0)
        ELSE
            COLOR fg_color~&, _RGBA32(0, 0, 0, 0)
        END IF
        _UPRINTSTRING (PALETTE_MENU_X% + 4, doc_y% + 2), "[DOCUMENT]"
        IF chip_w% > 0 THEN PALETTE_MENU_draw_chips -2, chip_x%, doc_y%, menu_item_h%, chip_w%, fg_color~&
        ' Separator line below [DOCUMENT]
        DIM doc_sep_y      AS INTEGER
        doc_sep_y% = doc_y% + menu_item_h%
        LINE (PALETTE_MENU_X% + 3, doc_sep_y%)-(PALETTE_MENU_X% + PALETTE_MENU_W% - 4, doc_sep_y%), THEME.PALETTE_MENU_SEP_fg~&
        doc_offset% = menu_item_h% + 1 ' Extra vertical offset for all items below
    END IF

    ' Draw menu items
    FOR i% = 0 TO visible_count% - 1
        DIM item_idx AS INTEGER
        item_idx% = start_idx% + i%
        IF item_idx% >= PALETTE_LOADER_COUNT% THEN EXIT FOR
        
        y% = PALETTE_MENU_Y% + 2 + doc_offset% + (i% * menu_item_h%)
        
        ' Get palette name from list
        pal_name$ = PALETTE_LIST(item_idx%).pname
        IF THEMEED.started THEN THEMEED_seen SCRN.GUI&, "PALMENU", "PALMENU:" + _TRIM$(STR$(i%)), _IIF(PALETTE_LIST_SOURCE(item_idx%) = -1, "HEADER ", "ITEM ") + RTRIM$(pal_name$), PALETTE_MENU_X% + 1, y%, PALETTE_MENU_W% - 2, menu_item_h%, "@PALETTE_MENU_render"
        
        ' Separator header row (source -1): draw dim label, not selectable
        DIM is_sep AS INTEGER
        is_sep% = (PALETTE_LIST_SOURCE(item_idx%) = -1)
        IF is_sep% THEN
            DIM sep_lbl    AS STRING
            sep_lbl$ = UCASE$(RTRIM$(pal_name$)) ' (a UI group header, not a palette name)
            DIM sep_tw     AS INTEGER
            sep_tw% = _PRINTWIDTH(sep_lbl$)
            DIM sep_pad    AS INTEGER : sep_pad% = 4
            DIM sep_lx     AS INTEGER
            sep_lx% = PALETTE_MENU_X% + (PALETTE_MENU_W% \ 2) - (sep_tw% \ 2)
            DIM sep_bx1    AS INTEGER, sep_bx2 AS INTEGER
            sep_bx1% = sep_lx% - sep_pad%
            sep_bx2% = sep_lx% + sep_tw% + sep_pad% - 1
            DIM sep_line_y AS INTEGER
            sep_line_y% = y% + (menu_item_h% \ 2)
            ' Background color box around label text
            LINE (sep_bx1%, y% + 1)-(sep_bx2%, y% + menu_item_h% - 2), THEME.PALETTE_MENU_SEP_bg~&, BF
            ' Horizontal rules flanking the box on both sides
            LINE (PALETTE_MENU_X% + 3, sep_line_y%)-(sep_bx1% - 2, sep_line_y%), THEME.PALETTE_MENU_SEP_fg~&
            LINE (sep_bx2% + 2, sep_line_y%)-(PALETTE_MENU_X% + PALETTE_MENU_W% - 4, sep_line_y%), THEME.PALETTE_MENU_SEP_fg~&
            COLOR THEME.PALETTE_MENU_SEP_fg~&, _RGBA32(0, 0, 0, 0)
            _UPRINTSTRING (sep_lx%, y% + 2), sep_lbl$
        ELSE
            ' Check if this is current palette
            DIM is_current AS INTEGER
            is_current% = (item_idx% = PALETTE_LOADER_CURRENT_IDX%)
            
            ' Check hover (from mouse or keyboard) - use RAW coords since menu is in screen space
            DIM item_hover AS INTEGER
            item_hover% = (MOUSE.RAW_X% >= PALETTE_MENU_X% AND MOUSE.RAW_X% < PALETTE_MENU_X% + PALETTE_MENU_W% AND _
                           MOUSE.RAW_Y% >= y% AND MOUSE.RAW_Y% < y% + menu_item_h%)
            
            ' Also check if this item is the keyboard-selected hover
            DIM is_keyboard_hover AS INTEGER
            is_keyboard_hover% = (PALETTE_MENU_HOVER% = item_idx%)
            
            IF item_hover% THEN
                PALETTE_MENU_HOVER% = item_idx%
                LINE (PALETTE_MENU_X% + 1, y%)-(PALETTE_MENU_X% + PALETTE_MENU_W% - 2, y% + menu_item_h% - 1), hover_bg~&, BF
            ELSEIF is_keyboard_hover% THEN
                LINE (PALETTE_MENU_X% + 1, y%)-(PALETTE_MENU_X% + PALETTE_MENU_W% - 2, y% + menu_item_h% - 1), hover_bg~&, BF
            ELSEIF is_current% THEN
                LINE (PALETTE_MENU_X% + 1, y%)-(PALETTE_MENU_X% + PALETTE_MENU_W% - 2, y% + menu_item_h% - 1), sel_bg~&, BF
            END IF
            
            ' Draw palette name - truncate if too long
            IF is_current% THEN
                COLOR _RGB32(255, 255, 255), _RGBA32(0, 0, 0, 0)
            ELSE
                COLOR fg_color~&, _RGBA32(0, 0, 0, 0)
            END IF
            
            ' Truncate name if needed to fit menu width (allow ~34 chars for 180px width)
            DIM display_name AS STRING
            display_name$ = RTRIM$(pal_name$)
            IF LEN(display_name$) > 34 THEN
                display_name$ = LEFT$(display_name$, 31) + "..."
            END IF
            _UPRINTSTRING (PALETTE_MENU_X% + 4, y% + 2), display_name$

            IF chip_w% > 0 THEN PALETTE_MENU_draw_chips item_idx%, chip_x%, y%, menu_item_h%, chip_w%, fg_color~&
        END IF
    NEXT i%
    
    ' Draw scroll indicators if needed
    IF PALETTE_LOADER_COUNT% > max_visible% THEN
        COLOR THEME.PALETTE_MENU_scroll_fg~&, _RGBA32(0, 0, 0, 0)
        IF start_idx% > 0 THEN
            _UPRINTSTRING (PALETTE_MENU_X% + PALETTE_MENU_W% - 12, PALETTE_MENU_Y% + 2), CHR$(30)                    ' Up arrow
        END IF
        IF start_idx% + visible_count% < PALETTE_LOADER_COUNT% THEN
            _UPRINTSTRING (PALETTE_MENU_X% + PALETTE_MENU_W% - 12, PALETTE_MENU_Y% + PALETTE_MENU_H% - 12), CHR$(31) ' Down arrow
        END IF
    END IF
    
    _FONT old_font&

    ' Some rows hit the per-frame parse budget — ask for another frame so their
    ' chips fill in instead of staying blank until the next unrelated redraw
    IF PALETTE_PREVIEW_PENDING% THEN
        GUI_NEEDS_REDRAW% = TRUE
        SCENE_DIRTY%      = TRUE
        FRAME_IDLE%       = FALSE
    END IF

    ' Play hover sound when menu item changes
    IF (PALETTE_MENU_HOVER% >= 0 OR PALETTE_MENU_HOVER% = -2) AND PALETTE_MENU_HOVER% <> PALETTE_MENU_PREV_HOVER% THEN
        SOUND_play SND_MENU_HOVER
    END IF
    PALETTE_MENU_PREV_HOVER% = PALETTE_MENU_HOVER%
END SUB


''
' Handle click on palette menu
' @param x INTEGER - Mouse X
' @param y INTEGER - Mouse Y
'
SUB PALETTE_MENU_handle_click (x AS INTEGER, y AS INTEGER)
    x% = x% ' reserved for future horizontal hit-testing
    IF NOT PALETTE_MENU_VISIBLE% THEN EXIT SUB
    
    DIM menu_item_h AS INTEGER
    DIM max_visible AS INTEGER
    DIM clicked_idx AS INTEGER
    DIM dummy       AS INTEGER
    
    menu_item_h% = THEME.PALETTE_MENU_item_height%
    IF menu_item_h% < 1 THEN menu_item_h% = 12
    max_visible% = (PALETTE_MENU_H% - 4) \ menu_item_h%
    
    ' Calculate which item was clicked
    DIM rel_y AS INTEGER
    rel_y% = y% - PALETTE_MENU_Y% - 2
    IF rel_y% < 0 THEN EXIT SUB  ' Click above menu content

    ' --- Check if [DOCUMENT] row was clicked ---
    IF PALETTE_DOC_EXISTS% THEN
        IF rel_y% < menu_item_h% THEN
            ' Clicked on [DOCUMENT] entry — restore document palette
            PAL_COLOR_COUNT% = PALETTE_DOC_COUNT%
            DIM dri AS INTEGER
            FOR dri% = 0 TO PALETTE_DOC_COUNT% - 1
                PAL(dri%).value~& = PALETTE_DOC_COLORS(dri%)
            NEXT dri%
            PALETTE_EMBEDDED_ACTIVE% = TRUE
            PALETTE_EMBEDDED_NAME$   = "[DOCUMENT]"
            PAL_set_defaults_by_size
            SOUND_play SND_TOOL_SELECT
            IF PALETTE_OPS.ACTIVE% THEN PALETTE_OPS_deactivate
            PALETTE_STRIP_SCROLL_OFFSET% = 0
            PALETTE_MENU_hide
            GUI_NEEDS_REDRAW% = TRUE
            SCENE_DIRTY%      = TRUE
            FRAME_IDLE%       = FALSE
            BLEND_invalidate_cache
            _LOGINFO "PALETTE_MENU: Restored [DOCUMENT] palette (" + _TRIM$(STR$(PALETTE_DOC_COUNT%)) + " colors)"
            EXIT SUB
        END IF
        ' Adjust rel_y past the [DOCUMENT] row + separator
        rel_y% = rel_y% - menu_item_h% - 1
        IF rel_y% < 0 THEN EXIT SUB  ' Clicked on separator line
    END IF

    clicked_idx% = PALETTE_MENU_SCROLL% + (rel_y% \ menu_item_h%)
    
    IF clicked_idx% >= 0 AND clicked_idx% < PALETTE_LOADER_COUNT% THEN
        IF PALETTE_LIST_SOURCE(clicked_idx%) = -1 THEN EXIT SUB  ' separator row - not selectable
        ' Load selected palette
        dummy% = PALETTE_LOADER_load_by_index%(clicked_idx%)
        SOUND_play SND_TOOL_SELECT
        
        ' Deactivate palette ops when switching palettes
        IF PALETTE_OPS.ACTIVE% THEN PALETTE_OPS_deactivate
        
        ' Set default FG/BG colors based on palette size
        PAL_set_defaults_by_size
        
        PALETTE_STRIP_SCROLL_OFFSET% = 0
        PALETTE_MENU_hide
        GUI_NEEDS_REDRAW% = TRUE
        SCENE_DIRTY%      = TRUE
        FRAME_IDLE%       = FALSE
        BLEND_invalidate_cache
    END IF
END SUB


''
' Handle mouse wheel on palette menu
' @param direction INTEGER - Wheel direction
'
SUB PALETTE_MENU_handle_wheel (direction AS INTEGER)
    IF NOT PALETTE_MENU_VISIBLE% THEN EXIT SUB
    
    DIM max_visible AS INTEGER
    DIM menu_item_h AS INTEGER
    DIM max_scroll  AS INTEGER
    
    menu_item_h% = THEME.PALETTE_MENU_item_height%
    IF menu_item_h% < 1 THEN menu_item_h% = 12
    max_visible% = (PALETTE_MENU_H% - 4) \ menu_item_h%
    max_scroll%  = PALETTE_LOADER_COUNT% - max_visible%
    IF max_scroll% < 0 THEN max_scroll% = 0
    
    IF direction% < 0 THEN
        ' Wheel down = scroll up (decrease offset, show items higher in list)
        PALETTE_MENU_SCROLL% = PALETTE_MENU_SCROLL% - 1
        IF PALETTE_MENU_SCROLL% < 0 THEN PALETTE_MENU_SCROLL% = 0
    ELSE
        ' Wheel up = scroll down (increase offset, show items lower in list)
        PALETTE_MENU_SCROLL% = PALETTE_MENU_SCROLL% + 1
        IF PALETTE_MENU_SCROLL% > max_scroll% THEN PALETTE_MENU_SCROLL% = max_scroll%
    END IF
    GUI_NEEDS_REDRAW% = TRUE
END SUB


''
' Navigate up in palette menu (arrow key up)
'
SUB PALETTE_MENU_navigate_up ()
    IF NOT PALETTE_MENU_VISIBLE% THEN EXIT SUB
    
    DIM max_visible AS INTEGER
    DIM menu_item_h AS INTEGER
    
    menu_item_h% = THEME.PALETTE_MENU_item_height%
    IF menu_item_h% < 1 THEN menu_item_h% = 12
    max_visible% = (PALETTE_MENU_H% - 4) \ menu_item_h%
    
    ' Move hover up
    IF PALETTE_MENU_HOVER% < 0 THEN
        PALETTE_MENU_HOVER% = PALETTE_MENU_SCROLL% ' Start at top of visible area
    ELSE
        PALETTE_MENU_HOVER% = PALETTE_MENU_HOVER% - 1
        IF PALETTE_MENU_HOVER% < 0 THEN PALETTE_MENU_HOVER% = 0
    END IF
    
    ' Scroll if needed to keep hover visible
    IF PALETTE_MENU_HOVER% < PALETTE_MENU_SCROLL% THEN
        PALETTE_MENU_SCROLL% = PALETTE_MENU_HOVER%
    END IF
    
    GUI_NEEDS_REDRAW% = TRUE
END SUB


''
' Navigate down in palette menu (arrow key down)
'
SUB PALETTE_MENU_navigate_down ()
    IF NOT PALETTE_MENU_VISIBLE% THEN EXIT SUB
    
    DIM max_visible AS INTEGER
    DIM menu_item_h AS INTEGER
    DIM max_scroll  AS INTEGER
    
    menu_item_h% = THEME.PALETTE_MENU_item_height%
    IF menu_item_h% < 1 THEN menu_item_h% = 12
    max_visible% = (PALETTE_MENU_H% - 4) \ menu_item_h%
    max_scroll%  = PALETTE_LOADER_COUNT% - max_visible%
    IF max_scroll% < 0 THEN max_scroll% = 0
    
    ' Move hover down
    IF PALETTE_MENU_HOVER% < 0 THEN
        PALETTE_MENU_HOVER% = PALETTE_MENU_SCROLL% ' Start at top of visible area
    ELSE
        PALETTE_MENU_HOVER% = PALETTE_MENU_HOVER% + 1
        IF PALETTE_MENU_HOVER% >= PALETTE_LOADER_COUNT% THEN 
            PALETTE_MENU_HOVER% = PALETTE_LOADER_COUNT% - 1
        END IF
    END IF
    
    ' Scroll if needed to keep hover visible
    IF PALETTE_MENU_HOVER% >= PALETTE_MENU_SCROLL% + max_visible% THEN
        PALETTE_MENU_SCROLL% = PALETTE_MENU_HOVER% - max_visible% + 1
        IF PALETTE_MENU_SCROLL% > max_scroll% THEN PALETTE_MENU_SCROLL% = max_scroll%
    END IF
    
    GUI_NEEDS_REDRAW% = TRUE
END SUB


''
' Jump to first palette entry starting with given character
' @param char STRING - Character to search for (a-z, A-Z)
'
SUB PALETTE_MENU_jump_to_char (char AS STRING)
    IF NOT PALETTE_MENU_VISIBLE% THEN EXIT SUB
    IF LEN(char$) <> 1 THEN EXIT SUB
    
    DIM search_char AS STRING
    DIM i           AS INTEGER
    DIM first_char  AS STRING
    DIM menu_item_h AS INTEGER
    DIM max_visible AS INTEGER
    DIM max_scroll  AS INTEGER
    
    ' Convert to uppercase for comparison
    search_char$ = UCASE$(char$)
    
    ' Search palette list for first entry starting with this character
    FOR i% = 0 TO PALETTE_LOADER_COUNT% - 1
        first_char$ = UCASE$(LEFT$(PALETTE_LIST(i%).pname, 1))
        IF first_char$ = search_char$ THEN
            ' Found a match - scroll to make it visible and set hover
            menu_item_h% = THEME.PALETTE_MENU_item_height%
            IF menu_item_h% < 1 THEN menu_item_h% = 12
            max_visible% = (PALETTE_MENU_H% - 4) \ menu_item_h%
            max_scroll%  = PALETTE_LOADER_COUNT% - max_visible%
            IF max_scroll% < 0 THEN max_scroll% = 0
            
            ' Scroll to show this item (put it at top of visible area)
            PALETTE_MENU_SCROLL% = i%
            IF PALETTE_MENU_SCROLL% > max_scroll% THEN PALETTE_MENU_SCROLL% = max_scroll%
            
            ' Set hover to this item
            PALETTE_MENU_HOVER% = i%
            
            GUI_NEEDS_REDRAW% = TRUE
            EXIT SUB
        END IF
    NEXT i%
END SUB


''
' Check if coordinates are within palette menu bounds
' @param x INTEGER - X position
' @param y INTEGER - Y position
' @return INTEGER - True if in bounds
'
FUNCTION PALETTE_MENU_in_bounds% (x AS INTEGER, y AS INTEGER)
    IF NOT PALETTE_MENU_VISIBLE% THEN
        PALETTE_MENU_in_bounds% = 0
        EXIT FUNCTION
    END IF
    PALETTE_MENU_in_bounds% = (x% >= PALETTE_MENU_X% AND x% < PALETTE_MENU_X% + PALETTE_MENU_W% AND _
                               y% >= PALETTE_MENU_Y% AND y% < PALETTE_MENU_Y% + PALETTE_MENU_H%)
END FUNCTION


' =============================================================================
' The strip's size menu (PSM): right-click a blank part of the strip.
'   Max Rows = 4        >   1 .. 8
'   Max Columns = 128   >   16, 32, 48, 64, 128, 256
'   Chip Height = 6     >   4 .. 32
'   Chip Width = 6      >   4 .. 32
'   ---
'   COLOR CYCLING:          (a dimmed heading)
'   ---
'   the Palette > Color Cycling flyout, flattened (actions 2061..2069)
' Hovering a size row opens its submenu; a pick applies at once (and is saved: in
' a workspace, into it - GUI/WORKSPACE-APPLY). A cycling row runs its action.
' =============================================================================

FUNCTION PSM_n$ (v AS INTEGER)
    PSM_n$ = _TRIM$(STR$(v))
END FUNCTION


SUB PSM_build_root ()
    DIM i AS INTEGER
    POPUP_MENU_clear_items
    POPUP_MENU_set_item 0, "MAX ROWS = " + PSM_n$(CFG.PALETTE_MAX_ROWS%), ">", 1, 0
    POPUP_MENU_set_item 1, "MAX COLUMNS = " + PSM_n$(CFG.PALETTE_MAX_CHIPS_PER_ROW%), ">", 2, 0
    POPUP_MENU_set_item 2, "CHIP HEIGHT = " + PSM_n$(CFG.PALETTE_CHIP_HEIGHT%), ">", 3, 0
    POPUP_MENU_set_item 3, "CHIP WIDTH = " + PSM_n$(CFG.PALETTE_CHIP_WIDTH%), ">", 4, 0
    POPUP_MENU_set_item 4, "EDGE = " + PSM_edge_name$(PALETTE_STRIP_edge%), ">", 5, 0
    POPUP_MENU_set_item 5, "", "", 0, POPUP_MENU_FLAG_DIVIDER
    POPUP_MENU_set_item 6, "COLOR CYCLING:", "", 0, POPUP_MENU_FLAG_DISABLED
    POPUP_MENU_set_item 7, "", "", 0, POPUP_MENU_FLAG_DIVIDER
    ' the same rows as Palette > Color Cycling (GUI/MENUBAR.BM), same order
    FOR i = 0 TO 8
        POPUP_MENU_set_item 8 + i, PSM_cycle_label$(i), "", PSM_ACT_BASE + 2061 + i, 0
    NEXT i
END SUB


FUNCTION PSM_edge_name$ (e AS INTEGER)
    PSM_edge_name$ = _TRIM$(MID$("BOTTOMTOP   LEFT  RIGHT ", e * 6 + 1, 6))
END FUNCTION


FUNCTION PSM_cycle_label$ (i AS INTEGER)
    SELECT CASE i
        CASE 0: PSM_cycle_label$ = "RANGE FROM MARKED CHIPS"
        CASE 1: PSM_cycle_label$ = "DELETE RANGE"
        CASE 2: PSM_cycle_label$ = "CLEAR ALL RANGES"
        CASE 3: PSM_cycle_label$ = "CHANGE DIRECTION"
        CASE 4: PSM_cycle_label$ = "PAUSE / RESUME RANGE"
        CASE 5: PSM_cycle_label$ = "FASTER"
        CASE 6: PSM_cycle_label$ = "SLOWER"
        CASE 7: PSM_cycle_label$ = "RESTART ALL"
        CASE 8: PSM_cycle_label$ = "CHECK DUPLICATE COLORS"
    END SELECT
END FUNCTION


' Fill the popup list with root row r's values; returns how many.
' Values: 1000 + rows, 2000 + columns, 3000 + chip height, 4000 + chip width,
' 5000 + edge (PSTRIP_*).
FUNCTION PSM_build_sub% (r AS INTEGER)
    DIM k AS INTEGER, n AS INTEGER, v AS INTEGER, cur AS INTEGER, vBase AS INTEGER
    POPUP_MENU_clear_items
    SELECT CASE r
        CASE 0
            FOR k = 1 TO 8
                POPUP_MENU_set_item n, PSM_n$(k), "", 1000 + k, _IIF(CFG.PALETTE_MAX_ROWS% = k, POPUP_MENU_FLAG_CHECKED, 0): n = n + 1
            NEXT k
        CASE 1
            FOR k = 1 TO 6
                v = VAL(MID$("016032048064128256", k * 3 - 2, 3))
                POPUP_MENU_set_item n, PSM_n$(v), "", 2000 + v, _IIF(CFG.PALETTE_MAX_CHIPS_PER_ROW% = v, POPUP_MENU_FLAG_CHECKED, 0): n = n + 1
            NEXT k
        CASE 2, 3
            IF r = 2 THEN cur = CFG.PALETTE_CHIP_HEIGHT%: vBase = 3000 ELSE cur = CFG.PALETTE_CHIP_WIDTH%: vBase = 4000
            FOR k = 4 TO 32
                POPUP_MENU_set_item n, PSM_n$(k), "", vBase + k, _IIF(cur = k, POPUP_MENU_FLAG_CHECKED, 0): n = n + 1
            NEXT k
        CASE 4 ' where the strip docks
            FOR k = PSTRIP_BOTTOM TO PSTRIP_RIGHT
                POPUP_MENU_set_item n, PSM_edge_name$(k), "", 5000 + k, _IIF(PALETTE_STRIP_edge% = k, POPUP_MENU_FLAG_CHECKED, 0): n = n + 1
            NEXT k
    END SELECT
    PSM_build_sub% = n
END FUNCTION


FUNCTION PSM_font& ()
    IF MENU_BAR.fontHandle& > 0 THEN PSM_font& = MENU_BAR.fontHandle&
END FUNCTION


SUB PSM_open (x AS INTEGER, y AS INTEGER)
    DIM px AS INTEGER, py AS INTEGER, ph AS INTEGER
    IF PALETTE_MENU_VISIBLE% THEN PALETTE_MENU_hide
    PSM_build_root
    PSM.rw = POPUP_MENU_measure_width%(PSM_ROOT_N, PSM_font&)
    POPUP_MENU_place x, y, PSM.rw, PSM_ROOT_N, PSM_ITEM_H, px, py, ph
    PSM.rx = px: PSM.ry = py
    PSM.rHover = -1: PSM.subRow = -1: PSM.sbHover = -1: PSM.sbN = 0
    PSM.isOpen = TRUE
    MOUSE.UI_CHROME_CLICKED% = TRUE
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


SUB PSM_close ()
    PSM.isOpen = FALSE
    PSM.subRow = -1: PSM.rHover = -1: PSM.sbHover = -1
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
    INVALIDATE_scene
END SUB


' Open root row r's submenu beside it (right of the root, or left when there
' is no room), its top level with the row, pulled up to stay on screen.
SUB PSM_open_sub (r AS INTEGER)
    DIM h AS INTEGER
    PSM.subRow = r
    PSM.sbN = PSM_build_sub%(r)
    PSM.sbW = POPUP_MENU_measure_width%(PSM.sbN, PSM_font&)
    h = POPUP_MENU_total_height%(PSM.sbN, PSM_ITEM_H)
    PSM.sbX = PSM.rx + PSM.rw - 1
    IF PSM.sbX + PSM.sbW + 1 > SCRN.w& THEN PSM.sbX = PSM.rx - PSM.sbW + 1
    IF PSM.sbX < 1 THEN PSM.sbX = 1
    PSM.sbY = PSM.ry + r * PSM_ITEM_H
    IF PSM.sbY + h + 1 > SCRN.h& THEN PSM.sbY = SCRN.h& - h - 1
    IF PSM.sbY < 1 THEN PSM.sbY = 1
    PSM.sbHover = -1
    GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


FUNCTION PSM_in_box% (bx AS INTEGER, by AS INTEGER, bw AS INTEGER, n AS INTEGER, mx AS INTEGER, my AS INTEGER)
    PSM_in_box% = (mx >= bx _ANDALSO mx < bx + bw _ANDALSO my >= by _ANDALSO my < by + POPUP_MENU_total_height%(n, PSM_ITEM_H))
END FUNCTION


''
' MOUSE_process_frame, first: while the menu is open it has the pointer.
' Hover a root row = its submenu; a press in the submenu picks; a press on
' the root keeps it open; a press anywhere else (or Esc) closes it.
' Returns TRUE (the frame is the menu's).
FUNCTION PSM_mouse% ()
    DIM mx AS INTEGER, my AS INTEGER, hv AS INTEGER, v AS INTEGER, pressed AS INTEGER
    IF PSM.isOpen = 0 THEN EXIT FUNCTION
    PSM_mouse% = TRUE
    MOUSE.UI_CHROME_CLICKED% = TRUE
    IF _KEYDOWN(27) THEN PSM_close: EXIT FUNCTION
    mx = MOUSE.RAW_X%: my = MOUSE.RAW_Y%
    pressed = (MOUSE.B1% <> 0 _ANDALSO MOUSE.OLD_B1% = 0) _ORELSE (MOUSE.B2% <> 0 _ANDALSO MOUSE.OLD_B2% = 0)

    ' the submenu first (it may overlap the root)
    IF PSM.subRow >= 0 THEN
        v = PSM_build_sub%(PSM.subRow)
        IF PSM_in_box%(PSM.sbX, PSM.sbY, PSM.sbW, PSM.sbN, mx, my) THEN
            hv = POPUP_MENU_hover_row%(PSM.sbX, PSM.sbY, PSM.sbW, PSM.sbN, PSM_ITEM_H, mx, my)
            IF hv <> PSM.sbHover THEN PSM.sbHover = hv: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
            IF pressed THEN
                v = POPUP_MENU_hit_value%(PSM.sbX, PSM.sbY, PSM.sbW, PSM.sbN, PSM_ITEM_H, mx, my)
                IF v >= 1000 THEN PSM_close: PSM_pick v
            END IF
            EXIT FUNCTION
        END IF
        IF PSM.sbHover <> -1 THEN PSM.sbHover = -1: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
    END IF

    PSM_build_root
    IF PSM_in_box%(PSM.rx, PSM.ry, PSM.rw, PSM_ROOT_N, mx, my) THEN
        hv = POPUP_MENU_hover_row%(PSM.rx, PSM.ry, PSM.rw, PSM_ROOT_N, PSM_ITEM_H, mx, my)
        IF hv <> PSM.rHover THEN PSM.rHover = hv: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
        IF hv >= 0 _ANDALSO hv < PSM_SIZE_ROWS _ANDALSO hv <> PSM.subRow THEN PSM_open_sub hv
        IF hv >= PSM_SIZE_ROWS _ANDALSO PSM.subRow >= 0 THEN PSM.subRow = -1: PSM.sbHover = -1: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE: INVALIDATE_scene
        IF pressed _ANDALSO hv >= PSM_SIZE_ROWS THEN
            v = POPUP_MENU_hit_value%(PSM.rx, PSM.ry, PSM.rw, PSM_ROOT_N, PSM_ITEM_H, mx, my)
            IF v > PSM_ACT_BASE THEN PSM_close: CMD_execute_action v - PSM_ACT_BASE
        END IF
        EXIT FUNCTION
    END IF
    IF PSM.rHover <> -1 THEN PSM.rHover = -1: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
    IF pressed THEN PSM_close
END FUNCTION


SUB PSM_pick (v AS INTEGER)
    DIM msg AS STRING
    SELECT CASE v
        CASE 1001 TO 1008
            CFG.PALETTE_MAX_ROWS% = v - 1000: msg = "Color strip: at most " + PSM_n$(v - 1000) + " rows"
        CASE 2001 TO 2999
            CFG.PALETTE_MAX_CHIPS_PER_ROW% = v - 2000: msg = "Color strip: at most " + PSM_n$(v - 2000) + " colors a row"
        CASE 3004 TO 3032
            CFG.PALETTE_CHIP_HEIGHT% = v - 3000: msg = "Color strip: chips " + PSM_n$(v - 3000) + " px tall"
        CASE 4004 TO 4032
            CFG.PALETTE_CHIP_WIDTH% = v - 4000: msg = "Color strip: chips " + PSM_n$(v - 4000) + " px wide"
        CASE 5000 TO 5003
            CFG.PALETTE_STRIP_EDGE% = v - 5000: msg = "Color strip: docked " + LCASE$(_IIF(v = 5000, "at the bottom", _IIF(v = 5001, "at the top", _IIF(v = 5002, "on the left", "on the right"))))
            IF PALETTE_MENU_VISIBLE% THEN PALETTE_MENU_hide
        CASE ELSE
            EXIT SUB
    END SELECT
    ' the strip's height feeds the whole layout (canvas, docks, the status bar)
    PALETTE_STRIP_Y% = SCRN.h& - THEME.STATUS_height% - PALETTE_STRIP_get_height%
    SCREEN_compute_layout
    CONFIG_save
    STATUS_flash msg
    GUI_NEEDS_REDRAW% = TRUE
    STATUS_NEEDS_REDRAW% = TRUE
    FRAME_IDLE% = FALSE
    INVALIDATE_scene
END SUB


''
' SCREEN_render, after SkipToPointer: the root and its submenu over everything.
SUB PSM_render ()
    DIM oldDest AS LONG, n AS INTEGER
    IF PSM.isOpen = 0 THEN EXIT SUB
    oldDest = _DEST
    PSM_build_root
    POPUP_MENU_render SCRN.CANVAS&, PSM.rx, PSM.ry, PSM.rw, PSM_ROOT_N, PSM_ITEM_H, _IIF(PSM.rHover >= 0, PSM.rHover, PSM.subRow), PSM_font&
    IF PSM.subRow >= 0 THEN
        n = PSM_build_sub%(PSM.subRow)
        POPUP_MENU_render SCRN.CANVAS&, PSM.sbX, PSM.sbY, PSM.sbW, n, PSM_ITEM_H, PSM.sbHover, PSM_font&
    END IF
    _DEST oldDest
END SUB
