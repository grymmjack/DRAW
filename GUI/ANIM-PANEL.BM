''
' DRAW - GUI/ANIM-PANEL.BM
' =============================================================================
' Animation panel (see ANIM-PANEL.BI). Window plumbing follows GUI/PEN-PANEL.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Defaults + the open state from DRAW.cfg (the buffer is made on first use).
SUB ANIMP_init ()
    ANIMP.visible = FALSE: ANIMP.positioned = FALSE: ANIMP.initialized = FALSE
    ANIMP.autoHidden = FALSE: ANIMP.renderScale = 1: ANIMP.panelImg = 0
    ANIMP.dragging = FALSE: ANIMP.pressCtl = ANIMP_CTL_NONE: ANIMP.hoverCtl = ANIMP_CTL_NONE
    IF CFG.ANIM_PANEL_VISIBLE% THEN ANIMP.visible = TRUE
END SUB

SUB ANIMP_ensure_initialized ()
    IF ANIMP.initialized THEN EXIT SUB
    ANIMP_layout
    IF ANIMP.panelImg < -1 THEN _FREEIMAGE ANIMP.panelImg
    ANIMP.panelImg = _NEWIMAGE(ANIMP.panelW, ANIMP.panelH, 32)
    ANIMP_compute_display_size
    IF CFG.ANIM_PANEL_X% >= 0 _ANDALSO CFG.ANIM_PANEL_Y% >= 0 THEN
        ANIMP.dispX = CFG.ANIM_PANEL_X%: ANIMP.dispY = CFG.ANIM_PANEL_Y%
        ANIMP.positioned = TRUE
    END IF
    ANIMP.initialized = TRUE
END SUB

''
' Rows from the shared floating-panel font: status / nav buttons / W H
' gutter margin / FPS hold / loop chips / info.
SUB ANIMP_layout ()
    DIM f AS INTEGER, g AS INTEGER, sec AS INTEGER, rh AS INTEGER, y AS INTEGER, r AS INTEGER
    FPANEL_ensure
    ANIMP.natW = FPANEL_panel_w%
    ANIMP.panelW = FPANEL_fit_size%(ANIMP.natW, ANIMP.fitW) ' docked: the slot's width (rows stretch)
    f = FPANEL.fontH: g = FPANEL.gap: sec = FPANEL.section: rh = FPANEL.rowH
    y = FPANEL.titleH + FPANEL.pad
    ANIMP.yStatus = y: y = y + f + g
    ANIMP.yNav = y: y = y + rh + g
    ANIMP.yOps = y: y = y + rh + sec
    FOR r = 1 TO ANIMP_ROWS
        ANIMP_rowY(r) = y: y = y + rh + g
        IF r = ANIMP_ROW_MARGIN THEN ANIMP.yMode = y: y = y + rh + sec
    NEXT r
    y = y + sec - g
    ANIMP.yLoop = y: y = y + rh + sec
    ANIMP.yOnion = y: y = y + rh + g
    FOR r = 1 TO ANIMP_ON_ROWS
        ANIMP_onY(r) = y: y = y + rh + g
    NEXT r
    y = y + sec - g
    ANIMP.yScale = y: y = y + rh + g
    ANIMP.yExport = y: y = y + rh + sec
    ANIMP.yInfo = y: y = y + f + FPANEL.pad
    ANIMP.panelH = y: ANIMP.natH = y ' nothing here grows taller
    ANIMP.chipW = rh + 2
    ANIMP.valW = FPANEL_text_w%("9999") + 4
END SUB

''
' Docked: lay out to nw native px wide (0 = natural); the height stays.
SUB ANIMP_fit (nw AS INTEGER, nh AS INTEGER)
    IF nw = ANIMP.fitW _ANDALSO nh = ANIMP.fitH THEN EXIT SUB
    ANIMP.fitW = nw: ANIMP.fitH = nh
    IF ANIMP.initialized = 0 THEN EXIT SUB ' ANIMP_ensure_initialized lays it out
    DIM oldW AS INTEGER, oldH AS INTEGER
    oldW = ANIMP.panelW: oldH = ANIMP.panelH
    ANIMP_layout
    IF ANIMP.panelW <> oldW _ORELSE ANIMP.panelH <> oldH _ORELSE ANIMP.panelImg >= -1 THEN
        IF ANIMP.panelImg < -1 THEN _FREEIMAGE ANIMP.panelImg
        ANIMP.panelImg = _NEWIMAGE(ANIMP.panelW, ANIMP.panelH, 32)
    END IF
    ANIMP_compute_display_size
END SUB

SUB ANIMP_reset ()
    ANIMP.autoHidden = FALSE: ANIMP.dragging = FALSE
    ANIMP.pressCtl = ANIMP_CTL_NONE: ANIMP.hoverCtl = ANIMP_CTL_NONE
END SUB

SUB ANIMP_toggle ()
    ANIMP.pendRow = 0 ' closing / opening drops a waiting re-slice / resize question
    IF ANIMP.visible THEN
        ANIMP.visible = FALSE
    ELSE
        ANIMP.visible = TRUE: ANIMP.autoHidden = FALSE
        ANIMP_ensure_initialized
        IF ANIMP.positioned = 0 THEN ANIMP_auto_position
        FPANEL_place REGION_ANIM_PANEL, ANIMP.dispX, ANIMP.dispY, ANIMP.dispW, ANIMP.dispH, ANIMP.dispX, ANIMP.dispY
        CFG.ANIM_PANEL_X% = ANIMP.dispX: CFG.ANIM_PANEL_Y% = ANIMP.dispY
    END IF
    CFG.ANIM_PANEL_VISIBLE% = ANIMP.visible
    SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
END SUB

SUB ANIMP_compute_display_size ()
    DIM ts AS INTEGER, ds AS INTEGER
    ts = FPANEL_scale%(DP_ANIM): IF ts < 1 THEN ts = 1
    ds = SCRN.displayScale%: IF ds < 1 THEN ds = 1
    ANIMP.renderScale = CSNG(ts) / CSNG(ds)
    ANIMP.dispW = INT(CSNG(ANIMP.panelW) * ts / ds + 0.5)
    ANIMP.dispH = INT(CSNG(ANIMP.panelH) * ts / ds + 0.5)
END SUB

''
' First open: the top right of the work area.
SUB ANIMP_auto_position ()
    DIM minY AS INTEGER, maxY AS INTEGER
    ANIMP_ensure_initialized
    CS3D_work_area minY, maxY
    ANIMP.dispX = SCRN.uiRightEdge% - ANIMP.dispW - 8
    IF ANIMP.dispX < SCRN.uiLeftEdge% + 8 THEN ANIMP.dispX = SCRN.uiLeftEdge% + 8
    ANIMP.dispY = minY + 8
    ANIMP.positioned = TRUE
    CFG.ANIM_PANEL_X% = ANIMP.dispX: CFG.ANIM_PANEL_Y% = ANIMP.dispY
END SUB

SUB ANIMP_clamp_to_work_area ()
    DIM minY AS INTEGER, maxY AS INTEGER, lx AS LONG, ly AS LONG
    IF ANIMP.initialized = 0 _ORELSE ANIMP.docked THEN EXIT SUB
    CS3D_work_area minY, maxY
    lx = ANIMP.dispX: ly = ANIMP.dispY
    LAY_clamp lx, ly, CLNG(ANIMP.dispW), CLNG(ANIMP.dispH), CLNG(SCRN.uiLeftEdge%), CLNG(minY), CLNG(SCRN.uiRightEdge%), CLNG(maxY)
    ANIMP.dispX = lx: ANIMP.dispY = ly
END SUB

FUNCTION ANIMP_hit_window% (rawX AS INTEGER, rawY AS INTEGER)
    IF DOCK_native_off%(DP_ANIM) THEN EXIT FUNCTION
    IF ANIMP.initialized = 0 THEN EXIT FUNCTION
    IF rawX >= ANIMP.dispX _ANDALSO rawX < ANIMP.dispX + ANIMP.dispW _ANDALSO rawY >= ANIMP.dispY _ANDALSO rawY < ANIMP.dispY + ANIMP.dispH THEN ANIMP_hit_window% = TRUE
END FUNCTION

FUNCTION ANIMP_active_hit% (rawX AS INTEGER, rawY AS INTEGER)
    IF ANIMP.visible = 0 _ORELSE ANIMP.autoHidden THEN EXIT FUNCTION
    ANIMP_active_hit% = ANIMP_hit_window%(rawX, rawY)
END FUNCTION

' ---------------------------------------------------------------------------
' Geometry of the controls (native px)
' ---------------------------------------------------------------------------

''
' Stepper row r: x of its -, its value and its +.
SUB ANIMP_stepper_x (minusX AS INTEGER, valX AS INTEGER, plusX AS INTEGER)
    plusX = ANIMP.panelW - FPANEL.pad - ANIMP.chipW
    valX = plusX - 2 - ANIMP.valW
    minusX = valX - 2 - ANIMP.chipW
END SUB

''
' Chip k (0-based) of n across the panel at y: x and w.
SUB ANIMP_chip_x (k AS INTEGER, n AS INTEGER, x AS INTEGER, w AS INTEGER)
    DIM span AS INTEGER, gap AS INTEGER
    gap = 2
    span = ANIMP.panelW - 2 * FPANEL.pad
    w = (span - gap * (n - 1)) \ n
    x = FPANEL.pad + k * (w + gap)
END SUB

FUNCTION ANIMP_hit% (nx AS INTEGER, ny AS INTEGER)
    DIM r AS INTEGER, k AS INTEGER, mx AS INTEGER, vx AS INTEGER, px AS INTEGER, cx AS INTEGER, cw AS INTEGER, rh AS INTEGER
    rh = FPANEL.rowH
    ANIMP_stepper_x mx, vx, px
    FOR r = 1 TO ANIMP_ROWS
        IF ny >= ANIMP_rowY(r) _ANDALSO ny < ANIMP_rowY(r) + rh THEN
            IF nx >= mx _ANDALSO nx < mx + ANIMP.chipW THEN ANIMP_hit% = 2 * r - 1: EXIT FUNCTION
            IF nx >= px _ANDALSO nx < px + ANIMP.chipW THEN ANIMP_hit% = 2 * r: EXIT FUNCTION
        END IF
    NEXT r
    FOR r = 1 TO ANIMP_ON_ROWS
        IF ny >= ANIMP_onY(r) _ANDALSO ny < ANIMP_onY(r) + rh THEN
            IF nx >= mx _ANDALSO nx < mx + ANIMP.chipW THEN ANIMP_hit% = ANIMP_CTL_ON0 + 2 * (r - 1): EXIT FUNCTION
            IF nx >= px _ANDALSO nx < px + ANIMP.chipW THEN ANIMP_hit% = ANIMP_CTL_ON0 + 2 * (r - 1) + 1: EXIT FUNCTION
        END IF
    NEXT r
    IF ny >= ANIMP.yOnion _ANDALSO ny < ANIMP.yOnion + rh THEN
        FOR k = 0 TO 1
            ANIMP_chip_x k, 2, cx, cw
            IF nx >= cx _ANDALSO nx < cx + cw THEN ANIMP_hit% = ANIMP_CTL_ONION + k: EXIT FUNCTION
        NEXT k
    END IF
    IF ny >= ANIMP.yScale _ANDALSO ny < ANIMP.yScale + rh THEN ' [SCALE] 1X 2X 4X
        FOR k = 1 TO 3
            ANIMP_chip_x k, 4, cx, cw
            IF nx >= cx _ANDALSO nx < cx + cw THEN ANIMP_hit% = ANIMP_CTL_SCALE0 + k - 1: EXIT FUNCTION
        NEXT k
    END IF
    IF ny >= ANIMP.yExport _ANDALSO ny < ANIMP.yExport + rh THEN ' [EXPORT] GIF APNG BAS
        FOR k = 1 TO 3
            ANIMP_chip_x k, 4, cx, cw
            IF nx >= cx _ANDALSO nx < cx + cw THEN ANIMP_hit% = ANIMP_CTL_EXP0 + k - 1: EXIT FUNCTION
        NEXT k
    END IF
    IF ny >= ANIMP.yMode _ANDALSO ny < ANIMP.yMode + rh THEN
        FOR k = 0 TO 1
            ANIMP_chip_x k, 2, cx, cw
            IF nx >= cx _ANDALSO nx < cx + cw THEN ANIMP_hit% = ANIMP_CTL_RESLICE + k: EXIT FUNCTION
        NEXT k
    END IF
    IF ny >= ANIMP.yNav _ANDALSO ny < ANIMP.yNav + rh THEN ' |< < PLAY > >|
        FOR k = 0 TO 4
            ANIMP_chip_x k, 5, cx, cw
            IF nx >= cx _ANDALSO nx < cx + cw THEN ANIMP_hit% = ANIMP_nav_ctl%(k): EXIT FUNCTION
        NEXT k
    END IF
    FOR k = 0 TO 3
        ANIMP_chip_x k, 4, cx, cw
        IF nx >= cx _ANDALSO nx < cx + cw THEN
            IF ny >= ANIMP.yLoop _ANDALSO ny < ANIMP.yLoop + rh THEN ANIMP_hit% = ANIMP_CTL_LOOP0 + k: EXIT FUNCTION
            IF ny >= ANIMP.yOps _ANDALSO ny < ANIMP.yOps + rh THEN ANIMP_hit% = ANIMP_CTL_ADD + k: EXIT FUNCTION
        END IF
    NEXT k
END FUNCTION

' ---------------------------------------------------------------------------
' Values
' ---------------------------------------------------------------------------

''
' Row r's value: the layout's, or on a picture without frames the whole
' canvas as one frame.
FUNCTION ANIMP_value% (r AS INTEGER)
    DIM isOn AS INTEGER
    isOn = ANIM.active
    SELECT CASE r
        CASE ANIMP_ROW_W: ANIMP_value% = _IIF(isOn, ANIM.frameW, SCRN.canvasW&)
        CASE ANIMP_ROW_H: ANIMP_value% = _IIF(isOn, ANIM.frameH, SCRN.canvasH&)
        CASE ANIMP_ROW_GUTTER: ANIMP_value% = _IIF(isOn, ANIM.gutter, 0)
        CASE ANIMP_ROW_MARGIN: ANIMP_value% = _IIF(isOn, ANIM.margin, 0)
        CASE ANIMP_ROW_FPS: ANIMP_value% = ANIM.fps
        CASE ANIMP_ROW_HOLD: ANIMP_value% = ANIM_hold%(ANIM.current)
    END SELECT
END FUNCTION

''
' Does row r do anything now? Timing needs frames; the size rows always work.
FUNCTION ANIMP_row_on% (r AS INTEGER)
    IF r <= ANIMP_ROW_MARGIN THEN ANIMP_row_on% = TRUE ELSE ANIMP_row_on% = (ANIM.active <> 0)
END FUNCTION

''
' Step row r by d (the panel's - / + buttons). Every change is an undo step (a
' held stepper one step). The first layout change on a drawn sheet waits for
' RE-SLICE / RESIZE (R-07), asked once per document.
SUB ANIMP_step (r AS INTEGER, d AS INTEGER)
    DIM fw AS LONG, fh AS LONG, gu AS LONG, ma AS LONG, v AS LONG, resize AS INTEGER
    IF ANIMP_row_on%(r) = 0 THEN EXIT SUB
    SELECT CASE r
        CASE ANIMP_ROW_W TO ANIMP_ROW_MARGIN
            IF ANIM.active _ANDALSO ANIM_SIZE_MODE = ANIM_SIZE_ASK THEN
                IF ANIM_OPS_sheet_drawn% THEN
                    ANIMP.pendRow = r: ANIMP.pendD = d: ANIMP.pressCtl = ANIMP_CTL_NONE
                    STATUS_flash "Re-slice (the pixels stay) or resize the frames (the drawings follow)? Pick one in the Animation panel"
                    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
                    EXIT SUB
                END IF
            END IF
            resize = (ANIM.active <> 0 _ANDALSO ANIM_SIZE_MODE = ANIM_SIZE_RESIZE)
            fw = ANIMP_value%(ANIMP_ROW_W): fh = ANIMP_value%(ANIMP_ROW_H)
            gu = ANIMP_value%(ANIMP_ROW_GUTTER): ma = ANIMP_value%(ANIMP_ROW_MARGIN)
            SELECT CASE r
                CASE ANIMP_ROW_W: fw = fw + d
                CASE ANIMP_ROW_H: fh = fh + d
                CASE ANIMP_ROW_GUTTER: gu = gu + d
                CASE ANIMP_ROW_MARGIN: ma = ma + d
            END SELECT
            IF fw < 1 THEN fw = 1
            IF fh < 1 THEN fh = 1
            IF resize = 0 THEN ' re-slice: the frames fit the canvas
                IF fw > SCRN.canvasW& THEN fw = SCRN.canvasW&
                IF fh > SCRN.canvasH& THEN fh = SCRN.canvasH&
            END IF
            IF gu < 0 THEN gu = 0
            IF gu > 255 THEN gu = 255
            IF ma < 0 THEN ma = 0
            IF ma > 255 THEN ma = 255
            ANIM_OPS_relayout CINT(_MIN(fw, ANIM_SHEET_MAX)), CINT(_MIN(fh, ANIM_SHEET_MAX)), CINT(gu), CINT(ma), resize, ANIMP.pressKey
        CASE ANIMP_ROW_FPS
            v = ANIM.fps + d: ANIM_OPS_timing CINT(_MAX(1, _MIN(ANIM_FPS_MAX, v))), 0, 0, ANIMP.pressKey
        CASE ANIMP_ROW_HOLD
            v = ANIM_hold%(ANIM.current) + d: ANIM_OPS_timing 0, ANIM.current, CINT(_MAX(1, _MIN(ANIM_HOLD_MAX, v))), ANIMP.pressKey
    END SELECT
END SUB

''
' Run control c (a click, or a held stepper's repeat).
SUB ANIMP_do (c AS INTEGER)
    DIM d AS INTEGER, pr AS INTEGER
    IF c <> ANIMP_CTL_RESLICE _ANDALSO c <> ANIMP_CTL_RESIZE THEN ANIMP.pendRow = 0 ' anything else drops the question
    SELECT CASE c
        CASE 1 TO 2 * ANIMP_ROWS
            DIM r AS INTEGER
            d = _IIF(MODIFIERS.shift%, 10, 1)
            IF c MOD 2 = 1 THEN d = -d
            r = (c + 1) \ 2
            ANIMP_step r, d
        CASE ANIMP_CTL_FIRST TO ANIMP_CTL_LAST
            IF ANIM.active THEN CMD_execute_action ANIM_ACT_FIRST + (c - ANIMP_CTL_FIRST)
        CASE ANIMP_CTL_LOOP0 TO ANIMP_CTL_LOOP0 + 3
            IF ANIM.active _ANDALSO ANIM.loopMode <> c - ANIMP_CTL_LOOP0 THEN ANIM.loopMode = c - ANIMP_CTL_LOOP0: INVALIDATE_canvas
        CASE ANIMP_CTL_ADD TO ANIMP_CTL_DEL
            CMD_execute_action ANIM_ACT_OP0 + ANIMP_op%(c) ' refusals flash in the status bar
        CASE ANIMP_CTL_PLAY
            CMD_execute_action ANIM_ACT_PLAY
        CASE ANIMP_CTL_ON0 TO ANIMP_CTL_ON0 + 2 * ANIMP_ON_ROWS - 1
            d = _IIF(MODIFIERS.shift%, 10, 1)
            IF (c - ANIMP_CTL_ON0) MOD 2 = 0 THEN d = -d
            ANIMP_onion_step (c - ANIMP_CTL_ON0) \ 2 + 1, d
        CASE ANIMP_CTL_ONION: CMD_execute_action ANIM_ACT_ONION
        CASE ANIMP_CTL_TINT: CMD_execute_action ANIM_ACT_ONION_TINT
        CASE ANIMP_CTL_SCALE0 TO ANIMP_CTL_SCALE0 + 2 ' export scale 1x / 2x / 4x
            d = 2 ^ (c - ANIMP_CTL_SCALE0)
            IF CFG.ANIM_EXPORT_SCALE% <> d THEN
                CFG.ANIM_EXPORT_SCALE% = d: CONFIG_save
                STATUS_flash "Animation exports at" + STR$(d) + "x"
            END IF
        CASE ANIMP_CTL_EXP0 TO ANIMP_CTL_EXP0 + 2 ' the ANIM > Export ... items
            IF ANIM.active = 0 THEN STATUS_flash "Export: the picture has no frames yet": EXIT SUB
            ANIMP.pressCtl = ANIMP_CTL_NONE ' a dialog opens: no held repeat after it
            SELECT CASE c - ANIMP_CTL_EXP0
                CASE 0: CMD_execute_action ANIM_ACT_EXPORT_GIF
                CASE 1: CMD_execute_action ANIM_ACT_EXPORT_APNG
                CASE 2: CMD_execute_action ANIM_ACT_EXPORT_BAS
            END SELECT
        CASE ANIMP_CTL_RESLICE, ANIMP_CTL_RESIZE
            IF ANIM.active = FALSE THEN EXIT SUB
            ANIM_SIZE_MODE = _IIF(c = ANIMP_CTL_RESIZE, ANIM_SIZE_RESIZE, ANIM_SIZE_RESLICE)
            IF ANIM_SIZE_MODE = ANIM_SIZE_RESIZE THEN
                STATUS_flash "Frame size changes resize the frames: the drawings follow"
            ELSE
                STATUS_flash "Frame size changes re-slice the sheet: the pixels stay"
            END IF
            IF ANIMP.pendRow THEN ' the change that asked
                pr = ANIMP.pendRow: ANIMP.pendRow = 0
                ANIMP_step pr, ANIMP.pendD
            END IF
    END SELECT
END SUB

''
' Onion skin row r (1 BEFORE, 2 AFTER, 3 OPACITY: d x 5 %) value and step.
FUNCTION ANIMP_onion_value% (r AS INTEGER)
    SELECT CASE r
        CASE 1: ANIMP_onion_value% = CFG.ONION_BEFORE%
        CASE 2: ANIMP_onion_value% = CFG.ONION_AFTER%
        CASE 3: ANIMP_onion_value% = CFG.ONION_OPACITY%
    END SELECT
END FUNCTION

SUB ANIMP_onion_step (r AS INTEGER, d AS INTEGER)
    SELECT CASE r
        CASE 1: CFG.ONION_BEFORE% = _MAX(0, _MIN(ANIM_ONION_MAX, CFG.ONION_BEFORE% + d))
        CASE 2: CFG.ONION_AFTER% = _MAX(0, _MIN(ANIM_ONION_MAX, CFG.ONION_AFTER% + d))
        CASE 3: CFG.ONION_OPACITY% = _MAX(5, _MIN(100, CFG.ONION_OPACITY% + d * 5))
    END SELECT
    ANIMP.onionSave = TRUE ' saved on the release (a held stepper repeats)
    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' Control of chip k (0-4) of the |< < PLAY > >| row.
FUNCTION ANIMP_nav_ctl% (k AS INTEGER)
    SELECT CASE k
        CASE 0: ANIMP_nav_ctl% = ANIMP_CTL_FIRST
        CASE 1: ANIMP_nav_ctl% = ANIMP_CTL_PREV
        CASE 2: ANIMP_nav_ctl% = ANIMP_CTL_PLAY
        CASE 3: ANIMP_nav_ctl% = ANIMP_CTL_NEXT
        CASE 4: ANIMP_nav_ctl% = ANIMP_CTL_LAST
    END SELECT
END FUNCTION

''
' The frame operation (ANIM_OP_*) behind an ADD / DUP / INS / DEL chip.
FUNCTION ANIMP_op% (c AS INTEGER)
    SELECT CASE c
        CASE ANIMP_CTL_ADD: ANIMP_op% = ANIM_OP_APPEND
        CASE ANIMP_CTL_DUP: ANIMP_op% = ANIM_OP_DUPLICATE
        CASE ANIMP_CTL_INS: ANIMP_op% = ANIM_OP_INSERT_AFTER
        CASE ANIMP_CTL_DEL: ANIMP_op% = ANIM_OP_DELETE
    END SELECT
END FUNCTION

' ---------------------------------------------------------------------------
' Number boxes (F1, field kit T-6): every stepper row's value also takes the
' wheel (+/- 1, Shift +/- 10), a middle click (back to its default), a drag
' up / down, and a click (type the number). Rows: 1..ANIMP_ROWS the layout /
' timing rows, ANIMP_ROWS + 1..ANIMP_ON_ROWS the onion skin rows.
' ---------------------------------------------------------------------------

''
' The number box at native (nx, ny) (0 none). whole = anywhere on its row
' (the wheel, a middle click), else only the value between - and +.
FUNCTION ANIMP_value_at% (nx AS INTEGER, ny AS INTEGER, whole AS INTEGER)
    DIM r AS INTEGER, mx AS INTEGER, vx AS INTEGER, px AS INTEGER, rh AS INTEGER, inX AS INTEGER
    rh = FPANEL.rowH
    ANIMP_stepper_x mx, vx, px
    IF whole THEN inX = (nx >= 0 _ANDALSO nx < ANIMP.panelW) ELSE inX = (nx >= vx _ANDALSO nx < vx + ANIMP.valW)
    IF inX = 0 THEN EXIT FUNCTION
    FOR r = 1 TO ANIMP_ROWS
        IF ny >= ANIMP_rowY(r) _ANDALSO ny < ANIMP_rowY(r) + rh THEN ANIMP_value_at% = r: EXIT FUNCTION
    NEXT r
    FOR r = 1 TO ANIMP_ON_ROWS
        IF ny >= ANIMP_onY(r) _ANDALSO ny < ANIMP_onY(r) + rh THEN ANIMP_value_at% = ANIMP_ROWS + r: EXIT FUNCTION
    NEXT r
END FUNCTION

''
' Box vr's value, label, and whether it does anything now.
FUNCTION ANIMP_box_value% (vr AS INTEGER)
    IF vr <= ANIMP_ROWS THEN ANIMP_box_value% = ANIMP_value%(vr) ELSE ANIMP_box_value% = ANIMP_onion_value%(vr - ANIMP_ROWS)
END FUNCTION

FUNCTION ANIMP_box_label$ (vr AS INTEGER)
    IF vr <= ANIMP_ROWS THEN ANIMP_box_label$ = ANIMP_row_label$(vr) ELSE ANIMP_box_label$ = "ONION " + _TRIM$(MID$("BEFORE AFTER  OPACITY", (vr - ANIMP_ROWS - 1) * 7 + 1, 7))
END FUNCTION

FUNCTION ANIMP_box_on% (vr AS INTEGER)
    IF vr <= ANIMP_ROWS THEN ANIMP_box_on% = ANIMP_row_on%(vr) ELSE ANIMP_box_on% = TRUE
END FUNCTION

''
' Step box vr by d (the onion opacity steps 5 % at a time, as its + / -).
SUB ANIMP_box_step (vr AS INTEGER, d AS INTEGER)
    IF d = 0 _ORELSE ANIMP_box_on%(vr) = 0 THEN EXIT SUB
    IF vr <= ANIMP_ROWS THEN ANIMP_step vr, d ELSE ANIMP_onion_step vr - ANIMP_ROWS, d
END SUB

''
' Set box vr to v (typed, or its default). One undo step (ANIMP.pressKey).
SUB ANIMP_box_set (vr AS INTEGER, v AS LONG)
    DIM r AS INTEGER
    IF ANIMP_box_on%(vr) = 0 THEN EXIT SUB
    IF vr <= ANIMP_ROWS THEN
        v = _MAX(-32000, _MIN(32000, v))
        IF v <> ANIMP_value%(vr) THEN ANIMP_step vr, CINT(v - ANIMP_value%(vr))
        EXIT SUB
    END IF
    r = vr - ANIMP_ROWS
    SELECT CASE r
        CASE 1: CFG.ONION_BEFORE% = _MAX(0, _MIN(ANIM_ONION_MAX, v))
        CASE 2: CFG.ONION_AFTER% = _MAX(0, _MIN(ANIM_ONION_MAX, v))
        CASE 3: CFG.ONION_OPACITY% = _MAX(5, _MIN(100, v))
    END SELECT
    CONFIG_save
    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' A middle click: box vr back to its default (FALSE: it has none - the frame size).
FUNCTION ANIMP_box_reset% (vr AS INTEGER)
    DIM v AS LONG
    SELECT CASE vr
        CASE ANIMP_ROW_W, ANIMP_ROW_H: EXIT FUNCTION
        CASE ANIMP_ROW_GUTTER, ANIMP_ROW_MARGIN: v = 0
        CASE ANIMP_ROW_FPS: v = ANIM_FPS_DEFAULT
        CASE ANIMP_ROW_HOLD: v = 1
        CASE ANIMP_ROWS + 1, ANIMP_ROWS + 2: v = 1
        CASE ANIMP_ROWS + 3: v = 40
        CASE ELSE: EXIT FUNCTION
    END SELECT
    ANIMP.pressKey = ANIMP.pressKey + 1
    ANIMP_box_set vr, v
    ANIMP_box_reset% = TRUE
END FUNCTION

''
' A click on box vr without a drag: type the number.
SUB ANIMP_box_type (vr AS INTEGER)
    DIM t AS STRING, lbl AS STRING
    IF ANIMP_box_on%(vr) = 0 THEN EXIT SUB
    lbl = ANIMP_box_label$(vr)
    POINTER_hide_for_dialog
    t = DRAW_input_box_ex$("Animation", lbl + ":", _TRIM$(STR$(ANIMP_box_value%(vr))), "A number", TRUE)
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog FALSE
    t = _TRIM$(t)
    IF t = "" THEN EXIT SUB ' cancelled
    IF INSTR("-0123456789", LEFT$(t, 1)) = 0 THEN STATUS_flash lbl + ": not a number": EXIT SUB
    ANIMP.pressKey = ANIMP.pressKey + 1
    ANIMP_box_set vr, VAL(t)
END SUB

''
' The wheel over the panel (MOUSE_handle_gui_panels): a row's number box steps;
' TRUE = it was over the panel (the wheel goes no further).
FUNCTION ANIMP_wheel% (delta AS INTEGER)
    DIM nx AS INTEGER, ny AS INTEGER, vr AS INTEGER, t AS DOUBLE
    IF ANIMP.visible = 0 _ORELSE ANIMP.autoHidden _ORELSE ANIMP.initialized = 0 _ORELSE delta = 0 THEN EXIT FUNCTION
    IF ANIMP_hit_window%(MOUSE.RAW_X%, MOUSE.RAW_Y%) = 0 THEN EXIT FUNCTION
    ANIMP_wheel% = TRUE
    IF ANIMP.renderScale <= 0 THEN EXIT FUNCTION
    nx = INT((MOUSE.RAW_X% - ANIMP.dispX) / ANIMP.renderScale): ny = INT((MOUSE.RAW_Y% - ANIMP.dispY) / ANIMP.renderScale)
    vr = ANIMP_value_at%(nx, ny, TRUE)
    IF vr = 0 THEN EXIT FUNCTION
    t = TIMER(.001)
    IF vr <> ANIMP.wheelRow _ORELSE t < ANIMP.wheelT _ORELSE t - ANIMP.wheelT > .8 THEN ANIMP.pressKey = ANIMP.pressKey + 1
    ANIMP.wheelRow = vr: ANIMP.wheelT = t
    ANIMP.pendRow = 0
    ANIMP_box_step vr, -delta * _IIF(MODIFIERS.shift%, 10, 1) ' wheel up = more
    IF ANIMP.onionSave THEN ANIMP.onionSave = FALSE: CONFIG_save
    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END FUNCTION

' ---------------------------------------------------------------------------
' Render
' ---------------------------------------------------------------------------

SUB ANIMP_render ()
    IF ANIMP.visible = 0 _ORELSE ANIMP.autoHidden THEN EXIT SUB
    ANIMP_ensure_initialized
    IF ANIMP.positioned = 0 THEN ANIMP_auto_position
    ANIMP_clamp_to_work_area
    REGION_set_bounds REGION_ANIM_PANEL, ANIMP.dispX, ANIMP.dispY, ANIMP.dispW, ANIMP.dispH, _IIF(ANIMP.docked <> 0, ZORDER_DOCKED_WINDOW, ZORDER_FLOATING)

    ANIMP.hoverCtl = ANIMP_CTL_NONE: ANIMP.closeHover = FALSE
    IF ANIMP_hit_window%(MOUSE.RAW_X%, MOUSE.RAW_Y%) _ANDALSO ANIMP.dragging = 0 _ANDALSO ANIMP.renderScale > 0 THEN
        DIM hx AS INTEGER, hy AS INTEGER
        hx = INT((MOUSE.RAW_X% - ANIMP.dispX) / ANIMP.renderScale)
        hy = INT((MOUSE.RAW_Y% - ANIMP.dispY) / ANIMP.renderScale)
        ANIMP.closeHover = FPANEL_over_close%(hx, hy, ANIMP.panelW)
        ANIMP.hoverCtl = ANIMP_hit%(hx, hy)
    END IF

    DIM oldDest AS LONG, oldFont AS LONG, isOn AS INTEGER, pad AS INTEGER, f AS INTEGER, rh AS INTEGER
    DIM r AS INTEGER, k AS INTEGER, mx AS INTEGER, vx AS INTEGER, px AS INTEGER, cx AS INTEGER, cw AS INTEGER
    DIM fg AS _UNSIGNED LONG, t AS STRING, ty AS INTEGER, en AS INTEGER
    isOn = ANIM.active: pad = FPANEL.pad: f = FPANEL.fontH: rh = FPANEL.rowH
    oldDest = _DEST
    _DEST ANIMP.panelImg
    oldFont = FPANEL_begin&
    CLS , THEME.CP_bg~&
    FPANEL_title_bar ANIMP.panelW, "ANIMATION", ANIMP.closeHover

    IF ANIMP.pendRow _ANDALSO isOn THEN
        FPANEL_text pad, ANIMP.yStatus, "RE-SLICE OR RESIZE?", THEME.CP_text_bright~&
    ELSEIF isOn THEN
        t = _IIF(ANIM_PLAY.playing, "PLAYING", "FRAME") + STR$(ANIM.current) + " OF" + STR$(ANIM.count)
        FPANEL_text pad, ANIMP.yStatus, t, THEME.CP_text_bright~&
    ELSE
        FPANEL_text pad, ANIMP.yStatus, "NO FRAMES - SET A SIZE", THEME.CP_text_dim~&
    END IF

    ' first / previous / play / next / last
    FOR k = 0 TO 4
        ANIMP_chip_x k, 5, cx, cw
        IF k = 2 THEN
            t = _IIF(ANIM_PLAY.playing, "STOP", "PLAY")
            ANIMP_chip cx, ANIMP.yNav, cw, t, ANIM_PLAY.playing <> 0, ANIMP.hoverCtl = ANIMP_CTL_PLAY, isOn _ANDALSO ANIM.count > 1
        ELSE
            t = MID$("|< <     >  >|", k * 3 + 1, 2)
            ANIMP_chip cx, ANIMP.yNav, cw, _TRIM$(t), FALSE, ANIMP.hoverCtl = ANIMP_nav_ctl%(k), isOn
        END IF
    NEXT k

    ' add / duplicate / insert / delete
    FOR k = 0 TO 3
        ANIMP_chip_x k, 4, cx, cw
        t = _TRIM$(MID$("ADD DUP INS DEL", k * 4 + 1, 4))
        ANIMP_chip cx, ANIMP.yOps, cw, t, FALSE, ANIMP.hoverCtl = ANIMP_CTL_ADD + k, ANIM_op_refusal$(ANIMP_op%(ANIMP_CTL_ADD + k)) = ""
    NEXT k

    ' steppers
    ANIMP_stepper_x mx, vx, px
    FOR r = 1 TO ANIMP_ROWS
        en = ANIMP_row_on%(r)
        IF en THEN fg = THEME.CP_text~& ELSE fg = THEME.CP_text_dim~&
        ty = ANIMP_rowY(r) + (rh - f) \ 2
        FPANEL_text pad, ty, ANIMP_row_label$(r), fg
        ANIMP_chip mx, ANIMP_rowY(r), ANIMP.chipW, "-", FALSE, ANIMP.hoverCtl = 2 * r - 1, en
        ANIMP_chip px, ANIMP_rowY(r), ANIMP.chipW, "+", FALSE, ANIMP.hoverCtl = 2 * r, en
        LINE (vx, ANIMP_rowY(r))-(vx + ANIMP.valW - 1, ANIMP_rowY(r) + rh - 1), THEME.CP_slider_bg~&, BF
        LINE (vx, ANIMP_rowY(r))-(vx + ANIMP.valW - 1, ANIMP_rowY(r) + rh - 1), THEME.CP_slider_border~&, B
        t = _TRIM$(STR$(ANIMP_value%(r)))
        FPANEL_text vx + ANIMP.valW - 2 - FPANEL_text_w%(t), ty, t, fg
    NEXT r

    ' re-slice / resize (lit while a change waits for the answer)
    FOR k = 0 TO 1
        ANIMP_chip_x k, 2, cx, cw
        t = MID$("RE-SLICERESIZE", k * 8 + 1, 8)
        ANIMP_chip cx, ANIMP.yMode, cw, _TRIM$(t), isOn _ANDALSO ANIM_SIZE_MODE = k + 1, ANIMP.hoverCtl = ANIMP_CTL_RESLICE + k _ORELSE (ANIMP.pendRow <> 0 _ANDALSO isOn), isOn
    NEXT k

    ' loop mode
    FOR k = 0 TO 3
        ANIMP_chip_x k, 4, cx, cw
        t = _TRIM$(MID$("FWD REV PINGONCE", k * 4 + 1, 4))
        ANIMP_chip cx, ANIMP.yLoop, cw, t, isOn _ANDALSO ANIM.loopMode = k, ANIMP.hoverCtl = ANIMP_CTL_LOOP0 + k, isOn
    NEXT k

    ' onion skin (shows in the lightbox)
    FOR k = 0 TO 1
        ANIMP_chip_x k, 2, cx, cw
        IF k = 0 THEN
            ANIMP_chip cx, ANIMP.yOnion, cw, "ONION", CFG.ONION_SKIN% <> 0, ANIMP.hoverCtl = ANIMP_CTL_ONION, TRUE
        ELSE
            ANIMP_chip cx, ANIMP.yOnion, cw, "TINT", CFG.ONION_TINT% <> 0, ANIMP.hoverCtl = ANIMP_CTL_TINT, CFG.ONION_SKIN% <> 0
        END IF
    NEXT k
    FOR r = 1 TO ANIMP_ON_ROWS
        en = (CFG.ONION_SKIN% <> 0)
        IF en THEN fg = THEME.CP_text~& ELSE fg = THEME.CP_text_dim~&
        ty = ANIMP_onY(r) + (rh - f) \ 2
        FPANEL_text pad, ty, _TRIM$(MID$("BEFORE AFTER  OPACITY", (r - 1) * 7 + 1, 7)), fg
        ANIMP_chip mx, ANIMP_onY(r), ANIMP.chipW, "-", FALSE, ANIMP.hoverCtl = ANIMP_CTL_ON0 + 2 * (r - 1), en
        ANIMP_chip px, ANIMP_onY(r), ANIMP.chipW, "+", FALSE, ANIMP.hoverCtl = ANIMP_CTL_ON0 + 2 * (r - 1) + 1, en
        LINE (vx, ANIMP_onY(r))-(vx + ANIMP.valW - 1, ANIMP_onY(r) + rh - 1), THEME.CP_slider_bg~&, BF
        LINE (vx, ANIMP_onY(r))-(vx + ANIMP.valW - 1, ANIMP_onY(r) + rh - 1), THEME.CP_slider_border~&, B
        t = _TRIM$(STR$(ANIMP_onion_value%(r))) + _IIF(r = 3, "%", "")
        FPANEL_text vx + ANIMP.valW - 2 - FPANEL_text_w%(t), ty, t, fg
    NEXT r

    ' export (F4): [SCALE] 1X 2X 4X, [EXPORT] GIF APNG BAS
    ANIMP_chip_x 0, 4, cx, cw
    FPANEL_text cx, ANIMP.yScale + (rh - f) \ 2, "SCALE", THEME.CP_text~&
    FPANEL_text cx, ANIMP.yExport + (rh - f) \ 2, "EXPORT", _IIF(isOn, THEME.CP_text~&, THEME.CP_text_dim~&)
    FOR k = 1 TO 3
        ANIMP_chip_x k, 4, cx, cw
        ANIMP_chip cx, ANIMP.yScale, cw, MID$("1X2X4X", 2 * k - 1, 2), CFG.ANIM_EXPORT_SCALE% = 2 ^ (k - 1), ANIMP.hoverCtl = ANIMP_CTL_SCALE0 + k - 1, TRUE
        ANIMP_chip cx, ANIMP.yExport, cw, _TRIM$(MID$("GIF APNGBAS ", 4 * k - 3, 4)), FALSE, ANIMP.hoverCtl = ANIMP_CTL_EXP0 + k - 1, isOn
    NEXT k

    IF isOn THEN
        t = _TRIM$(STR$(ANIM_cols%)) + " X" + STR$(ANIM_rows%) + " CELLS," + STR$(ANIM_cells% - ANIM.count) + " SPARE"
    ELSE
        t = _TRIM$(STR$(SCRN.canvasW&)) + " X" + STR$(SCRN.canvasH&) + " PICTURE"
    END IF
    FPANEL_text pad, ANIMP.yInfo, t, THEME.CP_text_dim~&

    FPANEL_frame ANIMP.panelW, ANIMP.panelH
    _FONT oldFont
    _DEST oldDest

    DIM ts AS INTEGER, ds AS INTEGER, sx AS LONG, sy AS LONG
    ts = FPANEL_scale%(DP_ANIM): IF ts < 1 THEN ts = 1
    ds = SCRN.displayScale%: IF ds < 1 THEN ds = 1
    sx = CLNG(ANIMP.dispX) * ds: sy = CLNG(ANIMP.dispY) * ds
    oldDest = _DEST
    _DEST 0
    _PUTIMAGE (sx, sy)-(sx + CLNG(ANIMP.panelW) * ts - 1, sy + CLNG(ANIMP.panelH) * ts - 1), ANIMP.panelImg, 0
    _DEST oldDest
END SUB

FUNCTION ANIMP_row_label$ (r AS INTEGER)
    SELECT CASE r
        CASE ANIMP_ROW_W: ANIMP_row_label$ = "FRAME W"
        CASE ANIMP_ROW_H: ANIMP_row_label$ = "FRAME H"
        CASE ANIMP_ROW_GUTTER: ANIMP_row_label$ = "GUTTER"
        CASE ANIMP_ROW_MARGIN: ANIMP_row_label$ = "MARGIN"
        CASE ANIMP_ROW_FPS: ANIMP_row_label$ = "FPS"
        CASE ANIMP_ROW_HOLD: ANIMP_row_label$ = "HOLD"
    END SELECT
END FUNCTION

''
' FPANEL_chip, greyed when it does nothing.
SUB ANIMP_chip (x AS INTEGER, y AS INTEGER, w AS INTEGER, label AS STRING, active AS INTEGER, hover AS INTEGER, enabled AS INTEGER)
    IF enabled THEN
        FPANEL_chip x, y, w, FPANEL.rowH, label, active, hover
    ELSE
        ANIMP_chip_at x, y, w, FPANEL.rowH, label, FALSE, FALSE
    END IF
END SUB

''
' A chip h px tall (the lightbox's transport bar), greyed when it does nothing.
SUB ANIMP_chip_at (x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, label AS STRING, active AS INTEGER, enabled AS INTEGER)
    IF enabled THEN
        FPANEL_chip x, y, w, h, label, active, FALSE
    ELSE
        LINE (x, y)-(x + w - 1, y + h - 1), THEME.CP_slider_bg~&, BF
        FPANEL_text x + (w - FPANEL_text_w%(label)) \ 2, y + (h - FPANEL.fontH) \ 2, label, THEME.CP_text_dim~&
    END IF
END SUB

''
' A held stepper repeats: redraw while one is held.
FUNCTION ANIMP_needs_redraw% ()
    ANIMP_needs_redraw% = (ANIMP.visible <> 0 _ANDALSO (ANIMP.pressCtl <> ANIMP_CTL_NONE _ORELSE ANIMP.vRow <> 0))
END FUNCTION

' ---------------------------------------------------------------------------
' Mouse (MOUSE_handle_gui_panels, over the panel or while a drag / press is on)
' ---------------------------------------------------------------------------

SUB ANIMP_mouse_input ()
    IF ANIMP.visible = 0 _ORELSE ANIMP.autoHidden _ORELSE ANIMP.initialized = 0 THEN EXIT SUB
    DIM lx AS INTEGER, ly AS INTEGER, nx AS INTEGER, ny AS INTEGER, pressed AS INTEGER, c AS INTEGER, t AS DOUBLE
    DIM vr AS INTEGER, dy AS INTEGER, want AS INTEGER
    lx = MOUSE.RAW_X% - ANIMP.dispX: ly = MOUSE.RAW_Y% - ANIMP.dispY
    IF ANIMP.renderScale > 0 THEN nx = INT(lx / ANIMP.renderScale): ny = INT(ly / ANIMP.renderScale) ELSE nx = lx: ny = ly
    pressed = (MOUSE.B1% _ANDALSO MOUSE.OLD_B1% = 0)

    IF ANIMP.dragging THEN
        IF MOUSE.B1% THEN
            DIM pvX AS INTEGER, pvY AS INTEGER
            DOCK_native_drag DP_ANIM, MOUSE.RAW_X%, MOUSE.RAW_Y%
            pvX = ANIMP.dispX: pvY = ANIMP.dispY
            ANIMP.dispX = ANIMP.dragStartDX + (MOUSE.RAW_X% - ANIMP.dragStartMX)
            ANIMP.dispY = ANIMP.dragStartDY + (MOUSE.RAW_Y% - ANIMP.dragStartMY)
            ANIMP_clamp_to_work_area
            FPANEL_place REGION_ANIM_PANEL, ANIMP.dispX, ANIMP.dispY, ANIMP.dispW, ANIMP.dispH, pvX, pvY
            ANIMP_clamp_to_work_area
        ELSE
            IF DOCK_native_drag_end%(DP_ANIM) THEN ANIMP.dragging = FALSE: EXIT SUB
            ANIMP.dragging = FALSE
            CONFIG_save
        END IF
        CFG.ANIM_PANEL_X% = ANIMP.dispX: CFG.ANIM_PANEL_Y% = ANIMP.dispY
        SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
        EXIT SUB
    END IF

    ' a number box pressed: a drag up / down steps it, a click types it (F1)
    IF ANIMP.vRow <> 0 THEN
        vr = ANIMP.vRow
        IF MOUSE.B1% THEN
            dy = ANIMP.vY0 - MOUSE.RAW_Y% ' up = more
            IF ABS(dy) >= ANIMP_DRAG_PX THEN ANIMP.vMoved = TRUE
            IF ANIMP.vMoved THEN
                want = FIX(dy / ANIMP_DRAG_PX)
                IF want <> ANIMP.vApplied THEN
                    ANIMP_box_step vr, (want - ANIMP.vApplied) * _IIF(MODIFIERS.shift%, 10, 1)
                    ANIMP.vApplied = want
                    IF ANIMP.pendRow THEN ANIMP.vRow = 0 ' waits for RE-SLICE / RESIZE
                END IF
            END IF
        ELSE
            ANIMP.vRow = 0
            IF ANIMP.vMoved = 0 THEN ANIMP_box_type vr
            IF ANIMP.onionSave THEN ANIMP.onionSave = FALSE: CONFIG_save
        END IF
        SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
        EXIT SUB
    END IF

    ' a middle click on a row: its number back to the default
    IF MOUSE.B3% _ANDALSO MOUSE.OLD_B3% = 0 _ANDALSO lx >= 0 _ANDALSO lx < ANIMP.dispW _ANDALSO ly >= 0 _ANDALSO ly < ANIMP.dispH THEN
        vr = ANIMP_value_at%(nx, ny, TRUE)
        IF vr <> 0 _ANDALSO ANIMP_box_on%(vr) THEN
            ANIMP.pendRow = 0
            IF ANIMP_box_reset%(vr) = 0 THEN STATUS_flash ANIMP_box_label$(vr) + " has no default: click it to type a size"
            SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
        END IF
        EXIT SUB
    END IF

    ' a held stepper: repeat while the pointer stays on it
    IF ANIMP.pressCtl <> ANIMP_CTL_NONE THEN
        IF MOUSE.B1% = 0 THEN
            ANIMP.pressCtl = ANIMP_CTL_NONE
            IF ANIMP.onionSave THEN ANIMP.onionSave = FALSE: CONFIG_save
        ELSE
            t = TIMER(.001)
            IF t < ANIMP.pressT - 1 THEN ANIMP.pressT = t ' midnight
            IF t >= ANIMP.pressT _ANDALSO ANIMP_hit%(nx, ny) = ANIMP.pressCtl THEN
                ANIMP_do ANIMP.pressCtl
                ANIMP.pressT = t + .06
            END IF
        END IF
        SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
        EXIT SUB
    END IF

    IF pressed = 0 THEN EXIT SUB
    IF lx < 0 _ORELSE lx >= ANIMP.dispW _ORELSE ly < 0 _ORELSE ly >= ANIMP.dispH THEN EXIT SUB

    IF ny < FPANEL.titleH THEN
        IF FPANEL_over_close%(nx, ny, ANIMP.panelW) THEN ANIMP_toggle: CONFIG_save: EXIT SUB
        ANIMP.dragging = LAYOUT_unlocked%
        ANIMP.dragStartMX = MOUSE.RAW_X%: ANIMP.dragStartMY = MOUSE.RAW_Y%
        ANIMP.dragStartDX = ANIMP.dispX: ANIMP.dragStartDY = ANIMP.dispY
        EXIT SUB
    END IF

    vr = ANIMP_value_at%(nx, ny, FALSE)
    IF vr <> 0 THEN
        IF ANIMP_box_on%(vr) = 0 THEN EXIT SUB
        ANIMP.pendRow = 0
        ANIMP.vRow = vr: ANIMP.vY0 = MOUSE.RAW_Y%: ANIMP.vApplied = 0: ANIMP.vMoved = FALSE
        ANIMP.pressKey = ANIMP.pressKey + 1 ' the whole drag: one undo step
        SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
        EXIT SUB
    END IF

    c = ANIMP_hit%(nx, ny)
    IF c = ANIMP_CTL_NONE THEN EXIT SUB
    ANIMP.pressKey = ANIMP.pressKey + 1 ' a new press: a new undo step
    ANIMP_do c
    IF (c <= 2 * ANIMP_ROWS _ORELSE (c >= ANIMP_CTL_ON0 _ANDALSO c < ANIMP_CTL_ON0 + 2 * ANIMP_ON_ROWS)) _ANDALSO ANIMP.pendRow = 0 THEN ANIMP.pressCtl = c: ANIMP.pressT = TIMER(.001) + .4
    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' QA dump line: ANIMP visible docked x y w h scale% hold sizeMode pendRow
' (viewport px; the current frame's hold; ANIM_SIZE_*; a change waiting for it)
' ANIMPL nav row1..row6 loop rowH minusX plusX chipW pad panelW ops mode onion on1..on3
' onionBefore onionAfter onionOpacity yScale yExport exportScale (native px but the
' onion values and the scale,
' for clicking the controls: viewport = disp + native * scale% / 100)
FUNCTION ANIMP_dump$ ()
    DIM d AS STRING, r AS INTEGER, mx AS INTEGER, vx AS INTEGER, px AS INTEGER
    IF ANIMP.initialized THEN
        ANIMP_stepper_x mx, vx, px
        d = "ANIMPL" + DOCK_n$(ANIMP.yNav)
        FOR r = 1 TO ANIMP_ROWS: d = d + DOCK_n$(ANIMP_rowY(r)): NEXT r
        d = d + DOCK_n$(ANIMP.yLoop) + DOCK_n$(FPANEL.rowH) + DOCK_n$(mx) + DOCK_n$(px) + DOCK_n$(ANIMP.chipW) + DOCK_n$(FPANEL.pad) + DOCK_n$(ANIMP.panelW) + DOCK_n$(ANIMP.yOps) + DOCK_n$(ANIMP.yMode)
        d = d + DOCK_n$(ANIMP.yOnion): FOR r = 1 TO ANIMP_ON_ROWS: d = d + DOCK_n$(ANIMP_onY(r)): NEXT r
        FOR r = 1 TO ANIMP_ON_ROWS: d = d + DOCK_n$(ANIMP_onion_value%(r)): NEXT r ' onion BEFORE AFTER OPACITY
        d = d + DOCK_n$(ANIMP.yScale) + DOCK_n$(ANIMP.yExport) + DOCK_n$(CFG.ANIM_EXPORT_SCALE%) ' export (F4)
        d = d + CHR$(10)
    END IF
    ANIMP_dump$ = d + "ANIMP" + DOCK_n$(ANIMP.visible <> 0) + DOCK_n$(ANIMP.docked <> 0) + DOCK_n$(ANIMP.dispX) + DOCK_n$(ANIMP.dispY) + DOCK_n$(ANIMP.dispW) + DOCK_n$(ANIMP.dispH) + DOCK_n$(INT(ANIMP.renderScale * 100)) + DOCK_n$(ANIM_hold%(ANIM.current)) + DOCK_n$(ANIM_SIZE_MODE) + DOCK_n$(ANIMP.pendRow) + CHR$(10)
END FUNCTION
