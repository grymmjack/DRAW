''
' DRAW - GUI/WORKFLOW.BM
' =============================================================================
' Workflow buttons (see GUI/WORKFLOW.BI and PLANS/PERSONAS.md).
' =============================================================================
$INCLUDEONCE

''
' WF_ID() from CFG.WORKFLOW_BUTTONS (only when that changed: a workspace's
' [OPTIONS] or the config can change it at any time).
SUB WF_sync ()
    DIM s AS STRING, it AS STRING, p AS INTEGER, q AS INTEGER
    IF WF_PARSED_OK _ANDALSO WF_PARSED = CFG.WORKFLOW_BUTTONS$ THEN EXIT SUB
    WF_PARSED = CFG.WORKFLOW_BUTTONS$
    WF_PARSED_OK = TRUE
    WF_N = 0
    s = LCASE$(CFG.WORKFLOW_BUTTONS$)
    IF s = "none" THEN s = ""
    p = 1
    DO WHILE p <= LEN(s) _ANDALSO WF_N < WF_MAX
        q = INSTR(p, s, ",")
        IF q = 0 THEN q = LEN(s) + 1
        it = _TRIM$(MID$(s, p, q - p))
        IF LEN(it) THEN WF_N = WF_N + 1: WF_ID(WF_N) = it
        p = q + 1
    LOOP
END SUB


''
' Is the strip shown (setting on, at least one button)?
FUNCTION WF_on% ()
    WF_sync
    WF_on% = (CFG.WORKFLOW_BAR% <> 0) _ANDALSO WF_N > 0
END FUNCTION


''
' Button height (px): the toolbox's text font (Tiny5) plus a little room.
FUNCTION WF_btn_h% ()
    DIM fh AS INTEGER
    fh = 8
    IF LAYER_PANEL.fontHandle& > 0 THEN fh = _FONTHEIGHT(LAYER_PANEL.fontHandle&)
    IF fh < 6 THEN fh = 6
    WF_btn_h% = fh + 4
END FUNCTION


''
' Button columns in a w units wide panel (its 1 unit frame inside w): as many
' labelled ones (WF_LBL_W) as fit, at most one per button, the rows balanced
' (four buttons in three columns would leave one alone: two rows of two).
' One column when not even two fit - those show first letters (WF_render).
FUNCTION WF_cols% (w AS INTEGER)
    DIM c AS INTEGER, r AS INTEGER
    WF_sync
    c = (w - 2 + 1) \ (WF_LBL_W + 1)
    IF c < 2 _ORELSE WF_N < 2 THEN WF_cols% = 1: EXIT FUNCTION
    IF c > WF_N THEN c = WF_N
    r = (WF_N + c - 1) \ c
    WF_cols% = (WF_N + r - 1) \ r
END FUNCTION


''
' Height (units) of the panel w units wide: its frame and the button rows,
' 1 unit between them. 0 when it is off.
FUNCTION WF_height% (w AS INTEGER)
    DIM c AS INTEGER, r AS INTEGER
    IF WF_on% = 0 THEN EXIT FUNCTION
    c = WF_cols%(w)
    r = (WF_N + c - 1) \ c
    WF_height% = r * (WF_btn_h% + 1) + 1
END FUNCTION


''
' Narrowest the panel goes (units): one column of square first-letter buttons.
FUNCTION WF_min_w% ()
    WF_min_w% = WF_btn_h% + 2
END FUNCTION


''
' Widest it is any use (units): every button in one row at WF_LBL_MAX.
FUNCTION WF_max_w% ()
    WF_sync
    WF_max_w% = _MAX(WF_min_w%, WF_N * (WF_LBL_MAX + 1) + 1)
END FUNCTION


''
' DOCK_apply_rect: the panel's rect (its units, from the dock rect's corner).
SUB WF_place (x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    WF_X = x: WF_Y = y: WF_W = w: WF_H = h
END SUB


''
' Index in WS_LIST of button n's workspace (0 = none by that id).
FUNCTION WF_ws_index% (n AS INTEGER)
    IF n < 1 _ORELSE n > WF_N THEN EXIT FUNCTION
    IF WS_SCANNED = 0 THEN WS_scan
    WF_ws_index% = WS_find%(WF_ID(n))
END FUNCTION


''
' Button n's label: the workspace's SHORT=, else its name, upper case.
FUNCTION WF_label$ (n AS INTEGER)
    DIM k AS INTEGER, t AS STRING
    k = WF_ws_index%(n)
    IF k = 0 THEN WF_label$ = "?" + UCASE$(WF_ID(n)): EXIT FUNCTION
    t = WS_LIST(k).short
    IF LEN(t) = 0 THEN t = WS_LIST(k).title
    WF_label$ = UCASE$(t)
END FUNCTION


''
' Is button n's workspace the one in use?
FUNCTION WF_lit% (n AS INTEGER)
    DIM k AS INTEGER
    k = WF_ws_index%(n)
    IF k = 0 THEN EXIT FUNCTION
    WF_lit% = (WS_LIST(k).id = WS_ACTIVE_ID)
END FUNCTION


''
' Draw the panel into _DEST (SCRN.GUI&, or its own surface at a Scale) at
' WF_X / WF_Y: background, frame, the buttons.
SUB WF_render ()
    DIM i AS INTEGER, c AS INTEGER, bw AS INTEGER, bh AS INTEGER, x AS INTEGER, y AS INTEGER
    DIM t AS STRING, tw AS INTEGER, th AS INTEGER, oldFont AS LONG, fg AS _UNSIGNED LONG
    FOR i = 1 TO WF_MAX: WF_BW(i) = 0: NEXT i
    IF WF_W <= 0 _ORELSE WF_H <= 0 _ORELSE WF_on% = 0 THEN EXIT SUB
    LINE (WF_X, WF_Y)-(WF_X + WF_W - 1, WF_Y + WF_H - 1), THEME.TOOLBAR_bg~&, BF
    LINE (WF_X, WF_Y)-(WF_X + WF_W - 1, WF_Y + WF_H - 1), THEME.TOOLBAR_border_fg~&, B
    REGION_set_bounds REGION_WORKFLOW, WF_X, WF_Y, WF_W, WF_H, ZORDER_PANEL ' (its footprint at a Scale: PSURF_render)
    c = WF_cols%(WF_W)
    bh = WF_btn_h%
    bw = (WF_W - 2 - (c - 1)) \ c
    IF bw < 1 THEN EXIT SUB
    oldFont& = _FONT
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle&
    _PRINTMODE _KEEPBACKGROUND
    th = _UFONTHEIGHT
    FOR i = 1 TO WF_N
        x = WF_X + 1 + ((i - 1) MOD c) * (bw + 1)
        y = WF_Y + 1 + ((i - 1) \ c) * (bh + 1)
        WF_BX(i) = x: WF_BY(i) = y: WF_BW(i) = bw: WF_BH(i) = bh
        LINE (x, y)-(x + bw - 1, y + bh - 1), THEME.EDIT_BAR_BG_COLOR~&, BF
        fg = _RGB32(202, 202, 202)
        IF WF_ws_index%(i) = 0 THEN fg = _RGB32(110, 110, 110)
        IF WF_lit%(i) THEN
            LINE (x, y)-(x + bw - 1, y + bh - 1), THEME.TOOLBAR_btn_overlay~&, BF
            LINE (x, y)-(x + bw - 1, y + bh - 1), THEME.TOOLBAR_btn_stroke~&, B
            fg = _RGB32(255, 255, 255)
        ELSEIF i = WF_HOVER THEN
            LINE (x, y)-(x + bw - 1, y + bh - 1), THEME.EDIT_BAR_ICON_MOUSE_OUTLINE_COLOR~&, B
        END IF
        t = WF_shown_label$(i, c)
        DO WHILE LEN(t) > 1 _ANDALSO _UPRINTWIDTH(t) > bw - 4
            t = LEFT$(t, LEN(t) - 1)
        LOOP
        tw = _UPRINTWIDTH(t)
        COLOR fg, _RGBA32(0, 0, 0, 0)
        _UPRINTSTRING (x + (bw - tw + 1) \ 2, y + (bh - th + 1) \ 2), t
    NEXT i
    _FONT oldFont&
END SUB


''
' What button n shows with c columns: its label, or in one column only the
' workspace's first letter (Rick, 2026-11-14).
FUNCTION WF_shown_label$ (n AS INTEGER, c AS INTEGER)
    DIM t AS STRING
    t = WF_label$(n)
    IF c = 1 THEN
        IF LEFT$(t, 1) = "?" _ANDALSO LEN(t) > 1 THEN t = MID$(t, 2) ' (an unknown id: its letter, greyed)
        t = LEFT$(t, 1)
    END IF
    WF_shown_label$ = t
END FUNCTION


''
' The button at (mx, my) - the panel's units - as last drawn, 0 = none.
FUNCTION WF_hit% (mx AS INTEGER, my AS INTEGER)
    DIM i AS INTEGER
    FOR i = 1 TO WF_N
        IF WF_BW(i) > 0 THEN
            IF mx >= WF_BX(i) _ANDALSO mx < WF_BX(i) + WF_BW(i) _ANDALSO my >= WF_BY(i) _ANDALSO my < WF_BY(i) + WF_BH(i) THEN WF_hit% = i: EXIT FUNCTION
        END IF
    NEXT i
END FUNCTION


''
' Is viewport (mouseX, mouseY) on the panel (its frame and gaps too)? Every
' click / hover / pan gate asks here, as for the organizer.
FUNCTION WF_is_over_area% (mouseX AS INTEGER, mouseY AS INTEGER)
    IF WF_W <= 0 _ORELSE WF_H <= 0 _ORELSE WF_on% = 0 _ORELSE SCRN.showToolbar% = 0 THEN EXIT FUNCTION
    IF DOCK_live%(DP_WORKFLOW) = 0 THEN EXIT FUNCTION ' collapsed, an inactive tab, or hidden by a small window
    IF WZ_blocked%(DP_WORKFLOW, mouseX, mouseY) THEN EXIT FUNCTION ' a window in front covers it here (GUI/WINZ)
    IF PSURF_on%(DP_WORKFLOW) THEN WF_is_over_area% = PSURF_in%(DP_WORKFLOW, mouseX, mouseY): EXIT FUNCTION ' its footprint
    WF_is_over_area% = (mouseX >= WF_X _ANDALSO mouseX < WF_X + WF_W _ANDALSO mouseY >= WF_Y _ANDALSO mouseY < WF_Y + WF_H)
END FUNCTION


''
' Hover (viewport px, no button held): redraw when the button under it changes.
SUB WF_track (inX AS INTEGER, inY AS INTEGER)
    DIM h AS INTEGER
    IF WF_is_over_area%(inX, inY) THEN h = WF_hit%(PSURF_mx%(DP_WORKFLOW, inX), PSURF_my%(DP_WORKFLOW, inY))
    IF h <> WF_HOVER THEN WF_HOVER = h: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' A press (viewport px): TRUE when it was on the panel (taken).
FUNCTION WF_click% (inX AS INTEGER, inY AS INTEGER)
    DIM n AS INTEGER
    IF WF_is_over_area%(inX, inY) = 0 THEN EXIT FUNCTION
    WF_click% = TRUE
    n = WF_hit%(PSURF_mx%(DP_WORKFLOW, inX), PSURF_my%(DP_WORKFLOW, inY))
    IF n THEN WF_press n
END FUNCTION


''
' Button n: switch to its workspace, or back to Default when it is the one in use.
SUB WF_press (n AS INTEGER)
    DIM k AS INTEGER
    IF n < 1 _ORELSE n > WF_N THEN EXIT SUB
    k = WF_ws_index%(n)
    IF k = 0 THEN
        STATUS_flash "No workspace '" + WF_ID(n) + "' - right-click the button to pick one"
        EXIT SUB
    END IF
    IF WS_LIST(k).id = WS_ACTIVE_ID _ANDALSO WS_is_default%(WS_LIST(k).id) = 0 THEN
        WS_action WS_ACT_LEAVE
    ELSE
        WS_action WS_ACT_SLOT0 + k
    END IF
    GUI_NEEDS_REDRAW% = TRUE
END SUB


''
' A right-click (viewport px): TRUE when it was on the panel. On a button its
' menu; between them the panel's handle menu.
FUNCTION WF_right_click% (inX AS INTEGER, inY AS INTEGER)
    DIM mx AS INTEGER, my AS INTEGER
    mx = inX: my = inY ' (by reference: DOCK_menu_open may relayout)
    IF WF_is_over_area%(mx, my) = 0 THEN EXIT FUNCTION
    WF_right_click% = TRUE
    WF_MENU_NEXT = WF_hit%(PSURF_mx%(DP_WORKFLOW, mx), PSURF_my%(DP_WORKFLOW, my))
    DOCK_menu_open DP_WORKFLOW, mx, my
END FUNCTION


''
' The handle menu's rows in workflow mode (DOCK_menu_build): button n's
' workspace, then add / move / remove / hide, then Float / Dock Back and the
' panel's Scale.
SUB WF_menu_build (n AS INTEGER)
    DIM r AS INTEGER, k AS INTEGER, f AS INTEGER
    POPUP_MENU_clear_items
    POPUP_MENU_set_item r, "Workflow Button" + STR$(n) + ": switch to", "", -1, POPUP_MENU_FLAG_DISABLED: r = r + 1
    POPUP_MENU_set_item r, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: r = r + 1
    IF WS_SCANNED = 0 THEN WS_scan
    FOR k = 1 TO WS_COUNT
        IF r >= POPUP_MENU_MAX_ITEMS - 8 THEN EXIT FOR
        f = 0
        IF n >= 1 _ANDALSO n <= WF_N THEN IF WS_LIST(k).id = WF_ID(n) THEN f = POPUP_MENU_FLAG_CHECKED
        POPUP_MENU_set_item r, WS_LIST(k).title, "", WF_MV_WS + k, f: r = r + 1
    NEXT k
    POPUP_MENU_set_item r, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: r = r + 1
    IF n > 1 THEN POPUP_MENU_set_item r, "Move Left", "", WF_MV_LEFT, 0: r = r + 1
    IF n < WF_N THEN POPUP_MENU_set_item r, "Move Right", "", WF_MV_RIGHT, 0: r = r + 1
    IF WF_N < WF_MAX THEN POPUP_MENU_set_item r, "Add a Button", "", WF_MV_ADD, 0: r = r + 1
    POPUP_MENU_set_item r, "Remove This Button", "", WF_MV_REMOVE, 0: r = r + 1
    POPUP_MENU_set_item r, "Hide Workflow Buttons", "", WF_MV_HIDE, 0: r = r + 1
    ' the panel's own rows (DOCK_menu_do takes them)
    POPUP_MENU_set_item r, "---", "", -1, POPUP_MENU_FLAG_DIVIDER: r = r + 1
    IF DOCK_floating%(DP_WORKFLOW) THEN
        POPUP_MENU_set_item r, "Dock Back", "", DOCK_ACT_DOCKBACK, 0: r = r + 1
    ELSE
        POPUP_MENU_set_item r, "Float", "", DOCK_ACT_FLOAT, 0: r = r + 1
    END IF
    DOCK_menu_add_scale DP_WORKFLOW, r
    DOCK_UI.menuN = r
END SUB


''
' A row of that menu was clicked (DOCK_menu_do).
SUB WF_menu_do (n AS INTEGER, v AS INTEGER)
    DIM i AS INTEGER, k AS INTEGER, t AS STRING, used AS INTEGER
    IF n < 1 _ORELSE n > WF_N THEN EXIT SUB
    SELECT CASE v
        CASE WF_MV_WS + 1 TO WF_MV_WS + WS_MAX
            k = v - WF_MV_WS
            IF k > WS_COUNT THEN EXIT SUB
            WF_ID(n) = WS_LIST(k).id
            WF_save_list "Workflow button" + STR$(n) + ": " + WS_LIST(k).title
        CASE WF_MV_LEFT, WF_MV_RIGHT
            i = n + _IIF(v = WF_MV_LEFT, -1, 1)
            IF i < 1 _ORELSE i > WF_N THEN EXIT SUB
            t = WF_ID(i): WF_ID(i) = WF_ID(n): WF_ID(n) = t
            WF_save_list "Workflow button moved"
        CASE WF_MV_ADD
            IF WF_N >= WF_MAX THEN EXIT SUB
            ' the first named workspace not on a button yet (else Default)
            t = WS_DEFAULT_ID$
            FOR k = 1 TO WS_COUNT
                used = FALSE
                FOR i = 1 TO WF_N
                    IF WF_ID(i) = WS_LIST(k).id THEN used = TRUE: EXIT FOR
                NEXT i
                IF used = 0 _ANDALSO WS_LIST(k).id <> WS_CURRENT_ID$ _ANDALSO WS_is_default%(WS_LIST(k).id) = 0 THEN t = WS_LIST(k).id: EXIT FOR
            NEXT k
            FOR i = WF_N TO n + 1 STEP -1
                WF_ID(i + 1) = WF_ID(i)
            NEXT i
            WF_ID(n + 1) = t
            WF_N = WF_N + 1
            WF_save_list "Workflow button added (right-click it to pick its workspace)"
        CASE WF_MV_REMOVE
            FOR i = n TO WF_N - 1
                WF_ID(i) = WF_ID(i + 1)
            NEXT i
            WF_N = WF_N - 1
            WF_save_list _IIF(WF_N, "Workflow button removed", "No workflow buttons left (View > Workflow Buttons brings the default ones back)")
        CASE WF_MV_HIDE
            WF_action WF_ACT_TOGGLE
    END SELECT
END SUB


''
' WF_ID() -> CFG.WORKFLOW_BUTTONS, saved; the strip relayouts.
SUB WF_save_list (msg AS STRING)
    DIM i AS INTEGER, s AS STRING
    FOR i = 1 TO WF_N
        IF i > 1 THEN s = s + ","
        s = s + WF_ID(i)
    NEXT i
    CFG.WORKFLOW_BUTTONS$ = s
    WF_PARSED_OK = FALSE
    WF_sync
    CONFIG_save
    IF LEN(msg) THEN STATUS_flash msg
    WF_HOVER = 0
    DOCK_redraw
END SUB


''
' Actions 2660-2668.
SUB WF_action (act AS INTEGER)
    SELECT CASE act
        CASE WF_ACT_TOGGLE
            CFG.WORKFLOW_BAR% = (CFG.WORKFLOW_BAR% = 0)
            IF CFG.WORKFLOW_BAR% _ANDALSO LEN(_TRIM$(CFG.WORKFLOW_BUTTONS$)) = 0 THEN CFG.WORKFLOW_BUTTONS$ = "sprite,animate,scene,annotate"
            WF_sync
            CONFIG_save
            STATUS_flash _IIF(CFG.WORKFLOW_BAR%, "Workflow buttons on", "Workflow buttons off (View > Workflow Buttons)")
            WF_HOVER = 0
            DOCK_redraw
        CASE WF_ACT_BTN0 + 1 TO WF_ACT_BTN0 + WF_MAX
            WF_sync
            IF act - WF_ACT_BTN0 > WF_N THEN STATUS_flash "No workflow button" + STR$(act - WF_ACT_BTN0): EXIT SUB
            WF_press act - WF_ACT_BTN0
    END SELECT
END SUB


''
' QA dump (viewport px): WF on n x y w h active cols laidOut |
' WFB i x y w h lit id label shown (shown = what the button says: the label,
' cut to fit, or its first letter in one column)
FUNCTION WF_dump$ ()
    DIM d AS STRING, i AS INTEGER, lf AS STRING
    DIM x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER
    lf = CHR$(10)
    x = WF_X: y = WF_Y: w = WF_W: h = WF_H
    PSURF_rect_to_view DP_WORKFLOW, x, y, w, h
    d = "WF" + DOCK_n$(WF_on%) + DOCK_n$(WF_N) + DOCK_n$(x) + DOCK_n$(y) + DOCK_n$(w) + DOCK_n$(h) + " " + WS_ACTIVE_ID + DOCK_n$(WF_cols%(WF_W)) + DOCK_n$(DOCK_live%(DP_WORKFLOW) <> 0 _ANDALSO WF_W > 0) + lf
    FOR i = 1 TO WF_N
        bx = WF_BX(i): by = WF_BY(i): bw = WF_BW(i): bh = WF_BH(i)
        PSURF_rect_to_view DP_WORKFLOW, bx, by, bw, bh
        d = d + "WFB" + DOCK_n$(i) + DOCK_n$(bx) + DOCK_n$(by) + DOCK_n$(bw) + DOCK_n$(bh) + DOCK_n$(WF_lit%(i) <> 0) + " " + WF_ID(i) + " " + WF_label$(i) + " " + WF_shown_label$(i, WF_cols%(WF_W)) + lf
    NEXT i
    WF_dump$ = d
END FUNCTION
