''
' DRAW - GUI/PANEL-SLIDER.BM - a labelled slider row (GUI/PANEL-SLIDER.BI).
' =============================================================================
' Geometry: a slider at (x, y) w wide; lw = the label column, vw = the value column.
' Two-line (stacked) when w < lw + vw + PSL_MIN_TRACK: label and value on the first
' row, the track the whole width on the second.
$INCLUDEONCE

FUNCTION PSL_row_h% ()
    DIM h AS INTEGER
    h = THEME.BAR_row_height%
    IF h < 10 THEN h = 14
    PSL_row_h% = h
END FUNCTION


FUNCTION PSL_tw% (t AS STRING)
    IF MENU_BAR.fontHandle& > 0 THEN
        PSL_tw% = _UPRINTWIDTH(t, 0, MENU_BAR.fontHandle&)
    ELSE
        PSL_tw% = LEN(t) * 8
    END IF
END FUNCTION


''
' Is a slider w wide drawn on two rows (label + value, then the track)?
FUNCTION PSL_stacked% (w AS INTEGER, lw AS INTEGER, vw AS INTEGER)
    PSL_stacked% = (w < lw + vw + 40)
END FUNCTION


''
' Its height: one row, or two when stacked.
FUNCTION PSL_h% (w AS INTEGER, lw AS INTEGER, vw AS INTEGER)
    IF PSL_stacked%(w, lw, vw) THEN PSL_h% = 2 * PSL_row_h% ELSE PSL_h% = PSL_row_h%
END FUNCTION


''
' The track's rect (tx, ty, tw, th) for a slider at (x, y) w wide.
SUB PSL_track (x AS INTEGER, y AS INTEGER, w AS INTEGER, lw AS INTEGER, vw AS INTEGER, tx AS INTEGER, ty AS INTEGER, tw AS INTEGER, th AS INTEGER)
    DIM rowH AS INTEGER
    rowH = PSL_row_h%
    IF PSL_stacked%(w, lw, vw) THEN
        tx = x + 2: tw = w - 4: ty = y + rowH + 2
    ELSE
        tx = x + lw: tw = w - lw - vw: ty = y + 3
    END IF
    IF tw < 8 THEN tw = 8
    th = rowH - 7
END SUB


''
' Draw it: label, track filled to v (lo..hi), the value text vt. hot = outlined
' (under the pointer / held).
SUB PSL_draw (x AS INTEGER, y AS INTEGER, w AS INTEGER, lw AS INTEGER, vw AS INTEGER, label AS STRING, v AS LONG, lo AS LONG, hi AS LONG, vt AS STRING, hot AS INTEGER)
    DIM tx AS INTEGER, ty AS INTEGER, tw AS INTEGER, th AS INTEGER, rowH AS INTEGER, fy AS INTEGER, fw AS LONG
    DIM t AS STRING, vx AS INTEGER
    rowH = PSL_row_h%
    fy = y + (rowH - _UFONTHEIGHT) \ 2
    PSL_track x, y, w, lw, vw, tx, ty, tw, th
    IF THEMEED.started THEN THEMEED_seen _DEST, "", "", "SLIDER " + UCASE$(label), x, y, w, rowH, "@PSL_draw" ' Theme Edit (CFG/THEME-EDIT)
    COLOR THEME.BAR_label_fg~&, _RGBA32(0, 0, 0, 0)
    t = label
    IF PSL_stacked%(w, lw, vw) THEN
        DO WHILE LEN(t) > 1 _ANDALSO PSL_tw%(t) > w - vw - 4
            t = LEFT$(t, LEN(t) - 1)
        LOOP
        _UPRINTSTRING (x + 2, fy), t
        vx = x + w - 2 - PSL_tw%(vt)
    ELSE
        DO WHILE LEN(t) > 1 _ANDALSO PSL_tw%(t) > lw - 4
            t = LEFT$(t, LEN(t) - 1)
        LOOP
        _UPRINTSTRING (x + 2, fy), t
        vx = tx + tw + 3
    END IF
    LINE (tx, ty)-(tx + tw - 1, ty + th - 1), THEME.BAR_slider_bg~&, BF
    IF hi > lo THEN
        fw = ((_MIN(_MAX(v, lo), hi) - lo) * (tw - 2) + (hi - lo) \ 2) \ (hi - lo)
        IF fw > 0 THEN LINE (tx + 1, ty + 1)-(tx + fw, ty + th - 2), THEME.BAR_slider_fill~&, BF
    END IF
    IF hot THEN
        LINE (tx, ty)-(tx + tw - 1, ty + th - 1), THEME.BAR_slider_hover_border~&, B
    ELSE
        LINE (tx, ty)-(tx + tw - 1, ty + th - 1), THEME.BAR_slider_border~&, B
    END IF
    COLOR THEME.BAR_value_fg~&, _RGBA32(0, 0, 0, 0)
    _UPRINTSTRING (vx, fy), vt
END SUB


''
' The part of the slider at (mx, my): PSL_PART_LABEL / TRACK / VALUE, 0 = off it.
' The track takes 2 px either side (an easy grab); stacked, the first row's right
' half is the value.
FUNCTION PSL_part% (mx AS INTEGER, my AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, lw AS INTEGER, vw AS INTEGER)
    DIM tx AS INTEGER, ty AS INTEGER, tw AS INTEGER, th AS INTEGER, rowH AS INTEGER
    IF mx < x _ORELSE mx >= x + w _ORELSE my < y _ORELSE my >= y + PSL_h%(w, lw, vw) THEN EXIT FUNCTION
    rowH = PSL_row_h%
    PSL_track x, y, w, lw, vw, tx, ty, tw, th
    IF PSL_stacked%(w, lw, vw) THEN
        IF my >= y + rowH THEN PSL_part% = PSL_PART_TRACK: EXIT FUNCTION
        IF mx >= x + w - vw - 2 THEN PSL_part% = PSL_PART_VALUE ELSE PSL_part% = PSL_PART_LABEL
        EXIT FUNCTION
    END IF
    IF mx >= tx - 2 _ANDALSO mx < tx + tw + 2 THEN
        PSL_part% = PSL_PART_TRACK
    ELSEIF mx >= tx + tw + 2 THEN
        PSL_part% = PSL_PART_VALUE
    ELSE
        PSL_part% = PSL_PART_LABEL
    END IF
END FUNCTION


''
' The value (lo..hi) the pointer's x gives on the track.
FUNCTION PSL_value& (mx AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, lw AS INTEGER, vw AS INTEGER, lo AS LONG, hi AS LONG)
    DIM tx AS INTEGER, ty AS INTEGER, tw AS INTEGER, th AS INTEGER, f AS SINGLE
    PSL_track x, y, w, lw, vw, tx, ty, tw, th
    f = (mx - tx) / _MAX(1, tw - 1)
    IF f < 0 THEN f = 0
    IF f > 1 THEN f = 1
    PSL_value& = lo + CLNG(f * (hi - lo))
END FUNCTION
