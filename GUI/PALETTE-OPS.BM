''
' DRAW - GUI/PALETTE-OPS.BM
' =============================================================================
' Palette Ops mode implementation.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE


''
' Initialize palette ops state.
'
SUB PALETTE_OPS_init ()
    PALETTE_OPS.ACTIVE%           = FALSE
    PALETTE_OPS.DRAG_ACTIVE%      = FALSE
    PALETTE_OPS.DRAG_SRC_IDX%     = -1
    PALETTE_OPS.DRAG_DST_IDX%     = -1
    PALETTE_OPS.WAND_PENDING_IDX% = -1
    PALETTE_OPS.WAND_SHOWING%     = FALSE
    PALETTE_OPS.DBLCLICK_TIME#    = 0
    PALETTE_OPS.DBLCLICK_IDX%     = -1
    PALETTE_OPS_clear_transient
    DIM poi AS INTEGER
    FOR poi% = 0 TO 255
        PALETTE_OPS_MARKED(poi%) = FALSE
    NEXT poi%
END SUB


''
' Clear the selected chip + in-flight drags (no undo record: callers commit
' a live edit first with PALETTE_OPS_edit_commit when it should be kept).
'
SUB PALETTE_OPS_clear_transient ()
    PALETTE_OPS.SEL_IDX%     = -1
    PALETTE_OPS.MARK_DRAG%   = FALSE
    PALETTE_OPS.DEL_DRAG%    = FALSE
    PALETTE_OPS.DEL_START%   = -1
    PALETTE_OPS.DEL_END%     = -1
    PALETTE_OPS.DRAG_START_X% = 0
    PALETTE_OPS.DRAG_START_Y% = 0
    PALETTE_OPS.TOGGLE_PENDING% = FALSE
END SUB


''
' Activate palette ops mode.
' Auto-remaps canvas to current palette (no dialog).
'
SUB PALETTE_OPS_activate ()
    IF PALETTE_OPS.ACTIVE% THEN EXIT SUB

    PALETTE_OPS.ACTIVE%           = TRUE
    PALETTE_OPS.DRAG_ACTIVE%      = FALSE
    PALETTE_OPS.WAND_PENDING_IDX% = -1
    PALETTE_OPS.WAND_SHOWING%     = FALSE
    PALETTE_OPS.DBLCLICK_TIME#    = 0
    PALETTE_OPS.DBLCLICK_IDX%     = -1
    PALETTE_OPS_clear_transient
    DIM poi2 AS INTEGER
    FOR poi2% = 0 TO 255
        PALETTE_OPS_MARKED(poi2%) = FALSE
    NEXT poi2%

    ' Auto-remap canvas to current palette (no dither, no dialog)
    PALETTE_LOADER_remap_to_palette

    SOUND_play SND_ORGANIZER
    GUI_NEEDS_REDRAW% = TRUE
    SCENE_DIRTY%      = TRUE
    FRAME_IDLE%       = FALSE
    _LOGINFO "PALETTE_OPS: Activated (auto-remapped to palette)"
END SUB


''
' Deactivate palette ops mode. Clears all state.
'
SUB PALETTE_OPS_deactivate ()
    IF NOT PALETTE_OPS.ACTIVE% THEN EXIT SUB

    ' Keep a live chip edit that is still open (one undo step), then drop the
    ' selection and any in-flight drag.
    PALETTE_OPS_edit_commit
    PALETTE_OPS_clear_transient

    ' Clear wand selection if showing
    IF PALETTE_OPS.WAND_SHOWING% THEN
        MAGIC_WAND_reset
        MARQUEE.ACTIVE%           = FALSE
        PALETTE_OPS.WAND_SHOWING% = FALSE
    END IF

    PALETTE_OPS.ACTIVE%           = FALSE
    PALETTE_OPS.DRAG_ACTIVE%      = FALSE
    PALETTE_OPS.DRAG_SRC_IDX%     = -1
    PALETTE_OPS.WAND_PENDING_IDX% = -1
    DIM poi3 AS INTEGER
    FOR poi3% = 0 TO 255
        PALETTE_OPS_MARKED(poi3%) = FALSE
    NEXT poi3%

    GUI_NEEDS_REDRAW% = TRUE
    FRAME_IDLE%       = FALSE
    _LOGINFO "PALETTE_OPS: Deactivated"
END SUB


''
' Toggle palette ops mode on/off.
'
SUB PALETTE_OPS_toggle ()
    IF PALETTE_OPS.ACTIVE% THEN
        PALETTE_OPS_deactivate
    ELSE
        PALETTE_OPS_activate
    END IF
END SUB


''
' Reset palette ops (alias for deactivate, used by DRW_load_binary).
'
SUB PALETTE_OPS_reset ()
    PALETTE_OPS_edit_discard ' document is being replaced: its layers are gone
    PALETTE_OPS_clear_transient
    PALETTE_OPS.ACTIVE%           = FALSE
    PALETTE_OPS.DRAG_ACTIVE%      = FALSE
    PALETTE_OPS.DRAG_SRC_IDX%     = -1
    PALETTE_OPS.WAND_PENDING_IDX% = -1
    PALETTE_OPS.WAND_SHOWING%     = FALSE
    DIM poi4 AS INTEGER
    FOR poi4% = 0 TO 255
        PALETTE_OPS_MARKED(poi4%) = FALSE
    NEXT poi4%
    ' Document palette state is reset by DRW_load_binary after it
    ' restores PALETTE_DOC_EXISTS% from the loaded file
    PALETTE_DOC_EXISTS% = FALSE
    PALETTE_DOC_COUNT%  = 0
END SUB


''
' Mark current palette as [DOCUMENT] and snapshot colors for switching back.
' Called automatically when palette ops modifies colors.
'
SUB PALETTE_OPS_mark_document_palette ()
    PALETTE_EMBEDDED_ACTIVE% = TRUE
    PALETTE_EMBEDDED_NAME$   = "[DOCUMENT]"
    PALETTE_DOC_EXISTS%      = TRUE

    ' Snapshot current PAL() into document palette backup
    PALETTE_DOC_COUNT% = PAL_COLOR_COUNT%
    DIM mdpi AS INTEGER
    FOR mdpi% = 0 TO PAL_COLOR_COUNT% - 1
        PALETTE_DOC_COLORS(mdpi%) = PAL(mdpi%).value~&
    NEXT mdpi%
    _LOGINFO "PALETTE_OPS: Marked as [DOCUMENT] palette (" + _TRIM$(STR$(PAL_COLOR_COUNT%)) + " colors)"
END SUB


''
' Per-frame tick for palette ops (call from main loop or mouse handler).
' Handles delayed wand selection after 500ms.
'
SUB PALETTE_OPS_tick ()
    IF NOT PALETTE_OPS.ACTIVE% THEN EXIT SUB

    ' Selected chip follows FG: any FG change (color panels, picker, hex...)
    ' edits the chip and its pixels live; mouse up commits one undo step.
    IF PALETTE_OPS.SEL_IDX% >= PAL_COLOR_COUNT% THEN PALETTE_OPS_deselect
    IF PALETTE_OPS.SEL_IDX% >= 0 _ANDALSO NOT PAL_FG_IS_TRANSPARENT% THEN
        DIM selCur AS _UNSIGNED LONG : selCur~& = PAINT_COLOR~& OR &HFF000000~&
        IF (selCur~& AND &HFFFFFF) <> (PALETTE_OPS.SEL_LAST~& AND &HFFFFFF) THEN
            IF NOT PALETTE_OPS.EDIT_ACTIVE% _ANDALSO (PAL(PALETTE_OPS.SEL_IDX%).value~& AND &HFFFFFF) <> (PALETTE_OPS.SEL_LAST~& AND &HFFFFFF) THEN
                ' The chip changed underneath us (undo / redo / color dialog):
                ' that FG change is not an edit — just resync.
                PALETTE_OPS.SEL_LAST~& = selCur~&
            ELSE
                PALETTE_OPS_edit_apply selCur~&
            END IF
        END IF
    END IF
    IF PALETTE_OPS.EDIT_ACTIVE% _ANDALSO NOT MOUSE.B1% _ANDALSO NOT MOUSE.B2% _ANDALSO NOT MOUSE.B3% THEN
        PALETTE_OPS_edit_commit
    END IF

    ' Handle delayed wand selection
    IF PALETTE_OPS.WAND_PENDING_IDX% >= 0 THEN
        IF TIMER - PALETTE_OPS.WAND_TIMER# >= 0.5 THEN
            DIM wandColor AS _UNSIGNED LONG
            DIM wandIdx   AS INTEGER
            wandIdx%                      = PALETTE_OPS.WAND_PENDING_IDX%
            PALETTE_OPS.WAND_PENDING_IDX% = -1

            wandColor~& = PAL(wandIdx%).value~&

            ' Find first pixel of this color on current layer
            DIM wandImg AS LONG
            wandImg& = LAYER_current_image&
            IF wandImg& < -1 THEN
                DIM wandW      AS INTEGER, wandH AS INTEGER
                wandW% = _WIDTH(wandImg&)
                wandH% = _HEIGHT(wandImg&)
                DIM wandMem    AS _MEM
                wandMem = _MEMIMAGE(wandImg&)
                DIM wandFoundX AS INTEGER, wandFoundY AS INTEGER
                DIM wandFound  AS INTEGER
                wandFoundX% = 0
                wandFoundY% = 0
                wandFound%  = FALSE

                DIM wandPx  AS LONG, wandPy AS LONG
                DIM wandOff AS _OFFSET
                DIM wandPix AS _UNSIGNED LONG
                FOR wandPy& = 0 TO wandH% - 1
                    FOR wandPx& = 0 TO wandW% - 1
                        wandOff = wandMem.OFFSET + (wandPy& * wandW% + wandPx&) * 4
                        _MEMGET wandMem, wandOff, wandPix~&
                        IF _ALPHA32(wandPix~&) > 0 THEN
                            ' Compare RGB (ignore alpha differences)
                            IF _RED32(wandPix~&) = _RED32(wandColor~&) AND _
                               _GREEN32(wandPix~&) = _GREEN32(wandColor~&) AND _
                               _BLUE32(wandPix~&)  = _BLUE32(wandColor~&) THEN
                                wandFoundX%        = wandPx&
                                wandFoundY%        = wandPy&
                                wandFound%         = TRUE
                                EXIT FOR
                            END IF
                        END IF
                    NEXT wandPx&
                    IF wandFound% THEN EXIT FOR
                NEXT wandPy&
                _MEMFREE wandMem

                IF wandFound% THEN
                    ' Select all matching pixels using magic wand
                    MAGIC_WAND_select_all_color_merged wandFoundX%, wandFoundY%, SEL_MODE_REPLACE
                    PALETTE_OPS.WAND_SHOWING% = TRUE
                    MARQUEE.MAGIC_WAND_MODE   = TRUE
                    SOUND_play SND_SELECTION
                    GUI_NEEDS_REDRAW% = TRUE
                    FRAME_IDLE%       = FALSE
                    _LOGINFO "PALETTE_OPS: Wand selected color idx " + STR$(wandIdx%)
                ELSE
                    _LOGINFO "PALETTE_OPS: No pixels of color idx " + STR$(wandIdx%) + " found on current layer"
                END IF
            END IF
        ELSE
            ' Keep frame active while waiting for delay
            FRAME_IDLE% = FALSE
        END IF
    END IF
END SUB


''
' Calculate which palette index is at screen position (x, y) on the strip.
' Returns -1 if position is not over a swatch.
' Must match the layout math in PALETTE_STRIP_render / PALETTE_STRIP_handle_click.
'
FUNCTION PALETTE_OPS_calc_strip_index% (x AS INTEGER, y AS INTEGER)
    PALETTE_OPS_calc_strip_index% = -1
    IF NOT PALETTE_STRIP_VISIBLE% THEN EXIT FUNCTION

    DIM pal_count AS INTEGER
    pal_count% = PALETTE_LOADER_get_color_count%
    IF pal_count% = 0 THEN EXIT FUNCTION

    DIM sw         AS INTEGER, sh AS INTEGER
    sw% = CFG.PALETTE_CHIP_WIDTH%
    sh% = CFG.PALETTE_CHIP_HEIGHT%
    DIM row_height AS INTEGER
    row_height% = sh% + 1

    DIM name_width AS INTEGER
    name_width% = PALETTE_STRIP_name_w%

    DIM available_width  AS INTEGER
    available_width% = SCRN.w& - (PALETTE_STRIP_ARROW_WIDTH * 2) - name_width% - 12
    DIM swatches_per_row AS INTEGER
    swatches_per_row% = available_width% \ (sw% + 1)
    IF swatches_per_row% > CFG.PALETTE_MAX_CHIPS_PER_ROW% THEN
        swatches_per_row% = CFG.PALETTE_MAX_CHIPS_PER_ROW%
    END IF
    IF swatches_per_row% < 1 THEN EXIT FUNCTION

    DIM num_rows AS INTEGER
    num_rows% = ((pal_count% - 1) \ swatches_per_row%) + 1
    IF num_rows% < CFG.PALETTE_MIN_ROWS% THEN num_rows% = CFG.PALETTE_MIN_ROWS%
    IF num_rows% > CFG.PALETTE_MAX_ROWS% THEN num_rows% = CFG.PALETTE_MAX_ROWS%

    DIM max_swatches   AS INTEGER
    max_swatches% = swatches_per_row% * num_rows%
    IF max_swatches% > pal_count% THEN max_swatches% = pal_count%
    DIM visible_colors AS INTEGER
    visible_colors% = max_swatches%

    DIM arrow_left_x     AS INTEGER
    arrow_left_x% = 2
    DIM swatches_start_x AS INTEGER
    swatches_start_x% = arrow_left_x% + PALETTE_STRIP_ARROW_WIDTH + 2

    DIM swatch_area_width AS INTEGER
    swatch_area_width% = swatches_per_row% * (sw% + 1)

    ' Check if within swatch grid area
    IF x% < swatches_start_x% OR x% >= swatches_start_x% + swatch_area_width% THEN EXIT FUNCTION

    DIM rel_y     AS INTEGER
    rel_y% = y% - PALETTE_STRIP_Y% - 2
    DIM click_row AS INTEGER
    click_row% = rel_y% \ row_height%
    IF click_row% < 0 THEN click_row% = 0
    IF click_row% >= num_rows% THEN click_row% = num_rows% - 1

    DIM click_col AS INTEGER
    click_col% = (x% - swatches_start_x%) \ (sw% + 1)

    DIM clicked_idx AS INTEGER
    clicked_idx% = (click_row% * swatches_per_row%) + click_col%

    DIM pal_idx AS INTEGER
    pal_idx% = (PALETTE_STRIP_SCROLL_OFFSET% + clicked_idx%) MOD pal_count%

    IF pal_idx% >= 0 AND pal_idx% < pal_count% AND clicked_idx% < visible_colors% THEN
        PALETTE_OPS_calc_strip_index% = pal_idx%
    END IF
END FUNCTION


''
' Handle click on palette strip while palette ops mode is active.
' Dispatches to appropriate action based on button state.
'
SUB PALETTE_OPS_handle_strip_click (x AS INTEGER, y AS INTEGER)
    IF NOT PALETTE_OPS.ACTIVE% THEN EXIT SUB

    ' Let arrow buttons and palette name dropdown work normally
    DIM arrow_left_x      AS INTEGER, arrow_right_x AS INTEGER
    DIM swatches_end_x    AS INTEGER, pal_name_x AS INTEGER
    DIM name_width        AS INTEGER, sw2 AS INTEGER
    name_width%   = PALETTE_STRIP_name_w%
    sw2%          = CFG.PALETTE_CHIP_WIDTH%
    arrow_left_x% = 2
    DIM available_w2      AS INTEGER
    available_w2% = SCRN.w& - (PALETTE_STRIP_ARROW_WIDTH * 2) - name_width% - 12
    DIM spr2              AS INTEGER
    spr2% = available_w2% \ (sw2% + 1)
    IF spr2% > CFG.PALETTE_MAX_CHIPS_PER_ROW% THEN spr2% = CFG.PALETTE_MAX_CHIPS_PER_ROW%
    DIM swatches_start_x2 AS INTEGER
    swatches_start_x2% = arrow_left_x% + PALETTE_STRIP_ARROW_WIDTH + 2
    swatches_end_x%    = swatches_start_x2% + (spr2% * (sw2% + 1))
    arrow_right_x%     = swatches_end_x% + 2
    pal_name_x%        = SCRN.w& - name_width%

    ' Pass through to normal handler for arrows and palette dropdown
    IF x% >= arrow_left_x% AND x% < arrow_left_x% + PALETTE_STRIP_ARROW_WIDTH THEN
        PALETTE_STRIP_handle_click x%, y%
        EXIT SUB
    END IF
    IF x% >= arrow_right_x% AND x% < arrow_right_x% + PALETTE_STRIP_ARROW_WIDTH THEN
        PALETTE_STRIP_handle_click x%, y%
        EXIT SUB
    END IF
    IF x% >= pal_name_x% AND x% < SCRN.w& - 4 THEN
        PALETTE_STRIP_handle_click x%, y%
        EXIT SUB
    END IF

    ' Calculate which palette index was clicked
    DIM palIdx AS INTEGER
    palIdx% = PALETTE_OPS_calc_strip_index%(x%, y%)

    ' Blank strip area (off the chips): L-click deselects everything
    IF palIdx% < 0 THEN
        IF MOUSE.B1% AND NOT MOUSE.B2% AND NOT MOUSE.B3% THEN PALETTE_OPS_deselect_all
        EXIT SUB
    END IF

    ' Dispatch by button state
    IF MOUSE.B1% AND NOT MOUSE.B2% AND NOT MOUSE.B3% THEN
        DIM clickTime AS DOUBLE
        clickTime# = TIMER

        ' SHIFT: ramp from the selected chip to this one
        IF MODIFIERS.shift% _ANDALSO PALETTE_OPS.SEL_IDX% >= 0 _ANDALSO palIdx% <> PALETTE_OPS.SEL_IDX% THEN
            PALETTE_OPS_ramp PALETTE_OPS.SEL_IDX%, palIdx%
            PALETTE_OPS.DBLCLICK_IDX% = -1
            EXIT SUB
        END IF

        IF palIdx% = PALETTE_OPS.DBLCLICK_IDX% AND _
           (clickTime# - PALETTE_OPS.DBLCLICK_TIME#) < 0.3 THEN
            ' DOUBLE-CLICK: Change color via OS dialog and replace on canvas
            PALETTE_OPS.DBLCLICK_IDX%     = -1
            PALETTE_OPS.DBLCLICK_TIME#    = 0
            PALETTE_OPS.WAND_PENDING_IDX% = -1 ' Cancel any pending wand
            PALETTE_OPS.TOGGLE_PENDING%   = FALSE
            PALETTE_OPS.DRAG_START_X%     = 0
            PALETTE_OPS_select palIdx%
            PALETTE_OPS_change_color palIdx%
            PALETTE_OPS.SEL_LAST~& = PAINT_COLOR~& OR &HFF000000~&
        ELSE
            PALETTE_OPS.DBLCLICK_TIME# = clickTime#
            PALETTE_OPS.DBLCLICK_IDX%  = palIdx%

            ' Clicking the selected chip deselects it — on release, so a drag
            ' that starts on it still moves it.
            IF palIdx% = PALETTE_OPS.SEL_IDX% THEN
                PALETTE_OPS.TOGGLE_PENDING% = TRUE
            ELSE
                PALETTE_OPS.TOGGLE_PENDING% = FALSE
                PALETTE_OPS_select palIdx%

                ' Clear previous wand selection, start the 500ms wand delay
                IF PALETTE_OPS.WAND_SHOWING% THEN
                    MAGIC_WAND_reset
                    MARQUEE.ACTIVE%           = FALSE
                    PALETTE_OPS.WAND_SHOWING% = FALSE
                END IF
                PALETTE_OPS.WAND_PENDING_IDX% = palIdx%
                PALETTE_OPS.WAND_TIMER#       = clickTime#
            END IF

            ' Drag tracking (PALETTE_OPS_handle_held)
            PALETTE_OPS.DRAG_START_X% = x%
            PALETTE_OPS.DRAG_START_Y% = y%
            PALETTE_OPS.DRAG_SRC_IDX% = palIdx%
        END IF
        GUI_NEEDS_REDRAW% = TRUE

    ELSEIF MOUSE.B2% AND NOT MOUSE.B1% THEN
        ' RIGHT: toggle this chip's mark; holding and dragging paints that
        ' same state onto every chip passed over
        PALETTE_OPS_MARKED(palIdx%) = NOT PALETTE_OPS_MARKED(palIdx%)
        PALETTE_OPS.MARK_VALUE%     = PALETTE_OPS_MARKED(palIdx%)
        PALETTE_OPS.MARK_DRAG%      = TRUE
        SOUND_play SND_TOOL_SELECT
        GUI_NEEDS_REDRAW% = TRUE
        FRAME_IDLE%       = FALSE

    ELSEIF MOUSE.B3% THEN
        ' MIDDLE: start a delete range (acts on release — see handle_held)
        PALETTE_OPS.DEL_DRAG%  = TRUE
        PALETTE_OPS.DEL_START% = palIdx%
        PALETTE_OPS.DEL_END%   = palIdx%
        PALETTE_OPS.DEL_SHIFT% = MODIFIERS.shift%
        GUI_NEEDS_REDRAW% = TRUE
        FRAME_IDLE%       = FALSE
    END IF
END SUB


'
' Per-frame strip interaction while a button that was pressed on the strip is
' still held (or was just released): L-drag move, R-drag mark, M-drag delete.
' Called every frame from MOUSE_input_handler while Color Ops is active.
' Returns TRUE while it owns the mouse (caller blocks canvas tools).
'
FUNCTION PALETTE_OPS_handle_held% (x AS INTEGER, y AS INTEGER)
    PALETTE_OPS_handle_held% = FALSE
    IF NOT PALETTE_OPS.ACTIVE% THEN EXIT FUNCTION
    DIM idx AS INTEGER

    ' --- L: drag-move (marked chip moves every marked chip) ---
    IF PALETTE_OPS.DRAG_START_X% > 0 THEN
        IF MOUSE.B1% THEN
            IF NOT PALETTE_OPS.DRAG_ACTIVE% THEN
                IF ABS(x% - PALETTE_OPS.DRAG_START_X%) > 3 OR ABS(y% - PALETTE_OPS.DRAG_START_Y%) > 3 THEN
                    PALETTE_OPS.DRAG_ACTIVE%      = TRUE
                    PALETTE_OPS.DRAG_DST_IDX%     = PALETTE_OPS.DRAG_SRC_IDX%
                    PALETTE_OPS.WAND_PENDING_IDX% = -1 ' Cancel pending wand
                    PALETTE_OPS.TOGGLE_PENDING%   = FALSE
                END IF
            END IF
            IF PALETTE_OPS.DRAG_ACTIVE% THEN
                idx% = PALETTE_OPS_calc_strip_index%(x%, y%)
                IF idx% >= 0 _ANDALSO idx% <> PALETTE_OPS.DRAG_DST_IDX% THEN
                    PALETTE_OPS.DRAG_DST_IDX% = idx%
                    GUI_NEEDS_REDRAW%         = TRUE
                END IF
                FRAME_IDLE% = FALSE
                PALETTE_OPS_handle_held% = TRUE
            END IF
        ELSE
            ' Released
            IF PALETTE_OPS.DRAG_ACTIVE% THEN
                idx% = PALETTE_OPS_calc_strip_index%(x%, y%)
                IF idx% < 0 THEN idx% = PALETTE_OPS.DRAG_DST_IDX%
                IF idx% >= 0 _ANDALSO idx% <> PALETTE_OPS.DRAG_SRC_IDX% THEN
                    IF PALETTE_OPS_MARKED(PALETTE_OPS.DRAG_SRC_IDX%) THEN
                        PALETTE_OPS_move_marked idx%
                    ELSE
                        PALETTE_OPS_rearrange PALETTE_OPS.DRAG_SRC_IDX%, idx%
                    END IF
                END IF
                PALETTE_OPS_handle_held% = TRUE
            ELSEIF PALETTE_OPS.TOGGLE_PENDING% THEN
                PALETTE_OPS_deselect ' plain click on the selected chip
            END IF
            PALETTE_OPS.DRAG_ACTIVE%    = FALSE
            PALETTE_OPS.DRAG_SRC_IDX%   = -1
            PALETTE_OPS.DRAG_DST_IDX%   = -1
            PALETTE_OPS.DRAG_START_X%   = 0
            PALETTE_OPS.DRAG_START_Y%   = 0
            PALETTE_OPS.TOGGLE_PENDING% = FALSE
            GUI_NEEDS_REDRAW%           = TRUE
            FRAME_IDLE%                 = FALSE
        END IF
    END IF

    ' --- R: paint marks ---
    IF PALETTE_OPS.MARK_DRAG% THEN
        IF MOUSE.B2% THEN
            idx% = PALETTE_OPS_calc_strip_index%(x%, y%)
            IF idx% >= 0 _ANDALSO PALETTE_STRIP_in_bounds%(x%, y%) THEN
                IF PALETTE_OPS_MARKED(idx%) <> PALETTE_OPS.MARK_VALUE% THEN
                    PALETTE_OPS_MARKED(idx%) = PALETTE_OPS.MARK_VALUE%
                    GUI_NEEDS_REDRAW%        = TRUE
                END IF
            END IF
            FRAME_IDLE% = FALSE
            PALETTE_OPS_handle_held% = TRUE
        ELSE
            PALETTE_OPS.MARK_DRAG% = FALSE
        END IF
    END IF

    ' --- M: delete range (single chip = click semantics) ---
    IF PALETTE_OPS.DEL_DRAG% THEN
        IF MOUSE.B3% THEN
            idx% = PALETTE_OPS_calc_strip_index%(x%, y%)
            IF idx% >= 0 _ANDALSO PALETTE_STRIP_in_bounds%(x%, y%) _ANDALSO idx% <> PALETTE_OPS.DEL_END% THEN
                PALETTE_OPS.DEL_END% = idx%
                GUI_NEEDS_REDRAW%    = TRUE
            END IF
            FRAME_IDLE% = FALSE
            PALETTE_OPS_handle_held% = TRUE
        ELSE
            DIM dS AS INTEGER, dE AS INTEGER, dShift AS INTEGER
            dS% = PALETTE_OPS.DEL_START% : dE% = PALETTE_OPS.DEL_END% : dShift% = PALETTE_OPS.DEL_SHIFT%
            PALETTE_OPS.DEL_DRAG%  = FALSE
            PALETTE_OPS.DEL_START% = -1
            PALETTE_OPS.DEL_END%   = -1
            IF dS% >= 0 _ANDALSO dS% < PAL_COLOR_COUNT% THEN
                IF dE% = dS% THEN
                    IF dShift% THEN
                        PALETTE_OPS_insert_color dS%
                    ELSEIF PALETTE_OPS_MARKED(dS%) THEN
                        PALETTE_OPS_delete_marked
                    ELSE
                        PALETTE_OPS_delete_color dS%
                    END IF
                ELSEIF dE% >= 0 _ANDALSO dE% < PAL_COLOR_COUNT% THEN
                    IF dE% < dS% THEN SWAP dS%, dE%
                    PALETTE_OPS_delete_range dS%, dE%
                END IF
            END IF
            GUI_NEEDS_REDRAW% = TRUE
            FRAME_IDLE%       = FALSE
            PALETTE_OPS_handle_held% = TRUE
        END IF
    END IF
END FUNCTION


''
' Change a palette color via OS color dialog and replace old color on canvas.
'
SUB PALETTE_OPS_change_color (palIdx AS INTEGER)
    DIM oldColor AS _UNSIGNED LONG
    oldColor~& = PAL(palIdx%).value~&

    CP_reset_options
    DIM newColor AS _UNSIGNED LONG
    newColor~& = DRAW_pick_color&("Change Palette Color #" + _TRIM$(STR$(palIdx%)), oldColor~&)
    MOUSE_cleanup_after_dialog FALSE

    ' Detect cancel by comparing the RETURNED color to the initial (the contract
    ' every other DRAW_pick_color& caller uses — see ORGANIZER_handle_*). Do NOT
    ' read CP_STATE.result here: when the floating color mixer is open,
    ' DRAW_pick_color& re-inits it on close (COLORMIXER_ensure_initialized ->
    ' CP_init), which resets CP_STATE.result to CP_RESULT_NONE before we return.
    ' Reading it made a double-click color edit silently no-op with the mixer up.
    IF newColor~& = oldColor~& THEN EXIT SUB

    ' BUG-31: snapshot the palette + group the change with its pixel-remap records so one
    ' Ctrl+Z restores both the color and the remapped pixels.
    DIM pccBefore AS STRING, pccOwns AS INTEGER : pccOwns% = FALSE
    IF NOT HISTORY_IN_PROGRESS% AND NOT HISTORY_GROUP_ACTIVE% THEN
        pccBefore$ = PALETTE_snapshot$
        HISTORY_begin_group
        pccOwns% = TRUE
    END IF

    ' Update palette entry
    PAL(palIdx%).value~& = newColor~&

    ' Replace old color with new color across all visible layers
    PALETTE_OPS_replace_color_on_layers oldColor~&, newColor~&

    ' Update FG/BG colors if they referenced this index
    IF PAL_FG_IDX% = palIdx% THEN PAINT_COLOR~& = newColor~&
    IF PAL_BG_IDX% = palIdx% THEN PAINT_BG_COLOR~& = newColor~&

    IF pccOwns% THEN
        HISTORY_record_palette pccBefore$, PALETTE_snapshot$, "Change Color"
        HISTORY_end_group
    END IF

    PALETTE_OPS_mark_document_palette
    CANVAS_DIRTY%     = TRUE
    SCENE_DIRTY%      = TRUE
    GUI_NEEDS_REDRAW% = TRUE
    FRAME_IDLE%       = FALSE
    _LOGINFO "PALETTE_OPS: Changed color " + STR$(palIdx%) + " and replaced on canvas"
END SUB


''
' Replace all pixels of oldColor with newColor across all visible layers.
' Records history for undo support.
'
SUB PALETTE_OPS_replace_color_on_layers (oldColor AS _UNSIGNED LONG, newColor AS _UNSIGNED LONG)
    DIM cW AS LONG, cH AS LONG ' per layer: a promoted layer's buffer is larger than the canvas (gotcha #14)

    ' Only open (and later close) a history group if WE own it. BUG-31: reading
    ' usedGroup% from HISTORY_GROUP_ACTIVE% AFTER begin_group wrongly claimed ownership
    ' when a caller had already opened a group (begin_group early-exits when one is
    ' active) — so this SUB then CLOSED the caller's group after the first color, and a
    ' batch delete fell back to N separate undos. Now claim ownership only when no group
    ' was active on entry, so a caller (PALETTE_OPS_delete_marked) can wrap the whole
    ' batch in one group and every replace here joins it.
    DIM usedGroup AS INTEGER
    usedGroup% = FALSE
    IF NOT HISTORY_IN_PROGRESS% AND NOT HISTORY_GROUP_ACTIVE% THEN
        HISTORY_begin_group
        usedGroup% = TRUE
    END IF

    DIM li AS INTEGER
    ' BUG-25: LAYERS() is SPARSE after a mid-stack delete — a used layer can sit in a slot
    ' index > LAYER_COUNT%. Iterate the full array (the imgHandle guard skips empty slots),
    ' or the palette replace silently skips high-slot layers.
    FOR li% = 1 TO MAX_LAYERS
        IF LAYERS(li%).imgHandle < -1 AND LAYERS(li%).visible THEN
            ' Save before-image for undo
            DIM repBefore AS LONG
            repBefore& = 0
            IF LAYERS(li%).historyId& > 0 THEN
                repBefore& = _COPYIMAGE(LAYERS(li%).imgHandle&, 32)
            END IF

            cW& = _WIDTH(LAYERS(li%).imgHandle)
            cH& = _HEIGHT(LAYERS(li%).imgHandle)
            DIM repMem     AS _MEM
            repMem = _MEMIMAGE(LAYERS(li%).imgHandle)
            DIM rpx        AS LONG, rpy AS LONG
            DIM repOff     AS _OFFSET
            DIM repPix     AS _UNSIGNED LONG
            DIM repChanged AS INTEGER
            repChanged% = FALSE

            FOR rpy& = 0 TO cH& - 1
                FOR rpx& = 0 TO cW& - 1
                    repOff = repMem.OFFSET + (rpy& * cW& + rpx&) * 4
                    _MEMGET repMem, repOff, repPix~&
                    IF _ALPHA32(repPix~&) > 0 THEN
                        IF _RED32(repPix~&) = _RED32(oldColor~&) AND _
                           _GREEN32(repPix~&) = _GREEN32(oldColor~&) AND _
                           _BLUE32(repPix~&)  = _BLUE32(oldColor~&) THEN
                            DIM repNew AS _UNSIGNED LONG
                            repNew~& = _RGBA32(_RED32(newColor~&), _GREEN32(newColor~&), _BLUE32(newColor~&), _ALPHA32(repPix~&))
                            _MEMPUT repMem, repOff, repNew~&
                            repChanged% = TRUE
                        END IF
                    END IF
                NEXT rpx&
            NEXT rpy&
            _MEMFREE repMem

            IF repChanged% THEN
                LAYERS(li%).contentDirty = TRUE
                IF repBefore& < -1 THEN
                    HISTORY_record_transform LAYERS(li%).historyId&, li%, 0, repBefore&, "Palette Ops Color Change"
                END IF
            ELSE
                IF repBefore& < -1 THEN SAFE_FREEIMAGE repBefore&
            END IF
        END IF
    NEXT li%

    IF usedGroup% THEN HISTORY_end_group
    HISTORY_saved_this_frame% = TRUE
    BLEND_invalidate_cache
END SUB


''
' BUG-31: serialize the full palette STATE for undo — every color (value + name) up to
' PAL_COLOR_COUNT, plus the FG/BG indices, the transparent flags, and the resolved
' PAINT_COLOR/PAINT_BG_COLOR. Header is 18 bytes: 5 x INTEGER (count, fg, bg, fgT, bgT)
' + 2 x _UNSIGNED LONG (paint fg/bg); then per color: _UNSIGNED LONG value + INTEGER
' name-length + name bytes, then "CYC1" + PCYC_serialize$ (color cycling ranges;
' optional on restore). Paired with PALETTE_restore.
'
FUNCTION PALETTE_snapshot$
    DIM s AS STRING, i AS INTEGER
    s$ = MKI$(PAL_COLOR_COUNT%) + MKI$(PAL_FG_IDX%) + MKI$(PAL_BG_IDX%)
    s$ = s$ + MKI$(PAL_FG_IS_TRANSPARENT%) + MKI$(PAL_BG_IS_TRANSPARENT%)
    s$ = s$ + _MK$(_UNSIGNED LONG, PAINT_COLOR~&) + _MK$(_UNSIGNED LONG, PAINT_BG_COLOR~&)
    FOR i% = 0 TO PAL_COLOR_COUNT% - 1
        s$ = s$ + _MK$(_UNSIGNED LONG, PAL(i%).value~&)
        s$ = s$ + MKI$(LEN(PAL(i%).name$)) + PAL(i%).name$
    NEXT i%
    ' Color cycling ranges ride along so every palette undo step restores them
    s$ = s$ + "CYC1" + PCYC_serialize$
    PALETTE_snapshot$ = s$
END FUNCTION

''
' Restore a palette state captured by PALETTE_snapshot$. Rebuilds PAL(), the count,
' FG/BG indices + transparent flags, and the resolved paint colors.
'
SUB PALETTE_restore (snap AS STRING)
    IF LEN(snap$) < 18 THEN EXIT SUB
    DIM p   AS LONG : p& = 1
    DIM cnt AS INTEGER
    cnt%                   = CVI(MID$(snap$, p&, 2))                 : p& = p& + 2
    PAL_FG_IDX%            = CVI(MID$(snap$, p&, 2))                 : p& = p& + 2
    PAL_BG_IDX%            = CVI(MID$(snap$, p&, 2))                 : p& = p& + 2
    PAL_FG_IS_TRANSPARENT% = CVI(MID$(snap$, p&, 2))                 : p& = p& + 2
    PAL_BG_IS_TRANSPARENT% = CVI(MID$(snap$, p&, 2))                 : p& = p& + 2
    PAINT_COLOR~&          = _CV(_UNSIGNED LONG, MID$(snap$, p&, 4)) : p& = p& + 4
    PAINT_BG_COLOR~&       = _CV(_UNSIGNED LONG, MID$(snap$, p&, 4)) : p& = p& + 4
    DIM i   AS INTEGER, nlen AS INTEGER
    FOR i% = 0 TO cnt% - 1
        PAL(i%).value~& = _CV(_UNSIGNED LONG, MID$(snap$, p&, 4)) : p& = p& + 4
        nlen%           = CVI(MID$(snap$, p&, 2))                 : p& = p& + 2
        IF nlen% > 0 THEN
            PAL(i%).name$ = MID$(snap$, p&, nlen%) : p& = p& + nlen%
        ELSE
            PAL(i%).name$ = ""
        END IF
    NEXT i%
    PAL_COLOR_COUNT% = cnt%
    ' Optional color cycling tail (snapshots from before cycling existed lack it
    ' and leave the ranges alone)
    IF MID$(snap$, p&, 4) = "CYC1" THEN
        DIM cycUsed AS LONG
        cycUsed& = PCYC_deserialize&(snap$, p& + 4)
    END IF
END SUB

''
' Delete a palette color. Pixels using it are remapped to nearest neighbor.
'
SUB PALETTE_OPS_delete_color (palIdx AS INTEGER)
    IF PAL_COLOR_COUNT% <= 2 THEN
        _LOGWARN "PALETTE_OPS: Cannot delete — minimum 2 palette colors required"
        SOUND_play SND_TOOL_SELECT
        EXIT SUB
    END IF

    ' BUG-31: when deleting a single color (NOT inside a batch), snapshot the palette and
    ' open one undo group so the color-state record + the pixel-remap records collapse into
    ' a single Ctrl+Z. In a batch, PALETTE_OPS_delete_marked owns the group + snapshot.
    DIM pdcBefore AS STRING, pdcOwns AS INTEGER : pdcOwns% = FALSE
    IF NOT PALETTE_OPS_BATCH% THEN
        pdcBefore$ = PALETTE_snapshot$
        HISTORY_begin_group
        pdcOwns% = TRUE
    END IF

    DIM deletedColor AS _UNSIGNED LONG
    deletedColor~& = PAL(palIdx%).value~&

    ' Find nearest neighbor (excluding the color being deleted)
    DIM nearestIdx   AS INTEGER
    nearestIdx% = PAL_find_closest_excluding%(deletedColor~&, palIdx%)
    DIM nearestColor AS _UNSIGNED LONG
    nearestColor~& = PAL(nearestIdx%).value~&

    ' Replace deleted color pixels with nearest neighbor
    PALETTE_OPS_replace_color_on_layers deletedColor~&, nearestColor~&

    ' Shift palette entries down
    DIM pi AS INTEGER
    FOR pi% = palIdx% TO PAL_COLOR_COUNT% - 2
        PAL(pi%).value~&        = PAL(pi% + 1).value~&
        PAL(pi%).name$          = PAL(pi% + 1).name$
        PALETTE_OPS_MARKED(pi%) = PALETTE_OPS_MARKED(pi% + 1)
    NEXT pi%
    PAL_COLOR_COUNT% = PAL_COLOR_COUNT% - 1
    PALETTE_OPS_MARKED(PAL_COLOR_COUNT%) = FALSE
    PCYC_on_delete palIdx% ' cycle ranges shift / shrink with the palette
    IF PALETTE_OPS.SEL_IDX% = palIdx% THEN
        PALETTE_OPS.SEL_IDX% = -1
    ELSEIF PALETTE_OPS.SEL_IDX% > palIdx% THEN
        PALETTE_OPS.SEL_IDX% = PALETTE_OPS.SEL_IDX% - 1
    END IF

    ' Adjust FG/BG indices
    IF PAL_FG_IDX% = palIdx% THEN
        IF nearestIdx% > palIdx% THEN nearestIdx% = nearestIdx% - 1
        PAL_FG_IDX%   = nearestIdx%
        PAINT_COLOR~& = PAL(PAL_FG_IDX%).value~&
    ELSEIF PAL_FG_IDX% > palIdx% THEN
        PAL_FG_IDX% = PAL_FG_IDX% - 1
    END IF
    IF PAL_BG_IDX% = palIdx% THEN
        IF nearestIdx% > palIdx% THEN nearestIdx% = nearestIdx% - 1
        PAL_BG_IDX%      = nearestIdx%
        PAINT_BG_COLOR~& = PAL(PAL_BG_IDX%).value~&
    ELSEIF PAL_BG_IDX% > palIdx% THEN
        PAL_BG_IDX% = PAL_BG_IDX% - 1
    END IF

    IF pdcOwns% THEN
        HISTORY_record_palette pdcBefore$, PALETTE_snapshot$, "Delete Color"
        HISTORY_end_group
    END IF

    PALETTE_OPS_mark_document_palette
    SOUND_play SND_LAYER_OP
    CANVAS_DIRTY%     = TRUE
    SCENE_DIRTY%      = TRUE
    GUI_NEEDS_REDRAW% = TRUE
    FRAME_IDLE%       = FALSE
    _LOGINFO "PALETTE_OPS: Deleted color " + STR$(palIdx%) + ", remapped to idx " + STR$(nearestIdx%)
END SUB


''
' Delete all marked palette colors (one undo step).
'
SUB PALETTE_OPS_delete_marked ()
    DIM flags(0 TO 255) AS INTEGER, mi AS INTEGER
    FOR mi% = 0 TO 255
        flags(mi%) = PALETTE_OPS_MARKED(mi%)
    NEXT mi%
    PALETTE_OPS_delete_flags flags(), "Delete Colors"
END SUB


''
' Delete palette colors lo..hi inclusive (M-drag range; one undo step).
'
SUB PALETTE_OPS_delete_range (lo AS INTEGER, hi AS INTEGER)
    DIM flags(0 TO 255) AS INTEGER, ri AS INTEGER
    FOR ri% = lo% TO hi%
        IF ri% >= 0 _ANDALSO ri% <= 255 THEN flags(ri%) = TRUE
    NEXT ri%
    PALETTE_OPS_delete_flags flags(), "Delete Color Range"
END SUB


''
' Delete every palette color whose flag is set. Processes from highest index
' to lowest so lower indices stay valid; each deleted color's pixels remap to
' its nearest surviving neighbor. flags() is a caller-owned copy (never
' PALETTE_OPS_MARKED itself, which PALETTE_OPS_delete_color shifts as it goes).
'
SUB PALETTE_OPS_delete_flags (flags() AS INTEGER, label AS STRING)
    DIM delIdx   AS INTEGER
    DIM delCount AS INTEGER
    DIM mi       AS INTEGER
    FOR mi% = 0 TO PAL_COLOR_COUNT% - 1
        IF flags(mi%) THEN delCount% = delCount% + 1
    NEXT mi%

    IF delCount% = 0 THEN EXIT SUB
    IF PAL_COLOR_COUNT% - delCount% < 2 THEN
        _LOGWARN "PALETTE_OPS: Cannot delete — must keep at least 2 palette colors"
        SOUND_play SND_TOOL_SELECT
        EXIT SUB
    END IF
    PALETTE_OPS_edit_commit

    ' BUG-31: batch the whole delete into ONE undo group + ONE palette-state record so a
    ' single Ctrl+Z restores every deleted color AND its remapped pixels at once.
    ' PALETTE_OPS_BATCH% tells each inner PALETTE_OPS_delete_color to skip its own
    ' group/snapshot and join this one.
    DIM opdBefore AS STRING, opdOwns AS INTEGER : opdOwns% = FALSE
    IF NOT HISTORY_IN_PROGRESS% AND NOT HISTORY_GROUP_ACTIVE% THEN
        opdBefore$ = PALETTE_snapshot$
        HISTORY_begin_group
        opdOwns% = TRUE
    END IF

    PALETTE_OPS_BATCH% = TRUE
    FOR delIdx% = PAL_COLOR_COUNT% - 1 TO 0 STEP -1
        IF flags(delIdx%) THEN PALETTE_OPS_delete_color delIdx%
    NEXT delIdx%
    PALETTE_OPS_BATCH% = FALSE

    IF opdOwns% THEN
        HISTORY_record_palette opdBefore$, PALETTE_snapshot$, label$
        HISTORY_end_group
    END IF

    _LOGINFO "PALETTE_OPS: Deleted " + STR$(delCount%) + " colors"
END SUB


''
' Insert the current FG color after the specified index (blank when FG is
' transparent) — build a palette straight from the color panels. Undoable.
'
SUB PALETTE_OPS_insert_color (palIdx AS INTEGER)
    IF PAL_COLOR_COUNT% >= 256 THEN
        _LOGWARN "PALETTE_OPS: Palette full (256 colors), cannot insert"
        EXIT SUB
    END IF
    PALETTE_OPS_edit_commit
    DIM insBefore AS STRING : insBefore$ = PALETTE_snapshot$

    ' Shift palette entries up from the end
    DIM ii AS INTEGER
    FOR ii% = PAL_COLOR_COUNT% TO palIdx% + 2 STEP -1
        PAL(ii%).value~&        = PAL(ii% - 1).value~&
        PAL(ii%).name$          = PAL(ii% - 1).name$
        PALETTE_OPS_MARKED(ii%) = PALETTE_OPS_MARKED(ii% - 1)
    NEXT ii%

    ' New entry at palIdx + 1
    IF PAL_FG_IS_TRANSPARENT% THEN
        PAL(palIdx% + 1).value~& = _RGBA32(0, 0, 0, 0)
    ELSE
        PAL(palIdx% + 1).value~& = PAINT_COLOR~& OR &HFF000000~&
    END IF
    PAL(palIdx% + 1).name$          = ""
    PALETTE_OPS_MARKED(palIdx% + 1) = FALSE
    PAL_COLOR_COUNT% = PAL_COLOR_COUNT% + 1
    PCYC_on_insert palIdx% + 1 ' cycle ranges shift / grow with the palette

    ' Adjust FG/BG/selected indices
    IF PAL_FG_IDX% > palIdx% THEN PAL_FG_IDX% = PAL_FG_IDX% + 1
    IF PAL_BG_IDX% > palIdx% THEN PAL_BG_IDX% = PAL_BG_IDX% + 1
    IF PALETTE_OPS.SEL_IDX% > palIdx% THEN PALETTE_OPS.SEL_IDX% = PALETTE_OPS.SEL_IDX% + 1

    HISTORY_record_palette insBefore$, PALETTE_snapshot$, "Insert Color"
    PALETTE_OPS_mark_document_palette
    SOUND_play SND_NEW_LAYER
    GUI_NEEDS_REDRAW% = TRUE
    FRAME_IDLE%       = FALSE
    _LOGINFO "PALETTE_OPS: Inserted color after idx " + STR$(palIdx%)
END SUB


''
' Rearrange a palette color from srcIdx to dstIdx (it lands AT dstIdx; the
' colors between shift over). Undoable.
'
SUB PALETTE_OPS_rearrange (srcIdx AS INTEGER, dstIdx AS INTEGER)
    IF srcIdx% = dstIdx% THEN EXIT SUB
    IF srcIdx% < 0 OR srcIdx% >= PAL_COLOR_COUNT% THEN EXIT SUB
    IF dstIdx% < 0 OR dstIdx% >= PAL_COLOR_COUNT% THEN EXIT SUB

    ' order(newPos) = oldIdx: the list without src, with src inserted at dst
    DIM order(0 TO 255) AS INTEGER, n AS INTEGER, i AS INTEGER
    FOR i% = 0 TO PAL_COLOR_COUNT% - 1
        IF i% <> srcIdx% THEN
            IF n% = dstIdx% THEN order(n%) = srcIdx% : n% = n% + 1
            order(n%) = i% : n% = n% + 1
        END IF
    NEXT i%
    IF n% = dstIdx% THEN order(n%) = srcIdx%
    PALETTE_OPS_apply_order order(), "Move Color"
    _LOGINFO "PALETTE_OPS: Rearranged color " + STR$(srcIdx%) + " -> " + STR$(dstIdx%)
END SUB


''
' Move every marked chip, as one block in its current order, to dstIdx:
' dropped left of the block it lands before dstIdx, dropped right it lands
' after it. Dropping onto a marked chip does nothing. Undoable.
'
SUB PALETTE_OPS_move_marked (dstIdx AS INTEGER)
    IF dstIdx% < 0 OR dstIdx% >= PAL_COLOR_COUNT% THEN EXIT SUB
    IF PALETTE_OPS_MARKED(dstIdx%) THEN EXIT SUB
    DIM kept(0 TO 255) AS INTEGER, moved(0 TO 255) AS INTEGER
    DIM nk AS INTEGER, nm AS INTEGER, i AS INTEGER, firstMarked AS INTEGER, p AS INTEGER
    firstMarked% = -1
    FOR i% = 0 TO PAL_COLOR_COUNT% - 1
        IF PALETTE_OPS_MARKED(i%) THEN
            moved(nm%) = i% : nm% = nm% + 1
            IF firstMarked% < 0 THEN firstMarked% = i%
        ELSE
            IF i% < dstIdx% THEN p% = p% + 1
            kept(nk%) = i% : nk% = nk% + 1
        END IF
    NEXT i%
    IF nm% = 0 THEN EXIT SUB
    IF dstIdx% > firstMarked% THEN p% = p% + 1 ' moving right: land after the target

    DIM order(0 TO 255) AS INTEGER, n AS INTEGER
    FOR i% = 0 TO p% - 1 : order(n%) = kept(i%) : n% = n% + 1 : NEXT i%
    FOR i% = 0 TO nm% - 1 : order(n%) = moved(i%) : n% = n% + 1 : NEXT i%
    FOR i% = p% TO nk% - 1 : order(n%) = kept(i%) : n% = n% + 1 : NEXT i%
    PALETTE_OPS_apply_order order(), "Move Colors"
    _LOGINFO "PALETTE_OPS: Moved " + STR$(nm%) + " marked colors to " + STR$(dstIdx%)
END SUB


''
' Reorder the palette: order(newPos) = oldIdx for every color. Marks, FG/BG
' and the selected chip follow their colors. Pixels are untouched (colors are
' unchanged, only their slots). One palette undo record.
'
SUB PALETTE_OPS_apply_order (order() AS INTEGER, label AS STRING)
    PALETTE_OPS_edit_commit
    DIM aoBefore AS STRING : aoBefore$ = PALETTE_snapshot$
    DIM cnt AS INTEGER : cnt% = PAL_COLOR_COUNT%
    DIM v(0 TO 255) AS _UNSIGNED LONG, nm(0 TO 255) AS STRING, mk(0 TO 255) AS INTEGER, inv(0 TO 255) AS INTEGER
    DIM i AS INTEGER
    FOR i% = 0 TO cnt% - 1
        v(i%) = PAL(i%).value~& : nm(i%) = PAL(i%).name$ : mk(i%) = PALETTE_OPS_MARKED(i%)
    NEXT i%
    FOR i% = 0 TO cnt% - 1
        PAL(i%).value~&        = v(order(i%))
        PAL(i%).name$          = nm(order(i%))
        PALETTE_OPS_MARKED(i%) = mk(order(i%))
        inv(order(i%))         = i%
    NEXT i%
    IF PAL_FG_IDX% >= 0 _ANDALSO PAL_FG_IDX% < cnt% THEN PAL_FG_IDX% = inv(PAL_FG_IDX%)
    IF PAL_BG_IDX% >= 0 _ANDALSO PAL_BG_IDX% < cnt% THEN PAL_BG_IDX% = inv(PAL_BG_IDX%)
    IF PALETTE_OPS.SEL_IDX% >= 0 _ANDALSO PALETTE_OPS.SEL_IDX% < cnt% THEN PALETTE_OPS.SEL_IDX% = inv(PALETTE_OPS.SEL_IDX%)
    PALETTE_OPS.DBLCLICK_IDX% = -1
    PCYC_on_reorder order(), cnt% ' ranges follow their colors when still contiguous

    HISTORY_record_palette aoBefore$, PALETTE_snapshot$, label$
    PALETTE_OPS_mark_document_palette
    SOUND_play SND_DRAG_DROP
    GUI_NEEDS_REDRAW% = TRUE
    FRAME_IDLE%       = FALSE
END SUB


''
' Select a chip: it becomes FG and follows FG edits until deselected.
'
SUB PALETTE_OPS_select (idx AS INTEGER)
    IF idx% < 0 OR idx% >= PAL_COLOR_COUNT% THEN EXIT SUB
    PALETTE_OPS_edit_commit
    PALETTE_OPS.SEL_IDX%   = idx%
    PAL_FG_IS_TRANSPARENT% = FALSE
    PAL_FG_IDX%            = idx%
    PAINT_COLOR~&          = PAL(idx%).value~&
    PALETTE_OPS.SEL_LAST~& = PAINT_COLOR~& OR &HFF000000~&
    SOUND_play SND_TOOL_SELECT
    STATUS_NEEDS_REDRAW% = TRUE
    GUI_NEEDS_REDRAW%    = TRUE
    FRAME_IDLE%          = FALSE
END SUB


''
' Deselect the chip (FG keeps its color). Clears the chip's wand selection.
'
SUB PALETTE_OPS_deselect ()
    PALETTE_OPS_edit_commit
    PALETTE_OPS.SEL_IDX%          = -1
    PALETTE_OPS.WAND_PENDING_IDX% = -1
    IF PALETTE_OPS.WAND_SHOWING% THEN
        MAGIC_WAND_reset
        MARQUEE.ACTIVE%           = FALSE
        PALETTE_OPS.WAND_SHOWING% = FALSE
    END IF
    GUI_NEEDS_REDRAW% = TRUE
    SCENE_DIRTY%      = TRUE
    FRAME_IDLE%       = FALSE
END SUB


''
' Deselect the chip and clear every mark (L-click on a blank strip area).
'
SUB PALETTE_OPS_deselect_all ()
    PALETTE_OPS_deselect
    DIM i AS INTEGER
    FOR i% = 0 TO 255
        PALETTE_OPS_MARKED(i%) = FALSE
    NEXT i%
END SUB


''
' Live chip edit, step 1: record the chip's pixels. Every pixel (all visible
' layers, alpha > 0) whose RGB is the chip's color is noted by byte offset,
' so each later update rewrites exactly those pixels. Layers holding any get a
' before-image for the undo record.
'
SUB PALETTE_OPS_edit_begin ()
    DIM sel AS INTEGER : sel% = PALETTE_OPS.SEL_IDX%
    PALETTE_OPS.EDIT_ORIG~& = PAL(sel%).value~&
    DIM origRGB AS _UNSIGNED LONG : origRGB~& = PALETTE_OPS.EDIT_ORIG~& AND &HFFFFFF

    ' Undo snapshot of the palette as it was. FG has already moved to the new
    ' color by the time an edit is seen, so put the chip's color back as FG.
    PALETTE_OPS_EDIT_BEFORE$ = PALETTE_snapshot$
    MID$(PALETTE_OPS_EDIT_BEFORE$, 11, 4) = _MK$(_UNSIGNED LONG, PALETTE_OPS.EDIT_ORIG~&)

    DIM li AS INTEGER, total AS LONG, pass AS INTEGER
    DIM m AS _MEM, o AS _OFFSET, oEnd AS _OFFSET, px AS _UNSIGNED LONG, k AS LONG
    FOR pass% = 1 TO 2 ' 1 = count, 2 = record offsets
        IF pass% = 2 THEN
            IF total& < 1 THEN total& = 1
            REDIM PALETTE_OPS_EDIT_OFF(0 TO total& - 1) AS LONG
            k& = 0
        END IF
        FOR li% = 1 TO MAX_LAYERS
            IF pass% = 1 THEN PALETTE_OPS_EDIT_N(li%) = 0 : PALETTE_OPS_EDIT_IMG(li%) = 0
            IF LAYERS(li%).imgHandle < -1 _ANDALSO LAYERS(li%).visible THEN
                IF pass% = 2 THEN PALETTE_OPS_EDIT_FIRST(li%) = k&
                m = _MEMIMAGE(LAYERS(li%).imgHandle)
                o = m.OFFSET : oEnd = m.OFFSET + m.SIZE
                DO WHILE o < oEnd
                    _MEMGET m, o, px
                    IF (px AND &HFF000000~&) <> 0 _ANDALSO (px AND &HFFFFFF) = origRGB~& THEN
                        IF pass% = 1 THEN
                            PALETTE_OPS_EDIT_N(li%) = PALETTE_OPS_EDIT_N(li%) + 1
                            total& = total& + 1
                        ELSE
                            PALETTE_OPS_EDIT_OFF(k&) = o - m.OFFSET : k& = k& + 1
                        END IF
                    END IF
                    o = o + 4
                LOOP
                _MEMFREE m
                IF pass% = 2 _ANDALSO PALETTE_OPS_EDIT_N(li%) > 0 _ANDALSO LAYERS(li%).historyId& > 0 THEN
                    PALETTE_OPS_EDIT_IMG(li%) = _COPYIMAGE(LAYERS(li%).imgHandle, 32)
                END IF
            END IF
        NEXT li%
    NEXT pass%
    PALETTE_OPS.EDIT_COUNT& = k&
    PALETTE_OPS.EDIT_ACTIVE% = TRUE
END SUB


''
' Live chip edit, step 2: the chip and its recorded pixels become newColor
' (each pixel keeps its own alpha). Runs every frame the FG changes.
'
SUB PALETTE_OPS_edit_apply (newColor AS _UNSIGNED LONG)
    DIM sel AS INTEGER : sel% = PALETTE_OPS.SEL_IDX%
    IF sel% < 0 OR sel% >= PAL_COLOR_COUNT% THEN EXIT SUB
    IF NOT PALETTE_OPS.EDIT_ACTIVE% THEN PALETTE_OPS_edit_begin

    DIM rgb AS _UNSIGNED LONG : rgb~& = newColor~& AND &HFFFFFF
    PAL(sel%).value~& = newColor~& OR &HFF000000~&
    PAL_FG_IDX% = sel%
    IF PAL_BG_IDX% = sel% _ANDALSO NOT PAL_BG_IS_TRANSPARENT% THEN PAINT_BG_COLOR~& = PAL(sel%).value~&

    DIM li AS INTEGER, k AS LONG, m AS _MEM, o AS _OFFSET, px AS _UNSIGNED LONG
    FOR li% = 1 TO MAX_LAYERS
        IF PALETTE_OPS_EDIT_N(li%) > 0 _ANDALSO LAYERS(li%).imgHandle < -1 THEN
            m = _MEMIMAGE(LAYERS(li%).imgHandle)
            FOR k& = PALETTE_OPS_EDIT_FIRST(li%) TO PALETTE_OPS_EDIT_FIRST(li%) + PALETTE_OPS_EDIT_N(li%) - 1
                o = m.OFFSET + PALETTE_OPS_EDIT_OFF(k&)
                _MEMGET m, o, px
                px = (px AND &HFF000000~&) OR rgb~&
                _MEMPUT m, o, px
            NEXT k&
            _MEMFREE m
            LAYERS(li%).contentDirty = TRUE
        END IF
    NEXT li%
    IF PALETTE_OPS.EDIT_COUNT& > 0 THEN BLEND_invalidate_cache

    PALETTE_OPS.SEL_LAST~& = newColor~& OR &HFF000000~&
    CANVAS_DIRTY%        = TRUE
    SCENE_DIRTY%         = TRUE
    GUI_NEEDS_REDRAW%    = TRUE
    STATUS_NEEDS_REDRAW% = TRUE
    FRAME_IDLE%          = FALSE
END SUB


''
' Live chip edit, step 3: one undo step for the whole edit (palette state +
' every changed layer), then forget the recorded pixels. No-op when no edit
' is open or the chip ended back at its original color.
'
SUB PALETTE_OPS_edit_commit ()
    IF NOT PALETTE_OPS.EDIT_ACTIVE% THEN EXIT SUB
    PALETTE_OPS.EDIT_ACTIVE% = FALSE
    DIM sel AS INTEGER : sel% = PALETTE_OPS.SEL_IDX%
    DIM changed AS INTEGER
    IF sel% >= 0 _ANDALSO sel% < PAL_COLOR_COUNT% THEN
        changed% = ((PAL(sel%).value~& AND &HFFFFFF) <> (PALETTE_OPS.EDIT_ORIG~& AND &HFFFFFF))
    END IF

    DIM li AS INTEGER
    IF changed% _ANDALSO NOT HISTORY_IN_PROGRESS% THEN
        DIM owns AS INTEGER
        IF NOT HISTORY_GROUP_ACTIVE% THEN HISTORY_begin_group : owns% = TRUE
        FOR li% = 1 TO MAX_LAYERS
            IF PALETTE_OPS_EDIT_IMG(li%) < -1 _ANDALSO LAYERS(li%).imgHandle < -1 THEN
                HISTORY_record_transform LAYERS(li%).historyId&, li%, 0, PALETTE_OPS_EDIT_IMG(li%), "Palette Color Edit"
                PALETTE_OPS_EDIT_IMG(li%) = 0 ' history owns it now
            END IF
        NEXT li%
        HISTORY_record_palette PALETTE_OPS_EDIT_BEFORE$, PALETTE_snapshot$, "Edit Palette Color"
        IF owns% THEN HISTORY_end_group
        HISTORY_saved_this_frame% = TRUE
        PALETTE_OPS_mark_document_palette
        _LOGINFO "PALETTE_OPS: Edited color " + STR$(sel%) + " (" + _TRIM$(STR$(PALETTE_OPS.EDIT_COUNT&)) + " pixels)"
    END IF
    PALETTE_OPS_edit_discard
END SUB


''
' Drop the live-edit bookkeeping without recording anything (document load).
'
SUB PALETTE_OPS_edit_discard ()
    DIM li AS INTEGER
    FOR li% = 1 TO MAX_LAYERS
        IF PALETTE_OPS_EDIT_IMG(li%) < -1 THEN _FREEIMAGE PALETTE_OPS_EDIT_IMG(li%)
        PALETTE_OPS_EDIT_IMG(li%) = 0
        PALETTE_OPS_EDIT_N(li%)   = 0
    NEXT li%
    REDIM PALETTE_OPS_EDIT_OFF(0) AS LONG
    PALETTE_OPS.EDIT_COUNT&  = 0
    PALETTE_OPS.EDIT_ACTIVE% = FALSE
    PALETTE_OPS_EDIT_BEFORE$ = ""
END SUB


''
' Ramp: the chips strictly between fromIdx and toIdx become an interpolated
' ramp from fromIdx's color to toIdx's (CFG.GRADIENT_BLEND_SPACE, same as the
' gradient tools), and their pixels follow. toIdx becomes the selected chip.
' One undo step.
'
SUB PALETTE_OPS_ramp (fromIdx AS INTEGER, toIdx AS INTEGER)
    IF fromIdx% < 0 OR fromIdx% >= PAL_COLOR_COUNT% OR toIdx% < 0 OR toIdx% >= PAL_COLOR_COUNT% THEN EXIT SUB
    PALETTE_OPS_edit_commit
    DIM span AS INTEGER : span% = toIdx% - fromIdx%
    IF ABS(span%) >= 2 THEN
        DIM c1 AS _UNSIGNED LONG, c2 AS _UNSIGNED LONG
        c1~& = PAL(fromIdx%).value~& OR &HFF000000~&
        c2~& = PAL(toIdx%).value~& OR &HFF000000~&
        DIM n AS INTEGER, i AS INTEGER, stp AS INTEGER, idx AS INTEGER
        DIM oldC(1 TO 256) AS _UNSIGNED LONG, newC(1 TO 256) AS _UNSIGNED LONG
        stp% = SGN(span%)
        FOR idx% = fromIdx% + stp% TO toIdx% - stp% STEP stp%
            n% = n% + 1
            oldC(n%) = PAL(idx%).value~&
            newC(n%) = DRAWER_gradient_lerp_color~&(c1~&, c2~&, (idx% - fromIdx%) / span%) OR &HFF000000~&
        NEXT idx%

        DIM rBefore AS STRING, owns AS INTEGER
        rBefore$ = PALETTE_snapshot$
        IF NOT HISTORY_IN_PROGRESS% _ANDALSO NOT HISTORY_GROUP_ACTIVE% THEN HISTORY_begin_group : owns% = TRUE
        i% = 0
        FOR idx% = fromIdx% + stp% TO toIdx% - stp% STEP stp%
            i% = i% + 1
            PAL(idx%).value~& = newC(i%)
        NEXT idx%
        PALETTE_OPS_remap_layers oldC(), newC(), n%, "Palette Ramp"
        HISTORY_record_palette rBefore$, PALETTE_snapshot$, "Palette Ramp"
        IF owns% THEN HISTORY_end_group
        PALETTE_OPS_mark_document_palette
        CANVAS_DIRTY% = TRUE
        SCENE_DIRTY%  = TRUE
        _LOGINFO "PALETTE_OPS: Ramp " + STR$(fromIdx%) + " ->" + STR$(toIdx%) + " (" + _TRIM$(STR$(n%)) + " colors)"
    END IF
    PALETTE_OPS_select toIdx%
END SUB


''
' Remap pixel colors on every visible layer in ONE pass: a pixel (alpha > 0)
' whose RGB is oldC(j) becomes newC(j)'s RGB with its own alpha (first match
' wins, so swaps and chains never cascade). Records a transform per changed
' layer; joins the caller's history group or opens its own.
'
SUB PALETTE_OPS_remap_layers (oldC() AS _UNSIGNED LONG, newC() AS _UNSIGNED LONG, n AS INTEGER, label AS STRING)
    IF n% < 1 THEN EXIT SUB
    DIM owns AS INTEGER
    IF NOT HISTORY_IN_PROGRESS% _ANDALSO NOT HISTORY_GROUP_ACTIVE% THEN HISTORY_begin_group : owns% = TRUE

    DIM li AS INTEGER, j AS INTEGER, changed AS INTEGER, before AS LONG
    DIM m AS _MEM, o AS _OFFSET, oEnd AS _OFFSET, px AS _UNSIGNED LONG, rgb AS _UNSIGNED LONG
    FOR li% = 1 TO MAX_LAYERS
        IF LAYERS(li%).imgHandle < -1 _ANDALSO LAYERS(li%).visible THEN
            before& = 0
            IF LAYERS(li%).historyId& > 0 THEN before& = _COPYIMAGE(LAYERS(li%).imgHandle, 32)
            changed% = FALSE
            m = _MEMIMAGE(LAYERS(li%).imgHandle)
            o = m.OFFSET : oEnd = m.OFFSET + m.SIZE
            DO WHILE o < oEnd
                _MEMGET m, o, px
                IF (px AND &HFF000000~&) <> 0 THEN
                    rgb~& = px AND &HFFFFFF
                    FOR j% = 1 TO n%
                        IF rgb~& = (oldC(j%) AND &HFFFFFF) THEN
                            IF rgb~& <> (newC(j%) AND &HFFFFFF) THEN
                                px = (px AND &HFF000000~&) OR (newC(j%) AND &HFFFFFF)
                                _MEMPUT m, o, px
                                changed% = TRUE
                            END IF
                            EXIT FOR
                        END IF
                    NEXT j%
                END IF
                o = o + 4
            LOOP
            _MEMFREE m
            IF changed% THEN
                LAYERS(li%).contentDirty = TRUE
                IF before& < -1 THEN HISTORY_record_transform LAYERS(li%).historyId&, li%, 0, before&, label$
            ELSE
                IF before& < -1 THEN _FREEIMAGE before&
            END IF
        END IF
    NEXT li%

    IF owns% THEN HISTORY_end_group
    HISTORY_saved_this_frame% = TRUE
    BLEND_invalidate_cache
END SUB


''
' Find closest palette color excluding a specific index.
' Used for nearest-neighbor remapping when deleting a color.
'
FUNCTION PAL_find_closest_excluding% (c AS _UNSIGNED LONG, excludeIdx AS INTEGER)
    DIM fi       AS INTEGER
    DIM fr       AS INTEGER, fg AS INTEGER, fb AS INTEGER
    DIM fpr      AS INTEGER, fpg AS INTEGER, fpb AS INTEGER
    DIM fdr      AS INTEGER, fdg AS INTEGER, fdb AS INTEGER
    DIM fdist    AS LONG, fmin_dist AS LONG
    DIM fclosest AS INTEGER

    fr% = _RED32(c~&)
    fg% = _GREEN32(c~&)
    fb% = _BLUE32(c~&)

    fclosest%  = -1
    fmin_dist& = 2147483647

    FOR fi% = 0 TO PAL_COLOR_COUNT% - 1
        IF fi% = excludeIdx% THEN _CONTINUE
        fpr%   = _RED32(PAL(fi%).value~&)
        fpg%   = _GREEN32(PAL(fi%).value~&)
        fpb%   = _BLUE32(PAL(fi%).value~&)
        fdr%   = fr% - fpr%
        fdg%   = fg% - fpg%
        fdb%   = fb% - fpb%
        fdist& = fdr% * fdr% + fdg% * fdg% + fdb% * fdb%
        IF fdist& < fmin_dist& THEN
            fmin_dist& = fdist&
            fclosest%  = fi%
        END IF
    NEXT fi%

    IF fclosest% < 0 THEN fclosest% = 0
    PAL_find_closest_excluding% = fclosest%
END FUNCTION
