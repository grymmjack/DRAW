''
' DRAW - GUI/BUTTON-LIST.BM
' =============================================================================
' Button lists for the toolbox and the bars (see BUTTON-LIST.BI).
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE


''
' Build panel's list the first time it is used (its default).
SUB BL_ensure (panel AS INTEGER)
    IF panel < 1 _ORELSE panel > BL_PANELS THEN EXIT SUB
    IF BL_READY(panel) = 0 THEN BL_set_default panel
END SUB


SUB BL_clear (panel AS INTEGER)
    BL_N(panel) = 0
    BL_READY(panel) = TRUE
END SUB


''
' Append an entry; FALSE when the list is full.
FUNCTION BL_add% (panel AS INTEGER, kind AS INTEGER, id AS INTEGER)
    DIM n AS INTEGER
    n = BL_N(panel)
    IF n >= BL_MAX THEN EXIT FUNCTION
    BL(panel, n).kind = kind: BL(panel, n).id = id
    BL(panel, n).x = 0: BL(panel, n).y = 0: BL(panel, n).w = 0: BL(panel, n).h = 0
    BL_N(panel) = n + 1
    BL_add% = TRUE
END FUNCTION


''
' Insert an entry at position at (0 = first; at >= count appends). FALSE when full.
FUNCTION BL_insert% (panel AS INTEGER, at AS INTEGER, kind AS INTEGER, id AS INTEGER)
    DIM i AS INTEGER, p AS INTEGER
    IF BL_N(panel) >= BL_MAX THEN EXIT FUNCTION
    p = at
    IF p < 0 THEN p = 0
    IF p > BL_N(panel) THEN p = BL_N(panel)
    FOR i = BL_N(panel) TO p + 1 STEP -1
        BL(panel, i) = BL(panel, i - 1)
    NEXT i
    BL(panel, p).kind = kind: BL(panel, p).id = id
    BL(panel, p).x = 0: BL(panel, p).y = 0: BL(panel, p).w = 0: BL(panel, p).h = 0
    BL_N(panel) = BL_N(panel) + 1
    BL_insert% = TRUE
END FUNCTION


SUB BL_remove (panel AS INTEGER, at AS INTEGER)
    DIM i AS INTEGER
    IF at < 0 _ORELSE at >= BL_N(panel) THEN EXIT SUB
    FOR i = at TO BL_N(panel) - 2
        BL(panel, i) = BL(panel, i + 1)
    NEXT i
    BL_N(panel) = BL_N(panel) - 1
END SUB


''
' Position of the first entry (kind, id) in panel, -1 = not there.
FUNCTION BL_find% (panel AS INTEGER, kind AS INTEGER, id AS INTEGER)
    DIM i AS INTEGER
    BL_find% = -1
    BL_ensure panel
    FOR i = 0 TO BL_N(panel) - 1
        IF BL(panel, i).kind = kind _ANDALSO BL(panel, i).id = id THEN BL_find% = i: EXIT FUNCTION
    NEXT i
END FUNCTION


''
' Today's fixed layout: the edit / advanced bar tables (dividers kept), the
' toolbox's default grid (an empty cell stays a gap), the PANELS / I/O bars'
' lists (CBAR_set_default).
SUB BL_set_default (panel AS INTEGER)
    DIM i AS INTEGER, ok AS INTEGER
    BL_clear panel
    SELECT CASE panel
        CASE BL_EDITBAR
            FOR i = 0 TO EDITBAR_TOTAL_SLOTS - 1
                IF EDIT_BAR_ITEMS(i).isDivider% THEN ok = BL_add%(panel, BL_DIV, 0) ELSE ok = BL_add%(panel, BL_CMD, EDIT_BAR_ITEMS(i).actionID%)
            NEXT i
        CASE BL_ADVBAR
            FOR i = 0 TO ADVBAR_TOTAL_SLOTS - 1
                IF ADV_BAR_ITEMS(i).isDivider% THEN ok = BL_add%(panel, BL_DIV, 0) ELSE ok = BL_add%(panel, BL_CMD, ADV_BAR_ITEMS(i).actionID%)
            NEXT i
        CASE BL_TOOLBOX
            FOR i = 0 TO TB_TOTAL - 1
                IF TOOLBAR_DEF_ORDER(i) < 0 THEN ok = BL_add%(panel, BL_GAP, 0) ELSE ok = BL_add%(panel, BL_TOOL, TOOLBAR_DEF_ORDER(i))
            NEXT i
        CASE BL_PANELSBAR, BL_IOBAR: CBAR_set_default panel ' (GUI/CMDBARS)
    END SELECT
END SUB


' =============================================================================
' The command icon catalog: the bars' tables, by action id
' =============================================================================

''
' The icon of command act (disabled = its dimmed copy); 0 = it has none (a text
' tile then). Loads the bars' icons on first use.
FUNCTION BL_cmd_icon& (act AS INTEGER, disabled AS INTEGER)
    DIM i AS INTEGER
    IF act = 0 THEN EXIT FUNCTION
    IF EDIT_BAR.iconsLoaded% = 0 THEN EDITBAR_load_icons
    IF ADV_BAR.iconsLoaded% = 0 THEN ADVBAR_load_icons
    FOR i = 0 TO EDITBAR_TOTAL_SLOTS - 1
        IF EDIT_BAR_ITEMS(i).isDivider% = 0 _ANDALSO EDIT_BAR_ITEMS(i).actionID% = act THEN
            IF disabled _ANDALSO EDIT_BAR_ITEMS(i).disabledHandle& < -1 THEN BL_cmd_icon& = EDIT_BAR_ITEMS(i).disabledHandle& ELSE BL_cmd_icon& = EDIT_BAR_ITEMS(i).iconHandle&
            EXIT FUNCTION
        END IF
    NEXT i
    FOR i = 0 TO ADVBAR_TOTAL_SLOTS - 1
        IF ADV_BAR_ITEMS(i).isDivider% = 0 _ANDALSO ADV_BAR_ITEMS(i).actionID% = act THEN
            IF disabled _ANDALSO ADV_BAR_ITEMS(i).disabledHandle& < -1 THEN BL_cmd_icon& = ADV_BAR_ITEMS(i).disabledHandle& ELSE BL_cmd_icon& = ADV_BAR_ITEMS(i).iconHandle&
            EXIT FUNCTION
        END IF
    NEXT i
    ' no bar icon: the theme's command art, if it has some
    BL_cmd_icon& = BL_cmd_file_icon&(act, 0, disabled)
END FUNCTION


''
' A command's file name stem for theme art: its name in lower case, words
' joined by - ("New Layer" -> new-layer); cmd-<id> when it has no name.
' The AI commands are registered only while AI is on (MENUBAR_init), so with it
' off they have no name - and a toolbox / bar button holding one lost its art to
' the cmd-<id> text tile (Rick 2026-11-20, after --reset-defaults put
' AI_ENABLED=0). Their art names are fixed here instead.
FUNCTION BL_cmd_slug$ (act AS INTEGER)
    DIM t AS STRING, s AS STRING, i AS INTEGER, ch AS STRING
    SELECT CASE act
        CASE 1820, 1825: BL_cmd_slug$ = "new-from-ai": EXIT FUNCTION
        CASE 1821: BL_cmd_slug$ = "regenerate-layer": EXIT FUNCTION
        CASE 1822: BL_cmd_slug$ = "cancel-generation": EXIT FUNCTION
        CASE 1823: BL_cmd_slug$ = "tools": EXIT FUNCTION
        CASE 1827: BL_cmd_slug$ = "style-editor": EXIT FUNCTION
        CASE 1828: BL_cmd_slug$ = "prompt-editor": EXIT FUNCTION
    END SELECT
    t = LCASE$(BL_cmd_label$(act))
    FOR i = 1 TO LEN(t)
        ch = MID$(t, i, 1)
        IF (ch >= "a" _ANDALSO ch <= "z") _ORELSE (ch >= "0" _ANDALSO ch <= "9") THEN
            s = s + ch
        ELSEIF LEN(s) _ANDALSO RIGHT$(s, 1) <> "-" THEN
            s = s + "-"
        END IF
    NEXT i
    DO WHILE RIGHT$(s, 1) = "-": s = LEFT$(s, LEN(s) - 1): LOOP
    IF LEN(s) = 0 THEN s = "cmd-" + _TRIM$(STR$(act))
    BL_cmd_slug$ = s
END FUNCTION


''
' Theme art for command act (kind 0 = 16px, 1 = toolbox 11px); 0 = none.
FUNCTION BL_cmd_file_icon& (act AS INTEGER, kind AS INTEGER, disabled AS INTEGER)
    DIM i AS INTEGER, img AS LONG, dimg AS LONG, subDir AS STRING, f AS STRING, th AS STRING, nm AS STRING, k AS INTEGER
    IF act <= 0 THEN EXIT FUNCTION
    FOR i = 0 TO BL_FICON_N - 1
        IF BL_FICON_ACT(i) = act _ANDALSO BL_FICON_KIND(i) = kind THEN
            IF disabled _ANDALSO BL_FICON_DIM(i) < -1 THEN BL_cmd_file_icon& = BL_FICON_DIM(i) ELSE BL_cmd_file_icon& = BL_FICON_IMG(i)
            EXIT FUNCTION
        END IF
    NEXT i
    IF BL_FICON_N >= BL_FICON_MAX THEN EXIT FUNCTION
    IF kind = 1 THEN subDir = "/IMAGES/COMMANDS/TOOLBOX/" ELSE subDir = "/IMAGES/COMMANDS/"
    th = _TRIM$(CFG.THEME$)
    FOR k = 1 TO 4
        SELECT CASE k
            CASE 1: f = "ASSETS/THEMES/" + th + subDir + BL_cmd_slug$(act) + ".png"
            CASE 2: f = "ASSETS/THEMES/" + th + subDir + "cmd-" + _TRIM$(STR$(act)) + ".png"
            CASE 3: f = "ASSETS/THEMES/DEFAULT" + subDir + BL_cmd_slug$(act) + ".png"
            CASE 4: f = "ASSETS/THEMES/DEFAULT" + subDir + "cmd-" + _TRIM$(STR$(act)) + ".png"
        END SELECT
        IF _FILEEXISTS(f) THEN nm = f: EXIT FOR
    NEXT k
    IF LEN(nm) THEN
        img = _LOADIMAGE(nm, 32)
        IF img < -1 THEN
            dimg = _COPYIMAGE(img)
            BL_dim_image dimg
        ELSE
            _LOGWARN "Command icon " + nm + " could not be loaded"
            img = 0
        END IF
    END IF
    BL_FICON_ACT(BL_FICON_N) = act: BL_FICON_KIND(BL_FICON_N) = kind
    BL_FICON_IMG(BL_FICON_N) = img: BL_FICON_DIM(BL_FICON_N) = dimg
    BL_FICON_N = BL_FICON_N + 1
    IF disabled _ANDALSO dimg < -1 THEN BL_cmd_file_icon& = dimg ELSE BL_cmd_file_icon& = img
END FUNCTION


''
' The tooltip of command act: its bar tooltip (the tables are keyed by the bar
' slot it has by default), else its command name and hotkey. An AI command
' while AI features are off says how to turn it on instead of line 2.
SUB BL_cmd_tooltip (act AS INTEGER, line1 AS STRING, line2 AS STRING)
    DIM i AS INTEGER
    line1 = "": line2 = ""
    FOR i = 0 TO EDITBAR_TOTAL_SLOTS - 1
        IF EDIT_BAR_ITEMS(i).isDivider% = 0 _ANDALSO EDIT_BAR_ITEMS(i).actionID% = act THEN
            line1 = TOOLTIP_EB_LINE1$(i): line2 = TOOLTIP_EB_LINE2$(i)
            EXIT FOR
        END IF
    NEXT i
    IF LEN(line1) = 0 THEN
        FOR i = 0 TO ADVBAR_TOTAL_SLOTS - 1
            IF ADV_BAR_ITEMS(i).isDivider% = 0 _ANDALSO ADV_BAR_ITEMS(i).actionID% = act THEN
                line1 = TOOLTIP_AB_LINE1$(i): line2 = TOOLTIP_AB_LINE2$(i)
                EXIT FOR
            END IF
        NEXT i
    END IF
    IF LEN(line1) = 0 THEN
        line1 = UCASE$(BL_cmd_label$(act))
        IF LEN(BL_cmd_hotkey$(act)) THEN line1 = UCASE$(BL_cmd_hotkey$(act)) + " - " + line1
    END IF
    IF act = 1820 THEN line1 = "GENERATE WITH AI" ' the toolbox button (Rick 2026-11-22)
    IF BL_cmd_ai_off%(act) THEN
        ' AI off: the AI menu is not built, so the menu lookup finds no name
        IF LEN(line1) = 0 THEN
            SELECT CASE act
                CASE 1821: line1 = "REGENERATE LAYER"
                CASE 1822: line1 = "CANCEL GENERATION"
                CASE 1823: line1 = "AI TOOLS"
                CASE 1825: line1 = "NEW FROM AI"
                CASE 1826: line1 = "EDIT AI PROMPT"
                CASE 1827: line1 = "AI STYLE EDITOR"
                CASE 1828: line1 = "AI PROMPT EDITOR"
            END SELECT
        END IF
        line2 = "TO ENABLE THIS BUTTON, ENABLE AI FEATURES"
    END IF
END SUB


''
' The command palette's name for action act, else its menu label ("" when it
' has neither).
FUNCTION BL_cmd_label$ (act AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO UBOUND(CMD_LIST)
        IF CMD_LIST(i).action_id = act _ANDALSO LEN(_TRIM$(CMD_LIST(i).name)) THEN BL_cmd_label$ = _TRIM$(CMD_LIST(i).name): EXIT FUNCTION
    NEXT i
    i = BL_menu_item%(act)
    IF i >= 0 THEN BL_cmd_label$ = _TRIM$(MENU_ITEMS(i).label)
END FUNCTION


FUNCTION BL_cmd_hotkey$ (act AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO UBOUND(CMD_LIST)
        IF CMD_LIST(i).action_id = act _ANDALSO LEN(_TRIM$(CMD_LIST(i).name)) THEN BL_cmd_hotkey$ = BINDINGS_hotkey$(act, _TRIM$(CMD_LIST(i).hotkey)): EXIT FUNCTION
    NEXT i
    i = BL_menu_item%(act)
    IF i >= 0 THEN BL_cmd_hotkey$ = BINDINGS_hotkey$(act, _TRIM$(MENU_ITEMS(i).hotkey))
END FUNCTION


''
' The menu row that runs action act (-1 = none): commands the palette does
' not list (Paste in Place, Flip Horizontal, ...) are named by their menu.
FUNCTION BL_menu_item% (act AS INTEGER)
    DIM i AS INTEGER
    BL_menu_item% = -1
    IF act <= 0 THEN EXIT FUNCTION
    FOR i = 0 TO MENU_ITEM_COUNT - 1
        IF MENU_ITEMS(i).actionId = act _ANDALSO MENU_ITEMS(i).isDivider = 0 _ANDALSO MENU_ITEMS(i).hasSubmenu = 0 THEN BL_menu_item% = i: EXIT FUNCTION
    NEXT i
END FUNCTION


' =============================================================================
' Names (workspace files)
' =============================================================================

''
' A toolbox tool's name (move, hand, ...), "" = none.
FUNCTION BL_tool_name$ (btn AS INTEGER)
    DIM slot AS INTEGER
    slot = TOOLBAR_default_slot%(btn)
    IF slot >= 0 THEN BL_tool_name$ = WS_list_item$(WSC_TB_NAMES$, slot + 1)
END FUNCTION


''
' An entry's name in a workspace list.
FUNCTION BL_entry_name$ (kind AS INTEGER, id AS INTEGER)
    DIM nm AS STRING
    SELECT CASE kind
        CASE BL_DIV: nm = "|"
        CASE BL_GAP: nm = "-"
        CASE BL_TOOL: nm = BL_tool_name$(id)
        CASE BL_CMD
            nm = WS_editbar_name$(id)
            IF LEN(nm) = 0 THEN nm = WS_advbar_name$(id)
            IF LEN(nm) = 0 THEN nm = "cmd:" + _TRIM$(STR$(id))
    END SELECT
    BL_entry_name$ = nm
END FUNCTION


''
' A name in a workspace list -> kind, id. FALSE when unknown. A bare number is
' a command's action id (as the bar lists always allowed).
FUNCTION BL_parse_name% (nm AS STRING, kind AS INTEGER, id AS INTEGER)
    DIM n AS STRING, i AS INTEGER, btn AS INTEGER, tool AS INTEGER
    n = LCASE$(_TRIM$(nm))
    kind = 0: id = 0
    IF LEN(n) = 0 THEN EXIT FUNCTION
    SELECT CASE n
        CASE "|", "divider": kind = BL_DIV: BL_parse_name% = TRUE: EXIT FUNCTION
        CASE "-", "gap", "space": kind = BL_GAP: BL_parse_name% = TRUE: EXIT FUNCTION
    END SELECT
    IF LEFT$(n, 4) = "cmd:" THEN
        id = VAL(MID$(n, 5))
        IF id > 0 THEN kind = BL_CMD: BL_parse_name% = TRUE
        EXIT FUNCTION
    END IF
    IF VAL(n) > 0 _ANDALSO LTRIM$(STR$(VAL(n))) = n THEN kind = BL_CMD: id = VAL(n): BL_parse_name% = TRUE: EXIT FUNCTION
    ' a bar button's name
    i = BL_bar_cmd_by_name%(n)
    IF i THEN kind = BL_CMD: id = i: BL_parse_name% = TRUE: EXIT FUNCTION
    ' a toolbox tool's name
    IF TOOLBAR_button_by_name%(n, btn, tool) THEN
        IF btn >= 0 THEN kind = BL_TOOL: id = btn: BL_parse_name% = TRUE
    END IF
END FUNCTION


''
' The action of the bar button named nm (undo, preview, ...), 0 = none.
FUNCTION BL_bar_cmd_by_name% (nm AS STRING)
    DIM i AS INTEGER, n AS STRING
    n = LCASE$(_TRIM$(nm))
    FOR i = 0 TO EDITBAR_TOTAL_SLOTS - 1
        IF EDIT_BAR_ITEMS(i).isDivider% = 0 _ANDALSO WS_editbar_name$(EDIT_BAR_ITEMS(i).actionID%) = n THEN BL_bar_cmd_by_name% = EDIT_BAR_ITEMS(i).actionID%: EXIT FUNCTION
    NEXT i
    FOR i = 0 TO ADVBAR_TOTAL_SLOTS - 1
        IF ADV_BAR_ITEMS(i).isDivider% = 0 _ANDALSO WS_advbar_name$(ADV_BAR_ITEMS(i).actionID%) = n THEN BL_bar_cmd_by_name% = ADV_BAR_ITEMS(i).actionID%: EXIT FUNCTION
    NEXT i
END FUNCTION


''
' Panel's list as a workspace list ("undo,redo,|,cut,...").
FUNCTION BL_to_csv$ (panel AS INTEGER)
    DIM i AS INTEGER, r AS STRING
    BL_ensure panel
    FOR i = 0 TO BL_N(panel) - 1
        IF i > 0 THEN r = r + ","
        r = r + BL_entry_name$(BL(panel, i).kind, BL(panel, i).id)
    NEXT i
    BL_to_csv$ = r
END FUNCTION


''
' Replace panel's list with a workspace list; unknown names are skipped (and
' logged). Returns how many entries it has.
FUNCTION BL_from_csv% (panel AS INTEGER, csv AS STRING)
    DIM i AS INTEGER, kind AS INTEGER, id AS INTEGER, ok AS INTEGER, it AS STRING
    BL_clear panel
    FOR i = 1 TO WS_list_count%(csv)
        it = WS_list_item$(csv, i)
        IF BL_parse_name%(it, kind, id) THEN
            ok = BL_add%(panel, kind, id)
        ELSEIF LEN(_TRIM$(it)) THEN
            _LOGWARN "Button list: unknown button '" + _TRIM$(it) + "' skipped"
        END IF
    NEXT i
    BL_from_csv% = BL_N(panel)
END FUNCTION


' =============================================================================
' The bars: lay out, draw, hit-test and click from the lists
' =============================================================================

''
' A command button is lit (not dimmed): the bars' availability rules (each is
' TRUE for the commands it does not know; the PANELS bar's: its panel shows),
' and not an AI command while AI features are off.
FUNCTION BL_cmd_enabled% (act AS INTEGER)
    BL_cmd_enabled% = (EDITBAR_action_enabled%(act) <> 0) _ANDALSO (ADVBAR_action_enabled%(act) <> 0) _ANDALSO (CBAR_action_enabled%(act) <> 0) _ANDALSO (BL_cmd_ai_off%(act) = 0)
END FUNCTION


''
' Command act is an AI command (New AI Layer, New from AI, Regenerate, ...) and
' AI features are off (Settings > ENABLE AI FEATURES), so it does nothing -
' COMMAND.BM gates each of these on CFG.AI_ENABLED. 1824 (the on/off toggle)
' always works.
FUNCTION BL_cmd_ai_off% (act AS INTEGER)
    SELECT CASE act
        CASE 1820 TO 1823, 1825 TO 1828: BL_cmd_ai_off% = (CFG.AI_ENABLED% = 0)
    END SELECT
END FUNCTION


''
' A bar command can be used right now. "Lit" (BL_cmd_enabled%) is a toggle's
' ON state - an OFF toggle is drawn dim but still answers hover (outline +
' sound) and clicks; only an unavailable command (nothing to undo, no reference
' loaded, ...) is inert (BUGS.md 2026-11-15).
FUNCTION BL_cmd_available% (act AS INTEGER)
    SELECT CASE act
        CASE 301: BL_cmd_available% = HISTORY_can_undo%
        CASE 302: BL_cmd_available% = HISTORY_can_redo%
        CASE 305, 312: BL_cmd_available% = CLIPBOARD.VALID
        CASE 324: BL_cmd_available% = SELECTION_has_active%
        CASE 1503, 1504: BL_cmd_available% = (REFIMG.IMAGE < -1)
        CASE 1907, 1908: BL_cmd_available% = (MULTI_SELECT_COUNT% >= 2)
        CASE 907: BL_cmd_available% = GRID.SHOW%
        CASE 1820 TO 1823, 1825 TO 1828: BL_cmd_available% = (BL_cmd_ai_off%(act) = 0)
        CASE ELSE: BL_cmd_available% = TRUE
    END SELECT
END FUNCTION


''
' A bar's scroll offset kept within 0..(content height - visible height).
FUNCTION BL_scroll_clamp% (offset AS INTEGER, contentH AS INTEGER, viewH AS INTEGER)
    DIM maxOff AS INTEGER
    maxOff = contentH - viewH
    IF maxOff < 0 THEN maxOff = 0
    BL_scroll_clamp% = offset
    IF offset > maxOff THEN BL_scroll_clamp% = maxOff
    IF offset < 0 THEN BL_scroll_clamp% = 0
END FUNCTION


''
' Lay out and draw a bar's buttons inside its inner area (x1, width w) between
' y1 and y2, scrolled up by scrollOff px, in cols icon columns (more when the
' area is wider: the column flow). Icons flow left to right; a divider ends
' the row. Only whole icons are drawn. Records each entry's rect for
' BL_bar_hit%. Returns the content height (for scrolling).
FUNCTION BL_bar_draw% (panel AS INTEGER, x1 AS INTEGER, w AS INTEGER, y1 AS INTEGER, y2 AS INTEGER, scrollOff AS INTEGER, cols AS INTEGER, hoverIdx AS INTEGER)
    DIM i AS INTEGER, padding AS INTEGER, curY AS INTEGER, contentH AS INTEGER
    DIM barCols AS INTEGER, barColW AS INTEGER, colK AS INTEGER, rowH AS INTEGER
    DIM img AS LONG, dimg AS LONG, iconW AS INTEGER, iconH AS INTEGER, iconX AS INTEGER, lit AS INTEGER
    DIM divPx AS INTEGER, lineY AS INTEGER
    IF BL_HROWS(panel) > 0 THEN BL_bar_draw% = BL_bar_draw_h%(panel, x1, w, y1, y2, hoverIdx): EXIT FUNCTION
    BL_ensure panel
    padding = THEME.ICON_BAR_padding%
    curY = y1 + 1 + padding - scrollOff ' just below the top edge
    barColW = THEME.ICON_BAR_width%
    barCols = cols
    IF barColW > 0 _ANDALSO w \ barColW > barCols THEN barCols = w \ barColW
    IF barCols < 1 THEN barCols = 1
    FOR i = 0 TO BL_N(panel) - 1
        BL(panel, i).x = 0: BL(panel, i).y = 0: BL(panel, i).w = 0: BL(panel, i).h = 0
        IF BL(panel, i).kind = BL_DIV THEN
            IF colK > 0 THEN
                curY = curY + rowH + padding: contentH = contentH + rowH + padding
                colK = 0: rowH = 0
            END IF
            divPx = BL_div_px%(panel) ' (Customize Toolbars: DIVIDER - n +)
            ' SHOW DIVIDERS: a line in the middle of the space between the rows (padding + divider)
            IF BL_SHOWDIV(panel) _ANDALSO divPx + padding > 0 THEN
                lineY = curY - padding + (padding + divPx - 1) \ 2
                IF lineY >= y1 _ANDALSO lineY <= y2 THEN LINE (x1 + 2, lineY)-(x1 + w - 3, lineY), THEME.ICON_BAR_divider_fg~&
            END IF
            curY = curY + divPx
            contentH = contentH + divPx
            _CONTINUE
        END IF
        BL_entry_icon panel, i, img, dimg, iconW, iconH, lit
        iconX = x1 + colK * barColW + (barColW - iconW) \ 2
        IF iconH > rowH THEN rowH = iconH
        ' only whole icons: a partial one would spill past the panel's rect
        IF curY >= y1 _ANDALSO curY + iconH - 1 <= y2 THEN
            IF BL(panel, i).kind <> BL_GAP THEN
                BL_entry_draw panel, i, iconX, curY, img, dimg, iconW, iconH, lit, hoverIdx
            ELSEIF BL_SHOWGAP(panel) THEN
                BL_gap_outline iconX, curY, iconW, iconH, THEME.ICON_BAR_divider_fg~& ' SHOW GAPS
            END IF
        END IF
        colK = colK + 1
        IF colK >= barCols THEN
            curY = curY + rowH + padding: contentH = contentH + rowH + padding
            colK = 0: rowH = 0
        END IF
    NEXT i
    IF colK > 0 THEN contentH = contentH + rowH + padding
    BL_bar_draw% = contentH
END FUNCTION


''
' Entry i's icon (a tool's is its 11px toolbox button in a 16px cell; a command
' without an icon gets its text tile), its dimmed twin, size and lit state.
SUB BL_entry_icon (panel AS INTEGER, i AS INTEGER, img AS LONG, dimg AS LONG, iconW AS INTEGER, iconH AS INTEGER, lit AS INTEGER)
    img = 0: dimg = 0: lit = TRUE
    IF BL(panel, i).kind = BL_TOOL THEN img = BL_tool_icon&(BL(panel, i).id)
    IF BL(panel, i).kind = BL_CMD THEN
        img = BL_cmd_icon&(BL(panel, i).id, FALSE)
        dimg = BL_cmd_icon&(BL(panel, i).id, TRUE)
        IF img >= -1 THEN img = BL_cmd_tile&(BL(panel, i).id, FALSE): dimg = BL_cmd_tile&(BL(panel, i).id, TRUE) ' no icon: its text tile
        lit = BL_cmd_enabled%(BL(panel, i).id)
    END IF
    IF img < -1 _ANDALSO BL(panel, i).kind <> BL_TOOL THEN
        iconW = _WIDTH(img): iconH = _HEIGHT(img)
    ELSE
        iconW = 16: iconH = 16
    END IF
END SUB


''
' Draw entry i at (iconX, iconY) and record its rect for BL_bar_hit%.
SUB BL_entry_draw (panel AS INTEGER, i AS INTEGER, iconX AS INTEGER, iconY AS INTEGER, img AS LONG, dimg AS LONG, iconW AS INTEGER, iconH AS INTEGER, lit AS INTEGER, hoverIdx AS INTEGER)
    BL(panel, i).x = iconX: BL(panel, i).y = iconY: BL(panel, i).w = iconW: BL(panel, i).h = iconH
    IF BL(panel, i).kind = BL_TOOL THEN
        BL_draw_tool_button BL(panel, i).id, iconX, iconY
    ELSEIF lit = 0 _ANDALSO dimg < -1 THEN
        _PUTIMAGE (iconX, iconY), dimg
    ELSEIF img < -1 THEN
        _PUTIMAGE (iconX, iconY), img
    END IF
    ' a command that picks a tool: pushed while that is the tool, like a tool button
    IF BL(panel, i).kind = BL_CMD _ANDALSO CMD_tool_on%(BL(panel, i).id) THEN
        LINE (iconX, iconY)-(iconX + iconW - 1, iconY + iconH - 1), THEME.ICON_BAR_button_on_bg~&, BF
        LINE (iconX, iconY)-(iconX + iconW - 1, iconY + iconH - 1), THEME.ICON_BAR_button_on_border~&, B
    END IF
    ' the shared Edge-Mode button shows "AA" when its target is Anti-Aliasing
    IF i = hoverIdx _ANDALSO BL_entry_lit%(panel, i) THEN LINE (iconX - 1, iconY - 1)-(iconX + iconW, iconY + iconH), THEME.ICON_BAR_button_hover_border~&, B
END SUB


''
' A bar in a top / bottom dock row (BL_HROWS): its icons sideways - rows of
' BL_hbar_cell_h% from the top, a column fills down then the next one starts.
' One even grid by default: dividers and gaps take no room here, so every column
' is full and the icons line up (Rick 2026-11-16: "aligned and stacked
' horizontally without breaks and weird columns"). With the panel's SHOW
' DIVIDERS on (Customize Toolbars) a divider ends the icon column, takes its
' DIVIDER size and draws a line down it; with SHOW GAPS on a gap takes a cell,
' outlined (Rick 2026-11-23: they showed no difference in a top row).
' BL_hbar_span% follows the same rules for the width. Only whole icons are
' drawn. No scrolling (the dock gives it the width its columns need): returns
' the rect's height.
FUNCTION BL_bar_draw_h% (panel AS INTEGER, x1 AS INTEGER, w AS INTEGER, y1 AS INTEGER, y2 AS INTEGER, hoverIdx AS INTEGER)
    DIM i AS INTEGER, k AS INTEGER, rws AS INTEGER, colX AS INTEGER, colW AS INTEGER, cellH AS INTEGER, iconY AS INTEGER
    DIM img AS LONG, dimg AS LONG, iconW AS INTEGER, iconH AS INTEGER, iconX AS INTEGER, lit AS INTEGER
    DIM sp AS INTEGER, lineX AS INTEGER, topY AS INTEGER, botY AS INTEGER
    BL_ensure panel
    rws = BL_HROWS(panel): IF rws < 1 THEN rws = 1
    colW = THEME.ICON_BAR_width%: IF colW < 1 THEN colW = 20
    cellH = BL_hbar_cell_h%
    topY = y1 + 1 + THEME.ICON_BAR_padding%
    botY = topY + rws * cellH - THEME.ICON_BAR_padding% - 1: IF botY > y2 THEN botY = y2
    colX = x1
    FOR i = 0 TO BL_N(panel) - 1
        BL(panel, i).x = 0: BL(panel, i).y = 0: BL(panel, i).w = 0: BL(panel, i).h = 0
        IF BL(panel, i).kind = BL_DIV THEN
            IF BL_SHOWDIV(panel) = 0 _ORELSE i = BL_N(panel) - 1 THEN _CONTINUE
            IF k > 0 THEN colX = colX + colW: k = 0
            sp = BL_hbar_div_w%(panel)
            lineX = colX + (sp - 1) \ 2
            IF lineX <= x1 + w - 1 THEN LINE (lineX, topY)-(lineX, botY), THEME.ICON_BAR_divider_fg~&
            colX = colX + sp
            _CONTINUE
        END IF
        IF BL(panel, i).kind = BL_GAP _ANDALSO BL_SHOWGAP(panel) = 0 THEN _CONTINUE
        BL_entry_icon panel, i, img, dimg, iconW, iconH, lit
        iconX = colX + (colW - iconW) \ 2
        iconY = topY + k * cellH
        IF iconX + iconW - 1 <= x1 + w - 1 _ANDALSO iconY + iconH - 1 <= y2 THEN
            IF BL(panel, i).kind = BL_GAP THEN
                BL_gap_outline iconX, iconY, iconW, iconH, THEME.ICON_BAR_divider_fg~&
            ELSE
                BL_entry_draw panel, i, iconX, iconY, img, dimg, iconW, iconH, lit, hoverIdx
            END IF
        END IF
        k = k + 1
        IF k >= rws THEN colX = colX + colW: k = 0
    NEXT i
    BL_bar_draw_h% = y2 - y1 + 1
END FUNCTION


''
' The room a shown divider takes across a sideways bar: its DIVIDER size, at
' least 1 px for its line.
FUNCTION BL_hbar_div_w% (panel AS INTEGER)
    DIM sp AS INTEGER
    sp = BL_div_px%(panel): IF sp < 1 THEN sp = 1
    BL_hbar_div_w% = sp
END FUNCTION


''
' Width of a sideways bar's content with rws icon rows: its icon columns, and
' with SHOW DIVIDERS / SHOW GAPS on the dividers' room and the gaps' cells
' (the rules of BL_bar_draw_h%).
FUNCTION BL_hbar_span% (panel AS INTEGER, rws AS INTEGER)
    DIM i AS INTEGER, k AS INTEGER, r AS INTEGER, colW AS INTEGER, tot AS INTEGER
    r = rws: IF r < 1 THEN r = 1
    colW = THEME.ICON_BAR_width%: IF colW < 1 THEN colW = 20
    FOR i = 0 TO BL_N(panel) - 1
        IF BL(panel, i).kind = BL_DIV THEN
            IF BL_SHOWDIV(panel) = 0 _ORELSE i = BL_N(panel) - 1 THEN _CONTINUE
            IF k > 0 THEN tot = tot + colW: k = 0
            tot = tot + BL_hbar_div_w%(panel)
            _CONTINUE
        END IF
        IF BL(panel, i).kind = BL_GAP _ANDALSO BL_SHOWGAP(panel) = 0 THEN _CONTINUE
        k = k + 1
        IF k >= r THEN tot = tot + colW: k = 0
    NEXT i
    IF k > 0 THEN tot = tot + colW
    BL_hbar_span% = tot
END FUNCTION


''
' One icon row of a sideways bar (px): an icon and its padding.
FUNCTION BL_hbar_cell_h% ()
    BL_hbar_cell_h% = 16 + THEME.ICON_BAR_padding%
END FUNCTION


''
' Height of a sideways bar with rws icon rows (its top / bottom edge rows too).
FUNCTION BL_hbar_h% (rws AS INTEGER)
    BL_hbar_h% = 2 + THEME.ICON_BAR_padding% + rws * BL_hbar_cell_h%
END FUNCTION


''
' The icon rows a sideways bar h px tall holds (at least 1).
FUNCTION BL_hbar_rows_fit% (h AS INTEGER)
    DIM r AS INTEGER
    r = (h - 2 - THEME.ICON_BAR_padding%) \ BL_hbar_cell_h%
    IF r < 1 THEN r = 1
    BL_hbar_rows_fit% = r
END FUNCTION


''
' Width of a sideways bar (borders included) with rws icon rows: the columns
' BL_bar_draw_h% fills (BL_hbar_span%: its buttons, plus divider / gap room
' when the panel shows them).
FUNCTION BL_hbar_w% (panel AS INTEGER, rws AS INTEGER)
    DIM tot AS INTEGER
    BL_ensure panel
    tot = BL_hbar_span%(panel, rws)
    BL_hbar_w% = tot + THEME.ICON_BAR_border_left_width% + THEME.ICON_BAR_border_right_width%
END FUNCTION


''
' The bar entry (a button) under (mx, my), -1 = none.
FUNCTION BL_bar_hit% (panel AS INTEGER, mx AS INTEGER, my AS INTEGER)
    DIM i AS INTEGER
    BL_bar_hit% = -1
    FOR i = 0 TO BL_N(panel) - 1
        IF BL(panel, i).w > 0 _ANDALSO (BL(panel, i).kind = BL_CMD _ORELSE BL(panel, i).kind = BL_TOOL) THEN
            IF mx >= BL(panel, i).x _ANDALSO mx < BL(panel, i).x + BL(panel, i).w _ANDALSO my >= BL(panel, i).y _ANDALSO my < BL(panel, i).y + BL(panel, i).h THEN BL_bar_hit% = i: EXIT FUNCTION
        END IF
    NEXT i
END FUNCTION


''
' Entry i of panel is lit (hover sound / outline): a lit command, or a tool.
FUNCTION BL_entry_lit% (panel AS INTEGER, i AS INTEGER)
    IF i < 0 _ORELSE i >= BL_N(panel) THEN EXIT FUNCTION
    SELECT CASE BL(panel, i).kind
        CASE BL_CMD: BL_entry_lit% = BL_cmd_available%(BL(panel, i).id) ' (an OFF toggle still hovers)
        CASE BL_TOOL: BL_entry_lit% = TRUE
    END SELECT
END FUNCTION


''
' A click on entry i of panel.
SUB BL_bar_click (panel AS INTEGER, i AS INTEGER)
    IF i < 0 _ORELSE i >= BL_N(panel) THEN EXIT SUB
    SELECT CASE BL(panel, i).kind
        CASE BL_CMD
            ' Angle Snap (Degrees, 414) is one half of a mode pair: the bar button
            ' toggles it - lit (degrees) -> Pixel Art (415) - instead of setting
            ' degrees again, which made it impossible to turn off
            IF BL(panel, i).id = 414 _ANDALSO CFG.ANGLE_SNAP_PIXEL_ART% = 0 THEN
                CMD_execute_action 415
            ELSE
                CMD_execute_action BL(panel, i).id
            END IF
        CASE BL_TOOL: IF TOOLBAR_activate_tool%(BL_tool_of%(BL(panel, i).id)) THEN MOUSE.UI_CHROME_CLICKED% = TRUE
    END SELECT
END SUB


' =============================================================================
' Text tiles (a command with no icon)
' =============================================================================

''
' Up to 3 letters for command act: its name's first word (after a leading
' TOGGLE / SHOW, and after a "Group: " prefix), its first letter then its next
' consonants (FLATTEN -> FLT, MERGE -> MRG); short words borrow the next words'
' initials.
FUNCTION BL_tile_text$ (act AS INTEGER)
    DIM nm AS STRING, w(1 TO 8) AS STRING, n AS INTEGER, i AS INTEGER, ch AS STRING, cur AS STRING, r AS STRING, k AS INTEGER, first AS INTEGER
    nm = UCASE$(BL_cmd_label$(act))
    k = INSTR(nm, ": ") ' "Annotate: Arrow" -> ARROW, so a group's tiles differ
    IF k > 0 _ANDALSO k < LEN(nm) - 1 THEN nm = MID$(nm, k + 2)
    IF LEN(nm) = 0 THEN BL_tile_text$ = LEFT$(_TRIM$(STR$(act)), 3): EXIT FUNCTION
    FOR i = 1 TO LEN(nm) + 1
        IF i <= LEN(nm) THEN ch = MID$(nm, i, 1) ELSE ch = " "
        IF (ch >= "A" _ANDALSO ch <= "Z") _ORELSE (ch >= "0" _ANDALSO ch <= "9") THEN
            cur = cur + ch
        ELSEIF LEN(cur) THEN
            IF n < 8 THEN n = n + 1: w(n) = cur
            cur = ""
        END IF
    NEXT i
    IF n = 0 THEN BL_tile_text$ = "?": EXIT FUNCTION
    first = 1
    IF n > 1 _ANDALSO (w(1) = "TOGGLE" _ORELSE w(1) = "SHOW") THEN first = 2
    ' a short first word (NEW, ADD...): its initial, then the next word's letters
    IF LEN(w(first)) <= 3 _ANDALSO n > first THEN
        r = LEFT$(w(first), 1) + LEFT$(w(first + 1), 1)
        FOR i = 2 TO LEN(w(first + 1))
            IF LEN(r) >= 3 THEN EXIT FOR
            ch = MID$(w(first + 1), i, 1)
            IF INSTR("AEIOU", ch) = 0 _ANDALSO ch <> RIGHT$(r, 1) THEN r = r + ch
        NEXT i
        BL_tile_text$ = r
        EXIT FUNCTION
    END IF
    r = LEFT$(w(first), 1)
    FOR i = 2 TO LEN(w(first))
        IF LEN(r) >= 3 THEN EXIT FOR
        ch = MID$(w(first), i, 1)
        IF INSTR("AEIOU", ch) = 0 _ANDALSO ch <> RIGHT$(r, 1) THEN r = r + ch
    NEXT i
    FOR k = first + 1 TO n
        IF LEN(r) >= 3 THEN EXIT FOR
        r = r + LEFT$(w(k), 1)
    NEXT k
    IF LEN(r) < 2 _ANDALSO LEN(w(first)) > 1 THEN r = LEFT$(w(first), 3)
    BL_tile_text$ = r
END FUNCTION


''
' The tile image of command act (disabled = its dimmed copy), built once.
FUNCTION BL_cmd_tile& (act AS INTEGER, disabled AS INTEGER)
    DIM i AS INTEGER, img AS LONG, dimg AS LONG, t AS STRING, c AS _UNSIGNED LONG, oldDest AS LONG, oldFont AS LONG
    DIM tw AS INTEGER, th AS INTEGER
    STATIC tileFg AS _UNSIGNED LONG
    IF tileFg <> THEME.ICON_BAR_button_fg~& THEN BL_free_tiles: tileFg = THEME.ICON_BAR_button_fg~& ' (a live theme edit: draw them again)
    FOR i = 0 TO BL_TILE_N - 1
        IF BL_TILE_ACT(i) = act THEN
            IF disabled THEN BL_cmd_tile& = BL_TILE_DIM(i) ELSE BL_cmd_tile& = BL_TILE_IMG(i)
            EXIT FUNCTION
        END IF
    NEXT i
    IF BL_TILE_N >= BL_TILE_MAX THEN EXIT FUNCTION
    oldDest& = _DEST: oldFont& = _FONT
    DIM tileW AS INTEGER
    c = THEME.ICON_BAR_button_fg~& ' the text on icon buttons
    tileW = _MAX(16, THEME.ICON_BAR_width%) ' a bar column's full width: room for 3 letters
    img = _NEWIMAGE(tileW, 16, 32)
    _DEST img
    CLS , _RGBA32(0, 0, 0, 0)
    LINE (1, 0)-(tileW - 2, 0), c: LINE (1, 15)-(tileW - 2, 15), c
    LINE (0, 1)-(0, 14), c: LINE (tileW - 1, 1)-(tileW - 1, 14), c
    IF LAYER_PANEL.fontHandle& > 0 THEN _FONT LAYER_PANEL.fontHandle& ELSE _FONT 8
    t = BL_tile_text$(act)
    DO WHILE LEN(t) > 1 _ANDALSO _UPRINTWIDTH(t) > tileW - 4
        t = LEFT$(t, LEN(t) - 1)
    LOOP
    tw = _UPRINTWIDTH(t): th = _UFONTHEIGHT
    COLOR c, _RGBA32(0, 0, 0, 0)
    _PRINTMODE _KEEPBACKGROUND
    _UPRINTSTRING ((tileW - tw + 1) \ 2, (16 - th) \ 2), t
    _FONT 16
    _DEST oldDest&: _FONT oldFont&
    ' dimmed copy, as the bars dim their icons
    dimg = _COPYIMAGE(img)
    BL_dim_image dimg
    BL_TILE_ACT(BL_TILE_N) = act: BL_TILE_IMG(BL_TILE_N) = img: BL_TILE_DIM(BL_TILE_N) = dimg
    BL_TILE_N = BL_TILE_N + 1
    IF disabled THEN BL_cmd_tile& = dimg ELSE BL_cmd_tile& = img
END FUNCTION


''
' Scale an image's alpha like the bars' disabled icons.
SUB BL_dim_image (img AS LONG)
    DIM m AS _MEM, offs AS _OFFSET, px AS _UNSIGNED LONG, a AS INTEGER, k AS SINGLE
    IF img >= -1 THEN EXIT SUB
    k = (255 - THEME.ICON_BAR_button_disabled_alpha%) / 255!
    IF k < 0 THEN k = 0
    IF k > 1 THEN k = 1
    m = _MEMIMAGE(img)
    offs = m.OFFSET
    DO WHILE offs < m.OFFSET + m.SIZE
        px = _MEMGET(m, offs, _UNSIGNED LONG)
        a = _ALPHA32(px)
        IF a > 0 THEN _MEMPUT m, offs, _RGBA32(_RED32(px), _GREEN32(px), _BLUE32(px), INT(a * k)) AS _UNSIGNED LONG
        offs = offs + 4
    LOOP
    _MEMFREE m
END SUB


''
' Free the tiles (a theme reload rebuilds them on next use).
SUB BL_free_tiles ()
    DIM i AS INTEGER
    FOR i = 0 TO BL_TILE_N - 1
        IF BL_TILE_IMG(i) < -1 THEN _FREEIMAGE BL_TILE_IMG(i)
        IF BL_TILE_DIM(i) < -1 THEN _FREEIMAGE BL_TILE_DIM(i)
        BL_TILE_IMG(i) = 0: BL_TILE_DIM(i) = 0: BL_TILE_ACT(i) = 0
    NEXT i
    BL_TILE_N = 0
    FOR i = 0 TO BL_FICON_N - 1
        IF BL_FICON_IMG(i) < -1 THEN _FREEIMAGE BL_FICON_IMG(i)
        IF BL_FICON_DIM(i) < -1 THEN _FREEIMAGE BL_FICON_DIM(i)
        BL_FICON_IMG(i) = 0: BL_FICON_DIM(i) = 0: BL_FICON_ACT(i) = 0
    NEXT i
    BL_FICON_N = 0
END SUB


' =============================================================================
' Tools on the bars
' =============================================================================

''
' The tool (TOOL_*) of toolbox button btn (TB_*), -1 = none.
FUNCTION BL_tool_of% (btn AS INTEGER)
    DIM slot AS INTEGER
    BL_tool_of% = -1
    slot = TOOLBAR_default_slot%(btn)
    IF slot >= 0 THEN BL_tool_of% = TOOLBAR_DEF_TO_TOOL(slot)
END FUNCTION


''
' Toolbox button btn's icon, loaded if the toolbox has not drawn it yet.
FUNCTION BL_tool_icon& (btn AS INTEGER)
    IF btn < 0 _ORELSE btn > UBOUND(GUI_TB) THEN EXIT FUNCTION
    IF GUI_TB(btn).iHnd& = 0 THEN GUI_TB(btn).iHnd& = _LOADIMAGE("ASSETS/THEMES/" + _TRIM$(CFG.THEME$) + "/IMAGES/TOOLBOX/" + GUI_TB(btn).iSrc$, 32)
    BL_tool_icon& = GUI_TB(btn).iHnd&
END FUNCTION


''
' A toolbox button on a bar: its 11px button centred in a 16px cell at (x, y),
' with the toolbox's active-tool mark when its tool is the current one.
SUB BL_draw_tool_button (btn AS INTEGER, x AS INTEGER, y AS INTEGER)
    DIM img AS LONG, bx AS INTEGER, by AS INTEGER, t AS INTEGER, act AS INTEGER
    img = BL_tool_icon&(btn)
    bx = x + (16 - TB_BTN_W) \ 2: by = y + (16 - TB_BTN_H) \ 2
    IF img < -1 THEN _PUTIMAGE (bx, by), img, , (0, 0)-(TB_BTN_W - 1, TB_BTN_H - 1)
    t = BL_tool_of%(btn)
    act = (t >= 0 _ANDALSO t = TOOLBAR_active_tool_id%)
    IF t = TOOL_SMART_SHAPES _ANDALSO SMART_SHAPES_is_active% THEN act = TRUE
    IF act THEN
        LINE (bx, by)-(bx + TB_BTN_W - 1, by + TB_BTN_H - 1), THEME.ICON_BAR_button_on_bg~&, BF
        LINE (bx, by)-(bx + TB_BTN_W - 1, by + TB_BTN_H - 1), THEME.ICON_BAR_button_on_border~&, B
    END IF
END SUB


' =============================================================================
' Dividers and gaps: how big a divider is, and whether dividers / gaps show
' (Customize Toolbars, per panel; workspace DIVIDER_SIZE= / SHOW_DIVIDERS= /
' SHOW_GAPS= in the panel's section). Rick 2026-11-23: "dividers should be
' adjustable in the toolbar customizer. and gaps should show up with [x] show
' gaps [x] show dividers". A bar in a top / bottom row stays one even grid
' (BL_bar_draw_h%: no divider / gap room there).
' =============================================================================

''
' The divider size set for panel: -1 = its default (BL_div_px%), else 0..16.
FUNCTION BL_div_size% (panel AS INTEGER)
    BL_div_size% = BL_DIVSZ(panel) - 1
END FUNCTION

SUB BL_div_size_set (panel AS INTEGER, v AS INTEGER)
    DIM n AS INTEGER
    n = v
    IF n < -1 THEN n = -1
    IF n > BL_DIV_MAX THEN n = BL_DIV_MAX
    BL_DIVSZ(panel) = n + 1
END SUB

''
' The space a divider takes on panel (px, its units): the size set, else the
' theme's ICON_BAR_DIVIDER_MARGIN on a bar and none in the toolbox (where a
' divider only ends the row).
FUNCTION BL_div_px% (panel AS INTEGER)
    DIM s AS INTEGER
    s = BL_div_size%(panel)
    IF s < 0 THEN
        IF panel = BL_TOOLBOX THEN s = 0 ELSE s = THEME.ICON_BAR_divider_margin%
    END IF
    IF s < 0 THEN s = 0
    BL_div_px% = s
END FUNCTION

''
' Back to the default look: default divider size, no lines, no gap outlines.
SUB BL_style_reset (panel AS INTEGER)
    BL_DIVSZ(panel) = 0
    BL_SHOWDIV(panel) = FALSE
    BL_SHOWGAP(panel) = FALSE
END SUB

''
' The panel's dividers / gaps as one string (Customize Toolbars compares it to
' see whether a change needs saving).
FUNCTION BL_style_key$ (panel AS INTEGER)
    BL_style_key$ = _TRIM$(STR$(BL_div_size%(panel))) + "," + _TRIM$(STR$(BL_SHOWDIV(panel) <> 0)) + "," + _TRIM$(STR$(BL_SHOWGAP(panel) <> 0))
END FUNCTION

''
' The panel's section in a workspace file.
FUNCTION BL_ws_section$ (panel AS INTEGER)
    SELECT CASE panel
        CASE BL_TOOLBOX: BL_ws_section$ = "TOOLBOX"
        CASE BL_EDITBAR: BL_ws_section$ = "EDIT_BAR"
        CASE BL_ADVBAR: BL_ws_section$ = "ADVANCED_BAR"
        CASE BL_PANELSBAR, BL_IOBAR: BL_ws_section$ = CBAR_section$(CBAR_of_bl%(panel))
    END SELECT
END FUNCTION

''
' SHOW GAPS: a dotted outline of a gap's cell.
SUB BL_gap_outline (x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, c AS _UNSIGNED LONG)
    IF w < 2 _ORELSE h < 2 THEN EXIT SUB
    LINE (x, y)-(x + w - 1, y + h - 1), c, B, &HAAAA
END SUB
