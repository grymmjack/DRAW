$INCLUDEONCE
'==============================================================================
' KIT-DIALOG.BM - DRAW KITS export dialog + per-type item picker.
' Install dialog is added in a later task. Uses GUI/DIALOG.BM framework, the
' TOOLS/KIT* resolver/manifest, and the modal DRAW_input_box/open/save helpers.
'==============================================================================

' Basename of a path (after the last / or \).
FUNCTION KIT_basename$ (pth AS STRING)
    DIM i AS LONG
    FOR i = LEN(pth) TO 1 STEP -1
        IF ASC(pth, i) = 47 OR ASC(pth, i) = 92 THEN KIT_basename$ = MID$(pth, i + 1): EXIT FUNCTION
    NEXT
    KIT_basename$ = pth
END FUNCTION

FUNCTION KIT_shot_label$
    IF KIT_SHOT_SRC$ = "" THEN KIT_shot_label$ = "(click to choose)" ELSE KIT_shot_label$ = KIT_basename$(KIT_SHOT_SRC$)
END FUNCTION

' Left-aligned toggle (DIALOG_draw_toggle centers its label; kit rows read better
' left-justified). Same look/colors, text pinned to the left with a small pad.
SUB KIT_draw_toggle_l (ctx AS DIALOG_CTX, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER, label AS STRING, selected AS INTEGER)
    DIM bg AS _UNSIGNED LONG, fg AS _UNSIGNED LONG, border AS _UNSIGNED LONG, fontH AS INTEGER
    IF selected THEN
        bg~& = THEME.DIALOG_toggle_sel_bg~&: fg~& = THEME.DIALOG_toggle_sel_fg~&: border~& = THEME.DIALOG_toggle_sel_border~&
    ELSE
        bg~& = THEME.DIALOG_toggle_bg~&: fg~& = THEME.DIALOG_toggle_fg~&: border~& = THEME.DIALOG_toggle_border~&
    END IF
    LINE (bx, by)-(bx + bw, by + bh), bg~&, BF
    LINE (bx, by)-(bx + bw, by + bh), border~&, B
    COLOR fg~&
    fontH% = DIALOG_font_height%(ctx)
    _UPRINTSTRING (bx + 6, by + (bh - fontH%) \ 2), label
END SUB

' Draw a "LABEL: [ value ]" field row (value clipped to the box).
SUB KIT_dlg_field (ctx AS DIALOG_CTX, lx AS INTEGER, fx AS INTEGER, fy AS INTEGER, fw AS INTEGER, label AS STRING, txt AS STRING)
    DIALOG_draw_label ctx, lx, fy + 1, label
    LINE (fx, fy)-(fx + fw - 1, fy + 14), _RGB32(24, 26, 32), BF
    LINE (fx, fy)-(fx + fw - 1, fy + 14), _RGB32(80, 88, 104), B
    DIM shown AS STRING : shown = txt
    DIM maxc AS INTEGER : maxc = (fw - 8) \ 8
    IF maxc < 2 THEN maxc = 2
    IF LEN(shown) > maxc THEN shown = LEFT$(shown, maxc - 2) + ".."
    COLOR _RGB32(210, 214, 222)
    _UPRINTSTRING (fx + 4, fy + 3), shown
END SUB

' Edit one metadata field (0 name / 1 desc / 2 author) via a modal input box.
SUB KIT_dlg_edit_field (which AS INTEGER)
    DIM ttl AS STRING, msg AS STRING, cur AS STRING, r AS STRING
    SELECT CASE which
        CASE 0: ttl = "Kit Name": msg = "Name for this kit:": cur = KIT_EXPORT_MF.kitName
        CASE 1: ttl = "Kit Description": msg = "Describe this kit:": cur = KIT_EXPORT_MF.kitDesc
        CASE 2: ttl = "Kit Author": msg = "Author / credit:": cur = KIT_EXPORT_MF.kitAuthor
    END SELECT
    POINTER_hide_for_dialog
    IF which = 1 THEN ' description = multi-line
        r = DRAW_input_box_multiline$(ttl, msg, cur, "")
    ELSE
        r = DRAW_input_box_ex$(ttl, msg, cur, "", TRUE)
    END IF
    POINTER_show_after_dialog: MOUSE_cleanup_after_dialog TRUE
    IF r <> "" THEN
        SELECT CASE which
            CASE 0: KIT_EXPORT_MF.kitName = r
            CASE 1: KIT_EXPORT_MF.kitDesc = r
            CASE 2: KIT_EXPORT_MF.kitAuthor = r
        END SELECT
    END IF
END SUB

SUB KIT_dlg_pick_shot
    DIM p AS STRING
    POINTER_hide_for_dialog
    p = DRAW_open_file$("Kit Screenshot", "", "Images|*.png|*.jpg|*.jpeg|*.bmp|All Files|*.*", 0)
    POINTER_show_after_dialog: MOUSE_cleanup_after_dialog TRUE
    IF p <> "" THEN KIT_SHOT_SRC$ = p
END SUB

' Find the FONT_LIST index whose path ends with nm (the kit item's relative path),
' so a picked font can be previewed. -1 if not currently in the font list.
FUNCTION KIT_font_list_idx% (nm AS STRING)
    DIM j AS INTEGER, p AS STRING
    KIT_font_list_idx% = -1
    FOR j = 0 TO FONT_LIST_COUNT% - 1
        p = RTRIM$(FONT_LIST(j).path)
        IF LEN(p) >= LEN(nm) THEN
            IF RIGHT$(p, LEN(nm)) = nm THEN KIT_font_list_idx% = j: EXIT FUNCTION
        END IF
    NEXT
END FUNCTION

'-- Per-type item picker ------------------------------------------------------
SUB KIT_picker_dialog (ty AS INTEGER)
    DIM ctx AS DIALOG_CTX, k AS LONG, i AS INTEGER, idx AS INTEGER, hi AS INTEGER
    DIM titleH AS INTEGER, listY AS INTEGER, rowH AS INTEGER, visRows AS INTEGER
    DIM btnH AS INTEGER, btnY AS INTEGER, scroll AS INTEGER, n AS INTEGER
    DIM isFont AS INTEGER, showPrev AS INTEGER, shotFrames AS INTEGER, dw AS INTEGER
    DIM pvImg AS LONG, pvw AS INTEGER, pvh AS INTEGER, pw AS INTEGER, ph AS INTEGER, prx AS INTEGER, pry AS INTEGER

    KIT_enumerate ty
    n = KIT_ENUM_COUNT%
    REDIM names(0) AS STRING
    IF n > 0 THEN
        REDIM names(0 TO n - 1) AS STRING
        FOR i = 0 TO n - 1: names(i) = KIT_ENUM_NAME(i): NEXT
    END IF

    ' Font pickers render a live preview of each face when previews are enabled.
    isFont = (ty = KIT_TYPE_FONT_TTF OR ty = KIT_TYPE_FONT_BITMAP OR ty = KIT_TYPE_FONT_COLORBITMAP)
    showPrev = (isFont AND CFG.FONT_PREVIEW_ENABLED)
    REDIM flidx(0) AS INTEGER
    IF showPrev AND n > 0 THEN
        REDIM flidx(0 TO n - 1) AS INTEGER
        FOR i = 0 TO n - 1: flidx(i) = -2 ' -2 = not yet looked up
        NEXT
    END IF

    dw = 300: IF showPrev THEN dw = 384
    DIALOG_init ctx, dw, 324
    ctx.prevH = 0
    titleH = THEME.DIALOG_title_height%
    listY = titleH + 26: rowH = 15: IF showPrev THEN rowH = 22
    btnH = 20: btnY = ctx.h - btnH - 8
    visRows = (btnY - listY - 6) \ rowH
    scroll = 0: shotFrames = 0

    DO
        DIALOG_poll_mouse ctx
        k = _KEYHIT
        IF k = 27 THEN ctx.done = TRUE

        IF DIALOG_hit%(ctx, 10, titleH + 6, 52, 15) THEN ' All
            FOR i = 0 TO n - 1
                IF NOT KIT_sel_has%(ty, names(i)) THEN KIT_item_add ty, names(i)
            NEXT
        END IF
        IF DIALOG_hit%(ctx, 66, titleH + 6, 52, 15) THEN KIT_sel_remove_type ty ' None

        IF ctx.mwheel <> 0 THEN scroll = scroll + ctx.mwheel * 2
        IF n - visRows < 0 THEN
            scroll = 0
        ELSE
            IF scroll > n - visRows THEN scroll = n - visRows
        END IF
        IF scroll < 0 THEN scroll = 0

        FOR i = 0 TO visRows - 1
            idx = scroll + i
            IF idx < n THEN
                IF DIALOG_hit%(ctx, 10, listY + i * rowH, ctx.w - 20, rowH - 1) THEN KIT_sel_toggle ty, names(idx)
            END IF
        NEXT
        IF DIALOG_hit%(ctx, ctx.w - 80, btnY, 70, btnH) THEN ctx.done = TRUE ' Done

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "PICK " + UCASE$(KIT_type_label$(ty))
        DIALOG_draw_button ctx, 10, titleH + 6, 52, 15, "All", _RGB32(50, 55, 66), _RGB32(70, 78, 92), _RGB32(90, 100, 120)
        DIALOG_draw_button ctx, 66, titleH + 6, 52, 15, "None", _RGB32(50, 55, 66), _RGB32(70, 78, 92), _RGB32(90, 100, 120)
        IF n = 0 THEN DIALOG_draw_label ctx, 10, listY, "(no items of this type)"
        IF showPrev THEN FONT_PREVIEW_frame_reset
        FOR i = 0 TO visRows - 1
            idx = scroll + i
            IF idx < n THEN
                KIT_draw_toggle_l ctx, 10, listY + i * rowH, ctx.w - 20, rowH - 1, names(idx), KIT_sel_has%(ty, names(idx))
                IF showPrev THEN
                    IF flidx(idx) = -2 THEN flidx(idx) = KIT_font_list_idx%(names(idx))
                    IF flidx(idx) >= 0 THEN
                        pvImg = FONT_PREVIEW_ensure&(flidx(idx))
                        IF pvImg < -1 THEN
                            pvw = _WIDTH(pvImg): pvh = _HEIGHT(pvImg)
                            IF pvw > 0 AND pvh > 0 THEN
                                ph = rowH - 5: pw = pvw * ph \ pvh
                                IF pw > 150 THEN pw = 150
                                prx = ctx.w - 12 - pw: pry = listY + i * rowH + 2
                                _PUTIMAGE (prx, pry)-(prx + pw - 1, pry + ph - 1), pvImg, ctx.imgHandle
                            END IF
                        END IF
                    END IF
                END IF
            END IF
        NEXT
        IF n > visRows THEN
            hi = scroll + visRows: IF hi > n THEN hi = n
            DIALOG_draw_label ctx, 10, btnY + 5, LTRIM$(STR$(scroll + 1)) + "-" + LTRIM$(STR$(hi)) + " / " + LTRIM$(STR$(n)) + "  (wheel)"
        END IF
        DIALOG_draw_button ctx, ctx.w - 80, btnY, 70, btnH, "DONE", _RGB32(40, 90, 120), _RGB32(60, 120, 160), _RGB32(90, 160, 210)
        DIALOG_blit ctx
        IF KIT_SHOT_PATH$ <> "" THEN ' shot mode: let previews fill over a few frames
            shotFrames = shotFrames + 1
            IF shotFrames >= 40 OR NOT showPrev THEN _SAVEIMAGE KIT_SHOT_PATH$, ctx.imgHandle: ctx.done = TRUE
        END IF
    LOOP UNTIL ctx.done
    DIALOG_cleanup ctx
END SUB

'-- Export dialog -------------------------------------------------------------
' Collects metadata + per-type item selection into KIT_EXPORT_MF / KIT_ITEM_* and
' the output path into KIT_OUT_PATH$. Returns TRUE when the user chose to export.
FUNCTION KIT_export_dialog%
    DIM ctx AS DIALOG_CTX, k AS LONG, i AS INTEGER, ty AS INTEGER, ry AS INTEGER
    DIM titleH AS INTEGER, fldX AS INTEGER, fldW AS INTEGER
    DIM nameY AS INTEGER, descY AS INTEGER, authY AS INTEGER, shotY AS INTEGER
    DIM incY AS INTEGER, row0Y AS INTEGER, rowH AS INTEGER, chkW AS INTEGER, itemsX AS INTEGER, itemsW AS INTEGER
    DIM btnH AS INTEGER, btnW AS INTEGER, btnY AS INTEGER, okX AS INTEGER, cxX AS INTEGER
    DIM cnt AS STRING

    ' Fresh selection + metadata each open; cache per-type totals.
    KIT_items_clear
    KIT_EXPORT_MF.kitName = "": KIT_EXPORT_MF.kitDesc = "": KIT_EXPORT_MF.kitAuthor = "": KIT_EXPORT_MF.kitShot = ""
    KIT_SHOT_SRC$ = "": KIT_OUT_PATH$ = ""
    FOR ty = 0 TO KIT_TYPE_COUNT - 1
        KIT_enumerate ty: KIT_TOTAL(ty) = KIT_ENUM_COUNT%
    NEXT
    IF KIT_SHOT_PATH$ <> "" THEN ' populate 1 of every available type for the screenshot
        DIM sty AS INTEGER
        FOR sty = 0 TO KIT_TYPE_COUNT - 1
            KIT_enumerate sty
            IF KIT_ENUM_COUNT% > 0 THEN KIT_item_add sty, KIT_ENUM_NAME(0)
        NEXT
    END IF

    DIALOG_init ctx, 384, 408
    ctx.prevH = 0
    titleH = THEME.DIALOG_title_height%
    fldX = 78: fldW = ctx.w - fldX - 10
    nameY = titleH + 8: descY = nameY + 20: authY = descY + 20: shotY = authY + 20
    incY = shotY + 24: row0Y = incY + 14: rowH = 17
    chkW = 150: itemsW = 60: itemsX = ctx.w - itemsW - 10
    btnH = 22: btnW = 96: btnY = ctx.h - btnH - 10: okX = ctx.w - btnW * 2 - 16: cxX = ctx.w - btnW - 10

    DO
        DIALOG_poll_mouse ctx
        k = _KEYHIT
        IF k = 27 THEN ctx.done = TRUE: ctx.result = FALSE

        IF DIALOG_hit%(ctx, fldX, nameY, fldW, 15) THEN KIT_dlg_edit_field 0
        IF DIALOG_hit%(ctx, fldX, descY, fldW, 15) THEN KIT_dlg_edit_field 1
        IF DIALOG_hit%(ctx, fldX, authY, fldW, 15) THEN KIT_dlg_edit_field 2
        IF DIALOG_hit%(ctx, fldX, shotY, fldW, 15) THEN KIT_dlg_pick_shot

        FOR i = 0 TO KIT_TYPE_COUNT - 1
            ry = row0Y + i * rowH
            IF DIALOG_hit%(ctx, 10, ry, chkW, 15) THEN
                IF KIT_item_count_of%(i) > 0 THEN KIT_sel_remove_type i ELSE KIT_sel_add_all_of i
            END IF
            IF KIT_TOTAL(i) > 0 THEN
                IF DIALOG_hit%(ctx, itemsX, ry, itemsW, 15) THEN KIT_picker_dialog i
            END IF
        NEXT

        IF DIALOG_hit%(ctx, okX, btnY, btnW, btnH) THEN
            IF KIT_export_confirm% THEN ctx.done = TRUE: ctx.result = TRUE
        END IF
        IF DIALOG_hit%(ctx, cxX, btnY, btnW, btnH) THEN ctx.done = TRUE: ctx.result = FALSE

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "EXPORT DRAW KIT"
        KIT_dlg_field ctx, 10, fldX, nameY, fldW, "NAME:", KIT_EXPORT_MF.kitName
        KIT_dlg_field ctx, 10, fldX, descY, fldW, "DESC:", KIT_EXPORT_MF.kitDesc
        KIT_dlg_field ctx, 10, fldX, authY, fldW, "AUTHOR:", KIT_EXPORT_MF.kitAuthor
        KIT_dlg_field ctx, 10, fldX, shotY, fldW, "SHOT:", KIT_shot_label$
        DIALOG_draw_label ctx, 10, incY, "INCLUDE  (check = all;  Items to pick):"
        FOR i = 0 TO KIT_TYPE_COUNT - 1
            ry = row0Y + i * rowH
            KIT_draw_toggle_l ctx, 10, ry, chkW, 15, KIT_type_label$(i), (KIT_item_count_of%(i) > 0)
            cnt = "(" + LTRIM$(STR$(KIT_item_count_of%(i))) + "/" + LTRIM$(STR$(KIT_TOTAL(i))) + ")"
            DIALOG_draw_label ctx, 10 + chkW + 6, ry + 1, cnt
            IF KIT_TOTAL(i) > 0 THEN DIALOG_draw_button ctx, itemsX, ry, itemsW, 15, "Items", _RGB32(50, 55, 66), _RGB32(70, 78, 92), _RGB32(90, 100, 120)
        NEXT
        DIALOG_draw_button ctx, okX, btnY, btnW, btnH, "EXPORT", _RGB32(40, 100, 40), _RGB32(60, 150, 60), _RGB32(80, 200, 80)
        DIALOG_draw_button ctx, cxX, btnY, btnW, btnH, "CANCEL", _RGB32(100, 40, 40), _RGB32(150, 60, 60), _RGB32(200, 80, 80)
        DIALOG_blit ctx
        IF KIT_SHOT_PATH$ <> "" THEN _SAVEIMAGE KIT_SHOT_PATH$, ctx.imgHandle: ctx.done = TRUE: ctx.result = FALSE
    LOOP UNTIL ctx.done

    KIT_export_dialog% = ctx.result
    DIALOG_cleanup ctx
END FUNCTION

' Validate the export selection and prompt for an output path. Returns TRUE when
' ready to write (name given, >=1 item, path chosen). Fills KIT_OUT_PATH$ + mf.
FUNCTION KIT_export_confirm%
    IF _TRIM$(KIT_EXPORT_MF.kitName) = "" THEN
        POINTER_hide_for_dialog: DRAW_alert "Export Kit", "Please enter a name for the kit.": POINTER_show_after_dialog: MOUSE_cleanup_after_dialog TRUE
        EXIT FUNCTION
    END IF
    IF KIT_ITEM_COUNT% < 1 THEN
        POINTER_hide_for_dialog: DRAW_alert "Export Kit", "Select at least one item to include.": POINTER_show_after_dialog: MOUSE_cleanup_after_dialog TRUE
        EXIT FUNCTION
    END IF
    KIT_EXPORT_MF.kitShot = "" ' resolved at write time (kit-internal name)
    DIM defName AS STRING : defName = KIT_safe_filename$(_TRIM$(KIT_EXPORT_MF.kitName)) + ".zip"
    DIM p AS STRING, sd AS STRING
    sd = CFG.LAST_DIR_KIT$: IF sd <> "" THEN sd = sd + "/"
    POINTER_hide_for_dialog
    p = DRAW_save_file$("Export Kit", sd, "DRAW Kit|*.zip|All Files|*.*", 0, defName, "zip")
    POINTER_show_after_dialog: MOUSE_cleanup_after_dialog TRUE
    IF p = "" THEN EXIT FUNCTION
    KIT_OUT_PATH$ = p
    CFG.LAST_DIR_KIT$ = CONFIG_extract_dir$(p): CONFIG_save
    KIT_export_confirm% = TRUE
END FUNCTION

' Sanitize a kit name into a filename-safe base.
FUNCTION KIT_safe_filename$ (s AS STRING)
    DIM r AS STRING, i AS LONG, c AS INTEGER
    FOR i = 1 TO LEN(s)
        c = ASC(s, i)
        IF (c >= 48 AND c <= 57) OR (c >= 65 AND c <= 90) OR (c >= 97 AND c <= 122) OR c = 45 OR c = 95 THEN
            r = r + CHR$(c)
        ELSEIF c = 32 THEN
            r = r + "-"
        END IF
    NEXT
    IF r = "" THEN r = "kit"
    KIT_safe_filename$ = r
END FUNCTION

' Word-wrap text into rows of at most `cols` chars, drawn from (x,y) down; caps
' at maxLines rows (last row gets an ellipsis if truncated).
SUB KIT_wrap_draw (ctx AS DIALOG_CTX, x AS INTEGER, y AS INTEGER, cols AS INTEGER, txt AS STRING, maxLines AS INTEGER, lineH AS INTEGER)
    DIM words AS STRING, ln AS STRING, w AS STRING, sp AS LONG, row AS INTEGER
    words = txt
    row = 0
    DO WHILE LEN(words) > 0 AND row < maxLines
        sp = INSTR(words, " ")
        IF sp = 0 THEN w = words: words = "" ELSE w = LEFT$(words, sp - 1): words = MID$(words, sp + 1)
        IF w = "" THEN _CONTINUE
        IF LEN(ln) = 0 THEN
            ln = w
        ELSEIF LEN(ln) + 1 + LEN(w) <= cols THEN
            ln = ln + " " + w
        ELSE
            DIALOG_draw_label ctx, x, y + row * lineH, ln
            row = row + 1: ln = w
        END IF
    LOOP
    IF row < maxLines AND LEN(ln) > 0 THEN DIALOG_draw_label ctx, x, y + row * lineH, ln
    IF LEN(words) > 0 AND row >= maxLines THEN DIALOG_draw_label ctx, x, y + (maxLines - 1) * lineH, LEFT$(ln, cols - 2) + ".."
END SUB

'-- Install dialog ------------------------------------------------------------
' Pick a kit file, show its preview/description/author + per-type include
' checkboxes, and let the user choose what to install. On TRUE, KIT_INSTALL_PATH$,
' the parsed manifest (KIT_ITEM_*) and KIT_INSTALL_ON() drive the install (task 8).
FUNCTION KIT_install_dialog%
    DIM kp AS STRING, sd AS STRING
    IF KIT_SHOT_SKIPPICK% THEN
        kp = KIT_INSTALL_PATH$
    ELSE
        sd = CFG.LAST_DIR_KIT$: IF sd <> "" THEN sd = sd + "/"
        POINTER_hide_for_dialog
        kp = DRAW_open_file$("Install DRAW Kit", sd, "DRAW Kit|*.zip|All Files|*.*", 0)
        POINTER_show_after_dialog: MOUSE_cleanup_after_dialog TRUE
        IF kp = "" THEN EXIT FUNCTION
        CFG.LAST_DIR_KIT$ = CONFIG_extract_dir$(kp): CONFIG_save
    END IF

    DIM mf AS KIT_MANIFEST
    IF NOT KIT_load_kit_manifest%(kp, mf) THEN
        POINTER_hide_for_dialog: DRAW_alert "Install Kit", "This is not a valid DRAW kit (no manifest).": POINTER_show_after_dialog: MOUSE_cleanup_after_dialog TRUE
        EXIT FUNCTION
    END IF
    KIT_INSTALL_PATH$ = kp

    ' Present-type list + default all present types ON.
    DIM present(0 TO KIT_TYPE_COUNT - 1) AS INTEGER, pcount AS INTEGER, ty AS INTEGER
    pcount = 0
    FOR ty = 0 TO KIT_TYPE_COUNT - 1
        KIT_INSTALL_ON(ty) = (KIT_item_count_of%(ty) > 0)
        IF KIT_item_count_of%(ty) > 0 THEN present(pcount) = ty: pcount = pcount + 1
    NEXT

    DIM prev AS LONG : prev = KIT_load_kit_preview&(kp, mf)

    DIM ctx AS DIALOG_CTX, k AS LONG, i AS INTEGER, ry AS INTEGER
    DIM titleH AS INTEGER, metaX AS INTEGER, pvX AS INTEGER, pvY AS INTEGER, pvW AS INTEGER, pvH AS INTEGER
    DIM descY AS INTEGER, row0Y AS INTEGER, rowH AS INTEGER, btnH AS INTEGER, btnW AS INTEGER, btnY AS INTEGER, okX AS INTEGER, cxX AS INTEGER

    DIALOG_init ctx, 384, 404
    ctx.prevH = 0
    titleH = THEME.DIALOG_title_height%
    pvX = 10: pvY = titleH + 8: pvW = 128: pvH = 96
    metaX = pvX + pvW + 10
    descY = pvY + pvH + 6
    row0Y = descY + 66: rowH = 16
    btnH = 22: btnW = 96: btnY = ctx.h - btnH - 10: okX = ctx.w - btnW * 2 - 16: cxX = ctx.w - btnW - 10

    DO
        DIALOG_poll_mouse ctx
        k = _KEYHIT
        IF k = 27 THEN ctx.done = TRUE: ctx.result = FALSE

        FOR i = 0 TO pcount - 1
            ry = row0Y + i * rowH
            IF DIALOG_hit%(ctx, 10, ry, 220, 14) THEN KIT_INSTALL_ON(present(i)) = NOT KIT_INSTALL_ON(present(i))
        NEXT
        IF DIALOG_hit%(ctx, okX, btnY, btnW, btnH) THEN ctx.done = TRUE: ctx.result = TRUE
        IF DIALOG_hit%(ctx, cxX, btnY, btnW, btnH) THEN ctx.done = TRUE: ctx.result = FALSE

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "INSTALL DRAW KIT"
        ' Preview box
        LINE (pvX, pvY)-(pvX + pvW - 1, pvY + pvH - 1), _RGB32(20, 22, 28), BF
        LINE (pvX, pvY)-(pvX + pvW - 1, pvY + pvH - 1), _RGB32(80, 88, 104), B
        IF prev < -1 THEN
            _PUTIMAGE (pvX + 1, pvY + 1)-(pvX + pvW - 2, pvY + pvH - 2), prev, ctx.imgHandle
        ELSE
            COLOR _RGB32(120, 126, 138): _UPRINTSTRING (pvX + 24, pvY + pvH \ 2 - 4), "(no preview)"
        END IF
        ' Metadata
        COLOR _RGB32(230, 234, 240): _UPRINTSTRING (metaX, pvY + 2), _TRIM$(mf.kitName)
        DIALOG_draw_label ctx, metaX, pvY + 20, "by " + _TRIM$(mf.kitAuthor)
        DIALOG_draw_label ctx, metaX, pvY + 36, LTRIM$(STR$(KIT_ITEM_COUNT%)) + " items"
        ' Description (wrapped)
        DIALOG_draw_label ctx, pvX, descY, "DESCRIPTION:"
        KIT_wrap_draw ctx, pvX, descY + 11, (ctx.w - 14) \ 8, _TRIM$(mf.kitDesc), 4, 10
        ' Include checkboxes
        DIALOG_draw_label ctx, 10, row0Y - 13, "INSTALL:"
        FOR i = 0 TO pcount - 1
            ry = row0Y + i * rowH
            KIT_draw_toggle_l ctx, 10, ry, 220, 14, KIT_type_label$(present(i)) + "  (" + LTRIM$(STR$(KIT_item_count_of%(present(i)))) + ")", KIT_INSTALL_ON(present(i))
        NEXT
        DIALOG_draw_button ctx, okX, btnY, btnW, btnH, "INSTALL", _RGB32(40, 100, 40), _RGB32(60, 150, 60), _RGB32(80, 200, 80)
        DIALOG_draw_button ctx, cxX, btnY, btnW, btnH, "CANCEL", _RGB32(100, 40, 40), _RGB32(150, 60, 60), _RGB32(200, 80, 80)
        DIALOG_blit ctx
        IF KIT_SHOT_PATH$ <> "" THEN _SAVEIMAGE KIT_SHOT_PATH$, ctx.imgHandle: ctx.done = TRUE: ctx.result = FALSE
    LOOP UNTIL ctx.done

    IF prev < -1 THEN _FREEIMAGE prev
    KIT_install_dialog% = ctx.result
    DIALOG_cleanup ctx
END FUNCTION

' Name-clash prompt. Returns 0 overwrite / 1 skip / 2 keep-both (1 on ESC).
' Sets applyAll (BYREF) when the "apply to all remaining" box is ticked.
FUNCTION KIT_conflict_dialog% (fname AS STRING, applyAll AS INTEGER)
    DIM ctx AS DIALOG_CTX, k AS LONG, choice AS INTEGER
    DIM titleH AS INTEGER, bY AS INTEGER, bW AS INTEGER, aY AS INTEGER, shown AS STRING
    choice = 1 ' default / ESC = skip
    DIALOG_init ctx, 348, 158
    ctx.prevH = 0
    titleH = THEME.DIALOG_title_height%
    bW = (ctx.w - 20 - 16) \ 3
    bY = titleH + 62
    aY = bY + 30
    shown = fname : IF LEN(shown) > 40 THEN shown = ".." + RIGHT$(shown, 38)

    DO
        DIALOG_poll_mouse ctx
        k = _KEYHIT
        IF k = 27 THEN choice = 1: ctx.done = TRUE
        IF DIALOG_hit%(ctx, 10, bY, bW, 22) THEN choice = 0: ctx.done = TRUE
        IF DIALOG_hit%(ctx, 10 + bW + 8, bY, bW, 22) THEN choice = 1: ctx.done = TRUE
        IF DIALOG_hit%(ctx, 10 + (bW + 8) * 2, bY, bW, 22) THEN choice = 2: ctx.done = TRUE
        IF DIALOG_hit%(ctx, 10, aY, 220, 14) THEN applyAll = NOT applyAll

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "FILE ALREADY EXISTS"
        DIALOG_draw_label ctx, 10, titleH + 8, "This kit item already exists locally:"
        COLOR _RGB32(240, 220, 120): _UPRINTSTRING (10, titleH + 26), shown
        DIALOG_draw_label ctx, 10, titleH + 44, "What should DRAW do?"
        DIALOG_draw_button ctx, 10, bY, bW, 22, "Overwrite", _RGB32(110, 78, 30), _RGB32(160, 116, 50), _RGB32(210, 160, 70)
        DIALOG_draw_button ctx, 10 + bW + 8, bY, bW, 22, "Skip", _RGB32(50, 55, 66), _RGB32(70, 78, 92), _RGB32(90, 100, 120)
        DIALOG_draw_button ctx, 10 + (bW + 8) * 2, bY, bW, 22, "Keep Both", _RGB32(40, 90, 60), _RGB32(60, 130, 90), _RGB32(80, 180, 120)
        KIT_draw_toggle_l ctx, 10, aY, 220, 14, "Apply to all remaining", applyAll
        DIALOG_blit ctx
    LOOP UNTIL ctx.done
    DIALOG_cleanup ctx
    KIT_conflict_dialog% = choice
END FUNCTION

'-- Dev screenshot mode (--kit-screenshots <dir>) -----------------------------
' Return the directory arg after --kit-screenshots on the command line ("" if absent).
FUNCTION KIT_get_screenshot_arg$
    DIM i AS INTEGER
    FOR i = 1 TO _COMMANDCOUNT - 1
        IF LCASE$(COMMAND$(i)) = "--kit-screenshots" THEN KIT_get_screenshot_arg$ = COMMAND$(i + 1): EXIT FUNCTION
    NEXT
END FUNCTION

' Generic: return the value after <flag> on the command line ("" if absent).
FUNCTION KIT_get_flag_arg$ (flag AS STRING)
    DIM i AS INTEGER
    FOR i = 1 TO _COMMANDCOUNT - 1
        IF LCASE$(COMMAND$(i)) = LCASE$(flag) THEN KIT_get_flag_arg$ = COMMAND$(i + 1): EXIT FUNCTION
    NEXT
END FUNCTION

' Render the export + install dialogs to PNGs in outdir (called at startup then exit).
' Headless export: build a kit at zipPath with 1 of every available asset type
' (+ a preview image), no dialogs. Used by --kit-export and the round-trip test.
SUB KIT_dev_export (zipPath AS STRING)
    DIM ty AS INTEGER, r AS INTEGER
    KIT_items_clear
    KIT_EXPORT_MF.kitName = "Sample DRAW Kit"
    KIT_EXPORT_MF.kitDesc = "A sample DRAW KIT: one of each available asset type. Install via File > Install Kit... in DRAW, or just unzip it (see DRAWKIT.md)."
    KIT_EXPORT_MF.kitAuthor = "DRAW"
    FOR ty = 0 TO KIT_TYPE_COUNT - 1
        KIT_enumerate ty
        IF KIT_ENUM_COUNT% > 0 THEN KIT_item_add ty, KIT_ENUM_NAME(0)
    NEXT
    KIT_SHOT_SRC$ = "ASSETS/THEMES/DEFAULT/splash.png"
    KIT_OUT_PATH$ = zipPath
    r = KIT_export_write%
END SUB

SUB KIT_dev_screenshots (outdir AS STRING)
    DIM r AS INTEGER, d AS STRING, ty AS INTEGER, i AS INTEGER, pickTy AS INTEGER
    d = outdir : IF RIGHT$(d, 1) <> "/" AND RIGHT$(d, 1) <> "\" THEN d = d + "/"

    ' Build a sample kit with 1 of every available type + a preview image.
    KIT_items_clear
    KIT_EXPORT_MF.kitName = "Grymm's Retro Pack"
    KIT_EXPORT_MF.kitDesc = "CRT palettes, block brushes, gradients, fonts, text styles, a widescreen template, and the DARK theme. Drop it in and go."
    KIT_EXPORT_MF.kitAuthor = "Rick Christy"
    FOR ty = 0 TO KIT_TYPE_COUNT - 1
        KIT_enumerate ty
        IF KIT_ENUM_COUNT% > 0 THEN KIT_item_add ty, KIT_ENUM_NAME(0)
    NEXT
    KIT_SHOT_SRC$ = "ASSETS/THEMES/DEFAULT/splash.png"
    KIT_OUT_PATH$ = d + "sample-kit.zip"
    r = KIT_export_write%

    ' Export dialog (fresh open; shot-mode pre-checks 1 of every type).
    KIT_SHOT_PATH$ = d + "kit-export.png"
    r = KIT_export_dialog%
    KIT_SHOT_PATH$ = ""

    ' Item picker: use the type with the most items; pre-check every other one
    ' so the shot shows a mixed checked/unchecked list.
    pickTy = KIT_TYPE_PALETTE
    FOR ty = 0 TO KIT_TYPE_COUNT - 1
        KIT_enumerate ty
        IF KIT_ENUM_COUNT% > KIT_TOTAL(pickTy) THEN pickTy = ty
        KIT_TOTAL(ty) = KIT_ENUM_COUNT%
    NEXT
    ' Demo font previews on the TrueType picker (well-supported for previews).
    IF KIT_TOTAL(KIT_TYPE_FONT_TTF) > 0 THEN pickTy = KIT_TYPE_FONT_TTF
    KIT_items_clear
    KIT_enumerate pickTy
    FOR i = 0 TO KIT_ENUM_COUNT% - 1 STEP 2
        KIT_item_add pickTy, KIT_ENUM_NAME(i)
    NEXT
    ' Demo font previews in the picker.
    CFG.FONT_PREVIEW_ENABLED = TRUE
    IF _TRIM$(CFG.FONT_PREVIEW_SAMPLE$) = "" THEN CFG.FONT_PREVIEW_SAMPLE$ = "{Font} AaBb 123"
    KIT_SHOT_PATH$ = d + "kit-picker.png"
    KIT_picker_dialog pickTy
    KIT_SHOT_PATH$ = ""

    ' Install dialog read from the sample kit (skip the file picker).
    KIT_INSTALL_PATH$ = d + "sample-kit.zip"
    KIT_SHOT_SKIPPICK% = TRUE
    KIT_SHOT_PATH$ = d + "kit-install.png"
    r = KIT_install_dialog%
    KIT_SHOT_PATH$ = "": KIT_SHOT_SKIPPICK% = FALSE
END SUB
