''
' DRAW - GUI/TOOLBAR.BM
' =============================================================================
' Toolbar subs and functions.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Render the toolbar buttons onto SCRN.GUI&.
' Calculates column positions, loads icons lazily, draws active-tool indicator.
'
' @param xPos INTEGER Unused (position computed internally from layout)
' @param btnRangeStart INTEGER First button order index to render (inclusive)
' @param btnRangeEnd INTEGER Last button order index to render (inclusive)
'
SUB TOOLBAR_render(xPos%, btnRangeStart%, btnRangeEnd%)
    xPos% = xPos% ' position is computed internally from screen/config
    DIM AS INTEGER i, w, h, x, y, row, col, btnIdx
    DIM AS INTEGER TB_RIGHT, TB_COL2, TB_COL1, TB_COL0
    DIM AS INTEGER scale, scaled_w, scaled_h, scaled_padding
    
    ' Get toolbar scale from config (1-4, default 1)
    scale% = CFG.TOOLBAR_SCALE%
    IF scale% < 1 THEN scale% = 1
    IF scale% > 4 THEN scale% = 4
    
    ' Calculate scaled button dimensions
    scaled_w%       = TB_BTN_W * scale%
    scaled_h%       = TB_BTN_H * scale%
    scaled_padding% = TB_BTN_PADDING * scale%
    
    ' Calculate toolbar column positions left-to-right from SCRN.toolboxX%
    ' (SCREEN_compute_layout sets toolboxX based on TOOLBOX_DOCK_EDGE config).
    ' TB_RIGHT = x of the panel's LAST column (live layout: TOOLBAR_panel_cols%).
    TB_COL0  = SCRN.toolboxX% + 1
    TB_COL1  = TB_COL0 + scaled_w% + scaled_padding%
    TB_COL2  = TB_COL1 + scaled_w% + scaled_padding%
    TB_RIGHT = SCRN.toolboxX% + TOOLBOX_PANEL_W - 1 - scaled_w% ' panel_x2 = TB_RIGHT + scaled_w
    
    ' Draw toolbar background panel with border
    TOOLBAR_draw_background TB_COL0, TB_RIGHT, btnRangeStart%, btnRangeEnd%

    ' Register toolbar hitbox (matches TOOLBAR_is_over_area math)
    DIM tbRegX1 AS INTEGER, tbRegY1 AS INTEGER, tbRegX2 AS INTEGER, tbRegY2 AS INTEGER
    tbRegX1% = TB_COL0% - 1
    tbRegY1% = TB_TOP - 1
    tbRegX2% = TB_RIGHT% + scaled_w%
    tbRegY2% = TB_TOP + (TB_LIVE_ROWS * scaled_h%) + ((TB_LIVE_ROWS - 1) * scaled_padding%)
    REGION_set_bounds REGION_TOOLBAR, tbRegX1%, tbRegY1%, tbRegX2% - tbRegX1% + 1, tbRegY2% - tbRegY1% + 1, ZORDER_PANEL
    
    FOR i% = btnRangeStart% TO btnRangeEnd%
        ' Get the actual button index from the order array
        btnIdx% = TOOLBAR_BUTTON_ORDER(i%)
        
        ' Skip blank toolbar positions
        IF btnIdx% < 0 THEN GOTO TOOLBAR_render_next_button
        
        GUI_TB(btnIdx%).w% = scaled_w%
        GUI_TB(btnIdx%).h% = scaled_h%
        w%                 = GUI_TB(btnIdx%).w%
        h%                 = GUI_TB(btnIdx%).h%
        
        ' Row and column in the live grid (TB_LIVE_COLS per row; default 4)
        row% = i% \ TB_LIVE_COLS
        col% = i% MOD TB_LIVE_COLS
        x%   = TB_COL0 + col% * (scaled_w% + scaled_padding%)
        
        y% = TB_TOP + scaled_h% * row% + scaled_padding% * row%
        
        ' Store position for click handling
        GUI_TB(btnIdx%).x% = x%
        GUI_TB(btnIdx%).y% = y%
        
        ' Load primary icon if not already loaded (one-time initialization)
        ' Image handles are negative, so 0 means uninitialized
        IF GUI_TB(btnIdx%).iHnd& = 0 THEN
            DIM icon_path   AS STRING
            DIM themeImgDir AS STRING
            themeImgDir$          = "ASSETS/THEMES/" + _TRIM$(CFG.THEME$) + "/"
            icon_path$            = themeImgDir$ + "IMAGES/TOOLBOX/" + GUI_TB(btnIdx%).iSrc$
            GUI_TB(btnIdx%).iHnd& = _LOADIMAGE(icon_path$, 32)
        END IF
        
        ' Load alternate icon if button has one and not already loaded (one-time initialization)
        IF LEN(GUI_TB(btnIdx%).iSrcAlt$) > 0 AND GUI_TB(btnIdx%).iHndAlt& = 0 THEN
            DIM icon_path_alt AS STRING
            IF LEN(themeImgDir$) = 0 THEN themeImgDir$ = "ASSETS/THEMES/" + _TRIM$(CFG.THEME$) + "/"
            icon_path_alt$           = themeImgDir$ + "IMAGES/TOOLBOX/" + GUI_TB(btnIdx%).iSrcAlt$
            GUI_TB(btnIdx%).iHndAlt& = _LOADIMAGE(icon_path_alt$, 32)
        END IF
        
        ' Determine which icon handle to use for display
        DIM display_handle AS LONG
        display_handle& = GUI_TB(btnIdx%).iHnd&

        ' Swap fill icon when Grid Cell Fill is active
        IF TOOLBAR_BUTTON_TO_TOOL(i%) = TOOL_FILL AND GRID.CELL_FILL% THEN
            IF GUI_TB(btnIdx%).iHndAlt& < -1 THEN
                display_handle& = GUI_TB(btnIdx%).iHndAlt&
            END IF
        END IF

        ' Swap Smart Shapes parent icon to currently active sub-shape (session-only)
        IF btnIdx% = TB_SMART_SHAPES THEN
            DIM ssActiveIcon AS STRING
            ssActiveIcon$ = SMART_SHAPES_active_icon$
            IF ssActiveIcon$ <> _TRIM$(GUI_TB(btnIdx%).iSrc$) THEN
                ' Lazy-load alt icon for the currently selected child
                DIM ssDir                  AS STRING
                ssDir$ = "ASSETS/THEMES/" + _TRIM$(CFG.THEME$) + "/IMAGES/TOOLBOX/"
                STATIC ss_last_loaded_icon AS STRING
                STATIC ss_last_loaded_hnd  AS LONG
                IF ssActiveIcon$ <> ss_last_loaded_icon$ THEN
                    IF ss_last_loaded_hnd& < -1 THEN SAFE_FREEIMAGE ss_last_loaded_hnd&
                    ss_last_loaded_hnd&  = _LOADIMAGE(ssDir$ + ssActiveIcon$, 32)
                    ss_last_loaded_icon$ = ssActiveIcon$
                END IF
                IF ss_last_loaded_hnd& < -1 THEN display_handle& = ss_last_loaded_hnd&
            END IF
        END IF
        
        ' Workspace icon override (ICON.<name>=file): any size, scaled to the cell
        IF TB_ICON_OVR(btnIdx%) < -1 THEN
            _PUTIMAGE (x%, y%)-(x% + w% - 1, y% + h% - 1), TB_ICON_OVR(btnIdx%), SCRN.GUI&
            display_handle& = 0
        END IF

        ' Only draw if we have a valid handle
        IF display_handle& < -1 THEN
            ' Scale image from original 11x11 to scaled size (pixel perfect, no smoothing)
            _PUTIMAGE _
                (x%, y%)-(x% + w% - 1, y% + h% - 1), _
                display_handle&, _
                SCRN.GUI&, _
                (0, 0)-(TB_BTN_W - 1, TB_BTN_H - 1)
        END IF
        
        ' Draw indicator if this button's tool is active
        DIM is_active AS INTEGER
        is_active% = FALSE
        
        ' Check if this button's tool is active
        IF TOOLBAR_BUTTON_TO_TOOL(i%) = CURRENT_TOOL% THEN
            is_active% = TRUE
        END IF
        ' Smart Shapes button highlights when any of its sub-tools is active
        IF TOOLBAR_BUTTON_TO_TOOL(i%) = TOOL_SMART_SHAPES AND SMART_SHAPES_is_active% THEN
            is_active% = TRUE
        END IF
        IF TOOLBAR_BUTTON_TO_TOOL(i%) = TOOL_OPEN AND BROWSER.visible% THEN
            is_active% = TRUE
        END IF
        ' Selection tool variants: highlight the correct button when TOOL_MARQUEE is active
        IF CURRENT_TOOL% = TOOL_MARQUEE THEN
            DIM mappedTool AS INTEGER
            mappedTool% = TOOLBAR_BUTTON_TO_TOOL(i%)
            ' If crop mode is active, highlight crop button instead of any select button
            IF CROP.STATE = CROP_STATE_ACTIVE THEN
                IF mappedTool% = TOOL_CROP THEN
                    is_active% = TRUE
                ELSE
                    is_active% = FALSE
                END IF
            ELSE
                IF mappedTool% = TOOL_SELECT_RECT OR mappedTool% = TOOL_SELECT_WAND _
                OR mappedTool% = TOOL_SELECT_FREE OR mappedTool% = TOOL_SELECT_POLY _
                OR mappedTool% = TOOL_SELECT_ELLIPSE THEN
                    IF mappedTool% = MARQUEE.VARIANT THEN
                        is_active% = TRUE
                    END IF
                END IF
            END IF
        END IF
        
        ' Draw the active indicator
        IF is_active% THEN
            DIM overlayColor AS _UNSIGNED LONG
            DIM strokeColor  AS _UNSIGNED LONG
            DIM bt           AS INTEGER ' border thickness scaled with toolbar
            overlayColor~& = THEME.TOOLBAR_btn_overlay~&
            strokeColor~&  = THEME.TOOLBAR_btn_stroke~&
            bt%            = scale%
            IF bt% < 1 THEN bt% = 1
            LINE (x%, y%)-(x% + w%, y% + h%), overlayColor~&, BF
            ' Draw border as 4 non-overlapping filled rects so corners don't
            ' accumulate double alpha (which makes them appear brighter).
            ' Top edge
            LINE (x%, y%)-(x% + w% - 1, y% + bt% - 1), strokeColor~&, BF
            ' Bottom edge
            LINE (x%, y% + h% - bt%)-(x% + w% - 1, y% + h% - 1), strokeColor~&, BF
            ' Left edge (inset to avoid top/bottom corner overlap)
            LINE (x%, y% + bt%)-(x% + bt% - 1, y% + h% - bt% - 1), strokeColor~&, BF
            ' Right edge (inset to avoid top/bottom corner overlap)
            LINE (x% + w% - bt%, y% + bt%)-(x% + w% - 1, y% + h% - bt% - 1), strokeColor~&, BF
        END IF
        TOOLBAR_render_next_button:
    NEXT i%
END SUB

''
' Get the logical active toolbar tool, preserving marquee variants and crop mode.
' @return INTEGER - Active tool constant (TOOL_* or TOOL_SELECT_* for marquee variants)
'
FUNCTION TOOLBAR_active_tool_id% ()
    TOOLBAR_active_tool_id% = CURRENT_TOOL%

    IF CROP.STATE = CROP_STATE_ACTIVE THEN
        TOOLBAR_active_tool_id% = TOOL_CROP
        EXIT FUNCTION
    END IF

    IF CURRENT_TOOL% = TOOL_MARQUEE THEN
        IF MARQUEE.VARIANT = TOOL_SELECT_RECT OR MARQUEE.VARIANT = TOOL_SELECT_WAND _
        OR MARQUEE.VARIANT          = TOOL_SELECT_FREE OR MARQUEE.VARIANT = TOOL_SELECT_POLY _
        OR MARQUEE.VARIANT          = TOOL_SELECT_ELLIPSE THEN
            TOOLBAR_active_tool_id% = MARQUEE.VARIANT
        END IF
    END IF
END FUNCTION

''
' Check if mouse click is on a toolbar button and activate tool
' Returns TRUE if a button was clicked, FALSE if clicking empty toolbar area
' @param mouseX INTEGER Raw screen X coordinate of the click
' @param mouseY INTEGER Raw screen Y coordinate of the click
' @return INTEGER - TRUE if a toolbar button was clicked
'
FUNCTION TOOLBAR_handle_click%(mouseX%, mouseY%)
    DIM AS INTEGER i, btnIdx, x, y, w, h
    DIM AS INTEGER scale, scaled_w, scaled_h
    STATIC last_click_tool AS INTEGER
    STATIC dot_prev_tool   AS INTEGER
    
    ' Get toolbar scale from config (1-4, default 1)
    scale% = CFG.TOOLBAR_SCALE%
    IF scale% < 1 THEN scale% = 1
    IF scale% > 4 THEN scale% = 4
    
    ' Calculate scaled button dimensions
    scaled_w% = TB_BTN_W * scale%
    scaled_h% = TB_BTN_H * scale%
    
    ' Check all buttons using stored positions from rendering
    FOR i% = 0 TO TB_LIVE_COUNT - 1
        ' Get the actual button index from the order array
        btnIdx% = TOOLBAR_BUTTON_ORDER(i%)
        
        ' Skip blank toolbar positions
        IF btnIdx% < 0 THEN GOTO TOOLBAR_click_next_button
        
        ' Use stored positions from GUI_TB (set during TOOLBAR_render)
        x% = GUI_TB(btnIdx%).x%
        y% = GUI_TB(btnIdx%).y%
        w% = scaled_w%
        h% = scaled_h%
        
        IF mouseX% >= x% AND mouseX% < x% + w% AND mouseY% >= y% AND mouseY% < y% + h% THEN
            TOOLTIP_reset
            DIM tool_id    AS INTEGER
            DIM click_time AS DOUBLE
            ' Use position index (i%) for TOOLBAR_BUTTON_TO_TOOL, not button constant (btnIdx%)
            tool_id%    = TOOLBAR_BUTTON_TO_TOOL(i%)
            click_time# = TIMER

            IF tool_id% = TOOL_DOT THEN
                IF last_click_tool% = TOOL_DOT AND click_time# - MOUSE.B1_CLICK_TIME# < 0.3 THEN
                    IF CUSTOM_BRUSH_is_active% THEN
                        CUSTOM_BRUSH_reset
                        GUI_NEEDS_REDRAW% = TRUE
                    END IF

                    tool_id% = dot_prev_tool%
                    IF tool_id% = 0 THEN tool_id% = CURRENT_TOOL%

                    last_click_tool%     = 0
                    dot_prev_tool%       = 0
                    MOUSE.B1_CLICK_TIME# = 0
                ELSE
                    dot_prev_tool%       = TOOLBAR_active_tool_id%
                    last_click_tool%     = TOOL_DOT
                    MOUSE.B1_CLICK_TIME# = click_time#
                END IF
            ELSE
                last_click_tool%     = tool_id%
                MOUSE.B1_CLICK_TIME# = click_time#
            END IF
            
            ' Handle immediate action tools (load/save) - defer until after mouse processing
            ' Deferred actions: 1=save, 2=import image, 3=open DRW project, 4=export selection
            IF tool_id% = TOOL_SAVE THEN
                SOUND_play SND_TOOL_SELECT
                MOUSE.DEFERRED_ACTION%   = 1 ' 1 = save
                MOUSE.UI_CHROME_CLICKED% = TRUE
                TOOLBAR_handle_click%    = TRUE
                EXIT FUNCTION
            ELSEIF tool_id% = TOOL_OPEN THEN
                SOUND_play SND_TOOL_SELECT
                CMD_execute_action 2022      ' Toggle Browser
                MOUSE.UI_CHROME_CLICKED% = TRUE
                TOOLBAR_handle_click%    = TRUE
                EXIT FUNCTION
            ELSEIF tool_id% = TOOL_EXPORT_SEL THEN
                SOUND_play SND_TOOL_SELECT
                MOUSE.DEFERRED_ACTION%   = 4 ' 4 = export selection
                MOUSE.UI_CHROME_CLICKED% = TRUE
                TOOLBAR_handle_click%    = TRUE
                EXIT FUNCTION
            END IF
            
            ' Smart Shapes — open the sub-tool flyout AND immediately activate
            ' the last-chosen sub-shape. A quick click selects it (release with
            ' no hover keeps the activation); hold-and-drag over a different
            ' icon changes selection on release.
            IF tool_id% = TOOL_SMART_SHAPES THEN
                IF SMART_SHAPES_GROUP_IDX >= 0 THEN
                    DIM ssLastIdx AS INTEGER
                    ssLastIdx% = SUBTOOL_GROUPS(SMART_SHAPES_GROUP_IDX%).lastChildIdx
                    IF ssLastIdx% < 0 THEN ssLastIdx% = 0
                    IF ssLastIdx% < SUBTOOL_GROUPS(SMART_SHAPES_GROUP_IDX%).childCount THEN
                        DIM ssTool AS INTEGER
                        ssTool% = SUBTOOL_GROUP_CHILDREN(SMART_SHAPES_GROUP_IDX%, ssLastIdx%).toolConst
                        IF CURRENT_TOOL% <> ssTool% THEN
                            ' Cancel crop / reset move state, mirroring the normal
                            ' tool-switch path below.
                            IF CROP.STATE = CROP_STATE_ACTIVE THEN CROP_cancel
                            IF CURRENT_TOOL% = TOOL_MOVE AND MOVE.ACTIVE THEN MOVE_reset
                            PREVIOUS_TOOL% = CURRENT_TOOL%
                            CURRENT_TOOL%  = ssTool%
                            TOOLS_reset_all FALSE
                            IF CURRENT_TOOL% <> TOOL_FILL THEN FILL_deactivate
                            IF CURRENT_TOOL% = TOOL_PICKER THEN PICKER_activate ELSE PICKER_deactivate
                        END IF
                    END IF
                    SUBTOOL_FLYOUT_open SMART_SHAPES_GROUP_IDX%
                    SOUND_play SND_TOOL_SELECT
                    MOUSE.UI_CHROME_CLICKED% = TRUE
                    TOOLBAR_handle_click%    = TRUE
                    EXIT FUNCTION
                END IF
            END IF
            
            ' Crop button enters crop mode
            IF tool_id% = TOOL_CROP THEN
                SOUND_play SND_TOOL_SELECT
                CROP_begin
                MOUSE.UI_CHROME_CLICKED% = TRUE
                TOOLBAR_handle_click%    = TRUE
                EXIT FUNCTION
            END IF
            
            ' QB64/Code export (action button)
            IF tool_id% = TOOL_CODE THEN
                SOUND_play SND_TOOL_SELECT
                FILE_QB64_export_quick
                MOUSE.UI_CHROME_CLICKED% = TRUE
                TOOLBAR_handle_click%    = TRUE
                EXIT FUNCTION
            END IF
            
            ' Normal tool selection
            ' Cancel crop mode if switching away (only before drag starts)
            IF CROP.STATE = CROP_STATE_ACTIVE THEN
                CROP_cancel
            END IF
            ' Apply and reset move if switching away from move tool with active transform
            IF CURRENT_TOOL% = TOOL_MOVE AND MOVE.ACTIVE AND tool_id% <> TOOL_MOVE THEN
                MOVE_reset                   ' This applies the transform before switching
            END IF
            CURRENT_TOOL% = tool_id%
            TOOLS_reset_all FALSE           ' Reset all tools, preserve marquee selection
            ' Deactivate fill for non-fill tools
            IF CURRENT_TOOL% <> TOOL_FILL THEN FILL_deactivate
            IF CURRENT_TOOL% = TOOL_FILL THEN FILL_activate
            ' Activate/deactivate picker
            IF CURRENT_TOOL% = TOOL_PICKER THEN PICKER_activate ELSE PICKER_deactivate
            ' Left-click on marquee rect = regular rectangle mode (disable magic wand mode)
            IF tool_id% = TOOL_SELECT_RECT THEN
                ' Clear auto-created marquee from MOVE tool (preserve user-created ones)
                IF MARQUEE.ACTIVE% AND NOT MARQUEE.USER_CREATED THEN
                    MARQUEE_reset
                END IF
                MARQUEE.MAGIC_WAND_MODE = FALSE
                MARQUEE.VARIANT         = TOOL_SELECT_RECT
                ' Cancel any in-progress creation state but preserve existing selection
                FREEHAND_SEL_reset
                POLY_SEL_reset
                ELLIPSE_SEL_reset
                CURRENT_TOOL% = TOOL_MARQUEE
            END IF
            ' Magic wand selection mode
            IF tool_id% = TOOL_SELECT_WAND THEN
                CURRENT_TOOL%           = TOOL_MARQUEE
                MARQUEE.MAGIC_WAND_MODE = TRUE
                MARQUEE.VARIANT         = TOOL_SELECT_WAND
                ' Cancel any in-progress creation state but preserve existing selection
                FREEHAND_SEL_reset
                POLY_SEL_reset
                ELLIPSE_SEL_reset
            END IF
            ' Freehand, polygon, and ellipse selection tools
            IF tool_id% = TOOL_SELECT_FREE OR tool_id% = TOOL_SELECT_POLY OR tool_id% = TOOL_SELECT_ELLIPSE THEN
                CURRENT_TOOL%           = TOOL_MARQUEE
                MARQUEE.MAGIC_WAND_MODE = FALSE
                MARQUEE.VARIANT         = tool_id%
                ' Cancel any in-progress creation state but preserve existing selection
                FREEHAND_SEL_reset
                POLY_SEL_reset
                ELLIPSE_SEL_reset
            END IF
            ' Eraser tool — force transparent painting
            IF tool_id% = TOOL_ERASER THEN
                ERASER_activate
            ELSE
                ERASER_deactivate
            END IF
            ' Capture selection when switching to move tool (handles both marquee and full-layer cases)
            IF tool_id% = TOOL_MOVE THEN
                MOVE_capture_selection
            END IF
            ' Reset all other tools when switching to pan
            IF tool_id% = TOOL_PAN THEN
                ' Check for double-click to fit canvas in viewport
                STATIC panClickTime  AS DOUBLE
                DIM panNow           AS DOUBLE
                panNow# = TIMER
                IF panNow# - panClickTime# < 0.3 THEN
                    ZOOM_fit_canvas
                    panClickTime# = 0
                ELSE
                    panClickTime# = panNow#
                END IF
                TOOLS_reset_all FALSE
            END IF
            ' Reset other tools when switching to zoom
            IF tool_id% = TOOL_ZOOM THEN
                ' Check for double-click to zoom to 100% and swap to hand tool
                STATIC zoomClickTime AS DOUBLE
                DIM zoomNow          AS DOUBLE
                zoomNow# = TIMER
                IF zoomNow# - zoomClickTime# < 0.3 THEN
                    ZOOM_reset
                    CURRENT_TOOL%  = TOOL_PAN
                    zoomClickTime# = 0
                ELSE
                    zoomClickTime# = zoomNow#
                END IF
                TOOLS_reset_all FALSE
            END IF
            SOUND_play SND_TOOL_SELECT
            ' Force full scene rebuild: GUI-only path would restore stale SCENE_CACHE&
            ' (which has the old TEXT BAR baked in) and a transparent GUI overlay
            ' wouldn't erase it.  SCENE_DIRTY% ensures the full path runs.
            GUI_NEEDS_REDRAW%        = TRUE
            SCENE_DIRTY%             = TRUE
            FRAME_IDLE%              = FALSE
            MOUSE.UI_CHROME_CLICKED% = TRUE ' Flag that toolbar was clicked
            TOOLBAR_handle_click%    = TRUE
            EXIT FUNCTION
        END IF
        TOOLBAR_click_next_button:
    NEXT i%
    
    ' No button was clicked - return FALSE to allow canvas interaction
    TOOLBAR_handle_click% = FALSE
END FUNCTION

''
' Handle right-click on toolbar buttons for alternate tool modes
' @param mouseX INTEGER Raw screen X coordinate of the right-click
' @param mouseY INTEGER Raw screen Y coordinate of the right-click
'
SUB TOOLBAR_handle_right_click(mouseX%, mouseY%)
    DIM AS INTEGER i, btnIdx, x, y, w, h
    DIM AS INTEGER scale, scaled_w, scaled_h
    
    ' Get toolbar scale from config (1-4, default 1)
    scale% = CFG.TOOLBAR_SCALE%
    IF scale% < 1 THEN scale% = 1
    IF scale% > 4 THEN scale% = 4
    
    ' Calculate scaled button dimensions
    scaled_w% = TB_BTN_W * scale%
    scaled_h% = TB_BTN_H * scale%
    
    ' Check all buttons using stored positions from rendering
    FOR i% = 0 TO TB_LIVE_COUNT - 1
        ' Get the actual button index from the order array
        btnIdx% = TOOLBAR_BUTTON_ORDER(i%)
        
        ' Skip blank toolbar positions
        IF btnIdx% < 0 THEN GOTO TOOLBAR_rclick_next_button
        
        ' Use stored positions from GUI_TB (set during TOOLBAR_render)
        x% = GUI_TB(btnIdx%).x%
        y% = GUI_TB(btnIdx%).y%
        w% = scaled_w%
        h% = scaled_h%
        
        IF mouseX% >= x% AND mouseX% < x% + w% AND mouseY% >= y% AND mouseY% < y% + h% THEN
            DIM tool_id AS INTEGER
            ' Use position index (i%) for TOOLBAR_BUTTON_TO_TOOL, not button constant (btnIdx%)
            tool_id% = TOOLBAR_BUTTON_TO_TOOL(i%)
            IF tool_id% = TOOL_TEXT THEN
                CURRENT_TOOL%     = TOOL_TEXT
                GUI_NEEDS_REDRAW% = TRUE
                TEXT.USE_TINY5    = TRUE
                TEXT.CHAR_WIDTH   = 5
                TEXT.LINE_HEIGHT  = 6        ' 5px font + 1px gap
                TEXT_reset
                MOUSE.UI_CHROME_CLICKED% = TRUE
            END IF
            
            ' Right-click on Open tool = open DRW project dialog
            IF tool_id% = TOOL_OPEN THEN
                MOUSE.DEFERRED_ACTION%   = 3 ' 3 = open DRW project
                MOUSE.UI_CHROME_CLICKED% = TRUE
            END IF
            
            EXIT SUB
        END IF
        TOOLBAR_rclick_next_button:
    NEXT i%
END SUB
''
' Handle middle-click on toolbar buttons for special modes.
' Middle-click on Text tool opens a file dialog to load a custom font.
'
' @param mouseX INTEGER Raw screen X coordinate of the click
' @param mouseY INTEGER Raw screen Y coordinate of the click
'
SUB TOOLBAR_handle_middle_click(mouseX%, mouseY%)
    DIM AS INTEGER i, btnIdx, x, y, w, h
    DIM AS INTEGER scale, scaled_w, scaled_h
    
    ' Get toolbar scale from config (1-4, default 1)
    scale% = CFG.TOOLBAR_SCALE%
    IF scale% < 1 THEN scale% = 1
    IF scale% > 4 THEN scale% = 4
    
    ' Calculate scaled button dimensions
    scaled_w% = TB_BTN_W * scale%
    scaled_h% = TB_BTN_H * scale%
    
    ' Check all buttons using stored positions from rendering
    FOR i% = 0 TO TB_LIVE_COUNT - 1
        ' Get the actual button index from the order array
        btnIdx% = TOOLBAR_BUTTON_ORDER(i%)
        
        ' Skip blank toolbar positions
        IF btnIdx% < 0 THEN GOTO TOOLBAR_mclick_next_button
        
        ' Use stored positions from GUI_TB (set during TOOLBAR_render)
        x% = GUI_TB(btnIdx%).x%
        y% = GUI_TB(btnIdx%).y%
        w% = scaled_w%
        h% = scaled_h%
        
        IF mouseX% >= x% AND mouseX% < x% + w% AND mouseY% >= y% AND mouseY% < y% + h% THEN
            DIM tool_id AS INTEGER
            ' Use position index (i%) for TOOLBAR_BUTTON_TO_TOOL, not button constant (btnIdx%)
            tool_id% = TOOLBAR_BUTTON_TO_TOOL(i%)
            
            ' Middle-click on Text tool = Load custom font
            IF tool_id% = TOOL_TEXT THEN
                _LOGINFO "Middle-click detected on text tool"
                DIM fontPath       AS STRING
                DIM loadedFontSize AS INTEGER
                POINTER_hide_for_dialog
                fontPath$ = DRAW_open_file$("Select Custom Font", "ASSETS/FONTS/", "Font Files|*.ttf|*.TTF|*.otf|*.OTF", 0)
                POINTER_show_after_dialog
                ' Clear input buffers after dialog
                DO WHILE _MOUSEINPUT : LOOP
                _KEYCLEAR
                MOUSE_force_buttons_up
                _LOGINFO "Font dialog returned: " + fontPath$
                IF LEN(fontPath$) > 0 THEN
                    ' Free existing custom font if loaded
                    IF TEXT.CUSTOM_FONT_HANDLE > 0 THEN
                        _LOGINFO "Freeing existing custom font handle: " + STR$(TEXT.CUSTOM_FONT_HANDLE)
                        _FREEFONT TEXT.CUSTOM_FONT_HANDLE
                    END IF
                    ' Load the new custom font - try different approaches until success
                    _LOGINFO "Loading custom font from: " + fontPath$
                    loadedFontSize% = 0
                    
                    ' Try 1: Size 16 with natural kerning and hinting, no anti-aliasing
                    TEXT.CUSTOM_FONT_HANDLE = _LOADFONT(fontPath$, 16, "DONTBLEND")
                    IF TEXT.CUSTOM_FONT_HANDLE > 0 THEN loadedFontSize% = 16
                    _LOGINFO "Attempt 1 (size 16, DONTBLEND): handle = " + STR$(TEXT.CUSTOM_FONT_HANDLE)
                    
                    IF TEXT.CUSTOM_FONT_HANDLE <= 0 THEN
                        ' Try 2: Size 12 (only if attempt 1 failed)
                        TEXT.CUSTOM_FONT_HANDLE = _LOADFONT(fontPath$, 12, "DONTBLEND")
                        IF TEXT.CUSTOM_FONT_HANDLE > 0 THEN loadedFontSize% = 12
                        _LOGINFO "Attempt 2 (size 12, DONTBLEND): handle = " + STR$(TEXT.CUSTOM_FONT_HANDLE)
                    END IF
                    
                    IF TEXT.CUSTOM_FONT_HANDLE <= 0 THEN
                        ' Try 3: Size 8 (only if previous attempts failed)
                        TEXT.CUSTOM_FONT_HANDLE = _LOADFONT(fontPath$, 8, "DONTBLEND")
                        IF TEXT.CUSTOM_FONT_HANDLE > 0 THEN loadedFontSize% = 8
                        _LOGINFO "Attempt 3 (size 8, DONTBLEND): handle = " + STR$(TEXT.CUSTOM_FONT_HANDLE)
                    END IF
                    
                    IF TEXT.CUSTOM_FONT_HANDLE <= 0 THEN
                        ' Try 4: Size 20 (larger fallback)
                        TEXT.CUSTOM_FONT_HANDLE = _LOADFONT(fontPath$, 20, "DONTBLEND")
                        IF TEXT.CUSTOM_FONT_HANDLE > 0 THEN loadedFontSize% = 20
                        _LOGINFO "Attempt 4 (size 20, DONTBLEND): handle = " + STR$(TEXT.CUSTOM_FONT_HANDLE)
                    END IF
                    IF TEXT.CUSTOM_FONT_HANDLE > 0 THEN
                        ' Successfully loaded
                        TEXT.CUSTOM_FONT_PATH    = fontPath$
                        TEXT.CUSTOM_FONT_SIZE    = loadedFontSize%
                        MOUSE.UI_CHROME_CLICKED% = TRUE
                        _LOGINFO "Custom font successfully loaded! Handle: " + STR$(TEXT.CUSTOM_FONT_HANDLE)
                    ELSE
                        _LOGINFO "ERROR: Failed to load custom font! Final handle: " + STR$(TEXT.CUSTOM_FONT_HANDLE)
                        TEXT.CUSTOM_FONT_HANDLE = 0
                        TEXT.CUSTOM_FONT_PATH   = ""
                        TEXT.CUSTOM_FONT_SIZE   = 0
                    END IF
                ELSE
                    _LOGINFO "Font selection cancelled"
                END IF
            END IF
            EXIT SUB
        END IF
        TOOLBAR_mclick_next_button:
    NEXT i%
END SUB

''
' Check if mouse position is over any toolbar button (for auto-hide)
' Returns TRUE if over a button, FALSE if over empty toolbar area
' @param mouseX INTEGER Raw screen X coordinate to test
' @param mouseY INTEGER Raw screen Y coordinate to test
' @return INTEGER - TRUE if hovering over a toolbar button
'
FUNCTION TOOLBAR_is_over_button%(mouseX%, mouseY%)
    DIM AS INTEGER i, btnIdx, x, y, w, h
    DIM AS INTEGER scale, scaled_w, scaled_h
    
    ' Get toolbar scale from config (1-4, default 1)
    scale% = CFG.TOOLBAR_SCALE%
    IF scale% < 1 THEN scale% = 1
    IF scale% > 4 THEN scale% = 4
    
    ' Calculate scaled button dimensions
    scaled_w% = TB_BTN_W * scale%
    scaled_h% = TB_BTN_H * scale%
    
    ' Check all buttons using stored positions from rendering
    FOR i% = 0 TO TB_LIVE_COUNT - 1
        ' Get the actual button index from the order array
        btnIdx% = TOOLBAR_BUTTON_ORDER(i%)
        
        ' Skip blank toolbar positions
        IF btnIdx% < 0 THEN GOTO TOOLBAR_over_next_button
        
        ' Use stored positions from GUI_TB (set during TOOLBAR_render)
        x% = GUI_TB(btnIdx%).x%
        y% = GUI_TB(btnIdx%).y%
        w% = scaled_w%
        h% = scaled_h%
        
        IF mouseX% >= x% AND mouseX% < x% + w% AND mouseY% >= y% AND mouseY% < y% + h% THEN
            TOOLBAR_is_over_button% = TRUE
            EXIT FUNCTION
        END IF
        TOOLBAR_over_next_button:
    NEXT i%
    
    ' Not over any button
    TOOLBAR_is_over_button% = FALSE
END FUNCTION

''
' Draw toolbar background panel with border
' @param TB_COL0 INTEGER Left X coordinate of the toolbar column
' @param TB_RIGHT INTEGER Right X coordinate of the toolbar column
' @param btnRangeStart INTEGER First button index in the visible range
' @param btnRangeEnd INTEGER Last button index in the visible range
' 
SUB TOOLBAR_draw_background(TB_COL0%, TB_RIGHT%, btnRangeStart%, btnRangeEnd%)
    DIM AS INTEGER panel_x1, panel_y1, panel_x2, panel_y2
    DIM AS INTEGER num_rows
    DIM AS INTEGER scale, scaled_w, scaled_h, scaled_padding
    DIM bg_color     AS _UNSIGNED LONG
    DIM border_color AS _UNSIGNED LONG
    
    ' Get toolbar scale from config (1-4, default 1)
    scale% = CFG.TOOLBAR_SCALE%
    IF scale% < 1 THEN scale% = 1
    IF scale% > 4 THEN scale% = 4
    
    ' Calculate scaled button dimensions
    scaled_w%       = TB_BTN_W * scale%
    scaled_h%       = TB_BTN_H * scale%
    scaled_padding% = TB_BTN_PADDING * scale%
    
    ' Calculate number of rows needed (live columns per row)
    num_rows% = ((btnRangeEnd% - btnRangeStart% + 1) + (TB_LIVE_COLS - 1)) \ TB_LIVE_COLS
    IF num_rows% < 1 THEN num_rows% = 1
    
    ' Calculate panel bounds
    panel_x1% = TB_COL0% - 1                                                           ' 1px padding on left
    panel_y1% = TB_TOP - 1                                                             ' 1px padding on top
    panel_x2% = TB_RIGHT% + scaled_w%                                                  ' Right edge of right column
    panel_y2% = TB_TOP + (num_rows% * scaled_h%) + ((num_rows% - 1) * scaled_padding%) ' Bottom edge
    
    ' Get colors from theme settings (direct RGB32 values, not palette indices)
    bg_color~&     = THEME.TOOLBAR_bg~&
    border_color~& = THEME.TOOLBAR_border_fg~&
    
    ' Draw filled background
    LINE (panel_x1%, panel_y1%)-(panel_x2%, panel_y2%), bg_color~&, BF
    
    ' Draw 1px border
    LINE (panel_x1%, panel_y1%)-(panel_x2%, panel_y2%), border_color~&, B
END SUB

''
' Check if mouse position is over the toolbar area (including background panel)
' Returns TRUE if over the entire toolbar area, FALSE otherwise
' @param mouseX INTEGER Raw screen X coordinate to test
' @param mouseY INTEGER Raw screen Y coordinate to test
' @return INTEGER - TRUE if hovering over the toolbar area
' 
FUNCTION TOOLBAR_is_over_area%(mouseX%, mouseY%)
    DIM AS INTEGER TB_RIGHT, TB_COL0
    DIM AS INTEGER panel_x1, panel_y1, panel_x2, panel_y2
    DIM AS INTEGER num_rows
    DIM AS INTEGER scale, scaled_w, scaled_h, scaled_padding
    
    ' Get toolbar scale from config (1-4, default 1)
    scale% = CFG.TOOLBAR_SCALE%
    IF scale% < 1 THEN scale% = 1
    IF scale% > 4 THEN scale% = 4
    
    ' Calculate scaled button dimensions
    scaled_w%       = TB_BTN_W * scale%
    scaled_h%       = TB_BTN_H * scale%
    scaled_padding% = TB_BTN_PADDING * scale%
    
    ' Calculate toolbar column positions left-to-right from SCRN.toolboxX%
    TB_COL0 = SCRN.toolboxX% + 1
    DIM AS INTEGER TB_COL2, TB_COL1
    TB_COL1  = TB_COL0 + scaled_w% + scaled_padding%
    TB_COL2  = TB_COL1 + scaled_w% + scaled_padding%
    TB_RIGHT = SCRN.toolboxX% + TOOLBOX_PANEL_W - 1 - scaled_w% ' panel_x2 = TB_RIGHT + scaled_w
    
    ' Calculate number of rows
    num_rows% = TB_LIVE_ROWS
    
    ' Calculate panel bounds (same as TOOLBAR_draw_background)
    panel_x1% = TB_COL0% - 1
    panel_y1% = TB_TOP - 1
    panel_x2% = TB_RIGHT% + scaled_w%
    panel_y2% = TB_TOP + (num_rows% * scaled_h%) + ((num_rows% - 1) * scaled_padding%)
    
    ' Check if mouse is within panel bounds
    IF mouseX% >= panel_x1% AND mouseX% <= panel_x2% AND mouseY% >= panel_y1% AND mouseY% <= panel_y2% THEN
        TOOLBAR_is_over_area% = TRUE
    ELSE
        TOOLBAR_is_over_area% = FALSE
    END IF
END FUNCTION


' =============================================================================
' Live layout (workspaces). The default 4x7 grid lives in TOOLBAR.BI; a
' workspace [TOOLBOX] BUTTONS=/COLUMNS= rewrites the slot arrays here.
' =============================================================================

''
' Width in px of a toolbox panel holding c button columns (incl. 1px borders).
FUNCTION TOOLBAR_cols_w% (c AS INTEGER)
    DIM scl AS INTEGER
    scl = CFG.TOOLBAR_SCALE%
    IF scl < 1 THEN scl = 1
    IF scl > 4 THEN scl = 4
    TOOLBAR_cols_w% = c * TB_BTN_W * scl + (c - 1) * TB_BTN_PADDING * scl + 2
END FUNCTION


''
' Height in px of the toolbar buttons block at TB_LIVE_ROWS.
FUNCTION TOOLBAR_rows_h% ()
    DIM scl AS INTEGER
    scl = CFG.TOOLBAR_SCALE%
    IF scl < 1 THEN scl = 1
    IF scl > 4 THEN scl = 4
    TOOLBAR_rows_h% = TB_LIVE_ROWS * TB_BTN_H * scl + (TB_LIVE_ROWS - 1) * TB_BTN_PADDING * scl
END FUNCTION


''
' Fit the toolbox column to its content (called by SCREEN_compute_layout):
'   * TB_WANT_COLS button columns, plus more while the buttons, the organizer
'     and a usable drawer don't fit the window height;
'   * TOOLBOX_PANEL_W = those columns' width, but never narrower than one
'     organizer stack / one drawer bin (their scales can be larger).
' The organizer and drawer reflow into whatever width results.
SUB TOOLBAR_reflow ()
    DIM AS INTEGER c, n, availH, need, minW, orgScl, drwScl
    n = TB_LIVE_COUNT
    IF n < 1 THEN n = 1
    IF TB_WANT_COLS = 0 THEN TB_WANT_COLS = CFG.TOOLBOX_COLUMNS%
    c = TB_WANT_COLS
    IF c < 1 THEN c = 1
    IF c > 8 THEN c = 8
    orgScl = USCALE.organizer%: IF orgScl < 1 THEN orgScl = 1
    drwScl = USCALE.drawer%: IF drwScl < 1 THEN drwScl = 1
    IF ORGANIZER.visible% THEN minW = ORG_COL_W * orgScl + 2
    IF DRAWER.visible% _ANDALSO minW < DRAWER_min_w% THEN minW = DRAWER_min_w%
    availH = SCRN.h& - SCREEN_bottom_bars_h%
    DO
        TB_LIVE_COLS = c
        TB_LIVE_ROWS = (n + c - 1) \ c
        TOOLBOX_PANEL_W = TOOLBAR_cols_w%(c)
        IF TOOLBOX_PANEL_W < minW THEN TOOLBOX_PANEL_W = minW
        need = TB_TOP + TOOLBAR_rows_h% + 1 + ORGANIZER_height_for%
        IF DRAWER.visible% THEN need = need + 40 * drwScl
        IF need <= availH _ORELSE c >= 8 _ORELSE c >= n THEN EXIT DO
        c = c + 1
    LOOP
END SUB


''
' Kept for callers: the toolbox's live button columns.
FUNCTION TOOLBAR_panel_cols% ()
    TOOLBAR_panel_cols% = TB_LIVE_COLS
END FUNCTION


''
' Default-grid slot of a TB_* button (tooltip text is keyed by it), -1 = none.
FUNCTION TOOLBAR_default_slot% (btn AS INTEGER)
    DIM i AS INTEGER
    TOOLBAR_default_slot% = -1
    FOR i = 0 TO TB_TOTAL - 1
        IF TOOLBAR_DEF_ORDER(i) = btn THEN TOOLBAR_default_slot% = i: EXIT FUNCTION
    NEXT i
END FUNCTION


''
' Workspace button name -> TB_* button and TOOL_* tool. Returns FALSE when
' the name is unknown. "-" / "|" / "space" = an empty cell (btn -1).
FUNCTION TOOLBAR_button_by_name% (nm AS STRING, outBtn AS INTEGER, outTool AS INTEGER)
    DIM b AS INTEGER
    b = -2
    SELECT CASE LCASE$(_TRIM$(nm))
        CASE "-", "|", "space", "gap":          b = -1
        CASE "move":                            b = TB_MOVE
        CASE "hand", "pan":                     b = TB_HAND
        CASE "zoom":                            b = TB_ZOOM
        CASE "crop":                            b = TB_CROP
        CASE "marquee", "select":               b = TB_SELECT
        CASE "marquee-free", "lasso":           b = TB_MARQUEE_FREEHAND
        CASE "marquee-poly":                    b = TB_MARQUEE_POLY
        CASE "marquee-ellipse":                 b = TB_MARQUEE_ELLIPSE
        CASE "wand", "magic-wand":              b = TB_MARQUEE_WAND
        CASE "picker", "eyedropper":            b = TB_PICKER
        CASE "text":                            b = TB_TEXT
        CASE "eraser":                          b = TB_ERASER
        CASE "dot", "pset":                     b = TB_PSET
        CASE "brush":                           b = TB_BRUSH
        CASE "spray":                           b = TB_SPRAY
        CASE "fill", "paint":                   b = TB_PAINT
        CASE "line":                            b = TB_LINE
        CASE "polygon":                         b = TB_POLYGON
        CASE "polygon-filled":                  b = TB_POLYGON_FILLED
        CASE "save":                            b = TB_SAVE
        CASE "bezier":                          b = TB_BEZIER
        CASE "rect", "rectangle":               b = TB_RECT
        CASE "rect-filled":                     b = TB_RECT_FILLED
        CASE "export-sel", "export-selection":  b = TB_EXPORT_SEL
        CASE "smart-shapes":                    b = TB_SMART_SHAPES
        CASE "ellipse", "circle":               b = TB_CIRCLE
        CASE "ellipse-filled":                  b = TB_CIRCLE_FILLED
        CASE "open":                            b = TB_OPEN
    END SELECT
    IF b = -2 THEN EXIT FUNCTION
    outBtn = b
    outTool = -1
    IF b >= 0 THEN
        ' the tool comes from the default grid (the one source of the mapping)
        DIM s AS INTEGER
        s = TOOLBAR_default_slot%(b)
        IF s >= 0 THEN outTool = TOOLBAR_DEF_TO_TOOL(s)
    END IF
    TOOLBAR_button_by_name% = TRUE
END FUNCTION


''
' Put the default grid back (and drop icon overrides).
SUB TOOLBAR_layout_restore ()
    DIM i AS INTEGER
    FOR i = 0 TO TB_MAX_SLOTS - 1
        IF i < TB_TOTAL THEN
            TOOLBAR_BUTTON_ORDER(i) = TOOLBAR_DEF_ORDER(i)
            TOOLBAR_BUTTON_TO_TOOL(i) = TOOLBAR_DEF_TO_TOOL(i)
        ELSE
            TOOLBAR_BUTTON_ORDER(i) = -1
            TOOLBAR_BUTTON_TO_TOOL(i) = -1
        END IF
    NEXT i
    TB_LIVE_COUNT = TB_TOTAL
    TB_WANT_COLS = CFG.TOOLBOX_COLUMNS%
    IF TB_WANT_COLS < 1 _ORELSE TB_WANT_COLS > 8 THEN TB_WANT_COLS = TB_COLS
    TB_LIVE_COLS = TB_WANT_COLS
    TB_LIVE_ROWS = (TB_LIVE_COUNT + TB_LIVE_COLS - 1) \ TB_LIVE_COLS
    FOR i = 0 TO 29
        IF TB_ICON_OVR(i) < -1 THEN _FREEIMAGE TB_ICON_OVR(i)
        TB_ICON_OVR(i) = 0
    NEXT i
    TOOLTIP_reset
    INVALIDATE_scene
END SUB


''
' Lay the toolbar out from a comma list of button names and a column count.
' Unknown names are skipped (logged). Returns the number of slots used
' (0 = nothing usable: the layout is left unchanged).
FUNCTION TOOLBAR_layout_apply% (buttons AS STRING, cols AS INTEGER)
    DIM n AS INTEGER, i AS INTEGER, used AS INTEGER, b AS INTEGER, t AS INTEGER, nm AS STRING, c AS INTEGER
    DIM newOrder(0 TO TB_MAX_SLOTS - 1) AS INTEGER, newTool(0 TO TB_MAX_SLOTS - 1) AS INTEGER
    n = WS_list_count%(buttons)
    FOR i = 1 TO n
        nm = WS_list_item$(buttons, i)
        IF TOOLBAR_button_by_name%(nm, b, t) THEN
            IF used < TB_MAX_SLOTS THEN
                newOrder(used) = b
                newTool(used) = t
                used = used + 1
            END IF
        ELSE
            _LOGINFO "TOOLBAR: workspace button '" + nm + "' is not a toolbox button (yet) - skipped"
        END IF
    NEXT i
    IF used = 0 THEN EXIT FUNCTION
    FOR i = 0 TO TB_MAX_SLOTS - 1
        IF i < used THEN
            TOOLBAR_BUTTON_ORDER(i) = newOrder(i)
            TOOLBAR_BUTTON_TO_TOOL(i) = newTool(i)
        ELSE
            TOOLBAR_BUTTON_ORDER(i) = -1
            TOOLBAR_BUTTON_TO_TOOL(i) = -1
        END IF
    NEXT i
    c = cols ' (by-reference param: work on a copy)
    IF c < 1 THEN c = CFG.TOOLBOX_COLUMNS%
    IF c < 1 THEN c = TB_COLS
    IF c > 8 THEN c = 8
    TB_LIVE_COUNT = used
    TB_WANT_COLS = c
    TB_LIVE_COLS = c
    TB_LIVE_ROWS = (used + c - 1) \ c
    TOOLTIP_reset
    INVALIDATE_scene
    TOOLBAR_layout_apply% = used
END FUNCTION


''
' ICON.<name>=file for a workspace: theme-relative (IMAGES/TOOLBOX/) or a
' path. Returns FALSE when the name or image is bad.
FUNCTION TOOLBAR_icon_override% (nm AS STRING, fileSpec AS STRING)
    DIM b AS INTEGER, t AS INTEGER, f AS STRING, img AS LONG
    IF TOOLBAR_button_by_name%(nm, b, t) = 0 THEN EXIT FUNCTION
    IF b < 0 _ORELSE b > 29 THEN EXIT FUNCTION
    f = _TRIM$(fileSpec)
    IF _FILEEXISTS(f) = 0 THEN f = "ASSETS/THEMES/" + _TRIM$(CFG.THEME$) + "/IMAGES/TOOLBOX/" + _TRIM$(fileSpec)
    IF _FILEEXISTS(f) = 0 THEN f = WS_user_dir$ + PATHS_sep$ + _TRIM$(fileSpec)
    IF _FILEEXISTS(f) = 0 THEN EXIT FUNCTION
    img = _LOADIMAGE(f, 32)
    IF img >= -1 THEN EXIT FUNCTION
    IF TB_ICON_OVR(b) < -1 THEN _FREEIMAGE TB_ICON_OVR(b)
    TB_ICON_OVR(b) = img
    TOOLBAR_icon_override% = TRUE
END FUNCTION
