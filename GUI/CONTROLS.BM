''
' DRAW - GUI/CONTROLS.BM
' =============================================================================
' Customize Controls dialog (Phase 4). Blocking modal on DIALOG_CTX, mirrors
' SETTINGS_show_dialog. Reads the live input registry (INPUT_BINDS) and lists the
' keyboard bindings by category with their current keys.
'
' 4.1 (this file): scaffold — open/close, registry read, category grouping,
' wheel scroll, FIND box drawn, per-row rebind buttons drawn (inert). Rebind
' capture + filter typing + conflict badges + persistence land in 4.2+.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Category display name. Local (no dependency on the generator's SUB-local names).
'
FUNCTION CTRL_cat_name$ (cat AS INTEGER)
    SELECT CASE cat
        CASE CAT_GLOBAL:    CTRL_cat_name$ = "GLOBAL / APPLICATION"
        CASE CAT_FILE:      CTRL_cat_name$ = "FILE"
        CASE CAT_EDIT:      CTRL_cat_name$ = "EDIT / HISTORY / CLIPBOARD"
        CASE CAT_VIEW:      CTRL_cat_name$ = "VIEW / ZOOM / PAN"
        CASE CAT_TOOLS:     CTRL_cat_name$ = "TOOLS"
        CASE CAT_SELECTION: CTRL_cat_name$ = "SELECTION"
        CASE CAT_LAYERS:    CTRL_cat_name$ = "LAYERS / GROUPS"
        CASE CAT_COLOR:     CTRL_cat_name$ = "COLOR / PALETTE"
        CASE CAT_GRID:      CTRL_cat_name$ = "GRID / SYMMETRY"
        CASE CAT_TEXT:      CTRL_cat_name$ = "TEXT / CHARACTER MAP"
        CASE CAT_BRUSH:     CTRL_cat_name$ = "BRUSH / CUSTOM BRUSH"
        CASE CAT_TRANSFORM: CTRL_cat_name$ = "TRANSFORM"
        CASE CAT_IMAGE:     CTRL_cat_name$ = "IMAGE / ADJUSTMENTS / EFFECTS"
        CASE CAT_PANELS:    CTRL_cat_name$ = "PANELS"
        CASE CAT_AUDIO:     CTRL_cat_name$ = "AUDIO"
        CASE CAT_MOUSE:     CTRL_cat_name$ = "MOUSE"
        CASE ELSE:          CTRL_cat_name$ = "OTHER"
    END SELECT
END FUNCTION


''
' Rendered current key for a binding row: "Ctrl+Shift+H", "F12", etc.
' Reuses the generator's shared keycode/mod renderers (OUTPUT/SHORTCUTS-DUMP.BM).
'
FUNCTION CTRL_current_key$ (bindIdx AS INTEGER)
    DIM s AS STRING
    s$ = SHORTCUTS_modstr$(INPUT_BINDS(bindIdx).requireMods) + SHORTCUTS_keyname$(INPUT_BINDS(bindIdx).keycode)
    CTRL_current_key$ = s$
END FUNCTION


''
' Does binding i pass the current FIND filter? Empty filter matches everything.
'
FUNCTION CTRL_row_matches% (bindIdx AS INTEGER)
    IF CONTROLS.filterLen = 0 THEN CTRL_row_matches% = TRUE: EXIT FUNCTION
    DIM lbl AS STRING, flt AS STRING
    lbl$ = LCASE$(_TRIM$(RTRIM$(INPUT_BINDS(bindIdx).label)))
    flt$ = LCASE$(_TRIM$(LEFT$(CONTROLS.filter, CONTROLS.filterLen)))
    IF INSTR(lbl$, flt$) > 0 THEN CTRL_row_matches% = TRUE ELSE CTRL_row_matches% = FALSE
END FUNCTION


''
' Rebuild the flattened, filtered display list (category headers + binding rows)
' from the live registry. Keyboard bindings only (keycode <> 0), grouped by CAT_*.
'
SUB CONTROLS_rebuild_vis ()
    REDIM CTRL_VISROWS(1 TO INPUT_BIND_COUNT + 20) AS CTRL_VISROW
    DIM n AS INTEGER, cat AS INTEGER, i AS INTEGER, hasAny AS INTEGER
    n = 0
    FOR cat = 1 TO 16
        hasAny = FALSE
        FOR i = 1 TO INPUT_BIND_COUNT
            IF INPUT_BINDS(i).category = cat AND INPUT_BINDS(i).keycode <> 0 THEN
                IF CTRL_row_matches%(i) THEN hasAny = TRUE: EXIT FOR
            END IF
        NEXT
        IF hasAny THEN
            n = n + 1
            CTRL_VISROWS(n).isHeader = TRUE
            CTRL_VISROWS(n).cat = cat
            CTRL_VISROWS(n).bindIdx = 0
            FOR i = 1 TO INPUT_BIND_COUNT
                IF INPUT_BINDS(i).category = cat AND INPUT_BINDS(i).keycode <> 0 THEN
                    IF CTRL_row_matches%(i) THEN
                        n = n + 1
                        CTRL_VISROWS(n).isHeader = FALSE
                        CTRL_VISROWS(n).cat = cat
                        CTRL_VISROWS(n).bindIdx = i
                    END IF
                END IF
            NEXT
        END IF
    NEXT
    CONTROLS.visCount = n

    DIM totH AS INTEGER
    totH = 0
    FOR i = 1 TO n
        IF CTRL_VISROWS(i).isHeader THEN totH = totH + CTRL_CAT_H ELSE totH = totH + CTRL_ROW_H
    NEXT
    CONTROLS.contentH = totH
    IF CONTROLS.scrollY > CONTROLS.contentH - CONTROLS.viewportH THEN CONTROLS.scrollY = CONTROLS.contentH - CONTROLS.viewportH
    IF CONTROLS.scrollY < 0 THEN CONTROLS.scrollY = 0
END SUB


''
' Clamp the scroll offset to the content range.
'
SUB CONTROLS_clamp_scroll ()
    DIM maxS AS INTEGER
    maxS = CONTROLS.contentH - CONTROLS.viewportH
    IF maxS < 0 THEN maxS = 0
    IF CONTROLS.scrollY > maxS THEN CONTROLS.scrollY = maxS
    IF CONTROLS.scrollY < 0 THEN CONTROLS.scrollY = 0
END SUB


' --- Content-area top Y (below title + find + header rows) --------------------
FUNCTION CTRL_content_top% ()
    CTRL_content_top% = THEME.DIALOG_title_height% + 2 + CTRL_FIND_H + CTRL_HDR_H
END FUNCTION


''
' Draw the FIND row (label + text box). 4.1: box drawn, typing wired in 4.2.
'
SUB CONTROLS_draw_find ()
    DIM y AS INTEGER, boxX AS INTEGER, boxW AS INTEGER
    y = THEME.DIALOG_title_height% + 2
    COLOR THEME.DIALOG_label_fg~&
    _UPRINTSTRING (CTRL_COL_NAME_X, y + 5), "FIND:"
    boxX = CTRL_COL_NAME_X + 40
    boxW = CONTROLS.ctx.w - boxX - CTRL_COL_NAME_X
    LINE (boxX, y + 2)-(boxX + boxW, y + CTRL_FIND_H - 4), THEME.DIALOG_toggle_bg~&, BF
    LINE (boxX, y + 2)-(boxX + boxW, y + CTRL_FIND_H - 4), THEME.DIALOG_toggle_border~&, B
    COLOR THEME.DIALOG_toggle_fg~&
    IF CONTROLS.filterLen > 0 THEN
        _UPRINTSTRING (boxX + 4, y + 5), LEFT$(CONTROLS.filter, CONTROLS.filterLen)
    ELSE
        COLOR THEME.DIALOG_border_inner~&
        _UPRINTSTRING (boxX + 4, y + 5), "type to filter (soon)"
    END IF
END SUB


''
' Draw the column-header row.
'
SUB CONTROLS_draw_headers ()
    DIM y AS INTEGER
    y = THEME.DIALOG_title_height% + 2 + CTRL_FIND_H
    LINE (1, y)-(CONTROLS.ctx.w - 2, y + CTRL_HDR_H), THEME.DIALOG_title_bg~&, BF
    COLOR THEME.DIALOG_label_fg~&
    _UPRINTSTRING (CTRL_COL_NAME_X, y + 3), "FUNCTION"
    _UPRINTSTRING (CTRL_COL_CUR_X, y + 3), "CURRENT KEY"
    _UPRINTSTRING (CTRL_COL_BTN_X, y + 3), "REBIND"
    LINE (1, y + CTRL_HDR_H)-(CONTROLS.ctx.w - 2, y + CTRL_HDR_H), THEME.DIALOG_border_inner~&
END SUB


''
' Draw the scrolling content: category headers + binding rows within the viewport.
'
SUB CONTROLS_draw_content ()
    DIM top AS INTEGER, bottom AS INTEGER, y AS INTEGER, i AS INTEGER, rh AS INTEGER
    DIM bi AS INTEGER, hov AS INTEGER
    top = CTRL_content_top%
    bottom = CONTROLS.ctx.h - CTRL_BTN_BAR_H
    y = top - CONTROLS.scrollY
    FOR i = 1 TO CONTROLS.visCount
        IF CTRL_VISROWS(i).isHeader THEN rh = CTRL_CAT_H ELSE rh = CTRL_ROW_H
        IF y + rh > top AND y < bottom THEN
            IF CTRL_VISROWS(i).isHeader THEN
                LINE (1, y)-(CONTROLS.ctx.w - CTRL_SCROLL_W - 2, y + rh - 1), THEME.DIALOG_title_bg~&, BF
                COLOR THEME.DIALOG_title_fg~&
                _UPRINTSTRING (CTRL_COL_NAME_X, y + 2), CTRL_cat_name$(CTRL_VISROWS(i).cat)
            ELSE
                bi = CTRL_VISROWS(i).bindIdx
                hov = (CONTROLS.ctx.my >= y AND CONTROLS.ctx.my < y + rh AND CONTROLS.ctx.mx < CONTROLS.ctx.w - CTRL_SCROLL_W - 2)
                IF hov THEN LINE (1, y)-(CONTROLS.ctx.w - CTRL_SCROLL_W - 2, y + rh - 1), THEME.LAYER_PANEL_row_hover_bg~&, BF
                COLOR THEME.DIALOG_label_fg~&
                _UPRINTSTRING (CTRL_COL_NAME_X, y + 2), CTRL_clip_label$(_TRIM$(RTRIM$(INPUT_BINDS(bi).label)), CTRL_COL_NAME_W)
                COLOR THEME.DIALOG_toggle_fg~&
                _UPRINTSTRING (CTRL_COL_CUR_X, y + 2), CTRL_current_key$(bi)
                ' Rebind button (inert in 4.1)
                CTRL_draw_row_btn CTRL_COL_BTN_X, y + 1, CTRL_COL_BTN_W, rh - 2, "SET...", INPUT_BINDS(bi).dispatched
            END IF
        END IF
        y = y + rh
    NEXT
END SUB


''
' Clip a label to fit within maxW pixels, adding an ellipsis if truncated.
'
FUNCTION CTRL_clip_label$ (s AS STRING, maxW AS INTEGER)
    IF _PRINTWIDTH(s$) <= maxW THEN CTRL_clip_label$ = s$: EXIT FUNCTION
    DIM t AS STRING
    t$ = s$
    DO WHILE LEN(t$) > 1 AND _PRINTWIDTH(t$ + "...") > maxW
        t$ = LEFT$(t$, LEN(t$) - 1)
    LOOP
    CTRL_clip_label$ = t$ + "..."
END FUNCTION


''
' Draw a small in-row button. `enabled` FALSE renders it greyed (not rebindable yet).
'
SUB CTRL_draw_row_btn (bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER, lbl AS STRING, enabled AS INTEGER)
    DIM bg AS _UNSIGNED LONG, fg AS _UNSIGNED LONG, br AS _UNSIGNED LONG
    IF enabled THEN
        bg~& = THEME.DIALOG_toggle_bg~& : fg~& = THEME.DIALOG_button_fg~& : br~& = THEME.DIALOG_toggle_border~&
    ELSE
        bg~& = THEME.DIALOG_bg~& : fg~& = THEME.DIALOG_border_inner~& : br~& = THEME.DIALOG_border_inner~&
    END IF
    LINE (bx, by)-(bx + bw, by + bh), bg~&, BF
    LINE (bx, by)-(bx + bw, by + bh), br~&, B
    COLOR fg~&
    _UPRINTSTRING (bx + (bw - _PRINTWIDTH(lbl$)) \ 2, by + 2), lbl$
END SUB


''
' Draw the scrollbar track + proportional thumb (drag wired in 4.2; wheel works now).
'
SUB CONTROLS_draw_scrollbar ()
    DIM top AS INTEGER, bottom AS INTEGER, trackX AS INTEGER, trackH AS INTEGER
    top = CTRL_content_top%
    bottom = CONTROLS.ctx.h - CTRL_BTN_BAR_H
    trackX = CONTROLS.ctx.w - CTRL_SCROLL_W - 1
    trackH = bottom - top
    IF trackH <= 0 THEN EXIT SUB
    LINE (trackX, top)-(trackX + CTRL_SCROLL_W - 1, bottom), THEME.DIALOG_slider_track_bg~&, BF
    IF CONTROLS.contentH <= CONTROLS.viewportH THEN EXIT SUB
    DIM thumbH AS INTEGER, thumbY AS INTEGER, maxS AS INTEGER
    thumbH = (CONTROLS.viewportH * trackH) \ CONTROLS.contentH
    IF thumbH < 12 THEN thumbH = 12
    maxS = CONTROLS.contentH - CONTROLS.viewportH
    IF maxS < 1 THEN maxS = 1
    thumbY = top + (CONTROLS.scrollY * (trackH - thumbH)) \ maxS
    LINE (trackX, thumbY)-(trackX + CTRL_SCROLL_W - 1, thumbY + thumbH), THEME.DIALOG_slider_fill~&, BF
END SUB


''
' Draw the bottom button bar and hit-test its buttons. CLOSE ends the modal.
' RESET ALL is drawn (inert in 4.1; wired to BINDINGS_reset_all in 4.2).
'
SUB CONTROLS_draw_button_bar ()
    DIM barY AS INTEGER
    barY = CONTROLS.ctx.h - CTRL_BTN_BAR_H
    LINE (1, barY)-(CONTROLS.ctx.w - 2, barY), THEME.DIALOG_border_inner~&
    LINE (1, barY + 1)-(CONTROLS.ctx.w - 2, CONTROLS.ctx.h - 2), THEME.DIALOG_title_bg~&, BF

    DIM bw AS INTEGER, bh AS INTEGER, by AS INTEGER
    bw = 84 : bh = CTRL_BTN_BAR_H - 10 : by = barY + 5

    ' RESET ALL — left
    CTRL_draw_bar_btn CTRL_COL_NAME_X, by, bw, bh, "RESET ALL", (CONTROLS.ctx.mx >= CTRL_COL_NAME_X AND CONTROLS.ctx.mx <= CTRL_COL_NAME_X + bw AND CONTROLS.ctx.my >= by AND CONTROLS.ctx.my <= by + bh)

    ' CLOSE — right
    DIM closeX AS INTEGER
    closeX = CONTROLS.ctx.w - bw - CTRL_COL_NAME_X
    CTRL_draw_bar_btn closeX, by, bw, bh, "CLOSE", (CONTROLS.ctx.mx >= closeX AND CONTROLS.ctx.mx <= closeX + bw AND CONTROLS.ctx.my >= by AND CONTROLS.ctx.my <= by + bh)
    IF DIALOG_hit%(CONTROLS.ctx, closeX, by, bw, bh) THEN
        CONTROLS.ctx.result = TRUE
        CONTROLS.ctx.done = TRUE
    END IF
END SUB


''
' Draw a labelled bar button with a hover state.
'
SUB CTRL_draw_bar_btn (bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER, lbl AS STRING, hov AS INTEGER)
    DIM bg AS _UNSIGNED LONG
    IF hov THEN bg~& = THEME.DIALOG_toggle_sel_bg~& ELSE bg~& = THEME.DIALOG_toggle_bg~&
    LINE (bx, by)-(bx + bw, by + bh), bg~&, BF
    LINE (bx, by)-(bx + bw, by + bh), THEME.DIALOG_toggle_border~&, B
    COLOR THEME.DIALOG_button_fg~&
    _UPRINTSTRING (bx + (bw - _PRINTWIDTH(lbl$)) \ 2, by + (bh - 8) \ 2), lbl$
END SUB


''
' Keyboard: Escape closes. (Filter typing / row navigation arrive in 4.2.)
'
SUB CONTROLS_handle_keyboard ()
    DIM k AS LONG
    k& = _KEYHIT
    IF k& = 27 THEN
        CONTROLS.ctx.result = FALSE
        CONTROLS.ctx.done = TRUE
    END IF
END SUB


''
' Open the Customize Controls modal.
'
SUB CONTROLS_open ()
    BROWSER_suspend_for_modal

    DIM dlgW AS INTEGER, dlgH AS INTEGER
    dlgW = CTRL_W : dlgH = CTRL_H
    IF dlgW > SCRN.w& - 8 THEN dlgW = SCRN.w& - 8
    IF dlgH > SCRN.h& - 8 THEN dlgH = SCRN.h& - 8
    IF dlgW < 220 THEN dlgW = 220
    IF dlgH < 180 THEN dlgH = 180
    DIALOG_init CONTROLS.ctx, dlgW, dlgH

    CONTROLS.filter = ""
    CONTROLS.filterLen = 0
    CONTROLS.scrollY = 0
    CONTROLS.needsRedraw = TRUE
    CONTROLS.viewportH = (dlgH - CTRL_BTN_BAR_H) - CTRL_content_top%
    IF CONTROLS.viewportH < 0 THEN CONTROLS.viewportH = 0
    CONTROLS_rebuild_vis

    _KEYCLEAR
    DO WHILE _MOUSEINPUT: LOOP

    DIM frameIdle AS INTEGER, prevMX AS INTEGER, prevMY AS INTEGER
    prevMX = -1 : prevMY = -1

    DO
        frameIdle = -1

        DIALOG_poll_mouse CONTROLS.ctx
        CONTROLS_handle_keyboard

        IF CONTROLS.ctx.mwheel <> 0 THEN
            CONTROLS.scrollY = CONTROLS.scrollY + CONTROLS.ctx.mwheel * CTRL_ROW_H * 3
            CONTROLS_clamp_scroll
            frameIdle = 0
        END IF

        IF CONTROLS.ctx.mx <> prevMX OR CONTROLS.ctx.my <> prevMY THEN frameIdle = 0
        IF CONTROLS.ctx.mb1 THEN frameIdle = 0
        IF CONTROLS.ctx.justClicked THEN frameIdle = 0
        IF CONTROLS.needsRedraw THEN frameIdle = 0: CONTROLS.needsRedraw = FALSE
        prevMX = CONTROLS.ctx.mx : prevMY = CONTROLS.ctx.my

        IF NOT frameIdle THEN
            _DEST CONTROLS.ctx.imgHandle
            _FONT CONTROLS.ctx.fontH
            _PRINTMODE _KEEPBACKGROUND

            DIALOG_draw_frame CONTROLS.ctx, "CUSTOMIZE CONTROLS"
            CONTROLS_draw_find
            CONTROLS_draw_headers
            CONTROLS_draw_content
            CONTROLS_draw_scrollbar
            CONTROLS_draw_button_bar

            DIALOG_blit CONTROLS.ctx
        ELSE
            _LIMIT 15
        END IF
    LOOP UNTIL CONTROLS.ctx.done

    DIALOG_cleanup CONTROLS.ctx

    SCENE_DIRTY%      = TRUE
    GUI_NEEDS_REDRAW% = TRUE
    FRAME_IDLE%       = FALSE

    BROWSER_resume_after_modal
END SUB
