''
' DRAW - TOOLS/PICKER.BM
' =============================================================================
' Color picker tool subs and functions.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Initialize picker tool
'
SUB PICKER_init ()
    PICKER.ACTIVE% = FALSE
    PICKER_LOUPE_init
END SUB


''
' Activate picker tool
'
SUB PICKER_activate ()
    PICKER.ACTIVE% = TRUE
    ' Reset R-key arm state so a ghost/stuck R from before activation doesn't
    ' immediately trigger reference-image sampling (Linux/SDL2 key-up may be
    ' swallowed while ALT is held - see project gotcha #20).
    PICKER_REFIMG_RESET% = TRUE
    PICKER_LOUPE_activate
END SUB


''
' Deactivate picker tool
'
SUB PICKER_deactivate ()
    PICKER.ACTIVE% = FALSE
    PICKER_LOUPE_deactivate
END SUB


''
' Composite a cropped visible-layer region into a destination image.
' Blends all visible layers in render order into the destination, respecting blend modes and opacity.
'
' @param canvasX INTEGER Left edge X coordinate on the canvas to sample from
' @param canvasY INTEGER Top edge Y coordinate on the canvas to sample from
' @param regionW INTEGER Width of the region to composite in pixels
' @param regionH INTEGER Height of the region to composite in pixels
' @param destImg LONG Destination image handle to composite into (must be pre-allocated 32-bit)
'
SUB PICKER_compose_region (canvasX AS INTEGER, canvasY AS INTEGER, regionW AS INTEGER, regionH AS INTEGER, destImg AS LONG)
    DIM oldDest  AS LONG
    DIM clipLeft AS INTEGER, clipTop AS INTEGER, clipRight AS INTEGER, clipBottom AS INTEGER
    DIM destX    AS INTEGER, destY AS INTEGER

    IF destImg& >= -1 THEN EXIT SUB
    IF regionW% < 1 OR regionH% < 1 THEN EXIT SUB

    oldDest& = _DEST
    _DEST destImg&
    _DONTBLEND destImg&
    CLS , _RGBA32(0, 0, 0, 0)
    _BLEND destImg&

    IF RENDER_ORDER_DIRTY% THEN RENDER_ORDER_rebuild

    DIM pli AS INTEGER, plf AS INTEGER
    FOR pli% = 1 TO RENDER_ORDER_COUNT%
        plf% = RENDER_ORDER%(pli%)
        IF plf% > 0 _ANDALSO LAYERS(plf%).visible% THEN
            DIM pSrcImg AS LONG
            pSrcImg& = LAYERS(plf%).imgHandle&
            IF pSrcImg& < -1 THEN
                clipLeft%   = canvasX%
                clipTop%    = canvasY%
                clipRight%  = canvasX% + regionW% - 1
                clipBottom% = canvasY% + regionH% - 1
                IF clipLeft% < 0 THEN clipLeft% = 0
                IF clipTop% < 0 THEN clipTop% = 0
                IF clipRight% >= SCRN.canvasW& THEN clipRight% = SCRN.canvasW& - 1
                IF clipBottom% >= SCRN.canvasH& THEN clipBottom% = SCRN.canvasH& - 1

                IF clipRight% >= clipLeft% AND clipBottom% >= clipTop% THEN
                    DIM pLayer AS LONG
                    destX%  = clipLeft% - canvasX%
                    destY%  = clipTop% - canvasY%
                    pLayer& = _NEWIMAGE(regionW%, regionH%, 32)
                    IF pLayer& < -1 THEN
                        _DEST pLayer&
                        _DONTBLEND pLayer&
                        CLS , _RGBA32(0, 0, 0, 0)
                        _BLEND pLayer&
                        _PUTIMAGE (destX%, destY%), pSrcImg&, pLayer&, (clipLeft%, clipTop%)-(clipRight%, clipBottom%)

                        _DEST destImg&
                        IF LAYERS(plf%).blendMode% = BLEND_NORMAL AND LAYERS(plf%).opacity% = 255 THEN
                            _PUTIMAGE , pLayer&, destImg&
                        ELSE
                            LAYER_blend_composite destImg&, pLayer&, LAYERS(plf%).blendMode%, LAYERS(plf%).opacity%
                        END IF

                        SAFE_FREEIMAGE pLayer&
                    END IF
                END IF
            END IF
        END IF
    NEXT pli%

    _DEST oldDest&
END SUB


''
' Resolve the final picker color at a canvas position.
' Hold R to sample the visible reference image; otherwise sample visible layer pixels.
' Uses a STATIC arm pattern to guard against stuck R key on Linux/SDL2.
'
' @param canvasX INTEGER Canvas X coordinate to sample
' @param canvasY INTEGER Canvas Y coordinate to sample
' @param layerColor _UNSIGNED LONG Color sampled from visible layers (used as default/fallback)
' @return _UNSIGNED LONG - Resolved color: reference image color if R is held, otherwise layerColor
'
FUNCTION PICKER_resolve_sample_color~& (canvasX AS INTEGER, canvasY AS INTEGER, layerColor AS _UNSIGNED LONG)
    DIM preferReference AS INTEGER
    DIM refColor        AS _UNSIGNED LONG
    ' SDL2 on Linux can swallow key-up events while ALT is held, leaving _KEYDOWN(82)
    ' stuck TRUE after an ALT+R session.  We guard against this with a STATIC arm
    ' pattern: rArmed% is only set by a genuine low->high transition, and is reset
    ' every time the picker is activated (via PICKER_REFIMG_RESET%).
    STATIC rPrev        AS INTEGER
    STATIC rArmed       AS INTEGER

    PICKER_resolve_sample_color~& = layerColor~&

    DIM rNow AS INTEGER
    rNow% = (_KEYDOWN(82) OR _KEYDOWN(114))

    ' On picker (re)activation absorb whatever R state currently exists so a
    ' ghost/stuck key from a prior ALT+R operation does not immediately arm.
    IF PICKER_REFIMG_RESET% THEN
        rPrev%               = rNow%
        rArmed%              = FALSE
        PICKER_REFIMG_RESET% = FALSE
    END IF

    ' Only arm on a genuine low->high transition; disarm when released.
    IF NOT rPrev% AND rNow% THEN
        rArmed% = TRUE
    ELSEIF NOT rNow% THEN
        rArmed% = FALSE
    END IF
    rPrev% = rNow%

    preferReference% = rArmed%

    IF preferReference% AND REFIMG_sample_color_at_canvas%(canvasX%, canvasY%, refColor~&) THEN
        PICKER_resolve_sample_color~& = refColor~&
    END IF
END FUNCTION


''
' The colour the picker takes at canvas (x, y), by Tool Options (CFG.PICKER_SAMPLE% /
' PICKER_SAMPLE_SIZE%): every visible layer merged, the current layer, or the reference image
' (where it has none: the merged colour); averaged over a 1 / 3 / 5 px square (the part on
' the canvas). 1 px merged is the picker as it always was.
FUNCTION PICKER_sample~& (x AS INTEGER, y AS INTEGER)
    DIM n AS INTEGER, hn AS INTEGER, img AS LONG, os AS LONG, i AS INTEGER, j AS INTEGER
    DIM c AS _UNSIGNED LONG, rs AS LONG, gs AS LONG, bs AS LONG, asum AS LONG, k AS LONG
    DIM cx AS INTEGER, cy AS INTEGER, layerImg AS LONG, aw AS INTEGER, ah AS INTEGER, mode AS INTEGER
    n = CFG.PICKER_SAMPLE_SIZE%
    IF n <> 3 _ANDALSO n <> 5 THEN n = 1
    hn = n \ 2
    mode = CFG.PICKER_SAMPLE%
    os = _SOURCE
    IF mode = 1 THEN
        layerImg = LAYER_current_image&
        IF layerImg >= -1 _ORELSE CURRENT_LAYER% < 1 THEN mode = 0 ELSE aw = LAYERS(CURRENT_LAYER%).apronW%: ah = LAYERS(CURRENT_LAYER%).apronH%
    END IF
    IF mode <> 1 THEN
        img = _NEWIMAGE(n, n, 32)
        IF img >= -1 THEN EXIT FUNCTION
        PICKER_compose_region x - hn, y - hn, n, n, img
    END IF
    FOR j = -hn TO hn
        FOR i = -hn TO hn
            cx = x + i: cy = y + j
            IF cx >= 0 _ANDALSO cy >= 0 _ANDALSO cx < SCRN.canvasW& _ANDALSO cy < SCRN.canvasH& THEN
                IF mode = 1 THEN
                    _SOURCE layerImg: c = POINT(cx + aw, cy + ah)
                ELSEIF mode = 2 _ANDALSO REFIMG_sample_color_at_canvas%(cx, cy, c) THEN
                    ' (the reference's colour, in c)
                ELSE
                    _SOURCE img: c = POINT(i + hn, j + hn)
                END IF
                rs = rs + _RED32(c): gs = gs + _GREEN32(c): bs = bs + _BLUE32(c): asum = asum + _ALPHA32(c): k = k + 1
            END IF
        NEXT i
    NEXT j
    _SOURCE os
    IF img < -1 THEN SAFE_FREEIMAGE img
    IF k = 0 THEN EXIT FUNCTION
    PICKER_sample~& = _RGBA32((rs + k \ 2) \ k, (gs + k \ 2) \ k, (bs + k \ 2) \ k, (asum + k \ 2) \ k)
END FUNCTION


''
' Pick color at given coordinates
'
' @param x INTEGER - X coordinate to pick color from
' @param y INTEGER - Y coordinate to pick color from
' @param button INTEGER - Mouse button (1=left/foreground, 2=right/background)
'
SUB PICKER_pick_color (x AS INTEGER, y AS INTEGER, button AS INTEGER)
    DIM old_dest     AS LONG
    DIM old_source   AS LONG
    DIM layer_color  AS _UNSIGNED LONG
    DIM picked_color AS _UNSIGNED LONG
    DIM mergedPick   AS LONG
    
    old_dest&   = _DEST
    old_source& = _SOURCE

    ' Ensure coordinates are within bounds
    IF x% < 0 OR x% >= SCRN.canvasW& OR y% < 0 OR y% >= SCRN.canvasH& THEN
        _SOURCE old_source&
        _DEST old_dest&
        EXIT SUB
    END IF

    ' What Tool Options SAMPLE / SIZE say (visible layers, 1 px, by default); hold R to
    ' sample the reference image instead.
    layer_color~&  = PICKER_sample~&(x%, y%)
    picked_color~& = PICKER_resolve_sample_color~&(x%, y%, layer_color~&)
    
    ' Set the paint color based on which button was used
    IF button% = 1 THEN
        ' Left button - set foreground color
        PAINT_COLOR~&          = picked_color~&
        PAL_FG_IS_TRANSPARENT% = (_ALPHA32(picked_color~&) = 0)
        ' Update palette index if color matches palette
        DIM i AS INTEGER
        FOR i% = 0 TO 15
            IF PAL_color(i%) = picked_color~& THEN
                PAL_FG_IDX% = i%
                EXIT FOR
            END IF
        NEXT i%
        GUI_NEEDS_REDRAW% = TRUE
    ELSEIF button% = 2 THEN
        ' Right button - set background color
        PAINT_BG_COLOR~&       = picked_color~&
        PAL_BG_IS_TRANSPARENT% = (_ALPHA32(picked_color~&) = 0)
        GUI_NEEDS_REDRAW%      = TRUE
    END IF
    
    _SOURCE old_source&
    _DEST old_dest&
END SUB
