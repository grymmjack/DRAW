''
' DRAW - TOOLS/ANIM-VIEW.BM
' =============================================================================
' Animation views (see ANIM-VIEW.BI).
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' The frame grid over the canvas in sheet view: every cell's border (spare
' cells past the last frame dotted), frame numbers when a cell is big enough
' on screen, and a 2 px outline round the current frame.
' @param dest LONG   the viewport image (SCRN.CANVAS&)
' @param dx/dy LONG  viewport px of canvas pixel (0,0) at the current zoom
'
SUB ANIM_VIEW_render_grid (dest AS LONG, dx AS LONG, dy AS LONG)
    DIM oldDest AS LONG, oldFont AS LONG, oldFg AS _UNSIGNED LONG, oldBg AS _UNSIGNED LONG
    DIM n AS INTEGER, cells AS INTEGER, z AS SINGLE, r AS INTEGER
    DIM x AS LONG, y AS LONG, w AS LONG, h AS LONG
    DIM x1 AS LONG, y1 AS LONG, x2 AS LONG, y2 AS LONG, vw AS LONG, vh AS LONG
    DIM lbl AS STRING, tw AS INTEGER, th AS INTEGER, labels AS INTEGER

    ANIM_VIEW.drawn = FALSE
    IF ANIM.active = FALSE _ORELSE CFG.FRAME_GRID% = 0 THEN EXIT SUB
    IF dest >= -1 THEN EXIT SUB
    cells = ANIM_cells%
    IF cells < 1 THEN EXIT SUB
    z = SCRN.zoom!
    IF z <= 0 THEN EXIT SUB

    oldDest = _DEST
    _DEST dest
    _BLEND dest
    vw = _WIDTH(dest): vh = _HEIGHT(dest)

    ' cell borders
    FOR n = 1 TO cells
        r = ANIM_cell_rect%(n, x, y, w, h)
        x1 = dx + INT(x * z): y1 = dy + INT(y * z)
        x2 = dx + INT((x + w) * z) - 1: y2 = dy + INT((y + h) * z) - 1
        IF x2 < x1 THEN x2 = x1
        IF y2 < y1 THEN y2 = y1
        IF x2 >= 0 _ANDALSO y2 >= 0 _ANDALSO x1 < vw _ANDALSO y1 < vh THEN
            IF n <= ANIM.count THEN
                LINE (x1, y1)-(x2, y2), THEME.ANIM_FRAME_border~&, B
            ELSE
                LINE (x1, y1)-(x2, y2), THEME.ANIM_FRAME_spare~&, B , &HCCCC
            END IF
        END IF
    NEXT n

    ' the current layer's linked cells (4.3): hatched - painting one paints its source
    IF ANIM_LK_N > 0 _ANDALSO CURRENT_LAYER% >= 1 _ANDALSO CURRENT_LAYER% <= MAX_LAYERS THEN
        FOR n = 1 TO ANIM.count
            IF ANIM_LK_is_link%(LAYERS(CURRENT_LAYER%).historyId&, n) THEN
                r = ANIM_cell_rect%(n, x, y, w, h)
                x1 = dx + INT(x * z): y1 = dy + INT(y * z)
                x2 = dx + INT((x + w) * z) - 1: y2 = dy + INT((y + h) * z) - 1
                IF x2 >= 0 _ANDALSO y2 >= 0 _ANDALSO x1 < vw _ANDALSO y1 < vh THEN
                    ANIM_LK_hatch _MAX(x1, 0), _MAX(y1, 0), _MIN(x2, vw - 1), _MIN(y2, vh - 1), (THEME.ANIM_FRAME_current~& AND &H00FFFFFF~&) OR &H70000000~&, 6
                END IF
            END IF
        NEXT n
    END IF

    ' frame numbers, top-left inside each frame, when the cell has room
    labels = (ANIM.frameW * z >= 14 _ANDALSO ANIM.frameH * z >= 11)
    IF labels THEN
        ANIM_VIEW_font_ensure
        oldFont = _FONT(dest): oldFg = _DEFAULTCOLOR(dest): oldBg = _BACKGROUNDCOLOR(dest)
        IF ANIM_VIEW.font > 0 THEN _FONT ANIM_VIEW.font, dest ELSE _FONT 8, dest
        th = _UFONTHEIGHT
        IF th < 1 THEN th = 8
        COLOR THEME.ANIM_FRAME_label_fg~&, _RGBA32(0, 0, 0, 0)
        FOR n = 1 TO ANIM.count
            r = ANIM_cell_rect%(n, x, y, w, h)
            x1 = dx + INT(x * z): y1 = dy + INT(y * z)
            IF x1 + 1 < vw _ANDALSO y1 + 1 < vh _ANDALSO x1 + INT(w * z) > 0 _ANDALSO y1 + INT(h * z) > 0 THEN
                lbl = _TRIM$(STR$(n))
                tw = _PRINTWIDTH(lbl)
                IF tw + 3 <= INT(w * z) THEN
                    LINE (x1 + 1, y1 + 1)-(x1 + tw + 2, y1 + th), THEME.ANIM_FRAME_label_bg~&, BF
                    _UPRINTSTRING (x1 + 2, y1 + 1), lbl
                END IF
            END IF
        NEXT n
        _FONT oldFont, dest
        COLOR oldFg, oldBg
    END IF

    ' the current frame on top
    IF ANIM_cell_rect%(ANIM.current, x, y, w, h) THEN
        x1 = dx + INT(x * z): y1 = dy + INT(y * z)
        x2 = dx + INT((x + w) * z) - 1: y2 = dy + INT((y + h) * z) - 1
        IF x2 < x1 THEN x2 = x1
        IF y2 < y1 THEN y2 = y1
        LINE (x1 - 1, y1 - 1)-(x2 + 1, y2 + 1), THEME.ANIM_FRAME_current~&, B
        LINE (x1, y1)-(x2, y2), THEME.ANIM_FRAME_current~&, B
    END IF

    ANIM_VIEW.drawn = TRUE
    ANIM_VIEW.dx = dx: ANIM_VIEW.dy = dy
    _DEST oldDest
END SUB

''
' The frame number font (Tiny5), loaded on first use; 0 = the built-in 8x8.
SUB ANIM_VIEW_font_ensure ()
    IF ANIM_VIEW.fontTried THEN EXIT SUB
    ANIM_VIEW.fontTried = TRUE
    IF _FILEEXISTS("./ASSETS/FONTS/Tiny5-Regular.ttf") THEN ANIM_VIEW.font = _LOADFONT("./ASSETS/FONTS/Tiny5-Regular.ttf", 8, "DONTBLEND")
    IF ANIM_VIEW.font < 0 THEN ANIM_VIEW.font = 0
END SUB

''
' View > Frame Grid (action 2500).
SUB ANIM_VIEW_toggle_grid ()
    CFG.FRAME_GRID% = (CFG.FRAME_GRID% = 0)
    CONFIG_save
    IF ANIM.active THEN
        IF CFG.FRAME_GRID% THEN STATUS_flash "Frame grid shown" ELSE STATUS_flash "Frame grid hidden"
    ELSE
        IF CFG.FRAME_GRID% THEN STATUS_flash "Frame grid on (this picture has no frames)" ELSE STATUS_flash "Frame grid off"
    END IF
    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' QA dump line (DOCK_dump): ANIM active count current frameW frameH gutter
' margin cols rows fps loop gridDrawn dx dy canvasW canvasH playing previewFrame
FUNCTION ANIM_VIEW_dump$ ()
    DIM d AS STRING
    d = "ANIM" + DOCK_n$(ANIM.active <> 0) + DOCK_n$(ANIM.count) + DOCK_n$(ANIM.current) + DOCK_n$(ANIM.frameW) + DOCK_n$(ANIM.frameH)
    d = d + DOCK_n$(ANIM.gutter) + DOCK_n$(ANIM.margin) + DOCK_n$(ANIM_cols%) + DOCK_n$(ANIM_rows%) + DOCK_n$(ANIM.fps) + DOCK_n$(ANIM.loopMode)
    d = d + DOCK_n$(ANIM_VIEW.drawn <> 0) + DOCK_n$(ANIM_VIEW.dx) + DOCK_n$(ANIM_VIEW.dy) + DOCK_n$(SCRN.canvasW&) + DOCK_n$(SCRN.canvasH&) + DOCK_n$(ANIM_PLAY.playing <> 0) + DOCK_n$(ANIM_VIEW_preview_frame% <> 0) + CHR$(10)
    ANIM_VIEW_dump$ = d
END FUNCTION


''
' The frame action numpad key b stands for (0 = none: it stays a plain key).
FUNCTION ANIM_numpad_action% (b AS INTEGER)
    SELECT CASE b
        CASE 1: ANIM_numpad_action% = ANIM_ACT_FIRST
        CASE 4: ANIM_numpad_action% = ANIM_ACT_PREV
        CASE 5: ANIM_numpad_action% = ANIM_ACT_NEXT
        CASE 9: ANIM_numpad_action% = ANIM_ACT_LAST
        CASE 12: ANIM_numpad_action% = ANIM_ACT_APPEND ' Num + (Shift: blank - ANIM_OPS_action)
        CASE 16: ANIM_numpad_action% = ANIM_ACT_PLAY ' Num Enter
        CASE 10: ANIM_numpad_action% = ANIM_ACT_LIGHTBOX ' Num 0
        CASE 14: ANIM_numpad_action% = ANIM_ACT_LB_PANES ' Num *
        CASE 15: ANIM_numpad_action% = ANIM_ACT_ONION ' Num /
        CASE 11: ANIM_numpad_action% = ANIM_ACT_FULLSCREEN ' Num . (TOOLS/ANIM-FS)
        CASE 8: ANIM_numpad_action% = ANIM_ACT_XSHEET ' Num 8 (TOOLS/ANIM-XS)
    END SELECT
END FUNCTION

''
' Numpad frame keys only on a sheet with frames (Num + on a plain picture
' too: it becomes frame 1), with no Ctrl / Alt, and not while typing,
' dragging a shape / stroke or in a menu, palette or dialog.
FUNCTION ANIM_keys_ready% ()
    IF ANIM.active = FALSE _ORELSE ANIM.count < 1 THEN EXIT FUNCTION
    ANIM_keys_ready% = ANIM_keys_free%
END FUNCTION

FUNCTION ANIM_key_ok% (b AS INTEGER)
    IF b = 12 THEN ANIM_key_ok% = ANIM_keys_free% ELSE ANIM_key_ok% = ANIM_keys_ready%
END FUNCTION

FUNCTION ANIM_keys_free% ()
    IF MODIFIERS.ctrl% _ORELSE MODIFIERS.alt% THEN EXIT FUNCTION
    IF CMD_PALETTE.visible% _ORELSE TBED_typing% _ORELSE KEYBOARD_SUPPRESS_FRAMES% > 0 THEN EXIT FUNCTION
    IF INPUT_CONTEXT AND (CTX_TEXT_ACTIVE OR CTX_COMMAND_PALETTE_OPEN OR CTX_DRAWING_IN_PROGRESS OR CTX_SS_DRAGGING) THEN EXIT FUNCTION
    IF CURRENT_TOOL% = TOOL_TEXT _ANDALSO TEXT.ACTIVE THEN EXIT FUNCTION
    IF COLORMIXER_hex_focused% _ORELSE ANIM_LB_editing% THEN EXIT FUNCTION
    IF MOUSE.B1% _ORELSE MOUSE.B2% _ORELSE MOUSE.B3% THEN EXIT FUNCTION
    IF MENU_BAR.openMenu% >= 0 THEN EXIT FUNCTION
    ANIM_keys_free% = TRUE
END FUNCTION

''
' DRAW.BAS, after NUMPAD_poll: a new numpad press of a frame key runs its
' action; its plain-code twins (INKEY$ / _KEYHIT) are dropped.
SUB ANIM_numpad_tick ()
    DIM b AS INTEGER, t AS DOUBLE
    t = TIMER(.001)
    FOR b = 1 TO NP_N
        IF NP_T(b) >= 0 _ANDALSO ANIM_numpad_action%(b) <> 0 THEN
            IF t < NP_T(b) _ORELSE t - NP_T(b) > .25 THEN
                NP_T(b) = -1 ' stale
            ELSEIF ANIM_key_ok%(b) THEN
                ANIM_numpad_fire b, 3
            END IF
        END IF
    NEXT b
END SUB

''
' Run numpad key b's frame action; twins (1 = _KEYHIT, 2 = INKEY$) still to drop.
SUB ANIM_numpad_fire (b AS INTEGER, twins AS INTEGER)
    NP_T(b) = -1
    ANIM_SW_B = b: ANIM_SW_MASK = twins: ANIM_SW_T = TIMER(.001)
    CMD_execute_action ANIM_numpad_action%(b)
END SUB

''
' A plain key code from _KEYHIT (src 1, DRAW.BAS) or INKEY$ (src 2,
' KEYBOARD_input_handler): TRUE = it is a numpad frame key's, drop it - the
' twin of a press already run, or a press this frame's poll had not seen yet
' (run here).
FUNCTION ANIM_numpad_code% (k AS LONG, src AS INTEGER)
    DIM b AS INTEGER, t AS DOUBLE
    IF k <= 0 THEN EXIT FUNCTION
    b = NUMPAD_of%(k)
    IF b = 0 _ORELSE b > NP_N THEN EXIT FUNCTION
    IF ANIM_numpad_action%(b) = 0 THEN EXIT FUNCTION
    t = TIMER(.001)
    IF ANIM_SW_B = b _ANDALSO (ANIM_SW_MASK AND src) <> 0 _ANDALSO t >= ANIM_SW_T _ANDALSO t - ANIM_SW_T < .3 THEN
        ANIM_SW_MASK = ANIM_SW_MASK AND (3 - src)
        ANIM_numpad_code% = TRUE
        EXIT FUNCTION
    END IF
    IF ANIM_key_ok%(b) = 0 THEN EXIT FUNCTION
    IF NUMPAD_sent%(k) <> b THEN EXIT FUNCTION
    ANIM_numpad_fire b, 3 - src
    ANIM_numpad_code% = TRUE
END FUNCTION

''
' INKEY$ twin of ANIM_numpad_code%: "4", or CHR$(0) + scan code.
FUNCTION ANIM_numpad_inkey% (keypress AS STRING)
    DIM k AS LONG
    IF LEN(keypress) = 1 THEN
        k = ASC(keypress)
    ELSEIF LEN(keypress) = 2 _ANDALSO ASC(keypress) = 0 THEN
        k = ASC(keypress, 2) * 256
    ELSE
        EXIT FUNCTION
    END IF
    ANIM_numpad_inkey% = ANIM_numpad_code%(k, 2)
END FUNCTION

''
' INPUT_detect_events: while a numpad frame key is held, the plain code it
' shares (_KEYDOWN(52) for numpad 4, 19200 with Num Lock off) is not down
' for the bindings - main-row 4 sets opacity, numpad 4 does not.
FUNCTION ANIM_numpad_masks% (kc AS LONG)
    DIM b AS INTEGER
    b = NUMPAD_of%(kc)
    IF b = 0 THEN EXIT FUNCTION
    IF ANIM_numpad_action%(b) = 0 THEN EXIT FUNCTION
    IF NUMPAD_held%(b) = 0 THEN EXIT FUNCTION
    IF ANIM_keys_ready% = 0 THEN EXIT FUNCTION
    ANIM_numpad_masks% = TRUE
END FUNCTION

''
' Actions 2501-2504: first / previous / next / last frame (previous / next
' wrap round the ends).
SUB ANIM_VIEW_goto (act AS INTEGER)
    DIM r AS INTEGER
    IF ANIM.active = FALSE _ORELSE ANIM.count < 1 THEN STATUS_flash "No frames: set a frame size first": EXIT SUB
    SELECT CASE act
        CASE ANIM_ACT_FIRST: r = ANIM_go%(1)
        CASE ANIM_ACT_PREV: r = ANIM_step%(-1)
        CASE ANIM_ACT_NEXT: r = ANIM_step%(1)
        CASE ANIM_ACT_LAST: r = ANIM_go%(ANIM.count)
    END SELECT
    STATUS_flash "Frame" + STR$(ANIM.current) + " of" + STR$(ANIM.count)
    IF r THEN SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB


''
' _KEYDOWN for the legacy arrow / Home / End / PgUp handlers (INPUT/KEYBOARD):
' FALSE while that code is a held numpad frame key (Num Lock off, numpad 4 =
' Left), so it does not also nudge a selection or flip a brush.
FUNCTION ANIM_keydown% (kc AS LONG)
    IF _KEYDOWN(kc) = 0 THEN EXIT FUNCTION
    IF ANIM_numpad_masks%(kc) THEN EXIT FUNCTION
    ANIM_keydown% = TRUE
END FUNCTION


''
' Action 2506: play / stop (Num Enter, Alt+/, ANIM > Play, the panel).
SUB ANIM_VIEW_play_toggle ()
    IF ANIM_PLAY.playing THEN
        ANIM_play_stop
        STATUS_flash "Stopped at frame" + STR$(ANIM.current) + " of" + STR$(ANIM.count)
    ELSEIF ANIM.active = FALSE _ORELSE ANIM.count < 2 THEN
        STATUS_flash "Nothing to play: add a frame (Num +) first"
    ELSE
        DIM a AS INTEGER, b AS INTEGER, part AS INTEGER
        ANIM_SEL_span a, b ' two or more frames selected in the strip: play those (R-20)
        part = (a > 0)
        IF ANIM_play_start%(a, b, TIMER(.001)) THEN
            IF part THEN
                STATUS_flash "Playing frames" + STR$(a) + " -" + STR$(b) + " - Num Enter or Alt+/ stops"
            ELSE
                STATUS_flash "Playing - Num Enter or Alt+/ stops"
            END IF
        END IF
    END IF
    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' DRAW.BAS, every frame: TRUE when playback stepped to another frame.
FUNCTION ANIM_play_tick% ()
    IF ANIM_PLAY.playing = FALSE THEN EXIT FUNCTION
    ANIM_play_tick% = ANIM_play_advance%(TIMER(.001))
END FUNCTION

''
' Does the Preview window show the current frame (fitted) instead of the
' canvas? With frames on, unless ANIM > Preview Shows Frame is off.
FUNCTION ANIM_VIEW_preview_frame% ()
    ANIM_VIEW_preview_frame% = (CFG.PREVIEW_SHOWS_FRAME% <> 0 _ANDALSO ANIM.active <> 0 _ANDALSO ANIM.count >= 1)
END FUNCTION

SUB ANIM_VIEW_preview_frame_toggle ()
    CFG.PREVIEW_SHOWS_FRAME% = (CFG.PREVIEW_SHOWS_FRAME% = 0)
    CONFIG_save
    IF CFG.PREVIEW_SHOWS_FRAME% THEN STATUS_flash "Preview shows the current frame" ELSE STATUS_flash "Preview shows the canvas"
    SCENE_DIRTY% = TRUE: GUI_NEEDS_REDRAW% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' Preview window: the current frame's cell of src (the canvas composite)
' fitted into (x1, y1)-(x2, y2) of dest - whole-number zoom when it fits,
' centred.
SUB ANIM_VIEW_preview_blit (src AS LONG, dest AS LONG, x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG, aw AS LONG, ah AS LONG, s AS SINGLE, dw AS LONG, dh AS LONG
    DIM dx AS LONG, dy AS LONG
    IF ANIM_cell_rect%(ANIM.current, cx, cy, cw, ch) = 0 THEN EXIT SUB
    aw = x2 - x1 + 1: ah = y2 - y1 + 1
    IF aw < 1 _ORELSE ah < 1 THEN EXIT SUB
    s = _MIN(aw / cw, ah / ch)
    IF s >= 1 THEN s = INT(s)
    dw = _MAX(1, INT(cw * s)): dh = _MAX(1, INT(ch * s))
    dx = x1 + (aw - dw) \ 2: dy = y1 + (ah - dh) \ 2
    _PUTIMAGE (dx, dy)-(dx + dw - 1, dy + dh - 1), src, dest, (cx, cy)-(cx + cw - 1, cy + ch - 1)
END SUB



''
' 45-degree lines every gap px across the box (x1, y1)-(x2, y2) on _DEST: a
' linked cell's hatching (4.3).
SUB ANIM_LK_hatch (x1 AS LONG, y1 AS LONG, x2 AS LONG, y2 AS LONG, c AS _UNSIGNED LONG, gap AS INTEGER)
    DIM s AS LONG, w AS LONG, h AS LONG, ta AS LONG, tb AS LONG
    w = x2 - x1: h = y2 - y1
    IF w < 0 _ORELSE h < 0 _ORELSE gap < 2 THEN EXIT SUB
    FOR s = (x1 + y1) MOD gap TO w + h STEP gap ' the same diagonals whatever the box
        ta = _MAX(0, s - w): tb = _MIN(s, h)
        IF tb >= ta THEN LINE (x1 + s - ta, y1 + ta)-(x1 + s - tb, y1 + tb), c
    NEXT s
END SUB
