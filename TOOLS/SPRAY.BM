''
' DRAW - TOOLS/SPRAY.BM
' =============================================================================
' Spray paint tool subs and functions.
'
' Sprays random dots within a circular area defined by BRUSH_SIZE.
' Density is proportional to the radius.
' Supports symmetry via PAINT_pset_with_symmetry.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Spray random dots around the given center point
' Uses BRUSH_SIZE system for radius, density proportional to area
'
' @param cx INTEGER - Center X coordinate (canvas space)
' @param cy INTEGER - Center Y coordinate (canvas space)
' @param col _UNSIGNED LONG - Color to spray
'
SUB SPRAY_on (cx AS INTEGER, cy AS INTEGER, col AS _UNSIGNED LONG)
    DIM AS INTEGER radius, density, i, px, py, base_radius, brush_dim
    DIM AS SINGLE angle, dist
    
    ' If custom brush is active, use it for spray stamps
    IF CUSTOM_BRUSH_is_active% THEN
        ' Get base radius from brush size system (pixel diameter / 2, minimum 1)
        base_radius% = BRUSH_PIXEL_SIZES(BRUSH_SIZE.CURRENT) \ 2
        IF base_radius% < 1 THEN base_radius% = 1
        
        ' Get custom brush maximum dimension for scaling
        brush_dim% = CUSTOM_BRUSH.WIDTH%
        IF CUSTOM_BRUSH.HEIGHT% > brush_dim% THEN brush_dim% = CUSTOM_BRUSH.HEIGHT%
        
        ' Scale spray radius proportionally by brush dimension
        radius% = base_radius% * brush_dim%
        radius% = _MAX(1, radius% * CFG.SPRAY_SPREAD% \ 100) ' (Tool Options SPREAD; 100 = as it always was)
        
        ' Calculate density based on base_radius (not scaled) to maintain proportional spacing
        ' This keeps stamp spacing consistent relative to brush size
        density% = INT(base_radius% * base_radius% * 0.15) + 3
        IF density% > 50 THEN density% = 50
        density% = _MAX(1, density% * CFG.SPRAY_DENSITY% \ 100) ' (Tool Options DENSITY)
        
        ' Spray custom brush stamps within the circular area
        FOR i% = 1 TO density%
            ' Random angle and distance (square root for uniform distribution)
            angle! = RND * 6.2831853 ' 2 * PI
            dist!  = SQR(RND) * radius%
            
            ' Calculate stamp position (centered on brush)
            px% = cx% + INT(dist! * COS(angle!) + 0.5) - CUSTOM_BRUSH.WIDTH% \ 2
            py% = cy% + INT(dist! * SIN(angle!) + 0.5) - CUSTOM_BRUSH.HEIGHT% \ 2
            
            ' Stamp custom brush
            CUSTOM_BRUSH_stamp px%, py%
        NEXT i%
    ELSEIF CFG.ANTIALIAS% <> 0 _ANDALSO _ALPHA32(col~&) > 0 THEN
        SPRAY_airbrush cx%, cy%, col~&
    ELSE
        ' Normal spray using brush shape/size for each spray tip
        ' Spray radius scales linearly with brush pixel size
        ' (pixel sizes are 1, 3, 5, 7... for indices 1..BRUSH_SIZE_COUNT)
        radius% = BRUSH_PIXEL_SIZES(BRUSH_SIZE.CURRENT) * 2 + 2
        IF radius% < 4 THEN radius% = 4
        
        ' Calculate density proportional to area: radius^2 * 0.10 + 3, capped at 40
        density% = INT(radius% * radius% * 0.10) + 3
        IF density% > 40 THEN density% = 40
        ' Tool Options SPREAD / DENSITY (100 = as above): after the density, which stays the size's
        radius% = _MAX(1, radius% * CFG.SPRAY_SPREAD% \ 100)
        density% = _MAX(1, density% * CFG.SPRAY_DENSITY% \ 100)
        
        ' Spray brush-shaped stamps within the spray area
        FOR i% = 1 TO density%
            IF BRUSH_SIZE.SHAPE = 0 THEN
                ' Circular spray area (polar coordinates)
                angle! = RND * 6.2831853 ' 2 * PI
                dist!  = SQR(RND) * radius%
                px%    = cx% + INT(dist! * COS(angle!) + 0.5)
                py%    = cy% + INT(dist! * SIN(angle!) + 0.5)
            ELSE
                ' Square spray area (uniform random within square)
                px% = cx% + INT((RND * 2 - 1) * radius% + 0.5)
                py% = cy% + INT((RND * 2 - 1) * radius% + 0.5)
            END IF
            
            ' Paint single 1px dot at each spray point (spray area = radius, tips = 1px)
            PAINT_pset_with_symmetry px%, py%, col~&, TRUE
        NEXT i%
    END IF
END SUB

''
' The spray with Antialias on: an airbrush (Rick 2026-11-18: "spray like a real
' airbrush"). A cloud of fine droplets, gaussian around the nozzle (sigma = half
' the spray radius, none past it; a square brush gives a square cloud), each a
' faint sub-pixel deposit split over its four pixels. Paint flows per SECOND,
' not per frame, so holding still builds the colour up at the same rate at any
' frame rate, and the droplets of a frame spread along the path from the last
' spray so a fast drag leaves a band, not dots. The droplets gather in a
' coverage grid first and each pixel is written once (PAINT_blend_pixel_sym:
' selection, opacity lock, symmetry, gradient colour, straight-alpha over).
' The density per pixel does not depend on the size: a big airbrush builds up
' as fast as a small one.
'
SUB SPRAY_airbrush (cx AS INTEGER, cy AS INTEGER, col AS _UNSIGNED LONG)
    CONST AB_FLOW = 0.12      ' one droplet's deposit
    ' droplets per second per radius^2: the peak density is AB_RATE * 4 / (2 pi) droplets / px / s
    ' (sigma = r / 2), so 19 is ~12 / px / s - 0.4 a frame at 30 fps, ~0.05 coverage a frame: a
    ' second of holding builds the middle up to ~0.8. (540 was 30x that: solid in one frame.)
    CONST AB_RATE = 19
    DIM r AS SINGLE, sg AS SINGLE, ccx AS SINGLE, ccy AS SINGLE, lx AS SINGLE, ly AS SINGLE
    DIM now AS DOUBLE, dt AS DOUBLE, n AS LONG, k AS LONG, t AS SINGLE
    DIM x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER, gw AS LONG, gh AS LONG
    DIM dx AS SINGLE, dy AS SINGLE, rr AS SINGLE, ang AS SINGLE, fx AS SINGLE, fy AS SINGLE
    DIM ix AS LONG, iy AS LONG, wx AS SINGLE, wy AS SINGLE, sq AS INTEGER
    DIM x AS INTEGER, y AS INTEGER, g AS SINGLE

    r! = BRUSH_PIXEL_SIZES(BRUSH_SIZE.CURRENT) * 2 + 2
    IF r! < 4 THEN r! = 4
    r! = r! * CFG.SPRAY_SPREAD% / 100 ' (Tool Options SPREAD; 100 = as before)
    IF r! < 1 THEN r! = 1
    sg! = r! / 2
    sq% = (BRUSH_SIZE.SHAPE <> 0)
    ccx! = cx% + 0.5: ccy! = cy% + 0.5
    now# = TIMER(0.001)
    IF SPRAY.AB_FRESH THEN
        dt# = 1 / 30: lx! = ccx!: ly! = ccy!: SPRAY.AB_FRESH = FALSE
    ELSE
        dt# = now# - SPRAY.AB_LT
        IF dt# < 0 THEN dt# = dt# + 86400   ' past midnight
        lx! = SPRAY.AB_LX: ly! = SPRAY.AB_LY
    END IF
    IF dt# < 0.004 THEN dt# = 0.004
    IF dt# > 0.1 THEN dt# = 0.1
    SPRAY.AB_LX = ccx!: SPRAY.AB_LY = ccy!: SPRAY.AB_LT = now#

    ' (a big airbrush is capped at 6000 droplets a frame; each one then carries more)
    DIM nf AS SINGLE, fl AS SINGLE
    nf! = r! * r! * AB_RATE * dt# * CFG.SPRAY_DENSITY% / 100 ' (Tool Options DENSITY)
    n& = INT(nf! + 0.5)
    IF n& < 4 THEN n& = 4
    IF n& > 6000 THEN n& = 6000
    fl! = AB_FLOW * CFG.SPRAY_FLOW% / 100 ' (Tool Options FLOW)
    IF nf! > n& THEN fl! = fl! * nf! / n&
    IF fl! > 0.5 THEN fl! = 0.5

    x0% = INT(_MIN(lx!, ccx!) - r! - 1): x1% = INT(_MAX(lx!, ccx!) + r! + 1)
    y0% = INT(_MIN(ly!, ccy!) - r! - 1): y1% = INT(_MAX(ly!, ccy!) + r! + 1)
    gw& = x1% - x0% + 1: gh& = y1% - y0% + 1
    IF gw& * gh& > 4000000 THEN lx! = ccx!: ly! = ccy!: x0% = INT(ccx! - r! - 1): y0% = INT(ccy! - r! - 1): x1% = INT(ccx! + r! + 1): y1% = INT(ccy! + r! + 1): gw& = x1% - x0% + 1: gh& = y1% - y0% + 1
    DIM cov(0 TO gw& * gh& - 1) AS SINGLE

    FOR k& = 1 TO n&
        IF sq% THEN
            dx! = sg! * SQR(-2 * LOG(1 - RND)) * COS(6.2831853 * RND)
            dy! = sg! * SQR(-2 * LOG(1 - RND)) * COS(6.2831853 * RND)
            IF ABS(dx!) > r! _ORELSE ABS(dy!) > r! THEN _CONTINUE
        ELSE
            rr! = sg! * SQR(-2 * LOG(1 - RND))
            IF rr! > r! THEN _CONTINUE
            ang! = 6.2831853 * RND
            dx! = rr! * COS(ang!): dy! = rr! * SIN(ang!)
        END IF
        t! = RND
        fx! = lx! + (ccx! - lx!) * t! + dx! - 0.5 - x0%
        fy! = ly! + (ccy! - ly!) * t! + dy! - 0.5 - y0%
        ix& = INT(fx!): iy& = INT(fy!)
        IF ix& < 0 _ORELSE iy& < 0 _ORELSE ix& >= gw& - 1 _ORELSE iy& >= gh& - 1 THEN _CONTINUE
        wx! = fx! - ix&: wy! = fy! - iy&
        SPRAY_ab_add cov(), iy& * gw& + ix&, fl! * (1 - wx!) * (1 - wy!)
        SPRAY_ab_add cov(), iy& * gw& + ix& + 1, fl! * wx! * (1 - wy!)
        SPRAY_ab_add cov(), (iy& + 1) * gw& + ix&, fl! * (1 - wx!) * wy!
        SPRAY_ab_add cov(), (iy& + 1) * gw& + ix& + 1, fl! * wx! * wy!
    NEXT k&

    FOR y% = 0 TO gh& - 1
        FOR x% = 0 TO gw& - 1
            g! = cov(y% * gw& + x%)
            IF g! > 0.003 THEN PAINT_blend_pixel_sym x0% + x%, y0% + y%, col~&, g!
        NEXT x%
    NEXT y%
END SUB

''
' One droplet's share c onto the airbrush grid cell i (coverage over coverage).
'
SUB SPRAY_ab_add (cov() AS SINGLE, i AS LONG, c AS SINGLE)
    cov(i&) = cov(i&) + c! * (1 - cov(i&))
END SUB

''
' Reset spray tool state
'
SUB SPRAY_reset ()
    SAFE_FREEIMAGE SPRAY.HISTORY_BEFORE_IMG
    SPRAY.ACTIVE             = FALSE
    SPRAY.HISTORY_BEFORE_IMG = 0
    SPRAY.HISTORY_COLOR~&    = 0
END SUB
