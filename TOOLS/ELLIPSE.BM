''
' DRAW - TOOLS/ELLIPSE.BM
' =============================================================================
' Ellipse (CIRCLE) tool subs and functions.
'
' @todo
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Anti-aliasing coverage for a point relative to an ellipse boundary.
' Uses a signed-distance field: for offset (dx,dy) from center with radii (rx,ry),
' f = (dx/rx)^2 + (dy/ry)^2 is the implicit value (1 on the curve); dividing (sqrt(f)-1)
' by the gradient magnitude of sqrt(f) converts it to an approximate pixel distance to
' the boundary (negative inside, positive outside). For a circle this reduces exactly to
' |offset| - r. Returns coverage in [0,1]:
'   fill    (isOutline=FALSE): clamp(0.5 - sdf)   — half-pixel inside is full coverage
'   outline (isOutline=TRUE) : clamp(1 - |sdf|)   — peak on the curve, fades over ~1px
' Only used on the CFG.ANTIALIAS% path; the hard-edged algorithms are untouched.
'
' @param dx SINGLE X offset from ellipse center
' @param dy SINGLE Y offset from ellipse center
' @param rx SINGLE Horizontal radius
' @param ry SINGLE Vertical radius
' @param isOutline INTEGER TRUE = 1px outline coverage, FALSE = filled coverage
' @return SINGLE Coverage in [0,1]
'
FUNCTION ELLIPSE_coverage! (dx AS SINGLE, dy AS SINGLE, rx AS SINGLE, ry AS SINGLE, isOutline AS INTEGER)
    DIM f   AS SINGLE, sqrtf AS SINGLE
    DIM gx  AS SINGLE, gy    AS SINGLE, grad AS SINGLE
    DIM sdf AS SINGLE, cov   AS SINGLE

    IF rx! <= 0.0 OR ry! <= 0.0 THEN
        ELLIPSE_coverage! = 0.0
        EXIT FUNCTION
    END IF

    f!     = (dx! / rx!) * (dx! / rx!) + (dy! / ry!) * (dy! / ry!)
    sqrtf! = SQR(f!)

    ' grad = |gradient of sqrt(f)| * sqrt(f) = sqrt((dx/rx^2)^2 + (dy/ry^2)^2)
    gx!   = dx! / (rx! * rx!)
    gy!   = dy! / (ry! * ry!)
    grad! = SQR(gx! * gx! + gy! * gy!)

    IF grad! < 0.000001 THEN
        ' Center / degenerate — deep inside for fill, off the 1px ring for outline.
        IF isOutline% THEN cov! = 0.0 ELSE cov! = 1.0
        ELLIPSE_coverage! = cov!
        EXIT FUNCTION
    END IF

    ' Approximate signed distance to the boundary, in pixels (negative = inside).
    sdf! = (sqrtf! - 1.0) * sqrtf! / grad!

    IF isOutline% THEN
        cov! = 1.0 - ABS(sdf!)
    ELSE
        cov! = 0.5 - sdf!
    END IF
    IF cov! < 0.0 THEN cov! = 0.0
    IF cov! > 1.0 THEN cov! = 1.0

    ELLIPSE_coverage! = cov!
END FUNCTION

''
' Resets ellipse tool state
'
SUB ELLIPSE_reset ()
    ELLIPSE_TOOL.DRAGGING = FALSE
    ELLIPSE_TOOL.START_X  = 0
    ELLIPSE_TOOL.START_Y  = 0
    ELLIPSE_TOOL.END_X    = 0
    ELLIPSE_TOOL.END_Y    = 0
    ELLIPSE_TOOL.FILLED   = FALSE
    ELLIPSE_TOOL.SLICES   = 0
    ELLIPSE_TOOL.RINGS    = 0
END SUB

''
' Draw ellipse modifier lines (spokes and concentric rings).
' Called during preview and commit.
'
' @param cx INTEGER  Center X
' @param cy INTEGER  Center Y
' @param rx SINGLE   Horizontal radius
' @param ry SINGLE   Vertical radius
' @param col _UNSIGNED LONG  Draw color
' @param slices INTEGER  Number of radial spoke lines through center (n lines = 2n sectors)
' @param rings INTEGER   Number of concentric inner ellipses
'
SUB ELLIPSE_draw_modifiers (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG, slices AS INTEGER, rings AS INTEGER)
    DIM i      AS INTEGER
    DIM ang    AS SINGLE
    DIM spokex AS SINGLE, spokey AS SINGLE
    DIM asp    AS SINGLE
    IF rx! = 0 AND ry! = 0 THEN EXIT SUB
    IF rx! > 0 THEN asp! = ry! / rx! ELSE asp! = 1

    ' Radial spoke lines — n spokes through center at angles 0..PI*(n-1)/n
    IF slices% > 0 THEN
        FOR i% = 0 TO slices% - 1
            ang!    = _PI * i% / slices% ' [0, PI) — each line is a full diameter
            spokex! = rx! * COS(ang!)
            spokey! = ry! * SIN(ang!)
            LINE (cx% + INT(spokex! + 0.5), cy% + INT(spokey! + 0.5))-(cx% - INT(spokex! + 0.5), cy% - INT(spokey! + 0.5)), col~&
        NEXT i%
    END IF

    ' Concentric inner ellipses at equidistant fractions of the radius
    IF rings% > 0 THEN
        DIM scale AS SINGLE
        FOR i% = 1 TO rings%
            scale! = i% / (rings% + 1)
            CIRCLE (cx%, cy%), rx! * scale!, col~&, , , asp!
        NEXT i%
    END IF
END SUB


''
' Draws a thick brush-stamped ellipse outline using midpoint algorithm.
' Stamps the current brush shape at each pixel along the ellipse path.
' Symmetry, selection clipping, and opacity lock are handled by PAINT_stamp_brush.
' @param cx INTEGER Center X coordinate of the ellipse
' @param cy INTEGER Center Y coordinate of the ellipse
' @param rx SINGLE Horizontal radius of the ellipse
' @param ry SINGLE Vertical radius of the ellipse
' @param col _UNSIGNED LONG Drawing color (RGBA)
'
SUB ELLIPSE_draw_brushed (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    IF rx! <= 0 OR ry! <= 0 THEN EXIT SUB

    DIM AS INTEGER x, y
    DIM AS SINGLE rxSq, rySq, twoRxSq, twoRySq
    DIM AS SINGLE p

    rxSq!    = rx! * rx!
    rySq!    = ry! * ry!
    twoRxSq! = 2 * rxSq!
    twoRySq! = 2 * rySq!

    ' Region 1
    x% = 0
    y% = INT(ry! + 0.5)

    DIM AS SINGLE px, py
    px! = 0
    py! = twoRxSq! * y%

    ' Draw initial points in 4 quadrants
    PAINT_stamp_brush cx% + x%, cy% + y%, col~&
    PAINT_stamp_brush cx% - x%, cy% + y%, col~&
    PAINT_stamp_brush cx% + x%, cy% - y%, col~&
    PAINT_stamp_brush cx% - x%, cy% - y%, col~&

    p! = rySq! - (rxSq! * ry!) + (0.25 * rxSq!)

    WHILE px! < py!
        x% = x% + 1
        px! = px! + twoRySq!
        IF p! < 0 THEN
            p! = p! + rySq! + px!
        ELSE
            y% = y% - 1
            py! = py! - twoRxSq!
            p! = p! + rySq! + px! - py!
        END IF
        PAINT_stamp_brush cx% + x%, cy% + y%, col~&
        PAINT_stamp_brush cx% - x%, cy% + y%, col~&
        PAINT_stamp_brush cx% + x%, cy% - y%, col~&
        PAINT_stamp_brush cx% - x%, cy% - y%, col~&
    WEND

    ' Region 2
    p! = rySq! * (x% + 0.5) * (x% + 0.5) + rxSq! * (y% - 1) * (y% - 1) - rxSq! * rySq!
    WHILE y% >= 0
        y% = y% - 1
        py! = py! - twoRxSq!
        IF p! > 0 THEN
            p! = p! + rxSq! - py!
        ELSE
            x% = x% + 1
            px! = px! + twoRySq!
            p! = p! + rxSq! - py! + px!
        END IF
        PAINT_stamp_brush cx% + x%, cy% + y%, col~&
        PAINT_stamp_brush cx% - x%, cy% + y%, col~&
        PAINT_stamp_brush cx% + x%, cy% - y%, col~&
        PAINT_stamp_brush cx% - x%, cy% - y%, col~&
    WEND
END SUB

''
' Draws an ellipse outline with selection clipping using midpoint algorithm.
' Pixels are individually clipped against the active selection mask and opacity lock.
' @param cx INTEGER Center X coordinate of the ellipse
' @param cy INTEGER Center Y coordinate of the ellipse
' @param rx SINGLE Horizontal radius of the ellipse
' @param ry SINGLE Vertical radius of the ellipse
' @param col _UNSIGNED LONG Drawing color (RGBA)
'
SUB ELLIPSE_draw_clipped_outline (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    IF rx! <= 0 OR ry! <= 0 THEN EXIT SUB

    ' Anti-aliased outline (soft 1px ring). AA off = the verbatim midpoint algorithm below.
    IF CFG.ANTIALIAS% THEN
        ELLIPSE_draw_outline_aa cx%, cy%, rx!, ry!, col~&
        EXIT SUB
    END IF

    DIM AS INTEGER x, y
    DIM AS SINGLE rxSq, rySq, twoRxSq, twoRySq
    DIM AS SINGLE p
    
    rxSq!    = rx! * rx!
    rySq!    = ry! * ry!
    twoRxSq! = 2 * rxSq!
    twoRySq! = 2 * rySq!
    
    ' Region 1
    x% = 0
    y% = INT(ry! + 0.5)
    
    DIM AS SINGLE px, py
    px! = 0
    py! = twoRxSq! * y%
    
    ' Draw initial points in 4 quadrants
    IF SELECTION_is_point_inside%(cx% + x%, cy% + y%) AND OPACITY_LOCK_allows_draw%(cx% + x%, cy% + y%) THEN PSET (cx% + x%, cy% + y%), DRAWER_resolve_paint_color~&(cx% + x%, cy% + y%, col~&)
    IF SELECTION_is_point_inside%(cx% - x%, cy% + y%) AND OPACITY_LOCK_allows_draw%(cx% - x%, cy% + y%) THEN PSET (cx% - x%, cy% + y%), DRAWER_resolve_paint_color~&(cx% - x%, cy% + y%, col~&)
    IF SELECTION_is_point_inside%(cx% + x%, cy% - y%) AND OPACITY_LOCK_allows_draw%(cx% + x%, cy% - y%) THEN PSET (cx% + x%, cy% - y%), DRAWER_resolve_paint_color~&(cx% + x%, cy% - y%, col~&)
    IF SELECTION_is_point_inside%(cx% - x%, cy% - y%) AND OPACITY_LOCK_allows_draw%(cx% - x%, cy% - y%) THEN PSET (cx% - x%, cy% - y%), DRAWER_resolve_paint_color~&(cx% - x%, cy% - y%, col~&)
    
    p! = rySq! - (rxSq! * ry!) + (0.25 * rxSq!)
    
    WHILE px! < py!
        x% = x% + 1
        px! = px! + twoRySq!
        IF p! < 0 THEN
            p! = p! + rySq! + px!
        ELSE
            y% = y% - 1
            py! = py! - twoRxSq!
            p! = p! + rySq! + px! - py!
        END IF
        IF SELECTION_is_point_inside%(cx% + x%, cy% + y%) AND OPACITY_LOCK_allows_draw%(cx% + x%, cy% + y%) THEN PSET (cx% + x%, cy% + y%), DRAWER_resolve_paint_color~&(cx% + x%, cy% + y%, col~&)
        IF SELECTION_is_point_inside%(cx% - x%, cy% + y%) AND OPACITY_LOCK_allows_draw%(cx% - x%, cy% + y%) THEN PSET (cx% - x%, cy% + y%), DRAWER_resolve_paint_color~&(cx% - x%, cy% + y%, col~&)
        IF SELECTION_is_point_inside%(cx% + x%, cy% - y%) AND OPACITY_LOCK_allows_draw%(cx% + x%, cy% - y%) THEN PSET (cx% + x%, cy% - y%), DRAWER_resolve_paint_color~&(cx% + x%, cy% - y%, col~&)
        IF SELECTION_is_point_inside%(cx% - x%, cy% - y%) AND OPACITY_LOCK_allows_draw%(cx% - x%, cy% - y%) THEN PSET (cx% - x%, cy% - y%), DRAWER_resolve_paint_color~&(cx% - x%, cy% - y%, col~&)
    WEND
    
    ' Region 2
    p! = rySq! * (x% + 0.5) * (x% + 0.5) + rxSq! * (y% - 1) * (y% - 1) - rxSq! * rySq!
    WHILE y% >= 0
        y% = y% - 1
        py! = py! - twoRxSq!
        IF p! > 0 THEN
            p! = p! + rxSq! - py!
        ELSE
            x% = x% + 1
            px! = px! + twoRySq!
            p! = p! + rxSq! - py! + px!
        END IF
        IF SELECTION_is_point_inside%(cx% + x%, cy% + y%) AND OPACITY_LOCK_allows_draw%(cx% + x%, cy% + y%) THEN PSET (cx% + x%, cy% + y%), DRAWER_resolve_paint_color~&(cx% + x%, cy% + y%, col~&)
        IF SELECTION_is_point_inside%(cx% - x%, cy% + y%) AND OPACITY_LOCK_allows_draw%(cx% - x%, cy% + y%) THEN PSET (cx% - x%, cy% + y%), DRAWER_resolve_paint_color~&(cx% - x%, cy% + y%, col~&)
        IF SELECTION_is_point_inside%(cx% + x%, cy% - y%) AND OPACITY_LOCK_allows_draw%(cx% + x%, cy% - y%) THEN PSET (cx% + x%, cy% - y%), DRAWER_resolve_paint_color~&(cx% + x%, cy% - y%, col~&)
        IF SELECTION_is_point_inside%(cx% - x%, cy% - y%) AND OPACITY_LOCK_allows_draw%(cx% - x%, cy% - y%) THEN PSET (cx% - x%, cy% - y%), DRAWER_resolve_paint_color~&(cx% - x%, cy% - y%, col~&)
    WEND
END SUB

''
' Anti-aliased ellipse outline (soft 1px ring). Walks the boundary band and draws each
' pixel at its SDF outline coverage through PAINT_blend_pixel. Current-layer only (matches
' the outline callers, which set _DEST to the layer). Reached only when CFG.ANTIALIAS% is on.
'
' @param cx INTEGER Center X
' @param cy INTEGER Center Y
' @param rx SINGLE Horizontal radius
' @param ry SINGLE Vertical radius
' @param col _UNSIGNED LONG Outline color (RGBA)
'
SUB ELLIPSE_draw_outline_aa (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    IF rx! <= 0.0 OR ry! <= 0.0 THEN EXIT SUB

    DIM px  AS INTEGER, py AS INTEGER
    DIM x0  AS INTEGER, x1 AS INTEGER, y0 AS INTEGER, y1 AS INTEGER
    DIM cov AS SINGLE

    x0% = cx% - INT(rx! + 0.5) - 1
    x1% = cx% + INT(rx! + 0.5) + 1
    y0% = cy% - INT(ry! + 0.5) - 1
    y1% = cy% + INT(ry! + 0.5) + 1

    FOR py% = y0% TO y1%
        FOR px% = x0% TO x1%
            cov! = ELLIPSE_coverage!(px% - cx%, py% - cy%, rx!, ry!, TRUE)
            IF cov! > 0.0 THEN PAINT_blend_pixel px%, py%, col~&, cov!
        NEXT px%
    NEXT py%
END SUB

''
' Fills an ellipse using scanline algorithm (more reliable than PAINT).
' Respects selection clipping, opacity lock, and drawer paint modes.
' @param cx INTEGER Center X coordinate of the ellipse
' @param cy INTEGER Center Y coordinate of the ellipse
' @param rx SINGLE Horizontal radius of the ellipse
' @param ry SINGLE Vertical radius of the ellipse
' @param fill_color _UNSIGNED LONG Fill color (RGBA)
' @param dest_image LONG Target image handle to draw into
'
SUB ELLIPSE_fill_scanline (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, fill_color AS _UNSIGNED LONG, dest_image AS LONG)
    IF rx! <= 0 OR ry! <= 0 THEN EXIT SUB

    ' Anti-aliased fill (soft edge) — all callers commit to the current layer, which is
    ' what PAINT_blend_pixel targets. AA off = the verbatim scanline path below.
    IF CFG.ANTIALIAS% THEN
        ELLIPSE_fill_scanline_aa cx%, cy%, rx!, ry!, fill_color~&
        EXIT SUB
    END IF

    DIM AS INTEGER y, x_left, x_right, scan_x
    DIM AS SINGLE dx
    DIM AS INTEGER y_start, y_end
    DIM oldDest          AS LONG
    DIM has_selection    AS INTEGER
    DIM use_drawer_paint AS INTEGER
    DIM rc               AS _UNSIGNED LONG
    
    oldDest& = _DEST
    _DEST dest_image&
    
    ' Check if there's an active selection for clipping
    has_selection%    = SELECTION_has_active%
    use_drawer_paint% = DRAWER_has_paint_mode%
    
    ' Calculate y range with proper rounding to avoid missing scanlines
    y_start% = cy% - INT(ry! + 0.5)
    y_end%   = cy% + INT(ry! + 0.5)
    
    ' Ensure at least one scanline for very thin ellipses
    IF y_start% = y_end% THEN y_end% = y_start% + 1
    
    ' For each scanline from top to bottom of ellipse
    FOR y% = y_start% TO y_end%
        ' Calculate x extent at this y using ellipse equation: (x/rx)^2 + (y/ry)^2 = 1
        ' Solving for x: x = rx * sqrt(1 - (y/ry)^2)
        DIM dy AS SINGLE
        dy! = (y% - cy%) / ry!
        
        IF ABS(dy!) <= 1.0001 THEN ' Small tolerance for rounding errors
            dx! = rx! * SQR(1 - dy! * dy!)
            ' Use proper rounding instead of truncation
            x_left%  = cx% - INT(dx! + 0.5)
            x_right% = cx% + INT(dx! + 0.5)
            
            ' Ensure at least one pixel for very thin ellipses
            IF x_left% > x_right% THEN x_left% = x_right%
            
            ' Draw horizontal line for this scanline
            IF x_left% <= x_right% THEN
                IF use_drawer_paint% OR has_selection% THEN
                    ' Clipped paint/gradient fill — skip transparent to avoid erasing
                    FOR scan_x% = x_left% TO x_right%
                        IF (NOT has_selection% OR SELECTION_is_point_inside%(scan_x%, y%)) AND OPACITY_LOCK_allows_draw%(scan_x%, y%) THEN
                            rc~& = DRAWER_resolve_paint_color~&(scan_x%, y%, fill_color~&)
                            IF _ALPHA32(rc~&) > 0 THEN PSET (scan_x%, y%), rc~&
                        END IF
                    NEXT scan_x%
                ELSE
                    ' Solid fill - check opacity lock per pixel if enabled
                    IF LAYERS(CURRENT_LAYER%).opacityLock% THEN
                        FOR scan_x% = x_left% TO x_right%
                            IF OPACITY_LOCK_allows_draw%(scan_x%, y%) THEN
                                PSET (scan_x%, y%), DRAWER_resolve_paint_color~&(scan_x%, y%, fill_color~&)
                            END IF
                        NEXT scan_x%
                    ELSE
                        ' Fast path - no selection or opacity lock
                        LINE (x_left%, y%)-(x_right%, y%), fill_color~&
                    END IF
                END IF
            END IF
        END IF
    NEXT y%

    _DEST oldDest&
END SUB

''
' Anti-aliased filled ellipse. Walks the bounding box (extended 1px for the fringe)
' and draws each pixel at its SDF fill coverage through PAINT_blend_pixel (which honors
' selection clip, opacity lock, resolved paint color, and coverage). Interior pixels get
' coverage 1 = a solid write; only the boundary band is feathered. Current-layer only
' (matches every ELLIPSE_fill_scanline caller). Reached only when CFG.ANTIALIAS% is on.
'
' @param cx INTEGER Center X
' @param cy INTEGER Center Y
' @param rx SINGLE Horizontal radius
' @param ry SINGLE Vertical radius
' @param fill_color _UNSIGNED LONG Fill color (RGBA), resolved per-pixel by PAINT_blend_pixel
'
SUB ELLIPSE_fill_scanline_aa (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, fill_color AS _UNSIGNED LONG)
    IF rx! <= 0.0 OR ry! <= 0.0 THEN EXIT SUB

    DIM px  AS INTEGER, py AS INTEGER
    DIM x0  AS INTEGER, x1 AS INTEGER, y0 AS INTEGER, y1 AS INTEGER
    DIM cov AS SINGLE

    x0% = cx% - INT(rx! + 0.5) - 1
    x1% = cx% + INT(rx! + 0.5) + 1
    y0% = cy% - INT(ry! + 0.5) - 1
    y1% = cy% + INT(ry! + 0.5) + 1

    FOR py% = y0% TO y1%
        FOR px% = x0% TO x1%
            cov! = ELLIPSE_coverage!(px% - cx%, py% - cy%, rx!, ry!, FALSE)
            IF cov! > 0.0 THEN PAINT_blend_pixel px%, py%, fill_color~&, cov!
        NEXT px%
    NEXT py%
END SUB
