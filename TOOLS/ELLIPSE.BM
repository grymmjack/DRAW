''
' DRAW - TOOLS/ELLIPSE.BM
' =============================================================================
' Ellipse (CIRCLE) tool subs and functions.
'
' @todo
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Anti-aliasing coverage for a point relative to an ellipse boundary.
' Uses a signed-distance field: for offset (dx,dy) from center with radii (rx,ry),
' f = (dx/rx)^2 + (dy/ry)^2 is the implicit value (1 on the curve); dividing (sqrt(f)-1)
' by the gradient magnitude of sqrt(f) converts it to an approximate pixel distance to
' the boundary (negative inside, positive outside). For a circle this reduces exactly to
' |offset| - r. Returns coverage in [0,1]:
'   fill    (isOutline=FALSE): clamp(0.5 - sdf)   — half-pixel inside is full coverage
'   outline (isOutline=TRUE) : clamp(1 - |sdf|)   — peak on the curve, fades over ~1px
' Only used on the CFG.ANTIALIAS% path; the hard-edged algorithms are untouched.
'
' @param dx SINGLE X offset from ellipse center
' @param dy SINGLE Y offset from ellipse center
' @param rx SINGLE Horizontal radius
' @param ry SINGLE Vertical radius
' @param isOutline INTEGER TRUE = 1px outline coverage, FALSE = filled coverage
' @return SINGLE Coverage in [0,1]
'
FUNCTION ELLIPSE_coverage! (dx AS SINGLE, dy AS SINGLE, rx AS SINGLE, ry AS SINGLE, isOutline AS INTEGER)
    DIM f   AS SINGLE, sqrtf AS SINGLE
    DIM gx  AS SINGLE, gy    AS SINGLE, grad AS SINGLE
    DIM sdf AS SINGLE, cov   AS SINGLE

    IF rx! <= 0.0 OR ry! <= 0.0 THEN
        ELLIPSE_coverage! = 0.0
        EXIT FUNCTION
    END IF

    f!     = (dx! / rx!) * (dx! / rx!) + (dy! / ry!) * (dy! / ry!)
    sqrtf! = SQR(f!)

    ' grad = |gradient of sqrt(f)| * sqrt(f) = sqrt((dx/rx^2)^2 + (dy/ry^2)^2)
    gx!   = dx! / (rx! * rx!)
    gy!   = dy! / (ry! * ry!)
    grad! = SQR(gx! * gx! + gy! * gy!)

    IF grad! < 0.000001 THEN
        ' Center / degenerate — deep inside for fill, off the 1px ring for outline.
        IF isOutline% THEN cov! = 0.0 ELSE cov! = 1.0
        ELLIPSE_coverage! = cov!
        EXIT FUNCTION
    END IF

    ' Approximate signed distance to the boundary, in pixels (negative = inside).
    sdf! = (sqrtf! - 1.0) * sqrtf! / grad!

    IF isOutline% THEN
        cov! = 1.0 - ABS(sdf!)
    ELSE
        cov! = 0.5 - sdf!
    END IF
    IF cov! < 0.0 THEN cov! = 0.0
    IF cov! > 1.0 THEN cov! = 1.0

    ELLIPSE_coverage! = cov!
END FUNCTION

''
' Resets ellipse tool state
'
SUB ELLIPSE_reset ()
    ELLIPSE_TOOL.DRAGGING = FALSE
    ELLIPSE_TOOL.START_X  = 0
    ELLIPSE_TOOL.START_Y  = 0
    ELLIPSE_TOOL.END_X    = 0
    ELLIPSE_TOOL.END_Y    = 0
    ELLIPSE_TOOL.FILLED   = FALSE
    ELLIPSE_TOOL.SLICES   = 0
    ELLIPSE_TOOL.RINGS    = 0
END SUB

''
' Resolves the pixel box an ellipse occupies from the tool's (center, radius) form.
' Callers derive cx = (start + end) \ 2 and rx = |end - start| / 2, so rx is a whole
' or half number and the box is exactly the dragged start..end span (w = 2rx + 1).
' Any other radius (modifier rings) is rounded to the nearest whole-pixel box.
'
' @param cx INTEGER Center X            @param cy INTEGER Center Y
' @param rx SINGLE Horizontal radius    @param ry SINGLE Vertical radius
' @param x0 INTEGER (out) Box left      @param y0 INTEGER (out) Box top
' @param w INTEGER (out) Box width      @param h INTEGER (out) Box height
'
SUB ELLIPSE_get_box (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, x0 AS INTEGER, y0 AS INTEGER, w AS INTEGER, h AS INTEGER)
    w%  = CINT(ABS(rx!) * 2) + 1
    h%  = CINT(ABS(ry!) * 2) + 1
    x0% = cx% - (w% - 1) \ 2
    y0% = cy% - (h% - 1) \ 2
END SUB

''
' Computes the rows of a pixel-exact ellipse inscribed in a w x h pixel box into
' ELLIPSE_INSET%(0 TO h-1): row j covers box columns inset .. w-1-inset.
'
' A pixel is inside when its CENTER lies inside the ideal ellipse whose edge is the
' box's outer pixel edge (semi-axes w/2, h/2, pulled in 0.1px so tiny circles round
' off their corners). Unlike a midpoint/angle-stepped walk around an integer center,
' this never rounds a half-pixel radius outward at the four extremes, so there are
' no single-pixel "ticks" on the top/bottom/left/right edges and even and odd sizes
' are both symmetric and fill exactly the dragged box.
'
' @param w INTEGER Box width in pixels (>= 1)
' @param h INTEGER Box height in pixels (>= 1)
'
SUB ELLIPSE_calc_insets (w AS INTEGER, h AS INTEGER)
    DIM j AS INTEGER
    REDIM ELLIPSE_INSET(0 TO h% - 1) AS INTEGER
    FOR j% = 0 TO h% - 1
        ELLIPSE_INSET(j%) = ELLIPSE_row_inset%(w%, h%, j%)
    NEXT j%
END SUB

''
' Left inset of row j of the pixel-exact ellipse inscribed in a w x h box (see
' ELLIPSE_calc_insets). The BAS/QB64 exporters emit this same routine verbatim as
' EllipseInset% (FILE_BAS_write_ellipse_helpers) -- keep the two identical so
' exported programs reproduce the drawing pixel for pixel.
'
' @param w INTEGER Box width in pixels (>= 1)
' @param h INTEGER Box height in pixels (>= 1)
' @param j INTEGER Row, 0 .. h-1
' @return INTEGER Columns inset .. w-1-inset of the row are inside the ellipse
'
FUNCTION ELLIPSE_row_inset% (w AS INTEGER, h AS INTEGER, j AS INTEGER)
    DIM a AS DOUBLE, b AS DOUBLE, v AS DOUBLE, t AS DOUBLE, e AS DOUBLE, ins AS INTEGER
    ' The middle row(s) always reach the box sides, so the shape spans the full drag.
    IF j% = (h% - 1) \ 2 _ORELSE j% = h% \ 2 THEN EXIT FUNCTION
    a# = w% / 2# - 0.1#
    b# = h% / 2# - 0.1#
    v# = j% - (h% - 1) / 2#
    t# = 1# - (v# / b#) * (v# / b#)
    IF t# < 0# THEN t# = 0#
    e#   = a# * SQR(t#)
    ins% = -INT(-((w% - 1) / 2# - e# - 0.000001#)) ' ceil
    IF ins% < 0 THEN ins% = 0
    IF ins% > (w% - 1) \ 2 THEN ins% = (w% - 1) \ 2
    ELLIPSE_row_inset% = ins%
END FUNCTION

''
' Plots one outline pixel through the requested write path.
'
SUB ELLIPSE_plot_px (x AS INTEGER, y AS INTEGER, col AS _UNSIGNED LONG, mode AS INTEGER)
    SELECT CASE mode%
        CASE ELLIPSE_PLOT_PSET
            PSET (x%, y%), col~&
        CASE ELLIPSE_PLOT_CLIPPED
            IF SELECTION_is_point_inside%(x%, y%) THEN
                IF OPACITY_LOCK_allows_draw%(x%, y%) THEN PSET (x%, y%), DRAWER_resolve_paint_color~&(x%, y%, col~&)
            END IF
        CASE ELLIPSE_PLOT_BRUSH
            PAINT_stamp_brush x%, y%, col~&
        CASE ELLIPSE_PLOT_PREVIEW
            PREVIEW_stamp_brush x%, y%, col~&
    END SELECT
END SUB

''
' Draws a 1px, 8-connected ellipse outline (no doubled corners, no edge ticks).
' The outline is the boundary of the ELLIPSE_calc_insets fill: in each row, the
' pixels whose row above or below is narrower. Every pixel is written exactly once,
' so translucent colours don't darken where segments would otherwise overlap.
'
' @param cx INTEGER Center X            @param cy INTEGER Center Y
' @param rx SINGLE Horizontal radius    @param ry SINGLE Vertical radius
' @param col _UNSIGNED LONG Colour (RGBA)
' @param mode INTEGER ELLIPSE_PLOT_* write path
'
SUB ELLIPSE_plot_outline (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG, mode AS INTEGER)
    IF rx! < 0 OR ry! < 0 THEN EXIT SUB

    DIM x0    AS INTEGER, y0 AS INTEGER, w AS INTEGER, h AS INTEGER
    DIM j     AS INTEGER, x AS INTEGER, lft AS INTEGER, rgt AS INTEGER
    DIM inner AS INTEGER, leftEnd AS INTEGER, rightStart AS INTEGER

    ELLIPSE_get_box cx%, cy%, rx!, ry!, x0%, y0%, w%, h%
    ELLIPSE_calc_insets w%, h%

    FOR j% = 0 TO h% - 1
        lft% = ELLIPSE_INSET(j%)
        rgt% = w% - 1 - lft%

        ' Inset of the narrower vertical neighbour (a row outside the box is empty = w).
        inner% = w%
        IF j% > 0 AND j% < h% - 1 THEN
            inner% = ELLIPSE_INSET(j% - 1)
            IF ELLIPSE_INSET(j% + 1) > inner% THEN inner% = ELLIPSE_INSET(j% + 1)
        END IF

        leftEnd% = inner% - 1
        IF leftEnd% < lft% THEN leftEnd% = lft%
        rightStart% = w% - 1 - leftEnd%

        IF leftEnd% + 1 >= rightStart% THEN
            FOR x% = lft% TO rgt%
                ELLIPSE_plot_px x0% + x%, y0% + j%, col~&, mode%
            NEXT x%
        ELSE
            FOR x% = lft% TO leftEnd%
                ELLIPSE_plot_px x0% + x%, y0% + j%, col~&, mode%
            NEXT x%
            FOR x% = rightStart% TO rgt%
                ELLIPSE_plot_px x0% + x%, y0% + j%, col~&, mode%
            NEXT x%
        END IF
    NEXT j%
END SUB

''
' Solid, unclipped filled ellipse onto _DEST (tool preview). Same pixels as
' ELLIPSE_fill_scanline, one LINE per row so each pixel is written once.
'
' @param cx INTEGER Center X            @param cy INTEGER Center Y
' @param rx SINGLE Horizontal radius    @param ry SINGLE Vertical radius
' @param col _UNSIGNED LONG Fill colour (RGBA)
'
SUB ELLIPSE_fill_plain (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    IF rx! < 0 OR ry! < 0 THEN EXIT SUB

    DIM x0 AS INTEGER, y0 AS INTEGER, w AS INTEGER, h AS INTEGER, j AS INTEGER

    ELLIPSE_get_box cx%, cy%, rx!, ry!, x0%, y0%, w%, h%
    ELLIPSE_calc_insets w%, h%
    FOR j% = 0 TO h% - 1
        LINE (x0% + ELLIPSE_INSET(j%), y0% + j%)-(x0% + w% - 1 - ELLIPSE_INSET(j%), y0% + j%), col~&
    NEXT j%
END SUB

''
' Draws one ellipse of the live tool preview onto _DEST (the shape overlay): filled
' (drawer paint mode resolves each pixel like the commit) or 1px outline.
'
' @param cx INTEGER Center X            @param cy INTEGER Center Y
' @param rx SINGLE Horizontal radius    @param ry SINGLE Vertical radius
' @param col _UNSIGNED LONG Preview colour
'
SUB ELLIPSE_preview_one (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    DIM x0 AS INTEGER, y0 AS INTEGER, w AS INTEGER, h AS INTEGER
    DIM j  AS INTEGER, x AS INTEGER

    IF NOT ELLIPSE_TOOL.FILLED THEN
        ELLIPSE_plot_outline cx%, cy%, rx!, ry!, col~&, ELLIPSE_PLOT_PSET
    ELSEIF DRAWER_has_paint_mode% THEN
        ELLIPSE_get_box cx%, cy%, rx!, ry!, x0%, y0%, w%, h%
        ELLIPSE_calc_insets w%, h%
        FOR j% = 0 TO h% - 1
            FOR x% = x0% + ELLIPSE_INSET(j%) TO x0% + w% - 1 - ELLIPSE_INSET(j%)
                PSET (x%, y0% + j%), DRAWER_resolve_paint_color~&(x%, y0% + j%, DRAW_COLOR~&)
            NEXT x%
        NEXT j%
    ELSE
        ELLIPSE_fill_plain cx%, cy%, rx!, ry!, col~&
    END IF
END SUB

''
' Draw ellipse modifier lines (spokes and concentric rings).
' Called during preview and commit.
'
' @param cx INTEGER  Center X
' @param cy INTEGER  Center Y
' @param rx SINGLE   Horizontal radius
' @param ry SINGLE   Vertical radius
' @param col _UNSIGNED LONG  Draw color
' @param slices INTEGER  Number of radial spoke lines through center (n lines = 2n sectors)
' @param rings INTEGER   Number of concentric inner ellipses
'
SUB ELLIPSE_draw_modifiers (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG, slices AS INTEGER, rings AS INTEGER)
    DIM i      AS INTEGER
    DIM ang    AS SINGLE
    DIM spokex AS SINGLE, spokey AS SINGLE
    IF rx! = 0 AND ry! = 0 THEN EXIT SUB

    ' Radial spoke lines — n spokes through center at angles 0..PI*(n-1)/n
    IF slices% > 0 THEN
        FOR i% = 0 TO slices% - 1
            ang!    = _PI * i% / slices% ' [0, PI) — each line is a full diameter
            spokex! = rx! * COS(ang!)
            spokey! = ry! * SIN(ang!)
            LINE (cx% + INT(spokex! + 0.5), cy% + INT(spokey! + 0.5))-(cx% - INT(spokex! + 0.5), cy% - INT(spokey! + 0.5)), col~&
        NEXT i%
    END IF

    ' Concentric inner ellipses at equidistant fractions of the radius
    IF rings% > 0 THEN
        DIM scale AS SINGLE
        FOR i% = 1 TO rings%
            scale! = i% / (rings% + 1)
            ELLIPSE_plot_outline cx%, cy%, rx! * scale!, ry! * scale!, col~&, ELLIPSE_PLOT_PSET
        NEXT i%
    END IF
END SUB


''
' Draws a thick brush-stamped ellipse outline (ELLIPSE_plot_outline path).
' Stamps the current brush shape at each pixel along the ellipse path.
' Symmetry, selection clipping, and opacity lock are handled by PAINT_stamp_brush.
' @param cx INTEGER Center X coordinate of the ellipse
' @param cy INTEGER Center Y coordinate of the ellipse
' @param rx SINGLE Horizontal radius of the ellipse
' @param ry SINGLE Vertical radius of the ellipse
' @param col _UNSIGNED LONG Drawing color (RGBA)
'
SUB ELLIPSE_draw_brushed (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    IF rx! < 0 OR ry! < 0 THEN EXIT SUB
    ELLIPSE_plot_outline cx%, cy%, rx!, ry!, col~&, ELLIPSE_PLOT_BRUSH
END SUB

''
' Draws an ellipse outline with selection clipping (ELLIPSE_plot_outline path).
' Pixels are individually clipped against the active selection mask and opacity lock.
' @param cx INTEGER Center X coordinate of the ellipse
' @param cy INTEGER Center Y coordinate of the ellipse
' @param rx SINGLE Horizontal radius of the ellipse
' @param ry SINGLE Vertical radius of the ellipse
' @param col _UNSIGNED LONG Drawing color (RGBA)
'
SUB ELLIPSE_draw_clipped_outline (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    ' Anti-aliased outline (soft 1px ring). AA off = the pixel-exact outline below.
    IF CFG.ANTIALIAS% THEN
        ELLIPSE_draw_outline_aa cx%, cy%, rx!, ry!, col~&
        EXIT SUB
    END IF

    ELLIPSE_plot_outline cx%, cy%, rx!, ry!, col~&, ELLIPSE_PLOT_CLIPPED
END SUB

''
' Anti-aliased ellipse outline (soft 1px ring). Walks the boundary band and draws each
' pixel at its SDF outline coverage through PAINT_blend_pixel. Current-layer only (matches
' the outline callers, which set _DEST to the layer). Reached only when CFG.ANTIALIAS% is on.
'
' @param cx INTEGER Center X
' @param cy INTEGER Center Y
' @param rx SINGLE Horizontal radius
' @param ry SINGLE Vertical radius
' @param col _UNSIGNED LONG Outline color (RGBA)
'
SUB ELLIPSE_draw_outline_aa (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    IF rx! < 0.0 OR ry! < 0.0 THEN EXIT SUB

    DIM px  AS INTEGER, py AS INTEGER
    DIM x0  AS INTEGER, y0 AS INTEGER, w AS INTEGER, h AS INTEGER
    DIM fcx AS SINGLE, fcy AS SINGLE, arx AS SINGLE, ary AS SINGLE
    DIM cov AS SINGLE

    ' Centre the SDF on the true centre of the dragged pixel box (a half pixel for odd
    ' spans), not the integer cx/cy: an off-centre SDF spills a half-alpha bump one
    ' pixel outside the box at the extremes -- the AA version of the edge "tick".
    ELLIPSE_get_box cx%, cy%, rx!, ry!, x0%, y0%, w%, h%
    fcx! = x0% + (w% - 1) / 2
    fcy! = y0% + (h% - 1) / 2
    ' Outline: the ring peaks on the centres of the box's outermost pixels.
    arx! = (w% - 1) / 2 : IF arx! < 0.5 THEN arx! = 0.5
    ary! = (h% - 1) / 2 : IF ary! < 0.5 THEN ary! = 0.5

    FOR py% = y0% - 1 TO y0% + h%
        FOR px% = x0% - 1 TO x0% + w%
            cov! = ELLIPSE_coverage!(px% - fcx!, py% - fcy!, arx!, ary!, TRUE)
            IF cov! > 0.0 THEN PAINT_blend_pixel px%, py%, col~&, cov!
        NEXT px%
    NEXT py%
END SUB

''
' Fills an ellipse using scanline algorithm (more reliable than PAINT).
' Respects selection clipping, opacity lock, and drawer paint modes.
' @param cx INTEGER Center X coordinate of the ellipse
' @param cy INTEGER Center Y coordinate of the ellipse
' @param rx SINGLE Horizontal radius of the ellipse
' @param ry SINGLE Vertical radius of the ellipse
' @param fill_color _UNSIGNED LONG Fill color (RGBA)
' @param dest_image LONG Target image handle to draw into
'
SUB ELLIPSE_fill_scanline (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, fill_color AS _UNSIGNED LONG, dest_image AS LONG)
    IF rx! <= 0 OR ry! <= 0 THEN EXIT SUB

    ' Anti-aliased fill (soft edge) — all callers commit to the current layer, which is
    ' what PAINT_blend_pixel targets. AA off = the pixel-exact scanline path below.
    IF CFG.ANTIALIAS% THEN
        ELLIPSE_fill_scanline_aa cx%, cy%, rx!, ry!, fill_color~&
        EXIT SUB
    END IF

    DIM AS INTEGER y, x_left, x_right, scan_x
    DIM oldDest          AS LONG
    DIM has_selection    AS INTEGER
    DIM use_drawer_paint AS INTEGER
    DIM rc               AS _UNSIGNED LONG
    
    oldDest& = _DEST
    _DEST dest_image&

    ' APRON (gotcha #14): dest_image& is the current layer's buffer, which is larger
    ' than the canvas when the layer is apron-promoted. Offset the pixel WRITES by the
    ' layer's apron; the selection clip / opacity lock / color resolve stay in CANVAS
    ' coords (matches BRUSH.BM and the RECT solid fill). Without this a filled ellipse
    ' on a promoted layer lands in the apron border and never shows on the canvas.
    DIM apW AS INTEGER, apH AS INTEGER
    apW% = 0 : apH% = 0
    IF CURRENT_LAYER% >= 1 AND CURRENT_LAYER% <= MAX_LAYERS THEN
        apW% = LAYERS(CURRENT_LAYER%).apronW%
        apH% = LAYERS(CURRENT_LAYER%).apronH%
    END IF

    ' Check if there's an active selection for clipping
    has_selection%    = SELECTION_has_active%
    use_drawer_paint% = DRAWER_has_paint_mode%
    
    ' Rows come from the same pixel-exact rasterizer as the outline, so the fill
    ' covers exactly the dragged box with no edge ticks and lines up with the stroke.
    DIM box_x0 AS INTEGER, box_y0 AS INTEGER, box_w AS INTEGER, box_h AS INTEGER
    ELLIPSE_get_box cx%, cy%, rx!, ry!, box_x0%, box_y0%, box_w%, box_h%
    ELLIPSE_calc_insets box_w%, box_h%

    ' For each scanline from top to bottom of ellipse
    FOR y% = box_y0% TO box_y0% + box_h% - 1
        x_left%  = box_x0% + ELLIPSE_INSET(y% - box_y0%)
        x_right% = box_x0% + box_w% - 1 - ELLIPSE_INSET(y% - box_y0%)
        ' Draw horizontal line for this scanline
        IF x_left% <= x_right% THEN
            IF use_drawer_paint% OR has_selection% THEN
                ' Clipped paint/gradient fill — skip transparent to avoid erasing
                FOR scan_x% = x_left% TO x_right%
                    IF (NOT has_selection% OR SELECTION_is_point_inside%(scan_x%, y%)) AND OPACITY_LOCK_allows_draw%(scan_x%, y%) THEN
                        rc~& = DRAWER_resolve_paint_color~&(scan_x%, y%, fill_color~&)
                        IF _ALPHA32(rc~&) > 0 THEN PSET (scan_x% + apW%, y% + apH%), rc~&
                    END IF
                NEXT scan_x%
            ELSE
                ' Solid fill - check opacity lock per pixel if enabled
                IF LAYERS(CURRENT_LAYER%).opacityLock% THEN
                    FOR scan_x% = x_left% TO x_right%
                        IF OPACITY_LOCK_allows_draw%(scan_x%, y%) THEN
                            PSET (scan_x% + apW%, y% + apH%), DRAWER_resolve_paint_color~&(scan_x%, y%, fill_color~&)
                        END IF
                    NEXT scan_x%
                ELSE
                    ' Fast path - no selection or opacity lock
                    LINE (x_left% + apW%, y% + apH%)-(x_right% + apW%, y% + apH%), fill_color~&
                END IF
            END IF
        END IF
    NEXT y%

    _DEST oldDest&
END SUB

''
' Anti-aliased filled ellipse. Walks the bounding box (extended 1px for the fringe)
' and draws each pixel at its SDF fill coverage through PAINT_blend_pixel (which honors
' selection clip, opacity lock, resolved paint color, and coverage). Interior pixels get
' coverage 1 = a solid write; only the boundary band is feathered. Current-layer only
' (matches every ELLIPSE_fill_scanline caller). Reached only when CFG.ANTIALIAS% is on.
'
' @param cx INTEGER Center X
' @param cy INTEGER Center Y
' @param rx SINGLE Horizontal radius
' @param ry SINGLE Vertical radius
' @param fill_color _UNSIGNED LONG Fill color (RGBA), resolved per-pixel by PAINT_blend_pixel
'
SUB ELLIPSE_fill_scanline_aa (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, fill_color AS _UNSIGNED LONG)
    IF rx! < 0.0 OR ry! < 0.0 THEN EXIT SUB

    DIM px  AS INTEGER, py AS INTEGER
    DIM x0  AS INTEGER, y0 AS INTEGER, w AS INTEGER, h AS INTEGER
    DIM fcx AS SINGLE, fcy AS SINGLE, arx AS SINGLE, ary AS SINGLE
    DIM cov AS SINGLE

    ' Centre the SDF on the true centre of the dragged pixel box (a half pixel for odd
    ' spans), not the integer cx/cy: an off-centre SDF spills a half-alpha bump one
    ' pixel outside the box at the extremes -- the AA version of the edge "tick".
    ELLIPSE_get_box cx%, cy%, rx!, ry!, x0%, y0%, w%, h%
    fcx! = x0% + (w% - 1) / 2
    fcy! = y0% + (h% - 1) / 2
    ' Fill: the edge is the box's outer pixel edge (half-coverage there).
    arx! = w% / 2
    ary! = h% / 2

    FOR py% = y0% - 1 TO y0% + h%
        FOR px% = x0% - 1 TO x0% + w%
            cov! = ELLIPSE_coverage!(px% - fcx!, py% - fcy!, arx!, ary!, FALSE)
            IF cov! > 0.0 THEN PAINT_blend_pixel px%, py%, fill_color~&, cov!
        NEXT px%
    NEXT py%
END SUB
