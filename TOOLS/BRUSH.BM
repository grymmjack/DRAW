''
' DRAW - TOOLS/BRUSH.BM
' =============================================================================
' Brush tool subs and functions.
'
' @todo
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Check if opacity lock allows drawing at the given position
' Returns TRUE if drawing is allowed, FALSE if blocked (transparent pixel with opacity lock)
' @param x INTEGER - X coordinate
' @param y INTEGER - Y coordinate
' @return INTEGER - TRUE if drawing allowed, FALSE if blocked
'
FUNCTION OPACITY_LOCK_allows_draw% (x AS INTEGER, y AS INTEGER)
    ' If opacity lock is not enabled, always allow drawing
    IF NOT LAYERS(CURRENT_LAYER%).opacityLock% THEN
        OPACITY_LOCK_allows_draw% = TRUE
        EXIT FUNCTION
    END IF
    
    ' Check if the target pixel has any alpha (non-transparent)
    DIM oldSrc     AS LONG
    DIM pixelAlpha AS INTEGER
    oldSrc& = _SOURCE
    _SOURCE LAYER_current_image&
    pixelAlpha% = _ALPHA32(POINT(x%, y%))
    _SOURCE oldSrc&
    
    ' Allow drawing only on non-transparent pixels (alpha > 0)
    OPACITY_LOCK_allows_draw% = (pixelAlpha% > 0)
END FUNCTION


''
' Draw a pixel with symmetry support
' @param x INTEGER - X coordinate
' @param y INTEGER - Y coordinate
' @param col _UNSIGNED LONG - Color to draw
' @param apply_symmetry INTEGER - TRUE to apply symmetry, FALSE for master stroke only
'
SUB PAINT_pset_with_symmetry (x AS INTEGER, y AS INTEGER, col AS _UNSIGNED LONG, apply_symmetry AS INTEGER)
    DIM mx(0 TO 7) AS INTEGER
    DIM my(0 TO 7) AS INTEGER
    DIM count          AS INTEGER
    DIM i              AS INTEGER
    DIM oldDest        AS LONG
    DIM targetImg      AS LONG
    DIM is_transparent AS INTEGER
    DIM resolvedCol    AS _UNSIGNED LONG
    
    targetImg& = LAYER_current_image&
    oldDest&   = _DEST
    _DEST targetImg&

    ' BUG-14/16: if the current layer is apron-promoted, its buffer is larger than the canvas —
    ' canvas (x,y) maps to buffer (x+apronW, y+apronH). Offset the PSET writes; the selection
    ' clip, opacity lock, symmetry mirror and color resolve stay in CANVAS coords.
    DIM apW AS INTEGER, apH AS INTEGER
    apW% = 0 : apH% = 0
    IF CURRENT_LAYER% >= 1 AND CURRENT_LAYER% <= MAX_LAYERS THEN
        apW% = LAYERS(CURRENT_LAYER%).apronW%
        apH% = LAYERS(CURRENT_LAYER%).apronH%
    END IF

    ' Check if drawing with transparent color (eraser mode)
    is_transparent% = (_ALPHA32(col~&) = 0)
    
    ' For transparent drawing, we need to disable blending
    IF is_transparent% THEN _DONTBLEND targetImg&
    
    ' Check selection clipping AND opacity lock for master stroke (a soft selection's
    ' partly-selected pixel: a partial write, PAINT_sel_partial)
    DIM sc AS INTEGER
    sc% = SELECTION_cover%(x%, y%)
    IF sc% > 0 _ANDALSO sc% < 255 THEN
        PAINT_sel_partial x%, y%, col~&, is_transparent%, targetImg&
    ELSEIF sc% >= 255 _ANDALSO OPACITY_LOCK_allows_draw%(x%, y%) THEN
        resolvedCol~& = DRAWER_resolve_paint_color~&(x%, y%, col~&)
        ' Draw master stroke at full opacity (pen pressure -> opacity composites instead)
        IF TABLET.opStroke THEN
            PEN_op_write x% + apW%, y% + apH%, resolvedCol~&, 1
        ELSE
            PSET (x% + apW%, y% + apH%), resolvedCol~&
        END IF
    END IF
    
    ' Apply symmetry if enabled and requested
    IF apply_symmetry% AND SYMMETRY.MODE > 0 THEN
        ' Get mirrored points
        SYMMETRY_get_mirrored_points x%, y%, mx%(), my%(), count%
        
        ' Draw mirrored strokes (check selection clipping and opacity lock for each)
        FOR i% = 0 TO count% - 1
            sc% = SELECTION_cover%(mx%(i%), my%(i%))
            IF sc% > 0 _ANDALSO sc% < 255 THEN
                PAINT_sel_partial mx%(i%), my%(i%), col~&, is_transparent%, targetImg&
            ELSEIF sc% >= 255 _ANDALSO OPACITY_LOCK_allows_draw%(mx%(i%), my%(i%)) THEN
                resolvedCol~& = DRAWER_resolve_paint_color~&(mx%(i%), my%(i%), col~&)
                IF TABLET.opStroke THEN
                    PEN_op_write mx%(i%) + apW%, my%(i%) + apH%, resolvedCol~&, 1
                ELSE
                    PSET (mx%(i%) + apW%, my%(i%) + apH%), resolvedCol~&
                END IF
            END IF
        NEXT i%
    END IF
    
    ' Restore blending if we disabled it
    IF is_transparent% THEN _BLEND targetImg&

    _DEST oldDest&
END SUB

''
' A hard write (PAINT_pset_with_symmetry) on a partly-selected pixel of a soft selection:
' paint or erase it by the selected share (PAINT_blend_pixel / PAINT_erase_pixel scale by
' SELECTION_cover% themselves), then put the target's blend state back the way the caller
' had it (_DONTBLEND for a transparent colour).
SUB PAINT_sel_partial (x AS INTEGER, y AS INTEGER, col AS _UNSIGNED LONG, isTransparent AS INTEGER, targetImg AS LONG)
    DIM px AS INTEGER, py AS INTEGER, pc AS _UNSIGNED LONG
    px% = x%: py% = y%: pc~& = col~& ' (by reference: copies)
    IF NOT OPACITY_LOCK_allows_draw%(px%, py%) THEN EXIT SUB
    IF isTransparent% THEN
        PAINT_erase_pixel px%, py%, 1!
        _DONTBLEND targetImg&
    ELSE
        PAINT_blend_pixel px%, py%, pc~&, 1!
    END IF
END SUB


''
' Anti-aliased pixel write (source-over coverage blend).
' The single AA primitive: draws the RESOLVED paint color at fractional coverage,
' honoring the SAME gates as PAINT_pset_with_symmetry (selection clip + opacity lock).
'
' Coverage is turned into an effective source alpha (alpha * coverage) and the pixel
' is drawn with QB64's own _BLEND doing the composite (out = src*a + dst*(1-a)). At
' coverage >= 1.0 the code takes the verbatim original PSET path, so an AA-OFF caller
' (which always passes 1.0) is BYTE-IDENTICAL to today. Fractional coverage only ever
' comes from AA geometry when CFG.ANTIALIAS% is on.
'
' @param x INTEGER - X coordinate
' @param y INTEGER - Y coordinate
' @param col _UNSIGNED LONG - Color to draw (resolved per-pixel through the drawer)
' @param coverage SINGLE - Edge coverage in [0,1]; <=0 draws nothing, >=1 is a hard PSET
'
SUB PAINT_blend_pixel (x AS INTEGER, y AS INTEGER, col AS _UNSIGNED LONG, coverage AS SINGLE)
    DIM oldDest        AS LONG
    DIM targetImg      AS LONG
    DIM is_transparent AS INTEGER
    DIM resolvedCol    AS _UNSIGNED LONG
    DIM cov            AS SINGLE
    DIM a              AS INTEGER

    cov! = coverage!
    IF cov! <= 0.0 THEN EXIT SUB              ' no coverage — nothing to composite
    IF cov! > 1.0 THEN cov! = 1.0

    ' Same clipping as the hard-edged primitive: selection mask + opacity lock. A soft
    ' selection's partly-selected pixel scales the coverage (a transparent colour erases
    ' that share instead of clearing the pixel).
    DIM sc AS INTEGER
    sc% = SELECTION_cover%(x%, y%)
    IF sc% <= 0 THEN EXIT SUB
    IF sc% < 255 THEN
        IF _ALPHA32(col~&) = 0 THEN
            IF OPACITY_LOCK_allows_draw%(x%, y%) THEN PAINT_erase_pixel x%, y%, cov!
            EXIT SUB
        END IF
        cov! = cov! * sc% / 255!
    END IF
    IF OPACITY_LOCK_allows_draw%(x%, y%) THEN
        targetImg& = LAYER_current_image&
        oldDest&   = _DEST
        _DEST targetImg&

        ' BUG-14/16: apron offset for a promoted layer (clip already checked in canvas coords).
        DIM apW AS INTEGER, apH AS INTEGER
        apW% = 0 : apH% = 0
        IF CURRENT_LAYER% >= 1 AND CURRENT_LAYER% <= MAX_LAYERS THEN
            apW% = LAYERS(CURRENT_LAYER%).apronW%
            apH% = LAYERS(CURRENT_LAYER%).apronH%
        END IF

        is_transparent% = (_ALPHA32(col~&) = 0)
        IF is_transparent% THEN _DONTBLEND targetImg&

        resolvedCol~& = DRAWER_resolve_paint_color~&(x%, y%, col~&)

        IF TABLET.opStroke THEN
            ' Pen pressure -> opacity: coverage folds into the per-pixel max opacity.
            PEN_op_write x% + apW%, y% + apH%, resolvedCol~&, cov!
        ELSEIF PAINT_AAM_USE _ANDALSO NOT is_transparent% THEN
            ' A soft stamp: the strongest coverage this frame wins (PAINT_aam_write).
            PAINT_aam_write x% + apW%, y% + apH%, resolvedCol~&, cov!, targetImg&
        ELSEIF cov! >= 1.0 THEN
            ' Full coverage — verbatim original write (byte-identical to PSET path).
            PSET (x% + apW%, y% + apH%), resolvedCol~&
        ELSEIF NOT is_transparent% THEN
            ' Partial coverage — straight-alpha source-over (PAINT_cover_over).
            PAINT_cover_over x% + apW%, y% + apH%, resolvedCol~&, cov!, targetImg&
        ELSE
            ' (a transparent color under _DONTBLEND: written as is, as before)
            a% = INT(_ALPHA32(resolvedCol~&) * cov! + 0.5)
            IF a% > 255 THEN a% = 255
            PSET (x% + apW%, y% + apH%), _RGBA32(_RED32(resolvedCol~&), _GREEN32(resolvedCol~&), _BLUE32(resolvedCol~&), a%)
        END IF

        IF is_transparent% THEN _BLEND targetImg&
        _DEST oldDest&
    END IF
END SUB


''
' col at coverage cov (0..1) over buffer pixel (bx, by) of img (the current
' _DEST), source-over in straight alpha. Not QB64's _BLEND: that mixes the RGB
' of a transparent pixel (black) into the result, so every soft edge painted on
' an empty layer came out dark - half-coverage white on an empty pixel became
' grey (127,127,127 at alpha 128) instead of white at alpha 128. Over an opaque
' pixel the two agree. Leaves img in _BLEND.
'
SUB PAINT_cover_over (bx AS LONG, by AS LONG, col AS _UNSIGNED LONG, cov AS SINGLE, img AS LONG)
    DIM oldSrc AS LONG, bk AS _UNSIGNED LONG
    DIM sa AS SINGLE, da AS SINGLE, oa AS SINGLE, dw AS SINGLE
    IF cov! <= 0 THEN EXIT SUB
    IF bx& < 0 OR by& < 0 OR bx& >= _WIDTH(img&) OR by& >= _HEIGHT(img&) THEN EXIT SUB
    sa! = (_ALPHA32(col~&) / 255!) * cov!
    IF sa! > 1 THEN sa! = 1
    oldSrc& = _SOURCE
    _SOURCE img&
    bk~& = POINT(bx&, by&)
    _SOURCE oldSrc&
    da! = _ALPHA32(bk~&) / 255!
    oa! = sa! + da! * (1 - sa!)
    IF oa! <= 0 THEN EXIT SUB
    dw! = da! * (1 - sa!)
    _DONTBLEND img&
    PSET (bx&, by&), _RGBA32(INT((_RED32(col~&) * sa! + _RED32(bk~&) * dw!) / oa! + 0.5), _
                             INT((_GREEN32(col~&) * sa! + _GREEN32(bk~&) * dw!) / oa! + 0.5), _
                             INT((_BLUE32(col~&) * sa! + _BLUE32(bk~&) * dw!) / oa! + 0.5), _
                             INT(oa! * 255 + 0.5))
    _BLEND img&
END SUB

''
' A soft stamp's pixel (PAINT_AAM_USE): only what this frame hasn't already
' covered there. With m the coverage the frame laid at the pixel so far and e
' this one, compositing the share (e - m) / (1 - m) over it leaves the pixel
' exactly as one coverage-e write would - so stamps one pixel apart along a
' thick line no longer pile up their soft rims into a hard edge.
'
SUB PAINT_aam_write (bx AS LONG, by AS LONG, col AS _UNSIGNED LONG, cov AS SINGLE, img AS LONG)
    DIM idx AS LONG, m AS INTEGER, e AS INTEGER
    IF bx& < 0 OR by& < 0 OR bx& >= _WIDTH(img&) OR by& >= _HEIGHT(img&) THEN EXIT SUB
    IF PAINT_AAM_IMG <> img& _ORELSE PAINT_AAM_W <> _WIDTH(img&) _ORELSE PAINT_AAM_H <> _HEIGHT(img&) THEN
        PAINT_aam_end
        PAINT_AAM_W = _WIDTH(img&): PAINT_AAM_H = _HEIGHT(img&)
        PAINT_AAM_MEM = _MEMNEW(PAINT_AAM_W * PAINT_AAM_H)
        _MEMFILL PAINT_AAM_MEM, PAINT_AAM_MEM.OFFSET, PAINT_AAM_MEM.SIZE, 0 AS _UNSIGNED _BYTE
        PAINT_AAM_IMG = img&
    END IF
    idx& = by& * PAINT_AAM_W + bx&
    m% = _MEMGET(PAINT_AAM_MEM, PAINT_AAM_MEM.OFFSET + idx&, _UNSIGNED _BYTE)
    e% = INT(cov! * 255 + 0.5): IF e% > 255 THEN e% = 255
    IF e% <= m% THEN EXIT SUB
    _MEMPUT PAINT_AAM_MEM, PAINT_AAM_MEM.OFFSET + idx&, e% AS _UNSIGNED _BYTE
    IF e% >= 255 THEN
        PSET (bx&, by&), col~&
    ELSE
        PAINT_cover_over bx&, by&, col~&, (e% - m%) / (255! - m%), img&
    END IF
END SUB

''
' Forget the soft-stamp mask (top of every frame, and when the stamped image
' changes).
'
SUB PAINT_aam_end ()
    IF PAINT_AAM_IMG <> 0 THEN
        IF _MEMEXISTS(PAINT_AAM_MEM) THEN _MEMFREE PAINT_AAM_MEM
    END IF
    PAINT_AAM_IMG = 0: PAINT_AAM_W = 0: PAINT_AAM_H = 0
END SUB


''
' Symmetry-aware wrapper around PAINT_blend_pixel — mirrors the coverage write through
' every SYMMETRY reflection, exactly like PAINT_pset_with_symmetry fans out its PSETs.
'
' @param x INTEGER - X coordinate
' @param y INTEGER - Y coordinate
' @param col _UNSIGNED LONG - Color to draw
' @param coverage SINGLE - Edge coverage in [0,1]
'
SUB PAINT_blend_pixel_sym (x AS INTEGER, y AS INTEGER, col AS _UNSIGNED LONG, coverage AS SINGLE)
    DIM mx(0 TO 7) AS INTEGER
    DIM my(0 TO 7) AS INTEGER
    DIM count AS INTEGER
    DIM i     AS INTEGER

    ' Master stroke
    PAINT_blend_pixel x%, y%, col~&, coverage!

    ' Mirrored strokes (gates are re-checked per point inside PAINT_blend_pixel)
    IF SYMMETRY.MODE > 0 THEN
        SYMMETRY_get_mirrored_points x%, y%, mx%(), my%(), count%
        FOR i% = 0 TO count% - 1
            PAINT_blend_pixel mx%(i%), my%(i%), col~&, coverage!
        NEXT i%
    END IF
END SUB


''
' Xiaolin Wu anti-aliased line. Standalone reusable primitive — plots coverage-
' weighted pixels through PAINT_blend_pixel_sym (so it inherits selection clipping,
' opacity lock, AND symmetry). No tool wiring here; callers route to this when AA is on.
'
' For each step along the major axis it lights the two pixels straddling the line's
' fractional position, with complementary coverages (rfpart/fpart) that sum to 1 — the
' AA analogue of Bresenham. Integer endpoints are the normal case (canvas pixel coords).
'
' @param x1 INTEGER Start X
' @param y1 INTEGER Start Y
' @param x2 INTEGER End X
' @param y2 INTEGER End Y
' @param col _UNSIGNED LONG Line color (resolved per-pixel by PAINT_blend_pixel)
'
SUB PAINT_wu_line (x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, col AS _UNSIGNED LONG)
    DIM steep AS INTEGER
    DIM ax0   AS SINGLE, ay0 AS SINGLE, ax1 AS SINGLE, ay1 AS SINGLE
    DIM dx    AS SINGLE, dy  AS SINGLE, gradient AS SINGLE
    DIM xend  AS SINGLE, yend AS SINGLE, xgap AS SINGLE, intery AS SINGLE
    DIM xpxl1 AS INTEGER, ypxl1 AS INTEGER
    DIM xpxl2 AS INTEGER, ypxl2 AS INTEGER
    DIM xp    AS INTEGER
    DIM fp    AS SINGLE, rfp AS SINGLE

    ax0! = x1%: ay0! = y1%: ax1! = x2%: ay1! = y2%

    ' Work along the major axis: for steep lines swap x/y so the loop steps in x.
    steep% = (ABS(ay1! - ay0!) > ABS(ax1! - ax0!))
    IF steep% THEN
        SWAP ax0!, ay0!
        SWAP ax1!, ay1!
    END IF
    IF ax0! > ax1! THEN
        SWAP ax0!, ax1!
        SWAP ay0!, ay1!
    END IF

    dx! = ax1! - ax0!
    dy! = ay1! - ay0!
    IF dx! = 0.0 THEN
        gradient! = 1.0
    ELSE
        gradient! = dy! / dx!
    END IF

    ' --- first endpoint (with fractional end-cap coverage) ---
    xend!  = INT(ax0! + 0.5)
    yend!  = ay0! + gradient! * (xend! - ax0!)
    xgap!  = 1.0 - ((ax0! + 0.5) - INT(ax0! + 0.5))
    xpxl1% = INT(xend!)
    ypxl1% = INT(yend!)
    fp!    = yend! - INT(yend!)
    rfp!   = 1.0 - fp!
    IF steep% THEN
        PAINT_blend_pixel_sym ypxl1%, xpxl1%, col~&, rfp! * xgap!
        PAINT_blend_pixel_sym ypxl1% + 1, xpxl1%, col~&, fp! * xgap!
    ELSE
        PAINT_blend_pixel_sym xpxl1%, ypxl1%, col~&, rfp! * xgap!
        PAINT_blend_pixel_sym xpxl1%, ypxl1% + 1, col~&, fp! * xgap!
    END IF
    intery! = yend! + gradient!

    ' --- second endpoint ---
    xend!  = INT(ax1! + 0.5)
    yend!  = ay1! + gradient! * (xend! - ax1!)
    xgap!  = (ax1! + 0.5) - INT(ax1! + 0.5)
    xpxl2% = INT(xend!)
    ypxl2% = INT(yend!)
    fp!    = yend! - INT(yend!)
    rfp!   = 1.0 - fp!
    IF steep% THEN
        PAINT_blend_pixel_sym ypxl2%, xpxl2%, col~&, rfp! * xgap!
        PAINT_blend_pixel_sym ypxl2% + 1, xpxl2%, col~&, fp! * xgap!
    ELSE
        PAINT_blend_pixel_sym xpxl2%, ypxl2%, col~&, rfp! * xgap!
        PAINT_blend_pixel_sym xpxl2%, ypxl2% + 1, col~&, fp! * xgap!
    END IF

    ' --- main span: two straddling pixels per column, coverages sum to 1 ---
    IF steep% THEN
        FOR xp% = xpxl1% + 1 TO xpxl2% - 1
            fp!  = intery! - INT(intery!)
            rfp! = 1.0 - fp!
            PAINT_blend_pixel_sym INT(intery!), xp%, col~&, rfp!
            PAINT_blend_pixel_sym INT(intery!) + 1, xp%, col~&, fp!
            intery! = intery! + gradient!
        NEXT xp%
    ELSE
        FOR xp% = xpxl1% + 1 TO xpxl2% - 1
            fp!  = intery! - INT(intery!)
            rfp! = 1.0 - fp!
            PAINT_blend_pixel_sym xp%, INT(intery!), col~&, rfp!
            PAINT_blend_pixel_sym xp%, INT(intery!) + 1, col~&, fp!
            intery! = intery! + gradient!
        NEXT xp%
    END IF
END SUB


''
' Coverage-subtract erase: softly erase a pixel by REDUCING its existing alpha by
' coverage (instead of the hard alpha-0 clear the normal eraser does). Reads the current
' layer's dest alpha, writes back max(0, dstAlpha - coverage*255) keeping RGB. Honors the
' selection mask (opacity-lock does not gate erasing). At coverage>=1 the pixel is fully
' erased (matching the hard eraser); fractional coverage gives a soft AA edge.
'
' @param x INTEGER - X coordinate
' @param y INTEGER - Y coordinate
' @param coverage SINGLE - Erase strength in [0,1]; <=0 does nothing
'
SUB PAINT_erase_pixel (x AS INTEGER, y AS INTEGER, coverage AS SINGLE)
    DIM oldDest   AS LONG
    DIM oldSource AS LONG
    DIM targetImg AS LONG
    DIM dstCol    AS _UNSIGNED LONG
    DIM cov       AS SINGLE
    DIM dstA      AS INTEGER, newA AS INTEGER

    cov! = coverage!
    IF cov! <= 0.0 THEN EXIT SUB
    IF cov! > 1.0 THEN cov! = 1.0

    DIM sc AS INTEGER ' a soft selection: erase the selected share
    sc% = SELECTION_cover%(x%, y%)
    IF sc% <= 0 THEN EXIT SUB
    IF sc% < 255 THEN cov! = cov! * sc% / 255!

    IF sc% > 0 THEN
        targetImg& = LAYER_current_image&
        oldDest&   = _DEST
        oldSource& = _SOURCE
        _DEST targetImg&
        _SOURCE targetImg&

        ' BUG-14/16: apron offset for a promoted layer — the POINT read AND the PSET write both
        ' target the offset buffer position (clip already checked in canvas coords).
        DIM apW AS INTEGER, apH AS INTEGER
        apW% = 0 : apH% = 0
        IF CURRENT_LAYER% >= 1 AND CURRENT_LAYER% <= MAX_LAYERS THEN
            apW% = LAYERS(CURRENT_LAYER%).apronW%
            apH% = LAYERS(CURRENT_LAYER%).apronH%
        END IF

        IF TABLET.opStroke THEN
            ' Pen pressure -> opacity: erase a pressure-scaled share of the original alpha.
            PEN_op_write x% + apW%, y% + apH%, _RGBA32(0, 0, 0, 0), cov!
            _BLEND targetImg&
        ELSE
            dstCol~& = POINT(x% + apW%, y% + apH%)
            dstA%    = _ALPHA32(dstCol~&)
            newA%    = dstA% - INT(cov! * 255.0 + 0.5)
            IF newA% < 0 THEN newA% = 0

            _DONTBLEND targetImg&
            PSET (x% + apW%, y% + apH%), _RGBA32(_RED32(dstCol~&), _GREEN32(dstCol~&), _BLUE32(dstCol~&), newA%)
            _BLEND targetImg&
        END IF

        _SOURCE oldSource&
        _DEST oldDest&
    END IF
END SUB


''
' Symmetry-aware wrapper around PAINT_erase_pixel.
'
' @param x INTEGER - X coordinate
' @param y INTEGER - Y coordinate
' @param coverage SINGLE - Erase strength in [0,1]
'
SUB PAINT_erase_pixel_sym (x AS INTEGER, y AS INTEGER, coverage AS SINGLE)
    DIM mx(0 TO 7) AS INTEGER
    DIM my(0 TO 7) AS INTEGER
    DIM count AS INTEGER
    DIM i     AS INTEGER

    PAINT_erase_pixel x%, y%, coverage!

    IF SYMMETRY.MODE > 0 THEN
        SYMMETRY_get_mirrored_points x%, y%, mx%(), my%(), count%
        FOR i% = 0 TO count% - 1
            PAINT_erase_pixel mx%(i%), my%(i%), coverage!
        NEXT i%
    END IF
END SUB


''
' Soft (anti-aliased) round eraser stamp: same solid interior as the hard eraser
' (dist <= radius-0.5 fully erased) plus a 1px coverage-subtract feather to radius+0.5.
' Mirror of PAINT_draw_filled_circle_aa but erasing via PAINT_erase_pixel_sym.
'
' @param x INTEGER Center X
' @param y INTEGER Center Y
' @param radius INTEGER Eraser radius
'
SUB PAINT_erase_circle_aa (x AS INTEGER, y AS INTEGER, radius AS INTEGER)
    DIM cx       AS INTEGER, cy AS INTEGER
    DIM dist     AS SINGLE
    DIM coverage AS SINGLE
    DIM rInner   AS SINGLE, rOuter AS SINGLE

    rInner! = radius% - 0.5
    rOuter! = radius% + 0.5

    FOR cy% = y% - radius% - 1 TO y% + radius% + 1
        FOR cx% = x% - radius% - 1 TO x% + radius% + 1
            dist! = SQR((cx% - x%) * (cx% - x%) + (cy% - y%) * (cy% - y%))
            IF dist! <= rInner! THEN
                coverage! = 1.0
            ELSEIF dist! >= rOuter! THEN
                coverage! = 0.0
            ELSE
                coverage! = rOuter! - dist!
            END IF
            IF coverage! > 0.0 THEN PAINT_erase_pixel_sym cx%, cy%, coverage!
        NEXT cx%
    NEXT cy%
END SUB


''
' Turns painting on
' Draws circular brush strokes with interpolation for smooth lines
'
SUB PAINT_on ()
    ' If custom brush is active, use it instead of normal brush
    IF CUSTOM_BRUSH_is_active% THEN
        BRUSH_draw_custom
        EXIT SUB
    END IF
    
    DIM radius  AS INTEGER
    DIM dx      AS INTEGER, dy AS INTEGER
    DIM steps   AS INTEGER
    DIM t       AS SINGLE
    DIM cx      AS INTEGER, cy AS INTEGER
    DIM i       AS INTEGER
    DIM start_x AS INTEGER, start_y AS INTEGER
    DIM end_x   AS INTEGER, end_y AS INTEGER

    DIM sx        AS INTEGER, sy AS INTEGER
    DIM berr      AS INTEGER, e2 AS INTEGER
    DIM px        AS INTEGER, py AS INTEGER
    DIM targetImg AS LONG
    
    targetImg& = LAYER_current_image&
    _DEST targetImg&
    
    ' Determine start and end points based on constraint mode
    IF CONSTRAIN_X% THEN
        start_x% = MOUSE.CON_X%
        start_y% = MOUSE.OLD_Y%
        end_x%   = MOUSE.CON_X%
        end_y%   = MOUSE.Y%
    ELSEIF CONSTRAIN_Y% THEN
        start_x% = MOUSE.OLD_X%
        start_y% = MOUSE.CON_Y%
        end_x%   = MOUSE.X%
        end_y%   = MOUSE.CON_Y%
    ELSE
        start_x% = MOUSE.OLD_X%
        start_y% = MOUSE.OLD_Y%
        end_x%   = MOUSE.X%
        end_y%   = MOUSE.Y%
    END IF
    
    ' For DOT tool, track last position for SHIFT+RightClick lines
    ' Only update when LEFT button is used (not right-click)
    IF CURRENT_TOOL% = TOOL_DOT AND MOUSE.B1% THEN
        DOT.LAST_X   = end_x%
        DOT.LAST_Y   = end_y%
        DOT.HAS_LAST = TRUE
    END IF
    
    DIM pixel_size AS INTEGER
    pixel_size% = BRUSH_SIZE_pixels%

    
    ' Pen pressure (INPUT/PEN): fix the pressure at both ends of this segment;
    ' with pressure size or opacity, every dab gets its own interpolated value.
    PEN_segment_begin
    IF CONSTRAIN_X% _ORELSE CONSTRAIN_Y% THEN TABLET.aaT = FALSE ' (constrained: the whole pixels)
    IF TABLET.skipSeg THEN ' pen below the tip threshold: a graze, not a stroke
        TABLET.aaT = FALSE
        _DEST SCRN.CANVAS&
        EXIT SUB
    END IF
    IF PEN_size_active% _ORELSE (TABLET.opStroke _ANDALSO NOT (pixel_size% = 1 AND BRUSH_SIZE.PIXEL_PERFECT)) THEN
        PAINT_on_pressure start_x%, start_y%, end_x%, end_y%, pixel_size%
        PEN_segment_end
        _DEST SCRN.CANVAS&
        EXIT SUB
    END IF

    ' Pixel perfect mode only applies to single pixel (size 1) DOT/BRUSH tools
    DIM use_pixel_perfect AS INTEGER
    use_pixel_perfect% = FALSE
    IF pixel_size% = 1 AND BRUSH_SIZE.PIXEL_PERFECT AND (CURRENT_TOOL% = TOOL_DOT OR CURRENT_TOOL% = TOOL_BRUSH) THEN
        use_pixel_perfect% = TRUE
    END IF
    
    IF pixel_size% = 1 THEN
        ' Single pixel - draw with pixel perfect mode if enabled
        IF use_pixel_perfect% THEN
            ' Pixel-perfect mode: just draw and collect, post-processing on mouse up
            dx% = ABS(end_x% - start_x%)
            dy% = ABS(end_y% - start_y%)
            
            IF start_x% < end_x% THEN sx% = 1 ELSE sx% = -1
            IF start_y% < end_y% THEN sy% = 1 ELSE sy% = -1
            
            berr% = dx% - dy%
            
            cx% = start_x%
            cy% = start_y%
            
            ' Collect AND draw unfiltered (so user can see)
            DO
                IF BMIX.active THEN BMIX_dab cx%, cy% ' mix brush: smudge pickup before the dab
                ' Check if pixel was already drawn (not just last pixel)
                _SOURCE targetImg&
                DIM existing_color AS _UNSIGNED LONG
                existing_color~& = POINT(cx%, cy%)
                
                ' Only add if this pixel hasn't been drawn yet this stroke
                IF existing_color~& <> DRAWER_resolve_paint_color~&(cx%, cy%, DRAW_COLOR~&) AND PP_STROKE_COUNT% < 10000 THEN
                    ' Snapshot the layer before the very first pixel so PAINT_draw_pixel_perfect
                    ' can restore both master AND mirrored pixels atomically in Step 1.
                    IF PP_STROKE_COUNT% = 0 THEN
                        IF PP_BACKUP& < -1 THEN SAFE_FREEIMAGE PP_BACKUP&
                        PP_BACKUP& = _COPYIMAGE(targetImg&, 32)
                    END IF
                    PP_STROKE(PP_STROKE_COUNT%).ORIGINAL_COLOR = existing_color~&
                    PP_STROKE(PP_STROKE_COUNT%).X              = cx%
                    PP_STROKE(PP_STROKE_COUNT%).Y              = cy%
                    PP_STROKE_COUNT% = PP_STROKE_COUNT% + 1
                    ' Now draw so user can see (with symmetry)
                    PAINT_pset_with_symmetry cx%, cy%, DRAW_COLOR~&, TRUE
                END IF
                
                IF cx% = end_x% AND cy% = end_y% THEN EXIT DO
                
                ' Bresenham step
                e2% = 2 * berr%
                IF e2% > -dy% THEN
                    berr% = berr% - dy%
                    cx% = cx% + sx%
                END IF
                IF e2% < dx% THEN
                    berr% = berr% + dx%
                    cy% = cy% + sy%
                END IF
            LOOP
            ' On mouse UP, erase and redraw filtered in PAINT_draw_pixel_perfect
        ELSE
            ' Standard line drawing without pixel perfect
            dx% = ABS(end_x% - start_x%)
            dy% = ABS(end_y% - start_y%)
            
            IF start_x% < end_x% THEN sx% = 1 ELSE sx% = -1
            IF start_y% < end_y% THEN sy% = 1 ELSE sy% = -1
            
            berr% = dx% - dy%
            
            cx% = start_x%
            cy% = start_y%
            
            DO
                IF BMIX.active THEN BMIX_dab cx%, cy% ' mix brush: smudge pickup before the dab
                PAINT_pset_with_symmetry cx%, cy%, DRAW_COLOR~&, TRUE
                
                IF cx% = end_x% AND cy% = end_y% THEN EXIT DO
                
                ' Bresenham step
                e2% = 2 * berr%
                IF e2% > -dy% THEN
                    berr% = berr% - dy%
                    cx% = cx% + sx%
                END IF
                IF e2% < dx% THEN
                    berr% = berr% + dx%
                    cy% = cy% + sy%
                END IF
            LOOP
        END IF
    ELSEIF pixel_size% = 3 AND BRUSH_SIZE.SHAPE = 0 AND NOT CFG.ANTIALIAS% AND BRUSH_SIZE.SOFT = 0 THEN
        ' Plus sign for size 3 circle only (crisp mode). With AA on this size falls
        ' through to the ELSE branch below, which stamps the soft AA circle instead.
        dx% = end_x% - start_x%
        dy% = end_y% - start_y%

        steps% = INT(SQR(dx% * dx% + dy% * dy%)) + 1
        IF steps% < 1 THEN steps% = 1

        FOR i% = 0 TO steps%
            t!  = i% / steps%
            cx% = start_x% + INT(dx% * t!)
            cy% = start_y% + INT(dy% * t!)
            IF BMIX.active THEN BMIX_dab cx%, cy% ' mix brush: smudge pickup before the dab
            ' Draw vertical line of plus
            FOR py% = cy% - 1 TO cy% + 1
                PAINT_pset_with_symmetry cx%, py%, DRAW_COLOR~&, TRUE
            NEXT
            ' Draw horizontal line of plus
            FOR px% = cx% - 1 TO cx% + 1
                PAINT_pset_with_symmetry px%, cy%, DRAW_COLOR~&, TRUE
            NEXT
        NEXT i%
    ELSE
        ' Brush - draw filled shapes along the path
        radius% = pixel_size% \ 2
        
        dx% = end_x% - start_x%
        dy% = end_y% - start_y%
        
        ' Calculate steps based on distance to ensure smooth line
        steps% = INT(SQR(dx% * dx% + dy% * dy%)) + 1
        IF steps% < 1 THEN steps% = 1
        
        ' Draw shapes along the path
        FOR i% = 0 TO steps%
            t!  = i% / steps%
            cx% = start_x% + INT(dx% * t!)
            cy% = start_y% + INT(dy% * t!)
            IF BMIX.active THEN BMIX_dab cx%, cy% ' mix brush: smudge pickup before the dab
            IF BRUSH_SIZE_special% THEN
                PAINT_shape_dab cx%, cy%, pixel_size%, DRAW_COLOR~& ' a slant / a soft round (the brush palette)
            ELSEIF BRUSH_SIZE.SHAPE = 0 THEN
                IF CFG.ANTIALIAS% THEN
                    IF _ALPHA32(DRAW_COLOR~&) = 0 AND radius% >= 1 THEN
                        ' Erasing with AA on: coverage-SUBTRACT for a soft feathered edge
                        ' (BUG-7, v2.0.0). Without this the transparent color hard-erases
                        ' the full circle via _DONTBLEND, so the soft eraser was dormant.
                        PAINT_erase_circle_aa cx%, cy%, radius%
                    ELSE
                        PAINT_AAM_USE = TRUE
                        PAINT_draw_filled_circle_aa cx%, cy%, radius%, DRAW_COLOR~&
                        PAINT_AAM_USE = FALSE
                    END IF
                ELSE
                    PAINT_draw_filled_circle cx%, cy%, radius%, DRAW_COLOR~&
                END IF
            ELSE
                PAINT_draw_filled_square cx%, cy%, pixel_size%, DRAW_COLOR~&
            END IF
        NEXT i%
    END IF
    
    PEN_segment_end
    _DEST SCRN.CANVAS&
END SUB


''
' PAINT_on for pen-pressure brushes: dabs one pixel apart along the segment,
' each sized (pressure size) and/or weighted (pressure opacity) from the
' pressure interpolated between the segment's ends.
'
SUB PAINT_on_pressure (sx AS INTEGER, sy AS INTEGER, ex AS INTEGER, ey AS INTEGER, baseSize AS INTEGER)
    DIM x0 AS INTEGER, y0 AS INTEGER, dx AS INTEGER, dy AS INTEGER
    DIM steps AS INTEGER, i AS INTEGER, cx AS INTEGER, cy AS INTEGER, dabSize AS INTEGER, full AS INTEGER
    DIM t AS SINGLE, p AS SINGLE, sizeOn AS INTEGER, dabF AS SINGLE
    x0% = sx%: y0% = sy%: full% = baseSize%
    sizeOn% = PEN_size_active%
    dx% = ex% - x0%
    dy% = ey% - y0%
    IF TABLET.aaPen THEN
        PAINT_aa_segment x0%, y0%, ex%, ey%, full%, sizeOn%
        EXIT SUB
    END IF
    steps% = INT(SQR(dx% * dx% + dy% * dy%)) + 1
    IF steps% < 1 THEN steps% = 1
    FOR i% = 0 TO steps%
        t! = i% / steps%
        cx% = x0% + INT(dx% * t!)
        cy% = y0% + INT(dy% * t!)
        p! = PEN_dab_pressure!(t!)
        TABLET.dabP = p!
        IF TABLET.opStroke THEN
            IF TABLET.usingPen THEN TABLET.dabOp = PEN_dab_op!(p!) ELSE TABLET.dabOp = PAINT_OPACITY% / 100!
        END IF
        dabSize% = full%
        IF sizeOn% THEN dabSize% = PEN_scaled_size%(full%, p!)
        ' Variable-width strokes can't be replayed as fixed-size brush calls: export as pixels.
        IF dabSize% <> full% THEN BRUSH_HISTORY_FLAGS& = BRUSH_HISTORY_FLAGS& OR HISTORY_FLAG_PAINT_MODE
        IF BMIX.active THEN BMIX_dab cx%, cy% ' mix brush: smudge pickup before the dab
        PAINT_stamp_size cx%, cy%, dabSize%, DRAW_COLOR~&
    NEXT i%
END SUB


''
' One segment of an antialiased stroke (TABLET.aaPen, pen or mouse) from the
' whole pixel (sx, sy) to (ex, ey) - or to the exact point PEN_aa_target gave,
' the pointer's sub-pixel position. The path runs through the midpoints of the
' stroke's points, a quadratic curve from one midpoint to the next with the
' point between as its control: each curve meets the next one smoothly, so the
' one-pixel steps of a slow mouse or pen round off instead of showing in the
' edge. The path ends half a segment behind the pointer; PAINT_aa_finish draws
' that last half on lift.
'
SUB PAINT_aa_segment (sx AS INTEGER, sy AS INTEGER, ex AS INTEGER, ey AS INTEGER, full AS INTEGER, sizeOn AS INTEGER)
    DIM qx AS SINGLE, qy AS SINGLE, nx AS SINGLE, ny AS SINGLE
    IF TABLET.aaT THEN
        qx! = TABLET.aaTX: qy! = TABLET.aaTY
    ELSE
        qx! = ex%: qy! = ey%
    END IF
    TABLET.aaT = FALSE
    ' a stroke that jumped (this segment doesn't start where the last one ended)
    IF TABLET.aaHas THEN
        IF ABS(TABLET.aaPX - sx%) > 1.5 _ORELSE ABS(TABLET.aaPY - sy%) > 1.5 THEN TABLET.aaHas = FALSE
    END IF
    IF NOT TABLET.aaHas THEN
        ' the first point: the press (start and end the same pixel: its exact spot)
        IF sx% = ex% _ANDALSO sy% = ey% THEN
            TABLET.aaPX = qx!: TABLET.aaPY = qy!
        ELSE
            TABLET.aaPX = sx%: TABLET.aaPY = sy%
        END IF
        TABLET.aaMX = TABLET.aaPX: TABLET.aaMY = TABLET.aaPY
        TABLET.aaHas = TRUE
        PAINT_aa_curve TABLET.aaMX, TABLET.aaMY, TABLET.aaMX, TABLET.aaMY, TABLET.aaMX, TABLET.aaMY, full%, sizeOn%
    END IF
    IF ABS(qx! - TABLET.aaPX) < 0.01 _ANDALSO ABS(qy! - TABLET.aaPY) < 0.01 THEN EXIT SUB
    nx! = (TABLET.aaPX + qx!) / 2: ny! = (TABLET.aaPY + qy!) / 2
    PAINT_aa_curve TABLET.aaMX, TABLET.aaMY, TABLET.aaPX, TABLET.aaPY, nx!, ny!, full%, sizeOn%
    TABLET.aaMX = nx!: TABLET.aaMY = ny!
    TABLET.aaPX = qx!: TABLET.aaPY = qy!
END SUB

''
' A thick antialiased line: the capsule of radius r around the segment
' (x0, y0)-(x1, y1) (a pixel's centre is its whole coordinate), every pixel at
' its exact coverage - r + 0.5 minus its distance to the segment, clamped 0..1.
' One shape, where stamping a soft circle at each pixel of a Bresenham line put
' the line's stair steps into its edges. Drawn as soft stamps (PAINT_AAM_USE),
' so lines meeting in one frame - a rectangle's sides, a polyline's or a
' Bezier's pieces - join without their soft rims adding up.
'
SUB PAINT_aa_capsule (x0 AS SINGLE, y0 AS SINGLE, x1 AS SINGLE, y1 AS SINGLE, r AS SINGLE, col AS _UNSIGNED LONG)
    DIM xa AS INTEGER, xb AS INTEGER, ya AS INTEGER, yb AS INTEGER, x AS INTEGER, y AS INTEGER
    DIM vx AS SINGLE, vy AS SINGLE, l2 AS SINGLE, ro AS SINGLE, ro2 AS SINGLE
    DIM wx AS SINGLE, wy AS SINGLE, t AS SINGLE, ddx AS SINGLE, ddy AS SINGLE, d2 AS SINGLE, cov AS SINGLE
    ro! = r! + 0.5: ro2! = ro! * ro!
    xa% = INT(_MIN(x0!, x1!) - ro!): xb% = -INT(-(_MAX(x0!, x1!) + ro!))
    ya% = INT(_MIN(y0!, y1!) - ro!): yb% = -INT(-(_MAX(y0!, y1!) + ro!))
    vx! = x1! - x0!: vy! = y1! - y0!: l2! = vx! * vx! + vy! * vy!
    PAINT_AAM_USE = TRUE
    FOR y% = ya% TO yb%
        FOR x% = xa% TO xb%
            wx! = x% - x0!: wy! = y% - y0!
            t! = 0
            IF l2! > 0 THEN
                t! = (wx! * vx! + wy! * vy!) / l2!
                IF t! < 0 THEN t! = 0
                IF t! > 1 THEN t! = 1
            END IF
            ddx! = wx! - t! * vx!: ddy! = wy! - t! * vy!
            d2! = ddx! * ddx! + ddy! * ddy!
            IF d2! < ro2! THEN
                cov! = ro! - SQR(d2!)
                IF cov! > 1 THEN cov! = 1
                IF cov! > 0.004 THEN PAINT_blend_pixel_sym x%, y%, col~&, cov!
            END IF
        NEXT x%
    NEXT y%
    PAINT_AAM_USE = FALSE
END SUB

''
' TRUE when a thick line in col should be drawn as an antialiased capsule
' (PAINT_aa_capsule): Antialias on, a round brush over 1px, a visible color.
'
FUNCTION PAINT_aa_thick_line% (col AS _UNSIGNED LONG)
    PAINT_aa_thick_line% = (CFG.ANTIALIAS% <> 0 _ANDALSO BRUSH_SIZE.SHAPE = 0 _ANDALSO BRUSH_SIZE_pixels% > 1 _ANDALSO _ALPHA32(col~&) > 0 _ANDALSO CUSTOM_BRUSH_is_active% = 0)
END FUNCTION

''
' TRUE when a curve (ellipse outline, Bezier, smart-shape arc) in col should be
' drawn as antialiased capsules between its exact, fractional points: Antialias
' on, a round brush (any size - 1px makes a soft 1px line), a visible color, no
' custom brush. Rounding a curve's points to whole pixels first and joining
' those is what put steps into its edges.
'
FUNCTION PAINT_aa_curve_ok% (col AS _UNSIGNED LONG)
    PAINT_aa_curve_ok% = (CFG.ANTIALIAS% <> 0 _ANDALSO (BRUSH_SIZE.SHAPE = 0 _ORELSE BRUSH_SIZE_pixels% <= 1) _ANDALSO _ALPHA32(col~&) > 0 _ANDALSO CUSTOM_BRUSH_is_active% = 0)
END FUNCTION

''
' The capsule radius for antialiased curves: half the brush size, at least 0.5.
'
FUNCTION PAINT_aa_radius! ()
    IF BRUSH_SIZE_pixels% <= 1 THEN PAINT_aa_radius! = 0.5 ELSE PAINT_aa_radius! = BRUSH_SIZE_pixels% / 2!
END FUNCTION

''
' An antialiased ellipse outline centred (cx, cy) with radii (rx, ry), as
' capsules between points about 1.5px apart along it (the chord is off the true
' curve by under 0.01px at radius 30+).
'
SUB PAINT_aa_ellipse (cx AS SINGLE, cy AS SINGLE, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    DIM n AS INTEGER, i AS INTEGER, a AS SINGLE, per AS SINGLE, r AS SINGLE
    DIM x0 AS SINGLE, y0 AS SINGLE, x1 AS SINGLE, y1 AS SINGLE
    r! = PAINT_aa_radius!
    per! = 3.14159265 * (3 * (rx! + ry!) - SQR((3 * rx! + ry!) * (rx! + 3 * ry!)))
    n% = INT(per! / 1.5): IF n% < 16 THEN n% = 16
    IF n% > 4000 THEN n% = 4000
    x0! = cx! + rx!: y0! = cy!
    FOR i% = 1 TO n%
        a! = 6.2831853 * i% / n%
        x1! = cx! + COS(a!) * rx!: y1! = cy! + SIN(a!) * ry!
        PAINT_aa_capsule x0!, y0!, x1!, y1!, r!, col~&
        x0! = x1!: y0! = y1!
    NEXT i%
END SUB

''
' Lift: the antialiased stroke's last half segment, to the last point, at the
' last pressure. Call before PEN_opacity_end.
'
SUB PAINT_aa_finish ()
    IF TABLET.aaPen = 0 _ORELSE TABLET.aaHas = 0 THEN EXIT SUB
    IF ABS(TABLET.aaMX - TABLET.aaPX) < 0.01 _ANDALSO ABS(TABLET.aaMY - TABLET.aaPY) < 0.01 THEN EXIT SUB
    TABLET.segP0 = TABLET.segP1
    PAINT_aa_curve TABLET.aaMX, TABLET.aaMY, (TABLET.aaMX + TABLET.aaPX) / 2, (TABLET.aaMY + TABLET.aaPY) / 2, TABLET.aaPX, TABLET.aaPY, BRUSH_SIZE_pixels%, PEN_size_active%
    TABLET.aaMX = TABLET.aaPX: TABLET.aaMY = TABLET.aaPY
END SUB

''
' Soft discs along the quadratic curve (x0, y0) .. control (cx, cy) .. (x1, y1),
' at the dabs' exact (fractional) places and sizes - sizes 1, 2, 3 ... and soft
' 1px lines, where whole-pixel circles only come in odd sizes (1, 3, 5 ...).
' Pressure runs segP0 -> segP1 along it. The discs merge by the strongest
' coverage (the stroke mask), so dabs need no 1px spacing: each steps
' 0.63 x sqrt(its radius) on (0.5px at least), which keeps the scallop between
' dabs under 0.05px (r - sqrt(r^2 - (s/2)^2)). The curve's start is the last
' curve's end (already drawn) unless it is a single point.
'
SUB PAINT_aa_curve (x0 AS SINGLE, y0 AS SINGLE, cx AS SINGLE, cy AS SINGLE, x1 AS SINGLE, y1 AS SINGLE, full AS INTEGER, sizeOn AS INTEGER)
    DIM ax AS SINGLE, ay AS SINGLE, bx AS SINGLE, vmax AS SINGLE
    DIM t AS SINGLE, u AS SINGLE, p AS SINGLE, dabF AS SINGLE, dr AS SINGLE
    ' the curve's speed is between 2|C - P0| and 2|P1 - C|: step by the larger
    ax! = SQR((cx! - x0!) * (cx! - x0!) + (cy! - y0!) * (cy! - y0!))
    bx! = SQR((x1! - cx!) * (x1! - cx!) + (y1! - cy!) * (y1! - cy!))
    vmax! = 2 * ax!: IF 2 * bx! > vmax! THEN vmax! = 2 * bx!
    IF vmax! < 0.001 THEN t! = 1 ELSE t! = 0
    DO
        IF t! > 0 _ORELSE vmax! < 0.001 THEN
            u! = 1 - t!
            ax! = u! * u! * x0! + 2 * u! * t! * cx! + t! * t! * x1!
            ay! = u! * u! * y0! + 2 * u! * t! * cy! + t! * t! * y1!
            p! = PEN_dab_pressure!(t!)
            TABLET.dabP = p!
            IF TABLET.usingPen THEN TABLET.dabOp = PEN_dab_op!(p!) ELSE TABLET.dabOp = PAINT_OPACITY% / 100!
            dabF! = full%
            IF sizeOn% THEN dabF! = PEN_size_frac!(full%, p!)
            ' Variable-width strokes can't be replayed as fixed-size brush calls: export as pixels.
            IF dabF! <> full% THEN BRUSH_HISTORY_FLAGS& = BRUSH_HISTORY_FLAGS& OR HISTORY_FLAG_PAINT_MODE
            PAINT_draw_disc_aa ax!, ay!, dabF! / 2, DRAW_COLOR~&
        ELSE
            p! = PEN_dab_pressure!(0)
            dabF! = full%
            IF sizeOn% THEN dabF! = PEN_size_frac!(full%, p!)
        END IF
        IF t! >= 1 THEN EXIT DO
        dr! = 0.63 * SQR(dabF! / 2): IF dr! < 0.5 THEN dr! = 0.5
        t! = t! + dr! / vmax!
        IF t! > 1 THEN t! = 1
    LOOP
END SUB


''
' Draws a filled circle
' @param x INTEGER Center X coordinate
' @param y INTEGER Center Y coordinate
' @param radius INTEGER Circle radius
' @param col _UNSIGNED LONG Color to fill with
'
SUB PAINT_draw_filled_circle (x AS INTEGER, y AS INTEGER, radius AS INTEGER, col AS _UNSIGNED LONG)
    DIM cx      AS INTEGER, cy AS INTEGER
    DIM dist_sq AS SINGLE, r_sq AS SINGLE
    
    r_sq! = (radius% - 0.5) * (radius% - 0.5)
    
    ' Scan the bounding box and fill pixels inside the circle
    FOR cy% = y% - radius% TO y% + radius%
        FOR cx% = x% - radius% TO x% + radius%
            dist_sq! = (cx% - x%) * (cx% - x%) + (cy% - y%) * (cy% - y%)
            IF dist_sq! <= r_sq! THEN
                PAINT_pset_with_symmetry cx%, cy%, col~&, TRUE
            END IF
        NEXT cx%
    NEXT cy%
END SUB

''
' Anti-aliased filled circle (soft edge). Same solid interior as
' PAINT_draw_filled_circle (dist <= radius-0.5 stays full coverage), plus a 1px
' coverage feather across [radius-0.5, radius+0.5] drawn through PAINT_blend_pixel_sym.
' Only reached when CFG.ANTIALIAS% is on; the hard-edged SUB above is the AA-off path.
'
' @param x INTEGER Center X coordinate
' @param y INTEGER Center Y coordinate
' @param radius INTEGER Circle radius
' @param col _UNSIGNED LONG Color to fill with
'
SUB PAINT_draw_filled_circle_aa (x AS INTEGER, y AS INTEGER, radius AS INTEGER, col AS _UNSIGNED LONG)
    DIM cx       AS INTEGER, cy AS INTEGER
    DIM dist     AS SINGLE
    DIM coverage AS SINGLE
    DIM rInner   AS SINGLE, rOuter AS SINGLE

    rInner! = radius% - 0.5 ' full coverage inside this radius
    rOuter! = radius% + 0.5 ' zero coverage beyond this radius

    ' Scan a bounding box extended by 1px so the feather ring is covered.
    FOR cy% = y% - radius% - 1 TO y% + radius% + 1
        FOR cx% = x% - radius% - 1 TO x% + radius% + 1
            dist! = SQR((cx% - x%) * (cx% - x%) + (cy% - y%) * (cy% - y%))
            IF dist! <= rInner! THEN
                coverage! = 1.0
            ELSEIF dist! >= rOuter! THEN
                coverage! = 0.0
            ELSE
                coverage! = rOuter! - dist! ' linear 1..0 across the 1px band
            END IF
            IF coverage! > 0.0 THEN PAINT_blend_pixel_sym cx%, cy%, col~&, coverage!
        NEXT cx%
    NEXT cy%
END SUB

''
' Antialiased disc at a fractional center (cx, cy) with a fractional radius r
' (canvas px; a pixel's center is its whole coordinate). Coverage falls off
' over 1px at the rim: r + 0.5 - distance, clamped to 0..1. r = 0.5 is a 1px dab
' that spreads over its neighbours when it sits between pixels (a soft 1px
' line). Through PAINT_blend_pixel_sym: selection, opacity lock, symmetry, and
' in a masked pen stroke (TABLET.opStroke) the strongest coverage per pixel.
'
SUB PAINT_draw_disc_aa (cx AS SINGLE, cy AS SINGLE, r AS SINGLE, col AS _UNSIGNED LONG)
    DIM x0 AS INTEGER, x1 AS INTEGER, y0 AS INTEGER, y1 AS INTEGER, x AS INTEGER, y AS INTEGER
    DIM ddx AS SINGLE, ddy AS SINGLE, cov AS SINGLE, ro AS SINGLE, ro2 AS SINGLE
    DIM fast AS INTEGER, apW AS LONG, apH AS LONG, bx AS LONG, by AS LONG, e AS INTEGER, rowIn AS INTEGER
    ro! = r! + 0.5: ro2! = ro! * ro!
    x0% = INT(cx! - ro!): x1% = -INT(-(cx! + ro!))
    y0% = INT(cy! - ro!): y1% = -INT(-(cy! + ro!))
    ' In a masked stroke most of every dab lands where the stroke is already as
    ' strong: look at the mask first and skip those pixels (PEN_op_write would
    ' leave them alone anyway). Not with symmetry - its mirrored pixels differ.
    fast% = (TABLET.opStroke <> 0 _ANDALSO SYMMETRY.MODE = 0 _ANDALSO CURRENT_LAYER% >= 1 _ANDALSO CURRENT_LAYER% <= MAX_LAYERS)
    IF fast% THEN apW& = LAYERS(CURRENT_LAYER%).apronW%: apH& = LAYERS(CURRENT_LAYER%).apronH%
    FOR y% = y0% TO y1%
        ddy! = y% - cy!
        by& = y% + apH&
        rowIn% = (by& >= 0 _ANDALSO by& < TABLET.opH)
        FOR x% = x0% TO x1%
            ddx! = x% - cx!
            IF ddx! * ddx! + ddy! * ddy! < ro2! THEN
                cov! = ro! - SQR(ddx! * ddx! + ddy! * ddy!)
                IF cov! > 1 THEN cov! = 1
                IF cov! > 0.004 THEN
                    IF fast% _ANDALSO rowIn% THEN
                        bx& = x% + apW&
                        IF bx& >= 0 _ANDALSO bx& < TABLET.opW THEN
                            e% = INT(TABLET.dabOp * cov! * 255 + 0.5): IF e% > 255 THEN e% = 255
                            IF e% <= _MEMGET(TABLET_MASK_MEM, TABLET_MASK_MEM.OFFSET + by& * TABLET.opW + bx&, _UNSIGNED _BYTE) THEN _CONTINUE
                        END IF
                    END IF
                    PAINT_blend_pixel_sym x%, y%, col~&, cov!
                END IF
            END IF
        NEXT x%
    NEXT y%
END SUB

''
' Draws a filled square
' @param x INTEGER Center X coordinate
' @param y INTEGER Center Y coordinate
' @param size INTEGER Square size
' @param col _UNSIGNED LONG Color to fill with
'
SUB PAINT_draw_filled_square (x AS INTEGER, y AS INTEGER, size AS INTEGER, col AS _UNSIGNED LONG)
    DIM half AS INTEGER
    DIM px   AS INTEGER, py AS INTEGER
    half% = size% \ 2
    
    FOR py = y% - half% TO y% + half%
        FOR px = x% - half% TO x% + half%
            PAINT_pset_with_symmetry px, py, col~&, TRUE
        NEXT
    NEXT
END SUB


''
' Stamps the current brush shape at (x, y) with symmetry and selection awareness.
' Used by line, rect, ellipse, and poly-line tools for thick brush drawing.
' Handles brush size 1 (single pixel) as well as larger sizes.
'
' @param x INTEGER - Center X coordinate
' @param y INTEGER - Center Y coordinate
' @param col _UNSIGNED LONG - Color to stamp with
'
SUB PAINT_stamp_brush (x AS INTEGER, y AS INTEGER, col AS _UNSIGNED LONG)
    PAINT_stamp_size x%, y%, BRUSH_SIZE_pixels%, col~&
END SUB


''
' A slant nib for a brush of size px at (x, y): the segment it is drawn along
' (x0, y0)-(x1, y1) and its half-thickness r. 45 degrees, as long as the size,
' a quarter of it thick (at least 1 px).
'
SUB PAINT_slant_seg (x AS INTEGER, y AS INTEGER, px AS INTEGER, x0 AS SINGLE, y0 AS SINGLE, x1 AS SINGLE, y1 AS SINGLE, r AS SINGLE)
    DIM h AS SINGLE, sg AS INTEGER
    r! = px% / 8!: IF r! < 0.5 THEN r! = 0.5
    h! = (px% / 2! - r!) * 0.70710678: IF h! < 0 THEN h! = 0
    sg% = 1: IF BRUSH_SIZE.SHAPE = BRUSH_SHAPE_BACKSLASH THEN sg% = -1
    ' "/" runs from bottom-left (y down) to top-right
    x0! = x% - h!: y0! = y% + h! * sg%
    x1! = x% + h!: y1! = y% - h! * sg%
END SUB

''
' Distance from pixel (px, py) to the segment (x0, y0)-(x1, y1).
'
FUNCTION PAINT_seg_dist! (px AS INTEGER, py AS INTEGER, x0 AS SINGLE, y0 AS SINGLE, x1 AS SINGLE, y1 AS SINGLE)
    DIM vx AS SINGLE, vy AS SINGLE, l2 AS SINGLE, t AS SINGLE, dx AS SINGLE, dy AS SINGLE
    vx! = x1! - x0!: vy! = y1! - y0!: l2! = vx! * vx! + vy! * vy!
    t! = 0
    IF l2! > 0 THEN
        t! = ((px% - x0!) * vx! + (py% - y0!) * vy!) / l2!
        IF t! < 0 THEN t! = 0
        IF t! > 1 THEN t! = 1
    END IF
    dx! = px% - x0! - t! * vx!: dy! = py% - y0! - t! * vy!
    PAINT_seg_dist! = SQR(dx! * dx! + dy! * dy!)
END FUNCTION

''
' One dab of a slant or a soft round brush (BRUSH_SIZE_special%) of size px
' at (x, y). The coverage of a pixel falls from 1 to 0 over the feather: the
' outer 1 px with Antialias on and SOFT 0, SOFT % of the radius when soft (a
' smoothstep), none at all for a hard slant with Antialias off (whole pixels,
' for pixel art). Soft writes are soft stamps (PAINT_AAM_USE): dabs of one
' frame keep the strongest coverage instead of piling up, and in a masked
' stroke (TABLET.opStroke) the whole stroke does. A transparent colour erases
' that share (PAINT_erase_pixel_sym).
'
SUB PAINT_shape_dab (x AS INTEGER, y AS INTEGER, px AS INTEGER, col AS _UNSIGNED LONG)
    DIM x0 AS SINGLE, y0 AS SINGLE, x1 AS SINGLE, y1 AS SINGLE, r AS SINGLE, ro AS SINGLE, f AS SINGLE
    DIM d AS SINGLE, c AS SINGLE, b AS INTEGER, ix AS INTEGER, iy AS INTEGER, soft AS INTEGER, hard AS INTEGER, er AS INTEGER
    IF BRUSH_SIZE.SHAPE = BRUSH_SHAPE_SLASH _ORELSE BRUSH_SIZE.SHAPE = BRUSH_SHAPE_BACKSLASH THEN
        PAINT_slant_seg x%, y%, px%, x0!, y0!, x1!, y1!, r!
    ELSE
        x0! = x%: y0! = y%: x1! = x%: y1! = y%: r! = px% / 2! - 0.5
        IF r! < 0.5 THEN r! = 0.5
    END IF
    soft% = BRUSH_SIZE.SOFT
    hard% = (soft% = 0 _ANDALSO CFG.ANTIALIAS% = 0)
    ro! = r! + 0.5
    f! = 1: IF soft% > 0 THEN f! = ro! * soft% / 100!: IF f! < 1 THEN f! = 1
    er% = (_ALPHA32(col~&) = 0)
    b% = INT(ro! + 1)
    PAINT_AAM_USE = TRUE
    FOR iy% = y% - b% TO y% + b%
        FOR ix% = x% - b% TO x% + b%
            d! = PAINT_seg_dist!(ix%, iy%, x0!, y0!, x1!, y1!)
            IF d! >= ro! THEN _CONTINUE
            IF hard% THEN
                IF d! > r! THEN _CONTINUE
                IF er% THEN PAINT_erase_pixel_sym ix%, iy%, 1 ELSE PAINT_pset_with_symmetry ix%, iy%, col~&, TRUE
            ELSE
                c! = (ro! - d!) / f!
                IF c! > 1 THEN c! = 1
                IF soft% > 0 THEN c! = c! * c! * (3 - 2 * c!)
                IF c! > 0.004 THEN
                    IF er% THEN PAINT_erase_pixel_sym ix%, iy%, c! ELSE PAINT_blend_pixel_sym ix%, iy%, col~&, c!
                END IF
            END IF
        NEXT ix%
    NEXT iy%
    PAINT_AAM_USE = FALSE
END SUB

''
' Stamps the current brush shape at (x, y) at an explicit size in pixels.
' PAINT_stamp_brush uses the brush size; the pen-pressure path passes a
' pressure-scaled size per dab.
'
' @param x INTEGER - Center X coordinate
' @param y INTEGER - Center Y coordinate
' @param size INTEGER - Brush size in pixels (1 = single pixel)
' @param col _UNSIGNED LONG - Color to stamp with
'
SUB PAINT_stamp_size (x AS INTEGER, y AS INTEGER, size AS INTEGER, col AS _UNSIGNED LONG)
    DIM pixel_size AS INTEGER
    DIM radius     AS INTEGER
    pixel_size% = size%

    IF pixel_size% <= 1 THEN
        ' Single pixel
        PAINT_pset_with_symmetry x%, y%, col~&, TRUE
    ELSEIF pixel_size% = 3 AND BRUSH_SIZE.SHAPE = 0 AND NOT CFG.ANTIALIAS% AND BRUSH_SIZE.SOFT = 0 THEN
        ' Plus sign for size 3 circle (crisp mode). With AA on this falls through to
        ' the ELSE branch below, which stamps the soft AA circle instead.
        DIM py AS INTEGER, px AS INTEGER
        FOR py% = y% - 1 TO y% + 1
            PAINT_pset_with_symmetry x%, py%, col~&, TRUE
        NEXT
        FOR px% = x% - 1 TO x% + 1
            PAINT_pset_with_symmetry px%, y%, col~&, TRUE
        NEXT
    ELSE
        ' Larger brush
        radius% = pixel_size% \ 2
        IF BRUSH_SIZE_special% THEN
            PAINT_shape_dab x%, y%, pixel_size%, col~& ' a slant / a soft round (the brush palette)
        ELSEIF BRUSH_SIZE.SHAPE = 0 THEN
            IF CFG.ANTIALIAS% THEN
                IF _ALPHA32(col~&) = 0 AND radius% >= 1 THEN
                    ' Soft coverage-subtract erase for a transparent stamp (BUG-7, v2.0.0).
                    PAINT_erase_circle_aa x%, y%, radius%
                ELSE
                    PAINT_AAM_USE = TRUE
                    PAINT_draw_filled_circle_aa x%, y%, radius%, col~&
                    PAINT_AAM_USE = FALSE
                END IF
            ELSE
                PAINT_draw_filled_circle x%, y%, radius%, col~&
            END IF
        ELSE
            PAINT_draw_filled_square x%, y%, pixel_size%, col~&
        END IF
    END IF
END SUB


''
' Clears the canvas
' Background layer (index 1) clears to PAINT_BG_COLOR, other layers clear to transparent
' 
SUB PAINT_clear ()
    DIM targetImg            AS LONG
    DIM x                    AS INTEGER, y AS INTEGER
    DIM oldDest              AS LONG
    DIM clear_history_before AS LONG
    DIM clear_recorded       AS INTEGER
    targetImg&            = LAYER_current_image&
    oldDest&              = _DEST
    clear_history_before& = 0
    clear_recorded%       = FALSE

    IF NOT HISTORY_IN_PROGRESS% AND LAYERS(CURRENT_LAYER%).historyId& > 0 AND targetImg& < -1 THEN
        clear_history_before& = _COPYIMAGE(targetImg&, 32)
    END IF
    
    ' Must disable blending to write transparent pixels
    _DONTBLEND targetImg&
    _DEST targetImg&
    
    ' Fill entire image with fully transparent pixels
    FOR y% = 0 TO _HEIGHT(targetImg&) - 1
        FOR x% = 0 TO _WIDTH(targetImg&) - 1
            PSET (x%, y%), _RGBA32(0, 0, 0, 0)
        NEXT x%
    NEXT y%
    
    ' Re-enable blending
    _BLEND targetImg&
    _DEST oldDest&

    IF clear_history_before& < -1 THEN
        HISTORY_record_brush LAYERS(CURRENT_LAYER%).historyId&, CURRENT_LAYER%, _RGBA32(0, 0, 0, 0), 0, clear_history_before&, "Clear Layer"
        clear_recorded% = TRUE
    END IF

    IF clear_recorded% THEN HISTORY_saved_this_frame% = TRUE
END SUB


''
' Clears the canvas with confirmation prompt
' Used for DELETE key
'
SUB PAINT_clear_with_prompt ()
    DIM result AS LONG
    POINTER_hide_for_dialog
    result& = DRAW_message_box%("Clear Canvas", "Are you sure you want to clear the canvas?", MB_BTN_YES_NO, MB_ICON_QUESTION)
    POINTER_show_after_dialog
    
    ' Clear input buffers
    DO WHILE _MOUSEINPUT : LOOP
    MOUSE_force_buttons_up
    
    IF result& = MB_RESULT_1 THEN ' User clicked Yes
        PAINT_clear
        CANVAS_DIRTY%                        = TRUE
        LAYERS(CURRENT_LAYER%).contentDirty% = TRUE
        SYMBOL_mark_parent_dirty CURRENT_LAYER%
        BLEND_invalidate_cache
        SCENE_DIRTY% = TRUE
        FRAME_IDLE%  = FALSE
    END IF
END SUB


''
' Clears the canvas without confirmation
' Used for BACKSPACE key
'
SUB PAINT_clear_no_prompt ()
    LAYERS_clear CURRENT_LAYER%
    CANVAS_DIRTY%                        = TRUE
    LAYERS(CURRENT_LAYER%).contentDirty% = TRUE
    BLEND_invalidate_cache
    GUI_NEEDS_REDRAW% = TRUE
END SUB

''
' Draws collected pixel-perfect stroke, skipping L-corners
' Called on mouse UP after complete path is collected
'
SUB PAINT_draw_pixel_perfect ()
    IF PP_STROKE_COUNT% < 1 THEN EXIT SUB
    
    DIM targetImg AS LONG
    targetImg& = LAYER_current_image&
    _DEST targetImg&
    
    ' STEP 1: Restore ALL original pixels (master + mirrors) from pre-stroke backup.
    ' Using the full image snapshot is the only correct approach: per-pixel PSET restore
    ' cannot restore mirrored pixels because their original colors were never recorded.
    DIM i AS INTEGER
    IF PP_BACKUP& < -1 THEN
        _DONTBLEND targetImg&
        _PUTIMAGE , PP_BACKUP&, targetImg&
        _BLEND targetImg&
        SAFE_FREEIMAGE PP_BACKUP&
        PP_BACKUP& = 0
    ELSE
        ' Fallback (no backup): restore master pixels only
        _DONTBLEND targetImg&
        FOR i% = 0 TO PP_STROKE_COUNT% - 1
            PSET (PP_STROKE(i%).X, PP_STROKE(i%).Y), PP_STROKE(i%).ORIGINAL_COLOR
        NEXT i%
        _BLEND targetImg&
    END IF
    
    ' STEP 2: Draw path with L-corner filtering (reference algorithm)
    DIM c                AS INTEGER
    DIM skipped          AS INTEGER
    DIM chk_prev_x       AS INTEGER, chk_prev_y AS INTEGER
    DIM chk_curr_x       AS INTEGER, chk_curr_y AS INTEGER
    DIM chk_next_x       AS INTEGER, chk_next_y AS INTEGER
    DIM chk_prev_aligned AS INTEGER, chk_next_aligned AS INTEGER, chk_ends_not_aligned AS INTEGER
    DIM is_corner        AS INTEGER
    
    skipped% = 0
    c%       = 0
    WHILE c% < PP_STROKE_COUNT%
        is_corner% = FALSE
        
        ' Check if current pixel is an L-corner
        IF c% > 0 AND c% + 1 < PP_STROKE_COUNT% THEN
            chk_prev_x% = PP_STROKE(c% - 1).X
            chk_prev_y% = PP_STROKE(c% - 1).Y
            chk_curr_x% = PP_STROKE(c%).X
            chk_curr_y% = PP_STROKE(c%).Y
            chk_next_x% = PP_STROKE(c% + 1).X
            chk_next_y% = PP_STROKE(c% + 1).Y
            
            chk_prev_aligned%     = (chk_prev_x% = chk_curr_x%) OR (chk_prev_y% = chk_curr_y%)
            chk_next_aligned%     = (chk_next_x% = chk_curr_x%) OR (chk_next_y% = chk_curr_y%)
            chk_ends_not_aligned% = (chk_prev_x% <> chk_next_x%) AND (chk_prev_y% <> chk_next_y%)
            
            ' Only remove corner if prev and next are EXACTLY diagonal (distance = 1 on both axes)
            DIM prev_next_diagonal AS INTEGER
            prev_next_diagonal% = (ABS(chk_prev_x% - chk_next_x%) = 1) AND (ABS(chk_prev_y% - chk_next_y%) = 1)
            
            IF chk_prev_aligned% AND chk_next_aligned% AND chk_ends_not_aligned% AND prev_next_diagonal% THEN
                ' SKIP this corner - increment to move past it
                skipped% = skipped% + 1
                c% = c% + 1
                ' Now draw the NEXT pixel without checking if it's a corner
                IF c% < PP_STROKE_COUNT% THEN
                    PAINT_pset_with_symmetry PP_STROKE(c%).X, PP_STROKE(c%).Y, DRAW_COLOR~&, TRUE
                END IF
                c% = c% + 1
                ' Continue to next iteration (skip the normal draw below)
                GOTO pp_continue
            END IF
        END IF
        
        ' Draw non-corner pixels
        PAINT_pset_with_symmetry PP_STROKE(c%).X, PP_STROKE(c%).Y, DRAW_COLOR~&, TRUE
        c% = c% + 1
        pp_continue:
    WEND
END SUB


''
' Draw with custom brush - stamps brush along stroke path
'
SUB BRUSH_draw_custom ()
    IF NOT CUSTOM_BRUSH_is_active% THEN EXIT SUB
    
    DIM start_x AS INTEGER, start_y AS INTEGER
    DIM end_x   AS INTEGER, end_y AS INTEGER
    DIM dx      AS INTEGER, dy AS INTEGER
    DIM steps   AS INTEGER, i AS INTEGER
    DIM t       AS SINGLE
    DIM stamp_x AS INTEGER, stamp_y AS INTEGER
    
    ' Determine start and end points based on constraint mode
    IF CONSTRAIN_X% THEN
        start_x% = MOUSE.CON_X%
        start_y% = MOUSE.OLD_Y%
        end_x%   = MOUSE.CON_X%
        end_y%   = MOUSE.Y%
    ELSEIF CONSTRAIN_Y% THEN
        start_x% = MOUSE.OLD_X%
        start_y% = MOUSE.CON_Y%
        end_x%   = MOUSE.X%
        end_y%   = MOUSE.CON_Y%
    ELSE
        start_x% = MOUSE.OLD_X%
        start_y% = MOUSE.OLD_Y%
        end_x%   = MOUSE.X%
        end_y%   = MOUSE.Y%
    END IF
    
    ' Calculate distance and interpolation steps
    dx%    = end_x% - start_x%
    dy%    = end_y% - start_y%
    steps% = INT(SQR(dx% * dx% + dy% * dy%))
    
    IF steps% = 0 THEN
        ' Single stamp at current position
        stamp_x% = end_x% - CUSTOM_BRUSH.WIDTH% \ 2
        stamp_y% = end_y% - CUSTOM_BRUSH.HEIGHT% \ 2
        CUSTOM_BRUSH_stamp stamp_x%, stamp_y%
    ELSE
        ' Interpolate and stamp along the path
        ' Space stamps based on brush size - use minimum dimension for tiling
        DIM stamp_spacing AS INTEGER
        stamp_spacing% = CUSTOM_BRUSH.WIDTH%
        IF CUSTOM_BRUSH.HEIGHT% < stamp_spacing% THEN stamp_spacing% = CUSTOM_BRUSH.HEIGHT%
        IF stamp_spacing% < 1 THEN stamp_spacing% = 1
        
        FOR i% = 0 TO steps% STEP stamp_spacing%
            t! = i% / steps%
            ' Calculate interpolated position
            DIM interp_x AS INTEGER, interp_y AS INTEGER
            interp_x% = start_x% + dx% * t!
            interp_y% = start_y% + dy% * t!
            ' Snap to grid if enabled (critical for diagonal tiling)
            GRID_snap_xy interp_x%, interp_y%
            ' Now stamp at snapped position
            stamp_x% = interp_x% - CUSTOM_BRUSH.WIDTH% \ 2
            stamp_y% = interp_y% - CUSTOM_BRUSH.HEIGHT% \ 2
            CUSTOM_BRUSH_stamp stamp_x%, stamp_y%
        NEXT i%
        
        ' Always stamp at the end point (already snapped by MOUSE coords)
        stamp_x% = end_x% - CUSTOM_BRUSH.WIDTH% \ 2
        stamp_y% = end_y% - CUSTOM_BRUSH.HEIGHT% \ 2
        CUSTOM_BRUSH_stamp stamp_x%, stamp_y%
    END IF
END SUB

''
' Stamps custom brush along a line from (x1,y1) to (x2,y2)
' Used by LINE, RECTANGLE, ELLIPSE, POLYGON tools
' @param x1 INTEGER Start X coordinate
' @param y1 INTEGER Start Y coordinate
' @param x2 INTEGER End X coordinate
' @param y2 INTEGER End Y coordinate
'
SUB CUSTOM_BRUSH_stamp_line (x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    IF NOT CUSTOM_BRUSH_is_active% THEN EXIT SUB
    
    DIM dx            AS INTEGER, dy AS INTEGER
    DIM steps         AS INTEGER
    DIM t             AS SINGLE
    DIM i             AS INTEGER
    DIM stamp_x       AS INTEGER, stamp_y AS INTEGER
    DIM stamp_spacing AS INTEGER
    
    dx%    = x2% - x1%
    dy%    = y2% - y1%
    steps% = INT(SQR(dx% * dx% + dy% * dy%))
    
    IF steps% = 0 THEN
        ' Single stamp at start position
        stamp_x% = x1% - CUSTOM_BRUSH.WIDTH% \ 2
        stamp_y% = y1% - CUSTOM_BRUSH.HEIGHT% \ 2
        CUSTOM_BRUSH_stamp stamp_x%, stamp_y%
    ELSE
        ' Stamp once per pixel along the line for smooth, dense strokes
        stamp_spacing% = 1

        FOR i% = 0 TO steps% STEP stamp_spacing%
            t! = i% / steps%
            ' Calculate interpolated position
            DIM interp_x AS INTEGER, interp_y AS INTEGER
            interp_x% = x1% + dx% * t!
            interp_y% = y1% + dy% * t!
            ' Snap to grid if enabled (critical for tile alignment)
            GRID_snap_xy interp_x%, interp_y%
            ' Now stamp at snapped position
            stamp_x% = interp_x% - CUSTOM_BRUSH.WIDTH% \ 2
            stamp_y% = interp_y% - CUSTOM_BRUSH.HEIGHT% \ 2
            CUSTOM_BRUSH_stamp stamp_x%, stamp_y%
        NEXT i%
        
        ' Always stamp at end point (already snapped by tool coordinates)
        stamp_x% = x2% - CUSTOM_BRUSH.WIDTH% \ 2
        stamp_y% = y2% - CUSTOM_BRUSH.HEIGHT% \ 2
        CUSTOM_BRUSH_stamp stamp_x%, stamp_y%
    END IF
END SUB

''
' Stamps custom brush along an ellipse outline
' @param cx INTEGER Center X coordinate
' @param cy INTEGER Center Y coordinate
' @param rx SINGLE Horizontal radius
' @param ry SINGLE Vertical radius
'
SUB CUSTOM_BRUSH_stamp_ellipse (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE)
    IF NOT CUSTOM_BRUSH_is_active% THEN EXIT SUB
    IF rx! <= 0 OR ry! <= 0 THEN EXIT SUB
    
    DIM angle      AS SINGLE
    DIM x          AS INTEGER, y AS INTEGER
    DIM prev_x     AS INTEGER, prev_y AS INTEGER
    DIM first_loop AS INTEGER
    DIM stamp_x    AS INTEGER, stamp_y AS INTEGER
    DIM step_angle AS SINGLE
    
    ' Calculate step size based on ellipse perimeter approximation
    DIM perimeter     AS SINGLE
    perimeter! = 3.14159 * (rx! + ry!) * 2
    ' Use minimum brush dimension for tiling
    DIM brush_spacing AS SINGLE
    brush_spacing! = CUSTOM_BRUSH.WIDTH%
    IF CUSTOM_BRUSH.HEIGHT% < brush_spacing! THEN brush_spacing! = CUSTOM_BRUSH.HEIGHT%
    step_angle! = 6.28318 / perimeter! * brush_spacing!
    IF step_angle! < 0.05 THEN step_angle! = 0.05
    
    first_loop% = TRUE
    angle!      = 0
    
    DO WHILE angle! < 6.28318
        x% = cx% + INT(rx! * COS(angle!))
        y% = cy% + INT(ry! * SIN(angle!))
        
        ' Snap ellipse perimeter point to grid for proper tiling
        GRID_snap_xy x%, y%
        
        IF NOT first_loop% THEN
            ' Stamp between previous and current point
            CUSTOM_BRUSH_stamp_line prev_x%, prev_y%, x%, y%
        ELSE
            ' Just stamp at first point
            stamp_x% = x% - CUSTOM_BRUSH.WIDTH% \ 2
            stamp_y% = y% - CUSTOM_BRUSH.HEIGHT% \ 2
            CUSTOM_BRUSH_stamp stamp_x%, stamp_y%
            first_loop% = FALSE
        END IF
        
        prev_x% = x%
        prev_y% = y%
        angle! = angle! + step_angle!
    LOOP
END SUB


''
' Stamps the current brush shape onto _DEST for preview rendering.
' No selection clipping, no opacity lock, no layer targeting — just raw PSET.
'
' @param x INTEGER - Center X coordinate
' @param y INTEGER - Center Y coordinate
' @param col _UNSIGNED LONG - Color to stamp with
'
SUB PREVIEW_stamp_brush (x AS INTEGER, y AS INTEGER, col AS _UNSIGNED LONG)
    DIM pixel_size AS INTEGER
    DIM radius     AS INTEGER
    DIM px         AS INTEGER, py AS INTEGER
    DIM dist_sq    AS SINGLE, r_sq AS SINGLE
    DIM half       AS INTEGER
    pixel_size% = BRUSH_SIZE_pixels%

    IF pixel_size% <= 1 THEN
        PSET (x%, y%), col~&
    ELSEIF BRUSH_SIZE.SHAPE = BRUSH_SHAPE_SLASH _ORELSE BRUSH_SIZE.SHAPE = BRUSH_SHAPE_BACKSLASH THEN
        ' a slant nib: its solid core
        DIM sx0 AS SINGLE, sy0 AS SINGLE, sx1 AS SINGLE, sy1 AS SINGLE, sr AS SINGLE
        PAINT_slant_seg x%, y%, pixel_size%, sx0!, sy0!, sx1!, sy1!, sr!
        half% = INT(pixel_size% / 2 + 1)
        FOR py% = y% - half% TO y% + half%
            FOR px% = x% - half% TO x% + half%
                IF PAINT_seg_dist!(px%, py%, sx0!, sy0!, sx1!, sy1!) <= sr! THEN PSET (px%, py%), col~&
            NEXT px%
        NEXT py%
    ELSEIF pixel_size% = 3 AND BRUSH_SIZE.SHAPE = 0 THEN
        ' Plus sign for size 3 circle
        FOR py% = y% - 1 TO y% + 1
            PSET (x%, py%), col~&
        NEXT
        FOR px% = x% - 1 TO x% + 1
            PSET (px%, y%), col~&
        NEXT
    ELSE
        radius% = pixel_size% \ 2
        IF BRUSH_SIZE.SHAPE = 0 THEN
            ' Filled circle
            r_sq! = (radius% - 0.5) * (radius% - 0.5)
            FOR py% = y% - radius% TO y% + radius%
                FOR px% = x% - radius% TO x% + radius%
                    dist_sq! = (px% - x%) * (px% - x%) + (py% - y%) * (py% - y%)
                    IF dist_sq! <= r_sq! THEN
                        PSET (px%, py%), col~&
                    END IF
                NEXT px%
            NEXT py%
        ELSE
            ' Filled square
            half% = pixel_size% \ 2
            FOR py% = y% - half% TO y% + half%
                FOR px% = x% - half% TO x% + half%
                    PSET (px%, py%), col~&
                NEXT px%
            NEXT py%
        END IF
    END IF
END SUB


''
' Draws a brushed line preview using Bresenham + PREVIEW_stamp_brush.
' Draws on current _DEST without layer/selection awareness.
'
' @param x1 INTEGER - Start X
' @param y1 INTEGER - Start Y
' @param x2 INTEGER - End X
' @param y2 INTEGER - End Y
' @param col _UNSIGNED LONG - Color
'
SUB PREVIEW_draw_brushed_line (x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, col AS _UNSIGNED LONG)
    DIM dx     AS INTEGER, dy AS INTEGER
    DIM sx     AS INTEGER, sy AS INTEGER
    DIM errval AS INTEGER, e2 AS INTEGER
    DIM x      AS INTEGER, y AS INTEGER

    x%  = x1% : y% = y1%
    dx% = ABS(x2% - x1%)
    dy% = -ABS(y2% - y1%)
    IF x1% < x2% THEN sx% = 1 ELSE sx% = -1
    IF y1% < y2% THEN sy% = 1 ELSE sy% = -1
    errval% = dx% + dy%

    DO
        PREVIEW_stamp_brush x%, y%, col~&
        IF x% = x2% AND y% = y2% THEN EXIT DO
        e2% = 2 * errval%
        IF e2% >= dy% THEN
            IF x% = x2% THEN EXIT DO
            errval% = errval% + dy%
            x% = x% + sx%
        END IF
        IF e2% <= dx% THEN
            IF y% = y2% THEN EXIT DO
            errval% = errval% + dx%
            y% = y% + sy%
        END IF
    LOOP
END SUB


''
' Draws a brushed ellipse outline preview (ELLIPSE_plot_outline + PREVIEW_stamp_brush).
' Draws on current _DEST without layer/selection awareness.
'
' @param cx INTEGER - Center X
' @param cy INTEGER - Center Y
' @param rx SINGLE - Radius X
' @param ry SINGLE - Radius Y
' @param col _UNSIGNED LONG - Color
'
SUB PREVIEW_draw_brushed_ellipse (cx AS INTEGER, cy AS INTEGER, rx AS SINGLE, ry AS SINGLE, col AS _UNSIGNED LONG)
    IF rx! < 0 OR ry! < 0 THEN EXIT SUB
    ' Same pixel-exact path as the commit (ELLIPSE_draw_brushed), so preview == result.
    ELLIPSE_plot_outline cx%, cy%, rx!, ry!, col~&, ELLIPSE_PLOT_PREVIEW
END SUB
