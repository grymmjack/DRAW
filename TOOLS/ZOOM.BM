''
' DRAW - TOOLS/ZOOM.BM
' =============================================================================
' Zoom tool subs and functions.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' A zoom level at or below 25%, largest first: 25, 20, 15, 10, 7.5, 5, 3, 2, 1 %.
' @param i INTEGER 1..ZOOM_SMALL_COUNT
' @return SINGLE The zoom factor (0 outside the range)
'
FUNCTION ZOOM_small_level! (i AS INTEGER)
    DIM r AS SINGLE
    SELECT CASE i%
        CASE 1: r! = 0.25
        CASE 2: r! = 0.2
        CASE 3: r! = 0.15
        CASE 4: r! = 0.1
        CASE 5: r! = 0.075
        CASE 6: r! = 0.05
        CASE 7: r! = 0.03
        CASE 8: r! = 0.02
        CASE 9: r! = 0.01
    END SELECT
    ZOOM_small_level! = r!
END FUNCTION

''
' The next small zoom level below z (never under SCRN.zoomMin!).
' @param z SINGLE Current zoom (at or below 25%)
' @return SINGLE The next level out
'
FUNCTION ZOOM_small_out! (z AS SINGLE)
    DIM i AS INTEGER, r AS SINGLE, lv AS SINGLE
    r! = SCRN.zoomMin!
    FOR i% = 1 TO ZOOM_SMALL_COUNT
        lv! = ZOOM_small_level!(i%)
        IF lv! < z! - 0.0001 THEN r! = lv! : EXIT FOR
    NEXT i%
    IF r! < SCRN.zoomMin! THEN r! = SCRN.zoomMin!
    ' Stop before the canvas shrinks under 100 screen pixels on its long side
    ' (a small canvas keeps the old 25% floor; only big images go lower).
    DIM longSide AS LONG
    longSide& = SCRN.canvasW&
    IF SCRN.canvasH& > longSide& THEN longSide& = SCRN.canvasH&
    IF longSide& * r! < 100 THEN r! = z!
    ZOOM_small_out! = r!
END FUNCTION

''
' The next small zoom level above z, up to 25%.
' @param z SINGLE Current zoom (below 25%)
' @return SINGLE The next level in
'
FUNCTION ZOOM_small_in! (z AS SINGLE)
    DIM i AS INTEGER, r AS SINGLE, lv AS SINGLE
    r! = 0.25
    FOR i% = ZOOM_SMALL_COUNT TO 1 STEP -1
        lv! = ZOOM_small_level!(i%)
        IF lv! > z! + 0.0001 THEN r! = lv! : EXIT FOR
    NEXT i%
    ZOOM_small_in! = r!
END FUNCTION

''
' The largest small zoom level that still fits: the biggest level <= z.
' Used by zoom-to-fit and zoom-to-region when the fit is under 25%.
' @param z SINGLE The exact fit zoom
' @return SINGLE A level from the list (SCRN.zoomMin! if z is smaller than all)
'
FUNCTION ZOOM_small_fit! (z AS SINGLE)
    DIM i AS INTEGER, r AS SINGLE, lv AS SINGLE
    r! = SCRN.zoomMin!
    FOR i% = 1 TO ZOOM_SMALL_COUNT
        lv! = ZOOM_small_level!(i%)
        IF lv! <= z! + 0.0001 THEN r! = lv! : EXIT FOR
    NEXT i%
    IF r! < SCRN.zoomMin! THEN r! = SCRN.zoomMin!
    ZOOM_small_fit! = r!
END FUNCTION

''
' Zoom in one snap level: 1%->...->25%->50%->100%->200%->300%->...->800%
'
SUB ZOOM_in ()
    IF SCRN.zoom! < 0.25 - 0.0001 THEN
        SCRN.zoom! = ZOOM_small_in!(SCRN.zoom!) ' below 25%: the small levels
    ELSEIF SCRN.zoom! < 0.5 THEN
        SCRN.zoom! = 0.5                   ' 25% -> 50%
    ELSEIF SCRN.zoom! < 1.0 THEN
        SCRN.zoom! = 1.0                   ' 50% -> 100%
    ELSE
        SCRN.zoom! = INT(SCRN.zoom!) + 1.0 ' 100% -> 200%, etc.
    END IF
    IF SCRN.zoom! > SCRN.zoomMax! THEN SCRN.zoom! = SCRN.zoomMax!
    GUI_NEEDS_REDRAW% = TRUE
END SUB

''
' Zoom out one snap level: ...300%->200%->100%->50%->25%->20%->...->1%
'
SUB ZOOM_out ()
    IF SCRN.zoom! > 1.0 THEN
        SCRN.zoom! = INT(SCRN.zoom!) - 1.0 ' 200% -> 100%, etc.
        IF SCRN.zoom! < 1.0 THEN SCRN.zoom! = 1.0 ' 150% -> 100%, not the floor
    ELSEIF SCRN.zoom! > 0.5 THEN
        SCRN.zoom! = 0.5                   ' 100% -> 50%
    ELSEIF SCRN.zoom! > 0.25 + 0.0001 THEN
        SCRN.zoom! = 0.25                  ' 50% -> 25%
    ELSE
        SCRN.zoom! = ZOOM_small_out!(SCRN.zoom!) ' 25% -> 20% -> ... -> 1%
    END IF
    IF SCRN.zoom! < SCRN.zoomMin! THEN SCRN.zoom! = SCRN.zoomMin!
    GUI_NEEDS_REDRAW% = TRUE
END SUB

''
' Reset zoom to 100% and center canvas
'
SUB ZOOM_reset ()
    SCRN.zoom!        = 1.0
    SCRN.offsetX%     = 0
    SCRN.offsetY%     = 0
    GUI_NEEDS_REDRAW% = TRUE
END SUB

''
' Zoom in centered on a screen position (logical coords)
' @param screenX INTEGER Screen X coordinate to zoom toward
' @param screenY INTEGER Screen Y coordinate to zoom toward
'
SUB ZOOM_in_at (screenX%, screenY%)
    DIM oldZoom AS SINGLE
    oldZoom! = SCRN.zoom!
    ZOOM_in
    IF SCRN.zoom! <> oldZoom! THEN
        ZOOM_adjust_offset oldZoom!, SCRN.zoom!, screenX%, screenY%
    END IF
END SUB

''
' Zoom out centered on a screen position (logical coords)
' @param screenX INTEGER Screen X coordinate to zoom away from
' @param screenY INTEGER Screen Y coordinate to zoom away from
'
SUB ZOOM_out_at (screenX%, screenY%)
    DIM oldZoom AS SINGLE
    oldZoom! = SCRN.zoom!
    ZOOM_out
    IF SCRN.zoom! <> oldZoom! THEN
        ZOOM_adjust_offset oldZoom!, SCRN.zoom!, screenX%, screenY%
    END IF
END SUB

''
' Adjust offset to keep a screen point over the same canvas point after zoom change
' @param oldZoom SINGLE Previous zoom level before the change
' @param newZoom SINGLE New zoom level after the change
' @param screenX INTEGER Screen X coordinate to anchor
' @param screenY INTEGER Screen Y coordinate to anchor
'
SUB ZOOM_adjust_offset (oldZoom!, newZoom!, screenX%, screenY%)
    ' Calculate canvas center offset at old zoom (canvas dimensions)
    DIM old_zw AS LONG, old_zh AS LONG
    old_zw& = SCRN.canvasW& * oldZoom!
    old_zh& = SCRN.canvasH& * oldZoom!
    DIM old_cx AS LONG, old_cy AS LONG
    old_cx& = (SCRN.w& - old_zw&) \ 2
    old_cy& = (SCRN.h& - old_zh&) \ 2

    ' Canvas position under mouse at old zoom
    DIM cvX AS SINGLE, cvY AS SINGLE
    ' (the canvas is drawn panelShift px over, as the mouse mapping has it)
    cvX! = (screenX% - old_cx& - SCRN.offsetX% - SCRN.panelShiftX%) / oldZoom!
    cvY! = (screenY% - old_cy& - SCRN.offsetY% - SCRN.panelShiftY%) / oldZoom!

    ' Calculate new canvas center offset at new zoom (canvas dimensions)
    DIM new_zw AS LONG, new_zh AS LONG
    new_zw& = SCRN.canvasW& * newZoom!
    new_zh& = SCRN.canvasH& * newZoom!
    DIM new_cx AS LONG, new_cy AS LONG
    new_cx& = (SCRN.w& - new_zw&) \ 2
    new_cy& = (SCRN.h& - new_zh&) \ 2

    ' Adjust offset to keep canvas point under screen position
    SCRN.offsetX% = screenX% - new_cx& - SCRN.panelShiftX% - (cvX! * newZoom!)
    SCRN.offsetY% = screenY% - new_cy& - SCRN.panelShiftY% - (cvY! * newZoom!)
END SUB

''
' The canvas view: the window less the side docks, the menu bar, the bottom
' bars and the Browser's band - the area a fit or a region zoom centres in.
'
SUB ZOOM_viewport_rect (vpLeft AS INTEGER, vpTop AS INTEGER, vpRight AS INTEGER, vpBottom AS INTEGER)
    vpLeft%   = SCRN.uiLeftEdge%
    vpRight%  = SCRN.uiRightEdge%
    vpTop%    = MENU_BAR_HEIGHT
    vpBottom% = SCRN.h& - 1
    IF SCRN.showStatus% THEN
        vpBottom% = vpBottom% - THEME.STATUS_height% - PALETTE_STRIP_get_height%
    END IF
    ' the Browser's top / bottom band (GUI/DOCK) takes its height out of the view
    IF DOCK_BAND_W > 0 THEN
        IF DOCK_BAND_SIDE = DOCK_BAND_TOP THEN vpTop% = DOCK_BAND_Y + DOCK_BAND_HH ELSE vpBottom% = DOCK_BAND_Y - 1
    END IF
    ' the top / bottom dock rows (Rick 2026-11-16: a fit "positions the canvas
    ' underneath those docks"): between them, as ANIM_LB_area does
    IF DOCK_ROWS_TOPH > 0 _ANDALSO DOCK_ROWS_Y1 > vpTop% THEN vpTop% = DOCK_ROWS_Y1
    IF DOCK_ROWS_BOTH > 0 _ANDALSO DOCK_ROWS_Y2 < vpBottom% THEN vpBottom% = DOCK_ROWS_Y2
    IF vpRight% - vpLeft% + 1 < 32 THEN vpRight% = vpLeft% + 31
    IF vpBottom% - vpTop% + 1 < 32 THEN vpBottom% = vpTop% + 31
END SUB

''
' Snap a fitting zoom down to the nearest valid level (1x and up: whole
' steps; under 1x: 50%, 25%, then the small levels), capped at zoomMax.
'
FUNCTION ZOOM_snap_fit! (z AS SINGLE)
    DIM r AS SINGLE
    IF z < 0.25 THEN
        r = ZOOM_small_fit!(z) ' big canvas: the largest small level that fits
    ELSEIF z < 0.5 THEN
        r = 0.25
    ELSEIF z < 1.0 THEN
        r = 0.5
    ELSE
        r = INT(z)
        IF r < 1.0 THEN r = 1.0
    END IF
    IF r > SCRN.zoomMax! THEN r = SCRN.zoomMax!
    ZOOM_snap_fit! = r
END FUNCTION

''
' Pan so canvas point (cvX, cvY) sits at the centre of the canvas view. The
' canvas is drawn at (w - zw) \ 2 + offset + panelShift; panelShift already
' centres it between the side docks, so the offset must not add that again
' (BUGS.md 2026-11-15: a fit in DEFAULT 2 sat off-centre, no left margin).
'
SUB ZOOM_center_on (cvX AS SINGLE, cvY AS SINGLE)
    DIM vpL AS INTEGER, vpT AS INTEGER, vpR AS INTEGER, vpB AS INTEGER
    ZOOM_viewport_rect vpL%, vpT%, vpR%, vpB%
    DIM zw AS LONG, zh AS LONG
    zw& = SCRN.canvasW& * SCRN.zoom!
    zh& = SCRN.canvasH& * SCRN.zoom!
    SCRN.offsetX% = (vpL% + vpR% + 1) \ 2 - (SCRN.w& - zw&) \ 2 - SCRN.panelShiftX% - CLNG(cvX! * SCRN.zoom!)
    SCRN.offsetY% = (vpT% + vpB% + 1) \ 2 - (SCRN.h& - zh&) \ 2 - SCRN.panelShiftY% - CLNG(cvY! * SCRN.zoom!)
END SUB

''
' Zoom to fit the whole canvas in the view, centred (Hand tool double-click,
' View > Fit).
'
SUB ZOOM_fit_canvas ()
    DIM vpLeft AS INTEGER, vpRight AS INTEGER
    DIM vpTop  AS INTEGER, vpBottom AS INTEGER
    ' the dock rows as they will be drawn: a Hand double-click switches the tool
    ' (its own Selection Bar, another height) in the same frame, and the fit
    ' centred between the old bar's rows - 9 px high (QA zoom-fit-center)
    SCREEN_compute_layout
    ZOOM_viewport_rect vpLeft%, vpTop%, vpRight%, vpBottom%

    ' Calculate zoom level that fits entire canvas within the viewport
    DIM fitZoomW AS SINGLE, fitZoomH AS SINGLE
    fitZoomW! = (vpRight% - vpLeft% + 1) / SCRN.canvasW&
    fitZoomH! = (vpBottom% - vpTop% + 1) / SCRN.canvasH&
    IF fitZoomW! < fitZoomH! THEN SCRN.zoom! = ZOOM_snap_fit!(fitZoomW!) ELSE SCRN.zoom! = ZOOM_snap_fit!(fitZoomH!)

    ZOOM_center_on SCRN.canvasW& / 2, SCRN.canvasH& / 2
    GUI_NEEDS_REDRAW% = TRUE
END SUB

''
' Zoom to fit a drag-selected screen region, centering the canvas on the selection.
' Snaps to the nearest valid zoom level and adjusts pan offset accordingly.
' @param x1 INTEGER First corner screen X coordinate of the drag region
' @param y1 INTEGER First corner screen Y coordinate of the drag region
' @param x2 INTEGER Second corner screen X coordinate of the drag region
' @param y2 INTEGER Second corner screen Y coordinate of the drag region
'
SUB ZOOM_to_region (x1%, y1%, x2%, y2%)
    ' Ensure proper ordering
    DIM rx1 AS INTEGER, ry1 AS INTEGER, rx2 AS INTEGER, ry2 AS INTEGER
    IF x1% < x2% THEN rx1% = x1% : rx2% = x2% ELSE rx1% = x2% : rx2% = x1%
    IF y1% < y2% THEN ry1% = y1% : ry2% = y2% ELSE ry1% = y2% : ry2% = y1%

    DIM regionW AS INTEGER, regionH AS INTEGER
    regionW% = rx2% - rx1%
    regionH% = ry2% - ry1%

    ' Need a minimum drag size (at least 8px)
    IF regionW% < 8 OR regionH% < 8 THEN EXIT SUB
    SCREEN_compute_layout ' the rows as drawn (ZOOM_fit_canvas)

    ' The drag region's centre in canvas coords, through the same mapping the
    ' canvas is drawn with (panelShift included - without it the zoom landed
    ' off to one side, BUGS.md 2026-11-15)
    DIM oldZoom AS SINGLE
    oldZoom! = SCRN.zoom!
    DIM old_cx AS LONG, old_cy AS LONG
    old_cx& = (SCRN.w& - CLNG(SCRN.canvasW& * oldZoom!)) \ 2 + SCRN.offsetX% + SCRN.panelShiftX%
    old_cy& = (SCRN.h& - CLNG(SCRN.canvasH& * oldZoom!)) \ 2 + SCRN.offsetY% + SCRN.panelShiftY%
    DIM canvasCX AS SINGLE, canvasCY AS SINGLE
    canvasCX! = ((rx1% + rx2%) / 2 - old_cx&) / oldZoom!
    canvasCY! = ((ry1% + ry2%) / 2 - old_cy&) / oldZoom!

    ' Zoom that fits the region's canvas area into the canvas view
    DIM vpL AS INTEGER, vpT AS INTEGER, vpR AS INTEGER, vpB AS INTEGER
    ZOOM_viewport_rect vpL%, vpT%, vpR%, vpB%
    DIM zoomW AS SINGLE, zoomH AS SINGLE
    zoomW! = (vpR% - vpL% + 1) / (regionW% / oldZoom!)
    zoomH! = (vpB% - vpT% + 1) / (regionH% / oldZoom!)
    IF zoomW! < zoomH! THEN SCRN.zoom! = ZOOM_snap_fit!(zoomW!) ELSE SCRN.zoom! = ZOOM_snap_fit!(zoomH!)

    ZOOM_center_on canvasCX!, canvasCY!
    GUI_NEEDS_REDRAW% = TRUE
END SUB

''
' Reset zoom tool drag state
'
SUB ZOOM_drag_reset ()
    ZOOM.DRAGGING = FALSE
    ZOOM.START_X  = 0
    ZOOM.START_Y  = 0
    ZOOM.END_X    = 0
    ZOOM.END_Y    = 0
END SUB

''
' Zoom to a specific level, keeping the current canvas centre in view.
' @param targetZoom SINGLE Desired zoom level (1.0 = 100%, 8.0 = 800%, etc.)
'
SUB ZOOM_to_level_canvas_center (targetZoom AS SINGLE)
    DIM newZoom AS SINGLE
    newZoom! = targetZoom!
    IF newZoom! < SCRN.zoomMin! THEN newZoom! = SCRN.zoomMin!
    IF newZoom! > SCRN.zoomMax! THEN newZoom! = SCRN.zoomMax!
    IF newZoom! = SCRN.zoom! THEN EXIT SUB

    DIM oldZoom AS SINGLE
    oldZoom!   = SCRN.zoom!
    SCRN.zoom! = newZoom!

    ' Canvas centre in canvas pixels
    DIM cvCx AS SINGLE, cvCy AS SINGLE
    cvCx! = SCRN.canvasW& / 2.0
    cvCy! = SCRN.canvasH& / 2.0

    ' Screen position of that canvas centre at old zoom
    DIM old_cx AS LONG, old_cy AS LONG
    old_cx& = (SCRN.w& - SCRN.canvasW& * oldZoom!) \ 2
    old_cy& = (SCRN.h& - SCRN.canvasH& * oldZoom!) \ 2
    DIM scrCx  AS LONG, scrCy AS LONG
    scrCx& = old_cx& + SCRN.offsetX% + INT(cvCx! * oldZoom!)
    scrCy& = old_cy& + SCRN.offsetY% + INT(cvCy! * oldZoom!)

    ' Recalculate offset so the same canvas point stays at that screen position
    DIM new_cx AS LONG, new_cy AS LONG
    new_cx&       = (SCRN.w& - SCRN.canvasW& * newZoom!) \ 2
    new_cy&       = (SCRN.h& - SCRN.canvasH& * newZoom!) \ 2
    SCRN.offsetX% = scrCx& - new_cx& - INT(cvCx! * newZoom!)
    SCRN.offsetY% = scrCy& - new_cy& - INT(cvCy! * newZoom!)

    ' If the canvas would be entirely outside the work-area viewport after the
    ' zoom (e.g. the user had panned far away then pressed Z+1), re-center the
    ' canvas in the work area so the user is never left staring at blank apron.
    DIM vp_left AS LONG, vp_right AS LONG
    DIM vp_top  AS LONG, vp_bottom AS LONG
    vp_left&   = SCRN.uiLeftEdge%
    vp_right&  = SCRN.uiRightEdge%
    vp_top&    = MENU_BAR_HEIGHT
    vp_bottom& = SCRN.h& - 1
    IF SCRN.showStatus% THEN
        vp_bottom& = vp_bottom& - THEME.STATUS_height% - PALETTE_STRIP_get_height%
    END IF
    DIM cv_left AS LONG, cv_right AS LONG
    DIM cv_top  AS LONG, cv_bottom AS LONG
    cv_left&   = new_cx& + SCRN.offsetX%
    cv_right&  = cv_left&  + INT(SCRN.canvasW& * newZoom!)
    cv_top&    = new_cy& + SCRN.offsetY%
    cv_bottom& = cv_top&   + INT(SCRN.canvasH& * newZoom!)
    IF cv_right& <= vp_left& OR cv_left& >= vp_right& OR _
       cv_bottom& <= vp_top& OR cv_top& >= vp_bottom& THEN
        ' Canvas is entirely off-screen — center it in the work area
        DIM vp_cx AS LONG, vp_cy AS LONG
        vp_cx&        = (vp_left& + vp_right&)   \ 2
        vp_cy&        = (vp_top&  + vp_bottom&)  \ 2
        SCRN.offsetX% = vp_cx& - (SCRN.w& \ 2)
        SCRN.offsetY% = vp_cy& - (SCRN.h& \ 2)
    END IF

    GUI_NEEDS_REDRAW% = TRUE
    SCENE_DIRTY%      = TRUE
    FRAME_IDLE%       = FALSE
END SUB
