''
' DRAW - TOOLS/LOAD.BM
' =============================================================================
' Load tool subs and functions.
'
' @todo
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Load an image file onto the painting surface
' If image is larger than canvas, enters placement mode for cropping/positioning
'
SUB LOAD_image ()
    DIM filename AS STRING
    
    ' Keep the current tool across the dialog (it used to switch to TOOL_NULL,
    ' leaving only an arrow until a tool was picked again).
    ' MOUSE_cleanup_after_dialog stops the dismissing click from reaching it.
    
    ' Use per-operation last dir, then legacy fallbacks
    DIM default_path AS STRING
    IF CFG.LAST_DIR_OPEN$ <> "" THEN
        default_path$ = CFG.LAST_DIR_OPEN$ + "/"
    ELSEIF LAST_DIRECTORY$ <> "" THEN
        default_path$ = LAST_DIRECTORY$ + "/"
    ELSEIF CFG.DEFAULT_OPEN_DIR$ <> "" THEN
        default_path$ = CFG.DEFAULT_OPEN_DIR$ + "/"
    ELSE
        default_path$ = ""
    END IF
    
    ' Show open file dialog
    POINTER_hide_for_dialog
    filename$ = DRAW_open_file$("Open Image", default_path$, "All Supported|*.bmp|*.png|*.jpg|*.jpeg|*.gif|*.psd|*.tga|*.qoi|*.hdr|*.ase|*.aseprite|*.lbm|*.iff|*.ilbm|Images|*.bmp|*.png|*.jpg|*.jpeg|*.gif|*.psd|*.tga|*.qoi|*.hdr|Aseprite|*.ase|*.aseprite|DeluxePaint|*.lbm|*.iff|*.ilbm|All Files|*.*", 0)
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog TRUE ' Clear buffers and center mouse
    
    ' If user didn't cancel
    IF filename$ <> "" THEN
        ' Update per-operation last directory
        CFG.LAST_DIR_OPEN$ = CONFIG_extract_dir$(filename$)
        LAST_DIRECTORY$    = CFG.LAST_DIR_OPEN$
        CONFIG_save

        ' Check if this is an Aseprite file — load as multi-layer project
        IF FILE_ASE_is_aseprite_file%(filename$) THEN
            FILE_ASE_load filename$
            SOUND_play SND_NEW_FILE
            RECENT_add_file filename$
            MOUSE_cleanup_after_dialog TRUE
            EXIT SUB
        END IF

        ' Check for PSD files — load with layer support
        IF FILE_PSD_is_psd_file%(filename$) THEN
            FILE_PSD_load filename$
            SOUND_play SND_NEW_FILE
            RECENT_add_file filename$
            MOUSE_cleanup_after_dialog TRUE
            EXIT SUB
        END IF

        ' Check for ANSI art (text or binary) by extension — render to a new document
        IF ANS_is_ansi_ext%(filename$) THEN
            ANS_load_file filename$
            SOUND_play SND_NEW_FILE
            RECENT_add_file filename$
            SAVE_set_document_file filename$
            MOUSE_cleanup_after_dialog TRUE
            EXIT SUB
        END IF

        ' All other formats (.draw projects AND raster images): direct load via
        ' DRW_load. It auto-detects .draw files and falls through to a flat
        ' image load (sizing canvas to image dimensions) for plain rasters.
        ' Interactive placement mode is reserved for File -> Import Image.
        DRW_load filename$
        SOUND_play SND_NEW_FILE
        RECENT_add_file filename$
        SAVE_set_document_file filename$
        CANVAS_DIRTY% = FALSE
        MOUSE_cleanup_after_dialog TRUE
    END IF
END SUB


''
' Import an image with placement (for use when you want to add to existing canvas)
' Unlike LOAD_image, this doesn't clear the canvas first
'
SUB IMPORT_image ()
    DIM filename AS STRING
    
    ' Use per-operation last dir, then legacy fallbacks
    DIM default_path AS STRING
    IF CFG.LAST_DIR_IMPORT$ <> "" THEN
        default_path$ = CFG.LAST_DIR_IMPORT$ + "/"
    ELSEIF LAST_DIRECTORY$ <> "" THEN
        default_path$ = LAST_DIRECTORY$ + "/"
    ELSEIF CFG.DEFAULT_OPEN_DIR$ <> "" THEN
        default_path$ = CFG.DEFAULT_OPEN_DIR$ + "/"
    ELSE
        default_path$ = ""
    END IF
    
    ' Show open file dialog
    POINTER_hide_for_dialog
    filename$ = DRAW_open_file$("Import Image", default_path$, "All Supported|*.bmp|*.png|*.jpg|*.jpeg|*.gif|*.psd|*.tga|*.qoi|*.hdr|*.ase|*.aseprite|Images|*.bmp|*.png|*.jpg|*.jpeg|*.gif|*.psd|*.tga|*.qoi|*.hdr|Aseprite|*.ase|*.aseprite|All Files|*.*", 0)
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog TRUE ' Clear buffers and center mouse
    
    ' If user didn't cancel
    IF filename$ <> "" THEN
        ' Update per-operation last directory
        CFG.LAST_DIR_IMPORT$ = CONFIG_extract_dir$(filename$)
        LAST_DIRECTORY$      = CFG.LAST_DIR_IMPORT$
        CONFIG_save
        
        ' Force placement mode for import (even for small images)
        ' Check for Aseprite files first — they need the custom loader
        IF FILE_ASE_is_aseprite_file%(filename$) THEN
            FILE_ASE_load filename$
            SOUND_play SND_NEW_FILE
            RECENT_add_file filename$
            MOUSE_cleanup_after_dialog TRUE
            EXIT SUB
        END IF

        ' Check for PSD files — load with layer support
        IF FILE_PSD_is_psd_file%(filename$) THEN
            FILE_PSD_load filename$
            SOUND_play SND_NEW_FILE
            RECENT_add_file filename$
            MOUSE_cleanup_after_dialog TRUE
            EXIT SUB
        END IF

        ' Check for ANSI art (text or binary) by extension — render to a new document
        IF ANS_is_ansi_ext%(filename$) THEN
            ANS_load_file filename$
            SOUND_play SND_NEW_FILE
            RECENT_add_file filename$
            SAVE_set_document_file filename$
            MOUSE_cleanup_after_dialog TRUE
            EXIT SUB
        END IF

        ' The shared loader: sized against and centred in the canvas - in the
        ' lightbox the current frame (field kit R-25: this copy measured the sheet)
        IF IMAGE_IMPORT_load_file%(filename$) THEN
            IMAGE_IMPORT_update_crop_from_zoom
        ELSE
            POINTER_hide_for_dialog
            DRAW_error "Import Error", "Failed to load image: " + filename$
            POINTER_show_after_dialog
            MOUSE_cleanup_after_dialog TRUE ' Clear buffers and center mouse
        END IF
    END IF
END SUB
