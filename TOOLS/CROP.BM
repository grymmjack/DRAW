''
' DRAW - TOOLS/CROP.BM
' =============================================================================
' Canvas resize and crop tool implementation.
'
' CANVAS_resize: Resizes the canvas to new dimensions, preserving layer content
' at (0,0). Resets undo, frees caches, updates all buffers.
'
' Crop tool: Delegates to MARQUEE for all box interaction (click-drag,
' resize handles, move, keyboard nudge). Crop adds a dark overlay outside
' the marquee region and size label. Enter applies, ESC cancels.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE


''
' Reset crop tool state
'
SUB CROP_reset ()
    CROP.STATE     = CROP_STATE_IDLE
    CROP.PREV_TOOL = 0
END SUB


''
' Resize the canvas to new dimensions, preserving existing layer content.
' Content is anchored at (0,0) — pixels outside the new bounds are clipped,
' new area is transparent.
'
' @param newW INTEGER New canvas width (must be >= 1)
' @param newH INTEGER New canvas height (must be >= 1)
'
SUB CANVAS_resize (newW AS INTEGER, newH AS INTEGER)
    DIM AS INTEGER i, w, h
    DIM oldDest     AS LONG
    DIM oldImg      AS LONG
    DIM newImg      AS LONG
    DIM oldGridXPos AS INTEGER, oldGridYPos AS INTEGER

    w% = newW%: h% = newH%
    IF w% < 1 THEN w% = 1
    IF h% < 1 THEN h% = 1

    ' Preserve grid phase so resizing does not shift grid/content relationship
    oldGridXPos% = GRID.xPos%
    oldGridYPos% = GRID.yPos%

    ' No change?
    IF w% = SCRN.canvasW& AND h% = SCRN.canvasH& THEN EXIT SUB

    ' Record for undo before making any changes
    HISTORY_record_canvas_resize SCRN.canvasW&, SCRN.canvasH&, w%, h%, FALSE

    ' Cancel any active import / custom brush / move
    IF IMG_IMPORT.STATE > IMPORT_STATE_IDLE THEN IMAGE_IMPORT_cancel
    IF CUSTOM_BRUSH_is_active% THEN CUSTOM_BRUSH_reset
    MARQUEE_reset
    MOVE_init
    MAGIC_WAND_reset

    ' APRON: collapse all extended layers to compact before resize so the
    ' subsequent (0,0)-anchored copy reads canvas pixels (not apron corner).
    LAYERS_demote_all

    ' Update canvas dimensions
    SCRN.canvasW& = w%
    SCRN.canvasH& = h%
    SCREEN_pattern_tile_force_off

    ' Recreate PAINTING buffer
    SAFE_FREEIMAGE SCRN.PAINTING&
    SCRN.PAINTING& = _NEWIMAGE(w%, h%, 32)
    oldDest&       = _DEST
    _DEST SCRN.PAINTING&
    CLS , _RGBA32(0, 0, 0, 0)
    _DEST oldDest&

    ' Resize each layer image, preserving content at (0,0)
    FOR i% = 1 TO MAX_LAYERS
        IF LAYERS(i%).imgHandle& < -1 THEN
            oldImg&  = LAYERS(i%).imgHandle&
            newImg&  = _NEWIMAGE(w%, h%, 32)
            oldDest& = _DEST
            _DEST newImg&
            CLS , _RGBA32(0, 0, 0, 0)
            _DONTBLEND newImg& ' (raw copy: a blend onto the fresh image greys soft / AA pixels - memory qb64-blend-onto-transparent-greys)
            _PUTIMAGE (0, 0), oldImg&, newImg&
            _BLEND newImg&
            _DEST oldDest&
            SAFE_FREEIMAGE oldImg&
            LAYERS(i%).imgHandle&    = newImg&
            LAYERS(i%).imgWidth%     = w%
            LAYERS(i%).imgHeight%    = h%
            LAYERS(i%).contentDirty% = TRUE
        END IF
        ' Free opacity cache (will be lazily recreated)
        SAFE_FREEIMAGE LAYERS(i%).opacityCacheImg& : LAYERS(i%).opacityCacheImg& = 0
        LAYERS(i%).opacityCacheVal% = 0
    NEXT i%

    ' Free render caches (lazily recreated at new size)
    SAFE_FREEIMAGE SCENE_CACHE&           : SCENE_CACHE& = 0
    SAFE_FREEIMAGE PG_CACHE_IMG&          : PG_CACHE_IMG& = 0
    SAFE_FREEIMAGE COMPOSITE_BUFFER&      : COMPOSITE_BUFFER& = 0
    SAFE_FREEIMAGE COMPOSITE_BELOW_CACHE& : COMPOSITE_BELOW_CACHE& = 0
    COMPOSITE_BELOW_VALID% = FALSE

    ' Free scale originals (dimensions changed, no longer valid)
    SAFE_FREEIMAGE SCALE_ORIGINAL_IMAGE
    SCALE_ORIGINAL_IMAGE = 0
    SCALE_ORIGINAL_LAYER = 0
    SCALE_FACTOR_LAYER   = 1.0
    SAFE_FREEIMAGE MOVE.ORIGINAL_IMAGE
    MOVE.ORIGINAL_IMAGE = 0

    ' Reset zoom/pan to fit new canvas
    IF w% <= SCRN.w& AND h% <= SCRN.h& THEN
        SCRN.zoom! = 1.0
    ELSE
        DIM fitZW AS SINGLE, fitZH AS SINGLE
        fitZW! = SCRN.w& / w%
        fitZH! = SCRN.h& / h%
        IF fitZW! < fitZH! THEN SCRN.zoom! = fitZW! ELSE SCRN.zoom! = fitZH!
    END IF
    SCRN.offsetX% = 0
    SCRN.offsetY% = 0
    SCRN.panning% = FALSE

    ' Recalculate symmetry center
    SYMMETRY.CENTER_X% = w% \ 2
    SYMMETRY.CENTER_Y% = h% \ 2
    IF NOT SYMMETRY.CENTER_SET% THEN
        ' Only auto-center if user hasn't explicitly set center
    END IF

    ' Recreate and redraw grid cache at the new canvas dimensions
    SAFE_FREEIMAGE GRID.imgHandle&
    GRID.imgWidth%  = w%
    GRID.imgHeight% = h%
    GRID.imgHandle& = _NEWIMAGE(w%, h%, 32)
    GRID.xPos%      = oldGridXPos%
    GRID.yPos%      = oldGridYPos%
    GRID_draw

    ' Mark everything dirty
    CANVAS_DIRTY% = TRUE
    BLEND_invalidate_cache
    SCENE_DIRTY%        = TRUE
    RENDER_ORDER_DIRTY% = TRUE
    GUI_NEEDS_REDRAW%   = TRUE
    FRAME_IDLE%         = FALSE

    _LOGINFO "CANVAS_resize: " + STR$(w%) + "x" + STR$(h%)
END SUB


''
' Show native input dialog for canvas resize.
' Prompts user for WxH, parses the response, and calls CANVAS_resize.
'
SUB CANVAS_resize_dialog ()
    DIM currentSize AS STRING
    DIM response    AS STRING
    DIM xPos        AS INTEGER
    DIM newW        AS INTEGER, newH AS INTEGER

    currentSize$ = _TRIM$(STR$(SCRN.canvasW&)) + "x" + _TRIM$(STR$(SCRN.canvasH&))

    POINTER_hide_for_dialog
    response$ = DRAW_input_box_ex$("Resize Canvas", "Enter new size (WxH):", currentSize$, "e.g. 320x200", TRUE)
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog FALSE

    IF LEN(response$) = 0 THEN EXIT SUB  ' User cancelled

    ' Parse WxH format (case-insensitive x separator)
    DIM upper AS STRING
    upper$ = UCASE$(response$)
    xPos%  = INSTR(upper$, "X")
    IF xPos% < 2 THEN
        _LOGWARN "CANVAS_resize_dialog: Invalid format (no x separator): " + response$
        EXIT SUB
    END IF

    newW% = VAL(LEFT$(response$, xPos% - 1))
    newH% = VAL(MID$(response$, xPos% + 1))

    IF newW% < 1 OR newH% < 1 THEN
        _LOGWARN "CANVAS_resize_dialog: Invalid dimensions: " + response$
        EXIT SUB
    END IF

    ' Reasonable upper limit (4096x4096)
    IF newW% > 4096 THEN newW% = 4096
    IF newH% > 4096 THEN newH% = 4096

    CANVAS_resize newW%, newH%
END SUB


''
' Resize the canvas AND scale all layer pixel content to the new dimensions.
' Group layers (1x1 sentinels) are left unchanged; only image/text layers
' have their pixel data scaled via _PUTIMAGE.
'
' @param newW INTEGER New canvas width  (must be >= 1)
' @param newH INTEGER New canvas height (must be >= 1)
'
SUB CANVAS_resize_with_content (newW AS INTEGER, newH AS INTEGER)
    DIM AS INTEGER i, w, h, oldW, oldH
    DIM oldDest     AS LONG
    DIM oldSrc      AS LONG
    DIM oldImg      AS LONG
    DIM newImg      AS LONG
    DIM oldGridXPos AS INTEGER, oldGridYPos AS INTEGER

    w% = newW%: h% = newH%
    IF w% < 1 THEN w% = 1
    IF h% < 1 THEN h% = 1

    IF w% = SCRN.canvasW& AND h% = SCRN.canvasH& THEN EXIT SUB

    oldW% = SCRN.canvasW&
    oldH% = SCRN.canvasH&

    ' Record for undo before making any changes
    HISTORY_record_canvas_resize SCRN.canvasW&, SCRN.canvasH&, w%, h%, TRUE

    ' Preserve grid phase
    oldGridXPos% = GRID.xPos%
    oldGridYPos% = GRID.yPos%

    ' Cancel any active import / custom brush / move
    IF IMG_IMPORT.STATE > IMPORT_STATE_IDLE THEN IMAGE_IMPORT_cancel
    IF CUSTOM_BRUSH_is_active% THEN CUSTOM_BRUSH_reset
    MARQUEE_reset
    MOVE_init
    MAGIC_WAND_reset

    ' APRON: collapse all extended layers before scale-resize.
    LAYERS_demote_all

    ' Update canvas dimensions
    SCRN.canvasW& = w%
    SCRN.canvasH& = h%
    SCREEN_pattern_tile_force_off

    ' Recreate PAINTING buffer
    SAFE_FREEIMAGE SCRN.PAINTING&
    SCRN.PAINTING& = _NEWIMAGE(w%, h%, 32)
    oldDest&       = _DEST
    _DEST SCRN.PAINTING&
    CLS , _RGBA32(0, 0, 0, 0)
    _DEST oldDest&

    ' Scale each image/text layer to the new dimensions
    FOR i% = 1 TO MAX_LAYERS
        IF LAYERS(i%).imgHandle& < -1 THEN
            IF LAYERS(i%).layerType% <> LAYER_TYPE_GROUP THEN
                oldImg&  = LAYERS(i%).imgHandle&
                newImg&  = _NEWIMAGE(w%, h%, 32)
                oldDest& = _DEST
                oldSrc&  = _SOURCE
                _DEST newImg&
                _DONTBLEND newImg&
                CLS , _RGBA32(0, 0, 0, 0)
                _BLEND newImg&
                IMG_scale_rect oldImg&, 0, 0, oldW%, oldH%, newImg& ' smooth with Antialias on
                _DEST oldDest&
                _SOURCE oldSrc&
                SAFE_FREEIMAGE oldImg&
                LAYERS(i%).imgHandle&    = newImg&
                LAYERS(i%).imgWidth%     = w%
                LAYERS(i%).imgHeight%    = h%
                LAYERS(i%).contentDirty% = TRUE
            END IF
        END IF
        ' Free opacity cache (will be lazily recreated)
        SAFE_FREEIMAGE LAYERS(i%).opacityCacheImg& : LAYERS(i%).opacityCacheImg& = 0
        LAYERS(i%).opacityCacheVal% = 0
    NEXT i%

    ' Free render caches (lazily recreated at new size)
    SAFE_FREEIMAGE SCENE_CACHE&           : SCENE_CACHE& = 0
    SAFE_FREEIMAGE PG_CACHE_IMG&          : PG_CACHE_IMG& = 0
    SAFE_FREEIMAGE COMPOSITE_BUFFER&      : COMPOSITE_BUFFER& = 0
    SAFE_FREEIMAGE COMPOSITE_BELOW_CACHE& : COMPOSITE_BELOW_CACHE& = 0
    COMPOSITE_BELOW_VALID% = FALSE

    ' Free scale originals (dimensions changed, no longer valid)
    SAFE_FREEIMAGE SCALE_ORIGINAL_IMAGE
    SCALE_ORIGINAL_IMAGE = 0
    SCALE_ORIGINAL_LAYER = 0
    SCALE_FACTOR_LAYER   = 1.0
    SAFE_FREEIMAGE MOVE.ORIGINAL_IMAGE
    MOVE.ORIGINAL_IMAGE = 0

    ' Reset zoom/pan to fit new canvas
    IF w% <= SCRN.w& AND h% <= SCRN.h& THEN
        SCRN.zoom! = 1.0
    ELSE
        DIM fitZWC AS SINGLE, fitZHC AS SINGLE
        fitZWC! = SCRN.w& / w%
        fitZHC! = SCRN.h& / h%
        IF fitZWC! < fitZHC! THEN SCRN.zoom! = fitZWC! ELSE SCRN.zoom! = fitZHC!
    END IF
    SCRN.offsetX% = 0
    SCRN.offsetY% = 0
    SCRN.panning% = FALSE

    ' Recalculate symmetry center
    SYMMETRY.CENTER_X% = w% \ 2
    SYMMETRY.CENTER_Y% = h% \ 2

    ' Recreate and redraw grid cache at the new canvas dimensions
    SAFE_FREEIMAGE GRID.imgHandle&
    GRID.imgWidth%  = w%
    GRID.imgHeight% = h%
    GRID.imgHandle& = _NEWIMAGE(w%, h%, 32)
    GRID.xPos%      = oldGridXPos%
    GRID.yPos%      = oldGridYPos%
    GRID_draw

    ' Mark everything dirty
    CANVAS_DIRTY% = TRUE
    BLEND_invalidate_cache
    SCENE_DIRTY%        = TRUE
    RENDER_ORDER_DIRTY% = TRUE
    GUI_NEEDS_REDRAW%   = TRUE
    FRAME_IDLE%         = FALSE

    _LOGINFO "CANVAS_resize_with_content: " + STR$(oldW%) + "x" + STR$(oldH%) + " -> " + STR$(w%) + "x" + STR$(h%)
END SUB


''
' Show native input dialog for resize-image-with-content.
' Prompts user for WxH, parses the response, and calls CANVAS_resize_with_content.
'
''
' Draw a click-to-edit numeric field (box + value) for the resize dialog.
'
SUB RESIZE_draw_field (ctx AS DIALOG_CTX, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, num AS INTEGER)
    DIM hovered AS INTEGER
    hovered% = (ctx.mx >= x AND ctx.mx <= x + w AND ctx.my >= y AND ctx.my <= y + h)
    IF hovered% THEN
        LINE (x, y)-(x + w, y + h), THEME.DIALOG_field_hover_bg~&, BF
    ELSE
        LINE (x, y)-(x + w, y + h), THEME.DIALOG_field_bg~&, BF
    END IF
    LINE (x, y)-(x + w, y + h), THEME.DIALOG_field_border~&, B
    COLOR THEME.DIALOG_field_fg~&
    _UPRINTSTRING (x + 6, y + (h - 12) \ 2 + 1), _TRIM$(STR$(num))
    IF THEMEED.started THEN THEMEED_seen _DEST, "DLG", "", "FIELD " + _TRIM$(STR$(num)), x, y, w + 1, h + 1, "@RESIZE_draw_field"
END SUB

''
' Pop DRAW's text-input dialog to edit one dimension; returns the new value
' (clamped 1..4096), or the current value on cancel/blank. Saves + restores the
' caller's _DEST and drains the still-held click (the input box exits on down).
'
FUNCTION RESIZE_edit_value% (current AS INTEGER, lbl AS STRING)
    DIM savedDest AS LONG : savedDest& = _DEST
    DIM resp      AS STRING
    resp$ = DRAW_input_box_ex$("Resize - " + lbl, "Enter " + lbl + " (pixels):", _TRIM$(STR$(current)), "e.g. 320", -1)
    DO WHILE _MOUSEBUTTON(1) OR _MOUSEBUTTON(2) OR _MOUSEBUTTON(3)
        DO WHILE _MOUSEINPUT: LOOP
        _LIMIT 60
    LOOP
    DO WHILE _MOUSEINPUT: LOOP
    _KEYCLEAR
    _DEST savedDest&
    IF LEN(_TRIM$(resp$)) = 0 THEN RESIZE_edit_value% = current : EXIT FUNCTION
    DIM v         AS INTEGER                                    : v% = VAL(resp$)
    IF v% < 1 THEN v% = 1
    IF v% > 4096 THEN v% = 4096
    RESIZE_edit_value% = v%
END FUNCTION

''
' IMAGE > Resize Image with Content. Width x Height fields (prepopulated with the
' current canvas size) plus x2 / /2 buttons that scale both values; OK rescales
' every layer's content to the new size (see CANVAS_resize_with_content).
'
SUB CANVAS_resize_with_content_dialog ()
    DIM ctx   AS DIALOG_CTX
    DIM newW  AS INTEGER, newH AS INTEGER
    DIM k     AS LONG
    DIM wBoxX AS INTEGER, hBoxX AS INTEGER, boxY AS INTEGER, boxW AS INTEGER, boxH AS INTEGER
    DIM x2X   AS INTEGER, d2X AS INTEGER, mulW AS INTEGER
    DIM btnW  AS INTEGER, btnH AS INTEGER, btnY AS INTEGER, okX AS INTEGER, cxX AS INTEGER

    DIM typed AS INTEGER, dbl AS INTEGER ' (Actions: a typed size is kept as W / H, else the X2 / /2 presses as DOUBLE)
    newW% = SCRN.canvasW&
    newH% = SCRN.canvasH&

    POINTER_hide_for_dialog
    DIALOG_init ctx, 336, 150
    ' an Actions step being played: its values; with its DIALOG box off, no dialog (TOOLS/ACTIONS)
    IF ACTS.playing THEN
        dbl% = ACTS_prm_lng&("DOUBLE", 0)
        DO WHILE dbl% > 0: newW% = _MIN(newW% * 2, 4096): newH% = _MIN(newH% * 2, 4096): dbl% = dbl% - 1: LOOP
        DO WHILE dbl% < 0: newW% = _MAX(newW% \ 2, 1): newH% = _MAX(newH% \ 2, 1): dbl% = dbl% + 1: LOOP
        newW% = ACTS_prm_lng&("W", newW%): newH% = ACTS_prm_lng&("H", newH%)
    END IF
    IF ACTS_dlg_silent% THEN ctx.done = TRUE: ctx.result = TRUE

    boxY%  = THEME.DIALOG_title_height% + 14
    boxH%  = 22 : boxW% = 80
    wBoxX% = 16
    hBoxX% = wBoxX% + boxW% + 20 ' gap holds the "x" separator
    mulW%  = 42
    x2X%   = hBoxX% + boxW% + 12
    d2X%   = x2X% + mulW% + 8
    btnW%  = 96 : btnH% = 22
    btnY%  = ctx.h - btnH% - 12
    okX%   = ctx.w - btnW% * 2 - 16
    cxX%   = ctx.w - btnW% - 10

    DO WHILE ctx.done = 0
        DIALOG_poll_mouse ctx
        k& = _KEYHIT
        IF k& = 13 THEN ctx.done = TRUE : ctx.result = TRUE
        IF k& = 27 THEN ctx.done = TRUE : ctx.result = FALSE

        IF DIALOG_hit%(ctx, wBoxX%, boxY%, boxW%, boxH%) THEN newW% = RESIZE_edit_value%(newW%, "Width"): typed% = TRUE
        IF DIALOG_hit%(ctx, hBoxX%, boxY%, boxW%, boxH%) THEN newH% = RESIZE_edit_value%(newH%, "Height"): typed% = TRUE
        IF DIALOG_hit%(ctx, x2X%, boxY%, mulW%, boxH%) THEN
            newW% = newW% * 2 : IF newW% > 4096 THEN newW% = 4096
            newH% = newH% * 2 : IF newH% > 4096 THEN newH% = 4096
            dbl% = dbl% + 1
        END IF
        IF DIALOG_hit%(ctx, d2X%, boxY%, mulW%, boxH%) THEN
            newW% = newW% \ 2 : IF newW% < 1 THEN newW% = 1
            newH% = newH% \ 2 : IF newH% < 1 THEN newH% = 1
            dbl% = dbl% - 1
        END IF
        IF DIALOG_hit%(ctx, okX%, btnY%, btnW%, btnH%) THEN ctx.done = TRUE : ctx.result = TRUE
        IF DIALOG_hit%(ctx, cxX%, btnY%, btnW%, btnH%) THEN ctx.done = TRUE : ctx.result = FALSE

        _DEST ctx.imgHandle
        DIALOG_draw_frame ctx, "RESIZE IMAGE WITH CONTENT"
        RESIZE_draw_field ctx, wBoxX%, boxY%, boxW%, boxH%, newW%
        DIALOG_draw_label ctx, hBoxX% - 14, boxY% + (boxH% - 12) \ 2 + 1, "X"
        RESIZE_draw_field ctx, hBoxX%, boxY%, boxW%, boxH%, newH%
        DIALOG_draw_button_role ctx, x2X%, boxY%, mulW%, boxH%, "X2", DLG_BTN_PLAIN
        DIALOG_draw_button_role ctx, d2X%, boxY%, mulW%, boxH%, "/2", DLG_BTN_PLAIN
        DIALOG_draw_label ctx, wBoxX%, boxY% + boxH% + 5, "WIDTH"
        DIALOG_draw_label ctx, hBoxX%, boxY% + boxH% + 5, "HEIGHT"
        DIALOG_draw_button_role ctx, okX%, btnY%, btnW%, btnH%, "OK", DLG_BTN_PRIMARY
        DIALOG_draw_button_role ctx, cxX%, btnY%, btnW%, btnH%, "CANCEL", DLG_BTN_CANCEL
        DIALOG_blit ctx
    LOOP

    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog FALSE

    ' an Actions step being recorded keeps the size (typed: W / H; X2 / /2 only: DOUBLE, so
    ' the action scales whatever image it is played on) - a cancel records nothing
    IF ctx.result THEN
        IF typed% _ORELSE dbl% = 0 THEN ACTS_prm_put "W", newW%: ACTS_prm_put "H", newH% ELSE ACTS_prm_put "DOUBLE", dbl%
    ELSE
        ACTS_dlg_cancel
    END IF

    IF ctx.result AND newW% >= 1 AND newH% >= 1 THEN CANVAS_resize_with_content newW%, newH%
    DIALOG_cleanup ctx
END SUB


''
' Begin crop mode: save previous tool, switch to MARQUEE tool.
' The Crop tool button starts with no box: the user drags the crop rectangle.
' Image > Crop (wholeImage) starts with the box on the whole image, to drag
' inward or outward, and zooms out first when any edge of the image is out of
' view - a box whose edges you can't see is no box (BUGS.md 2026-11-15).
' @param wholeImage INTEGER TRUE = box on the whole canvas
'
SUB CROP_begin (wholeImage AS INTEGER)
    IF CROP.STATE = CROP_STATE_ACTIVE THEN EXIT SUB
    ' The lightbox: a crop would cut the whole sheet to one region - every frame
    ' with it. Frames change size with the ANIM panel's RESIZE.
    IF ANIM_LB_showing% THEN STATUS_flash "Crop: not in the lightbox (it cuts the whole sheet) - change the frame size with ANIM > Resize, or turn the lightbox off": EXIT SUB

    CROP.PREV_TOOL = CURRENT_TOOL%
    CROP.STATE     = CROP_STATE_ACTIVE

    ' Switch to marquee tool — the marquee handles ALL box interaction
    CURRENT_TOOL%   = TOOL_MARQUEE
    MARQUEE.VARIANT = TOOL_SELECT_RECT ' Crop always uses rectangular marquee
    MARQUEE_reset                      ' Clear any existing selection

    IF wholeImage% THEN
        ' Pre-initialize marquee to the full canvas.
        ' User drags handles INWARD to crop, or OUTWARD past canvas edge to grow.
        MARQUEE.BOX.x        = 0
        MARQUEE.BOX.y        = 0
        MARQUEE.BOX.w        = SCRN.canvasW&
        MARQUEE.BOX.h        = SCRN.canvasH&
        MARQUEE.BOX.state    = MARQUEE_STATE_SELECTED
        MARQUEE.ACTIVE%      = TRUE
        MARQUEE.INITIALIZED% = TRUE
        MARQUEE.USER_CREATED = TRUE
        IF NOT CROP_canvas_in_view% THEN ZOOM_fit_canvas
    END IF
    DIM boxSeen AS INTEGER: boxSeen% = CROP_box_moved% ' the overlay's box as it starts

    INVALIDATE_scene

    _LOGINFO "CROP_begin: Crop mode started (using MARQUEE, whole image " + STR$(wholeImage%) + ")"
END SUB


''
' Is the whole canvas on screen, inside the canvas view?
'
FUNCTION CROP_canvas_in_view% ()
    DIM vpL AS INTEGER, vpT AS INTEGER, vpR AS INTEGER, vpB AS INTEGER
    ZOOM_viewport_rect vpL%, vpT%, vpR%, vpB%
    DIM zw AS LONG, zh AS LONG, cx AS LONG, cy AS LONG
    zw& = SCRN.canvasW& * SCRN.zoom!
    zh& = SCRN.canvasH& * SCRN.zoom!
    cx& = (SCRN.w& - zw&) \ 2 + SCRN.offsetX% + SCRN.panelShiftX%
    cy& = (SCRN.h& - zh&) \ 2 + SCRN.offsetY% + SCRN.panelShiftY%
    CROP_canvas_in_view% = (cx& >= vpL% _ANDALSO cy& >= vpT% _ANDALSO cx& + zw& - 1 <= vpR% _ANDALSO cy& + zh& - 1 <= vpB%)
END FUNCTION


''
' Has the crop box moved or resized since the last call? The crop overlay (the
' shade outside the box) is part of the cached scene: the main loop rebuilds
' it on a mouse move, but an arrow-key nudge moves the box without one - the
' shade stayed put until the mouse moved (BUGS.md 2026-11-15).
'
FUNCTION CROP_box_moved% ()
    STATIC lx AS INTEGER, ly AS INTEGER, lw AS INTEGER, lh AS INTEGER, la AS INTEGER
    DIM a AS INTEGER: a = (MARQUEE.ACTIVE% <> 0)
    IF MARQUEE.BOX.x <> lx _ORELSE MARQUEE.BOX.y <> ly _ORELSE MARQUEE.BOX.w <> lw _ORELSE MARQUEE.BOX.h <> lh _ORELSE a <> la THEN
        lx = MARQUEE.BOX.x: ly = MARQUEE.BOX.y: lw = MARQUEE.BOX.w: lh = MARQUEE.BOX.h: la = a
        CROP_box_moved% = TRUE
    END IF
END FUNCTION


''
' Trim the canvas to the artwork: the bounds of every visible layer's pixels
' (Crop tool double-click). Within the canvas only - it never grows it.
'
SUB CROP_trim_to_content ()
    DIM i AS INTEGER, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER
    DIM x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, found AS INTEGER
    x1% = SCRN.canvasW&: y1% = SCRN.canvasH&: x2% = -1: y2% = -1
    FOR i% = 1 TO MAX_LAYERS
        IF LAYERS(i%).imgHandle& < -1 _ANDALSO LAYERS(i%).visible% _ANDALSO LAYERS(i%).layerType% <> LAYER_TYPE_GROUP THEN
            LAYER_get_content_bounds i%, bx%, by%, bw%, bh%
            IF bw% > 0 _ANDALSO bh% > 0 THEN
                ' buffer -> canvas coords (gotcha #14), clamped to the canvas
                bx% = bx% - LAYERS(i%).apronW%: by% = by% - LAYERS(i%).apronH%
                IF bx% < 0 THEN bw% = bw% + bx%: bx% = 0
                IF by% < 0 THEN bh% = bh% + by%: by% = 0
                IF bx% + bw% > SCRN.canvasW& THEN bw% = SCRN.canvasW& - bx%
                IF by% + bh% > SCRN.canvasH& THEN bh% = SCRN.canvasH& - by%
                IF bw% > 0 _ANDALSO bh% > 0 THEN
                    found% = TRUE
                    IF bx% < x1% THEN x1% = bx%
                    IF by% < y1% THEN y1% = by%
                    IF bx% + bw% - 1 > x2% THEN x2% = bx% + bw% - 1
                    IF by% + bh% - 1 > y2% THEN y2% = by% + bh% - 1
                END IF
            END IF
        END IF
    NEXT i%
    IF NOT found% THEN
        CROP_cancel
        STATUS_flash "Trim: no artwork on the visible layers"
        EXIT SUB
    END IF
    IF x1% = 0 _ANDALSO y1% = 0 _ANDALSO x2% = SCRN.canvasW& - 1 _ANDALSO y2% = SCRN.canvasH& - 1 THEN
        CROP_cancel
        STATUS_flash "Trim: the artwork already fills the canvas"
        EXIT SUB
    END IF
    IF CROP.STATE <> CROP_STATE_ACTIVE THEN CROP_begin TRUE
    IF CROP.STATE <> CROP_STATE_ACTIVE THEN EXIT SUB ' refused (the lightbox)
    MARQUEE.BOX.x = x1%: MARQUEE.BOX.y = y1%
    MARQUEE.BOX.w = x2% - x1% + 1: MARQUEE.BOX.h = y2% - y1% + 1
    MARQUEE.ACTIVE% = TRUE: MARQUEE.INITIALIZED% = TRUE: MARQUEE.USER_CREATED = TRUE
    CROP_apply
    STATUS_flash "Trimmed to the artwork: " + _TRIM$(STR$(x2% - x1% + 1)) + "x" + _TRIM$(STR$(y2% - y1% + 1))
END SUB


''
' Cancel crop mode without applying.
'
SUB CROP_cancel ()
    IF CROP.STATE <> CROP_STATE_ACTIVE THEN EXIT SUB

    CROP.STATE = CROP_STATE_IDLE

    ' Clear the marquee selection
    MARQUEE_reset

    ' Restore previous tool
    IF CROP.PREV_TOOL > 0 THEN
        CURRENT_TOOL% = CROP.PREV_TOOL
    END IF

    INVALIDATE_scene

    _LOGINFO "CROP_cancel: Crop mode cancelled"
END SUB


''
' Apply the crop region: resize canvas to marquee box, offsetting content.
' Reads crop region from MARQUEE.BOX before resetting marquee.
'
SUB CROP_apply ()
    DIM AS INTEGER bx, by, bw, bh
    DIM isGrow AS INTEGER
    IF CROP.STATE <> CROP_STATE_ACTIVE THEN EXIT SUB ' CROP_begin refused (the lightbox)

    ' Read crop region from MARQUEE.BOX (before we reset it)
    bx% = MARQUEE.BOX.x
    by% = MARQUEE.BOX.y
    bw% = MARQUEE.BOX.w
    bh% = MARQUEE.BOX.h

    ' If no marquee selection was made, just cancel
    IF NOT MARQUEE.ACTIVE% THEN
        CROP_cancel
        EXIT SUB
    END IF

    ' Validate
    IF bw% < 1 OR bh% < 1 THEN
        CROP_cancel
        EXIT SUB
    END IF

    ' If crop region equals full canvas, nothing to do
    IF bx% = 0 AND by% = 0 AND bw% = SCRN.canvasW& AND bh% = SCRN.canvasH& THEN
        CROP_cancel
        EXIT SUB
    END IF

    ' Detect grow: any side of the crop box extends beyond the current canvas
    isGrow% = (bx% < 0) OR (by% < 0) OR (bx% + bw% > SCRN.canvasW&) OR (by% + bh% > SCRN.canvasH&)

    ' Record undo for every crop, shrink or grow (the old canvas and every
    ' layer's pixels, as Image -> Resize Canvas). The box's offset goes in the
    ' record's w/h with flags bit 2, so redo cuts the same region again
    ' (CROP_cut_canvas) rather than a top-left canvas resize.
    HISTORY_record_canvas_resize SCRN.canvasW&, SCRN.canvasH&, bw%, bh%, FALSE
    IF HISTORY_LAST_RECORD% > 0 THEN
        HISTORY_RECORDS(HISTORY_LAST_RECORD%).flags& = 2
        HISTORY_RECORDS(HISTORY_LAST_RECORD%).w%     = bx%
        HISTORY_RECORDS(HISTORY_LAST_RECORD%).h%     = by%
    END IF

    CROP_cut_canvas bx%, by%, bw%, bh%

    ' End crop mode
    CROP.STATE = CROP_STATE_IDLE

    ' Crop is done — switch to null tool (no active tool)
    CURRENT_TOOL% = TOOL_NULL

    IF isGrow% THEN
        _LOGINFO "CROP_apply: Grew canvas to " + STR$(bw%) + "x" + STR$(bh%) + " (box offset " + STR$(bx%) + "," + STR$(by%) + ")"
    ELSE
        _LOGINFO "CROP_apply: Cropped to " + STR$(bw%) + "x" + STR$(bh%) + " from (" + STR$(bx%) + "," + STR$(by%) + ")"
    END IF
END SUB


''
' Cuts the canvas to the region (bx, by, bw, bh) of the current canvas - every
' layer, the painting buffer, the grid (phase kept) and the view. The region may
' run past the canvas (a grow: the new area is transparent). No history: the
' caller records it (CROP_apply) or is replaying it (redo of a crop).
'
' @param bx INTEGER Region left in canvas pixels (negative = grow left)
' @param by INTEGER Region top
' @param bw INTEGER Region width = the new canvas width
' @param bh INTEGER Region height = the new canvas height
'
SUB CROP_cut_canvas (bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER)
    DIM i           AS INTEGER
    DIM oldDest     AS LONG
    DIM oldImg      AS LONG
    DIM newImg      AS LONG
    DIM oldGridXPos AS INTEGER, oldGridYPos AS INTEGER
    DIM cropModX    AS INTEGER, cropModY AS INTEGER
    DIM srcX1       AS INTEGER, srcY1 AS INTEGER, srcX2 AS INTEGER, srcY2 AS INTEGER
    DIM dstX1       AS INTEGER, dstY1 AS INTEGER, dstX2 AS INTEGER, dstY2 AS INTEGER
    IF bw% < 1 _ORELSE bh% < 1 THEN EXIT SUB

    oldGridXPos% = GRID.xPos%
    oldGridYPos% = GRID.yPos%

    ' Unified src/dst copy rects — works for both crop (positive bx/by)
    ' and grow (negative bx/by or extent > canvasW/H).
    srcX1% = 0             : IF bx% > 0 THEN srcX1% = bx%
    srcY1% = 0             : IF by% > 0 THEN srcY1% = by%
    srcX2% = bx% + bw% - 1 : IF srcX2% > SCRN.canvasW& - 1 THEN srcX2% = SCRN.canvasW& - 1
    srcY2% = by% + bh% - 1 : IF srcY2% > SCRN.canvasH& - 1 THEN srcY2% = SCRN.canvasH& - 1
    dstX1% = 0             : IF -bx% > 0 THEN dstX1% = -bx%
    dstY1% = 0             : IF -by% > 0 THEN dstY1% = -by%
    dstX2% = dstX1% + (srcX2% - srcX1%)
    dstY2% = dstY1% + (srcY2% - srcY1%)

    ' Cancel active tools and clear the marquee
    MARQUEE_reset
    IF IMG_IMPORT.STATE > IMPORT_STATE_IDLE THEN IMAGE_IMPORT_cancel
    IF CUSTOM_BRUSH_is_active% THEN CUSTOM_BRUSH_reset
    MOVE_init
    MAGIC_WAND_reset

    ' APRON: demote all extended layers so subsequent (srcX1..srcX2) reads
    ' index canvas-region pixels and not apron-corner pixels.
    LAYERS_demote_all

    ' Update canvas dimensions
    SCRN.canvasW& = bw%
    SCRN.canvasH& = bh%
    SCREEN_pattern_tile_force_off

    ' Recreate PAINTING buffer
    SAFE_FREEIMAGE SCRN.PAINTING&
    SCRN.PAINTING& = _NEWIMAGE(bw%, bh%, 32)
    oldDest&       = _DEST
    _DEST SCRN.PAINTING&
    CLS , _RGBA32(0, 0, 0, 0)
    _DEST oldDest&

    ' Crop each layer: copy region (bx, by, bw, bh) to new image at (0,0)
    FOR i% = 1 TO MAX_LAYERS
        IF LAYERS(i%).imgHandle& < -1 THEN
            oldImg&  = LAYERS(i%).imgHandle&
            newImg&  = _NEWIMAGE(bw%, bh%, 32)
            oldDest& = _DEST
            _DEST newImg&
            CLS , _RGBA32(0, 0, 0, 0)
            ' Copy using unified src/dst rects — handles both crop (bx>0) and grow (bx<0)
            IF srcX2% >= srcX1% AND srcY2% >= srcY1% THEN
                _DONTBLEND newImg& ' (raw copy: a blend onto the fresh image greys soft / AA pixels - memory qb64-blend-onto-transparent-greys)
                _PUTIMAGE (dstX1%, dstY1%)-(dstX2%, dstY2%), oldImg&, newImg&, (srcX1%, srcY1%)-(srcX2%, srcY2%)
                _BLEND newImg&
            END IF
            _DEST oldDest&
            SAFE_FREEIMAGE oldImg&
            LAYERS(i%).imgHandle&    = newImg&
            LAYERS(i%).imgWidth%     = bw%
            LAYERS(i%).imgHeight%    = bh%
            LAYERS(i%).contentDirty% = TRUE
        END IF
        ' Free opacity cache
        SAFE_FREEIMAGE LAYERS(i%).opacityCacheImg& : LAYERS(i%).opacityCacheImg& = 0
        LAYERS(i%).opacityCacheVal% = 0
    NEXT i%

    ' Free render caches
    SAFE_FREEIMAGE SCENE_CACHE&           : SCENE_CACHE& = 0
    SAFE_FREEIMAGE PG_CACHE_IMG&          : PG_CACHE_IMG& = 0
    SAFE_FREEIMAGE COMPOSITE_BUFFER&      : COMPOSITE_BUFFER& = 0
    SAFE_FREEIMAGE COMPOSITE_BELOW_CACHE& : COMPOSITE_BELOW_CACHE& = 0
    COMPOSITE_BELOW_VALID% = FALSE

    ' Free scale originals
    SAFE_FREEIMAGE SCALE_ORIGINAL_IMAGE
    SCALE_ORIGINAL_IMAGE = 0
    SCALE_ORIGINAL_LAYER = 0
    SCALE_FACTOR_LAYER   = 1.0
    SAFE_FREEIMAGE MOVE.ORIGINAL_IMAGE
    MOVE.ORIGINAL_IMAGE = 0

    ' Reset zoom/pan to fit
    IF bw% <= SCRN.w& AND bh% <= SCRN.h& THEN
        SCRN.zoom! = 1.0
    ELSE
        DIM fitZW AS SINGLE, fitZH AS SINGLE
        fitZW! = SCRN.w& / bw%
        fitZH! = SCRN.h& / bh%
        IF fitZW! < fitZH! THEN SCRN.zoom! = fitZW! ELSE SCRN.zoom! = fitZH!
    END IF
    SCRN.offsetX% = 0
    SCRN.offsetY% = 0
    SCRN.panning% = FALSE

    ' Recalculate symmetry center
    SYMMETRY.CENTER_X% = bw% \ 2
    SYMMETRY.CENTER_Y% = bh% \ 2

    ' Recreate grid image for new canvas size and remap phase by crop offset
    SAFE_FREEIMAGE GRID.imgHandle&
    GRID.imgWidth%  = bw%
    GRID.imgHeight% = bh%
    GRID.imgHandle& = _NEWIMAGE(bw%, bh%, 32)

    IF GRID.gridWidth% > 0 THEN
        cropModX%  = bx% MOD GRID.gridWidth%
        GRID.xPos% = oldGridXPos% - cropModX%
        DO WHILE GRID.xPos% < 0
            GRID.xPos% = GRID.xPos% + GRID.gridWidth%
        LOOP
        DO WHILE GRID.xPos% >= GRID.gridWidth%
            GRID.xPos% = GRID.xPos% - GRID.gridWidth%
        LOOP
    END IF

    IF GRID.gridHeight% > 0 THEN
        cropModY%  = by% MOD GRID.gridHeight%
        GRID.yPos% = oldGridYPos% - cropModY%
        DO WHILE GRID.yPos% < 0
            GRID.yPos% = GRID.yPos% + GRID.gridHeight%
        LOOP
        DO WHILE GRID.yPos% >= GRID.gridHeight%
            GRID.yPos% = GRID.yPos% - GRID.gridHeight%
        LOOP
    END IF

    ' Redraw grid
    GRID_draw

    ' Mark dirty
    CANVAS_DIRTY% = TRUE
    BLEND_invalidate_cache
    SCENE_DIRTY%        = TRUE
    RENDER_ORDER_DIRTY% = TRUE
    GUI_NEEDS_REDRAW%   = TRUE
    FRAME_IDLE%         = FALSE
END SUB


''
' Render crop overlay onto destination image.
' Draws dark overlay outside the marquee region and a size label.
' The marquee tool handles drawing the marching ants and handles.
'
' @param dest LONG Destination image handle (usually SCRN.CANVAS&)
'
SUB CROP_render (dest AS LONG)
    DIM AS INTEGER bx, by, bw, bh
    DIM AS INTEGER sx1, sy1, sx2, sy2
    DIM AS INTEGER cw, ch
    DIM oldDest AS LONG
    DIM darkClr AS _UNSIGNED LONG

    IF CROP.STATE <> CROP_STATE_ACTIVE THEN EXIT SUB

    ' Only draw overlay if the marquee has an active selection
    IF NOT MARQUEE.ACTIVE% THEN EXIT SUB

    oldDest& = _DEST
    _DEST dest&

    ' Read crop region from MARQUEE.BOX
    bx% = MARQUEE.BOX.x : by% = MARQUEE.BOX.y
    bw% = MARQUEE.BOX.w : bh% = MARQUEE.BOX.h
    cw% = SCRN.canvasW& : ch% = SCRN.canvasH&

    IF bw% < 1 OR bh% < 1 THEN
        _DEST oldDest&
        EXIT SUB
    END IF

    ' Calculate canvas-to-screen offset (centering + pan)
    DIM AS LONG czw, czh
    DIM AS INTEGER cdx, cdy
    czw& = cw% * SCRN.zoom!
    czh& = ch% * SCRN.zoom!
    cdx% = (SCRN.w& - czw&) \ 2 + SCRN.offsetX% + SCRN.panelShiftX%
    cdy% = (SCRN.h& - czh&) \ 2 + SCRN.offsetY% + SCRN.panelShiftY%

    ' Transform crop box to screen coordinates
    sx1% = INT(bx% * SCRN.zoom!) + cdx%
    sy1% = INT(by% * SCRN.zoom!) + cdy%
    sx2% = INT((bx% + bw%) * SCRN.zoom!) + cdx% - 1
    sy2% = INT((by% + bh%) * SCRN.zoom!) + cdy% - 1

    darkClr~& = _RGBA32(0, 0, 0, 128)

    ' Darken outside crop region (4 rectangles around the crop box)
    DIM canvasSX1 AS INTEGER, canvasSY1 AS INTEGER
    DIM canvasSX2 AS INTEGER, canvasSY2 AS INTEGER
    canvasSX1% = cdx%
    canvasSY1% = cdy%
    canvasSX2% = cdx% + czw& - 1
    canvasSY2% = cdy% + czh& - 1

    ' Top strip
    IF sy1% > canvasSY1% THEN
        LINE (canvasSX1%, canvasSY1%)-(canvasSX2%, sy1% - 1), darkClr~&, BF
    END IF
    ' Bottom strip
    IF sy2% < canvasSY2% THEN
        LINE (canvasSX1%, sy2% + 1)-(canvasSX2%, canvasSY2%), darkClr~&, BF
    END IF
    ' Left strip
    IF sx1% > canvasSX1% THEN
        LINE (canvasSX1%, sy1%)-(sx1% - 1, sy2%), darkClr~&, BF
    END IF
    ' Right strip
    IF sx2% < canvasSX2% THEN
        LINE (sx2% + 1, sy1%)-(canvasSX2%, sy2%), darkClr~&, BF
    END IF

    ' Draw size label above crop boundary
    DIM sizeLabel AS STRING
    DIM midX      AS INTEGER
    midX%      = (sx1% + sx2%) \ 2
    sizeLabel$ = _TRIM$(STR$(bw%)) + "X" + _TRIM$(STR$(bh%))
    DIM labelX    AS INTEGER, labelY AS INTEGER
    labelX% = midX% - (LEN(sizeLabel$) * 4)
    labelY% = sy1% - 12
    IF labelY% < 0 THEN labelY% = sy2% + 4
    COLOR _RGB32(255, 255, 255), _RGBA32(0, 0, 0, 180)
    _PRINTSTRING (labelX%, labelY%), sizeLabel$

    COLOR , _RGBA32(0, 0, 0, 0) ' Reset background color

    _DEST oldDest&
END SUB
