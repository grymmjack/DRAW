''
' DRAW - TOOLS/ANIM.BM
' =============================================================================
' Animation frame math (see ANIM.BI). Touches only ANIM, ANIM_HOLDS and the
' canvas size (SCRN.canvasW& / canvasH&), so QA/unit/anim-unit.bas can test
' it headless.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' No frames: a plain picture. Every document path calls this (new, open,
' new from clipboard / AI, Aseprite, PSD, plain PNG) - CLAUDE.md gotcha 15.
SUB ANIM_reset ()
    DIM i AS INTEGER
    ANIM.active = FALSE
    ANIM.frameW = 0: ANIM.frameH = 0
    ANIM.gutter = 0: ANIM.margin = 0
    ANIM.count = 0: ANIM.current = 0: ANIM.wanted = 0
    ANIM.fps = ANIM_FPS_DEFAULT
    ANIM.loopMode = ANIM_LOOP_FWD
    ANIM_SIZE_MODE = ANIM_SIZE_ASK
    ANIM_PLAY.playing = FALSE
    FOR i = 1 TO ANIM_MAX_FRAMES: ANIM_HOLDS(i) = 0: ANIM_SEL(i) = FALSE: NEXT i
    ANIM_SEL_ANCHOR = 0: ANIM_MOVE_TO = 0: ANIM_COUNT_TO = 0
END SUB


''
' Cells across / down the canvas for the current layout (0 when frames are off
' or not even one cell fits).
FUNCTION ANIM_cols% ()
    IF ANIM.active = FALSE _ORELSE ANIM.frameW < 1 THEN EXIT FUNCTION
    ANIM_cols% = ANIM_fit%(SCRN.canvasW&, ANIM.frameW, ANIM.gutter, ANIM.margin)
END FUNCTION

FUNCTION ANIM_rows% ()
    IF ANIM.active = FALSE _ORELSE ANIM.frameH < 1 THEN EXIT FUNCTION
    ANIM_rows% = ANIM_fit%(SCRN.canvasH&, ANIM.frameH, ANIM.gutter, ANIM.margin)
END FUNCTION

''
' How many cells of size `cell` fit along `span` with `gutter` between them and
' `margin` at both ends.
FUNCTION ANIM_fit% (span AS LONG, cell AS INTEGER, gutter AS INTEGER, margin AS INTEGER)
    DIM room AS LONG
    IF cell < 1 THEN EXIT FUNCTION
    room = span - 2 * margin + gutter
    IF room < cell + gutter THEN EXIT FUNCTION
    ANIM_fit% = room \ (cell + gutter)
END FUNCTION

FUNCTION ANIM_cells% ()
    DIM n AS LONG
    n = CLNG(ANIM_cols%) * ANIM_rows%
    IF n > ANIM_MAX_FRAMES THEN n = ANIM_MAX_FRAMES
    ANIM_cells% = n
END FUNCTION


''
' Frame n's cell on the canvas. FALSE (x/y/w/h untouched) when n has no cell.
FUNCTION ANIM_cell_rect% (n AS INTEGER, x AS LONG, y AS LONG, w AS LONG, h AS LONG)
    IF n < 1 _ORELSE n > ANIM_cells% THEN EXIT FUNCTION
    ANIM_rect_at n, ANIM_cols%, ANIM.frameW, ANIM.frameH, ANIM.gutter, ANIM.margin, x, y
    w = ANIM.frameW: h = ANIM.frameH
    ANIM_cell_rect% = TRUE
END FUNCTION

''
' Top left of cell n in a layout of cols columns (any layout, not just the
' current one: resizing frames reads the old cells).
SUB ANIM_rect_at (n AS INTEGER, cols AS INTEGER, fw AS INTEGER, fh AS INTEGER, gutter AS INTEGER, margin AS INTEGER, x AS LONG, y AS LONG)
    IF cols < 1 THEN x = margin: y = margin: EXIT SUB
    x = margin + ((n - 1) MOD cols) * (CLNG(fw) + gutter)
    y = margin + ((n - 1) \ cols) * (CLNG(fh) + gutter)
END SUB

''
' Length of `cells` cells of size `cell` with `gutter` between and `margin`
' at both ends.
FUNCTION ANIM_span& (cells AS LONG, cell AS LONG, gutter AS LONG, margin AS LONG)
    IF cells < 1 THEN ANIM_span& = 2 * margin: EXIT FUNCTION
    ANIM_span& = 2 * margin + cells * cell + (cells - 1) * gutter
END FUNCTION

''
' The frame whose cell holds canvas pixel (cx, cy); 0 for the margin, a
' gutter, past the cells or past the last frame.
FUNCTION ANIM_frame_at% (cx AS LONG, cy AS LONG)
    DIM cols AS INTEGER, rows AS INTEGER, c AS LONG, r AS LONG, n AS LONG
    cols = ANIM_cols%: rows = ANIM_rows%
    IF cols < 1 _ORELSE rows < 1 THEN EXIT FUNCTION
    IF cx < ANIM.margin _ORELSE cy < ANIM.margin THEN EXIT FUNCTION
    c = (cx - ANIM.margin) \ (ANIM.frameW + ANIM.gutter)
    r = (cy - ANIM.margin) \ (ANIM.frameH + ANIM.gutter)
    IF c >= cols _ORELSE r >= rows THEN EXIT FUNCTION
    IF (cx - ANIM.margin) MOD (ANIM.frameW + ANIM.gutter) >= ANIM.frameW THEN EXIT FUNCTION ' a gutter
    IF (cy - ANIM.margin) MOD (ANIM.frameH + ANIM.gutter) >= ANIM.frameH THEN EXIT FUNCTION
    n = r * cols + c + 1
    IF n > ANIM.count THEN EXIT FUNCTION
    ANIM_frame_at% = n
END FUNCTION


''
' Set the frame layout over the current canvas. Re-slices: pixels stay put, the
' grid moves (resizing frames on a drawn sheet asks first - the caller's job).
' count is the wanted count while it fits, else the cells there are (the
' frames past them come back when a later layout fits them: stepping the
' frame size through a smaller layout loses nothing); a layout with no room
' for a cell turns frames off. Returns ANIM.active.
FUNCTION ANIM_set_layout% (fw AS INTEGER, fh AS INTEGER, gutter AS INTEGER, margin AS INTEGER)
    DIM wasOn AS INTEGER, cells AS INTEGER
    wasOn = ANIM.active
    IF gutter < 0 THEN gutter = 0
    IF margin < 0 THEN margin = 0
    ANIM.frameW = fw: ANIM.frameH = fh: ANIM.gutter = gutter: ANIM.margin = margin
    ANIM.active = (fw > 0 _ANDALSO fh > 0)
    cells = ANIM_cells%
    IF cells < 1 THEN
        ANIM.active = FALSE: ANIM.count = 0: ANIM.current = 0
    ELSE
        IF wasOn = FALSE _ORELSE ANIM.wanted < 1 THEN ANIM.wanted = cells
        ANIM.count = _MIN(ANIM.wanted, cells)
        ANIM_clamp_current
    END IF
    ANIM_set_layout% = ANIM.active
END FUNCTION

''
' Keep the current frame inside 1..count.
SUB ANIM_clamp_current ()
    IF ANIM.active = FALSE _ORELSE ANIM.count < 1 THEN ANIM.current = 0: EXIT SUB
    IF ANIM.current < 1 THEN ANIM.current = 1
    IF ANIM.current > ANIM.count THEN ANIM.current = ANIM.count
END SUB


''
' Ticks (at ANIM.fps) frame n stays up: its hold, at least 1.
FUNCTION ANIM_hold% (n AS INTEGER)
    DIM h AS INTEGER
    IF n < 1 _ORELSE n > ANIM_MAX_FRAMES THEN ANIM_hold% = 1: EXIT FUNCTION
    h = ANIM_HOLDS(n)
    IF h < 1 THEN h = 1
    IF h > ANIM_HOLD_MAX THEN h = ANIM_HOLD_MAX
    ANIM_hold% = h
END FUNCTION

SUB ANIM_set_hold (n AS INTEGER, h AS INTEGER)
    IF n < 1 _ORELSE n > ANIM_MAX_FRAMES THEN EXIT SUB
    IF h < 1 THEN h = 1
    IF h > ANIM_HOLD_MAX THEN h = ANIM_HOLD_MAX
    ANIM_HOLDS(n) = h
END SUB

SUB ANIM_set_fps (fps AS INTEGER)
    IF fps < 1 THEN fps = 1
    IF fps > ANIM_FPS_MAX THEN fps = ANIM_FPS_MAX
    ANIM.fps = fps
END SUB


''
' Go to frame n (clamped). TRUE when the current frame changed.
FUNCTION ANIM_go% (n AS INTEGER)
    DIM was AS INTEGER
    IF ANIM.active = FALSE _ORELSE ANIM.count < 1 THEN EXIT FUNCTION
    was = ANIM.current
    ANIM.current = n
    ANIM_clamp_current
    ANIM_go% = (ANIM.current <> was)
END FUNCTION

''
' Step d frames from the current one, wrapping round the ends (the frame
' keys: next / previous). TRUE when the current frame changed.
FUNCTION ANIM_step% (d AS INTEGER)
    DIM n AS LONG
    IF ANIM.active = FALSE _ORELSE ANIM.count < 1 THEN EXIT FUNCTION
    n = ((CLNG(ANIM.current) - 1 + d) MOD ANIM.count + ANIM.count) MOD ANIM.count + 1
    ANIM_step% = ANIM_go%(n)
END FUNCTION


''
' The animation data saved beside the pixels, in its own PNG chunk ("drAn",
' DRW_embed_chunk_in_png) so a DRAW without animation opens the sheet as a
' plain picture. "" when the document has no frames. Little-endian INTEGERs:
'   version, frameW, frameH, gutter, margin, count, current, fps, loopMode,
'   nHolds, then nHolds holds (frames 1..nHolds; the rest hold 1).
' Newer versions append fields; a reader takes the ones it knows.
FUNCTION ANIM_serialize$ ()
    DIM s AS STRING, n AS INTEGER, i AS INTEGER
    IF ANIM.active = FALSE THEN EXIT FUNCTION
    FOR i = ANIM.count TO 1 STEP -1 ' holds past the last real one are all 1
        IF ANIM_hold%(i) > 1 THEN n = i: EXIT FOR
    NEXT i
    s = MKI$(ANIM_CHUNK_VERSION) + MKI$(ANIM.frameW) + MKI$(ANIM.frameH) + MKI$(ANIM.gutter) + MKI$(ANIM.margin)
    s = s + MKI$(ANIM.count) + MKI$(ANIM.current) + MKI$(ANIM.fps) + MKI$(ANIM.loopMode) + MKI$(n)
    FOR i = 1 TO n: s = s + MKI$(ANIM_hold%(i)): NEXT i
    ANIM_serialize$ = s
END FUNCTION

''
' Load ANIM_serialize$ data over the current canvas (its size must already be
' set). Bad or unfitting data leaves the document without frames. Returns
' ANIM.active.
FUNCTION ANIM_deserialize% (blob AS STRING)
    DIM v AS INTEGER, n AS INTEGER, i AS INTEGER, cnt AS INTEGER, cur AS INTEGER, r AS INTEGER, sm AS INTEGER
    sm = ANIM_SIZE_MODE: ANIM_reset: ANIM_SIZE_MODE = sm ' undo / redo restore this; the answer is the document's
    IF LEN(blob) < 20 THEN EXIT FUNCTION
    v = CVI(MID$(blob, 1, 2))
    IF v < 1 THEN EXIT FUNCTION
    r = ANIM_set_layout%(CVI(MID$(blob, 3, 2)), CVI(MID$(blob, 5, 2)), CVI(MID$(blob, 7, 2)), CVI(MID$(blob, 9, 2)))
    IF r = FALSE THEN EXIT FUNCTION
    cnt = CVI(MID$(blob, 11, 2)): cur = CVI(MID$(blob, 13, 2))
    IF cnt >= 1 _ANDALSO cnt <= ANIM_cells% THEN ANIM.count = cnt: ANIM.wanted = cnt
    ANIM.current = cur: ANIM_clamp_current
    ANIM_set_fps CVI(MID$(blob, 15, 2))
    i = CVI(MID$(blob, 17, 2))
    IF i >= ANIM_LOOP_FWD _ANDALSO i <= ANIM_LOOP_ONCE THEN ANIM.loopMode = i
    n = CVI(MID$(blob, 19, 2))
    IF n > ANIM_MAX_FRAMES THEN n = ANIM_MAX_FRAMES
    FOR i = 1 TO n
        IF 20 + 2 * i > LEN(blob) THEN EXIT FOR ' truncated: keep what is there
        ANIM_set_hold i, CVI(MID$(blob, 19 + 2 * i, 2))
    NEXT i
    ANIM_deserialize% = ANIM.active
END FUNCTION

''
' Plan frame operation op (ANIM_OP_*) on the current frames: fills ANIM_SRC(1
' TO newCount) - new frame n shows old frame ANIM_SRC(n), 0 = blank - and the
' new count and current frame. Touches nothing else. 0 when the op can't run;
' else TRUE (ANIM_op_refusal$ says why not).
FUNCTION ANIM_plan% (op AS INTEGER, newCount AS INTEGER, newCur AS INTEGER)
    DIM n AS INTEGER, c AS INTEGER, i AS INTEGER, k AS INTEGER, moved AS INTEGER
    n = ANIM.count: c = ANIM.current
    IF ANIM.active = FALSE _ORELSE n < 1 THEN EXIT FUNCTION ' a plain picture: ANIM-OPS makes it frame 1 first
    IF ANIM_op_refusal$(op) <> "" THEN EXIT FUNCTION
    FOR i = 1 TO n: ANIM_SRC(i) = i: NEXT i
    newCount = n: newCur = c
    SELECT CASE op
        CASE ANIM_OP_APPEND, ANIM_OP_APPEND_BLANK
            newCount = n + 1: newCur = n + 1
            IF op = ANIM_OP_APPEND THEN ANIM_SRC(n + 1) = n ELSE ANIM_SRC(n + 1) = 0
        CASE ANIM_OP_INSERT_BEFORE, ANIM_OP_INSERT_AFTER, ANIM_OP_DUPLICATE
            newCur = c + 1: IF op = ANIM_OP_INSERT_BEFORE THEN newCur = c
            newCount = n + 1
            FOR i = newCount TO newCur + 1 STEP -1: ANIM_SRC(i) = i - 1: NEXT i
            IF op = ANIM_OP_DUPLICATE THEN ANIM_SRC(newCur) = c ELSE ANIM_SRC(newCur) = 0
        CASE ANIM_OP_DELETE
            newCount = n - 1
            FOR i = c TO newCount: ANIM_SRC(i) = i + 1: NEXT i
            IF newCur > newCount THEN newCur = newCount
        CASE ANIM_OP_EARLIER
            ANIM_SRC(c - 1) = c: ANIM_SRC(c) = c - 1: newCur = c - 1
        CASE ANIM_OP_LATER
            ANIM_SRC(c + 1) = c: ANIM_SRC(c) = c + 1: newCur = c + 1
        CASE ANIM_OP_REVERSE
            FOR i = 1 TO n: ANIM_SRC(i) = n + 1 - i: NEXT i
            newCur = n + 1 - c
        CASE ANIM_OP_MOVE_SEL
            ' the unselected frames before the drop point, the selected ones, the rest
            k = 0
            FOR i = 1 TO _MIN(ANIM_MOVE_TO - 1, n)
                IF ANIM_SEL_is%(i) = 0 THEN k = k + 1: ANIM_SRC(k) = i
            NEXT i
            FOR i = 1 TO n
                IF ANIM_SEL_is%(i) THEN k = k + 1: ANIM_SRC(k) = i
            NEXT i
            FOR i = _MAX(ANIM_MOVE_TO, 1) TO n
                IF ANIM_SEL_is%(i) = 0 THEN k = k + 1: ANIM_SRC(k) = i
            NEXT i
            FOR i = 1 TO n
                IF ANIM_SRC(i) <> i THEN moved = TRUE
                IF ANIM_SRC(i) = c THEN newCur = i
            NEXT i
            IF moved = 0 THEN EXIT FUNCTION ' dropped where they already are
        CASE ANIM_OP_SET_COUNT
            IF ANIM_COUNT_TO = n THEN EXIT FUNCTION ' no change
            newCount = ANIM_COUNT_TO
            FOR i = n + 1 TO newCount: ANIM_SRC(i) = 0: NEXT i
            IF newCur > newCount THEN newCur = newCount
    END SELECT
    ANIM_plan% = TRUE
END FUNCTION

''
' Why frame operation op can't run on the current frames ("" = it can).
FUNCTION ANIM_op_refusal$ (op AS INTEGER)
    DIM n AS INTEGER, c AS INTEGER, r AS STRING
    n = ANIM.count: c = ANIM.current
    IF ANIM.active = FALSE _ORELSE n < 1 THEN
        ' add on a plain picture: it becomes frame 1, frame 2 goes beside it (R-08)
        SELECT CASE op
            CASE ANIM_OP_APPEND, ANIM_OP_APPEND_BLANK
                IF 2 * SCRN.canvasW& > ANIM_SHEET_MAX THEN r = "The picture is too wide for a frame beside it"
            CASE ELSE
                r = "This picture has no frames - add one (Num +) or set a frame size"
        END SELECT
    ELSE
        SELECT CASE op
            CASE ANIM_OP_APPEND, ANIM_OP_APPEND_BLANK, ANIM_OP_INSERT_BEFORE, ANIM_OP_INSERT_AFTER, ANIM_OP_DUPLICATE
                IF n >= ANIM_MAX_FRAMES THEN r = "No room for more frames (" + _TRIM$(STR$(ANIM_MAX_FRAMES)) + " at most)"
                IF r = "" _ANDALSO ANIM_sheet_h&(n + 1) > ANIM_SHEET_MAX THEN r = "The sheet can't grow taller"
            CASE ANIM_OP_DELETE
                IF n < 2 THEN r = "The only frame can't be deleted"
            CASE ANIM_OP_EARLIER
                IF c < 2 THEN r = "This is the first frame"
            CASE ANIM_OP_LATER
                IF c >= n THEN r = "This is the last frame"
            CASE ANIM_OP_REVERSE
                IF n < 2 THEN r = "One frame: nothing to reverse"
            CASE ANIM_OP_SET_COUNT
                IF ANIM_COUNT_TO < 1 THEN r = "At least one frame"
                IF ANIM_COUNT_TO > ANIM_MAX_FRAMES THEN r = "No room for more frames (" + _TRIM$(STR$(ANIM_MAX_FRAMES)) + " at most)"
                IF r = "" _ANDALSO ANIM_COUNT_TO > n _ANDALSO ANIM_sheet_h&(ANIM_COUNT_TO) > ANIM_SHEET_MAX THEN r = "The sheet can't grow that tall"
            CASE ANIM_OP_MOVE_SEL
                IF n < 2 THEN r = "One frame: nowhere to move it"
                IF ANIM_MOVE_TO < 1 _ORELSE ANIM_MOVE_TO > n + 1 THEN r = "Drop the frames between two frames"
            CASE ELSE
                r = "Unknown frame operation"
        END SELECT
    END IF
    ANIM_op_refusal$ = r
END FUNCTION

''
' Canvas height that holds `frames` frames in the current columns: the
' current height, or taller by whole rows (adding past the last cell grows
' the sheet - R-03).
FUNCTION ANIM_sheet_h& (frames AS INTEGER)
    DIM cols AS LONG, rows AS LONG, h AS LONG
    cols = ANIM_cols%
    IF cols < 1 THEN ANIM_sheet_h& = SCRN.canvasH&: EXIT FUNCTION
    rows = (frames + cols - 1) \ cols
    h = ANIM_span&(rows, ANIM.frameH, ANIM.gutter, ANIM.margin)
    IF h < SCRN.canvasH& THEN h = SCRN.canvasH&
    ANIM_sheet_h& = h
END FUNCTION

''
' After ANIM_plan% (and the sheet grown to ANIM_sheet_h&(newCount)): the holds
' follow their frames, a blank frame holds 1, and the count / current move.
SUB ANIM_apply_plan (newCount AS INTEGER, newCur AS INTEGER)
    DIM i AS INTEGER, old(1 TO ANIM_MAX_FRAMES) AS INTEGER, top AS INTEGER
    top = _MAX(ANIM.count, newCount)
    FOR i = 1 TO top: old(i) = ANIM_HOLDS(i): NEXT i
    FOR i = 1 TO top
        ANIM_HOLDS(i) = 0
        IF i <= newCount _ANDALSO ANIM_SRC(i) > 0 THEN ANIM_HOLDS(i) = old(ANIM_SRC(i))
    NEXT i
    ' the selection goes with its frames (a new frame is not selected)
    FOR i = 1 TO top: old(i) = ANIM_SEL(i): NEXT i
    FOR i = 1 TO top
        ANIM_SEL(i) = FALSE
        IF i <= newCount _ANDALSO ANIM_SRC(i) > 0 THEN ANIM_SEL(i) = old(ANIM_SRC(i))
    NEXT i
    ANIM.wanted = newCount
    ANIM.count = _MIN(newCount, ANIM_cells%)
    ANIM.current = newCur
    ANIM_clamp_current
END SUB


''
' Start playing frames fromF..toF (0, 0 = all) at time t (TIMER). FALSE when
' there is nothing to play (no frames, or one).
FUNCTION ANIM_play_start% (fromF AS INTEGER, toF AS INTEGER, t AS DOUBLE)
    IF ANIM.active = FALSE _ORELSE ANIM.count < 2 THEN EXIT FUNCTION
    IF fromF < 1 _ORELSE toF < 1 _ORELSE fromF >= toF THEN fromF = 1: toF = ANIM.count
    IF toF > ANIM.count THEN toF = ANIM.count
    ANIM_PLAY.fromF = fromF: ANIM_PLAY.toF = toF
    ANIM_PLAY.dir = _IIF(ANIM.loopMode = ANIM_LOOP_REV, -1, 1)
    IF ANIM.current < fromF _ORELSE ANIM.current > toF THEN ANIM.current = fromF
    IF ANIM.loopMode = ANIM_LOOP_ONCE _ANDALSO ANIM.current = toF THEN ANIM.current = fromF ' play once again from the top
    ANIM_PLAY.nextT = t + ANIM_hold%(ANIM.current) / ANIM.fps
    ANIM_PLAY.playing = TRUE
    ANIM_play_start% = TRUE
END FUNCTION

SUB ANIM_play_stop ()
    ANIM_PLAY.playing = FALSE
END SUB

''
' The frame after the current one in this loop mode (the range and ping-pong
' direction in ANIM_PLAY); 0 = stop (play once reached the end).
FUNCTION ANIM_play_next% ()
    DIM c AS INTEGER, a AS INTEGER, b AS INTEGER
    c = ANIM.current: a = ANIM_PLAY.fromF: b = _MIN(ANIM_PLAY.toF, ANIM.count)
    IF b <= a THEN EXIT FUNCTION
    SELECT CASE ANIM.loopMode
        CASE ANIM_LOOP_REV
            IF c <= a THEN ANIM_play_next% = b ELSE ANIM_play_next% = c - 1
        CASE ANIM_LOOP_PING
            IF ANIM_PLAY.dir >= 0 THEN
                IF c >= b THEN ANIM_PLAY.dir = -1: ANIM_play_next% = c - 1 ELSE ANIM_play_next% = c + 1
            ELSE
                IF c <= a THEN ANIM_PLAY.dir = 1: ANIM_play_next% = c + 1 ELSE ANIM_play_next% = c - 1
            END IF
        CASE ANIM_LOOP_ONCE
            IF c < b THEN ANIM_play_next% = c + 1
        CASE ELSE
            IF c >= b THEN ANIM_play_next% = a ELSE ANIM_play_next% = c + 1
    END SELECT
END FUNCTION

''
' Advance playback to time t: TRUE when the current frame changed. Catches up
' at most a few frames a call (a slow frame skips, it does not race), and
' stops at the end of play once.
FUNCTION ANIM_play_advance% (t AS DOUBLE)
    DIM n AS INTEGER, steps AS INTEGER
    IF ANIM_PLAY.playing = FALSE THEN EXIT FUNCTION
    IF ANIM.active = FALSE _ORELSE ANIM.count < 2 THEN ANIM_PLAY.playing = FALSE: EXIT FUNCTION
    IF ANIM_PLAY.nextT - t > 60 THEN ANIM_PLAY.nextT = t ' TIMER wrapped at midnight
    DO WHILE t >= ANIM_PLAY.nextT _ANDALSO steps < 4
        n = ANIM_play_next%
        IF n = 0 THEN ANIM_PLAY.playing = FALSE: EXIT DO
        ANIM.current = n: steps = steps + 1
        ANIM_PLAY.nextT = ANIM_PLAY.nextT + ANIM_hold%(n) / ANIM.fps
    LOOP
    IF ANIM_PLAY.playing _ANDALSO ANIM_PLAY.nextT < t THEN ANIM_PLAY.nextT = t + ANIM_hold%(ANIM.current) / ANIM.fps ' fell behind: no burst
    ANIM_play_advance% = (steps > 0)
END FUNCTION


' ---------------------------------------------------------------------------
' The strip selection (2.3)
' ---------------------------------------------------------------------------

''
' Is frame f in the selection? With nothing selected the current frame is.
FUNCTION ANIM_SEL_is% (f AS INTEGER)
    IF f < 1 _ORELSE f > ANIM.count THEN EXIT FUNCTION
    IF ANIM_SEL_count% = 0 THEN ANIM_SEL_is% = (f = ANIM.current): EXIT FUNCTION
    ANIM_SEL_is% = (ANIM_SEL(f) <> 0)
END FUNCTION

''
' Frames selected (0 = only the current frame counts).
FUNCTION ANIM_SEL_count% ()
    DIM i AS INTEGER, n AS INTEGER
    FOR i = 1 TO ANIM.count: IF ANIM_SEL(i) THEN n = n + 1
    NEXT i
    ANIM_SEL_count% = n
END FUNCTION

SUB ANIM_SEL_clear ()
    DIM i AS INTEGER
    FOR i = 1 TO ANIM_MAX_FRAMES: ANIM_SEL(i) = FALSE: NEXT i
    ANIM_SEL_ANCHOR = ANIM.current
END SUB

''
' A click on frame f in the strip, as in the layers panel: plain = f is
' current and the only one selected; Ctrl = f in / out of the selection
' (current when it goes in); Shift = the frames from the anchor to f, f
' current. Ctrl+Shift adds the range to the selection.
SUB ANIM_SEL_click (f AS INTEGER, ctrl AS INTEGER, shift AS INTEGER)
    DIM i AS INTEGER, a AS INTEGER, k AS INTEGER
    IF f < 1 _ORELSE f > ANIM.count THEN EXIT SUB
    IF shift THEN
        a = ANIM_SEL_ANCHOR
        IF a < 1 _ORELSE a > ANIM.count THEN a = ANIM.current
        IF ctrl = 0 THEN
            FOR i = 1 TO ANIM_MAX_FRAMES: ANIM_SEL(i) = FALSE: NEXT i
        END IF
        FOR i = _MIN(a, f) TO _MAX(a, f): ANIM_SEL(i) = TRUE: NEXT i
        ANIM_SEL_ANCHOR = a
        ANIM.current = f
    ELSEIF ctrl THEN
        IF ANIM_SEL_count% = 0 THEN ANIM_SEL(ANIM.current) = TRUE ' the current frame was the selection
        ANIM_SEL(f) = (ANIM_SEL(f) = 0)
        IF ANIM_SEL(f) THEN
            ANIM.current = f
        ELSEIF f = ANIM.current THEN
            ' it left: the nearest selected frame becomes current
            FOR k = 1 TO ANIM.count
                IF f - k >= 1 THEN IF ANIM_SEL(f - k) THEN ANIM.current = f - k: EXIT FOR
                IF f + k <= ANIM.count THEN IF ANIM_SEL(f + k) THEN ANIM.current = f + k: EXIT FOR
            NEXT k
        END IF
        ANIM_SEL_ANCHOR = f
    ELSE
        FOR i = 1 TO ANIM_MAX_FRAMES: ANIM_SEL(i) = FALSE: NEXT i
        ANIM_SEL(f) = TRUE
        ANIM_SEL_ANCHOR = f
        ANIM.current = f
    END IF
END SUB

''
' The frames playback plays: first..last of the selection when it holds two
' or more frames, else all of them (0, 0).
SUB ANIM_SEL_span (a AS INTEGER, b AS INTEGER)
    DIM i AS INTEGER
    a = 0: b = 0
    IF ANIM_SEL_count% < 2 THEN EXIT SUB
    FOR i = 1 TO ANIM.count
        IF ANIM_SEL(i) THEN
            IF a = 0 THEN a = i
            b = i
        END IF
    NEXT i
END SUB
