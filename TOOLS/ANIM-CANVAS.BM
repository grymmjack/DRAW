''
' DRAW - TOOLS/ANIM-CANVAS.BM
' =============================================================================
' The current frame as the canvas in the lightbox. See ANIM-CANVAS.BI.
'
$INCLUDEONCE

''
' The canvas as a command sees it, in canvas pixels: in the lightbox the
' current frame's cell (TRUE), else the whole canvas (FALSE).
FUNCTION ANIM_CV_rect% (x AS LONG, y AS LONG, w AS LONG, h AS LONG)
    IF ANIM_LB_showing% THEN
        IF ANIM_cell_rect%(ANIM.current, x, y, w, h) THEN ANIM_CV_rect% = TRUE: EXIT FUNCTION
    END IF
    x = 0: y = 0: w = SCRN.canvasW&: h = SCRN.canvasH&
END FUNCTION

''
' The opaque bounds of layer L inside canvas rect (rx, ry, rw, rh), in canvas
' pixels (the apron is allowed for); FALSE when it is empty there.
FUNCTION ANIM_CV_bounds% (L AS INTEGER, rx AS LONG, ry AS LONG, rw AS LONG, rh AS LONG, ox AS INTEGER, oy AS INTEGER, ow AS INTEGER, oh AS INTEGER)
    DIM img AS LONG, m AS _MEM, iw AS LONG, ih AS LONG, ax AS LONG, ay AS LONG
    DIM x AS LONG, y AS LONG, x1 AS LONG, y1 AS LONG, x2 AS LONG, y2 AS LONG
    DIM mnX AS LONG, mnY AS LONG, mxX AS LONG, mxY AS LONG, px AS _UNSIGNED LONG
    ox = 0: oy = 0: ow = 0: oh = 0
    IF L < 1 _ORELSE L > MAX_LAYERS THEN EXIT FUNCTION
    img = LAYERS(L).imgHandle&
    IF img >= -1 THEN EXIT FUNCTION
    iw = _WIDTH(img): ih = _HEIGHT(img)
    ax = LAYERS(L).apronW%: ay = LAYERS(L).apronH%
    x1 = _MAX(0, rx + ax): y1 = _MAX(0, ry + ay)
    x2 = _MIN(iw - 1, rx + rw - 1 + ax): y2 = _MIN(ih - 1, ry + rh - 1 + ay)
    IF x2 < x1 _ORELSE y2 < y1 THEN EXIT FUNCTION
    mnX = x2 + 1: mnY = y2 + 1: mxX = -1: mxY = -1
    m = _MEMIMAGE(img)
    FOR y = y1 TO y2
        FOR x = x1 TO x2
            _MEMGET m, m.OFFSET + (y * iw + x) * 4, px
            IF px AND &HFF000000~& THEN
                IF x < mnX THEN mnX = x
                IF x > mxX THEN mxX = x
                IF y < mnY THEN mnY = y
                IF y > mxY THEN mxY = y
            END IF
        NEXT x
    NEXT y
    _MEMFREE m
    IF mxX < 0 THEN EXIT FUNCTION
    ox = mnX - ax: oy = mnY - ay: ow = mxX - mnX + 1: oh = mxY - mnY + 1
    ANIM_CV_bounds% = TRUE
END FUNCTION

''
' Shift what layer L has in frame f's cell by (dx, dy) canvas pixels; what
' leaves the cell is cut off (the neighbouring frames are not touched).
SUB ANIM_CV_shift (L AS INTEGER, f AS INTEGER, dx AS INTEGER, dy AS INTEGER)
    DIM img AS LONG, tmp AS LONG, x AS LONG, y AS LONG, w AS LONG, h AS LONG, bx AS LONG, by AS LONG
    DIM sx1 AS LONG, sy1 AS LONG, sx2 AS LONG, sy2 AS LONG, oldDest AS LONG, ddx AS LONG, ddy AS LONG
    ddx = dx: ddy = dy
    IF ddx = 0 _ANDALSO ddy = 0 THEN EXIT SUB
    img = LAYERS(L).imgHandle&
    IF img >= -1 _ORELSE ANIM_cell_rect%(f, x, y, w, h) = 0 THEN EXIT SUB
    bx = x + LAYERS(L).apronW%: by = y + LAYERS(L).apronH%
    tmp = _NEWIMAGE(w, h, 32)
    IF tmp >= -1 THEN EXIT SUB
    _DONTBLEND tmp
    _PUTIMAGE (0, 0), img, tmp, (bx, by)-(bx + w - 1, by + h - 1)
    oldDest = _DEST
    _DEST img
    _DONTBLEND img
    LINE (bx, by)-(bx + w - 1, by + h - 1), _RGBA32(0, 0, 0, 0), BF
    sx1 = _MAX(0, -ddx): sy1 = _MAX(0, -ddy)
    sx2 = _MIN(w - 1, w - 1 - ddx): sy2 = _MIN(h - 1, h - 1 - ddy)
    IF sx2 >= sx1 _ANDALSO sy2 >= sy1 THEN _PUTIMAGE (bx + sx1 + ddx, by + sy1 + ddy), tmp, img, (sx1, sy1)-(sx2, sy2)
    _BLEND img
    _DEST oldDest
    _FREEIMAGE tmp
    LAYERS(L).contentDirty% = TRUE
    SAFE_FREEIMAGE LAYERS(L).apronCacheImg&: LAYERS(L).apronCacheImg& = 0
    LAYERS(L).apronCacheValid% = FALSE
    SYMBOL_mark_parent_dirty L
END SUB

''
' The layers a canvas-wide command works on in the lightbox, into lay(1..n):
' the multi-selected layers, else the current one (groups expanded by the
' caller), drawing layers only (ANIM_OPS_moves%). Returns n.
FUNCTION ANIM_CV_layers% (lay() AS INTEGER)
    DIM i AS INTEGER, n AS INTEGER, multi AS INTEGER
    multi = MULTI_SELECT_has_any%
    FOR i = 1 TO MAX_LAYERS
        IF ANIM_OPS_moves%(i) THEN
            IF multi THEN
                IF MULTI_SELECT_LAYERS(i) THEN n = n + 1: lay(n) = i
            ELSEIF i = CURRENT_LAYER% THEN
                n = n + 1: lay(n) = i
            END IF
        END IF
    NEXT i
    ANIM_CV_layers% = n
END FUNCTION

''
' Align / Distribute (1901-1908) in the lightbox: in each selected frame (the
' current one when none is), inside its cell. One layer lines up with the
' cell; several line up with each other as on the canvas (an edge: the one
' furthest that way stays; centre / distribute: their bounds together).
' One undo step.
SUB ANIM_CV_align (act AS INTEGER)
    DIM a AS INTEGER, why AS STRING, grp AS INTEGER, i AS INTEGER, j AS INTEGER, n AS INTEGER, f AS INTEGER
    DIM before AS STRING, after AS STRING, lbl AS STRING, nf AS INTEGER
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG
    DIM rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER, anchor AS INTEGER, best AS INTEGER, v AS INTEGER
    DIM dx AS INTEGER, dy AS INTEGER, k AS INTEGER, tmp AS INTEGER, total AS LONG, tp AS SINGLE, gap AS SINGLE
    a = act ' by reference (gotcha 13)
    why = ANIM_OPS_busy$
    IF why <> "" THEN STATUS_flash why: EXIT SUB
    SELECT CASE a
        CASE 1901: lbl = "Align Left"
        CASE 1902: lbl = "Align Center H"
        CASE 1903: lbl = "Align Right"
        CASE 1904: lbl = "Align Top"
        CASE 1905: lbl = "Align Middle V"
        CASE 1906: lbl = "Align Bottom"
        CASE 1907: lbl = "Distribute H"
        CASE 1908: lbl = "Distribute V"
        CASE ELSE: EXIT SUB
    END SELECT
    grp = CMD_group_expand_for_op%
    DIM lay(1 TO MAX_LAYERS) AS INTEGER
    n = ANIM_CV_layers%(lay())
    IF n = 0 THEN
        STATUS_flash lbl + ": no drawing layer to move"
        IF grp > 0 THEN CMD_group_restore_after_op grp
        EXIT SUB
    END IF
    IF (a = 1907 _ORELSE a = 1908) _ANDALSO n < 3 THEN
        STATUS_flash lbl + ": select three or more layers"
        IF grp > 0 THEN CMD_group_restore_after_op grp
        EXIT SUB
    END IF
    DIM lx(1 TO MAX_LAYERS) AS INTEGER, ly(1 TO MAX_LAYERS) AS INTEGER, lw(1 TO MAX_LAYERS) AS INTEGER, lh(1 TO MAX_LAYERS) AS INTEGER
    DIM ok(1 TO MAX_LAYERS) AS INTEGER, ord(1 TO MAX_LAYERS) AS INTEGER
    before = ANIM_OPS_snapshot$(TRUE)
    FOR f = 1 TO ANIM.count
        IF ANIM_SEL_is%(f) _ANDALSO ANIM_cell_rect%(f, cx, cy, cw, ch) THEN
            nf = nf + 1
            k = 0
            FOR i = 1 TO n
                ok(i) = ANIM_CV_bounds%(lay(i), cx, cy, cw, ch, lx(i), ly(i), lw(i), lh(i))
                IF ok(i) THEN k = k + 1: ord(k) = i
            NEXT i
            IF k = 0 THEN _CONTINUE
            IF a = 1907 _ORELSE a = 1908 THEN
                IF k >= 3 THEN
                    FOR i = 2 TO k ' by position
                        tmp = ord(i): j = i - 1
                        DO WHILE j >= 1
                            IF _IIF(a = 1907, lx(ord(j)), ly(ord(j))) <= _IIF(a = 1907, lx(tmp), ly(tmp)) THEN EXIT DO
                            ord(j + 1) = ord(j): j = j - 1
                        LOOP
                        ord(j + 1) = tmp
                    NEXT i
                    total = 0
                    FOR i = 1 TO k: total = total + _IIF(a = 1907, lw(ord(i)), lh(ord(i))): NEXT i
                    IF a = 1907 THEN
                        gap = ((lx(ord(k)) + lw(ord(k)) - lx(ord(1))) - total) / (k - 1): tp = lx(ord(1))
                    ELSE
                        gap = ((ly(ord(k)) + lh(ord(k)) - ly(ord(1))) - total) / (k - 1): tp = ly(ord(1))
                    END IF
                    FOR i = 1 TO k
                        j = ord(i)
                        IF a = 1907 THEN
                            ANIM_CV_shift lay(j), f, INT(tp + 0.5) - lx(j), 0: tp = tp + lw(j) + gap
                        ELSE
                            ANIM_CV_shift lay(j), f, 0, INT(tp + 0.5) - ly(j): tp = tp + lh(j) + gap
                        END IF
                    NEXT i
                END IF
                _CONTINUE
            END IF
            ' the reference: the cell (one layer), or the layers themselves
            rx = cx: ry = cy: rw = cw: rh = ch: anchor = 0
            IF n > 1 THEN
                IF a = 1901 _ORELSE a = 1904 _ORELSE a = 1903 _ORELSE a = 1906 THEN
                    best = _IIF(a = 1901 _ORELSE a = 1904, 32767, -32768)
                    FOR i = 1 TO k
                        j = ord(i)
                        SELECT CASE a
                            CASE 1901: v = lx(j)
                            CASE 1904: v = ly(j)
                            CASE 1903: v = lx(j) + lw(j)
                            CASE ELSE: v = ly(j) + lh(j)
                        END SELECT
                        IF (a = 1901 _ORELSE a = 1904) _ANDALSO v < best THEN best = v: anchor = j
                        IF (a = 1903 _ORELSE a = 1906) _ANDALSO v > best THEN best = v: anchor = j
                    NEXT i
                    rx = lx(anchor): ry = ly(anchor): rw = lw(anchor): rh = lh(anchor)
                ELSE
                    rx = 32767: ry = 32767: rw = -32768: rh = -32768 ' (x2 / y2 while gathering)
                    FOR i = 1 TO k
                        j = ord(i)
                        rx = _MIN(rx, lx(j)): ry = _MIN(ry, ly(j)): rw = _MAX(rw, lx(j) + lw(j)): rh = _MAX(rh, ly(j) + lh(j))
                    NEXT i
                    rw = rw - rx: rh = rh - ry
                END IF
            END IF
            FOR i = 1 TO k
                j = ord(i)
                IF j = anchor _ANDALSO anchor > 0 THEN _CONTINUE
                dx = 0: dy = 0
                SELECT CASE a
                    CASE 1901: dx = rx - lx(j)
                    CASE 1902: dx = (rx + rw \ 2) - (lx(j) + lw(j) \ 2)
                    CASE 1903: dx = (rx + rw - 1) - (lx(j) + lw(j) - 1)
                    CASE 1904: dy = ry - ly(j)
                    CASE 1905: dy = (ry + rh \ 2) - (ly(j) + lh(j) \ 2)
                    CASE 1906: dy = (ry + rh - 1) - (ly(j) + lh(j) - 1)
                END SELECT
                ANIM_CV_shift lay(j), f, dx, dy
            NEXT i
        END IF
    NEXT f
    after = ANIM_OPS_snapshot$(TRUE)
    IF after <> before THEN
        ANIM_OPS_record before, after, lbl, 0
        STATUS_flash lbl + _IIF(nf > 1, " in" + STR$(nf) + " frames", " in frame" + STR$(ANIM.current))
    ELSE
        STATUS_flash lbl + ": already there"
    END IF
    IF grp > 0 THEN CMD_group_restore_after_op grp
    BLEND_invalidate_cache
    INVALIDATE_canvas
    GUI_NEEDS_REDRAW% = TRUE: SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' The pane Move tool's press (ANIM_LB_move_begin%): what layer L has in the
' current frame's cell, for smart guides.
SUB ANIM_CV_move_begin (L AS INTEGER)
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG
    ANIM_CV_MV_W = 0: ANIM_CV_MV_H = 0
    IF ANIM_CV_rect%(cx, cy, cw, ch) = 0 THEN EXIT SUB
    IF ANIM_CV_bounds%(L, cx, cy, cw, ch, ANIM_CV_MV_X, ANIM_CV_MV_Y, ANIM_CV_MV_W, ANIM_CV_MV_H) = 0 THEN ANIM_CV_MV_W = 0
END SUB

''
' Smart guides for the pane Move tool: the drawing moved by (ox, oy) lines up
' with the frame's edges / centre and the other layers' drawings in the frame;
' with snap on, (ox, oy) are pulled onto the nearest line.
SUB ANIM_CV_move_guides (ox AS INTEGER, oy AS INTEGER)
    DIM d AS STRING
    d = DOCK_n$(ox) + DOCK_n$(oy)
    SMART_GUIDES_clear
    IF NOT SMART_GUIDES.ENABLED% _ORELSE ANIM_CV_MV_W < 1 THEN EXIT SUB
    SMART_GUIDES.moveBBoxX1% = 0: SMART_GUIDES.moveBBoxY1% = 0
    SMART_GUIDES.moveBBoxX2% = ANIM_CV_MV_W - 1: SMART_GUIDES.moveBBoxY2% = ANIM_CV_MV_H - 1
    SMART_GUIDES.moveBBoxValid% = TRUE
    SMART_GUIDES_update ANIM_CV_MV_X + ox, ANIM_CV_MV_Y + oy, ANIM_CV_MV_W, ANIM_CV_MV_H
    IF SMART_GUIDES.SNAP% THEN ox = ox + SMART_GUIDES.snapDX%: oy = oy + SMART_GUIDES.snapDY%
    ANIM_CV_LAST = d + DOCK_n$(SMART_GUIDES.vCount%) + DOCK_n$(SMART_GUIDES.hCount%) + DOCK_n$(SMART_GUIDES.snapDX%) + DOCK_n$(SMART_GUIDES.snapDY%) + DOCK_n$(ox) + DOCK_n$(oy)
END SUB

''
' QA dump: ANIMCV guidesOn snapOn moveX moveY moveW moveH, then the last pane-move
' guide step (offset in, guides v / h, snap dx / dy, offset out).
FUNCTION ANIM_CV_dump$ ()
    DIM d AS STRING, L AS INTEGER, td AS INTEGER, ox AS INTEGER, oy AS INTEGER, ow AS INTEGER, oh AS INTEGER
    d = "ANIMCV" + DOCK_n$(SMART_GUIDES.ENABLED% <> 0) + DOCK_n$(SMART_GUIDES.SNAP% <> 0) + DOCK_n$(ANIM_CV_MV_X) + DOCK_n$(ANIM_CV_MV_Y) + DOCK_n$(ANIM_CV_MV_W) + DOCK_n$(ANIM_CV_MV_H) + ANIM_CV_LAST + CHR$(10)
    ' ANIMTX: the current text layer - its start, then its pixels' bounds (x y w h; 0 0 0 0 = none)
    L = CURRENT_LAYER%
    IF L >= 1 _ANDALSO L <= MAX_LAYERS THEN
        IF LAYERS(L).layerType% = LAYER_TYPE_TEXT _ANDALSO LAYERS(L).imgHandle& < -1 THEN
            td = LAYERS(L).textDataIdx%
            IF td >= 1 THEN
                IF ANIM_CV_bounds%(L, 0, 0, SCRN.canvasW&, SCRN.canvasH&, ox, oy, ow, oh) = 0 THEN ox = 0: oy = 0: ow = 0: oh = 0
                d = d + "ANIMTX" + DOCK_n$(TEXT_LAYER_DATA(td).startX) + DOCK_n$(TEXT_LAYER_DATA(td).startY) + DOCK_n$(ox) + DOCK_n$(oy) + DOCK_n$(ow) + DOCK_n$(oh) + CHR$(10)
            END IF
        END IF
    END IF
    ANIM_CV_dump$ = d
END FUNCTION

''
' In the lightbox, cut the selection down to the current frame's cell (a
' mask: cleared outside it and its bounds found again; a box: intersected).
' Nothing left: no selection.
SUB ANIM_CV_clip_selection ()
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG, mw AS LONG, mh AS LONG, oldDest AS LONG
    DIM m AS _MEM, x AS LONG, y AS LONG, px AS _UNSIGNED LONG, mnX AS LONG, mnY AS LONG, mxX AS LONG, mxY AS LONG
    DIM x1 AS LONG, y1 AS LONG, x2 AS LONG, y2 AS LONG
    IF ANIM_CV_rect%(cx, cy, cw, ch) = 0 THEN EXIT SUB
    IF MARQUEE.WAND_HAS_SELECTION _ANDALSO MARQUEE.SELECTION_MASK < -1 THEN
        mw = _WIDTH(MARQUEE.SELECTION_MASK): mh = _HEIGHT(MARQUEE.SELECTION_MASK)
        oldDest = _DEST
        _DEST MARQUEE.SELECTION_MASK
        _DONTBLEND MARQUEE.SELECTION_MASK
        IF cy > 0 THEN LINE (0, 0)-(mw - 1, cy - 1), _RGBA32(0, 0, 0, 0), BF
        IF cy + ch < mh THEN LINE (0, cy + ch)-(mw - 1, mh - 1), _RGBA32(0, 0, 0, 0), BF
        IF cx > 0 THEN LINE (0, cy)-(cx - 1, cy + ch - 1), _RGBA32(0, 0, 0, 0), BF
        IF cx + cw < mw THEN LINE (cx + cw, cy)-(mw - 1, cy + ch - 1), _RGBA32(0, 0, 0, 0), BF
        _BLEND MARQUEE.SELECTION_MASK
        _DEST oldDest
        x1 = _MAX(0, cx): y1 = _MAX(0, cy): x2 = _MIN(mw - 1, cx + cw - 1): y2 = _MIN(mh - 1, cy + ch - 1)
        mnX = x2 + 1: mnY = y2 + 1: mxX = -1: mxY = -1
        m = _MEMIMAGE(MARQUEE.SELECTION_MASK)
        FOR y = y1 TO y2
            FOR x = x1 TO x2
                _MEMGET m, m.OFFSET + (y * mw + x) * 4, px
                IF px AND &HFF000000~& THEN
                    IF x < mnX THEN mnX = x
                    IF x > mxX THEN mxX = x
                    IF y < mnY THEN mnY = y
                    IF y > mxY THEN mxY = y
                END IF
            NEXT x
        NEXT y
        _MEMFREE m
        IF mxX < 0 THEN MARQUEE_clear: MAGIC_WAND_reset: EXIT SUB
        MARQUEE.WAND_MIN_X = mnX: MARQUEE.WAND_MIN_Y = mnY: MARQUEE.WAND_MAX_X = mxX: MARQUEE.WAND_MAX_Y = mxY
        MARQUEE.BOX.x = mnX: MARQUEE.BOX.y = mnY: MARQUEE.BOX.w = mxX - mnX + 1: MARQUEE.BOX.h = mxY - mnY + 1
        MARQUEE.WAND_EDGE_DIRTY = TRUE
    ELSEIF MARQUEE.ACTIVE _ANDALSO MARQUEE.USER_CREATED THEN
        x1 = _MAX(cx, MARQUEE.BOX.x): y1 = _MAX(cy, MARQUEE.BOX.y)
        x2 = _MIN(cx + cw - 1, MARQUEE.BOX.x + MARQUEE.BOX.w - 1): y2 = _MIN(cy + ch - 1, MARQUEE.BOX.y + MARQUEE.BOX.h - 1)
        IF x2 < x1 _ORELSE y2 < y1 THEN MARQUEE_clear: EXIT SUB
        MARQUEE.BOX.x = x1: MARQUEE.BOX.y = y1: MARQUEE.BOX.w = x2 - x1 + 1: MARQUEE.BOX.h = y2 - y1 + 1
        MARQUEE.CFG.initX = x1: MARQUEE.CFG.initY = y1: MARQUEE.CFG.initW = MARQUEE.BOX.w: MARQUEE.CFG.initH = MARQUEE.BOX.h
    END IF
    GUI_NEEDS_REDRAW% = TRUE: SCENE_DIRTY% = TRUE
END SUB

''
' Symmetry in the lightbox: the mirror centre (cx, cy) for canvas point (x, y)
' moves to the frame that point is in - its cell's centre, or a centre the
' user set kept at the same place inside its own frame's cell.
SUB ANIM_CV_sym_center (x AS INTEGER, y AS INTEGER, cx AS INTEGER, cy AS INTEGER)
    DIM f AS INTEGER, f0 AS INTEGER, fx AS LONG, fy AS LONG, fw AS LONG, fh AS LONG, x0 AS LONG, y0 AS LONG, w0 AS LONG, h0 AS LONG
    IF ANIM_LB_showing% = 0 THEN EXIT SUB
    f = ANIM_frame_at%(CLNG(x), CLNG(y))
    IF f < 1 THEN f = ANIM.current
    IF ANIM_cell_rect%(f, fx, fy, fw, fh) = 0 THEN EXIT SUB
    IF SYMMETRY.CENTER_SET% THEN
        f0 = ANIM_frame_at%(CLNG(SYMMETRY.CENTER_X%), CLNG(SYMMETRY.CENTER_Y%))
        IF f0 > 0 _ANDALSO ANIM_cell_rect%(f0, x0, y0, w0, h0) THEN
            cx = fx + (SYMMETRY.CENTER_X% - x0): cy = fy + (SYMMETRY.CENTER_Y% - y0)
            EXIT SUB
        END IF
    END IF
    cx = fx + fw \ 2: cy = fy + fh \ 2
END SUB

''
' The symmetry guides in the current pane (SCREEN_render, inside the pane
' overlay): drawn about the current frame's centre, then the centre is put back.
SUB ANIM_CV_sym_guides (dx AS LONG, dy AS LONG, zw AS LONG, zh AS LONG)
    DIM ox AS INTEGER, oy AS INTEGER, cx AS INTEGER, cy AS INTEGER, fx AS LONG, fy AS LONG, fw AS LONG, fh AS LONG
    IF ANIM_cell_rect%(ANIM.current, fx, fy, fw, fh) = 0 THEN EXIT SUB
    ox = SYMMETRY.CENTER_X%: oy = SYMMETRY.CENTER_Y%
    cx = ox: cy = oy
    ANIM_CV_sym_center CINT(fx), CINT(fy), cx, cy
    SYMMETRY.CENTER_X% = cx: SYMMETRY.CENTER_Y% = cy
    SYMMETRY_render_guides SCRN.CANVAS&, dx, dy, zw, zh, SCRN.zoom!
    SYMMETRY.CENTER_X% = ox: SYMMETRY.CENTER_Y% = oy
END SUB

''
' Where a w x h picture goes on the canvas (in the lightbox the current
' frame's cell): its top-left corner, or centred.
SUB ANIM_CV_place (w AS INTEGER, h AS INTEGER, centred AS INTEGER, px AS INTEGER, py AS INTEGER)
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG, ok AS INTEGER
    ok = ANIM_CV_rect%(cx, cy, cw, ch)
    IF centred THEN
        px = cx + (cw - w) \ 2: py = cy + (ch - h) \ 2
    ELSE
        px = cx: py = cy
    END IF
END SUB

''
' In the lightbox, clear canvas-size image img outside the current frame's
' cell (a new layer that was empty: what a placement put past the frame).
SUB ANIM_CV_keep_cell (img AS LONG)
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG, iw AS LONG, ih AS LONG, oldDest AS LONG
    IF img >= -1 THEN EXIT SUB
    IF ANIM_CV_rect%(cx, cy, cw, ch) = 0 THEN EXIT SUB
    iw = _WIDTH(img): ih = _HEIGHT(img)
    oldDest = _DEST
    _DEST img
    _DONTBLEND img
    IF cy > 0 THEN LINE (0, 0)-(iw - 1, cy - 1), _RGBA32(0, 0, 0, 0), BF
    IF cy + ch < ih THEN LINE (0, cy + ch)-(iw - 1, ih - 1), _RGBA32(0, 0, 0, 0), BF
    IF cx > 0 THEN LINE (0, cy)-(cx - 1, cy + ch - 1), _RGBA32(0, 0, 0, 0), BF
    IF cx + cw < iw THEN LINE (cx + cw, cy)-(iw - 1, cy + ch - 1), _RGBA32(0, 0, 0, 0), BF
    _BLEND img
    _DEST oldDest
END SUB

''
' Does Scale -50% / 2x / 2x H / 2x V (317 318 331 333) take the lightbox's
' frames? Only its whole-layer case: a selection, a floating move, a custom
' brush or a symbol child keep their own behaviour.
FUNCTION ANIM_CV_scale_wants% ()
    IF ANIM_LB_showing% = 0 THEN EXIT FUNCTION
    IF SELECTION_has_active% _ORELSE CUSTOM_BRUSH_is_active% THEN EXIT FUNCTION
    IF MOVE.ACTIVE _ANDALSO MOVE.SELECTION_IMAGE < -1 THEN EXIT FUNCTION
    IF CURRENT_LAYER% < 1 _ORELSE CURRENT_LAYER% > MAX_LAYERS THEN EXIT FUNCTION
    IF LAYERS(CURRENT_LAYER%).layerType% = LAYER_TYPE_SYMBOL_CHILD THEN EXIT FUNCTION
    ANIM_CV_scale_wants% = TRUE
END FUNCTION

''
' Scale what layer L has in frame f's cell by (sx, sy) about the cell's
' centre (nearest neighbour); what grows past the cell is cut off.
SUB ANIM_CV_scale_cell (L AS INTEGER, f AS INTEGER, sx AS SINGLE, sy AS SINGLE)
    DIM img AS LONG, tmp AS LONG, scl AS LONG, x AS LONG, y AS LONG, w AS LONG, h AS LONG, bx AS LONG, by AS LONG
    DIM nw AS LONG, nh AS LONG, ox AS LONG, oy AS LONG, oldDest AS LONG
    img = LAYERS(L).imgHandle&
    IF img >= -1 _ORELSE ANIM_cell_rect%(f, x, y, w, h) = 0 THEN EXIT SUB
    nw = _MAX(1, INT(w * sx)): nh = _MAX(1, INT(h * sy))
    bx = x + LAYERS(L).apronW%: by = y + LAYERS(L).apronH%
    tmp = _NEWIMAGE(w, h, 32)
    IF tmp >= -1 THEN EXIT SUB
    scl = _NEWIMAGE(nw, nh, 32)
    IF scl >= -1 THEN _FREEIMAGE tmp: EXIT SUB
    _DONTBLEND tmp: _DONTBLEND scl
    _PUTIMAGE (0, 0), img, tmp, (bx, by)-(bx + w - 1, by + h - 1)
    _PUTIMAGE (0, 0)-(nw - 1, nh - 1), tmp, scl
    oldDest = _DEST
    _DEST img
    _DONTBLEND img
    LINE (bx, by)-(bx + w - 1, by + h - 1), _RGBA32(0, 0, 0, 0), BF
    ox = (w - nw) \ 2: oy = (h - nh) \ 2 ' < 0: grown past the cell
    _PUTIMAGE (bx + _MAX(0, ox), by + _MAX(0, oy)), scl, img, (_MAX(0, -ox), _MAX(0, -oy))-(_MAX(0, -ox) + _MIN(w, nw) - 1, _MAX(0, -oy) + _MIN(h, nh) - 1)
    _BLEND img
    _DEST oldDest
    _FREEIMAGE tmp: _FREEIMAGE scl
    LAYERS(L).contentDirty% = TRUE
    SAFE_FREEIMAGE LAYERS(L).apronCacheImg&: LAYERS(L).apronCacheImg& = 0
    LAYERS(L).apronCacheValid% = FALSE
    SYMBOL_mark_parent_dirty L
END SUB

''
' Scale -50% / 2x / 2x H / 2x V in the lightbox: each selected frame (the
' current one when none is) about its own cell's centre, on the layers
' ANIM_CV_layers% gives. One undo step.
SUB ANIM_CV_scale (sx AS SINGLE, sy AS SINGLE, label AS STRING)
    DIM why AS STRING, grp AS INTEGER, n AS INTEGER, i AS INTEGER, f AS INTEGER, nf AS INTEGER
    DIM before AS STRING, after AS STRING, lbl AS STRING, fx AS SINGLE, fy AS SINGLE
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG
    fx = sx: fy = sy: lbl = label ' by reference (gotcha 13)
    why = ANIM_OPS_busy$
    IF why <> "" THEN STATUS_flash why: EXIT SUB
    grp = CMD_group_expand_for_op%
    DIM lay(1 TO MAX_LAYERS) AS INTEGER
    n = ANIM_CV_layers%(lay())
    IF n = 0 THEN
        STATUS_flash lbl + ": no drawing layer to scale"
        IF grp > 0 THEN CMD_group_restore_after_op grp
        EXIT SUB
    END IF
    SOUND_play SND_TRANSFORM
    before = ANIM_OPS_snapshot$(TRUE)
    FOR f = 1 TO ANIM.count
        IF ANIM_SEL_is%(f) _ANDALSO ANIM_cell_rect%(f, cx, cy, cw, ch) THEN
            nf = nf + 1
            FOR i = 1 TO n
                ANIM_CV_scale_cell lay(i), f, fx, fy
            NEXT i
        END IF
    NEXT f
    after = ANIM_OPS_snapshot$(TRUE)
    IF after <> before THEN
        ANIM_OPS_record before, after, lbl, 0
        STATUS_flash lbl + _IIF(nf > 1, " in" + STR$(nf) + " frames", " in frame" + STR$(ANIM.current))
    ELSE
        STATUS_flash lbl + ": nothing to scale"
    END IF
    IF grp > 0 THEN CMD_group_restore_after_op grp
    BLEND_invalidate_cache
    INVALIDATE_canvas
    GUI_NEEDS_REDRAW% = TRUE: SCENE_DIRTY% = TRUE: FRAME_IDLE% = FALSE
END SUB

''
' A flood's bounds (fill, global fill, magic wand): in the lightbox the cell of
' the frame clicked in (x, y canvas pixels), so it never runs through the
' neighbouring frames and back; else bL..bB are left as the caller set them.
SUB ANIM_CV_fill_box (x AS INTEGER, y AS INTEGER, bL AS INTEGER, bT AS INTEGER, bR AS INTEGER, bB AS INTEGER)
    DIM f AS INTEGER, fx AS LONG, fy AS LONG, fw AS LONG, fh AS LONG
    IF ANIM_LB_showing% = 0 THEN EXIT SUB
    f = ANIM_frame_at%(CLNG(x), CLNG(y))
    IF f < 1 THEN f = ANIM.current
    IF ANIM_cell_rect%(f, fx, fy, fw, fh) = 0 THEN EXIT SUB
    bL = _MAX(bL, fx): bT = _MAX(bT, fy): bR = _MIN(bR, fx + fw - 1): bB = _MIN(bB, fy + fh - 1)
END SUB

''
' A box (x, y, w, h canvas pixels) cut down to the cell of the frame at
' (px, py) in the lightbox; left alone when they don't overlap or outside it.
SUB ANIM_CV_clamp_box (px AS INTEGER, py AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    DIM f AS INTEGER, fx AS LONG, fy AS LONG, fw AS LONG, fh AS LONG, x1 AS LONG, y1 AS LONG, x2 AS LONG, y2 AS LONG
    IF ANIM_LB_showing% = 0 THEN EXIT SUB
    f = ANIM_frame_at%(CLNG(px), CLNG(py))
    IF f < 1 THEN f = ANIM.current
    IF ANIM_cell_rect%(f, fx, fy, fw, fh) = 0 THEN EXIT SUB
    x1 = _MAX(x, fx): y1 = _MAX(y, fy): x2 = _MIN(x + w - 1, fx + fw - 1): y2 = _MIN(y + h - 1, fy + fh - 1)
    IF x2 < x1 _ORELSE y2 < y1 THEN EXIT SUB
    x = x1: y = y1: w = x2 - x1 + 1: h = y2 - y1 + 1
END SUB

''
' The marquee being dragged (MARQUEE_update_drag) in the lightbox: both
' corners kept inside the cell of the frame the drag began in (the grid-snap
' end is exclusive, so it may sit one past the cell's last pixel).
SUB ANIM_CV_marquee_drag ()
    DIM f AS INTEGER, fx AS LONG, fy AS LONG, fw AS LONG, fh AS LONG, ex AS INTEGER
    IF ANIM_LB_showing% = 0 THEN EXIT SUB
    f = ANIM_frame_at%(CLNG(MARQUEE_UNSNAPPED_START_X%), CLNG(MARQUEE_UNSNAPPED_START_Y%))
    IF f < 1 THEN f = ANIM.current
    IF ANIM_cell_rect%(f, fx, fy, fw, fh) = 0 THEN EXIT SUB
    ex = _IIF(GRID.SNAP% _ANDALSO GRID.gridWidth% > 0, 0, 1)
    MARQUEE.DRAG_START_X% = _MAX(fx, _MIN(fx + fw - ex, MARQUEE.DRAG_START_X%))
    MARQUEE.DRAG_START_Y% = _MAX(fy, _MIN(fy + fh - ex, MARQUEE.DRAG_START_Y%))
    MARQUEE.DRAG_END_X% = _MAX(fx, _MIN(fx + fw - ex, MARQUEE.DRAG_END_X%))
    MARQUEE.DRAG_END_Y% = _MAX(fy, _MIN(fy + fh - ex, MARQUEE.DRAG_END_Y%))
END SUB

''
' Keep a paint-like write inside the current frame (a move / paste commit):
' ANIM_CV_keep_begin& copies the layer buffer when the lightbox clips to the
' frame (0 = no clip); ANIM_CV_keep_end puts back everything outside the
' current cell from that copy (aw / ah: the buffer's apron) and frees it.
FUNCTION ANIM_CV_keep_begin& (img AS LONG)
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG
    IF img >= -1 _ORELSE CFG.CLIP_FRAME_LIGHTBOX% = 0 THEN EXIT FUNCTION
    IF ANIM_CV_rect%(cx, cy, cw, ch) = 0 THEN EXIT FUNCTION
    ANIM_CV_keep_begin& = _COPYIMAGE(img, 32)
END FUNCTION

SUB ANIM_CV_keep_end (img AS LONG, keep AS LONG, aw AS INTEGER, ah AS INTEGER)
    DIM cx AS LONG, cy AS LONG, cw AS LONG, ch AS LONG, bw AS LONG, bh AS LONG, k AS LONG
    k = keep
    IF k >= -1 THEN EXIT SUB
    IF img < -1 _ANDALSO ANIM_CV_rect%(cx, cy, cw, ch) THEN
        bw = _WIDTH(img): bh = _HEIGHT(img)
        IF bw = _WIDTH(k) _ANDALSO bh = _HEIGHT(k) THEN
            cx = cx + aw: cy = cy + ah
            _DONTBLEND img
            IF cy > 0 THEN _PUTIMAGE (0, 0), k, img, (0, 0)-(bw - 1, cy - 1)
            IF cy + ch < bh THEN _PUTIMAGE (0, cy + ch), k, img, (0, cy + ch)-(bw - 1, bh - 1)
            IF cx > 0 THEN _PUTIMAGE (0, cy), k, img, (0, cy)-(cx - 1, cy + ch - 1)
            IF cx + cw < bw THEN _PUTIMAGE (cx + cw, cy), k, img, (cx + cw, cy)-(bw - 1, cy + ch - 1)
            _BLEND img
        END IF
    END IF
    _FREEIMAGE k
END SUB

''
' Centred effects (twirl, pinch, kaleidoscope, lens flare, backlight, ripples,
' grid, lightning, radial / zoom blur) in the lightbox: handed a whole layer
' buffer, each runs itself once per selected frame on that frame's cell, so
' its centre and radius are the frame's. The effect's prologue:
'   IF ANIM_CV_fx_split%(img) THEN
'       res = ANIM_CV_fx_begin&(img)
'       FOR f = 1 TO ANIM.count
'           sub = ANIM_CV_fx_cell&(img, f)
'           IF sub < -1 THEN ANIM_CV_fx_put res, <effect>(sub, ...), f: _FREEIMAGE sub
'       NEXT
'       ANIM_CV_fx_end: <effect> = res: EXIT FUNCTION
'   END IF
' (the call on the cell is not a layer buffer, so it runs as usual).
FUNCTION ANIM_CV_fx_split% (img AS LONG)
    DIM i AS INTEGER
    IF ANIM_CV_FX_L <> 0 _ORELSE img >= -1 THEN EXIT FUNCTION
    IF ANIM.active = FALSE _ORELSE ANIM_LB_showing% = 0 THEN EXIT FUNCTION
    FOR i = 1 TO MAX_LAYERS
        IF LAYERS(i).imgHandle& = img THEN ANIM_CV_FX_L = i: EXIT FOR
    NEXT i
    IF ANIM_CV_FX_L = 0 THEN EXIT FUNCTION
    ANIM_CV_FX_AW = LAYERS(ANIM_CV_FX_L).apronW%: ANIM_CV_FX_AH = LAYERS(ANIM_CV_FX_L).apronH%
    ANIM_CV_FX_L = 0
    ANIM_CV_fx_split% = TRUE
END FUNCTION

FUNCTION ANIM_CV_fx_begin& (img AS LONG)
    ANIM_CV_FX_L = -1 ' (busy: the calls on the cells don't split again)
    ANIM_CV_fx_begin& = _COPYIMAGE(img, 32)
END FUNCTION

FUNCTION ANIM_CV_fx_cell& (img AS LONG, f AS INTEGER)
    DIM x AS LONG, y AS LONG, w AS LONG, h AS LONG, c AS LONG
    IF ANIM_SEL_is%(f) = 0 _ORELSE ANIM_cell_rect%(f, x, y, w, h) = 0 THEN EXIT FUNCTION
    c = _NEWIMAGE(w, h, 32)
    IF c >= -1 THEN EXIT FUNCTION
    _DONTBLEND c
    _PUTIMAGE (0, 0), img, c, (x + ANIM_CV_FX_AW, y + ANIM_CV_FX_AH)-(x + ANIM_CV_FX_AW + w - 1, y + ANIM_CV_FX_AH + h - 1)
    _BLEND c
    ANIM_CV_fx_cell& = c
END FUNCTION

SUB ANIM_CV_fx_put (res AS LONG, cellRes AS LONG, f AS INTEGER)
    DIM x AS LONG, y AS LONG, w AS LONG, h AS LONG, r AS LONG
    r = cellRes
    IF r >= -1 THEN EXIT SUB
    IF res < -1 _ANDALSO ANIM_cell_rect%(f, x, y, w, h) THEN
        _DONTBLEND res
        _PUTIMAGE (x + ANIM_CV_FX_AW, y + ANIM_CV_FX_AH), r, res, (0, 0)-(_MIN(w, _WIDTH(r)) - 1, _MIN(h, _HEIGHT(r)) - 1)
        _BLEND res
    END IF
    _FREEIMAGE r
END SUB

SUB ANIM_CV_fx_end ()
    ANIM_CV_FX_L = 0
END SUB

''
' A user-picked effect centre (buffer pixels; < 0 = none) for the calls on the
' cells: the same offset inside each frame as inside the frame it was picked in.
FUNCTION ANIM_CV_fx_cen& (cx AS LONG, cy AS LONG, wantY AS INTEGER)
    DIM f AS INTEGER, x AS LONG, y AS LONG, w AS LONG, h AS LONG, px AS LONG, py AS LONG
    IF cx < 0 _ORELSE cy < 0 THEN ANIM_CV_fx_cen& = -1: EXIT FUNCTION
    px = cx - ANIM_CV_FX_AW: py = cy - ANIM_CV_FX_AH
    f = ANIM_frame_at%(px, py)
    IF f < 1 THEN f = ANIM.current
    IF ANIM_cell_rect%(f, x, y, w, h) = 0 THEN ANIM_CV_fx_cen& = -1: EXIT FUNCTION
    ANIM_CV_fx_cen& = _IIF(wantY, _MAX(0, _MIN(h - 1, py - y)), _MAX(0, _MIN(w - 1, px - x)))
END FUNCTION
