$INCLUDEONCE
'==============================================================================
' KIT-RESOLVE.BM - DRAW KITS asset resolver.
'
' Maps each KIT_TYPE_* to its on-disk story: where the user's items live, the
' kit-archive subfolder, whether an item is a file or a folder, how to enumerate
' the user's items (for the export picker), and how to refresh the in-app list
' after install. Export/install logic (later tasks) builds on these.
'
' Storage (per the asset audit):
'   Theme      folder  ./ASSETS/THEMES/<name>/                     (only location)
'   Pattern    .dset   PATHS_DATA_DIR$/DRAWER-SETS/ (mode byte = 2)
'   Gradient   .dset   PATHS_DATA_DIR$/DRAWER-SETS/ (mode byte = 3)
'   Brush      .dset   PATHS_DATA_DIR$/DRAWER-SETS/ (mode byte = 1)
'   Palette    .GPL    PATHS_DATA_DIR$/PALETTES/
'   Font(bmp)  files   PATHS_DATA_DIR$/FONTS/       (.psf .bdf .pcf .fon .bmp .Fnn)
'   Font(ttf)  files   PATHS_DATA_DIR$/FONTS/       (.ttf .otf .ttc)
'   Textstyle  records PATHS_DATA_DIR$/DRAW_TEXT_STYLES.dstyle (merged file)
'   Template   images  CFG.TEMPLATE_DIR$ (default ASSETS/TEMPLATES)
'==============================================================================

'-- Per-type descriptors ------------------------------------------------------
FUNCTION KIT_type_is_folder% (ty AS INTEGER)
    KIT_type_is_folder% = (ty = KIT_TYPE_THEME)
END FUNCTION

' Subfolder used inside the kit archive for this type.
FUNCTION KIT_type_zip_prefix$ (ty AS INTEGER)
    SELECT CASE ty
        CASE KIT_TYPE_THEME:       KIT_type_zip_prefix$ = "themes/"
        CASE KIT_TYPE_PATTERN:     KIT_type_zip_prefix$ = "patterns/"
        CASE KIT_TYPE_GRADIENT:    KIT_type_zip_prefix$ = "gradients/"
        CASE KIT_TYPE_BRUSH:       KIT_type_zip_prefix$ = "brushes/"
        CASE KIT_TYPE_PALETTE:     KIT_type_zip_prefix$ = "palettes/"
        CASE KIT_TYPE_FONT_BITMAP: KIT_type_zip_prefix$ = "fonts-bitmap/"
        CASE KIT_TYPE_FONT_COLORBITMAP: KIT_type_zip_prefix$ = "fonts-colorbitmap/"
        CASE KIT_TYPE_FONT_TTF:    KIT_type_zip_prefix$ = "fonts-ttf/"
        CASE KIT_TYPE_TEXTSTYLE:   KIT_type_zip_prefix$ = "textstyles/"
        CASE KIT_TYPE_TEMPLATE:    KIT_type_zip_prefix$ = "templates/"
        CASE ELSE:                 KIT_type_zip_prefix$ = "misc/"
    END SELECT
END FUNCTION

' Template directory (normalized with trailing separator).
FUNCTION KIT_template_dir$
    DIM d AS STRING
    d = CFG.TEMPLATE_DIR$
    IF d = "" THEN d = "ASSETS/TEMPLATES"
    IF RIGHT$(d, 1) <> "/" AND RIGHT$(d, 1) <> "\" THEN d = d + "/"
    KIT_template_dir$ = d
END FUNCTION

' Source AND install base directory for a type (trailing separator).
FUNCTION KIT_user_dir$ (ty AS INTEGER)
    SELECT CASE ty
        CASE KIT_TYPE_THEME:       KIT_user_dir$ = "./ASSETS/THEMES/"
        CASE KIT_TYPE_PATTERN, KIT_TYPE_GRADIENT, KIT_TYPE_BRUSH: KIT_user_dir$ = PATHS_data$("DRAWER-SETS/")
        CASE KIT_TYPE_PALETTE:     KIT_user_dir$ = PATHS_data$("PALETTES/")
        CASE KIT_TYPE_FONT_BITMAP, KIT_TYPE_FONT_COLORBITMAP, KIT_TYPE_FONT_TTF: KIT_user_dir$ = PATHS_data$("FONTS/")
        CASE KIT_TYPE_TEXTSTYLE:   KIT_user_dir$ = PATHS_DATA_DIR$ ' the .dstyle sits directly here
        CASE KIT_TYPE_TEMPLATE:    KIT_user_dir$ = KIT_template_dir$
        CASE ELSE:                 KIT_user_dir$ = ""
    END SELECT
END FUNCTION

' DRAWER mode byte (1/2/3) a given dset KIT type maps to.
FUNCTION KIT_dset_wanted_mode% (ty AS INTEGER)
    SELECT CASE ty
        CASE KIT_TYPE_BRUSH:    KIT_dset_wanted_mode% = 1
        CASE KIT_TYPE_PATTERN:  KIT_dset_wanted_mode% = 2
        CASE KIT_TYPE_GRADIENT: KIT_dset_wanted_mode% = 3
        CASE ELSE:              KIT_dset_wanted_mode% = 0
    END SELECT
END FUNCTION

' Factory (shipped) drawer-set dir for a dset KIT type; "" for non-dset types.
' The user's own sets live flat in DRAWER-SETS/ (KIT_user_dir$); the factory sets
' ship in per-mode subfolders under ASSETS/DSETS/ and must be enumerated too so a
' kit can include them even when the user hasn't saved any of their own.
FUNCTION KIT_factory_dir$ (ty AS INTEGER)
    SELECT CASE ty
        CASE KIT_TYPE_BRUSH:    KIT_factory_dir$ = "./ASSETS/DSETS/BRUSHES/"
        CASE KIT_TYPE_PATTERN:  KIT_factory_dir$ = "./ASSETS/DSETS/PATTERNS/"
        CASE KIT_TYPE_GRADIENT: KIT_factory_dir$ = "./ASSETS/DSETS/GRADIENTS/"
        CASE ELSE:              KIT_factory_dir$ = ""
    END SELECT
END FUNCTION

' Resolve an enumerated item's source file on disk: prefer the user dir, fall
' back to the factory dir (dset types). Used by export so factory items read from
' ASSETS/DSETS/ while the user's own take precedence on a name clash.
FUNCTION KIT_item_src_path$ (ty AS INTEGER, nm AS STRING)
    DIM up AS STRING, fp AS STRING
    up = KIT_user_dir$(ty) + nm
    IF _FILEEXISTS(up) THEN KIT_item_src_path$ = up: EXIT FUNCTION
    fp = KIT_factory_dir$(ty)
    IF fp <> "" AND _FILEEXISTS(fp + nm) THEN KIT_item_src_path$ = fp + nm: EXIT FUNCTION
    KIT_item_src_path$ = up ' default (may not exist; caller guards)
END FUNCTION

' TRUE if an enumerated dset item exists only in the factory dir (for labeling).
FUNCTION KIT_item_is_factory% (ty AS INTEGER, nm AS STRING)
    KIT_item_is_factory% = FALSE
    IF KIT_factory_dir$(ty) = "" THEN EXIT FUNCTION
    IF _FILEEXISTS(KIT_user_dir$(ty) + nm) THEN EXIT FUNCTION
    IF _FILEEXISTS(KIT_factory_dir$(ty) + nm) THEN KIT_item_is_factory% = TRUE
END FUNCTION

'-- Filename helpers ----------------------------------------------------------
FUNCTION KIT_file_ext$ (fn AS STRING)
    DIM i AS LONG
    FOR i = LEN(fn) TO 1 STEP -1
        IF ASC(fn, i) = 46 THEN KIT_file_ext$ = MID$(fn, i + 1): EXIT FUNCTION
        IF ASC(fn, i) = 47 OR ASC(fn, i) = 92 THEN EXIT FOR
    NEXT
    KIT_file_ext$ = ""
END FUNCTION

FUNCTION KIT_strip_ext$ (fn AS STRING)
    DIM i AS LONG
    FOR i = LEN(fn) TO 1 STEP -1
        IF ASC(fn, i) = 46 THEN KIT_strip_ext$ = LEFT$(fn, i - 1): EXIT FUNCTION
        IF ASC(fn, i) = 47 OR ASC(fn, i) = 92 THEN EXIT FOR
    NEXT
    KIT_strip_ext$ = fn
END FUNCTION

FUNCTION KIT_ext_is_vectorfont% (e AS STRING)
    DIM x AS STRING: x = LCASE$(e)
    KIT_ext_is_vectorfont% = (x = "ttf" OR x = "otf" OR x = "ttc")
END FUNCTION

FUNCTION KIT_ext_is_bitmapfont% (e AS STRING)
    ' .bmp is handled as a Color Bitmap font (CBF) separately, not here.
    DIM x AS STRING: x = LCASE$(e)
    IF x = "psf" OR x = "bdf" OR x = "pcf" OR x = "fon" THEN KIT_ext_is_bitmapfont% = TRUE: EXIT FUNCTION
    ' .Fnn family (f06/f08/f12/f14/f16/f19/f24/f32)
    IF LEN(x) = 3 THEN
        IF LEFT$(x, 1) = "f" AND ASC(x, 2) >= 48 AND ASC(x, 2) <= 57 AND ASC(x, 3) >= 48 AND ASC(x, 3) <= 57 THEN KIT_ext_is_bitmapfont% = TRUE
    END IF
END FUNCTION

FUNCTION KIT_ext_is_template% (e AS STRING)
    DIM x AS STRING: x = LCASE$(e)
    SELECT CASE x
        CASE "draw", "png", "bmp", "jpg", "jpeg", "gif", "psd", "tga", "qoi", "hdr": KIT_ext_is_template% = TRUE
    END SELECT
END FUNCTION

' Peek a .dset header's mode byte (1 brush / 2 pattern / 3 gradient), 0 if invalid.
FUNCTION KIT_dset_mode% (pth AS STRING)
    KIT_dset_mode% = 0
    IF NOT _FILEEXISTS(pth) THEN EXIT FUNCTION
    DIM fh AS INTEGER, magic AS STRING * 4, ver AS INTEGER, md AS INTEGER
    fh = FREEFILE
    OPEN pth FOR BINARY AS #fh
    GET #fh, , magic
    GET #fh, , ver
    GET #fh, , md
    CLOSE #fh
    IF magic <> "DST1" THEN EXIT FUNCTION
    KIT_dset_mode% = md
END FUNCTION

'-- Directory drain + enumeration ---------------------------------------------
' Sweep one directory's entries into KIT_DRAIN_NAME(). Runs a single _FILES$
' sweep with no other _FILES$ users interleaved (peeks/adds happen afterward).
SUB KIT_drain (dirp AS STRING)
    KIT_DRAIN_COUNT% = 0
    REDIM KIT_DRAIN_NAME(0) AS STRING
    IF NOT _DIREXISTS(dirp) THEN EXIT SUB
    DIM entry AS STRING
    entry = _FILES$(dirp)
    DO WHILE entry <> ""
        ' _FILES$ returns subdirs with a trailing "/" (and lists "./" and "../").
        ' Strip the slash so names are clean, then skip self/parent.
        IF RIGHT$(entry, 1) = "/" OR RIGHT$(entry, 1) = "\" THEN entry = LEFT$(entry, LEN(entry) - 1)
        IF entry <> "" AND entry <> "." AND entry <> ".." THEN
            REDIM _PRESERVE KIT_DRAIN_NAME(0 TO KIT_DRAIN_COUNT%) AS STRING
            KIT_DRAIN_NAME(KIT_DRAIN_COUNT%) = entry
            KIT_DRAIN_COUNT% = KIT_DRAIN_COUNT% + 1
        END IF
        entry = _FILES$
    LOOP
END SUB

SUB KIT_enum_add (nm AS STRING)
    REDIM _PRESERVE KIT_ENUM_NAME(0 TO KIT_ENUM_COUNT%) AS STRING
    KIT_ENUM_NAME(KIT_ENUM_COUNT%) = nm
    KIT_ENUM_COUNT% = KIT_ENUM_COUNT% + 1
END SUB

' Recursively enumerate font files under rootDir (fonts are organized in category
' subfolders). kind: 1 = vector (ttf/otf/ttc), 2 = bitmap, 3 = color bitmap (.bmp
' passing CBF_detect). Item names are the path RELATIVE to rootDir (e.g.
' "Commodore 64/C64.ttf") so export source == install target and subfolders survive.
SUB KIT_enum_fonts (rootDir AS STRING, kind AS INTEGER)
    REDIM qd(0) AS STRING, qz(0) AS STRING
    DIM qn AS INTEGER, head AS INTEGER, i AS INTEGER, dd AS STRING, rel AS STRING, en AS INTEGER
    DIM ex AS STRING, cbfW AS INTEGER, cbfH AS INTEGER
    IF NOT _DIREXISTS(rootDir) THEN EXIT SUB
    qd(0) = rootDir: IF RIGHT$(qd(0), 1) <> "/" AND RIGHT$(qd(0), 1) <> "\" THEN qd(0) = qd(0) + "/"
    qz(0) = ""
    qn = 1: head = 0
    DO WHILE head < qn
        dd = qd(head): rel = qz(head): head = head + 1
        KIT_drain dd
        en = KIT_DRAIN_COUNT%
        REDIM ent(0) AS STRING
        IF en > 0 THEN
            REDIM ent(0 TO en - 1) AS STRING
            FOR i = 0 TO en - 1: ent(i) = KIT_DRAIN_NAME(i): NEXT
        END IF
        FOR i = 0 TO en - 1
            IF _DIREXISTS(dd + ent(i)) THEN
                REDIM _PRESERVE qd(0 TO qn) AS STRING
                REDIM _PRESERVE qz(0 TO qn) AS STRING
                qd(qn) = dd + ent(i) + "/": qz(qn) = rel + ent(i) + "/": qn = qn + 1
            ELSE
                ex = LCASE$(KIT_file_ext$(ent(i)))
                SELECT CASE kind
                    CASE 1: IF KIT_ext_is_vectorfont%(ex) THEN KIT_enum_add rel + ent(i)
                    CASE 2: IF KIT_ext_is_bitmapfont%(ex) THEN KIT_enum_add rel + ent(i)
                    CASE 3: IF ex = "bmp" THEN IF CBF_detect%(dd + ent(i), cbfW, cbfH) THEN KIT_enum_add rel + ent(i)
                END SELECT
            END IF
        NEXT
    LOOP
END SUB

' Fill KIT_ENUM_NAME()/KIT_ENUM_COUNT% with the user's items of type ty.
' Item identity: theme -> folder name; palette/dset -> base name (no ext);
' font/template -> filename (with ext); text style -> style name.
SUB KIT_enumerate (ty AS INTEGER)
    KIT_ENUM_COUNT% = 0
    REDIM KIT_ENUM_NAME(0) AS STRING
    DIM i AS INTEGER, dirp AS STRING, wm AS INTEGER

    IF ty = KIT_TYPE_TEXTSTYLE THEN
        FOR i = 1 TO TEXT_STYLE_MAX
            IF TEXT_STYLES(i).used THEN KIT_enum_add _TRIM$(TEXT_STYLES(i).name)
        NEXT
        EXIT SUB
    END IF

    dirp = KIT_user_dir$(ty)
    IF dirp = "" THEN EXIT SUB
    KIT_drain dirp ' -> KIT_DRAIN_NAME()

    SELECT CASE ty
        CASE KIT_TYPE_THEME
            FOR i = 0 TO KIT_DRAIN_COUNT% - 1
                IF _DIREXISTS(dirp + KIT_DRAIN_NAME(i)) THEN KIT_enum_add KIT_DRAIN_NAME(i)
            NEXT
        CASE KIT_TYPE_PALETTE
            FOR i = 0 TO KIT_DRAIN_COUNT% - 1
                IF LCASE$(KIT_file_ext$(KIT_DRAIN_NAME(i))) = "gpl" THEN KIT_enum_add KIT_DRAIN_NAME(i) ' full filename (real ext/case)
            NEXT
        CASE KIT_TYPE_FONT_TTF
            KIT_enum_fonts dirp, 1 ' recurse category subfolders
        CASE KIT_TYPE_FONT_BITMAP
            KIT_enum_fonts dirp, 2
        CASE KIT_TYPE_FONT_COLORBITMAP
            KIT_enum_fonts dirp, 3
        CASE KIT_TYPE_TEMPLATE
            FOR i = 0 TO KIT_DRAIN_COUNT% - 1
                IF KIT_ext_is_template%(KIT_file_ext$(KIT_DRAIN_NAME(i))) THEN KIT_enum_add KIT_DRAIN_NAME(i)
            NEXT
        CASE KIT_TYPE_BRUSH, KIT_TYPE_PATTERN, KIT_TYPE_GRADIENT
            wm = KIT_dset_wanted_mode%(ty)
            ' 1) the user's own saved sets (flat DRAWER-SETS/, filtered by mode byte)
            FOR i = 0 TO KIT_DRAIN_COUNT% - 1
                IF LCASE$(KIT_file_ext$(KIT_DRAIN_NAME(i))) = "dset" THEN
                    IF KIT_dset_mode%(dirp + KIT_DRAIN_NAME(i)) = wm THEN KIT_enum_add KIT_DRAIN_NAME(i) ' full filename
                END IF
            NEXT
            ' 2) the factory sets shipped in ASSETS/DSETS/<mode>/ (so a kit can
            '    include them even with an empty user DRAWER-SETS/). Skip names
            '    the user already has (their own wins).
            DIM fdir AS STRING, jj AS INTEGER, dup AS INTEGER
            fdir = KIT_factory_dir$(ty)
            IF fdir <> "" THEN
                KIT_drain fdir
                FOR i = 0 TO KIT_DRAIN_COUNT% - 1
                    IF LCASE$(KIT_file_ext$(KIT_DRAIN_NAME(i))) = "dset" THEN
                        IF KIT_dset_mode%(fdir + KIT_DRAIN_NAME(i)) = wm THEN
                            dup = FALSE
                            FOR jj = 0 TO KIT_ENUM_COUNT% - 1
                                IF KIT_ENUM_NAME(jj) = KIT_DRAIN_NAME(i) THEN dup = TRUE
                            NEXT
                            IF dup = FALSE THEN KIT_enum_add KIT_DRAIN_NAME(i)
                        END IF
                    END IF
                NEXT
            END IF
    END SELECT
END SUB

'-- Refresh the in-app list after installing items of a type ------------------
SUB KIT_refresh (ty AS INTEGER)
    SELECT CASE ty
        CASE KIT_TYPE_PATTERN, KIT_TYPE_GRADIENT, KIT_TYPE_BRUSH
            DRAWER_invalidate_dset_cache
        CASE KIT_TYPE_PALETTE
            PALETTE_LOADER_scan_user_folders
        CASE KIT_TYPE_FONT_BITMAP, KIT_TYPE_FONT_COLORBITMAP, KIT_TYPE_FONT_TTF
            FONT_LIST_SCANNED% = FALSE
            FONT_LIST_scan
        CASE KIT_TYPE_TEXTSTYLE
            TEXT_STYLE_load
        ' THEME + TEMPLATE: no safe live refresh — a theme needs a restart to fully
        ' apply, and templates are re-read by the New-from-Template dialog each open.
    END SELECT
END SUB
