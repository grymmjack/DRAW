''
' DRAW - TOOLS/SAVE.BM
' =============================================================================
' Save tool subs and functions.
'
' @todo
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

FUNCTION SAVE_trim_trailing_dots_spaces$ (inName AS STRING)
    DIM outName AS STRING
    outName$ = inName$
    DO WHILE LEN(outName$) > 0
        DIM lastCh AS STRING
        lastCh$ = RIGHT$(outName$, 1)
        IF lastCh$ = "." OR lastCh$ = " " THEN
            outName$ = LEFT$(outName$, LEN(outName$) - 1)
        ELSE
            EXIT DO
        END IF
    LOOP
    SAVE_trim_trailing_dots_spaces$ = outName$
END FUNCTION

FUNCTION SAVE_has_basename_extension% (path AS STRING)
    DIM i        AS INTEGER
    DIM slashPos AS INTEGER
    DIM dotPos   AS INTEGER

    slashPos% = 0
    dotPos%   = 0
    FOR i% = LEN(path$) TO 1 STEP -1
        IF MID$(path$, i%, 1) = "/" OR MID$(path$, i%, 1) = "\" THEN
            slashPos% = i%
            EXIT FOR
        END IF
    NEXT i%

    FOR i% = LEN(path$) TO slashPos% + 1 STEP -1
        IF MID$(path$, i%, 1) = "." THEN
            dotPos% = i%
            EXIT FOR
        END IF
    NEXT i%

    IF dotPos% > slashPos% + 1 AND dotPos% < LEN(path$) THEN
        SAVE_has_basename_extension% = TRUE
    ELSE
        SAVE_has_basename_extension% = FALSE
    END IF
END FUNCTION

''
' Gate every save behind a real writability test.
'
' Saving into a drive/mount root (C:\ on Windows, / on Linux/macOS) or any other
' protected directory made _SAVEIMAGE raise error 5. The runtime error trap turns
' that into a crash report, which is technically survivable but tells the user
' nothing about what went wrong. Checking first turns it into a plain sentence.
'
' Call AFTER the filename is final (extension appended, dots trimmed) and BEFORE
' flattening — there is no point building a composite we cannot write.
'
' @param filePath STRING Full path about to be written
' @return INTEGER TRUE when the save may proceed
'
FUNCTION SAVE_target_writable% (filePath AS STRING)
    DIM ok  AS INTEGER
    DIM res AS INTEGER
    DIM dir AS STRING

    ok% = PATHS_can_write_file%(filePath$)
    IF ok% THEN
        SAVE_target_writable% = TRUE
        EXIT FUNCTION
    END IF

    dir$ = PATHS_parent_dir$(filePath$)
    IF dir$ = "" THEN dir$ = "."
    _LOGWARN "SAVE: target directory is not writable - " + dir$

    POINTER_hide_for_dialog
    res% = DRAW_message_box%("Cannot Save Here", _
        "DRAW could not write to:" + CHR$(10) + CHR$(10) + _
        dir$ + CHR$(10) + CHR$(10) + _
        "That folder is read-only or needs administrator permission." + CHR$(10) + _
        "Nothing has been saved and your artwork is unchanged." + CHR$(10) + CHR$(10) + _
        "Try a folder you own, such as your Documents or home folder.", _
        MB_BTN_OK, MB_ICON_WARNING)
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog TRUE

    SAVE_target_writable% = FALSE
END FUNCTION

''
' Confirm a save actually produced a file before treating it as done.
'
' _SAVEIMAGE reports nothing. If it fails — disk full, filename the OS rejects,
' a path over MAX_PATH on Windows — the raise is trapped and RESUME NEXT drops
' execution straight onto the "mark clean" line. The document was then flagged
' saved, the file was added to recents, and closing DRAW skipped the unsaved-
' changes prompt: the work was gone with no warning at any point.
'
' SAVE_target_writable% catches the permission case up front; this catches every
' other reason a write can fail. The .draw paths already verified this way — the
' image paths did not.
'
' @param filePath STRING Path that should now exist
' @return INTEGER TRUE when the file is on disk
'
FUNCTION SAVE_verify_written% (filePath AS STRING)
    DIM res AS INTEGER

    IF _FILEEXISTS(filePath$) THEN
        SAVE_verify_written% = TRUE
        EXIT FUNCTION
    END IF

    _LOGERROR "SAVE: file was not created - " + filePath$

    POINTER_hide_for_dialog
    res% = DRAW_message_box%("Save Failed", _
        "DRAW could not write:" + CHR$(10) + CHR$(10) + _
        filePath$ + CHR$(10) + CHR$(10) + _
        "The disk may be full, or the name may not be allowed here." + CHR$(10) + _
        "Your artwork is unchanged and still has unsaved edits." + CHR$(10) + CHR$(10) + _
        "Try saving again with a different name or location.", _
        MB_BTN_OK, MB_ICON_ERROR)
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog TRUE

    SAVE_verify_written% = FALSE
END FUNCTION

''
' Save the painting surface (smart save)
' This is CTRL-S behavior:
'   - If we have a known .draw filename, save silently as .draw
'   - Else if we have a known image filename, save silently as image
'   - Else show a save dialog to pick a filename
'
SUB SAVE_image ()
    _LOGWARN "SAVE_image called! DEFERRED=" + STR$(MOUSE.DEFERRED_ACTION%) + " _KEYDOWN(115)=" + STR$(_KEYDOWN(115)) + " _KEYDOWN(122)=" + STR$(_KEYDOWN(122)) + " ctrl=" + STR$(MODIFIERS.ctrl%) + " shift=" + STR$(MODIFIERS.shift%)
    ' v2.0.3: a pasted float now stays floating until finalised (BUG-B), so bake any
    ' in-progress move/paste onto the layer before writing — otherwise a paste that
    ' hasn't been committed yet would not be in the saved buffers.
    IF MOVE.ACTIVE THEN MOVE_reset
    ' If we have a .draw project filename, save silently as .draw
    IF CURRENT_DRW_FILENAME$ <> "" THEN
        DRW_save CURRENT_DRW_FILENAME$
        IF _FILEEXISTS(CURRENT_DRW_FILENAME$) THEN
            CANVAS_DIRTY% = FALSE
        END IF
        ' Clear any Ctrl/Shift/Alt whose key-up was dropped while the OS/WM
        ' shifted focus during the file write — otherwise tool hotkeys (B/D/F...)
        ' arrive as Ctrl+<key> and "stop working". The dialog save paths already
        ' do this via MOUSE_cleanup_after_dialog; the silent quick-save did not.
        MODIFIERS_force_release
        EXIT SUB
    END IF

    ' The document came from an image file that is not DRAW's own (GIF, BMP,
    ' JPG, PSD, Aseprite...). With SAVE_DRAW_SIDECAR on, keep that file as it is
    ' and save the layers to a .draw next to it. With it off, write the file back
    ' in its own format (flattened) when DRAW can encode it; otherwise ask.
    DIM siPrefillDir  AS STRING
    DIM siPrefillName AS STRING
    IF CURRENT_FILENAME$ <> "" THEN
        IF CFG.SAVE_DRAW_SIDECAR% THEN
            DIM siDerived AS STRING
            siDerived$ = SAVE_sidecar_path$(CURRENT_FILENAME$)
            DRW_save siDerived$
            IF NOT _FILEEXISTS(siDerived$) THEN EXIT SUB
            CURRENT_DRW_FILENAME$ = siDerived$
            RECENT_add_file siDerived$
            CANVAS_DIRTY% = FALSE
            MODIFIERS_force_release ' clear a dropped modifier key-up (see above)
            EXIT SUB
        END IF
        IF SAVE_can_write_format%(CURRENT_FILENAME$) THEN
            IF SAVE_flat_write%(CURRENT_FILENAME$) THEN CANVAS_DIRTY% = FALSE
            MODIFIERS_force_release
            EXIT SUB
        END IF
        ' DRAW cannot write this format (PSD, Aseprite, LBM, ANSI...): ask, starting
        ' beside the original with the same name.
        siPrefillDir$  = CONFIG_extract_dir$(CURRENT_FILENAME$)
        siPrefillName$ = SAVE_base_name$(CURRENT_FILENAME$) + ".png"
    END IF

    ' No known filename — show save dialog
    DIM filename     AS STRING
    DIM default_path AS STRING

    ' Start beside the original if there is one, else the per-operation last
    ' dir, then legacy fallbacks
    IF siPrefillDir$ <> "" THEN
        default_path$ = siPrefillDir$ + "/"
    ELSEIF CFG.LAST_DIR_SAVE$ <> "" THEN
        default_path$ = CFG.LAST_DIR_SAVE$ + "/"
    ELSEIF LAST_DIRECTORY$ <> "" THEN
        default_path$ = LAST_DIRECTORY$ + "/"
    ELSEIF CFG.DEFAULT_SAVE_DIR$ <> "" THEN
        default_path$ = CFG.DEFAULT_SAVE_DIR$ + "/"
    ELSE
        default_path$ = ""
    END IF

    ' Keep the current tool across the dialog (it used to switch to TOOL_NULL,
    ' leaving only an arrow until a tool was picked again).
    ' MOUSE_cleanup_after_dialog stops the dismissing click from reaching it.

    ' Show save file dialog
    POINTER_hide_for_dialog
    filename$ = DRAW_save_file$("Save Image", default_path$, "Image files|*.png|*.bmp|*.jpg|*.gif|*.tga|*.hdr|*.ico|*.qoi", 0, siPrefillName$, ".png")
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog TRUE ' Clear buffers and center mouse

    ' If user didn't cancel
    IF filename$ <> "" THEN
        ' Update per-operation last directory
        CFG.LAST_DIR_SAVE$ = CONFIG_extract_dir$(filename$)
        LAST_DIRECTORY$    = CFG.LAST_DIR_SAVE$
        CONFIG_save
        filename$ = SAVE_trim_trailing_dots_spaces$(filename$)

        ' Ensure file has an extension
        IF NOT SAVE_has_basename_extension%(filename$) THEN
            filename$ = filename$ + ".png"
        END IF

        ' Refuse unwritable targets before building a composite we cannot write
        IF NOT SAVE_target_writable%(filename$) THEN EXIT SUB

        ' Flatten all visible layers and save
        DIM flatImg AS LONG
        flatImg& = LAYERS_flatten&
        _LOGINFO "SAVE_image: flatImg&=" + STR$(flatImg&) + " W=" + STR$(_WIDTH(flatImg&)) + " H=" + STR$(_HEIGHT(flatImg&))
        _LOGINFO "SAVE_image: saving to " + filename$
        _SAVEIMAGE filename$, flatImg&
        _LOGINFO "SAVE_image: _SAVEIMAGE completed"
        IF flatImg& < -1 THEN SAFE_FREEIMAGE flatImg&

        ' Leave the document dirty and out of recents unless the file is really there
        IF NOT SAVE_verify_written%(filename$) THEN EXIT SUB

        ' Embed drAw chunk with project data if saving as PNG
        IF LCASE$(RIGHT$(filename$, 4)) = ".png" THEN
            DRW_embed_chunk_in_png filename$
        END IF

        ' This file is now the document's file (a PNG also carries the layers)
        SAVE_set_document_file filename$

        ' Add to recent files
        RECENT_add_file filename$

        ' Mark canvas as clean (no unsaved changes)
        CANVAS_DIRTY% = FALSE
    END IF
END SUB


''
' Save As - always shows dialog with fresh filename
' This is CTRL-ALT-S behavior
'
SUB SAVE_as ()
    DIM filename     AS STRING
    DIM default_path AS STRING

    ' Use per-operation last dir, then legacy fallbacks
    IF CFG.LAST_DIR_SAVE$ <> "" THEN
        default_path$ = CFG.LAST_DIR_SAVE$ + "/"
    ELSEIF LAST_DIRECTORY$ <> "" THEN
        default_path$ = LAST_DIRECTORY$ + "/"
    ELSEIF CFG.DEFAULT_SAVE_DIR$ <> "" THEN
        default_path$ = CFG.DEFAULT_SAVE_DIR$ + "/"
    ELSE
        default_path$ = ""
    END IF

    ' Keep the current tool across the dialog (it used to switch to TOOL_NULL,
    ' leaving only an arrow until a tool was picked again).
    ' MOUSE_cleanup_after_dialog stops the dismissing click from reaching it.

    ' Show save file dialog (no default filename - fresh save as)
    POINTER_hide_for_dialog
    filename$ = DRAW_save_file$("Save Image As", default_path$, "Image files|*.png|*.bmp|*.jpg|*.gif|*.tga|*.hdr|*.ico|*.qoi", 0, "", ".png")
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog TRUE ' Clear buffers and center mouse

    ' If user didn't cancel
    IF filename$ <> "" THEN
        ' Update per-operation last directory
        CFG.LAST_DIR_SAVE$ = CONFIG_extract_dir$(filename$)
        LAST_DIRECTORY$    = CFG.LAST_DIR_SAVE$
        CONFIG_save
        filename$ = SAVE_trim_trailing_dots_spaces$(filename$)

        ' Ensure file has an extension
        IF NOT SAVE_has_basename_extension%(filename$) THEN
            filename$ = filename$ + ".png"
        END IF

        ' Refuse unwritable targets before building a composite we cannot write
        IF NOT SAVE_target_writable%(filename$) THEN EXIT SUB

        ' A .draw name is DRAW's project format, which _SAVEIMAGE cannot encode
        ' (it picks an image codec by extension and has none for .draw, so it
        ' writes nothing and SAVE_verify_written% trips "Save Failed"). Route it
        ' through DRW_save, exactly as DRW_save_dialog does, and return.
        IF LCASE$(RIGHT$(filename$, 5)) = ".draw" THEN
            DRW_save filename$
            ' Leave the document dirty and out of recents unless it really wrote
            IF NOT SAVE_verify_written%(filename$) THEN EXIT SUB
            ' Mirror the opened-.draw state (see LOAD.BM) so a later Ctrl+S
            ' silent-saves as .draw via SAVE_image's CURRENT_DRW_FILENAME$ check
            SAVE_set_document_file filename$
            RECENT_add_file filename$
            CANVAS_DIRTY% = FALSE
            EXIT SUB
        END IF

        ' Flatten all visible layers and save
        DIM flatImg2 AS LONG
        flatImg2& = LAYERS_flatten&
        _SAVEIMAGE filename$, flatImg2&
        IF flatImg2& < -1 THEN SAFE_FREEIMAGE flatImg2&

        ' Leave the document dirty and out of recents unless the file is really there
        IF NOT SAVE_verify_written%(filename$) THEN EXIT SUB

        ' Embed drAw chunk with project data if saving as PNG
        IF LCASE$(RIGHT$(filename$, 4)) = ".png" THEN
            DRW_embed_chunk_in_png filename$
        END IF

        ' This file is now the document's file (a PNG also carries the layers)
        SAVE_set_document_file filename$

        ' Add to recent files
        RECENT_add_file filename$

        ' Mark canvas as clean (no unsaved changes)
        CANVAS_DIRTY% = FALSE
    END IF
END SUB


''
' Save the selected marquee region as a cropped image
' This is CTRL-ALT-S behavior
'
SUB SAVE_selection ()
    ' Check if we have an active marquee selection
    IF NOT MARQUEE.ACTIVE OR NOT MARQUEE.INITIALIZED THEN
        POINTER_hide_for_dialog
        DRAW_alert "Export Selection", "No selection to export. Use the Marquee tool to select an area first."
        POINTER_show_after_dialog
        MOUSE_cleanup_after_dialog TRUE ' Clear buffers and center mouse
        EXIT SUB
    END IF

    DIM filename      AS STRING
    DIM default_path  AS STRING
    DIM cropped_image AS LONG

    ' Use per-operation last dir, then legacy fallbacks
    IF CFG.LAST_DIR_EXPORT_LAYER$ <> "" THEN
        default_path$ = CFG.LAST_DIR_EXPORT_LAYER$ + "/"
    ELSEIF LAST_DIRECTORY$ <> "" THEN
        default_path$ = LAST_DIRECTORY$ + "/"
    ELSEIF CFG.DEFAULT_SAVE_DIR$ <> "" THEN
        default_path$ = CFG.DEFAULT_SAVE_DIR$ + "/"
    ELSE
        default_path$ = ""
    END IF

    ' Save and restore current tool across dialog
    DIM save_sel_prev_tool AS INTEGER
    save_sel_prev_tool% = CURRENT_TOOL%
    CURRENT_TOOL%       = TOOL_NULL

    ' Show save file dialog
    POINTER_hide_for_dialog
    filename$ = DRAW_save_file$("Export Selection", default_path$, "Image files|*.png|*.bmp|*.jpg|*.gif|*.tga|*.hdr|*.ico|*.qoi", 0, "", ".png")
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog TRUE ' Clear buffers and center mouse
    CURRENT_TOOL% = save_sel_prev_tool%

    ' If user didn't cancel
    IF filename$ <> "" THEN
        ' Update per-operation last directory
        CFG.LAST_DIR_EXPORT_LAYER$ = CONFIG_extract_dir$(filename$)
        LAST_DIRECTORY$            = CFG.LAST_DIR_EXPORT_LAYER$
        CONFIG_save
        filename$ = SAVE_trim_trailing_dots_spaces$(filename$)

        ' Ensure file has an extension
        IF NOT SAVE_has_basename_extension%(filename$) THEN
            filename$ = filename$ + ".png"
        END IF

        ' Refuse unwritable targets before compositing the whole canvas twice
        IF NOT SAVE_target_writable%(filename$) THEN EXIT SUB

        ' BUG-61: crop the selection region from LAYERS_flatten& — the group-aware,
        ' apron-correct flatten (fixed in BUG-59) — instead of re-compositing inline.
        ' The old inline loop did `_PUTIMAGE , imgHandle&, canvasSizedBuffer`, which
        ' STRETCHES an apron-extended layer (imgHandle& is larger than the canvas,
        ' content offset by apronW/H) down to canvas size — squashing / mis-placing
        ' the content — and it only checked per-layer visible%, so a hidden GROUP
        ' with visible children still exported. Flatten handles apron offsets and
        ' group visibility / isolation / blend / opacity exactly like the renderer.
        cropped_image& = _NEWIMAGE(MARQUEE.BOX.w, MARQUEE.BOX.h, 32)

        DIM exportSrc AS LONG
        exportSrc& = LAYERS_flatten&
        IF exportSrc& >= -1 THEN
            ' Flatten produced no valid image — nothing to export.
            IF cropped_image& < -1 THEN SAFE_FREEIMAGE cropped_image&
            EXIT SUB
        END IF

        ' If mask-based selection, only export masked pixels
        IF MARQUEE.WAND_HAS_SELECTION AND MARQUEE.SELECTION_MASK < -1 THEN
            DIM exp_old_src    AS LONG, exp_old_dest AS LONG
            DIM exp_x          AS INTEGER, exp_y AS INTEGER
            DIM exp_mask_color AS _UNSIGNED LONG
            exp_old_src&     = _SOURCE
            exp_old_dest&    = _DEST
            exp_mask_color~& = _RGB32(255, 255, 255)
            _DEST cropped_image&
            _DONTBLEND cropped_image&
            CLS , _RGBA32(0, 0, 0, 0)
            FOR exp_y% = 0 TO MARQUEE.BOX.h - 1
                FOR exp_x% = 0 TO MARQUEE.BOX.w - 1
                    _SOURCE MARQUEE.SELECTION_MASK
                    IF POINT(MARQUEE.BOX.x + exp_x%, MARQUEE.BOX.y + exp_y%) = exp_mask_color~& THEN
                        _SOURCE exportSrc&
                        PSET (exp_x%, exp_y%), POINT(MARQUEE.BOX.x + exp_x%, MARQUEE.BOX.y + exp_y%)
                    END IF
                NEXT exp_x%
            NEXT exp_y%
            _BLEND cropped_image&
            _SOURCE exp_old_src&
            _DEST exp_old_dest&
        ELSE
            ' Rectangular selection: copy the box region from current layer
            _PUTIMAGE (0, 0)-(MARQUEE.BOX.w - 1, MARQUEE.BOX.h - 1), exportSrc&, cropped_image&, _
                      (MARQUEE.BOX.x, MARQUEE.BOX.y)-(MARQUEE.BOX.x + MARQUEE.BOX.w - 1, MARQUEE.BOX.y + MARQUEE.BOX.h - 1)
        END IF

        ' Save the cropped image
        _SAVEIMAGE filename$, cropped_image&

        ' Free temporary images
        IF exportSrc& < -1 THEN SAFE_FREEIMAGE exportSrc&
        SAFE_FREEIMAGE cropped_image&

        ' Never announce "Export Complete" for a file that was not written
        IF NOT SAVE_verify_written%(filename$) THEN EXIT SUB

        POINTER_hide_for_dialog
        DRAW_alert "Export Complete", "Selection exported to: " + filename$ + CHR$(10) + _
                    "Size: " + _TRIM$(STR$(MARQUEE.BOX.w)) + "x" + _TRIM$(STR$(MARQUEE.BOX.h)) + " pixels"
        POINTER_show_after_dialog
        MOUSE_cleanup_after_dialog TRUE ' Clear buffers and center mouse
    END IF
END SUB


''
' Record which file the open document is. Every open and save path goes through
' here so the two names always agree:
'   .draw            project file only (Ctrl+S writes it; nothing to flatten to)
'   .png             both: Ctrl+S writes it with the layers inside, and it is the
'                    flatten target (Ctrl+Alt+Shift+S)
'   anything else    image only: Ctrl+S writes a .draw beside it or the file
'                    itself (CFG.SAVE_DRAW_SIDECAR); flatten writes the file
'
' @param filePath STRING full path of the document's file ("" = untitled)
'
SUB SAVE_set_document_file (filePath AS STRING)
    DIM f   AS STRING
    DIM ext AS STRING
    f$   = filePath$ ' by-reference param: callers may pass CURRENT_FILENAME$ itself
    ext$ = LCASE$(SAVE_extension$(f$))
    IF f$ = "" THEN
        CURRENT_DRW_FILENAME$ = ""
        CURRENT_FILENAME$     = ""
    ELSEIF ext$ = "draw" THEN
        CURRENT_DRW_FILENAME$ = f$
        CURRENT_FILENAME$     = ""
    ELSEIF ext$ = "png" THEN
        CURRENT_DRW_FILENAME$ = f$
        CURRENT_FILENAME$     = f$
    ELSE
        CURRENT_DRW_FILENAME$ = ""
        CURRENT_FILENAME$     = f$
    END IF
END SUB


''
' Extension of a path's file name, without the dot ("" when there is none).
'
FUNCTION SAVE_extension$ (filePath AS STRING)
    DIM nm  AS STRING
    DIM dot AS INTEGER
    nm$  = RECENT_extract_filename$(filePath$)
    dot% = _INSTRREV(nm$, ".")
    IF dot% > 1 THEN SAVE_extension$ = MID$(nm$, dot% + 1) ELSE SAVE_extension$ = ""
END FUNCTION


''
' File name without folder or extension ("art" for "/pics/art.gif").
'
FUNCTION SAVE_base_name$ (filePath AS STRING)
    DIM nm  AS STRING
    DIM dot AS INTEGER
    nm$  = RECENT_extract_filename$(filePath$)
    dot% = _INSTRREV(nm$, ".")
    IF dot% > 1 THEN SAVE_base_name$ = LEFT$(nm$, dot% - 1) ELSE SAVE_base_name$ = nm$
END FUNCTION


''
' The .draw that sits beside an image ("/pics/art.gif" -> "/pics/art.draw").
'
FUNCTION SAVE_sidecar_path$ (filePath AS STRING)
    DIM dir AS STRING
    dir$ = CONFIG_extract_dir$(filePath$)
    IF dir$ <> "" THEN dir$ = dir$ + "/"
    SAVE_sidecar_path$ = dir$ + SAVE_base_name$(filePath$) + ".draw"
END FUNCTION


''
' TRUE when _SAVEIMAGE can write this file's format (picked by extension).
'
FUNCTION SAVE_can_write_format% (filePath AS STRING)
    SELECT CASE LCASE$(SAVE_extension$(filePath$))
        CASE "png", "bmp", "jpg", "jpeg", "gif", "tga", "hdr", "ico", "qoi"
            SAVE_can_write_format% = TRUE
        CASE ELSE
            SAVE_can_write_format% = FALSE
    END SELECT
END FUNCTION


''
' Write the flattened image (all visible layers merged) to a file, in the format
' its extension names. Plain image only: no drAw chunk, no .draw beside it.
'
' @param filePath STRING full path to write
' @return TRUE when the file was written
'
FUNCTION SAVE_flat_write% (filePath AS STRING)
    DIM f       AS STRING
    DIM flatImg AS LONG
    SAVE_flat_write% = FALSE
    f$ = filePath$
    IF NOT SAVE_target_writable%(f$) THEN EXIT FUNCTION
    flatImg& = LAYERS_flatten&
    _LOGINFO "SAVE_flat_write: " + f$
    _SAVEIMAGE f$, flatImg&
    IF flatImg& < -1 THEN SAFE_FREEIMAGE flatImg&
    IF NOT SAVE_verify_written%(f$) THEN EXIT FUNCTION
    STATUS_flash "Saved " + RECENT_extract_filename$(f$) + " (flattened)"
    SAVE_flat_write% = TRUE
END FUNCTION


''
' Ctrl+Alt+Shift+S - Flatten & Save: write the merged image back to the
' document's own image file, in its own format, with no .draw beside it and no
' layers inside it. The file is the one the document was opened from or last
' saved as. Untitled documents, .draw projects and formats DRAW cannot write
' (PSD, Aseprite...) ask for a name instead, and later saves reuse it.
'
SUB SAVE_flattened ()
    DIM target       AS STRING
    DIM startDir     AS STRING
    DIM prefill      AS STRING
    DIM filename     AS STRING
    DIM default_path AS STRING
    DIM projectFile  AS STRING

    ' Bake any live paste/move float into the layer first (as SAVE_image does)
    IF MOVE.ACTIVE THEN MOVE_reset

    IF CURRENT_FILENAME$ <> "" _ANDALSO SAVE_can_write_format%(CURRENT_FILENAME$) THEN
        target$ = CURRENT_FILENAME$
    END IF

    IF target$ <> "" THEN
        ' Write in place. The document stays "unsaved" while a .draw project
        ' attached to it is older than what is on screen.
        IF SAVE_flat_write%(target$) THEN
            IF CURRENT_DRW_FILENAME$ = "" _ORELSE CURRENT_DRW_FILENAME$ = target$ THEN CANVAS_DIRTY% = FALSE
        END IF
        MODIFIERS_force_release
        EXIT SUB
    END IF

    ' No image file to write back to: ask, starting beside the document's file
    projectFile$ = CURRENT_FILENAME$
    IF projectFile$ = "" THEN projectFile$ = CURRENT_DRW_FILENAME$
    IF projectFile$ <> "" THEN
        startDir$ = CONFIG_extract_dir$(projectFile$)
        prefill$  = SAVE_base_name$(projectFile$) + ".png"
    END IF
    IF startDir$ <> "" THEN
        default_path$ = startDir$ + "/"
    ELSEIF CFG.LAST_DIR_SAVE$ <> "" THEN
        default_path$ = CFG.LAST_DIR_SAVE$ + "/"
    ELSEIF CFG.DEFAULT_SAVE_DIR$ <> "" THEN
        default_path$ = CFG.DEFAULT_SAVE_DIR$ + "/"
    END IF

    POINTER_hide_for_dialog
    filename$ = DRAW_save_file$("Flatten & Save", default_path$, "Image files|*.png|*.bmp|*.jpg|*.gif|*.tga|*.hdr|*.ico|*.qoi", 0, prefill$, ".png")
    POINTER_show_after_dialog
    MOUSE_cleanup_after_dialog TRUE
    IF filename$ = "" THEN EXIT SUB

    filename$ = SAVE_trim_trailing_dots_spaces$(filename$)
    IF NOT SAVE_has_basename_extension%(filename$) THEN filename$ = filename$ + ".png"
    IF NOT SAVE_can_write_format%(filename$) THEN
        DRAW_alert "Flatten & Save", "DRAW cannot write ." + SAVE_extension$(filename$) + " files. Use PNG, BMP, JPG, GIF, TGA, HDR, ICO or QOI."
        EXIT SUB
    END IF
    CFG.LAST_DIR_SAVE$ = CONFIG_extract_dir$(filename$)
    LAST_DIRECTORY$    = CFG.LAST_DIR_SAVE$
    CONFIG_save

    IF NOT SAVE_flat_write%(filename$) THEN EXIT SUB
    ' Keep a .draw project attached (it is still the Ctrl+S target); otherwise
    ' this image becomes the document's file.
    IF LCASE$(SAVE_extension$(CURRENT_DRW_FILENAME$)) = "draw" THEN
        CURRENT_FILENAME$ = filename$
    ELSE
        SAVE_set_document_file filename$
        CANVAS_DIRTY% = FALSE
    END IF
    RECENT_add_file filename$
END SUB
