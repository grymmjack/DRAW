$INCLUDEONCE
'==============================================================================
' KIT.BM - DRAW KITS core implementation. See KIT.BI.
'==============================================================================

'-- Asset-type <-> manifest key ----------------------------------------------
FUNCTION KIT_type_key$ (t AS INTEGER)
    SELECT CASE t
        CASE KIT_TYPE_THEME            : KIT_type_key$ = "theme"
        CASE KIT_TYPE_PATTERN          : KIT_type_key$ = "pattern"
        CASE KIT_TYPE_GRADIENT         : KIT_type_key$ = "gradient"
        CASE KIT_TYPE_BRUSH            : KIT_type_key$ = "brush"
        CASE KIT_TYPE_PALETTE          : KIT_type_key$ = "palette"
        CASE KIT_TYPE_FONT_BITMAP      : KIT_type_key$ = "fontbmp"
        CASE KIT_TYPE_FONT_COLORBITMAP : KIT_type_key$ = "fontcbf"
        CASE KIT_TYPE_FONT_TTF         : KIT_type_key$ = "fontttf"
        CASE KIT_TYPE_TEXTSTYLE        : KIT_type_key$ = "textstyle"
        CASE KIT_TYPE_TEMPLATE         : KIT_type_key$ = "template"
        CASE ELSE                      : KIT_type_key$ = ""
    END SELECT
END FUNCTION

FUNCTION KIT_type_from_key% (k AS STRING)
    KIT_type_from_key% = -1
    SELECT CASE k
        CASE "theme"     : KIT_type_from_key% = KIT_TYPE_THEME
        CASE "pattern"   : KIT_type_from_key% = KIT_TYPE_PATTERN
        CASE "gradient"  : KIT_type_from_key% = KIT_TYPE_GRADIENT
        CASE "brush"     : KIT_type_from_key% = KIT_TYPE_BRUSH
        CASE "palette"   : KIT_type_from_key% = KIT_TYPE_PALETTE
        CASE "fontbmp"   : KIT_type_from_key% = KIT_TYPE_FONT_BITMAP
        CASE "fontcbf"   : KIT_type_from_key% = KIT_TYPE_FONT_COLORBITMAP
        CASE "fontttf"   : KIT_type_from_key% = KIT_TYPE_FONT_TTF
        CASE "textstyle" : KIT_type_from_key% = KIT_TYPE_TEXTSTYLE
        CASE "template"  : KIT_type_from_key% = KIT_TYPE_TEMPLATE
    END SELECT
END FUNCTION

' Human label for a type (dialogs/counts).
FUNCTION KIT_type_label$ (t AS INTEGER)
    SELECT CASE t
        CASE KIT_TYPE_THEME            : KIT_type_label$ = "Themes"
        CASE KIT_TYPE_PATTERN          : KIT_type_label$ = "Patterns"
        CASE KIT_TYPE_GRADIENT         : KIT_type_label$ = "Gradients"
        CASE KIT_TYPE_BRUSH            : KIT_type_label$ = "Brushes"
        CASE KIT_TYPE_PALETTE          : KIT_type_label$ = "Palettes"
        CASE KIT_TYPE_FONT_BITMAP      : KIT_type_label$ = "Fonts (Bitmap)"
        CASE KIT_TYPE_FONT_COLORBITMAP : KIT_type_label$ = "Fonts (Color Bitmap)"
        CASE KIT_TYPE_FONT_TTF         : KIT_type_label$ = "Fonts (TrueType)"
        CASE KIT_TYPE_TEXTSTYLE        : KIT_type_label$ = "Text styles"
        CASE KIT_TYPE_TEMPLATE         : KIT_type_label$ = "Templates"
        CASE ELSE                      : KIT_type_label$ = "?"
    END SELECT
END FUNCTION

'-- Value escaping (keeps one key/value per line, allows multi-line desc) ------
FUNCTION KIT_esc$ (s AS STRING)
    DIM r AS STRING, i AS LONG, c AS INTEGER
    FOR i = 1 TO LEN(s)
        c = ASC(s, i)
        SELECT CASE c
            CASE 92   : r = r + "\\"
            CASE 10   : r = r + "\n"
            CASE 13   : r = r + "\r"
            CASE ELSE : r = r + CHR$(c)
        END SELECT
    NEXT
    KIT_esc$ = r
END FUNCTION

FUNCTION KIT_unesc$ (s AS STRING)
    DIM r AS STRING, i AS LONG, c AS INTEGER, nx AS INTEGER
    i = 1
    DO WHILE i <= LEN(s)
        c = ASC(s, i)
        IF c = 92 AND i < LEN(s) THEN
            nx = ASC(s, i + 1)
            SELECT CASE nx
                CASE 92   : r = r + CHR$(92) : i = i + 2
                CASE 110  : r = r + CHR$(10) : i = i + 2 ' \n
                CASE 114  : r = r + CHR$(13) : i = i + 2 ' \r
                CASE ELSE : r = r + CHR$(c)  : i = i + 1
            END SELECT
        ELSE
            r = r + CHR$(c): i = i + 1
        END IF
    LOOP
    KIT_unesc$ = r
END FUNCTION

'-- Item list -----------------------------------------------------------------
SUB KIT_items_clear
    KIT_ITEM_COUNT% = 0
    REDIM KIT_ITEM_TYPE(0) AS INTEGER
    REDIM KIT_ITEM_NAME(0) AS STRING
END SUB

SUB KIT_item_add (t AS INTEGER, nm AS STRING)
    REDIM _PRESERVE KIT_ITEM_TYPE(0 TO KIT_ITEM_COUNT%) AS INTEGER
    REDIM _PRESERVE KIT_ITEM_NAME(0 TO KIT_ITEM_COUNT%) AS STRING
    KIT_ITEM_TYPE(KIT_ITEM_COUNT%) = t
    KIT_ITEM_NAME(KIT_ITEM_COUNT%) = nm
    KIT_ITEM_COUNT% = KIT_ITEM_COUNT% + 1
END SUB

' How many items of a given type are in the current list (for dialog counts).
FUNCTION KIT_item_count_of% (t AS INTEGER)
    DIM i AS INTEGER, n AS INTEGER
    FOR i = 0 TO KIT_ITEM_COUNT% - 1
        IF KIT_ITEM_TYPE(i) = t THEN n = n + 1
    NEXT
    KIT_item_count_of% = n
END FUNCTION

'-- Selection helpers (the item list doubles as the export selection set) ------
FUNCTION KIT_sel_has% (t AS INTEGER, nm AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO KIT_ITEM_COUNT% - 1
        IF KIT_ITEM_TYPE(i) = t AND KIT_ITEM_NAME(i) = nm THEN KIT_sel_has% = TRUE: EXIT FUNCTION
    NEXT
END FUNCTION

' Rebuild the item list keeping everything EXCEPT (t,nm) when dropOne, or every
' item of type t when dropType. Compacts the parallel arrays.
SUB KIT_sel_rebuild_excluding (t AS INTEGER, nm AS STRING, dropType AS INTEGER)
    DIM i AS INTEGER, n AS INTEGER
    REDIM keepT(0) AS INTEGER, keepN(0) AS STRING
    n = 0
    FOR i = 0 TO KIT_ITEM_COUNT% - 1
        DIM drop AS INTEGER : drop = FALSE
        IF KIT_ITEM_TYPE(i) = t THEN
            IF dropType THEN drop = TRUE ELSE IF KIT_ITEM_NAME(i) = nm THEN drop = TRUE
        END IF
        IF NOT drop THEN
            REDIM _PRESERVE keepT(0 TO n) AS INTEGER
            REDIM _PRESERVE keepN(0 TO n) AS STRING
            keepT(n) = KIT_ITEM_TYPE(i): keepN(n) = KIT_ITEM_NAME(i): n = n + 1
        END IF
    NEXT
    KIT_items_clear
    FOR i = 0 TO n - 1
        KIT_item_add keepT(i), keepN(i)
    NEXT
END SUB

SUB KIT_sel_remove (t AS INTEGER, nm AS STRING)
    KIT_sel_rebuild_excluding t, nm, FALSE
END SUB

SUB KIT_sel_remove_type (t AS INTEGER)
    KIT_sel_rebuild_excluding t, "", TRUE
END SUB

SUB KIT_sel_toggle (t AS INTEGER, nm AS STRING)
    IF KIT_sel_has%(t, nm) THEN KIT_sel_remove t, nm ELSE KIT_item_add t, nm
END SUB

' Add every enumerated item of type t that isn't already selected.
SUB KIT_sel_add_all_of (t AS INTEGER)
    DIM i AS INTEGER
    KIT_enumerate t
    FOR i = 0 TO KIT_ENUM_COUNT% - 1
        IF NOT KIT_sel_has%(t, KIT_ENUM_NAME(i)) THEN KIT_item_add t, KIT_ENUM_NAME(i)
    NEXT
END SUB

'-- Manifest serialize / parse ------------------------------------------------
' Text form (one key=value per line; item.<typekey>=<name> per asset):
'   drawkit=1
'   name=...
'   description=...
'   author=...
'   screenshot=...
'   item.palette=nord
'   item.theme=Midnight
FUNCTION KIT_manifest_build$ (mf AS KIT_MANIFEST)
    DIM s AS STRING, i AS INTEGER
    s = "drawkit=1" + CHR$(10)
    s = s + "name=" + KIT_esc$(mf.kitName) + CHR$(10)
    s = s + "description=" + KIT_esc$(mf.kitDesc) + CHR$(10)
    s = s + "author=" + KIT_esc$(mf.kitAuthor) + CHR$(10)
    s = s + "screenshot=" + KIT_esc$(mf.kitShot) + CHR$(10)
    FOR i = 0 TO KIT_ITEM_COUNT% - 1
        s = s + "item." + KIT_type_key$(KIT_ITEM_TYPE(i)) + "=" + KIT_esc$(KIT_ITEM_NAME(i)) + CHR$(10)
    NEXT
    KIT_manifest_build$ = s
END FUNCTION

FUNCTION KIT_manifest_parse% (txt AS STRING, mf AS KIT_MANIFEST)
    mf.kitName = "": mf.kitDesc = "": mf.kitAuthor = "": mf.kitShot = ""
    KIT_items_clear
    DIM rest     AS STRING, ln AS STRING, nlp AS LONG, eqp AS LONG, k AS STRING, v AS STRING, tk AS STRING, t AS INTEGER
    DIM sawMagic AS INTEGER
    rest = txt
    DO WHILE LEN(rest) > 0
        nlp = INSTR(rest, CHR$(10))
        IF nlp = 0 THEN
            ln = rest: rest = ""
        ELSE
            ln = LEFT$(rest, nlp - 1): rest = MID$(rest, nlp + 1)
        END IF
        IF LEN(ln) > 0 THEN IF RIGHT$(ln, 1) = CHR$(13) THEN ln = LEFT$(ln, LEN(ln) - 1)
        IF LEN(ln) > 0 THEN
            eqp = INSTR(ln, "=")
            IF eqp > 1 THEN
                k = LEFT$(ln, eqp - 1)
                v = KIT_unesc$(MID$(ln, eqp + 1))
                SELECT CASE k
                    CASE "drawkit"     : sawMagic     = TRUE
                    CASE "name"        : mf.kitName   = v
                    CASE "description" : mf.kitDesc   = v
                    CASE "author"      : mf.kitAuthor = v
                    CASE "screenshot"  : mf.kitShot   = v
                    CASE ELSE
                        IF LEFT$(k, 5) = "item." THEN
                            tk = MID$(k, 6)
                            t  = KIT_type_from_key%(tk)
                            IF t >= 0 THEN KIT_item_add t, v
                        END IF
                END SELECT
            END IF
        END IF
    LOOP
    KIT_manifest_parse% = sawMagic
END FUNCTION
