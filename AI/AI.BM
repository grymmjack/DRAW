''
' DRAW - AI/AI.BM
' =============================================================================
' AI integration: tool registry, config persistence, and DRAW_InfoParser$.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Initialise the AI subsystem. Called at include time from AI.BI.
' Under $DYNAMIC a module-level DIM SHARED reserves the symbol but does not
' allocate, so every pool entry must be touched here before first read.
'
SUB AI_init ()
    DIM i AS INTEGER

    FOR i% = 1 TO AI_MAX_TOOLS
        AI_TOOLS(i%).used     = FALSE
        AI_TOOLS(i%).toolName = ""
        AI_TOOLS(i%).exePath  = ""
        AI_TOOLS(i%).workDir  = ""
        AI_TOOLS(i%).argsTmpl = ""
    NEXT i%
    AI_TOOL_COUNT% = 0

    FOR i% = 1 TO AI_MAX_STYLES
        AI_STYLES(i%).used       = FALSE
        AI_STYLES(i%).styleName  = ""
        AI_STYLES(i%).toolName   = ""
        AI_STYLES(i%).prefixText = ""
        AI_STYLES(i%).suffixText = ""
        AI_STYLES(i%).argsExtra  = ""
        AI_STYLES(i%).descText   = ""
        AI_STYLES(i%).seedVal    = 0
    NEXT i%
    AI_STYLE_COUNT% = 0

    FOR i% = 1 TO AI_MAX_PROMPTS
        AI_PROMPTS(i%).used     = FALSE
        AI_PROMPTS(i%).label    = ""
        AI_PROMPTS(i%).textBody = ""
    NEXT i%
    AI_PROMPT_COUNT% = 0

    FOR i% = 1 TO AI_LAYER_POOL_SIZE
        AI_LAYER_DATA(i%).used      = FALSE
        AI_LAYER_DATA(i%).prompt    = ""
        AI_LAYER_DATA(i%).styleName = ""
        AI_LAYER_DATA(i%).toolName  = ""
        AI_LAYER_DATA(i%).seedVal   = 0
        AI_LAYER_DATA(i%).modelName = ""
        AI_LAYER_DATA(i%).genW      = 0
        AI_LAYER_DATA(i%).genH      = 0
    NEXT i%

    AI_JOB.state      = AI_JOB_IDLE
    AI_JOB.toolIdx    = 0
    AI_JOB.layerIdx   = 0
    AI_JOB.target     = AI_TARGET_NEW_LAYER
    AI_JOB.outDir     = ""
    AI_JOB.outName    = ""
    AI_JOB.doneFile   = ""
    AI_JOB.startTime  = 0
    AI_JOB.timeoutSec = AI_DEFAULT_TIMEOUT#
    AI_JOB.lastPoll   = 0
    AI_JOB.statusMsg  = ""

    AI_LAST_PROMPT$     = ""
    AI_LAST_PROMPT_RAW$ = ""
    AI_LAST_STYLE$      = ""
    AI_LAST_SEED&       = 0
    AI_LAST_TOOL%       = 0
    AI_LAST_STYLE_IDX%  = 0

    AI_config_load
END SUB


''
' Full path of the AI tool configuration file (OS-native config dir).
' @return STRING - Path to DRAW.ai.cfg
'
FUNCTION AI_config_path$ ()
    AI_config_path$ = PATHS_config$("DRAW.ai.cfg")
END FUNCTION


''
' Load configured tools from DRAW.ai.cfg. Format is INI-ish to match DRAW.cfg:
'
'   [TOOL]
'   NAME=pixelmon
'   EXE=/home/you/pixelmon/pixelmon.py
'   DIR=/home/you/pixelmon
'   ARGS="{prompt}" --size {sw}x{sh} --output-to {outdir} --name {outname}
'
' A missing file is not an error — it just means no tools are configured yet.
'
SUB AI_config_load ()
    DIM cfgPath AS STRING
    cfgPath$ = AI_config_path$
    IF NOT _FILEEXISTS(cfgPath$) THEN EXIT SUB

    DIM fh      AS INTEGER
    DIM lineIn  AS STRING
    DIM keyStr  AS STRING
    DIM valStr  AS STRING
    DIM eqPos   AS INTEGER
    DIM curIdx  AS INTEGER

    curIdx% = 0
    fh%     = FREEFILE
    OPEN cfgPath$ FOR INPUT AS #fh%
    DO WHILE NOT EOF(fh%)
        LINE INPUT #fh%, lineIn$
        lineIn$ = _TRIM$(lineIn$)
        IF LEN(lineIn$) = 0 THEN _CONTINUE
        IF LEFT$(lineIn$, 1) = "#" OR LEFT$(lineIn$, 1) = ";" THEN _CONTINUE

        ' Section headers switch which record subsequent keys belong to
        DIM secKind AS INTEGER      ' 1 = tool, 2 = style, 3 = prompt
        IF UCASE$(lineIn$) = "[TOOL]" THEN
            IF AI_TOOL_COUNT% < AI_MAX_TOOLS THEN
                AI_TOOL_COUNT%             = AI_TOOL_COUNT% + 1
                curIdx%                    = AI_TOOL_COUNT%
                AI_TOOLS(curIdx%).used     = TRUE
                AI_TOOLS(curIdx%).toolName = "tool " + _TRIM$(STR$(curIdx%))
                secKind%                   = 1
            ELSE
                curIdx% = 0
            END IF
            _CONTINUE
        ELSEIF UCASE$(lineIn$) = "[STYLE]" THEN
            IF AI_STYLE_COUNT% < AI_MAX_STYLES THEN
                AI_STYLE_COUNT%             = AI_STYLE_COUNT% + 1
                curIdx%                     = AI_STYLE_COUNT%
                AI_STYLES(curIdx%).used     = TRUE
                AI_STYLES(curIdx%).styleName = "style " + _TRIM$(STR$(curIdx%))
                secKind%                    = 2
            ELSE
                curIdx% = 0
            END IF
            _CONTINUE
        ELSEIF UCASE$(lineIn$) = "[LAST]" THEN
            curIdx%  = 1        ' not a record index; keys handled by secKind 4
            secKind% = 4
            _CONTINUE
        ELSEIF UCASE$(lineIn$) = "[PROMPT]" THEN
            IF AI_PROMPT_COUNT% < AI_MAX_PROMPTS THEN
                AI_PROMPT_COUNT%           = AI_PROMPT_COUNT% + 1
                curIdx%                    = AI_PROMPT_COUNT%
                AI_PROMPTS(curIdx%).used   = TRUE
                AI_PROMPTS(curIdx%).label  = "prompt " + _TRIM$(STR$(curIdx%))
                secKind%                   = 3
            ELSE
                curIdx% = 0
            END IF
            _CONTINUE
        END IF

        IF curIdx% = 0 THEN _CONTINUE
        eqPos% = INSTR(lineIn$, "=")
        IF eqPos% < 2 THEN _CONTINUE
        keyStr$ = UCASE$(_TRIM$(LEFT$(lineIn$, eqPos% - 1)))
        valStr$ = _TRIM$(MID$(lineIn$, eqPos% + 1))

        SELECT CASE secKind%
            CASE 1
                SELECT CASE keyStr$
                    CASE "NAME" : AI_TOOLS(curIdx%).toolName = valStr$
                    CASE "EXE"  : AI_TOOLS(curIdx%).exePath  = valStr$
                    CASE "DIR"  : AI_TOOLS(curIdx%).workDir  = valStr$
                    CASE "ARGS" : AI_TOOLS(curIdx%).argsTmpl = valStr$
                END SELECT
            CASE 2
                SELECT CASE keyStr$
                    CASE "NAME"   : AI_STYLES(curIdx%).styleName  = valStr$
                    CASE "TOOL"   : AI_STYLES(curIdx%).toolName   = valStr$
                    CASE "PREFIX" : AI_STYLES(curIdx%).prefixText = valStr$
                    CASE "SUFFIX" : AI_STYLES(curIdx%).suffixText = valStr$
                    CASE "TEXT"   : AI_STYLES(curIdx%).suffixText = valStr$ ' alias
                    CASE "ARGS"   : AI_STYLES(curIdx%).argsExtra  = valStr$
                    CASE "DESC"   : AI_STYLES(curIdx%).descText   = valStr$
                    CASE "SEED"   : AI_STYLES(curIdx%).seedVal    = VAL(valStr$)
                END SELECT
            CASE 3
                SELECT CASE keyStr$
                    CASE "NAME" : AI_PROMPTS(curIdx%).label    = valStr$
                    CASE "TEXT" : AI_PROMPTS(curIdx%).textBody = valStr$
                END SELECT
            CASE 4
                ' Resolved to indices after the whole file is read, since the
                ' tool and style lists may not be fully populated yet.
                SELECT CASE keyStr$
                    CASE "TOOL"   : AI_LAST_TOOL_NAME$  = valStr$
                    CASE "STYLE"  : AI_LAST_STYLE_NAME$ = valStr$
                    CASE "PROMPT" : AI_LAST_PROMPT_RAW$ = valStr$
                    CASE "SEED"   : AI_LAST_SEED&       = VAL(valStr$)
                END SELECT
        END SELECT
    LOOP
    CLOSE #fh%

    ' Migrate flags written into PREFIX/SUFFIX. Prompt text never starts with
    ' "--", so a value that does is unambiguously a CLI flag that would
    ' otherwise be swallowed into the quoted {prompt} and never reach the tool.
    DIM mi AS INTEGER
    FOR mi% = 1 TO AI_STYLE_COUNT%
        IF LEFT$(_TRIM$(AI_STYLES(mi%).suffixText), 2) = "--" THEN
            AI_STYLES(mi%).argsExtra  = _TRIM$(AI_STYLES(mi%).argsExtra) + " " + _TRIM$(AI_STYLES(mi%).suffixText)
            AI_STYLES(mi%).suffixText = ""
            _LOGWARN "AI_config_load: style '" + RTRIM$(AI_STYLES(mi%).styleName) + "' had CLI flags in SUFFIX; moved to ARGS"
        END IF
        IF LEFT$(_TRIM$(AI_STYLES(mi%).prefixText), 2) = "--" THEN
            AI_STYLES(mi%).argsExtra  = _TRIM$(AI_STYLES(mi%).argsExtra) + " " + _TRIM$(AI_STYLES(mi%).prefixText)
            AI_STYLES(mi%).prefixText = ""
            _LOGWARN "AI_config_load: style '" + RTRIM$(AI_STYLES(mi%).styleName) + "' had CLI flags in PREFIX; moved to ARGS"
        END IF
        AI_STYLES(mi%).argsExtra = _TRIM$(AI_STYLES(mi%).argsExtra)
    NEXT mi%

    ' Resolve remembered choices by name now that both lists are complete
    IF LEN(_TRIM$(AI_LAST_TOOL_NAME$)) > 0 THEN AI_LAST_TOOL% = AI_tool_by_name%(AI_LAST_TOOL_NAME$)
    IF LEN(_TRIM$(AI_LAST_STYLE_NAME$)) > 0 THEN
        DIM rs AS INTEGER
        FOR rs% = 1 TO AI_STYLE_COUNT%
            IF UCASE$(RTRIM$(AI_STYLES(rs%).styleName)) = UCASE$(_TRIM$(AI_LAST_STYLE_NAME$)) THEN
                AI_LAST_STYLE_IDX% = rs%
                EXIT FOR
            END IF
        NEXT rs%
    END IF

    IF AI_TOOL_COUNT% > 0 AND AI_LAST_TOOL% < 1 THEN AI_LAST_TOOL% = 1
    _LOGINFO "AI_config_load: " + _TRIM$(STR$(AI_TOOL_COUNT%)) + " tool(s) from " + cfgPath$
END SUB


''
' Write the configured tools back to DRAW.ai.cfg.
'
SUB AI_config_save ()
    DIM fh AS INTEGER
    DIM i  AS INTEGER
    fh% = FREEFILE
    OPEN AI_config_path$ FOR OUTPUT AS #fh%
    PRINT #fh%, "# DRAW AI generator tools"
    PRINT #fh%, "# ARGS macros are expanded by DRAW_InfoParser$ - see AI/AI.BM"
    PRINT #fh%, "# DRAW supplies {outdir} and {outname}; the tool must write its PNG there."
    PRINT #fh%, ""
    FOR i% = 1 TO AI_TOOL_COUNT%
        IF AI_TOOLS(i%).used = 0 THEN _CONTINUE
        PRINT #fh%, "[TOOL]"
        PRINT #fh%, "NAME=" + RTRIM$(AI_TOOLS(i%).toolName)
        PRINT #fh%, "EXE=" + RTRIM$(AI_TOOLS(i%).exePath)
        PRINT #fh%, "DIR=" + RTRIM$(AI_TOOLS(i%).workDir)
        PRINT #fh%, "ARGS=" + RTRIM$(AI_TOOLS(i%).argsTmpl)
        PRINT #fh%, ""
    NEXT i%

    FOR i% = 1 TO AI_STYLE_COUNT%
        IF AI_STYLES(i%).used = 0 THEN _CONTINUE
        PRINT #fh%, "[STYLE]"
        PRINT #fh%, "NAME=" + RTRIM$(AI_STYLES(i%).styleName)
        PRINT #fh%, "TOOL=" + RTRIM$(AI_STYLES(i%).toolName)
        PRINT #fh%, "PREFIX=" + RTRIM$(AI_STYLES(i%).prefixText)
        PRINT #fh%, "SUFFIX=" + RTRIM$(AI_STYLES(i%).suffixText)
        PRINT #fh%, "ARGS=" + RTRIM$(AI_STYLES(i%).argsExtra)
        PRINT #fh%, "DESC=" + RTRIM$(AI_STYLES(i%).descText)
        PRINT #fh%, "SEED=" + _TRIM$(STR$(AI_STYLES(i%).seedVal))
        PRINT #fh%, ""
    NEXT i%

    FOR i% = 1 TO AI_PROMPT_COUNT%
        IF AI_PROMPTS(i%).used = 0 THEN _CONTINUE
        PRINT #fh%, "[PROMPT]"
        PRINT #fh%, "NAME=" + RTRIM$(AI_PROMPTS(i%).label)
        PRINT #fh%, "TEXT=" + RTRIM$(AI_PROMPTS(i%).textBody)
        PRINT #fh%, ""
    NEXT i%

    ' Remembered choices, so the generate dialog reopens where it was left.
    ' Stored by NAME, not index — a reordered list must not silently select
    ' something else.
    PRINT #fh%, "[LAST]"
    IF AI_LAST_TOOL% >= 1 AND AI_LAST_TOOL% <= AI_TOOL_COUNT% THEN
        PRINT #fh%, "TOOL=" + RTRIM$(AI_TOOLS(AI_LAST_TOOL%).toolName)
    ELSE
        PRINT #fh%, "TOOL="
    END IF
    IF AI_LAST_STYLE_IDX% >= 1 AND AI_LAST_STYLE_IDX% <= AI_STYLE_COUNT% THEN
        PRINT #fh%, "STYLE=" + RTRIM$(AI_STYLES(AI_LAST_STYLE_IDX%).styleName)
    ELSE
        PRINT #fh%, "STYLE="
    END IF
    PRINT #fh%, "PROMPT=" + AI_LAST_PROMPT_RAW$
    PRINT #fh%, "SEED=" + _TRIM$(STR$(AI_LAST_SEED&))
    PRINT #fh%, ""

    CLOSE #fh%
    _LOGINFO "AI_config_save: " + _TRIM$(STR$(AI_TOOL_COUNT%)) + " tool(s), " + _
             _TRIM$(STR$(AI_STYLE_COUNT%)) + " style(s), " + _TRIM$(STR$(AI_PROMPT_COUNT%)) + " prompt(s)"
END SUB


''
' Wrap a prompt in a style's prefix/suffix.
' @param basePrompt STRING - What the user typed
' @param styleIdx INTEGER - 1-based style index, 0 = no style
' @return STRING - Prompt to hand the generator
'
FUNCTION AI_compose_prompt$ (basePrompt AS STRING, styleIdx AS INTEGER)
    DIM s AS STRING
    s$ = _TRIM$(basePrompt$)
    IF styleIdx% < 1 OR styleIdx% > AI_STYLE_COUNT% THEN
        AI_compose_prompt$ = s$
        EXIT FUNCTION
    END IF
    IF AI_STYLES(styleIdx%).used = 0 THEN
        AI_compose_prompt$ = s$
        EXIT FUNCTION
    END IF

    DIM pre AS STRING, suf AS STRING
    pre$ = _TRIM$(AI_STYLES(styleIdx%).prefixText)
    suf$ = _TRIM$(AI_STYLES(styleIdx%).suffixText)
    IF LEN(pre$) > 0 THEN s$ = pre$ + ", " + s$
    IF LEN(suf$) > 0 THEN s$ = s$ + ", " + suf$
    AI_compose_prompt$ = s$
END FUNCTION


''
' Claim a free style slot.
' @return INTEGER - 1-based index, or 0 when full
'
FUNCTION AI_style_alloc% ()
    AI_style_alloc% = 0
    IF AI_STYLE_COUNT% >= AI_MAX_STYLES THEN EXIT FUNCTION
    AI_STYLE_COUNT%                  = AI_STYLE_COUNT% + 1
    AI_STYLES(AI_STYLE_COUNT%).used  = TRUE
    AI_STYLES(AI_STYLE_COUNT%).styleName  = "New Style"
    AI_STYLES(AI_STYLE_COUNT%).toolName   = ""
    AI_STYLES(AI_STYLE_COUNT%).prefixText = ""
    AI_STYLES(AI_STYLE_COUNT%).suffixText = ""
    AI_STYLES(AI_STYLE_COUNT%).argsExtra  = ""
    AI_STYLES(AI_STYLE_COUNT%).descText   = ""
    AI_STYLES(AI_STYLE_COUNT%).seedVal    = 0
    AI_style_alloc% = AI_STYLE_COUNT%
END FUNCTION


''
' Remove a style, closing the gap so the list stays contiguous.
' @param idx INTEGER - 1-based index
'
SUB AI_style_remove (idx AS INTEGER)
    DIM i AS INTEGER
    IF idx% < 1 OR idx% > AI_STYLE_COUNT% THEN EXIT SUB
    FOR i% = idx% TO AI_STYLE_COUNT% - 1
        AI_STYLES(i%) = AI_STYLES(i% + 1)
    NEXT i%
    AI_STYLES(AI_STYLE_COUNT%).used = FALSE
    AI_STYLE_COUNT% = AI_STYLE_COUNT% - 1
    IF AI_LAST_STYLE_IDX% > AI_STYLE_COUNT% THEN AI_LAST_STYLE_IDX% = 0
END SUB


''
' Claim a free prompt-preset slot.
' @return INTEGER - 1-based index, or 0 when full
'
FUNCTION AI_prompt_alloc% ()
    AI_prompt_alloc% = 0
    IF AI_PROMPT_COUNT% >= AI_MAX_PROMPTS THEN EXIT FUNCTION
    AI_PROMPT_COUNT%                     = AI_PROMPT_COUNT% + 1
    AI_PROMPTS(AI_PROMPT_COUNT%).used     = TRUE
    AI_PROMPTS(AI_PROMPT_COUNT%).label    = "New Prompt"
    AI_PROMPTS(AI_PROMPT_COUNT%).textBody = ""
    AI_prompt_alloc% = AI_PROMPT_COUNT%
END FUNCTION


''
' Remove a prompt preset, closing the gap.
' @param idx INTEGER - 1-based index
'
SUB AI_prompt_remove (idx AS INTEGER)
    DIM i AS INTEGER
    IF idx% < 1 OR idx% > AI_PROMPT_COUNT% THEN EXIT SUB
    FOR i% = idx% TO AI_PROMPT_COUNT% - 1
        AI_PROMPTS(i%) = AI_PROMPTS(i% + 1)
    NEXT i%
    AI_PROMPTS(AI_PROMPT_COUNT%).used = FALSE
    AI_PROMPT_COUNT% = AI_PROMPT_COUNT% - 1
END SUB


''
' Remove a tool, closing the gap.
' @param idx INTEGER - 1-based index
'
SUB AI_tool_remove (idx AS INTEGER)
    DIM i AS INTEGER
    IF idx% < 1 OR idx% > AI_TOOL_COUNT% THEN EXIT SUB
    FOR i% = idx% TO AI_TOOL_COUNT% - 1
        AI_TOOLS(i%) = AI_TOOLS(i% + 1)
    NEXT i%
    AI_TOOLS(AI_TOOL_COUNT%).used = FALSE
    AI_TOOL_COUNT% = AI_TOOL_COUNT% - 1
    IF AI_LAST_TOOL% > AI_TOOL_COUNT% THEN AI_LAST_TOOL% = 0
END SUB


''
' Claim a free tool slot.
' @return INTEGER - 1-based index, or 0 when full
'
FUNCTION AI_tool_alloc% ()
    AI_tool_alloc% = 0
    IF AI_TOOL_COUNT% >= AI_MAX_TOOLS THEN EXIT FUNCTION
    AI_TOOL_COUNT%                   = AI_TOOL_COUNT% + 1
    AI_TOOLS(AI_TOOL_COUNT%).used     = TRUE
    AI_TOOLS(AI_TOOL_COUNT%).toolName = "New Tool"
    AI_TOOLS(AI_TOOL_COUNT%).exePath  = ""
    AI_TOOLS(AI_TOOL_COUNT%).workDir  = ""
    AI_TOOLS(AI_TOOL_COUNT%).argsTmpl = CHR$(34) + "{prompt}" + CHR$(34) + " --output-to {outdir} --name {outname}"
    AI_tool_alloc% = AI_TOOL_COUNT%
END FUNCTION


''
' Slugify: lowercase, spaces and underscores to dashes, drop anything else
' that is not alphanumeric or a dash. For tools that want CLI-safe tokens.
' @param src STRING - Source text
' @return STRING - Slug
'
FUNCTION AI_slug$ (src AS STRING)
    DIM s AS STRING, o AS STRING, c AS STRING
    DIM i AS INTEGER
    s$ = LCASE$(_TRIM$(src$))
    o$ = ""
    FOR i% = 1 TO LEN(s$)
        c$ = MID$(s$, i%, 1)
        IF (c$ >= "a" AND c$ <= "z") OR (c$ >= "0" AND c$ <= "9") OR c$ = "-" THEN
            o$ = o$ + c$
        ELSEIF c$ = " " OR c$ = "_" THEN
            IF LEN(o$) > 0 AND RIGHT$(o$, 1) <> "-" THEN o$ = o$ + "-"
        END IF
    NEXT i%
    DO WHILE LEN(o$) > 0 AND RIGHT$(o$, 1) = "-"
        o$ = LEFT$(o$, LEN(o$) - 1)
    LOOP
    AI_slug$ = o$
END FUNCTION


''
' Substitute one macro and all of its case variants into a template.
'
' Every value is _TRIM$'d before substitution. Untrimmed values are a real
' hazard: a stray leading space in the palette name produced
' `--palette " ANSI32"` and pixelmon rejected it outright.
'
' Supported forms, for a macro named "pal":
'   {pal}        as-is (trimmed)
'   {PAL}        UPPERCASE — the case of the NAME sets the case of the VALUE
'   {pal:upper}  UPPERCASE (explicit)
'   {pal:lower}  lowercase (explicit)
'   {pal:slug}   cli-safe-slug
'
' @param s STRING - Template, modified in place
' @param macroName STRING - Macro name WITHOUT braces
' @param rawVal STRING - Value to substitute
'
SUB AI_apply_macro (s AS STRING, macroName AS STRING, rawVal AS STRING)
    ' Copy the value out first — QB64 passes by reference and callers routinely
    ' hand in SHARED globals here.
    DIM v AS STRING
    v$ = _TRIM$(rawVal$)

    DIM stem AS STRING
    stem$ = "{" + macroName$
    ' Check BOTH cases before bailing out — {PAL} must not be missed
    IF INSTR(s$, stem$) = 0 AND INSTR(s$, "{" + UCASE$(macroName$)) = 0 THEN EXIT SUB

    ' Modified forms first; the bare form cannot match inside them (it needs the
    ' closing brace immediately), but ordering keeps the intent obvious.
    s$ = AI_replace$(s$, stem$ + ":upper}", UCASE$(v$))
    s$ = AI_replace$(s$, stem$ + ":lower}", LCASE$(v$))
    s$ = AI_replace$(s$, stem$ + ":slug}", AI_slug$(v$))
    s$ = AI_replace$(s$, stem$ + "}", v$)

    ' Shorthand: an UPPERCASE macro name yields an UPPERCASE value, so
    ' {PAL} needs no modifier syntax at all.
    DIM upStem AS STRING
    upStem$ = "{" + UCASE$(macroName$)
    IF upStem$ <> stem$ THEN
        s$ = AI_replace$(s$, upStem$ + ":slug}", AI_slug$(v$))
        s$ = AI_replace$(s$, upStem$ + "}", UCASE$(v$))
    END IF
END SUB


''
' Substitute a dimension/position macro AND its screen-scaled twin.
'
' For a macro named "iw" this defines {iw} (the true pixel value) and {sciw}
' (that value multiplied by the display scale). DRAW shows the canvas scaled,
' so a generator asked to match what the user is LOOKING at needs the scaled
' number, while the artwork itself is still 1:1.
'
' @param s STRING - Template, modified in place
' @param macroName STRING - Base macro name, without braces or the sc prefix
' @param dimVal INTEGER - The 1:1 value
'
SUB AI_apply_dim (s AS STRING, macroName AS STRING, dimVal AS INTEGER)
    DIM sc AS INTEGER
    sc% = SCRN.displayScale%
    IF sc% < 1 THEN sc% = 1
    ' "{iw" is not a substring of "{sciw}", so the two cannot collide
    AI_apply_macro s$, macroName$, _TRIM$(STR$(dimVal%))
    AI_apply_macro s$, "sc" + macroName$, _TRIM$(STR$(dimVal% * sc%))
END SUB


''
' Full path of the AI activity log.
' @return STRING - Path to ai.log
'
FUNCTION AI_log_path$ ()
    AI_log_path$ = PATHS_config$("ai.log")
END FUNCTION


''
' Append a line to ai.log. This is the record of what DRAW actually handed the
' generator and what came back — the command line, exit code, output tail and
' the imported file — because a failing generator otherwise gives the user
' nothing but "exited 1".
' @param msg STRING - Line to append
'
SUB AI_log (msg AS STRING)
    DIM fh AS INTEGER
    fh% = FREEFILE
    OPEN AI_log_path$ FOR APPEND AS #fh%
    PRINT #fh%, DATE$ + " " + TIME$ + "  " + msg$
    CLOSE #fh%
END SUB


''
' Start a new section in ai.log for one run.
' @param heading STRING - Section heading
'
SUB AI_log_section (heading AS STRING)
    AI_log ""
    AI_log "==== " + heading + " ===================================="
END SUB


''
' Copy a captured output file into ai.log, capped so a chatty generator cannot
' grow the log without bound.
' @param filePath STRING - File to copy in
' @param maxLines INTEGER - Maximum lines to copy
'
SUB AI_log_file (filePath AS STRING, maxLines AS INTEGER)
    IF NOT _FILEEXISTS(filePath$) THEN
        AI_log "  (no output captured at " + filePath$ + ")"
        EXIT SUB
    END IF
    DIM fh AS INTEGER, n AS INTEGER, ln AS STRING
    fh% = FREEFILE
    OPEN filePath$ FOR INPUT AS #fh%
    n% = 0
    DO WHILE NOT EOF(fh%) AND n% < maxLines%
        LINE INPUT #fh%, ln$
        AI_log "  | " + ln$
        n% = n% + 1
    LOOP
    IF NOT EOF(fh%) THEN AI_log "  | ... (truncated)"
    CLOSE #fh%
END SUB


''
' Strip any trailing slash so joined paths do not end up with "//".
' @param p STRING - Path
' @return STRING - Path without a trailing separator
'
FUNCTION AI_trim_slash$ (p AS STRING)
    DIM s AS STRING
    s$ = _TRIM$(p$)
    DO WHILE LEN(s$) > 1 AND (RIGHT$(s$, 1) = "/" OR RIGHT$(s$, 1) = "\")
        s$ = LEFT$(s$, LEN(s$) - 1)
    LOOP
    AI_trim_slash$ = s$
END FUNCTION


''
' Join two path fragments with exactly one separator.
' @param basePath STRING - Left fragment
' @param leaf STRING - Right fragment
' @return STRING - Joined path
'
FUNCTION AI_join_path$ (basePath AS STRING, leaf AS STRING)
    AI_join_path$ = AI_trim_slash$(basePath$) + "/" + _TRIM$(leaf$)
END FUNCTION


''
' Find a configured tool by name (case-insensitive).
' @param wanted STRING - Tool name
' @return INTEGER - 1-based tool index, or 0 if not found
'
FUNCTION AI_tool_by_name% (wanted AS STRING)
    DIM i AS INTEGER
    DIM w AS STRING
    AI_tool_by_name% = 0
    w$ = UCASE$(_TRIM$(wanted$))
    IF LEN(w$) = 0 THEN EXIT FUNCTION
    FOR i% = 1 TO AI_TOOL_COUNT%
        IF AI_TOOLS(i%).used <> 0 THEN
            IF UCASE$(RTRIM$(AI_TOOLS(i%).toolName)) = w$ THEN
                AI_tool_by_name% = i%
                EXIT FUNCTION
            END IF
        END IF
    NEXT i%
END FUNCTION


''
' Claim a free slot in the AI layer data pool.
' @return INTEGER - 1-based pool index, or 0 when the pool is full
'
FUNCTION AI_LAYER_alloc% ()
    DIM i AS INTEGER
    AI_LAYER_alloc% = 0
    FOR i% = 1 TO AI_LAYER_POOL_SIZE
        IF AI_LAYER_DATA(i%).used = 0 THEN
            AI_LAYER_DATA(i%).used      = TRUE
            AI_LAYER_DATA(i%).prompt    = ""
            AI_LAYER_DATA(i%).styleName = ""
            AI_LAYER_DATA(i%).toolName  = ""
            AI_LAYER_DATA(i%).seedVal   = 0
            AI_LAYER_DATA(i%).modelName = ""
            AI_LAYER_DATA(i%).genW      = 0
            AI_LAYER_DATA(i%).genH      = 0
            AI_LAYER_alloc%             = i%
            EXIT FUNCTION
        END IF
    NEXT i%
END FUNCTION


''
' Release an AI layer data pool slot.
' @param poolIdx INTEGER - 1-based pool index
'
SUB AI_LAYER_free (poolIdx AS INTEGER)
    IF poolIdx% < 1 OR poolIdx% > AI_LAYER_POOL_SIZE THEN EXIT SUB
    AI_LAYER_DATA(poolIdx%).used = FALSE
END SUB


''
' Replace every occurrence of a substring. QB64-PE has no built-in replace.
' @param src STRING - Source text
' @param findStr STRING - Needle
' @param replStr STRING - Replacement
' @return STRING - Result
'
FUNCTION AI_replace$ (src AS STRING, findStr AS STRING, replStr AS STRING)
    DIM outStr AS STRING
    DIM rest   AS STRING
    DIM p      AS INTEGER

    IF LEN(findStr$) = 0 THEN
        AI_replace$ = src$
        EXIT FUNCTION
    END IF

    outStr$ = ""
    rest$   = src$
    DO
        p% = INSTR(rest$, findStr$)
        IF p% = 0 THEN EXIT DO
        outStr$ = outStr$ + LEFT$(rest$, p% - 1) + replStr$
        rest$   = MID$(rest$, p% + LEN(findStr$))
    LOOP
    AI_replace$ = outStr$ + rest$
END FUNCTION


''
' Short label for the active tool, used by the {tool} macro.
' @param toolId INTEGER - CURRENT_TOOL% value
' @return STRING - Human-readable tool name
'
FUNCTION AI_tool_label$ (toolId AS INTEGER)
    SELECT CASE toolId%
        CASE TOOL_BRUSH    : AI_tool_label$ = "brush"
        CASE TOOL_FILL     : AI_tool_label$ = "fill"
        CASE TOOL_DOT      : AI_tool_label$ = "dot"
        CASE TOOL_LINE     : AI_tool_label$ = "line"
        CASE TOOL_RECT     : AI_tool_label$ = "rect"
        CASE TOOL_ELLIPSE  : AI_tool_label$ = "ellipse"
        CASE TOOL_MARQUEE  : AI_tool_label$ = "marquee"
        CASE TOOL_MOVE     : AI_tool_label$ = "move"
        CASE TOOL_TEXT     : AI_tool_label$ = "text"
        CASE TOOL_ERASER   : AI_tool_label$ = "eraser"
        CASE TOOL_PICKER   : AI_tool_label$ = "picker"
        CASE ELSE          : AI_tool_label$ = "tool" + _TRIM$(STR$(toolId%))
    END SELECT
END FUNCTION


''
' Expand an argument template's {macros} against DRAW's current state.
'
' Run-specific values ({prompt}, {seed}, {style}, {outdir}, {outname}) come from
' the pending job / AI_LAST_* state, so a template can be expanded before the
' process is launched. Image-export macros ({limg}, {dimg}, {bimg}) write a PNG
' into the job's output directory on demand and substitute its path.
'
' NOTE vs. PLANS/IDEAS.md: the spec listed "Image width: {ih}" and
' "Image height: {iw}", which is transposed, and listed {lx} twice. Implemented
' here the sane way: {iw} = width, {ih} = height, {lx}/{ly} = layer origin.
'
' @param tmpl STRING - Template containing {macro} placeholders
' @return STRING - Expanded command-line arguments
'
FUNCTION DRAW_InfoParser$ (tmpl AS STRING)
    DIM s        AS STRING
    DIM curLayer AS INTEGER
    DIM selW     AS INTEGER, selH AS INTEGER
    DIM outDirS  AS STRING

    s$ = tmpl$
    IF INSTR(s$, "{") = 0 THEN
        DRAW_InfoParser$ = s$
        EXIT FUNCTION
    END IF

    curLayer% = CURRENT_LAYER%
    IF curLayer% < 1 OR curLayer% > LAYER_COUNT% THEN curLayer% = 1
    outDirS$ = RTRIM$(AI_JOB.outDir)

    ' --- Run parameters ---
    AI_apply_macro s$, "prompt", AI_LAST_PROMPT$
    AI_apply_macro s$, "style", AI_LAST_STYLE$
    AI_apply_macro s$, "seed", _TRIM$(STR$(AI_LAST_SEED&))
    AI_apply_macro s$, "outdir", outDirS$
    AI_apply_macro s$, "outname", RTRIM$(AI_JOB.outName)
    ' --- Document ---
    DIM fnameOnly AS STRING, dirOnly AS STRING
    fnameOnly$ = CURRENT_FILENAME$
    dirOnly$   = ""
    DIM slashPos AS INTEGER, k AS INTEGER
    slashPos% = 0
    FOR k% = LEN(fnameOnly$) TO 1 STEP -1
        IF MID$(fnameOnly$, k%, 1) = "/" OR MID$(fnameOnly$, k%, 1) = "\" THEN
            slashPos% = k%
            EXIT FOR
        END IF
    NEXT k%
    IF slashPos% > 0 THEN
        dirOnly$   = LEFT$(fnameOnly$, slashPos% - 1)
        fnameOnly$ = MID$(fnameOnly$, slashPos% + 1)
    END IF
    AI_apply_macro s$, "if", fnameOnly$
    AI_apply_macro s$, "id", dirOnly$
    AI_apply_dim s$, "iw", SCRN.canvasW&
    AI_apply_dim s$, "ih", SCRN.canvasH&
    ' --- Selection (falls back to the whole canvas when nothing is selected) ---
    IF MARQUEE.ACTIVE% AND MARQUEE.BOX.w > 0 AND MARQUEE.BOX.h > 0 THEN
        selW% = MARQUEE.BOX.w
        selH% = MARQUEE.BOX.h
    ELSE
        selW% = SCRN.canvasW&
        selH% = SCRN.canvasH&
    END IF
    AI_apply_dim s$, "sw", selW%
    AI_apply_dim s$, "sh", selH%
    ' --- Brush / grid ---
    AI_apply_dim s$, "bw", BRUSH_SIZE.CURRENT%
    AI_apply_dim s$, "bh", BRUSH_SIZE.CURRENT%
    AI_apply_dim s$, "gw", GRID.gridWidth%
    AI_apply_dim s$, "gh", GRID.gridHeight%
    ' --- Palette ---
    AI_apply_macro s$, "pal", PALETTE_LOADER_get_name$
    AI_apply_macro s$, "numpal", _TRIM$(STR$(PAL_COLOR_COUNT%))
    ' --- Layers ---
    AI_apply_macro s$, "numlayers", _TRIM$(STR$(LAYER_COUNT%))
    AI_apply_macro s$, "lidx", _TRIM$(STR$(curLayer%))
    AI_apply_macro s$, "lname", RTRIM$(LAYERS(curLayer%).name)
    AI_apply_dim s$, "lw", LAYERS(curLayer%).imgWidth%
    AI_apply_dim s$, "lh", LAYERS(curLayer%).imgHeight%
    AI_apply_dim s$, "lx", 0
    AI_apply_dim s$, "ly", 0
    ' --- Colors (hex, no alpha — what CLI tools expect) ---
    AI_apply_macro s$, "fg", AI_hex_color$(PAINT_COLOR~&)
    AI_apply_macro s$, "bg", AI_hex_color$(PAINT_BG_COLOR~&)
    AI_apply_macro s$, "pmode", BLEND_mode_name$(LAYERS(curLayer%).blendMode%)
    ' --- Tool / pointer ---
    AI_apply_macro s$, "tool", AI_tool_label$(CURRENT_TOOL%)
    AI_apply_dim s$, "px", MOUSE.X%
    AI_apply_dim s$, "py", MOUSE.Y%
    ' --- Font ---
    AI_apply_macro s$, "font", RTRIM$(THEME.GLOBAL_FONT_FILE$)
    AI_apply_macro s$, "fsize", _TRIM$(STR$(THEME.GLOBAL_FONT_SIZE%))
    AI_apply_macro s$, "fontfile", THEME_font_path$(THEME.GLOBAL_FONT_FILE$)
    ' --- Image exports for steering / hinting (written on demand) ---
    IF LEN(outDirS$) > 0 THEN
        IF INSTR(s$, "{limg}") > 0 OR INSTR(s$, "{LIMG}") > 0 THEN
            ' A promoted layer's buffer is larger than the canvas and offset by
            ' its apron, so export the canvas region rather than the raw buffer.
            DIM limgSrc AS LONG
            limgSrc& = AI_canvas_region&(LAYERS(curLayer%).imgHandle&, LAYERS(curLayer%).apronW%, LAYERS(curLayer%).apronH%)
            AI_apply_macro s$, "limg", AI_export_png$(limgSrc&, outDirS$ + "/_layer.png")
            IF limgSrc& <> LAYERS(curLayer%).imgHandle& THEN SAFE_FREEIMAGE limgSrc&
        END IF
        IF INSTR(s$, "{dimg}") > 0 OR INSTR(s$, "{DIMG}") > 0 THEN
            ' NOT SCRN.CANVAS& — that is the whole viewport surface, so it
            ' exported a screenshot of DRAW's entire UI (toolbars, palette,
            ' panels) instead of the artwork, which would poison any steering
            ' reference. Flatten the visible layers to a canvas-sized image.
            DIM dimgSrc AS LONG
            dimgSrc& = LAYERS_flatten&
            AI_apply_macro s$, "dimg", AI_export_png$(dimgSrc&, outDirS$ + "/_document.png")
            SAFE_FREEIMAGE dimgSrc&
        END IF
        IF INSTR(s$, "{bimg}") > 0 OR INSTR(s$, "{BIMG}") > 0 THEN
            AI_apply_macro s$, "bimg", AI_export_png$(CUSTOM_BRUSH.IMAGE&, outDirS$ + "/_brush.png")
        END IF
    END IF

    DRAW_InfoParser$ = s$
END FUNCTION


''
' Return the canvas-sized region of a layer buffer.
'
' A layer promoted for off-canvas painting has an apron: its buffer is
' (canvasW + 2*apronW) x (canvasH + 2*apronH) and canvas pixel (0,0) lives at
' (apronW, apronH). Exporting the raw buffer would hand the generator a larger
' image with the artwork inset.
'
' @param imgHandle LONG - Layer image buffer
' @param apronW INTEGER - Layer apron width (0 = compact)
' @param apronH INTEGER - Layer apron height
' @return LONG - imgHandle itself when compact, else a NEW image the caller frees
'
FUNCTION AI_canvas_region& (imgHandle AS LONG, apronW AS INTEGER, apronH AS INTEGER)
    AI_canvas_region& = imgHandle&
    IF imgHandle& >= -1 THEN EXIT FUNCTION
    IF apronW% <= 0 AND apronH% <= 0 THEN EXIT FUNCTION

    DIM region AS LONG
    region& = _NEWIMAGE(SCRN.canvasW&, SCRN.canvasH&, 32)
    IF region& >= -1 THEN EXIT FUNCTION

    DIM oldDest AS LONG
    oldDest& = _DEST
    _DEST region&
    CLS , _RGBA32(0, 0, 0, 0)
    _PUTIMAGE (0, 0)-(SCRN.canvasW& - 1, SCRN.canvasH& - 1), imgHandle&, region&, _
              (apronW%, apronH%)-(apronW% + SCRN.canvasW& - 1, apronH% + SCRN.canvasH& - 1)
    _DEST oldDest&
    AI_canvas_region& = region&
END FUNCTION


''
' Format a color as RRGGBB hex.
' @param c _UNSIGNED LONG - RGB32 color
' @return STRING - Six hex digits
'
FUNCTION AI_hex_color$ (c AS _UNSIGNED LONG)
    DIM h AS STRING
    h$ = HEX$(_RED32(c~&) * 65536 + _GREEN32(c~&) * 256 + _BLUE32(c~&))
    WHILE LEN(h$) < 6
        h$ = "0" + h$
    WEND
    AI_hex_color$ = h$
END FUNCTION


''
' Save an image handle to PNG for use as a generator reference.
' @param imgHandle LONG - Source image
' @param destPath STRING - Destination .png path
' @return STRING - destPath on success, "" when the handle was invalid
'
FUNCTION AI_export_png$ (imgHandle AS LONG, destPath AS STRING)
    AI_export_png$ = ""
    ' An unavailable source (e.g. {bimg} with no custom brush captured) expands
    ' to nothing, which leaves the tool's flag dangling and its argument parser
    ' eating the NEXT flag. Log it so that failure is explicable.
    IF imgHandle& >= -1 THEN
        AI_log "  WARN     : steering image not available for " + destPath$ + " - macro expanded to nothing"
        EXIT FUNCTION
    END IF
    _SAVEIMAGE destPath$, imgHandle&
    IF _FILEEXISTS(destPath$) THEN AI_export_png$ = destPath$
END FUNCTION


''
' Pipe-delimited list of configured tool names, for the dropdown widget.
' @return STRING - "name|name|..."
'
FUNCTION AI_items_tools$ ()
    DIM o AS STRING, i AS INTEGER
    o$ = ""
    FOR i% = 1 TO AI_TOOL_COUNT%
        IF LEN(o$) > 0 THEN o$ = o$ + "|"
        o$ = o$ + RTRIM$(AI_TOOLS(i%).toolName)
    NEXT i%
    IF LEN(o$) = 0 THEN o$ = "(none configured)"
    AI_items_tools$ = o$
END FUNCTION


''
' Pipe-delimited style names with a leading "(none)", so the dropdown's
' 0-based selection maps directly onto the style index (0 = no style).
' @return STRING - "(none)|name|..."
'
FUNCTION AI_items_styles$ ()
    DIM o AS STRING, i AS INTEGER
    o$ = "(none)"
    FOR i% = 1 TO AI_STYLE_COUNT%
        o$ = o$ + "|" + RTRIM$(AI_STYLES(i%).styleName)
    NEXT i%
    AI_items_styles$ = o$
END FUNCTION


''
' Pipe-delimited prompt-preset labels with a leading "(none)".
' @return STRING - "(none)|label|..."
'
FUNCTION AI_items_prompts$ ()
    DIM o AS STRING, i AS INTEGER
    o$ = "(none)"
    FOR i% = 1 TO AI_PROMPT_COUNT%
        o$ = o$ + "|" + RTRIM$(AI_PROMPTS(i%).label)
    NEXT i%
    AI_items_prompts$ = o$
END FUNCTION


''
' Remember the last-used tool / style / size / seed across sessions.
' Written as a [LAST] section in DRAW.ai.cfg by AI_config_save.
'
SUB AI_remember_choices ()
    AI_config_save
END SUB


''
' Collapse newlines and tabs to single spaces.
'
' The prompt text area accepts multi-line input, but the prompt is passed as a
' quoted shell argument — a raw newline there would terminate the command.
'
' @param src STRING - Possibly multi-line text
' @return STRING - Single-line equivalent
'
FUNCTION AI_flatten_lines$ (src AS STRING)
    DIM s AS STRING, o AS STRING, c AS STRING
    DIM i AS INTEGER
    s$ = src$
    o$ = ""
    FOR i% = 1 TO LEN(s$)
        c$ = MID$(s$, i%, 1)
        IF c$ = CHR$(10) OR c$ = CHR$(13) OR c$ = CHR$(9) THEN
            IF LEN(o$) > 0 AND RIGHT$(o$, 1) <> " " THEN o$ = o$ + " "
        ELSE
            o$ = o$ + c$
        END IF
    NEXT i%
    AI_flatten_lines$ = _TRIM$(o$)
END FUNCTION


