''
' DRAW - INPUT/TABLET.BM
' =============================================================================
' Pen tablet pressure. See INPUT/TABLET.BI.
'
$INCLUDEONCE

''
' Start the pressure backend once (needs the window, so after SCREEN_init).
'
SUB PEN_init ()
    IF TABLET.tried THEN EXIT SUB
    IF NOT CFG.PEN_PRESSURE% THEN EXIT SUB
    TABLET.tried = TRUE
    TABLET.ready = PD_init%
    IF TABLET.ready THEN
        _LOGINFO "PEN: " + PD_backend_name$ + " - " + PD_status$
    ELSE
        _LOGINFO "PEN: no pressure backend (" + PD_status$ + ")"
    END IF
END SUB

''
' Once per frame, before mouse handling.
'
SUB PEN_poll ()
    IF NOT CFG.PEN_PRESSURE% THEN EXIT SUB
    IF NOT TABLET.tried THEN PEN_init
    IF TABLET.ready THEN PD_poll
END SUB

''
' TRUE when pressure should shape the current stroke: feature on, backend
' running and the last pointer event came from a pen (or pressure trackpad).
'
FUNCTION PEN_active% ()
    PEN_active% = FALSE
    IF NOT CFG.PEN_PRESSURE% THEN EXIT FUNCTION
    IF NOT TABLET.ready THEN EXIT FUNCTION
    PEN_active% = (PD_source% <> PD_SRC_MOUSE)
END FUNCTION

''
' Brush / eraser press: forget the previous stroke's pressure.
'
SUB PEN_stroke_begin ()
    TABLET.lastValid = -1
    TABLET.segP0     = -1
    TABLET.segP1     = 1
    TABLET.dabP      = 1
    TABLET.usingPen  = FALSE
    TABLET.skipSeg   = FALSE
    TABLET.painted   = FALSE
    TABLET.penSeen   = FALSE
END SUB

''
' Pressure for drawing right now, after the pressure curve. A reading below
' PEN_MIN_VALID is the pen landing or lifting (it arrives a moment before or
' after the button): hold the last real value instead, so strokes don't start
' with a blob or end with a hairline flick.
'
FUNCTION PEN_stroke_pressure! ()
    DIM p AS SINGLE
    p! = PD_pressure!
    IF p! >= PEN_MIN_VALID THEN
        TABLET.lastValid = p!
    ELSEIF TABLET.lastValid >= 0 THEN
        p! = TABLET.lastValid
    ELSE
        p! = PEN_MIN_VALID
    END IF
    ' Pen Control: pressure processing, then the speed gain, then the curve
    IF PPROC_on% THEN p! = PPROC_step!(p!, TIMER(.001))
    IF TABLET.speedOn THEN
        p! = p! * PSPD.gain
        IF p! > 1 THEN p! = 1
        IF p! < PEN_MIN_VALID THEN p! = PEN_MIN_VALID
    END IF
    PEN_stroke_pressure! = PD_curve!(p!, CFG.PEN_PRESSURE_CURVE% / 100!)
END FUNCTION

''
' Called by PAINT_on before a frame's segment: fixes the pressure at both ends
' so each dab can interpolate between them.
'
SUB PEN_segment_begin ()
    ' Catch Up after a lift: the pen is off the tablet (no pressure, maybe out
    ' of range), so the stroke's tail keeps the pressure it last had
    IF TABLET.catching THEN
        TABLET.usingPen = TABLET.penSeen
        TABLET.skipSeg  = FALSE
        IF TABLET.usingPen THEN
            IF TABLET.segP0 < 0 THEN TABLET.segP0 = TABLET.segP1
            TABLET.segP0 = TABLET.segP1: TABLET.dabP = TABLET.segP1
        ELSE
            TABLET.segP0 = 1: TABLET.segP1 = 1: TABLET.dabP = 1
        END IF
        EXIT SUB
    END IF
    TABLET.usingPen = PEN_active%
    TABLET.skipSeg  = FALSE
    IF NOT TABLET.usingPen THEN
        TABLET.segP0 = 1: TABLET.segP1 = 1: TABLET.dabP = 1
        IF TABLET.opStroke THEN TABLET.dabOp = PAINT_OPACITY% / 100!
        TABLET.painted = TRUE
        EXIT SUB
    END IF
    TABLET.penSeen = TRUE
    ' Tip threshold: a pen that grazes the tablet can report a click at almost
    ' no pressure. Draw nothing until the pen presses at least this hard.
    IF CFG.PEN_TIP_THRESHOLD% > 0 _ANDALSO PD_pressure! < CFG.PEN_TIP_THRESHOLD% / 100! THEN
        TABLET.skipSeg = TRUE
        TABLET.segP0   = -1 ' resume from the real pressure, not a stale one
        EXIT SUB
    END IF
    TABLET.painted = TRUE
    IF TABLET.subN > 1 THEN
        ' a frame drawn in pieces (MOUSE_brush_samples): read the pressure once,
        ' and give each piece its share of the frame's change
        IF TABLET.subTo < 0 THEN
            TABLET.subTo = PEN_stroke_pressure!
            TABLET.subFrom = TABLET.segP0: IF TABLET.subFrom < 0 THEN TABLET.subFrom = TABLET.subTo
        END IF
        TABLET.segP0 = TABLET.subFrom + (TABLET.subTo - TABLET.subFrom) * (TABLET.subK - 1) / TABLET.subN
        TABLET.segP1 = TABLET.subFrom + (TABLET.subTo - TABLET.subFrom) * TABLET.subK / TABLET.subN
    ELSE
        TABLET.segP1 = PEN_stroke_pressure!
    END IF
    IF TABLET.segP0 < 0 THEN TABLET.segP0 = TABLET.segP1
    TABLET.dabP = TABLET.segP1
    ' Paths that don't interpolate per dab (pixel perfect) use the segment's end.
    IF TABLET.opStroke THEN TABLET.dabOp = PEN_dab_op!(TABLET.segP1)
END SUB

''
' TRUE when a pen stroke drew nothing (it never passed the tip threshold), so
' no undo step should be recorded for it. Strokes that never ran a pen segment
' (mouse, custom brush, smart erase) are never "empty".
'
FUNCTION PEN_stroke_empty% ()
    PEN_stroke_empty% = TABLET.penSeen _ANDALSO NOT TABLET.painted
END FUNCTION

SUB PEN_segment_end ()
    TABLET.segP0 = TABLET.segP1
    TABLET.aaT = FALSE
END SUB

''
' Pressure of the dab at fraction t (0..1) along the current segment.
'
FUNCTION PEN_dab_pressure! (t AS SINGLE)
    PEN_dab_pressure! = TABLET.segP0 + (TABLET.segP1 - TABLET.segP0) * t!
END FUNCTION

''
' TRUE when this stroke's brush size should follow pressure.
'
FUNCTION PEN_size_active% ()
    PEN_size_active% = FALSE
    IF NOT TABLET.usingPen THEN EXIT FUNCTION
    IF NOT CFG.PEN_PRESSURE_SIZE% THEN EXIT FUNCTION
    IF CURRENT_TOOL% <> TOOL_BRUSH AND CURRENT_TOOL% <> TOOL_ERASER THEN EXIT FUNCTION
    IF CUSTOM_BRUSH_is_active% THEN EXIT FUNCTION
    IF BRUSH_SIZE.PIXEL_PERFECT THEN EXIT FUNCTION
    PEN_size_active% = (BRUSH_SIZE_pixels% > 1)
END FUNCTION

''
' Brush size in pixels for a pressure: from PEN_MIN_SIZE % of the brush at the
' lightest touch up to the full brush size at full pressure (never below 1).
'
FUNCTION PEN_scaled_size% (baseSize AS INTEGER, p AS SINGLE)
    DIM f AS SINGLE, minF AS SINGLE, s AS INTEGER
    minF! = CFG.PEN_MIN_SIZE% / 100!
    IF minF! < 0 THEN minF! = 0
    IF minF! > 1 THEN minF! = 1
    f! = minF! + (1 - minF!) * p!
    s% = INT(baseSize% * f! + 0.5)
    IF s% < 1 THEN s% = 1
    IF s% > baseSize% THEN s% = baseSize%
    PEN_scaled_size% = s%
END FUNCTION

''
' Map a 0..1 pressure onto a lightest-touch..100% range: minPct at no
' pressure, 1 at full pressure.
'
FUNCTION PEN_range! (p AS SINGLE, minPct AS INTEGER)
    DIM f AS SINGLE
    f! = minPct% / 100!
    IF f! < 0 THEN f! = 0
    IF f! > 1 THEN f! = 1
    PEN_range! = f! + (1 - f!) * p!
END FUNCTION

''
' Mix brush: smudge share for the current dab. The new paint each dab lays is
' scaled by pressure (from PEN_MIX_MIN % at the lightest touch to the full
' amount), so a light touch smears more.
'
FUNCTION PEN_mix_smudge% (smudge AS INTEGER)
    DIM s AS INTEGER
    s% = smudge%
    IF TABLET.usingPen _ANDALSO CFG.PEN_PRESSURE_MIX% THEN
        s% = 100 - INT((100 - s%) * PEN_range!(TABLET.dabP, CFG.PEN_MIX_MIN%) + 0.5)
    END IF
    IF s% < 0 THEN s% = 0
    IF s% > 100 THEN s% = 100
    PEN_mix_smudge% = s%
END FUNCTION


' =============================================================================
' Pressure -> opacity
' =============================================================================

''
' Brush / Eraser press: start a pressure-opacity stroke when the option is on
' and the pen is in use. Takes a layer snapshot and a per-pixel mask. Call
' before STROKE_begin (which then stands aside: this stroke applies its
' opacity live, the plain Opacity setting included).
'
SUB PEN_opacity_begin ()
    DIM img AS LONG, aa AS INTEGER
    PEN_opacity_end
    ' Antialias on with a round brush (Rick 2026-11-17): the pen stroke's dabs get
    ' fractional sizes and centers - every size 1, 2, 3 ... and a soft 1px line - and
    ' go through this per-pixel mask too, so overlapping soft dabs never darken.
    ' (Not the mix brush: it mixes against the live layer.)
    ' The mouse too (Rick 2026-11-17, "our anti aliasing algorithm is pretty
    ' shitty"): its soft circles used to stack up over each other until every
    ' edge pixel was solid - a hard edge.
    aa% = (CFG.ANTIALIAS% <> 0 _ANDALSO BRUSH_SIZE.SHAPE = 0 _ANDALSO (CFG.BRUSH_MIX% = 0 _ORELSE CURRENT_TOOL% <> TOOL_BRUSH))
    IF CFG.PEN_PRESSURE_OPACITY% = 0 _ANDALSO aa% = 0 THEN EXIT SUB
    IF aa% = 0 _ANDALSO NOT PEN_active% THEN EXIT SUB
    IF CURRENT_TOOL% <> TOOL_BRUSH AND CURRENT_TOOL% <> TOOL_ERASER THEN EXIT SUB
    IF CUSTOM_BRUSH_is_active% THEN EXIT SUB
    IF BRUSH_HISTORY_SMART% THEN EXIT SUB
    IF BRUSH_SIZE.PIXEL_PERFECT AND BRUSH_SIZE_pixels% = 1 THEN EXIT SUB ' 1px pixel-perfect stays a plain pencil
    IF CURRENT_LAYER% < 1 OR CURRENT_LAYER% > MAX_LAYERS THEN EXIT SUB
    img& = LAYERS(CURRENT_LAYER%).imgHandle&
    IF img& >= -1 THEN EXIT SUB
    TABLET.opBakImg = _COPYIMAGE(img&, 32)
    IF TABLET.opBakImg >= -1 THEN TABLET.opBakImg = 0: EXIT SUB
    TABLET_BAK_MEM = _MEMIMAGE(TABLET.opBakImg)
    TABLET.opW = _WIDTH(img&)
    TABLET.opH = _HEIGHT(img&)
    TABLET_MASK_MEM = _MEMNEW(TABLET.opW * TABLET.opH)
    _MEMFILL TABLET_MASK_MEM, TABLET_MASK_MEM.OFFSET, TABLET_MASK_MEM.SIZE, 0 AS _UNSIGNED _BYTE
    TABLET.dabOp    = PAINT_OPACITY% / 100!
    TABLET.opErase  = (_ALPHA32(DRAW_COLOR~&) = 0)
    TABLET.opStroke = TRUE
    TABLET.opByP    = (CFG.PEN_PRESSURE_OPACITY% <> 0)
    TABLET.aaPen    = aa%
    TABLET.aaHas    = FALSE
    TABLET.aaT      = FALSE
    ' Per-pixel opacity can't be replayed as fixed brush calls: export as pixels.
    BRUSH_HISTORY_FLAGS& = BRUSH_HISTORY_FLAGS& OR HISTORY_FLAG_PAINT_MODE
END SUB

''
' End the pressure-opacity stroke and free its buffers. Safe to call any time.
'
SUB PEN_opacity_end ()
    IF TABLET.opBakImg < -1 THEN
        _MEMFREE TABLET_BAK_MEM
        _FREEIMAGE TABLET.opBakImg
        _MEMFREE TABLET_MASK_MEM
    END IF
    TABLET.opBakImg = 0
    TABLET.opStroke = FALSE
    TABLET.opByP    = FALSE
    TABLET.aaPen    = FALSE
    TABLET.aaHas    = FALSE
    TABLET.aaT      = FALSE
    TABLET.dabOp    = 1
END SUB

''
' The exact end of the next antialiased stroke segment: a pointer position in
' MOUSE.FX terms (pixel x spans x..x+1). PAINT_on draws whole pixels; this
' gives it the sub-pixel point the whole pixel came from.
SUB PEN_aa_target (fx AS DOUBLE, fy AS DOUBLE)
    TABLET.aaT = TRUE
    TABLET.aaTX = fx - 0.5#
    TABLET.aaTY = fy - 0.5#
END SUB

''
' Opacity 0..1 of a dab at pressure p in a masked stroke: by pressure when that
' option is on, else the plain Opacity setting (an antialiased pen stroke).
'
FUNCTION PEN_dab_op! (p AS SINGLE)
    IF TABLET.opByP THEN PEN_dab_op! = PEN_opacity_for!(p!) ELSE PEN_dab_op! = PAINT_OPACITY% / 100!
END FUNCTION

''
' PEN_scaled_size% without the rounding, for antialiased dabs: a pressure's
' size in pixels, any fraction, from 1 up to the brush size.
'
FUNCTION PEN_size_frac! (baseSize AS INTEGER, p AS SINGLE)
    DIM s AS SINGLE
    s! = baseSize% * PEN_range!(p!, CFG.PEN_MIN_SIZE%)
    IF s! < 1 THEN s! = 1
    IF s! > baseSize% THEN s! = baseSize%
    PEN_size_frac! = s!
END FUNCTION

''
' Opacity 0..1 for a dab at pressure p: Lightest Touch Opacity % .. 100%,
' times the plain Opacity setting.
'
FUNCTION PEN_opacity_for! (p AS SINGLE)
    PEN_opacity_for! = PEN_range!(p!, CFG.PEN_MIN_OPACITY%) * PAINT_OPACITY% / 100!
END FUNCTION

''
' Write one pixel of a pressure-opacity stroke at BUFFER coords (bx, by) on
' the current _DEST (the layer). The pixel becomes the stroke-start pixel with
' col composited over it at the strongest opacity reached there this stroke
' (TABLET.dabOp x coverage), composited straight-alpha source-over. In an
' erasing stroke a transparent col removes that share of the original alpha;
' in a painting stroke it is a pattern hole and the pixel is left alone.
' Leaves the layer in _BLEND, or _DONTBLEND for a transparent col.
'
SUB PEN_op_write (bx AS LONG, by AS LONG, col AS _UNSIGNED LONG, coverage AS SINGLE)
    DIM idx AS LONG, m AS INTEGER, e AS INTEGER, a AS INTEGER
    DIM bk AS _UNSIGNED LONG, c AS _UNSIGNED LONG
    IF bx& < 0 OR by& < 0 OR bx& >= TABLET.opW OR by& >= TABLET.opH THEN EXIT SUB
    c~& = col~&
    ' A transparent color only erases in an erasing stroke. When painting, it is
    ' a hole in a pattern / gradient: leave the pixel as it is (as plain PSET does).
    IF _ALPHA32(c~&) = 0 _ANDALSO NOT TABLET.opErase THEN EXIT SUB
    idx& = by& * TABLET.opW + bx&
    m% = _MEMGET(TABLET_MASK_MEM, TABLET_MASK_MEM.OFFSET + idx&, _UNSIGNED _BYTE)
    e% = INT(TABLET.dabOp * coverage! * 255 + 0.5)
    IF e% > 255 THEN e% = 255
    ' no stronger than this stroke already put here: the pixel would come out the
    ' same (overlapping dabs - most of every dab - cost nothing)
    IF e% <= m% THEN EXIT SUB
    m% = e%
    _MEMPUT TABLET_MASK_MEM, TABLET_MASK_MEM.OFFSET + idx&, m% AS _UNSIGNED _BYTE
    bk~& = _MEMGET(TABLET_BAK_MEM, TABLET_BAK_MEM.OFFSET + idx& * 4, _UNSIGNED LONG)
    _DONTBLEND
    IF _ALPHA32(c~&) = 0 THEN
        a% = INT(_ALPHA32(bk~&) * (255 - m%) / 255 + 0.5)
        PSET (bx&, by&), _RGBA32(_RED32(bk~&), _GREEN32(bk~&), _BLUE32(bk~&), a%)
        EXIT SUB
    END IF
    ' Source-over in straight alpha, done here rather than with _BLEND, which
    ' mixes the RGB of a transparent destination (black) into the result and
    ' darkens light strokes on empty pixels.
    DIM sa AS SINGLE, da AS SINGLE, oa AS SINGLE, dw AS SINGLE
    sa! = (_ALPHA32(c~&) / 255!) * (m% / 255!)
    da! = _ALPHA32(bk~&) / 255!
    oa! = sa! + da! * (1 - sa!)
    IF oa! <= 0 THEN
        PSET (bx&, by&), bk~&
    ELSE
        dw! = da! * (1 - sa!)
        PSET (bx&, by&), _RGBA32(INT((_RED32(c~&) * sa! + _RED32(bk~&) * dw!) / oa! + 0.5), _
                                 INT((_GREEN32(c~&) * sa! + _GREEN32(bk~&) * dw!) / oa! + 0.5), _
                                 INT((_BLUE32(c~&) * sa! + _BLUE32(bk~&) * dw!) / oa! + 0.5), _
                                 INT(oa! * 255 + 0.5))
    END IF
    _BLEND
END SUB


' ============================================================================
' Pen Control: the stroke filters (INPUT/STABILIZER) - smoothing for Brush /
' Eraser strokes (pen or mouse), pressure processing and speed scaling (pen)
' ============================================================================

''
' The settings into STAB / PPROC / PSPD (each stroke, so a change in the panel
' or Settings applies to the next one)
SUB PENC_sync ()
    STAB.mode = STAB_OFF
    IF CFG.PEN_STAB% THEN STAB.mode = _MAX(STAB_PULLED, _MIN(STAB_MODE_COUNT, CFG.PEN_STAB_MODE%))
    STAB.amount = _MAX(0, _MIN(100, CFG.PEN_STAB_AMOUNT%))
    STAB.catchUp = (CFG.PEN_STAB_CATCHUP% <> 0)
    PPROC.mode = PPROC_OFF
    IF CFG.PEN_PROC% THEN PPROC.mode = _MAX(PPROC_FIXED, _MIN(PPROC_MODE_COUNT, CFG.PEN_PROC_MODE%))
    PPROC.amount = _MAX(0, _MIN(100, CFG.PEN_PROC_AMOUNT%))
    PSPD.slowGain = _MAX(10, _MIN(100, CFG.PEN_SPEED_SLOW%)) / 100!
    PSPD.fastGain = _MAX(100, _MIN(500, CFG.PEN_SPEED_FAST%)) / 100!
    PSPD.fastSpeed = _MAX(50, _MIN(3000, CFG.PEN_SPEED_FAST_AT%))
    PSPD.smooth = _MAX(0, _MIN(100, CFG.PEN_SPEED_SMOOTH%)) / 100!
END SUB

''
' Brush / Eraser press: start the filters. smart% = a Shift smart erase (not
' smoothed: it erases what is under the pointer).
SUB PENC_stroke_begin (smart AS INTEGER)
    DIM t AS DOUBLE
    PENC_sync
    t = TIMER(.001)
    TABLET.stepT = t: TABLET.subN = 0
    TABLET.catching = FALSE
    TABLET.stabOn = (STAB_on% <> 0 _ANDALSO smart = 0)
    IF TABLET.stabOn THEN STAB_begin PENC_fx#, PENC_fy#, t ELSE STAB_end
    TABLET.stabDX = MOUSE.X%: TABLET.stabDY = MOUSE.Y%
    PPROC_begin
    TABLET.speedOn = (CFG.PEN_SPEED% <> 0 _ANDALSO PSPD_on%)
    PSPD_begin CDBL(MOUSE.RAW_X%), CDBL(MOUSE.RAW_Y%), t
END SUB

' The pointer for smoothing: the sub-pixel canvas position, or the snapped
' pixel's centre when grid snap moved the point
FUNCTION PENC_fx# ()
    IF INT(MOUSE.FX) <> MOUSE.X% THEN PENC_fx# = MOUSE.X% + 0.5# ELSE PENC_fx# = MOUSE.FX
END FUNCTION
FUNCTION PENC_fy# ()
    IF INT(MOUSE.FY) <> MOUSE.Y% THEN PENC_fy# = MOUSE.Y% + 0.5# ELSE PENC_fy# = MOUSE.FY
END FUNCTION

''
' A held frame: the speed gain, and the smoothed point to draw to (sx, sy;
' the pointer itself when smoothing is off)
SUB PENC_stroke_step (sx AS INTEGER, sy AS INTEGER)
    DIM t AS DOUBLE, z AS SINGLE, g AS SINGLE
    t = TIMER(.001)
    TABLET.stepT = t
    g = PSPD_step!(CDBL(MOUSE.RAW_X%), CDBL(MOUSE.RAW_Y%), t)
    sx = MOUSE.X%: sy = MOUSE.Y%
    IF TABLET.stabOn = 0 THEN EXIT SUB
    z = SCRN.zoom!: IF z <= 0 THEN z = 1
    DIM ox AS DOUBLE, oy AS DOUBLE
    ox = STAB.x: oy = STAB.y
    STAB_step PENC_fx#, PENC_fy#, t, STAB.amount / z ' Pulled String: Amount screen px
    sx = INT(STAB.x): sy = INT(STAB.y)
    ' the point moves while the pointer rests (Catch Up, Inertia): keep the
    ' frames coming so it draws and the guides follow
    IF STAB.x <> ox _ORELSE STAB.y <> oy _ORELSE STAB.rawX <> STAB.x _ORELSE STAB.rawY <> STAB.y THEN FRAME_IDLE% = FALSE: SCENE_DIRTY% = TRUE
END SUB

' TRUE while a stroke's points are smoothed
FUNCTION PENC_stab_stroke% ()
    PENC_stab_stroke% = (TABLET.stabOn <> 0 _ANDALSO STAB.active <> 0)
END FUNCTION

''
' Lift (or a document reset): forget the stroke. The release path runs the
' Catch Up tail first (MOUSE_brush_catch_up).
SUB PENC_stroke_end ()
    TABLET.catching = FALSE
    TABLET.stabOn = FALSE
    STAB_end
    PSPD_end
END SUB
