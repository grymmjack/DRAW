''
' DRAW - INPUT/NUMPAD.BM
' =============================================================================
' Numpad detection (see NUMPAD.BI). Ported from bu1ld0r.
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Once a frame: note each new numpad press in NP_T. A key going down counts
' unless the device queue already reported that press (.3 s).
SUB NUMPAD_poll ()
    DIM b AS INTEGER, h AS INTEGER, t AS DOUBLE
    NUMPAD_dev
    t = TIMER(.001)
    FOR b = 1 TO NP_N
        h = NUMPAD_held%(b)
        IF h _ANDALSO NP_HELD(b) = 0 THEN
            IF NP_T(b) < 0 _ANDALSO (NP_DEVT(b) < 0 _ORELSE t < NP_DEVT(b) _ORELSE t - NP_DEVT(b) > .3) THEN NP_T(b) = t
        END IF
        NP_HELD(b) = h
    NEXT b
END SUB

''
' [Linux] The keyboard device's queue: mark a numpad key's press (NP_T) even
' when it went down and up between two frames, which _KEYDOWN misses. QB64
' queues the device event before the key itself. Ids are X11 key codes + 1.
SUB NUMPAD_dev ()
    $IF LINUX THEN
        DIM b AS INTEGER, id AS INTEGER, d AS LONG, nb AS LONG
        IF NP_READY = 0 THEN d = _DEVICES: NP_READY = -1
        d = _DEVICEINPUT
        DO WHILE d
            IF d = 1 THEN
                nb = _LASTBUTTON(1)
                FOR b = 1 TO NP_N
                    id = NUMPAD_id%(b)
                    IF id <= nb THEN
                        IF _BUTTONCHANGE(id) = -1 THEN NP_T(b) = TIMER(.001): NP_DEVT(b) = NP_T(b)
                    END IF
                NEXT b
            END IF
            d = _DEVICEINPUT
        LOOP
    $END IF
END SUB

''
' Is numpad key b down? QB64's own codes: Num Lock on 100256 + n, off 200000 + n.
FUNCTION NUMPAD_held% (b AS INTEGER)
    SELECT CASE b
        CASE 1 TO 9: NUMPAD_held% = _KEYDOWN(100256 + b) OR _KEYDOWN(200000 + b)
        CASE 10: NUMPAD_held% = _KEYDOWN(100256) OR _KEYDOWN(200000)
        CASE 11: NUMPAD_held% = _KEYDOWN(100266) OR _KEYDOWN(200010)
        CASE 12: NUMPAD_held% = _KEYDOWN(100270)
        CASE 13: NUMPAD_held% = _KEYDOWN(100269)
        CASE 14: NUMPAD_held% = _KEYDOWN(100268)
        CASE 15: NUMPAD_held% = _KEYDOWN(100267)
        CASE 16: NUMPAD_held% = _KEYDOWN(100271)
    END SELECT
END FUNCTION

''
' [Linux] Numpad key b as the keyboard device numbers it (X11 key code + 1;
' Enter and / + 256).
FUNCTION NUMPAD_id% (b AS INTEGER)
    SELECT CASE b
        CASE 1: NUMPAD_id% = 88
        CASE 2: NUMPAD_id% = 89
        CASE 3: NUMPAD_id% = 90
        CASE 4: NUMPAD_id% = 84
        CASE 5: NUMPAD_id% = 85
        CASE 6: NUMPAD_id% = 86
        CASE 7: NUMPAD_id% = 80
        CASE 8: NUMPAD_id% = 81
        CASE 9: NUMPAD_id% = 82
        CASE 10: NUMPAD_id% = 91
        CASE 11: NUMPAD_id% = 92
        CASE 12: NUMPAD_id% = 87
        CASE 13: NUMPAD_id% = 83
        CASE 14: NUMPAD_id% = 64
        CASE 15: NUMPAD_id% = 363
        CASE 16: NUMPAD_id% = 361
    END SELECT
END FUNCTION

''
' The numpad key a plain code could have come from: its digit / sign with Num
' Lock on, or End, the arrows, Home, PgUp, Ins, Del with it off. 0 = none.
FUNCTION NUMPAD_of% (k AS LONG)
    SELECT CASE k
        CASE 49 TO 57: NUMPAD_of% = k - 48
        CASE 48: NUMPAD_of% = 10
        CASE 46: NUMPAD_of% = 11
        CASE 43: NUMPAD_of% = 12
        CASE 45: NUMPAD_of% = 13
        CASE 42: NUMPAD_of% = 14
        CASE 47: NUMPAD_of% = 15
        CASE 13: NUMPAD_of% = 16
        CASE 20224: NUMPAD_of% = 1 ' End
        CASE 20480: NUMPAD_of% = 2 ' Down
        CASE 20736: NUMPAD_of% = 3 ' PgDn
        CASE 19200: NUMPAD_of% = 4 ' Left
        CASE 19456: NUMPAD_of% = 5 ' the middle (no key of its own)
        CASE 19712: NUMPAD_of% = 6 ' Right
        CASE 18176: NUMPAD_of% = 7 ' Home
        CASE 18432: NUMPAD_of% = 8 ' Up
        CASE 18688: NUMPAD_of% = 9 ' PgUp
        CASE 20992: NUMPAD_of% = 10 ' Ins
        CASE 21248: NUMPAD_of% = 11 ' Del
    END SELECT
END FUNCTION

''
' Did the numpad send code k? Returns its numpad key (b), or 0.
FUNCTION NUMPAD_sent% (k AS LONG)
    DIM b AS INTEGER, t AS DOUBLE
    b = NUMPAD_of%(k)
    IF b = 0 THEN EXIT FUNCTION
    NUMPAD_dev ' pressed since this frame's poll
    t = TIMER(.001)
    IF NP_HELD(b) _ORELSE NUMPAD_held%(b) _ORELSE (NP_T(b) >= 0 _ANDALSO t >= NP_T(b) _ANDALSO t - NP_T(b) < .25) THEN NUMPAD_sent% = b
END FUNCTION
