ORDER=preview,edit-bar,|,char-map,char-grid,char-grid-snap,|,tile-mode,grid-cell-fill,grid-brush-size,fill-adjust,|,brush-edges,angle-snap,grayscale,cmd:332,|,ref-on,ref-load,ref-clear,ref-adjust,|,align-left,align-center,align-right,align-top,align-middle,align-bottom,|,distribute-h,distribute-v,|,cmd:950,cmd:2060,|,cmd:453

