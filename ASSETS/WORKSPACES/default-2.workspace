; DRAW workspace - Default (once called Default 2)
; The workspace DRAW starts in (WORKSPACE_HOME): shown as Default in View > Workspace,
; the switcher and the workflow buttons. Format: docs/MANUAL/22-workspaces-capture.md, Workspace files

[WORKSPACE]
NAME=DEFAULT 2
DESCRIPTION=The everyday layout DRAW starts in

[CHROME]
MENUBAR=SHOW
TOOLBOX=SHOW
LAYER_PANEL=SHOW
EDIT_BAR=SHOW
ADVANCED_BAR=SHOW
STATUS_BAR=SHOW
PREVIEW=HIDE
COLOR_MIXER=HIDE
CHARMAP=HIDE
