BUTTONS=move,hand,zoom,crop,marquee,marquee-free,marquee-poly,marquee-ellipse,wand,picker,text,eraser,dot,brush,cmd:2680,spray,fill,line,polygon,polygon-filled,save,bezier,rect,rect-filled,export-sel,smart-shapes,ellipse,ellipse-filled,open,cmd:2450,cmd:1820,cmd:958

[EDIT_BAR]
COLUMNS=1
ORDER=undo,redo,|,cut,copy,copy-merged,paste,paste-in-place,|,cut-to-layer,copy-to-layer,|,clear,|,fill-fg,fill-bg,stroke,|,flip-h,flip-v,scale-down,scale-up,rotate-cw,rotate-ccw,|,smart-guides,smart-guides-snap,|,edge-mode,|,flip-canvas-h,flip-canvas-v,|,cmd:413,cmd:2400,cmd:2401,cmd:2471

[ADVANCED_BAR]
