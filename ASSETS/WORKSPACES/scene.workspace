; DRAW workspace - Scene
; Put a scene together over time from clips: one big frame with the X-sheet
; under it (every layer's cels, clip bars, keyframe lanes, sounds), the
; layers, the Animation panel and the Drawer's AnimBrushes to place as clips.
; No onion skin. Numpad: 1 / 4 / 5 / 9 first / previous / next / last frame,
; Enter play, 8 X-sheet, * panes.
; Ctrl+Shift+W switches workspaces; F11 shows everything.

[WORKSPACE]
NAME=Scene
SHORT=SCENE
DESCRIPTION=Clips over time: big frame + X-sheet, layers, Drawer
BASED_ON=default

[CHROME]                    ; SHOW | HIDE | KEEP (keep = whatever you have now)
ANIM_PANEL=SHOW
LAYER_PANEL=SHOW
DRAWER=SHOW
CHARMAP=HIDE
COLOR_SPACE_3D=HIDE
BROWSER=HIDE
SWATCHES=HIDE

[OPTIONS]                   ; any DRAW.cfg key, this session only
LIGHTBOX=1
LIGHTBOX_PANES=1
XSHEET=1
ONION_SKIN=0
FRAME_GRID=1

[START]
TOOL=move
