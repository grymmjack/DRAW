; DRAW workspace - Animate
; Frame-by-frame animation: the lightbox (strip, transport bar, the frames
; before and after side by side) with onion skin, and the Animation panel.
; On a picture without frames, Num + (or the panel's frame size) makes frames
; and the lightbox opens on them.
; Numpad: 1 / 4 / 5 / 9 first / previous / next / last frame, Enter play,
; + add a frame, 0 lightbox / sheet, 8 X-sheet, / onion skin, . full screen.
; Ctrl+Shift+W switches workspaces; F11 shows everything.

[WORKSPACE]
NAME=Animate
SHORT=ANIMATE
DESCRIPTION=Frame by frame: lightbox, onion skin, Animation panel
BASED_ON=default

[CHROME]                    ; SHOW | HIDE | KEEP (keep = whatever you have now)
ANIM_PANEL=SHOW
LAYER_PANEL=SHOW
CHARMAP=HIDE
COLOR_SPACE_3D=HIDE
BROWSER=HIDE

[OPTIONS]                   ; any DRAW.cfg key, this session only
LIGHTBOX=1
ONION_SKIN=1
FRAME_GRID=1
