; DRAW workspace - Simple
; A calm DRAW: the everyday drawing tools, four menus, no power-user panels.
; Anything hidden here is still reachable from the command palette (?) and its
; shortcut key. Ctrl+Shift+W switches workspaces; F11 shows everything.

[WORKSPACE]
NAME=Simple
DESCRIPTION=Everyday drawing tools, fewer panels and menus

[CHROME]                    ; SHOW | HIDE | KEEP (keep = whatever you have now)
MENUBAR=SHOW
TOOLBOX=SHOW
ORGANIZER=SHOW
DRAWER=HIDE
LAYER_PANEL=SHOW
EDIT_BAR=SHOW
ADVANCED_BAR=HIDE
STATUS_BAR=SHOW
PALETTE_STRIP=SHOW
PREVIEW=HIDE
COLOR_MIXER=HIDE
CHARMAP=HIDE
COLOR_SPACE_3D=HIDE

[TOOLBOX]
COLUMNS=2
BUTTONS=brush,eraser,fill,picker,line,rect,ellipse,text,move,marquee

[MENUS]
ROOTS=FILE,EDIT,VIEW,HELP
