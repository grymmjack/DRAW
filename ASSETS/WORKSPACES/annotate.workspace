; DRAW workspace - Annotate
; Mark up screenshots: shapes, arrows, text, highlight, redact, numbered
; callouts. Capture Screen (Ctrl+Shift+P, or DRAW --capture) lands here.
; Single-letter keys below work only while this workspace is active.
; Ctrl+Shift+W switches workspaces; F11 shows everything.

[WORKSPACE]
NAME=Annotate
DESCRIPTION=Mark up screenshots: shapes, arrows, text, highlight, redact
BASED_ON=default

[CHROME]                    ; SHOW | HIDE | KEEP (keep = whatever you have now)
MENUBAR=SHOW
TOOLBOX=SHOW
TOOLBOX_DOCK=LEFT
ORGANIZER=HIDE
DRAWER=HIDE
LAYER_PANEL=HIDE
EDIT_BAR=SHOW
ADVANCED_BAR=HIDE
STATUS_BAR=SHOW
PALETTE_STRIP=SHOW
PREVIEW=HIDE
COLOR_MIXER=HIDE
CHARMAP=HIDE
COLOR_SPACE_3D=HIDE

[TOOLBOX]
COLUMNS=2
BUTTONS=move,marquee,rect,ellipse,line,arrow,text,highlight,redact,callout,picker,crop

[MENUS]
ROOTS=FILE,EDIT,VIEW,IMAGE,HELP

[EDIT_BAR]
BUTTONS=undo,redo,|,copy,paste,|,zoomfit

[KEYS]                      ; only while this workspace is active
r=rect
R=rect-filled
o=ellipse
l=line
a=arrow
t=text
h=highlight
x=redact
n=callout
c=crop
v=move

[OPTIONS]                   ; any DRAW.cfg key, this session only
ANGLE_SNAP_DEGREES=45

[START]
TOOL=rect
FG=#FF2040
ZOOM=FIT
