; DRAW workspace - Sprite
; One small character or object and its frames, drawn big: the whole sheet
; with the frame grid, the Preview showing the current frame at its real
; size, the Animation panel and the Drawer for brushes and AnimBrushes.
; Numpad: 1 / 4 / 5 / 9 first / previous / next / last frame, Enter play,
; + add a frame, 0 lightbox, / onion skin.
; Ctrl+Shift+W switches workspaces; F11 shows everything.

[WORKSPACE]
NAME=Sprite
SHORT=SPRITE
DESCRIPTION=One sprite and its frames: sheet view, frame grid, Preview, Drawer
BASED_ON=default

[CHROME]                    ; SHOW | HIDE | KEEP (keep = whatever you have now)
ANIM_PANEL=SHOW
LAYER_PANEL=SHOW
PREVIEW=SHOW
DRAWER=SHOW
CHARMAP=HIDE
COLOR_SPACE_3D=HIDE
BROWSER=HIDE
SWATCHES=HIDE

[MENUS]
ROOTS=FILE,EDIT,VIEW,SELECT,TOOLS,BRUSH,LAYER,PALETTE,IMAGE,ANIM,HELP

[OPTIONS]                   ; any DRAW.cfg key, this session only
LIGHTBOX=0
FRAME_GRID=1
PREVIEW_SHOWS_FRAME=1
ONION_SKIN=0

[START]
TOOL=brush
