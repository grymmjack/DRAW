# Auto detect text files and perform LF normalization
* text=auto

# TheDraw font bundles and their .TDX index sidecars are binary. `* text=auto`
# above would otherwise be trusted to auto-detect them; state it explicitly so
# line-ending normalization can never silently corrupt a 21 MB glyph bundle.
*.TDF binary
*.TDX binary

# Override GitHub language detection
*.bas linguist-language=qb64
*.bi linguist-language=qb64
*.bm linguist-language=qb64
*.frm linguist-language=qb64
# ANSI-art files are byte-exact (CRLF, CP437 high bytes, binary headers) — never normalize
*.ans   -text
*.asc   -text
*.nfo   -text
*.diz   -text
*.bin   -text
*.xb    -text
*.xbin  -text
*.tnd   -text
