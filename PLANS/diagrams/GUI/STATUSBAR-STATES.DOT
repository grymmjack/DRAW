digraph STATUSBAR {
    label="STATUS BAR STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="STATUS BAR"];
    }

    S_VISIBLE [label="1 · VISIBLE\n─────────────────\nSCRN.showStatus% = TRUE\nBottom bar (THEME.STATUS_height%)\nSTATUS_render()\nREGION_STATUS_BAR registered"];
    S_HIDDEN [label="2 · HIDDEN\n─────────────────\nSCRN.showStatus% = FALSE\nSCRN.statusManuallyHidden% = TRUE\nNot rendered, region cleared"];

    S_VISIBLE -> S_HIDDEN [label="  F10 / View menu (action 402)" color="#cc6666" style=dashed];
    S_HIDDEN -> S_VISIBLE [label="  F10 / View menu (action 402)" color="#66cc66"];

    subgraph cluster_sections {
        label="STATUS BAR CONTENT (left → right)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        SEC_TOOL [label="Tool Name + Badges\n────────────\nCURRENT_TOOL% name (or TRANSFORM mode)\n\" AA\" badge when CFG.ANTIALIAS%\n\" SYM:n\" when SYMMETRY.MODE > 0\nContextual hints (crop / wand / move / text)"
                  fontsize=10.0];
        SEC_COLORS [label="Color Swatches\n────────────\nTransparent chip + FG + BG\nSTATUS_*_SWATCH_X/Y hitboxes\nHidden while TOOL_MARQUEE active"
                    fontsize=10.0];
        SEC_COORDS [label="Coordinates / Info\n────────────\nCanvas X, Y (MOUSE.X/Y)\nBrush size, zoom %, canvas dims\nUpdates every frame"
                    fontsize=10.0];
        SEC_MSG [label="Messages / Hints\n────────────\nTool-specific hint strings\n[ESC=DONE], [Enter=apply crop], etc.\nFile load/save feedback"
                 fontsize=10.0];
    }

    subgraph cluster_color_click {
        label="SWATCH CLICK (STATUS_handle_click)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        CC_IDLE [label="No Interaction\n────────────\nSwatches displayed\n(none for TOOL_MARQUEE)" fontsize=10.0];
        CC_TRANS [label="Transparent Chip\n────────────\nL: FG transparent (PAL_FG_IS_TRANSPARENT%)\nR: BG transparent (PAL_BG_IS_TRANSPARENT%)\nsets _RGBA32(0,0,0,0)" fontsize=10.0];
        CC_FG [label="FG Swatch\n────────────\nL: PALETTE_PICKER_show~&\nR: DRAW_pick_color& (GJ picker)\nM: _COLORCHOOSERDIALOG (OS native)\nsets PAINT_COLOR~&, PAL_FG_IDX%" fontsize=10.0];
        CC_BG [label="BG Swatch\n────────────\nL: PALETTE_PICKER_show~&\nR: DRAW_pick_color& (GJ picker)\nM: _COLORCHOOSERDIALOG (OS native)\nsets PAINT_BG_COLOR~&, PAL_BG_IDX%" fontsize=10.0];

        CC_IDLE -> CC_TRANS [label=" click transp chip" color="#88aacc" fontsize=8.0];
        CC_IDLE -> CC_FG [label=" click FG" color="#66cc66" fontsize=8.0];
        CC_IDLE -> CC_BG [label=" click BG" color="#66cc66" fontsize=8.0];
        CC_TRANS -> CC_IDLE [label=" flag set" color="#cccc66" fontsize=8.0];
        CC_FG -> CC_IDLE [label=" color set" color="#cccc66" fontsize=8.0];
        CC_BG -> CC_IDLE [label=" color set" color="#cccc66" fontsize=8.0];
    }

    MAIN -> S_VISIBLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }
}
