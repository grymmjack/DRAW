digraph ADV_COLOR_PICKER {
    label="ADVANCED COLOR PICKER STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [color=gray fontcolor="#aaaaaa" fontsize=9.0 fontname="Cascadia Code PL"];
    node [color=white shape=rect style="" fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="ADVANCED COLOR PICKER PANEL"];
    }

    S_HIDDEN [label="1 · HIDDEN\n─────────────────\nADVCP.visible% = FALSE\nCFG.ADV_COLOR_PICKER_VISIBLE% = FALSE\nPanel not rendered\nToggle via Action 2023:\n  View → Advanced Color Picker,\n  Ctrl+Shift+M, or MMB the Color\n  Mixer organizer button"];
    S_VISIBLE [label="2 · VISIBLE (idle)\n─────────────────\nADVCP.visible% = TRUE\nACP_STATE.dragging% = ACP_DRAG_NONE\nFloating panel drawn to screen 0\n(native buffer upscaled by ts/ds):\n  title bar · hue ring · SV triangle\n  shade rows · COLOR HISTORY strip\nADVCP_sync_from_paint keeps the\nwheel showing PAINT_COLOR~&"];
    S_PANEL_DRAG [label="3 · MOVING PANEL\n─────────────────\nADVCP.dragging% = TRUE\nB1 held on title bar (not the ✕)\nUpdate dispX/dispY from drag delta\nADVCP_clamp_to_work_area\nPersist CFG.ADV_COLOR_PICKER_X%/_Y%\nSCENE_DIRTY% = TRUE"];
    S_CTXMENU [label="4 · CONTEXT MENU\n─────────────────\nADVCP.cmOpen% = TRUE\nB2 over the history strip\nMENU CAPTURES ALL INPUT\n(ADVCP_render_context_menu):\n  • Create Palette → .gpl + load\n  • Clear History → ACP_history_clear\nMOUSE.UI_CHROME_CLICKED% = TRUE"];

    S_HIDDEN -> S_VISIBLE [label="  Action 2023 fired\n  (View / Ctrl+Shift+M /\n  MMB organizer btn)" color="#66cc66"];
    S_VISIBLE -> S_HIDDEN [label="  Action 2023 again\n  Title-bar ✕ (nativeX ≥ panelW-12)" color="#cc6666" style=dashed];
    S_VISIBLE -> S_PANEL_DRAG [label="  B1 press on title bar" color="#66cc66"];
    S_PANEL_DRAG -> S_VISIBLE [label="  B1 released\n  Position saved" color="#cccc66"];
    S_VISIBLE -> S_CTXMENU [label="  B2 press over history strip\n  (ACP_over_history%)" color="#66cc66"];
    S_CTXMENU -> S_VISIBLE [label="  Click: act on row / dismiss" color="#cccc66"];

    subgraph cluster_widget {
        label="WIDGET INTERACTION  (ACP_input_mouse, while VISIBLE)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        W_RING [label="ACP_DRAG_RING\n────────────\nLeft-drag on the hue ring\n→ hue; ACP_STATE.changed%\n→ PAINT_COLOR~& / DRAW_COLOR~&" fontsize=10.0];
        W_TRI [label="ACP_DRAG_TRIANGLE\n────────────\nLeft-drag in the SV triangle\n→ saturation + value\n→ PAINT_COLOR~& / DRAW_COLOR~&" fontsize=10.0];
        W_NEIGHBOR [label="ACP_DRAG_NEIGHBOR\n────────────\nDrag a hue-neighbor marker\non the ring → sets range\n(NO color change; repaint\nshade rows) ACP_pick_neighbor" fontsize=10.0];
        W_SHADE [label="Shade-row click\n────────────\nClick a value/sat/hue/warm/\ncool/… patch → ACP_set_rgb\nwheel + rows recompute" fontsize=10.0];
        W_HIST [label="History-chip click\n────────────\nLeft-click a recent color\n→ set FG (ACP_history_hit%)\nStrip pushed on stroke commit" fontsize=10.0];
    }

    S_VISIBLE -> W_RING [label="  B1 on ring" color="#66cc66" lhead=cluster_widget];
    W_RING -> S_VISIBLE [label="  B1 released (ACP_DRAG_NONE)" color="#cccc66" ltail=cluster_widget];

    subgraph cluster_persist {
        label="PERSISTENCE (DRAW.cfg)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        P1 [label="Visibility\n────────────\nADVCP.visible% ↔\nCFG.ADV_COLOR_PICKER_VISIBLE%" fontsize=10.0];
        P2 [label="Position\n────────────\ndispX/dispY ↔\nCFG.ADV_COLOR_PICKER_X% / _Y%" fontsize=10.0];
        P3 [label="Shade config\n────────────\nPRESET · SPREAD_V/S/H · WARMCOOL\nPATCHES · CURVE · LABELS\nQUANTIZE · HUE_NEIGHBORS" fontsize=10.0];
        P4 [label="History\n────────────\nHISTORY on/off ·\nBG_COLOR / BG_CUSTOM" fontsize=10.0];
    }

    subgraph cluster_config {
        label="CONFIG — Settings dialog only (standing rule)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        CFG1 [label="Settings → PANELS →\nAdvanced Color Picker\n────────────\nShade preset + spreads, warm/cool,\nquantize steps, row labels, shade\ncurve, history toggle, hue neighbors.\nNO separate config panel." fontsize=10.0];
    }

    MAIN -> S_HIDDEN [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deactivate" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Transition" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
