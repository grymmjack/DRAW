digraph PALETTE_OPS {
    label="PALETTE OPS STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [color=gray fontcolor="#aaaaaa" fontsize=9.0 fontname="Cascadia Code PL"];
    node [color=white shape=rect style="" fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="PALETTE OPS — ON-STRIP EDITING"];
    }

    S_NORMAL [label="1 · NORMAL MODE\n─────────────────\nPALETTE_OPS.ACTIVE% = FALSE\nStrip clicks pick FG/BG color\nStandard palette behavior"];
    S_ENTERING [label="2 · ENTERING OPS\n─────────────────\nPALETTE_OPS_activate\nAuto-remap canvas to current\npalette (PALETTE_LOADER_remap_to_palette)\nMarks cleared; NO dialog\n([DOCUMENT] snapshot deferred)"];
    S_OPS_IDLE [label="3 · OPS IDLE\n─────────────────\nPALETTE_OPS.ACTIVE% = TRUE\nVisual indicator on strip\nStrip cells are editable"];
    S_WAND [label="4 · WAND SELECT\n─────────────────\nSingle L-click strip color\n→ 500ms delay (PALETTE_OPS_tick)\n→ magic-wand select ALL\nmatching canvas pixels"];
    S_CHANGE [label="5 · CHANGE COLOR\n─────────────────\nDouble L-click → OS color dialog\nPALETTE_OPS_change_color\nReplaces old color across layers\nPAL().value~& updated"];
    S_MARK [label="6 · MARK COLOR\n─────────────────\nR-click toggles\nPALETTE_OPS_MARKED(idx)\n(marks drive batch delete)"];
    S_DELETE [label="7 · DELETE SLOT\n─────────────────\nM-click → PALETTE_OPS_delete_color\n(remap to nearest neighbor)\nMarked colors → delete_marked"];
    S_INSERT [label="8 · INSERT SLOT\n─────────────────\nShift+M-click\nPALETTE_OPS_insert_color\nBlank color at position"];
    S_REARRANGE [label="9 · DRAG TO REARRANGE\n─────────────────\nB1 drag > 3px (DRAG_ACTIVE%)\nDRAG_SRC_IDX% → DRAG_DST_IDX%\nRelease → PALETTE_OPS_rearrange"];
    S_EXITING [label="10 · EXITING OPS\n─────────────────\nPALETTE_OPS_deactivate\nClear wand selection + marks,\nmode off (tool switch / R-click\nPalette Ops widget / Escape)"];

    S_NORMAL -> S_ENTERING [label="  Ops mode toggled on" color="#66cc66"];
    S_ENTERING -> S_OPS_IDLE [label="  Canvas remapped" color="#cccc66"];
    S_OPS_IDLE -> S_WAND [label="  L-click cell (single)" color="#66cc66"];
    S_WAND -> S_OPS_IDLE [label="  Pixels selected" color="#cccc66"];
    S_OPS_IDLE -> S_CHANGE [label="  L-double-click cell" color="#66cc66"];
    S_CHANGE -> S_OPS_IDLE [label="  Dialog closed, color replaced" color="#cccc66"];
    S_OPS_IDLE -> S_MARK [label="  R-click cell" color="#66cc66"];
    S_MARK -> S_OPS_IDLE [label="  Mark toggled" color="#cccc66"];
    S_OPS_IDLE -> S_DELETE [label="  M-click cell" color="#66cc66"];
    S_DELETE -> S_OPS_IDLE [label="  Color removed" color="#cccc66"];
    S_OPS_IDLE -> S_INSERT [label="  Shift+M-click" color="#66cc66"];
    S_INSERT -> S_OPS_IDLE [label="  Blank inserted" color="#cccc66"];
    S_OPS_IDLE -> S_REARRANGE [label="  B1 drag begin" color="#66cc66"];
    S_REARRANGE -> S_OPS_IDLE [label="  B1 released, reordered" color="#cccc66"];
    S_OPS_IDLE -> S_EXITING [label="  Ops mode toggled off" color="#cc6666" style=dashed];
    S_EXITING -> S_NORMAL [label="  Marks + wand cleared" color="#cc6666" style=dashed];

    subgraph cluster_doc {
        label="[DOCUMENT] PALETTE" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        D1 [label="Lazy Snapshot\n────────────\nPALETTE_OPS_mark_document_palette\ncalled on first color edit,\nnot on Ops entry" fontsize=10.0];
        D2 [label="Document-Scoped\n────────────\nPALETTE_EMBEDDED_NAME = [DOCUMENT]\nSnapshot in PALETTE_DOC_COLORS()\nSerialized into .draw" fontsize=10.0];
        D3 [label="Restore\n────────────\nSelect [DOCUMENT] row in\npalette menu to restore\nPALETTE_DOC_COLORS()" fontsize=10.0];
    }

    subgraph cluster_actions {
        label="OPS ACTIONS (button map)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        A1 [label="L-click\n────────────\nWand select (500ms)" fontsize=10.0];
        A2 [label="L-double\n────────────\nChange + replace color" fontsize=10.0];
        A3 [label="R-click\n────────────\nToggle mark" fontsize=10.0];
        A4 [label="M-click\n────────────\nDelete (Shift = insert)" fontsize=10.0];
        A5 [label="Drag\n────────────\nRearrange order" fontsize=10.0];
    }

    MAIN -> S_NORMAL [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Action" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Exit" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Return" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
