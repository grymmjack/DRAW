digraph PALETTE_STRIP {
    label="COLOR STRIP / PALETTE STRIP STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="PALETTE STRIP"];
        MENU_F [label="PALETTE MENU"];
    }

    S_VISIBLE [label="1 · VISIBLE\n─────────────────\nPALETTE_STRIP_VISIBLE% = TRUE\nRendered when SCRN.showStatus%\nMulti-row color chips above\nstatus bar, arrows + name dropdown"];
    S_HIDDEN [label="2 · HIDDEN\n─────────────────\nNot rendered when\nSCRN.showStatus% = FALSE\n(bundled with status bar)"];
    S_HOVER [label="3 · HOVER COLOR\n─────────────────\nPALETTE_STRIP_HOVER_IDX% = idx\nColor highlighted\nRGB tooltip shown"];
    S_SELECT [label="4 · COLOR SELECTED\n─────────────────\nB1 = FG: PAL_FG_IDX%, PAINT_COLOR~&\nB2 = BG: PAL_BG_IDX%, PAINT_BG_COLOR~&\nPALETTE_STRIP_handle_click"];
    S_SCROLL [label="5 · SCROLLING\n─────────────────\nPALETTE_STRIP_SCROLL_OFFSET%\nArrows or mousewheel wrap\nShift/Ctrl = page scroll\n(CFG.PALETTE_MAX_CHIPS_PER_ROW%)"];

    S_VISIBLE -> S_HIDDEN [label="  Hide Status Bar + Strip\n  (action 439)" color="#cc6666" style=dashed];
    S_HIDDEN -> S_VISIBLE [label="  Show Status Bar + Strip\n  (action 439)" color="#66cc66"];
    S_VISIBLE -> S_HOVER [label="  Mouse over color chip" color="#88aacc"];
    S_HOVER -> S_SELECT [label="  B1 click (FG)\n  B2 click (BG)" color="#66cc66"];
    S_SELECT -> S_VISIBLE [label="  Color applied" color="#cccc66"];
    S_VISIBLE -> S_SCROLL [label="  Arrow / mousewheel\n  (Shift/Ctrl = page)" color="#88aacc"];
    S_SCROLL -> S_VISIBLE [label="  Scroll stop" color="#88aacc"];
    S_HOVER -> S_VISIBLE [label="  Mouse leaves" color="#cc6666" style=dashed];

    subgraph cluster_palette_menu {
        label="PALETTE MENU — Palette Selection" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        PM_CLOSED [label="Menu Closed\n────────────\nPALETTE_MENU_VISIBLE% = FALSE\nPalette name shown at right edge"
                   fontsize=10.0];
        PM_OPEN [label="Menu Open\n────────────\nPALETTE_MENU_show\nPALETTE_LOADER_COUNT% entries\n(~55 GPL + Lospec/Created,\noptional [DOCUMENT] row)\nType a letter = jump-to-palette"
                 fontsize=10.0];
        PM_SELECT [label="Palette Selected\n────────────\nPALETTE_LOADER_load_by_index%\nPAL().value~& updated\nPAL_set_defaults_by_size\nScroll reset, ops deactivated"
                   fontsize=10.0];

        PM_CLOSED -> PM_OPEN [label=" Click palette name area" color="#66cc66" fontsize=8.0];
        PM_OPEN -> PM_SELECT [label=" Click / Enter item" color="#cccc66" fontsize=8.0];
        PM_SELECT -> PM_CLOSED [label=" PALETTE_MENU_hide" color="#cc6666" fontsize=8.0 style=dashed];
        PM_OPEN -> PM_CLOSED [label=" Escape / click outside" color="#cc6666" fontsize=8.0 style=dashed];
    }

    MAIN -> S_VISIBLE [arrowhead=none color="#555555" style=dotted];
    MENU_F -> PM_CLOSED [arrowhead=none color="#555555" style=dotted lhead=cluster_palette_menu];
    { rank=min; MAIN; MENU_F }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Show / Open" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Hide / Close" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Select / Apply" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
