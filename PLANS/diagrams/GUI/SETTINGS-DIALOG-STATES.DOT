digraph SETTINGS_DIALOG {
    label="SETTINGS DIALOG STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [color=gray fontcolor="#aaaaaa" fontsize=9.0 fontname="Cascadia Code PL"];
    node [color=white shape=rect style="" fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="SETTINGS DIALOG"];
    }

    S_CLOSED [label="1 · CLOSED\n─────────────────\nSETTINGS_show_dialog not running\nNo modal loop active\nNormal app main loop"];
    S_OPENING [label="2 · OPENING\n─────────────────\nSETTINGS_show_dialog()\nBROWSER_suspend_for_modal\nDIALOG_init SETTINGS.ctx\nSETTINGS_load_shadow\n(CFG → SETTINGS_CFG shadow)"];
    S_OPEN [label="3 · OPEN (TABBED)\n─────────────────\nSelf-contained blocking modal loop\n(own _DISPLAY / _LIMIT FPS_DIALOG)\nLeft tab sidebar (8 tabs)\nScrollable right content\nOK / Cancel / Apply bar"];
    S_EDITING [label="4 · EDITING WIDGET\n─────────────────\nSW_draw_* widgets: checkbox /\nspinner / slider / dropdown /\ncolor chip. Edits SETTINGS_CFG\nshadow, sets pendingChanges = TRUE"];
    S_CONFIRMING [label="5 · APPLYING (OK)\n─────────────────\nOK pressed\nSETTINGS_apply_shadow\n(SETTINGS_CFG → CFG)\nCONFIG_save, close dialog"];
    S_CANCELING [label="6 · CANCELING\n─────────────────\nCancel / Esc\nShadow discarded\n(CFG never touched)"];

    S_CLOSED -> S_OPENING [label="  Edit → Settings... / Ctrl+,\n  (ACTION_SETTINGS = 2100)" color="#66cc66"];
    S_OPENING -> S_OPEN [label="  Shadow loaded,\n  modal loop starts" color="#cccc66"];
    S_OPEN -> S_EDITING [label="  Click input widget" color="#66cc66"];
    S_EDITING -> S_OPEN [label="  Commit → pendingChanges" color="#cccc66"];
    S_OPEN -> S_OPEN [label="  Apply → SETTINGS_apply_shadow\n  (write CFG, stay open;\n  reopen if display scale changed)" color="#cccc66"];
    S_OPEN -> S_CONFIRMING [label="  OK button clicked" color="#66cc66"];
    S_OPEN -> S_CANCELING [label="  Cancel / Esc" color="#cc6666" style=dashed];
    S_CONFIRMING -> S_CLOSED [label="  shadow → CFG,\n  CONFIG_save, closed" color="#cc6666" style=dashed];
    S_CANCELING -> S_CLOSED [label="  Shadow discarded" color="#cc6666" style=dashed];

    subgraph cluster_tabs {
        label="TABS (8)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        T1 [label="General\n────────────\nDisplay (Fullscreen, UI Scale)\nPerformance (FPS Limit/Idle/\nCursor/Dialog) · Startup Defaults\n(Splash, AI, Allow Multiple\nInstances, Layers, Brush, Nudge)\nCanvas · Cursors & Tooltips\nBAS Export · Opacity Slider" fontsize=10.0];
        T2 [label="Grid & Guides\n────────────\nGrid · Pixel Grid\nCrosshair\nAngle Snapping" fontsize=10.0];
        T3 [label="Palette\n────────────\nPalette Strip\nPalette Picker\nPalette Sources (Lospec)" fontsize=10.0];
        T4 [label="Panels\n────────────\nLayer Panel · Preview Window\nEdit Bar · Advanced Bar\nCharacter Map" fontsize=10.0];
        T5 [label="Audio\n────────────\nSound Effects\nMusic\nMIDI Soundfont" fontsize=10.0];
        T6 [label="Fonts & Text\n────────────\nText Tool Defaults · Char Map\nFont · Font Sources\nCharacter Grid · Font Previews" fontsize=10.0];
        T7 [label="Appearance\n────────────\nTheme (FIRST — applies\nimmediately) · Transparency\nCheckerboard · Scrollbar\nLayer Defaults · Picker Loupe" fontsize=10.0];
        T8 [label="Directories\n────────────\nData Locations (read-only)\nDefault Directories · Last Used\nDirectories · Drawer Set Files" fontsize=10.0];
    }

    subgraph cluster_modal {
        label="MODAL BEHAVIOR" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        M1 [label="Input Routing\n────────────\nSelf-contained modal loop —\nmain app loop is suspended\nBROWSER_suspend_for_modal\nreads _MOUSEINPUT / _KEYHIT itself" fontsize=10.0];
        M2 [label="Render Pipeline\n────────────\nNot a SCREEN_render overlay —\nthe modal owns its own\n_DISPLAY + _LIMIT FPS_DIALOG\nand blits SETTINGS.ctx image" fontsize=10.0];
    }

    MAIN -> S_CLOSED [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Open / Apply" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Cancel / Close" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Transition" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
