digraph DIALOGS {
    label="DIALOGS STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        NATIVE [label="NATIVE DIALOGS"];
        OVERLAY [label="OVERLAY DIALOGS"];
    }

    // ─────────────────────────────────────────────────────
    //  NATIVE DIALOG STATES
    // ─────────────────────────────────────────────────────

    N_IDLE [label="1 · NO DIALOG\n─────────────────\nNormal application state\nAll input processed\nDialogs closed"];
    N_FILE_OPEN [label="2 · FILE OPEN DIALOG\n─────────────────\n_OPENFILEDIALOG$()\nOS native dialog\nBlocking call\nDeferred via MOUSE.DEFERRED_ACTION%"];
    N_FILE_SAVE [label="3 · FILE SAVE DIALOG\n─────────────────\n_SAVEFILEDIALOG$()\nOS native dialog\nBlocking call"];
    N_MESSAGE [label="4 · MESSAGE BOX\n─────────────────\n_MESSAGEBOX()\nConfirmation dialogs\nUnsaved changes warning\nReturn: OK/Cancel"];
    N_CLEANUP [label="5 · POST-DIALOG CLEANUP\n─────────────────\nMOUSE_cleanup_after_dialog()\nDrain mouse buffer\nForce buttons up\nSUPPRESS_FRAMES% = 2\nClear keyboard buffer"];

    N_IDLE -> N_FILE_OPEN [label="  DEFERRED_ACTION% = 2 (import) / 3 (open .draw)\n  / 5 (drawer slot import)\n  MOUSE_input_handler_loop()" color="#66cc66"];
    N_IDLE -> N_FILE_SAVE [label="  DEFERRED_ACTION% = 1 (save) / 4 (export selection)\n  MOUSE_input_handler_loop()" color="#66cc66"];
    N_IDLE -> N_MESSAGE [label="  Unsaved changes / confirm\n  CMD_execute_action()" color="#66cc66"];
    N_FILE_OPEN -> N_CLEANUP [label="  Dialog returns path$\n  or empty (cancelled)" color="#cccc66"];
    N_FILE_SAVE -> N_CLEANUP [label="  Dialog returns path$\n  or empty (cancelled)" color="#cccc66"];
    N_MESSAGE -> N_CLEANUP [label="  User clicks OK/Cancel" color="#cccc66"];
    N_CLEANUP -> N_IDLE [label="  SUPPRESS_FRAMES% = 0\n  Input restored" color="#cc6666" style=dashed];

    // ─────────────────────────────────────────────────────
    //  OVERLAY DIALOG STATES (Image Adjustments)
    // ─────────────────────────────────────────────────────

    subgraph cluster_overlay {
        label="IMAGE ADJUSTMENT MODAL DIALOGS — GUI/DIALOG.BM (DIALOG_CTX) + GUI/IMAGE-ADJ.BM" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        O_CLOSED [label="No Dialog\n────────────\nNormal canvas editing\nNo modal loop running"
                  fontsize=10.0];
        O_OPEN [label="Modal Loop Running\n────────────\nDIALOG_init ctx, w, h\nDO ... DIALOG_poll_mouse ... LOOP UNTIL ctx.done\nscreenShot bg + inputArmed swallow\nLive split-preview (origThumb / previewThumb)"
                fontsize=10.0];
        O_ADJUSTING [label="Adjusting Values\n────────────\nDIALOG_slider_drag% / DIALOG_slider_wheel%\nDIALOG_dropdown% select\nctx.previewDirty → recompute previewThumb"
                     fontsize=10.0];
        O_COMMIT [label="OK / Cancel\n────────────\nctx.done=TRUE, ctx.result TRUE=OK / FALSE=Cancel\nOK → IMAGE_ADJ_apply_to_layer\n  + HISTORY_record_transform\nCancel = discard adjResult"
                  fontsize=10.0];

        O_CLOSED -> O_OPEN [label=" IMAGE_ADJ_*_dialog\n (menu action, e.g.\n brightness/hue/levels)" color="#66cc66" fontsize=8.0];
        O_OPEN -> O_ADJUSTING [label=" Drag slider / dropdown" color="#66cc66" fontsize=8.0];
        O_ADJUSTING -> O_OPEN [label=" Release" color="#88aacc" fontsize=8.0];
        O_OPEN -> O_COMMIT [label=" OK / Cancel / Enter / Escape" color="#cccc66" fontsize=8.0];
        O_COMMIT -> O_CLOSED [label=" DIALOG_cleanup\n (loop unwinds)" color="#cc6666" fontsize=8.0 style=dashed];
    }

    // ─────────────────────────────────────────────────────
    //  ADJUSTMENT TYPES
    // ─────────────────────────────────────────────────────

    subgraph cluster_adj_types {
        label="ADJUSTMENT / FILTER / EFFECT DIALOGS — 71 (all share DIALOG_CTX)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        ADJ_TONE [label="Tonal Adjustments\n────────────\nbrightness_contrast, hue_saturation,\nlevels, color_balance, duotone,\nsolarize, gradientmap" fontsize=10.0];
        ADJ_STYL [label="Stylize / Edge\n────────────\nemboss, edgedetect, outline,\nchrome, chromatic, growshrink,\nextrude, mosaic, crystallize" fontsize=10.0];
        ADJ_LIGHT [label="Light / Glow\n────────────\ncorona, backlight, lensflare,\ninnerglow, outerglow, bevel,\nlongshadow, dropshadow, lightning" fontsize=10.0];
        ADJ_DISTORT [label="Distort\n────────────\npinch, twirl, wave, ripples,\nkaleidoscope, wind, glass,\npointillize, stainedglass" fontsize=10.0];
        ADJ_NOISE [label="Noise / Nature\n────────────\naddnoise, dustscratches, clouds,\nsky, terrain, fire, smoke, snow,\nwaterdrops, drip, icicles, electrify" fontsize=10.0];
        ADJ_TEX [label="Texture Generators\n────────────\nwood, marble, brick, stone,\nbrushmetal, weave, fur, reptile,\ndiamondplate, rust, texnoise, grid" fontsize=10.0];
    }

    NATIVE -> N_IDLE [arrowhead=none color="#555555" style=dotted];
    OVERLAY -> O_CLOSED [arrowhead=none color="#555555" style=dotted lhead=cluster_overlay];
    { rank=min; NATIVE; OVERLAY }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Open / Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Close / Cleanup" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Commit / Apply" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
