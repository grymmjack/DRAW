digraph SMART_GUIDES {
    label="SMART GUIDES STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [color=gray fontcolor="#aaaaaa" fontsize=9.0 fontname="Cascadia Code PL"];
    node [color=white shape=rect style="" fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="SMART GUIDES — MOVE TOOL"];
    }

    S_DISABLED [label="1 · DISABLED\n─────────────────\nSMART_GUIDES.ENABLED% = FALSE\nNo alignment hints drawn\nAction 910 to enable"];
    S_IDLE [label="2 · IDLE\n─────────────────\nENABLED% = TRUE but inactive\nMove tool not dragging\nWaiting for drag start"];
    S_DETECTING [label="3 · DETECTING\n─────────────────\nMove drag in progress (TOOL_MOVE)\nSMART_GUIDES_update scans\nSG_BBOXES of non-active layers\nfor edge / center alignment"];
    S_SHOW_GUIDE [label="4 · SHOWING GUIDE\n─────────────────\nMatch within SMART_GUIDES.DISTANCE\nSMART_GUIDES_add_h_guide / _add_v_guide\nH (const Y) + V (const X) arrays\nEdges: LEFT/RIGHT/TOP/BOTTOM/CTR_H/CTR_V"];
    S_SNAP [label="5 · SNAPPED\n─────────────────\nOnly if SMART_GUIDES.SNAP% (action 911)\nSMART_GUIDES_apply_snap\nsnapX/snapY within DISTANCE (default 4)\nsnapDX/snapDY applied, FRAME_IDLE% = FALSE"];

    S_DISABLED -> S_IDLE [label="  Action 910 fired\n  (Toggle Smart Guides)" color="#66cc66"];
    S_IDLE -> S_DISABLED [label="  Action 910 again\n  SMART_GUIDES_clear" color="#cc6666" style=dashed];
    S_IDLE -> S_DETECTING [label="  Move tool drag begins\n  CURRENT_TOOL% = TOOL_MOVE" color="#66cc66"];
    S_DETECTING -> S_SHOW_GUIDE [label="  Alignment within\n  SMART_GUIDES.DISTANCE (default 4)" color="#cccc66"];
    S_SHOW_GUIDE -> S_SNAP [label="  SMART_GUIDES.SNAP% ON\n  apply_snap to alignment axis" color="#cccc66"];
    S_SNAP -> S_SHOW_GUIDE [label="  Mouse moved past\n  snap break distance" color="#cccc66"];
    S_SHOW_GUIDE -> S_DETECTING [label="  Lost alignment\n  guide cleared next update" color="#cc6666" style=dashed];
    S_DETECTING -> S_IDLE [label="  Move drag released\n  SMART_GUIDES_clear, pos committed" color="#cc6666" style=dashed];

    subgraph cluster_axes {
        label="ALIGNMENT AXES" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        A_LEFT [label="Left Edge\n────────────\nMatching X bounds\nVertical line drawn" fontsize=10.0];
        A_CTRX [label="Center X\n────────────\nMid-X alignment\nCenter line" fontsize=10.0];
        A_RIGHT [label="Right Edge\n────────────\nRight-edge match" fontsize=10.0];
        A_TOP [label="Top Edge\n────────────\nMatching Y bounds\nHorizontal line drawn" fontsize=10.0];
        A_CTRY [label="Center Y\n────────────\nMid-Y alignment" fontsize=10.0];
        A_BOT [label="Bottom Edge\n────────────\nBottom-edge match" fontsize=10.0];
    }

    subgraph cluster_render {
        label="RENDER ORDER" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        R1 [label="SMART_GUIDES_render into SCRN.CANVAS&\nin SCREEN_render (OUTPUT/SCREEN.BM)\nH/V guide-line arrays (SG_MAX_GUIDES=128/axis)\nAction 911 = toggle SNAP (not clear)\nSMART_GUIDES_clear runs on disable / drag end" fontsize=10.0];
    }

    MAIN -> S_DISABLED [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deactivate" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Transition" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
