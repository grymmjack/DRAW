digraph EDITBAR {
    label="EDIT BAR STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="MAIN STATES"];
        DOCK [label="DOCKING"];
        EDGE_F [label="EDGE MODE"];
    }

    S_HIDDEN [label="1 · HIDDEN\n─────────────────\nSCRN.showEditBar% = FALSE\nSCRN.editBarManuallyHidden% = TRUE\nEDIT_BAR.visible% = FALSE\nNot rendered"];
    S_VISIBLE [label="2 · VISIBLE\n─────────────────\nSCRN.showEditBar% = TRUE\nEDIT_BAR.visible% = TRUE\nVertical icon bar\n32 slots (25 icons + 7 dividers)\nDocked LEFT or RIGHT\nWheel scroll (scrollOffset%, 12px)"];
    S_HOVER [label="3 · BUTTON HOVER\n─────────────────\nEDIT_BAR.hoverIndex% = idx\nHighlight + tooltip queued"];
    S_CLICK [label="4 · BUTTON CLICK (B1)\n─────────────────\nEDITBAR_handle_click()\nCMD_execute_action(actionID%)\nDividers ignored (actionID% = 0)"];

    S_HIDDEN -> S_VISIBLE [label="  F5 / Menu (EDITBAR_toggle)" color="#66cc66"];
    S_VISIBLE -> S_HIDDEN [label="  F5 / Menu (EDITBAR_toggle)" color="#cc6666" style=dashed];
    S_VISIBLE -> S_HOVER [label="  Mouse over icon" color="#88aacc"];
    S_HOVER -> S_CLICK [label="  B1 click" color="#66cc66"];
    S_CLICK -> S_VISIBLE [label="  Action executed" color="#cccc66"];
    S_HOVER -> S_VISIBLE [label="  Mouse leaves" color="#cc6666" style=dashed];

    subgraph cluster_docking {
        label="DOCKING — LEFT / RIGHT" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        D_LEFT [label="Docked Left\n────────────\nEDIT_BAR.dockSide% = EDITBAR_DOCK_LEFT\nBy the layers panel\nCFG.EDIT_BAR_DOCK_POSITION$ = LEFT"
                fontsize=10.0];
        D_RIGHT [label="Docked Right (default)\n────────────\nEDIT_BAR.dockSide% = EDITBAR_DOCK_RIGHT\nBy the toolbox / drawer\nCFG.EDIT_BAR_DOCK_POSITION$ = RIGHT"
                 fontsize=10.0];

        D_LEFT -> D_RIGHT [label=" Menu: Dock Right" color="#88aacc" fontsize=8.0];
        D_RIGHT -> D_LEFT [label=" Menu: Dock Left" color="#88aacc" fontsize=8.0];
    }

    subgraph cluster_edge {
        label="EDGE MODE — shared button (slot 28)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        EG_PP [label="Target = Pixel-Perfect\n────────────\nEDGE_MODE_TARGET = EDGE_TARGET_PP (default)\nButton shows PP glyph (no badge)\non/off truth: BRUSH_SIZE.PIXEL_PERFECT" fontsize=10.0];
        EG_AA [label="Target = Anti-Aliasing\n────────────\nEDGE_MODE_TARGET = EDGE_TARGET_AA\n\"AA\" badge drawn (EDITBAR_draw_aa_badge)\non/off truth: CFG.ANTIALIAS%" fontsize=10.0];
        EG_TOGGLE [label="Left-click (action 959)\n────────────\nEDITBAR_handle_click()\nToggle current target's mode on/off\nPP and AA stay mutually exclusive" fontsize=10.0];

        EG_PP -> EG_AA [label=" Right-click: switch target (action 960)" color="#6699ff" fontsize=8.0];
        EG_AA -> EG_PP [label=" Right-click: switch target (action 960)" color="#6699ff" fontsize=8.0];
        EG_PP -> EG_TOGGLE [label=" Left-click toggles PP" color="#cccc66" fontsize=8.0];
        EG_AA -> EG_TOGGLE [label=" Left-click toggles AA" color="#cccc66" fontsize=8.0];
    }

    subgraph cluster_actions {
        label="EDIT BAR ACTIONS — 25 ICONS in 9 groups" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        A_LIST [label="History: Undo, Redo\nClipboard: Cut, Copy, Copy Merged, Paste, Paste In Place\nLayer: Cut to Layer, Copy to Layer\nClear\nFill: Fill w/ FG, Fill w/ BG, Stroke Selection\nTransform: Flip H, Flip V, Scale Down, Scale Up, Rotate CW, Rotate CCW\nSmart Guides: Smart Guides (910), Snap Smart Guides (911)\nEdge Mode: shared PP / AA button (959, right-click 960)\nCanvas: Flip Canvas H (1803), Flip Canvas V (1804)"
                fontsize=10.0];
    }

    MAIN -> S_HIDDEN [arrowhead=none color="#555555" style=dotted];
    DOCK -> D_LEFT [arrowhead=none color="#555555" style=dotted lhead=cluster_docking];
    EDGE_F -> EG_PP [arrowhead=none color="#555555" style=dotted lhead=cluster_edge];
    { rank=min; MAIN; DOCK; EDGE_F }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Show / Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Hide / Close" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Mode / Re-target" arrowhead=normal color="#6699ff" fontsize=9.0];
    }
}
