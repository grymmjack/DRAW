digraph TOOLTIPS {
    label="TOOLTIP STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="TOOLTIP LIFECYCLE"];
    }

    S_HIDDEN [label="1 · HIDDEN\n─────────────────\nTOOLTIP.ACTIVE% = FALSE\nHOVER_BTN_IDX% = -1\nHOVER_SOURCE% = TOOLTIP_SRC_NONE\nNo tooltip rendered"];
    S_DELAY [label="2 · DELAY\n─────────────────\nHovering a target element\nHOVER_START# = TIMER\nWaiting CFG.TOOLTIP_HOVER_DELAY_MS%\n(default 500ms)"];
    S_VISIBLE [label="3 · VISIBLE\n─────────────────\nTOOLTIP.ACTIVE% = TRUE\nTOOLTIP_render → 1-3 text lines\nnear cursor, clamped to\nscreen edges"];

    S_HIDDEN -> S_DELAY [
        label="  Hover target resolved\n  (newIdx ≥ 0)\n  HOVER_START# = TIMER"
        color="#66cc66"
    ];
    S_DELAY -> S_VISIBLE [
        label="  elapsed ≥ HOVER_DELAY_MS\n  ACTIVE% = TRUE"
        color="#66cc66"
    ];
    S_DELAY -> S_HIDDEN [
        label="  Target changed / left\n  (newIdx < 0), reset"
        color="#cc6666" style=dashed
    ];
    S_VISIBLE -> S_DELAY [
        label="  Hover moves to a\n  different target\n  ACTIVE% = FALSE, restart timer"
        color="#cccc66"
    ];
    S_VISIBLE -> S_HIDDEN [
        label="  Mouse leaves, or button down,\n  or menu/popup open\n  ACTIVE% = FALSE"
        color="#cc6666" style=dashed
    ];

    // ─────────────────────────────────────────────────────
    //  TOOLTIP SOURCES (TOOLTIP.HOVER_SOURCE% = TOOLTIP_SRC_*)
    // ─────────────────────────────────────────────────────

    subgraph cluster_sources {
        label="TOOLTIP SOURCES — resolved in TOOLTIP_update priority order" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        SRC_TB [label="TOOLBAR\n────────────\nTool button: name + hotkey\nTOOLTIP_LINE1/2$(idx)"
                fontsize=10.0];
        SRC_FLY [label="SUBTOOL_FLYOUT\n────────────\nSmart-shapes child buttons\n(shown even while B1 held)"
                 fontsize=10.0];
        SRC_ORG [label="ORGANIZER\n────────────\nWidget name + state\nTOOLTIP_ORG_LINE1/2$(idx)"
                 fontsize=10.0];
        SRC_BARS [label="EDITBAR / ADVBAR\n────────────\nAction name + hotkey\nEB / AB line arrays"
                  fontsize=10.0];
        SRC_DRAWER [label="BINS / MINI_PAL\n────────────\nDrawer slot bins and\nmini-palette hover"
                    fontsize=10.0];
        SRC_LAYER [label="LAYER_NAME / OPACITY / NO_PAINT\n────────────\nRow name, opacity %,\ngroup-parent no-paint badge\n(DYNAMIC_TEXT$)"
                   fontsize=10.0];
        SRC_DOCK [label="DOCK_SWAP\n────────────\nBlank dock-panel area\n(toolbar / organizer / drawer /\nbars / layer panel background)"
                  fontsize=10.0];
    }

    MAIN -> S_HIDDEN [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Show" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Hide" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Re-arm timer" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
