digraph ABOUT_DIALOG {
    label="ABOUT DIALOG STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [color=gray fontcolor="#aaaaaa" fontsize=9.0 fontname="Cascadia Code PL"];
    node [color=white shape=rect style="" fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="ABOUT DIALOG"];
    }

    S_CLOSED [label="1 · CLOSED\n─────────────────\nABOUT_show not running\nNo modal loop active\n(no visible% flag — blocking modal)"];
    S_INTRO [label="2 · OPENING (SETUP)\n─────────────────\nABOUT_show → ABOUT_init\n(lazy build logo/checker data)\nPOINTER.HIDDEN%, SCREEN_render,\nbgSnap = _COPYIMAGE(0)\n_MOUSESHOW DEFAULT, drain input"];
    S_IDLE [label="3 · MODAL LOOP\n─────────────────\nBlocking DO…LOOP (own _DISPLAY,\n_LIMIT 60), frame& counts up\nGlint sweep + checker/bar anims\nVersion APP_VERSION$, static\ncredits, pulsing GitHub link, OK btn"];
    S_HOVER_LINK [label="4 · HOVER LINK\n─────────────────\nMouse over GitHub URL hitbox\n_MOUSESHOW \"LINK\"\nLink color pulses"];
    S_OPEN_URL [label="5 · OPENING URL\n─────────────────\nLink clicked\nSHELL _DONTWAIT\n\"xdg-open https://github.com/\n grymmjack/DRAW\"\nStay in modal loop"];
    S_CLOSING [label="6 · CLOSING\n─────────────────\nEsc (27) / OK button / _EXIT\nFree bgSnap + aboutImg\nRestore cursor + _DEST/_SOURCE"];

    S_CLOSED -> S_INTRO [label="  Help → About\n  (CMD action 1601)" color="#66cc66"];
    S_INTRO -> S_IDLE [label="  Setup done,\n  modal loop starts" color="#cccc66"];
    S_IDLE -> S_HOVER_LINK [label="  Mouse enters URL hitbox" color="#66cc66"];
    S_HOVER_LINK -> S_IDLE [label="  Mouse leaves" color="#cc6666" style=dashed];
    S_HOVER_LINK -> S_OPEN_URL [label="  B1 click on link" color="#66cc66"];
    S_OPEN_URL -> S_IDLE [label="  xdg-open launched\n  Stay on About" color="#cccc66"];
    S_IDLE -> S_CLOSING [label="  Esc / OK button / _EXIT" color="#cc6666" style=dashed];
    S_CLOSING -> S_CLOSED [label="  Images freed,\n  context restored" color="#cc6666" style=dashed];

    subgraph cluster_content {
        label="DISPLAYED CONTENT" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        C1 [label="Animated Logo\n────────────\nCrayon DRAW{} logo (DATA)\nGlint sweep + rainbow bar pops\nDriven by frame&" fontsize=10.0];
        C2 [label="Version\n────────────\n\"version \" + APP_VERSION$\nfrom _COMMON.BI" fontsize=10.0];
        C3 [label="Credits\n────────────\n\"A pixel art editor\"\nby grymmjack (Rick Christy)\nWritten in QB64-PE" fontsize=10.0];
        C4 [label="GitHub Link\n────────────\ngithub.com/grymmjack/DRAW\nSHELL xdg-open [Linux]" fontsize=10.0];
    }

    MAIN -> S_CLOSED [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Close / Reset" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Transition" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
