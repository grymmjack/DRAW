digraph COMMAND_PALETTE {
    label="COMMAND PALETTE STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="COMMAND PALETTE"];
    }

    S_CLOSED [label="1 · CLOSED\n─────────────────\nCMD_PALETTE.visible = FALSE\nNot rendered (CMD_render EXIT SUB)\nNormal keyboard input"];
    S_OPEN [label="2 · OPEN\n─────────────────\nCMD_PALETTE.visible = TRUE\nmode 0 = search / mode 1 = quick ref\nCMD_show_palette / CMD_show_quick_ref\nSearch box focused\nAll 260+ commands listed"];
    S_SEARCHING [label="3 · SEARCHING\n─────────────────\nCMD_PALETTE.search / .search_len\nCMD_update_search\nSubsequence fuzzy match\n(CMD_fuzzy_match%, smart-case)\n+ substring match on hotkey"];
    S_HOVER [label="4 · ITEM HOVER\n─────────────────\nCMD_PALETTE.hover = result idx\nRow highlighted (hover_bg)\nCMD_PALETTE.scroll follows"];
    S_EXECUTE [label="5 · EXECUTE\n─────────────────\nCMD_execute_selected\n→ CMD_execute_action(action_id)\nCMD_hide (palette closes)"];

    S_CLOSED -> S_OPEN [
        label="  ? key → CMD_show_palette (mode 0)\n  action 1703 / Help>Cheat Sheet\n  action 1602 → CMD_show_quick_ref (mode 1)"
        color="#66cc66"
    ];
    S_OPEN -> S_SEARCHING [
        label="  Type printable (32-126)\n  CMD_handle_key → CMD_update_search"
        color="#66cc66"
    ];
    S_SEARCHING -> S_SEARCHING [
        label="  More typing / Backspace\n  Filter refines (hover/scroll reset)"
        color="#88aacc"
    ];
    S_OPEN -> S_HOVER [
        label="  Mouse over item / wheel\n  or ↑/↓ arrows (key repeat)"
        color="#88aacc"
    ];
    S_SEARCHING -> S_HOVER [
        label="  Mouse over filtered item / wheel\n  ↑/↓ arrows, PgUp/PgDn"
        color="#88aacc"
    ];
    S_HOVER -> S_EXECUTE [
        label="  Enter / Click item\n  CMD_execute_selected"
        color="#cccc66"
    ];
    S_EXECUTE -> S_CLOSED [
        label="  Action complete\n  CMD_hide → visible = FALSE"
        color="#cc6666" style=dashed
    ];
    S_OPEN -> S_CLOSED [
        label="  Escape / click outside\n  CMD_hide"
        color="#cc6666" style=dashed
    ];
    S_SEARCHING -> S_CLOSED [
        label="  Escape / click outside\n  CMD_hide"
        color="#cc6666" style=dashed
    ];
    S_HOVER -> S_SEARCHING [
        label="  Continue typing"
        color="#88aacc"
    ];

    subgraph cluster_categories {
        label="COMMAND CATEGORIES — 15 GROUPS (CMD_CAT_*)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        CAT_LIST [label="Categories\n────────────\nTool, File, Edit,\nView, Color, Brush,\nLayer, Canvas,\nAssist, Custom, Grid,\nSymm, Select,\nHelp, Image"
                  fontsize=10.0];
    }

    subgraph cluster_keyboard {
        label="KEYBOARD NAVIGATION" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        KB_SEARCH [label="Search Input (CMD_handle_key)\n────────────\nPrintable 32-126 → search\nBackspace deletes (case 8)\nEnter = execute (case 13)\nESC = close (case 27)"
                   fontsize=10.0];
        KB_NAV [label="List Navigation\n────────────\n↑/↓ = Move highlight (key repeat)\nPageUp/Down = Jump\nMousewheel = up/down\n(no Home/End binding)"
                fontsize=10.0];
    }

    MAIN -> S_CLOSED [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }
    { rank=same; S_CLOSED; S_OPEN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Open / Navigate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Close" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Execute Action" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
