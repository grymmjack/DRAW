digraph TOOLBAR {
    label="TOOLBOX STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        TOOL_SEL [label="TOOL SELECTION"];
        LAYOUT_F [label="LAYOUT"];
        FLYOUT_F [label="SUB-TOOL FLYOUT"];
    }

    // ─────────────────────────────────────────────────────
    //  TOOL SELECTION STATES
    // ─────────────────────────────────────────────────────

    S_IDLE [label="1 · NO TOOL ACTIVE\n─────────────────\nCURRENT_TOOL% = TOOL_NULL\nToolbar rendered\nAll buttons normal"];
    S_ACTIVE [label="2 · TOOL ACTIVE\n─────────────────\nCURRENT_TOOL% > 0\nActive button highlighted\n(TOOLBAR_BUTTON_TO_TOOL(i) = CURRENT_TOOL%)\nPrev tool saved in PREVIOUS_TOOL"];
    S_HOVER [label="3 · BUTTON HOVER\n─────────────────\nMouse over toolbar button\nTooltip queued\nHighlight drawn"];
    S_CLICK [label="4 · BUTTON CLICK (B1)\n─────────────────\nTOOLBAR_handle_click%()\nMOVE_reset guard if leaving MOVE\nCURRENT_TOOL% = tool_id%\nTOOLS_reset_all FALSE\nFILL/PICKER activate·deactivate"];

    // ─────────────────────────────────────────────────────
    //  TRANSITIONS
    // ─────────────────────────────────────────────────────

    S_IDLE -> S_ACTIVE [
        label="  Hotkey / Menu action\n  KEYBOARD_tools() / CMD_execute_action()\n  Sets CURRENT_TOOL%"
        color="#66cc66"
    ];
    S_ACTIVE -> S_HOVER [
        label="  Mouse over different button"
        color="#88aacc"
    ];
    S_HOVER -> S_CLICK [
        label="  B1 click on button\n  TOOLBAR_handle_click%()"
        color="#66cc66"
    ];
    S_CLICK -> S_ACTIVE [
        label="  New tool activated\n  Previous tool state reset\n  (TOOLS_reset_all FALSE)"
        color="#cccc66"
    ];
    S_ACTIVE -> S_ACTIVE [
        label="  Hotkey switches tool\n  KEYBOARD_tools()\n  MOVE_reset if leaving MOVE, then set new"
        color="#88aacc"
    ];
    S_HOVER -> S_ACTIVE [
        label="  Mouse exits button\n  Tooltip cancelled"
        color="#cc6666" style=dashed
    ];
    S_ACTIVE -> S_ACTIVE [
        label="  Right-click (TOOLBAR_handle_right_click)\n  Text opts / marquee wand mode\n  Middle-click (TOOLBAR_handle_middle_click)"
        color="#cc66cc"
    ];

    // ─────────────────────────────────────────────────────
    //  LAYOUT GRID
    // ─────────────────────────────────────────────────────

    subgraph cluster_layout {
        label="TOOLBAR LAYOUT — 4 cols × 7 rows (TB_COLS × TB_ROWS)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        LY_GRID [label="Button Grid\n────────────\n28 buttons (indices 0..27, 4×7)\nrow = i \\ TB_COLS, col = i MOD TB_COLS\ny = TB_TOP + scaled_h·row + pad·row\nIcons loaded from theme"
                 fontsize=10.0];
        LY_MAP [label="Button → Tool Mapping\n────────────\nTOOLBAR_BUTTON_TO_TOOL(0..27)\nMaps grid index to TOOL_* constant\nGUI_TB(...) holds icon + tip + evt"
                fontsize=10.0];
        LY_INDICATOR [label="Active Indicator\n────────────\nHighlight on button where\nTOOLBAR_BUTTON_TO_TOOL(i) = CURRENT_TOOL%\nTOOLBAR_active_tool_id%\nUpdated on tool switch"
                      fontsize=10.0];
    }

    // ─────────────────────────────────────────────────────
    //  SUB-TOOL FLYOUT
    // ─────────────────────────────────────────────────────

    subgraph cluster_flyout {
        label="SUB-TOOL FLYOUT — GUI/SUBTOOL-FLYOUT.BM" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        FO_CLOSED [label="Closed\n────────────\nSUBTOOL_FLYOUT.GROUP_IDX = -1" fontsize=10.0];
        FO_OPEN [label="Open\n────────────\nSUBTOOL_FLYOUT_open(groupIdx)\nSmart Shapes group (SMART_SHAPES_GROUP_IDX)\nChildren = SUBTOOL_GROUP_CHILDREN(...)\nlastChildIdx remembered" fontsize=10.0];
        FO_COMMIT [label="Commit Child\n────────────\nSUBTOOL_FLYOUT_commit(childIdx)\nSets CURRENT_TOOL% = child.toolConst\nSUBTOOL_FLYOUT_set_last_child" fontsize=10.0];

        FO_CLOSED -> FO_OPEN [label=" click parent tool\n (Smart Shapes)" color="#66cc66" fontsize=8.0];
        FO_OPEN -> FO_COMMIT [label=" click child" color="#cccc66" fontsize=8.0];
        FO_COMMIT -> FO_CLOSED [label=" SUBTOOL_FLYOUT_close" color="#88aacc" fontsize=8.0];
        FO_OPEN -> FO_CLOSED [label=" click outside" color="#cc6666" style=dashed fontsize=8.0];
    }

    // ─────────────────────────────────────────────────────
    //  TOOL CONSTANTS
    // ─────────────────────────────────────────────────────

    subgraph cluster_tools {
        label="TOOL CONSTANTS — _COMMON.BI / GUI/GUI.BI" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        T_LIST [label="Drawing Tools\n────────────\nTOOL_DOT, TOOL_BRUSH,\nTOOL_SPRAY, TOOL_FILL,\nTOOL_LINE, TOOL_BEZIER,\nTOOL_POLYGON, TOOL_POLYGON_FILLED,\nTOOL_RECT, TOOL_RECT_FILLED,\nTOOL_ELLIPSE, TOOL_ELLIPSE_FILLED,\nTOOL_TEXT, TOOL_ERASER,\nTOOL_SMART_SHAPES"
                fontsize=10.0];
        T_SELECT [label="Nav / Selection Tools\n────────────\nTOOL_MOVE, TOOL_PAN,\nTOOL_ZOOM, TOOL_CROP,\nTOOL_SELECT_RECT (30),\nTOOL_SELECT_POLY (31),\nTOOL_SELECT_FREE (33),\nTOOL_SELECT_ELLIPSE,\nTOOL_SELECT_WAND,\nTOOL_MARQUEE (5)"
                  fontsize=10.0];
        T_UTIL [label="Utility Buttons\n────────────\nTOOL_PICKER,\nTOOL_SAVE, TOOL_OPEN,\nTOOL_EXPORT_SEL\n(QB64 quick export)"
                fontsize=10.0];
    }

    TOOL_SEL -> S_IDLE [arrowhead=none color="#555555" style=dotted];
    LAYOUT_F -> LY_GRID [arrowhead=none color="#555555" style=dotted lhead=cluster_layout];
    FLYOUT_F -> FO_CLOSED [arrowhead=none color="#555555" style=dotted lhead=cluster_flyout];

    { rank=min; TOOL_SEL; LAYOUT_F; FLYOUT_F }
    { rank=same; S_IDLE; S_ACTIVE }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deactivate" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Commit Switch" arrowhead=normal color="#cccc66" fontsize=9.0];
        L7 -> L8 [label=" Right/Middle-click" arrowhead=normal color="#cc66cc" fontsize=9.0];
    }
}
