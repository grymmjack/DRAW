digraph ORGANIZER {
    label="ORGANIZER STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="MAIN STATES"];
        WIDGETS [label="WIDGET GRID"];
    }

    // ─────────────────────────────────────────────────────
    //  MAIN STATES
    // ─────────────────────────────────────────────────────

    S_VISIBLE [label="1 · VISIBLE\n─────────────────\nORGANIZER.visible% = TRUE\nRendered below toolbar when\nSCRN.showToolbar% = TRUE\n4×3 grid, 11 widget slots\n(ORG_WIDGET_COUNT)"];
    S_HIDDEN [label="2 · HIDDEN\n─────────────────\nNot rendered when\nSCRN.showToolbar% = FALSE\n(no independent toggle —\nvisibility follows toolbar)"];
    S_HOVER [label="3 · WIDGET HOVER\n─────────────────\nTOOLTIP_get_hovered_org_idx% ≥ 0\nWidget under mouse\nTooltip queued (TOOLTIP_SRC_ORGANIZER)"];
    S_CLICK [label="4 · WIDGET CLICK\n─────────────────\nORGANIZER_handle_click% /\n_right_click% / _middle_click% /\n_handle_wheel / _handle_drag\n→ ORGANIZER_activate_widget"];

    S_VISIBLE -> S_HIDDEN [
        label="  Toolbar hidden\n  SCRN.showToolbar% = FALSE"
        color="#cc6666" style=dashed
    ];
    S_HIDDEN -> S_VISIBLE [
        label="  Toolbar shown\n  SCRN.showToolbar% = TRUE"
        color="#66cc66"
    ];
    S_VISIBLE -> S_HOVER [label="  Mouse over widget" color="#88aacc"];
    S_HOVER -> S_CLICK [label="  B1 / B2 / B3 / wheel" color="#66cc66"];
    S_CLICK -> S_VISIBLE [label="  Widget action dispatched" color="#cccc66"];

    // ─────────────────────────────────────────────────────
    //  ORGANIZER WIDGETS (4×3 grid, ORG_WIDGET_COUNT = 11)
    //  Row 0: Color Mixer | Opacity | Brush Size | Pattern
    //  Row 1: Palette Ops | Opacity | Brush Size | Gradient
    //  Row 2: Symmetry    | GridVis | Grid Snap  | Color Mode
    // ─────────────────────────────────────────────────────

    subgraph cluster_widgets {
        label="ORGANIZER WIDGETS — 4×3 GRID" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        W_MIXER [label="Color Mixer (ORG_COLOR_MIXER)\n────────────\nL-click: CMD_execute_action 2021\ntoggles Color Mixer panel"
                 fontsize=10.0];
        W_OPACITY [label="Opacity Slider (ORG_CANVAS_OPS)\n────────────\nDrawn inline (no image)\nL-drag: PAINT_OPACITY% 1..100\nR-click: reset to 100%\n(ORG_TRANSFORM_OPS = no-op)"
                   fontsize=10.0];
        W_BRUSH [label="Brush Size (ORG_BRUSH_SIZE)\n────────────\nSpans rows 0+1 (11×21)\nL-click: 4 zones → preset 1-4\nBRUSH_SIZE_set_preset\nSizes: 1 / 3 / 5 / 9 px"
                 fontsize=10.0];
        W_PATTERN [label="Pattern Mode (ORG_PATTERN_MODE)\n────────────\nL-click: DRAWER_set_mode\nDRAWER_MODE_PATTERN (F3)"
                   fontsize=10.0];
        W_PALOPS [label="Palette Ops (ORG_PALETTE_OPS)\n────────────\nL-click: PALETTE_OPS_activate /\nre-remap (L=Toggle)\nR-click: PALETTE_OPS_deactivate"
                  fontsize=10.0];
        W_GRADIENT [label="Gradient Mode (ORG_GRADIENT_MODE)\n────────────\nL-click: DRAWER_set_mode\nDRAWER_MODE_GRADIENT (F2)"
                    fontsize=10.0];
        W_SYMMETRY [label="Symmetry Mode (ORG_SYMMETRY_MODE)\n────────────\nL-click: SYMMETRY_cycle_mode\noff → 1 → 2 → 3 → off\n(4 state images)"
                    fontsize=10.0];
        W_GRIDVIS [label="Grid Visibility (ORG_GRID_VIS)\n────────────\nL-click: GRID.SHOW% = NOT GRID.SHOW%"
                   fontsize=10.0];
        W_GRIDSNAP [label="Grid Snap (ORG_GRID_SNAP)\n────────────\nL-click: GRID.SNAP% = NOT GRID.SNAP%\n(simple on/off toggle)"
                    fontsize=10.0];
        W_COLORMODE [label="Color Mode / FG-BG (ORG_COLOR_MODE)\n────────────\nFG / BG / Swap chip zones (F1)\nL: pick FG/BG, swap\nR: custom picker, reset W/B\nM: set FG/BG transparent\nElse: DRAWER_set_mode BRUSH"
                     fontsize=10.0];

        W_BRUSH -> W_BRUSH [
            label=" Wheel cycles presets\n (bigger / smaller)"
            color="#88aacc" fontsize=8.0
        ];
        W_SYMMETRY -> W_SYMMETRY [
            label=" Click cycles:\n off → 1 → 2 → 3 → off"
            color="#88aacc" fontsize=8.0
        ];
    }

    MAIN -> S_VISIBLE [arrowhead=none color="#555555" style=dotted];
    WIDGETS -> W_MIXER [arrowhead=none color="#555555" style=dotted lhead=cluster_widgets];
    { rank=min; MAIN; WIDGETS }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Show / Enable" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Hide / Disable" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Cycle State" arrowhead=normal color="#88aacc" fontsize=9.0];
    }
}
