digraph PREVIEW {
    label="PREVIEW WINDOW STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="MAIN STATES"];
        MODES [label="PREVIEW MODES"];
        INTERACT [label="INTERACTIONS"];
    }

    S_HIDDEN [label="1 · HIDDEN\n─────────────────\nPREVIEW.visible = FALSE\nNot rendered\n(PREVIEW.autoHidden while drawing over rect)"];
    S_VISIBLE [label="2 · VISIBLE\n─────────────────\nPREVIEW.visible = TRUE\nFloating window rendered (PREVIEW_render)\nPREVIEW.mode determines content"];
    S_DRAGGING [label="3 · DRAGGING\n─────────────────\nPREVIEW.dragging = TRUE\nWindow repositioned by title bar\ndragOffX/Y offset"];
    S_RESIZING [label="4 · RESIZING\n─────────────────\nPREVIEW.resizing = TRUE\nPREVIEW.resizeEdge 1-8 (N/NE/E/SE/S/SW/W/NW)\nMin size PREVIEW_MIN_W/H clamped"];
    S_PANNING [label="5 · PANNING\n─────────────────\nPREVIEW.panning = TRUE\nB1-drag in content (float mode only)\npanX/panY updated"];
    S_COLOR_PICK [label="6 · COLOR PICKING\n─────────────────\nPREVIEW_pick_color_at (colorPickEnabled)\nAlt+B1 → FG, Alt+B2 → BG\nSamples pixel from preview content"];

    S_HIDDEN -> S_VISIBLE [label="  F4 / Menu (action 434)\n  PREVIEW_toggle" color="#66cc66"];
    S_VISIBLE -> S_HIDDEN [label="  F4 / Menu\n  PREVIEW_toggle" color="#cc6666" style=dashed];
    S_VISIBLE -> S_DRAGGING [label="  B1 on title bar\n  PREVIEW.dragging = TRUE" color="#66cc66"];
    S_DRAGGING -> S_VISIBLE [label="  B1 released\n  Position saved to CFG" color="#cccc66"];
    S_VISIBLE -> S_RESIZING [label="  B1 on edge handle\n  PREVIEW_hit_resize_edge%" color="#66cc66"];
    S_RESIZING -> S_VISIBLE [label="  B1 released\n  Size saved to CFG" color="#cccc66"];
    S_VISIBLE -> S_PANNING [label="  B1-drag in content (float mode)\n  dbl-click = fit-to-window" color="#66cc66"];
    S_PANNING -> S_VISIBLE [label="  B1 released" color="#cccc66"];
    S_VISIBLE -> S_COLOR_PICK [label="  Alt+B1 / Alt+B2\n  (PREVIEW.colorPickEnabled)" color="#66cc66"];
    S_COLOR_PICK -> S_VISIBLE [label="  Color sampled" color="#cccc66"];

    subgraph cluster_modes {
        label="PREVIEW MODES" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        PM_FOLLOW [label="Follow Magnifier\n────────────\nPREVIEW.mode = 0 (PREVIEW_MODE_FOLLOW)\nfollowPointer% loupe\naround cursor position\nReal-time update"
                   fontsize=10.0];
        PM_FLOAT [label="Floating Image\n────────────\nPREVIEW.mode = 1 (PREVIEW_MODE_FLOAT)\nShows canvas or loaded image\nat independent zoom\nPan/zoom within window"
                  fontsize=10.0];
        PM_QUICK [label="Bin Quick Look (overlay, not a mode)\n────────────\nbinQuickLookActive% while hovering\ndrawer slot (binQuickLookEnabled)\nShows brush/pattern/gradient slot\nAuto-hides on leave"
                  fontsize=10.0];

        PM_FOLLOW -> PM_FLOAT [label=" PREVIEW_set_floating_mode\n (menu / action 2014)" color="#88aacc" fontsize=8.0];
        PM_FLOAT -> PM_FOLLOW [label=" PREVIEW_set_follow_mode\n (menu / action 2013)" color="#88aacc" fontsize=8.0];
        PM_FOLLOW -> PM_QUICK [label=" Drawer slot hover" color="#88aacc" fontsize=8.0];
        PM_FLOAT -> PM_QUICK [label=" Drawer slot hover" color="#88aacc" fontsize=8.0];
        PM_QUICK -> PM_FOLLOW [label=" Mouse leaves slot\n (return to prev mode)" color="#cc6666" fontsize=8.0 style=dashed];
        PM_QUICK -> PM_FLOAT [label=" Mouse leaves slot\n (return to prev mode)" color="#cc6666" fontsize=8.0 style=dashed];
    }

    subgraph cluster_features {
        label="PREVIEW FEATURES" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        F_ZOOM [label="Preview Zoom\n────────────\nMousewheel (PREVIEW_mouse_scroll)\nIndependent zoom level\nzoomMin 0.25x, zoomMax 16x"
                fontsize=10.0];
        F_RECENT [label="Recent Images\n────────────\nUp to 10 recent previews\nAccessible via submenu\nQuick comparison"
                  fontsize=10.0];
        F_CLAMP [label="Work-Area Clamping\n────────────\nWindow stays within\nscreen bounds\nSnap to edges"
                 fontsize=10.0];
    }

    MAIN -> S_HIDDEN [arrowhead=none color="#555555" style=dotted];
    MODES -> PM_FOLLOW [arrowhead=none color="#555555" style=dotted lhead=cluster_modes];
    INTERACT -> S_DRAGGING [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN; MODES; INTERACT }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate / Enter" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Close / Release" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Commit / Apply" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
