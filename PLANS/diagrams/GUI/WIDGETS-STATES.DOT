digraph G {
    label=" \n DRAW UI WIDGETS STATES \n " labelloc=t labeljust=c
    ordering=out
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true
    bgcolor=transparent
	edge [
		color=gray arrowhead=none arrowtail=none
        headport=n

	];
  	node [
  		color=white shape=rect
  		fontname="Cascadia Code PL", fontsize=12.0, fontcolor=cyan
  	]; 

    { node [shape=rect]; IDLE }
    { node [shape=folder color=orange penwidth=2]; WIDGETS }

    { edge [arrowtail=normal arrowhead=normal]; node [shape=rect];
        IDLE -> WIDGETS;
        WIDGETS -> PALETTE, PATTERN, WIDTH, MENUBAR, LAYERS, STATUSBAR, "SHARED WIDGETS";
        { node [shape=plain];
            PALETTE -> FG, BG, "CP <- ->"
            PALETTE -> { node [fontcolor=yellow]; DCLICKA } -> { node [shape=box3d]; "COLOR MIXER\n(COLORMIXER_toggle)" }
            PATTERN -> "PP <- ->"
            PATTERN -> { node [fontcolor=yellow]; DCLICKB } -> { node [shape=box3d]; "DRAWER (bins)" }
            WIDTH -> 1, 2, 3, 4, N
            MENUBAR -> FILE, EDIT, VIEW, SELECT, TOOLS, BRUSH, LAYER, "PALETTE menu", IMAGE, EFFECTS, "AI (opt)", HELP, AUDIO
            LAYERS -> "+", "-", "LP <- ->"
            STATUSBAR -> COLORCHIP -> "COLOR MIXER\n(COLORMIXER_toggle)"
        }

        // 2.0.0 shared immediate-mode dialog widgets (bound to DIALOG_CTX)
        { node [shape=plain];
            "SHARED WIDGETS" -> "SW_checkbox", "SW_radio", "SW_slider", "SW_spinner", "SW_dropdown", "SW_color_chip", "SW_file_picker", "SW_keybind", "SW_btn_group", "SW_text_field"
            "SHARED WIDGETS" -> "DIALOG_dropdown", "IMGDLG_dial (angle)", "IMGADJ_center_pick_pane", "SCROLLBAR"
        }

    }
}

