digraph DRAWER {
    label="DRAWER PANEL STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="MAIN STATES"];
        MODES [label="BIN MODES"];
        CTX [label="CONTEXT MENU"];
    }

    // ─────────────────────────────────────────────────────
    //  MAIN STATES
    // ─────────────────────────────────────────────────────

    S_HIDDEN [label="1 · HIDDEN\n─────────────────\nNot rendered when\nSCRN.showToolbar% = FALSE\n(DRAWER.visible% stays TRUE —\nvisibility follows toolbar)"];
    S_VISIBLE [label="2 · VISIBLE\n─────────────────\nDRAWER.visible% = TRUE\n30 slots (3 cols × 10 rows)\nDRAWER.mode% bin active\nMini palette shown"];
    S_HOVER_SLOT [label="3 · SLOT HOVER\n─────────────────\nDRAWER_slot_at% > 0\nSlot highlighted\nTooltip (TOOLTIP_SRC_BINS)\nWheel: cycle .dset files"];
    S_DRAG_SLOT [label="4 · SLOT DRAG\n─────────────────\nDRAWER.isDragging% = TRUE\ndragSourceSlot% / dragTargetSlot%\nDRAWER_handle_drag\nInsertion / swap preview"];
    S_CONTEXT [label="5 · CONTEXT MENU\n─────────────────\nR-click slot → DRAWER_context_menu_show\nPOPUP_MENU visible\nDRAWER.contextMenuOpen% = TRUE"];

    S_HIDDEN -> S_VISIBLE [label="  Toolbar shown" color="#66cc66"];
    S_VISIBLE -> S_HIDDEN [label="  Toolbar hidden" color="#cc6666" style=dashed];
    S_VISIBLE -> S_HOVER_SLOT [label="  Mouse over slot" color="#88aacc"];
    S_HOVER_SLOT -> S_VISIBLE [label="  Mouse leaves slot" color="#cc6666" style=dashed];
    S_HOVER_SLOT -> S_DRAG_SLOT [label="  B1 down + move > 3px\n  (dragPending → isDragging)" color="#66cc66"];
    S_DRAG_SLOT -> S_VISIBLE [label="  Release → DRAWER_handle_drop\n  swap (or Shift = insert)" color="#cccc66"];
    S_HOVER_SLOT -> S_CONTEXT [label="  Right-click (B2)" color="#66cc66"];
    S_CONTEXT -> S_VISIBLE [label="  Click item / outside / Escape" color="#cccc66"];
    S_HOVER_SLOT -> S_VISIBLE [
        label="  B1 click+release (no drag)\n  DRAWER_select_slot\n  brush/pattern/gradientSelected%"
        color="#cccc66"
    ];

    // ─────────────────────────────────────────────────────
    //  BIN MODES — Brush / Pattern / Gradient
    // ─────────────────────────────────────────────────────

    subgraph cluster_modes {
        label="BIN MODES — Brush / Pattern / Gradient" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        DM_BRUSH [label="Brush Bin\n────────────\nDRAWER.mode% = DRAWER_MODE_BRUSH (1)\nDRAWER_BRUSH_SLOTS() images\nSelect → custom brush (paintMode 1)"
                  fontsize=10.0];
        DM_PATTERN [label="Pattern Bin\n────────────\nDRAWER.mode% = DRAWER_MODE_PATTERN (2)\nDRAWER_PATTERN_SLOTS() tiles\nSelect → tiled paint (paintMode 3)"
                    fontsize=10.0];
        DM_GRADIENT [label="Gradient Bin\n────────────\nDRAWER.mode% = DRAWER_MODE_GRADIENT (3)\nGRAD_DEFS() editable gradients\nSelect → gradient paint (paintMode 2)"
                     fontsize=10.0];

        DM_BRUSH -> DM_PATTERN [
            label=" DRAWER_cycle_mode\n (M-click) or organizer\n Pattern widget"
            color="#88aacc" fontsize=8.0
        ];
        DM_PATTERN -> DM_GRADIENT [
            label=" DRAWER_cycle_mode\n or organizer Gradient"
            color="#88aacc" fontsize=8.0
        ];
        DM_GRADIENT -> DM_BRUSH [
            label=" DRAWER_cycle_mode\n or organizer Color widget"
            color="#88aacc" fontsize=8.0
        ];
    }

    // ─────────────────────────────────────────────────────
    //  CONTEXT MENU ITEMS (DRAWER_context_menu_build)
    // ─────────────────────────────────────────────────────

    subgraph cluster_context {
        label="SLOT CONTEXT MENU — POPUP_MENU" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        CM_INFO [label="Info rows (disabled)\n────────────\nSOURCE, SELECT (LMB),\nSTORE (Shift+LMB),\nCLEAR (Shift+MMB),\nLOAD (Shift+RMB)"
                 fontsize=10.0];
        CM_EDITGRAD [label="EDIT GRADIENT... (gradient mode)\n────────────\nDRAWER_CONTEXT_EDIT_GRADIENT\nGRADIENT_editor_dialog"
                     fontsize=10.0];
        CM_LOADIMG [label="LOAD IMAGES... (brush/pattern)\n────────────\nDRAWER_CONTEXT_LOAD_IMAGES\nDRAWER_load_images_into_slots"
                    fontsize=10.0];
        CM_LOADSET [label="LOAD DRAWER SET (.dset)\n────────────\nDRAWER_CONTEXT_LOAD_SET\nDRAWER_import_set_dialog"
                    fontsize=10.0];
        CM_SAVESET [label="SAVE DRAWER SET (.dset)\n────────────\nDRAWER_CONTEXT_SAVE_SET\nDRAWER_export_set_dialog"
                    fontsize=10.0];
        CM_CLEARSET [label="CLEAR DRAWER SET\n────────────\nDRAWER_CONTEXT_CLEAR_SET\nDRAWER_clear_active_set"
                     fontsize=10.0];
        CM_EXPLORE [label="EXPLORE FOLDER\n────────────\nDRAWER_CONTEXT_EXPLORE_FOLDER\nDRAWER_explore_context_folder"
                    fontsize=10.0];
    }

    // ─────────────────────────────────────────────────────
    //  MINI PALETTE
    // ─────────────────────────────────────────────────────

    subgraph cluster_mini_palette {
        label="MINI PALETTE" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        MP_IDLE [label="Mini Palette Idle\n────────────\nCompact color grid + page buttons\nFG / BG markers"
                 fontsize=10.0];
        MP_CLICK [label="Color Selected\n────────────\nDRAWER_select_palette_color\nL (B1) = FG (PAINT_COLOR~&)\nR (B2) = BG (PAINT_BG_COLOR~&)"
                  fontsize=10.0];

        MP_IDLE -> MP_CLICK [label=" Click color cell" color="#66cc66" fontsize=8.0];
        MP_CLICK -> MP_IDLE [label=" Color applied" color="#cccc66" fontsize=8.0];
    }

    MAIN -> S_HIDDEN [arrowhead=none color="#555555" style=dotted];
    MODES -> DM_BRUSH [arrowhead=none color="#555555" style=dotted lhead=cluster_modes];
    CTX -> CM_INFO [arrowhead=none color="#555555" style=dotted lhead=cluster_context];
    { rank=min; MAIN; MODES; CTX }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Show / Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Hide / Close" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Select / Commit" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
