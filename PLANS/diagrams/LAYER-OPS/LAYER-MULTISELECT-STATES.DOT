digraph LAYER_MULTISELECT {
    label="LAYER MULTI-SELECT STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="LAYER\nMULTI-SELECT"];
    }

    S_SINGLE [label="1 · SINGLE SELECT\n─────────────────\nLAYERS_select clears\nMULTI_SELECT, COUNT = 1\nMULTI_SELECT_LAYERS(cur)\nNormal painting mode"];
    S_MULTI [label="2 · MULTI-SELECT\n─────────────────\nMULTI_SELECT_COUNT > 1\n(MULTI_SELECT_has_any%)\nHighlighted in panel\nOps apply to all selected\nInvariant: COUNT >= 1"];
    S_GROUPADD [label="3 · GROUP ADD\n─────────────────\nCtrl+Click group header\nAdds group + all\ndescendants to selection\n(does NOT clear existing)"];

    S_SINGLE -> S_MULTI [label="  Ctrl/Shift+Click another\n  layer in panel\n  MULTI_SELECT_toggle" color="#66cc66"];
    S_SINGLE -> S_GROUPADD [label="  Ctrl+Click group header\n  Add group + descendants" color="#66cc66"];
    S_MULTI -> S_MULTI [label="  Ctrl/Shift+Click: toggle\n  layer in selection\n  (never deselect last)" color="#88aacc"];
    S_MULTI -> S_SINGLE [label="  Plain click layer body\n  LAYERS_select →\n  MULTI_SELECT_clear" color="#cc6666" style=dashed];
    S_GROUPADD -> S_MULTI [label="  More Ctrl/Shift+Click\n  Cross-group multi-select" color="#6699ff"];
    S_GROUPADD -> S_SINGLE [label="  Plain click layer body\n  MULTI_SELECT_clear" color="#cc6666" style=dashed];

    MAIN -> S_SINGLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_operations {
        label="MULTI-SELECT OPERATIONS" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        OP_MERGE [label="Merge Selected\n─────────────────\nLayer → Merge Selected\nComposite all selected\ninto bottom-most layer"];
        OP_DELETE [label="Delete Selected\n─────────────────\nDelete all selected\nlayers (keep ≥ 1)"];
        OP_VISIBLE [label="Toggle Visibility\n─────────────────\nShow/hide all\nselected layers"];
        OP_LOCK [label="Toggle Lock\n─────────────────\nLock/unlock all\nselected layers"];
        OP_ALIGN [label="Align / Distribute\n─────────────────\nAlign or distribute\nall selected layers\n(see ALIGN-DISTRIBUTE)"];
    }

    subgraph cluster_solo {
        label="SOLO MODE" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        SOLO_OFF [label="Solo OFF\n─────────────────\nLAYER_PANEL.soloLayer% = 0\nAll layers show\nnormal visibility"];
        SOLO_ON [label="Solo ON\n─────────────────\nsoloLayer% = layerIdx\nOthers hidden; a soloed\ngroup keeps descendants\nsavedVisibility (STRING*128)\nAlt+Click eye icon"];

        SOLO_OFF -> SOLO_ON [label="  Alt+Click eye\n  Solo this layer" color="#66cc66"];
        SOLO_ON -> SOLO_OFF [label="  Alt+Click same eye\n  or any plain eye click\n  Restore savedVisibility" color="#cc6666" style=dashed];
    }

    subgraph cluster_vis_swipe {
        label="VISIBILITY SWIPE" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        VS_IDLE [label="Idle\n─────────────────\nvisSwiping = FALSE\nNormal click toggles\nsingle layer visibility"];
        VS_ACTIVE [label="Swiping\n─────────────────\nvisSwiping = TRUE\nDrag over eye icons\nvisSwipeAction = on/off\nAll swiped layers toggled"];

        VS_IDLE -> VS_ACTIVE [label="  Click+drag over\n  multiple eye icons" color="#66cc66"];
        VS_ACTIVE -> VS_IDLE [label="  Mouse release\n  Swipe complete" color="#cc6666" style=dashed];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Select / Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deselect" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Mode switch" arrowhead=normal color="#6699ff" fontsize=9.0];
        L7 -> L8 [label=" Self-transition" arrowhead=normal color="#88aacc" fontsize=9.0];
    }
}
