digraph LAYER_ARRANGE {
    label="LAYER ARRANGE STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="LAYER\nARRANGE"];
    }

    S_IDLE [label="1 · IDLE\n─────────────────\nCURRENT_LAYER% active\nEach layer has zIndex\nRENDER_ORDER_DIRTY=FALSE"];

    MAIN -> S_IDLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_keyboard {
        label="KEYBOARD ARRANGE" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        K_UP [label="Move Up (action 703)\n─────────────────\nLayer → Arrange Up\nor Ctrl+PgUp\nLAYERS_move_up CURRENT_LAYER%\nSwap zIndex% with\nlayer above\nHISTORY_record_layer_reorder"];
        K_DOWN [label="Move Down (action 704)\n─────────────────\nLayer → Arrange Down\nor Ctrl+PgDn\nLAYERS_move_down CURRENT_LAYER%\nSwap zIndex% with\nlayer below\nHISTORY_record_layer_reorder"];
        K_TOP [label="Arrange to Top (action 708)\n─────────────────\nLayer → Arrange To Top\nor Ctrl+Shift+]\nLoops LAYERS_move_up\n  LAYER_COUNT% times\nEach step records reorder"];
        K_BOTTOM [label="Arrange to Bottom (action 709)\n─────────────────\nLayer → Arrange To Bottom\nor Ctrl+Shift+[\nLoops LAYERS_move_down\n  LAYER_COUNT% times\nEach step records reorder"];
    }

    subgraph cluster_drag {
        label="DRAG REORDER (LAYERS PANEL)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        D_PENDING [label="Drag Pending\n─────────────────\nLAYER_PANEL.dragPending% = TRUE\nisDragging% = FALSE\nMouse down on layer row\ndragStartY% = rawY%\ndragLayerIdx% = row\nWaiting for threshold"];
        D_DRAGGING [label="Dragging\n─────────────────\nLAYER_PANEL.isDragging% = TRUE\ndragLayerIdx% = source\ndragPreviewY% tracks mouse\ndropTargetZIndex% updated\nvia LAYER_PANEL_handle_drag"];
        D_AUTOSCROLL [label="Auto-Scroll\n─────────────────\nrawY% within AUTO_SCROLL_ZONE\nof panel top/bottom edge\nautoScrollTimer! throttle\nscrollOffset% steps by\nLAYER_ROW_HEIGHT"];
        D_DROP [label="Drop\n─────────────────\nRelease mouse\nLAYER_PANEL_handle_drop()\nMove layer to\ndropTargetZIndex%\nHISTORY_record_layer_reorder"];

        D_PENDING -> D_DRAGGING [label="  Mouse moves\n  past DRAG_THRESHOLD\n  (5px minimum)" color="#66cc66"];
        D_PENDING -> S_IDLE [label="  Mouse release\n  before threshold\n  (was a click)" color="#cc6666" style=dashed];
        D_DRAGGING -> D_AUTOSCROLL [label="  Mouse near\n  panel edge" color="#88aacc"];
        D_AUTOSCROLL -> D_DRAGGING [label="  Mouse moved\n  away from edge" color="#88aacc"];
        D_DRAGGING -> D_DROP [label="  Mouse release" color="#cccc66"];
        D_AUTOSCROLL -> D_DROP [label="  Mouse release" color="#cccc66"];
    }

    S_IDLE -> K_UP [label="  Arrange Up\n  Ctrl+PgUp" color="#6699ff"];
    S_IDLE -> K_DOWN [label="  Arrange Down\n  Ctrl+PgDn" color="#6699ff"];
    S_IDLE -> K_TOP [label="  Arrange To Top\n  Ctrl+Shift+]" color="#6699ff"];
    S_IDLE -> K_BOTTOM [label="  Arrange To Bottom\n  Ctrl+Shift+[" color="#6699ff"];
    S_IDLE -> D_PENDING [label="  Mouse down\n  on layer row" color="#66cc66"];

    subgraph cluster_post {
        label="POST-ARRANGE" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        P1 [label="Invalidation\n─────────────────\nRENDER_ORDER_DIRTY=TRUE\nSCENE_DIRTY = TRUE\nBLEND_invalidate_cache\nComposite below reset"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate / Start" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Cancel / Abort" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Commit / Record" arrowhead=normal color="#cccc66" fontsize=9.0];
        L7 -> L8 [label=" Rearrange / Move" arrowhead=normal color="#6699ff" fontsize=9.0];
    }
}
