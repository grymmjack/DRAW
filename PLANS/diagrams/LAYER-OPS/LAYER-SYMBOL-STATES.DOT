digraph LAYER_SYMBOL {
    label="LAYER SYMBOL STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [color=gray fontcolor="#aaaaaa" fontsize=9.0 fontname="Cascadia Code PL"];
    node [color=white shape=rect style="" fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="SYMBOL LAYER LIFECYCLE"];
    }

    S_NORMAL [label="1 · NORMAL LAYER\n─────────────────\nLAYER_TYPE_IMAGE (0)\nNo symbol relationship\nStandard pixel layer"];
    S_PARENT [label="2 · SYMBOL PARENT\n─────────────────\nLAYER_TYPE_SYMBOL_PARENT (3)\nEditable source layer\nEdits set symbolParentDirty%\nSync re-renders children"];
    S_CHILD [label="3 · SYMBOL CHILD\n─────────────────\nLAYER_TYPE_SYMBOL_CHILD (4)\nsymbolParentId& = parent\nhistoryId& (link)\nResolved by SYMBOL_find_parent_slot%\nDraw tools blocked (must detach)"];
    S_DETACHED [label="4 · DETACHED\n─────────────────\nChild → LAYER_TYPE_IMAGE\nsymbolParentId& = 0\nPixels frozen at current state\nIndependent edits allowed"];
    S_RASTERIZED [label="5 · RASTERIZED\n─────────────────\nParent → LAYER_TYPE_IMAGE\nAll children detached first\nSymbol bond broken\nPure raster layer"];

    S_NORMAL -> S_PARENT [label="  Convert to Symbol (730)\n  or New Symbol Layer (731)\n  SYMBOL_create_parent" color="#66cc66"];
    S_PARENT -> S_CHILD [label="  Create Instance (732)\n  SYMBOL_create_child\n  symbolParentId& set" color="#66cc66"];
    S_CHILD -> S_DETACHED [label="  Detach Instance (735)\n  SYMBOL_detach_child\n  Type → IMAGE, id = 0" color="#cccc66"];
    S_DETACHED -> S_NORMAL [label="  (immediate)" color="#cc6666" style=dashed];
    S_PARENT -> S_RASTERIZED [label="  Rasterize Symbol (734)\n  SYMBOL_rasterize_parent\n  All children detached" color="#cccc66"];
    S_RASTERIZED -> S_NORMAL [label="  (immediate)" color="#cc6666" style=dashed];

    subgraph cluster_sync {
        label="SYNC PROPAGATION  (Sync Symbols · 733 / on load / undo)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        SY1 [label="Parent Marked Dirty\n────────────\nSYMBOL_mark_parent_dirty\nsymbolParentDirty% = TRUE\non parent edit" fontsize=10.0];
        SY2 [label="Find Children\n────────────\nSYMBOL_find_children:\nsymbolParentId& ==\nparent historyId&" fontsize=10.0];
        SY3 [label="Replicate Pixels\n────────────\nSYMBOL_render_child\n_PUTIMAGE parent →\nchild (scale/offset/\nrotation/flip)" fontsize=10.0];
        SY4 [label="Finish Sync\n────────────\nchild contentDirty% = TRUE\nclear symbolParentDirty%\nBLEND_invalidate_cache\nINVALIDATE_scene" fontsize=10.0];

        SY1 -> SY2 -> SY3 -> SY4 [color="#88aacc" fontsize=8.0];
    }

    subgraph cluster_ops {
        label="ALLOWED OPERATIONS" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        O_PARENT [label="On Parent\n────────────\nDraw, paint, transform\nmarks dirty → Sync\nupdates all children" fontsize=10.0];
        O_CHILD_OK [label="Child: non-destructive\n────────────\nsymbolOffsetX/Y (move)\nsymbolScaleX/Y (flip = neg)\nsymbolRotation\nIndependent of parent" fontsize=10.0];
        O_CHILD_NO [label="Child: Paint Locked\n────────────\nDraw tools show alert\nMOUSE.BM guard blocks\nMust Detach (735) to paint" fontsize=10.0];
    }

    MAIN -> S_NORMAL [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Convert" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Reset" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Transition" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
