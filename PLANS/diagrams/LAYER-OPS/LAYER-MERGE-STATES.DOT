digraph LAYER_MERGE {
    label="LAYER MERGE STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="LAYER MERGE\nOPERATIONS"];
    }

    S_IDLE [label="1 · IDLE\n─────────────────\nNo merge active\nAll layers independent\nCURRENT_LAYER% set"];

    MAIN -> S_IDLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_merge_down {
        label="MERGE DOWN" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        MD_TRIGGER [label="Trigger (action 705)\n─────────────────\nLayer → Merge Down\nor Ctrl+Alt+E\nLAYERS_merge_down\nMerges current into\nlayer below"];
        MD_GUARD [label="Guard\n─────────────────\ncurrentZ% > 1\n(has a layer below,\nzIndex = currentZ - 1)\nelse EXIT SUB"];
        MD_SNAPSHOT [label="Snapshot Both\n─────────────────\nHISTORY_record_layer_merge\n  mrgSlot%, targetIndex%\nCaptures both layers'\nbefore-state"];
        MD_COMPOSITE [label="Composite\n─────────────────\n_DEST below.imgHandle&\nBlend current onto below:\n• non-Normal → LAYER_blend_composite\n• opacity<255 → per-pixel alpha\n• else _PUTIMAGE _BLEND\ntarget.contentDirty% = TRUE"];
        MD_CLEANUP [label="Delete Source\n─────────────────\nHISTORY_IN_PROGRESS% = TRUE\nLAYERS_delete mrgSlot%\nLAYERS_select targetIndex%\nINVALIDATE_scene"];

        MD_TRIGGER -> MD_GUARD [label="  Execute" color="#cccc66"];
        MD_GUARD -> MD_SNAPSHOT [label="  Has layer below" color="#cccc66"];
        MD_GUARD -> MD_TRIGGER [label="  No layer below\n  Abort" color="#cc6666" style=dashed];
        MD_SNAPSHOT -> MD_COMPOSITE [label="  Saved" color="#cccc66"];
        MD_COMPOSITE -> MD_CLEANUP [label="  Blended" color="#66cc66"];
    }

    subgraph cluster_merge_selected {
        label="MERGE SELECTED" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        MS_TRIGGER [label="Trigger (action 711)\n─────────────────\nLayer → Merge Selected\n(no hotkey)\nHandled in COMMAND CASE 711\nMerges multi-selected\nlayers into one"];
        MS_GUARD [label="Guard\n─────────────────\n≥ 2 layers multi-selected\n(MULTI_SELECT_has_any%)\nMenu item disabled otherwise"];
        MS_COMPOSITE [label="Composite All\n─────────────────\nHISTORY_record_layer_merge_visible\nsorted by zIndex\nNew layer via LAYERS_new%\nname = \"Merged\"\nBottom-up composite,\nrespect blend modes"];
        MS_CLEANUP [label="Remove Merged\n─────────────────\nResult = NEW \"Merged\" layer\nLAYERS_delete each selected\n(HISTORY_IN_PROGRESS%)\nLAYERS_select new layer"];

        MS_TRIGGER -> MS_GUARD [label="  Execute" color="#cccc66"];
        MS_GUARD -> MS_COMPOSITE [label="  ≥ 2 selected" color="#cccc66"];
        MS_COMPOSITE -> MS_CLEANUP [label="  Composited" color="#66cc66"];
    }

    subgraph cluster_merge_all {
        label="MERGE ALL (FLATTEN)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        MA_TRIGGER [label="Trigger (action 706)\n─────────────────\nLayer → Merge All\nor Ctrl+Alt+Shift+E\nLAYERS_merge_visible\n(VISIBLE layers only)"];
        MA_GUARD [label="Guard\n─────────────────\n≥ 2 visible layers\n(sortCount% >= 2)\nelse EXIT SUB"];
        MA_SNAPSHOT [label="Snapshot All\n─────────────────\nHISTORY_record_layer_merge_visible\n  sortedLayers%(), sortCount%\nCaptures all source\nlayers' before-state"];
        MA_FLATTEN [label="Flatten Visible\n─────────────────\nNew layer via LAYERS_new%\nname = \"Merged\"\nBottom-up composite of\nVISIBLE layers by zIndex\nRespect blend + opacity"];
        MA_CLEANUP [label="Merged Layer\n─────────────────\nResult = NEW \"Merged\" layer\nLAYERS_delete source\n  visible layers\n(HISTORY_IN_PROGRESS%)\nLAYERS_select new layer\n(hidden layers preserved)"];

        MA_TRIGGER -> MA_GUARD [label="  Execute" color="#cccc66"];
        MA_GUARD -> MA_SNAPSHOT [label="  ≥ 2 visible" color="#cccc66"];
        MA_GUARD -> MA_TRIGGER [label="  < 2 visible\n  Abort" color="#cc6666" style=dashed];
        MA_SNAPSHOT -> MA_FLATTEN [label="  All saved" color="#cccc66"];
        MA_FLATTEN -> MA_CLEANUP [label="  Composited" color="#66cc66"];
    }

    subgraph cluster_merge_group {
        label="MERGE GROUP" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        MG_TRIGGER [label="Trigger (action 723)\n─────────────────\nLayer → Merge Group\n(no hotkey)\nLAYERS_merge_group\nCurrent layer is a group"];
        MG_GUARD [label="Guard\n─────────────────\nlayerType% = LAYER_TYPE_GROUP\nGet descendants via\nLAYERS_group_descendants\n(empty group → just\ndelete header)"];
        MG_SNAPSHOT [label="Snapshot\n─────────────────\nIF NOT HISTORY_IN_PROGRESS%\nHISTORY_record_merge_group\n  grpSlot%, childBuf%(),\n  childCount%"];
        MG_COMPOSITE [label="Composite Children\n─────────────────\nBottom-up composite of\nall descendants by zIndex\nResult inherits group\nname, blendMode%, opacity%"];
        MG_CLEANUP [label="Collapse Group\n─────────────────\nDelete group header +\nall child layers\nSingle merged layer remains"];

        MG_TRIGGER -> MG_GUARD [label="  Execute" color="#cccc66"];
        MG_GUARD -> MG_SNAPSHOT [label="  Has children" color="#cccc66"];
        MG_SNAPSHOT -> MG_COMPOSITE [label="  Saved" color="#cccc66"];
        MG_COMPOSITE -> MG_CLEANUP [label="  Composited" color="#66cc66"];
    }

    S_IDLE -> MD_TRIGGER [label="  Merge Down\n  Ctrl+Alt+E" color="#cccc66"];
    S_IDLE -> MS_TRIGGER [label="  Merge Selected" color="#cccc66"];
    S_IDLE -> MA_TRIGGER [label="  Merge All\n  Ctrl+Alt+Shift+E" color="#cccc66"];
    S_IDLE -> MG_TRIGGER [label="  Merge Group" color="#cccc66"];

    subgraph cluster_post {
        label="POST-MERGE STATE" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        P1 [label="Invalidation\n─────────────────\nSCENE_DIRTY = TRUE\nCANVAS_DIRTY = TRUE\nRENDER_ORDER_DIRTY = TRUE\nBLEND invalidate cache\nAll caches reset"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Create / Composite" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Delete / Abort" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Step / Record" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
