digraph UI_MAIN_LOOP {
    label="UI / MAIN-LOOP STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    // ─────────────────────────────────────────────────────
    //  MAIN-LOOP PIPELINE (DRAW.BAS)
    // ─────────────────────────────────────────────────────

    S_LOOP_START [label="LOOP_start\n────────────\nDRAW.BAS:525\nreset HISTORY_saved_this_frame%"];
    S_MUSIC [label="MUSIC_tick\n────────────\nDRAW.BAS:530 (primary instance only)"];
    S_DROP [label="DROP_tick\n────────────\nDRAW.BAS:541 (target-aware drag-drop)"];
    S_MOUSE [label="MOUSE_input_handler\n────────────\nDRAW.BAS:557"];
    S_KEY [label="KEYBOARD_input_handler\n────────────\nDRAW.BAS:561"];
    S_DISPATCH [label="INPUT_dispatch_frame\n────────────\nDRAW.BAS:570\ncentral binding dispatch"];
    S_IDLE_DETECT [label="Idle detect\n────────────\nDRAW.BAS:582-713\nFRAME_IDLE% ; SCENE_CHANGED%→SCENE_DIRTY%"];
    S_RENDER [label="SCREEN_render (if not idle)\n────────────\nDRAW.BAS:788\nSCENE_DIRTY%→rebuild SCENE_CACHE&\nelse SkipToPointer fast path (SCREEN.BM:1821)"];
    S_LOOP_END [label="LOOP_end\n────────────\nDRAW.BAS:828 ; _LIMIT after render"];

    S_LOOP_START -> S_MUSIC [color="#88aacc"];
    S_MUSIC -> S_DROP [color="#88aacc"];
    S_DROP -> S_MOUSE [color="#88aacc"];
    S_MOUSE -> S_KEY [color="#88aacc"];
    S_KEY -> S_DISPATCH [color="#88aacc"];
    S_DISPATCH -> S_IDLE_DETECT [color="#88aacc"];
    S_IDLE_DETECT -> S_RENDER [color="#88aacc"];
    S_RENDER -> S_LOOP_END [color="#88aacc"];
    S_LOOP_END -> S_LOOP_START [label=" next frame" color="#88aacc"];

    // ─────────────────────────────────────────────────────
    //  LEGEND
    // ─────────────────────────────────────────────────────

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1

        L1 [label="" shape=point width=0.01];
        L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01];
        L4 [label="" shape=point width=0.01];

        L1 -> L2 [label=" Frame flow / next step" arrowhead=normal color="#88aacc" fontsize=9.0];
        L3 -> L4 [label=" Loop back (next frame)" arrowhead=normal color="#88aacc" fontsize=9.0];
    }
}
