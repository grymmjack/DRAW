digraph SELECTION_LIFECYCLE {
    label="SELECTION LIFECYCLE STATE MACHINE\nMARQUEE + MAGIC WAND + the shared SELECTION_MASK across tools (v2.0.0)"
    labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=22.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="SELECTION STATES"];
        SHARED [label="SHARED BUFFER"];
        CONSUME [label="CONSUMERS"];
    }

    // ---- The shared buffer node ----
    BUF [label="MARQUEE.SELECTION_MASK  (TOOLS/MARQUEE.BI:93)\n─────────────────────────────\ncanvas-sized 32-bit image · white = selected\ncompanions: WAND_HAS_SELECTION, WAND_MIN/MAX_X/Y (bbox),\nWAND_EDGE_X()/Y() outline cache\nguard idiom: WAND_HAS_SELECTION AND SELECTION_MASK < -1"
        color="#ffcc00" fontcolor="#ffcc00" penwidth=2];

    // ---- Main lifecycle ----
    S_NONE [label="1 · NO SELECTION\n─────────────────\nWAND_HAS_SELECTION = FALSE\nSELECTION_MASK = 0\nMARQUEE.ACTIVE = FALSE\nwhole layer editable"];
    S_MARQUEE [label="2 · MARQUEE DRAWN\n─────────────────\nrect/freehand/poly/ellipse drag\nMARQUEE.BOX set, ACTIVE=TRUE\nUSER_CREATED=TRUE\n(MARQUEE.BM:645-745)"];
    S_WAND [label="3 · WAND SELECTED\n─────────────────\nMAGIC_WAND_select_* flood\nwrites SELECTION_MASK\nsets WAND_HAS_SELECTION + bbox\n(MARQUEE.BM:1080/1603/1861)"];
    S_CLIP [label="4 · CLIP ACTIVE\n─────────────────\ndrawing tools gated by\nSELECTION_is_point_inside%\n(BRUSH.BM:66) — paint stays inside\nmask KEPT across tool switch"];
    S_FLOAT [label="5 · FLOATING\n─────────────────\nMOVE captures masked pixels\nMOVE_capture_selection\nmasks through SELECTION_MASK\n(MOVE.BM:326-355)"];
    S_CLEAR [label="6 · CLEARED\n─────────────────\nMAGIC_WAND_reset frees mask,\nclears flags, REDIMs edge cache\n(MARQUEE.BM:1036)"];

    S_NONE -> S_MARQUEE [label="  drag marquee" color="#66cc66"];
    S_NONE -> S_WAND [label="  W + click\n  wand flood" color="#66cc66"];
    S_MARQUEE -> S_WAND [label="  merge on mouseup\n  (MARQUEE.BM:2841)" color="#88aacc"];
    S_WAND -> S_WAND [label="  Shift/Alt click\n  ADD/SUB merges onto mask\n  (REPLACE self-heals first)" color="#88aacc"];
    S_MARQUEE -> S_CLIP [label="  switch to a draw tool\n  mask kept as clip" color="#6699ff"];
    S_WAND -> S_CLIP [label="  switch to a draw tool\n  mask kept as clip" color="#6699ff"];
    S_CLIP -> S_FLOAT [label="  V / paste\n  MOVE_capture_selection" color="#cccc66"];
    S_FLOAT -> S_CLIP [label="  commit move\n  mask shifted with content\n  (MOVE.BM:1035-1057)" color="#cccc66"];
    S_MARQUEE -> S_CLEAR [label="  ESC / deselect\n  or includeMarquee reset" color="#cc6666" style=dashed];
    S_WAND -> S_CLEAR [label="  ESC / new REPLACE wand\n  MAGIC_WAND_reset" color="#cc6666" style=dashed];
    S_CLIP -> S_CLEAR [label="  Ctrl+D deselect" color="#cc6666" style=dashed];
    S_CLEAR -> S_NONE [label="  back to clean" color="#88aacc"];

    // ---- BUG-1 edge ----
    S_BUG [label="⚠ BUG-1 · STALE MASK\n─────────────────\npaste keeps WAND mask live but\noverwrites MARQUEE.BOX; MOVE shifts\nstale mask → wand selects\ncontent that isn't there"
        color="#ff6666" fontcolor="#ff8888"];
    S_CLIP -> S_BUG [label="  CLIPBOARD_paste\n  TOOLS_reset_all FALSE\n  (mask NOT cleared)" color="#ff4444" penwidth=2 style=bold];
    S_BUG -> S_FLOAT [label="  paste engages MOVE\n  drags stale mask" color="#ff4444" penwidth=2 style=bold];

    // ---- Consumers cluster ----
    subgraph cluster_consumers {
        label="CONSUMERS — read the mask via WAND_HAS_SELECTION AND SELECTION_MASK < -1" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        CN [label="fill FG/BG (COMMAND.BM:2675/2741) · H/V flip (:3447/3637)\ncrop (:5218) · clear-sel (SELECTION.BM:440) · stroke-sel (STROKE-SEL.BM:264)\nsave (SAVE.BM:476) · image-adjust (IMAGE-ADJ.BM:162-390)\nHISTORY snapshot/restore (HISTORY.BM:1725/1765)" fontsize=10.0];
    }

    // ---- anchors ----
    MAIN -> S_NONE [arrowhead=none color="#555555" style=dotted];
    SHARED -> BUF [arrowhead=none color="#555555" style=dotted];
    CONSUME -> CN [arrowhead=none color="#555555" style=dotted lhead=cluster_consumers];
    BUF -> CN [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN; SHARED; CONSUME }

    // ---- Legend ----
    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        LB1 [label="" shape=point width=0.01]; LB2 [label="" shape=point width=0.01];
        L1 -> L2 [label=" create selection" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" clear / deselect" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" float / commit" arrowhead=normal color="#cccc66" fontsize=9.0];
        L7 -> L8 [label=" keep as clip / self" arrowhead=normal color="#6699ff" fontsize=9.0];
        LB1 -> LB2 [label=" ⚠ BUG-1 stale-mask path" arrowhead=normal color="#ff4444" penwidth=2 style=bold fontsize=9.0];
    }
}
