digraph CLIPBOARD_LIFECYCLE {
    label="CLIPBOARD LIFECYCLE STATE MACHINE\nCopy / Cut / Paste / Paste-as-Layer / clone-float / commit (v2.0.0)"
    labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=22.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        PIX [label="PIXEL CLIPBOARD"];
        LAY [label="LAYER CLIPBOARD"];
    }

    // ================= PIXEL CLIPBOARD =================
    P_STORE [label="CLIPBOARD (CLIPBOARD_OBJ)\n─────────────────\nTOOLS/SELECTION.BI:16\nIMAGE, WIDTH, HEIGHT, VALID, SOURCE_X/Y\nsynced to OS via _CLIPBOARDIMAGE"
        color="#ffcc00" fontcolor="#ffcc00" penwidth=2];

    P_IDLE [label="1 · IDLE\n─────────────────\nCLIPBOARD.VALID = FALSE"];
    P_COPIED [label="2 · COPIED / CUT\n─────────────────\nCLIPBOARD_copy (SELECTION.BM:65)\nreads active layer OR MOVE float;\nif WAND selection → reads through\nSELECTION_MASK (SELECTION.BM:107-128)"];
    P_FLOAT [label="3 · PASTE FLOAT\n─────────────────\nCLIPBOARD_paste (SELECTION.BM:234)\nMOVE.SELECTION_IMAGE + PREVIEW_BUFFER\nCURRENT_TOOL%=TOOL_MOVE, MOVE.ACTIVE\nMOVE.IS_PASTE=TRUE (clone mode)\nrenders only while tool=MOVE"];
    P_COMMIT [label="4 · COMMITTED\n─────────────────\nMOVE_reset → MOVE_apply_transform\nIS_PASTE ⇒ clone (never wipes layer)\nHISTORY recorded"];

    P_IDLE -> P_COPIED [label="  Ctrl+C / Ctrl+X\n  (303/304)" color="#66cc66"];
    P_COPIED -> P_FLOAT [label="  Ctrl+V (305)\n  or paste-from-OS (330)" color="#66cc66"];
    P_FLOAT -> P_FLOAT [label="  drag to position\n  clone stamp keeps sel live" color="#88aacc"];
    P_FLOAT -> P_COMMIT [label="  switch tool / click away\n  MOVE_apply_transform" color="#cccc66"];
    P_COMMIT -> P_IDLE [label="  float consumed\n  (CLIPBOARD still VALID)" color="#6699ff"];

    // ---- BUG edges ----
    P_BUG1 [label="⚠ BUG-1\n─────────────────\npaste preserves stale WAND mask\n(TOOLS_reset_all FALSE);\nmove shifts it → phantom wand sel"
        color="#ff6666" fontcolor="#ff8888"];
    P_BUG3 [label="⚠ BUG-3\n─────────────────\nfloat not discarded by New/Open;\nstamps onto NEW doc on next Move.\nfix: MOVE_cancel_transform in\nall 3 doc-creation paths"
        color="#ff6666" fontcolor="#ff8888"];
    P_FLOAT -> P_BUG1 [label="  wand mask left live" color="#ff4444" penwidth=2 style=bold];
    P_FLOAT -> P_BUG3 [label="  File→New / Open\n  while float active" color="#ff4444" penwidth=2 style=bold];

    // ================= LAYER CLIPBOARD (cross-instance) =================
    subgraph cluster_layer {
        label="LAYER CLIPBOARD — cross-instance (TOOLS/LAYERXFER.BM)" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        L_COPY [label="Copy Layer (715)\n────────────\nLAYERXFER_extract_layer&\n_CLIPBOARDIMAGE + _CLIPBOARD$ meta\n(COMMAND.BM:1859)" fontsize=10.0];
        L_PASTE [label="Paste Layer (716)\n────────────\nLAYERXFER_add_layer%\nbuilds a NEW layer\n(COMMAND.BM:1873) — no wand mask" fontsize=10.0];
        L_NEWLAY [label="Paste as New Layer (320/321)\nNew from Clipboard (COMMAND.BM:2394)\n────────────\nDRW_create_canvas_at_size" fontsize=10.0];

        L_COPY -> L_PASTE [label=" other instance\n or same" color="#66cc66" fontsize=8.0];
        L_COPY -> L_NEWLAY [label=" paste-as-layer" color="#66cc66" fontsize=8.0];
    }

    // ---- anchors ----
    PIX -> P_STORE [arrowhead=none color="#555555" style=dotted];
    P_STORE -> P_IDLE [arrowhead=none color="#555555" style=dotted];
    LAY -> L_COPY [arrowhead=none color="#555555" style=dotted lhead=cluster_layer];
    { rank=min; PIX; LAY }

    // ---- Legend ----
    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        LB1 [label="" shape=point width=0.01]; LB2 [label="" shape=point width=0.01];
        L1 -> L2 [label=" copy / paste" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" commit float" arrowhead=normal color="#cccc66" fontsize=9.0];
        L5 -> L6 [label=" consumed / re-edit" arrowhead=normal color="#6699ff" fontsize=9.0];
        LB1 -> LB2 [label=" ⚠ BUG-1 / BUG-3 paths" arrowhead=normal color="#ff4444" penwidth=2 style=bold fontsize=9.0];
    }
}
