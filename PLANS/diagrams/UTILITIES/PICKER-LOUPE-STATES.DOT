digraph PICKER_LOUPE_STATES {
    label="COLOR PICKER LOUPE STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="PICKER LOUPE"];
    }

    S_HIDDEN [label="1 · HIDDEN\n─────────────────\nPICKER_LOUPE.ACTIVE = FALSE\nNo magnifier visible\nBUFFER not allocated"];
    S_VISIBLE [label="2 · VISIBLE\n─────────────────\nPICKER_LOUPE.ACTIVE = TRUE\nMagnified region at mouse\nBUFFER + TEXT_BUFFER allocated\nSAMPLE_COLOR displayed"];
    S_SAMPLING [label="3 · SAMPLING CANVAS\n─────────────────\nCursor over canvas work area\nPICKER_LOUPE_render(dest&)\nframes composited:\n• magnified region (zoom\n  default 8×, configurable)\n• #RRGGBB hex overlay\n• R:/G:/B: value overlay\n• X:/Y: coord overlay\n• center pixel-pickup marker\nPICKER_compose_region +\nPICKER_resolve_sample_color~&"];
    S_CHROME [label="4 · SAMPLING CHROME (2.0.0)\n─────────────────\nCursor over GUI chrome\nREGION_hit_test% > REGION_CANVAS\nloupeChrome% = TRUE\nMagnifies SCENE_CACHE&\n(composited frame incl. UI)\nSAMPLE_COLOR = raw pixel\nsuppression gate skipped —\nAlt+click eyedrops ANY\non-screen pixel, UI included"];

    S_HIDDEN -> S_VISIBLE [label="  PICKER_LOUPE_activate()\n  Allocate BUFFER image\n  Allocate TEXT_BUFFER" color="#66cc66"];
    S_VISIBLE -> S_SAMPLING [label="  Cursor over canvas\n  work area" color="#66cc66"];
    S_VISIBLE -> S_CHROME [label="  Cursor over GUI panel\n  (region id > CANVAS)" color="#66cc66"];
    S_SAMPLING -> S_SAMPLING [label="  Mouse moves\n  SAMPLE_COLOR updated\n  Region re-composited" color="#88aacc"];
    S_CHROME -> S_CHROME [label="  Mouse moves\n  re-sample SCENE_CACHE" color="#88aacc"];
    S_SAMPLING -> S_CHROME [label="  Cursor crosses onto\n  GUI chrome" color="#cc66cc"];
    S_CHROME -> S_SAMPLING [label="  Cursor crosses back\n  onto canvas" color="#cc66cc"];
    S_VISIBLE -> S_HIDDEN [label="  PICKER_LOUPE_deactivate()\n  Free BUFFER\n  Free TEXT_BUFFER" color="#cc6666" style=dashed];
    S_SAMPLING -> S_HIDDEN [label="  Picker deselected /\n  Alt released" color="#cc6666" style=dashed];
    S_CHROME -> S_HIDDEN [label="  Picker deselected /\n  Alt released" color="#cc6666" style=dashed];

    MAIN -> S_HIDDEN [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_display {
        label="DISPLAY CONTENT" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        D1 [label="Magnified Region\n─────────────────\nBUFFER_W × BUFFER_H pixels\nzoom default 8× (config /\ntheme PICKER_LOUPE_zoom_level)\nCanvas: composited layers\nChrome: SCENE_CACHE& pixels"];
        D2 [label="Text Overlay\n─────────────────\nTEXT_BUFFER renders:\n• #RRGGBB hex code\n• R:/G:/B: values\n• X:/Y: sample coords\n• Font: FONT_HANDLE"];
        D3 [label="Pixel-Pickup Marker\n─────────────────\nCenter sample pixel marked\nwith PICKER_LOUPE_PIXEL_\nPICKUP_COLOR (default green)\nSAMPLE_COLOR is the result"];
    }

    subgraph cluster_integration {
        label="INTEGRATION" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        I1 [label="Used by PICKER tool\n─────────────────\nPICKER_activate (key I)\ncalls PICKER_LOUPE_activate\nAlso Hold Alt = Temp Color\nPicker (action 1206)\nLMB picks FG, RMB picks BG"];
        I2 [label="Color Resolution\n─────────────────\nCanvas: PICKER_compose_region\n+ PICKER_resolve_sample_color~&\nthrough the layer stack\nChrome: raw SCENE_CACHE& pixel"];
        I3 [label="Suppression\n─────────────────\nPICKER_LOUPE_should_suppress%\nhides loupe over panels on\nthe CANVAS path only; the\nCHROME path skips the gate\nto magnify the UI itself"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deactivate" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Self-transition" arrowhead=normal color="#88aacc" fontsize=9.0];
        L7 -> L8 [label=" Region switch" arrowhead=normal color="#cc66cc" fontsize=9.0];
    }
}
