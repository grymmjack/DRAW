digraph COLOR_MODE_STATES {
    label="COLOR MODE SLOT STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="COLOR MODE\nSLOT"];
    }

    S_NORMAL [label="1 · NORMAL\n─────────────────\nPAINT_COLOR~& = FG\nPAINT_BG_COLOR~& = BG\nPAL_FG_IDX% / PAL_BG_IDX%\nStandard painting mode"];
    S_SWAPPED [label="2 · SWAPPED\n─────────────────\nFG ↔ BG swapped\nPAINT_COLOR~& ↔ PAINT_BG_COLOR~&\nPAL_FG_IDX% ↔ PAL_BG_IDX%\n+ transparent flags swapped"];
    S_RESET [label="3 · DEFAULT COLORS\n─────────────────\nFG = White _RGB32(255,255,255)\nBG = Black _RGB32(0,0,0)\nPAL_*_IS_TRANSPARENT% = FALSE"];
    S_BGTRANS [label="4 · BG TRANSPARENT\n─────────────────\nPAL_BG_IS_TRANSPARENT% = TRUE\nPAINT_BG_COLOR~& = _RGBA32(0,0,0,0)\nRight-click / BG erases"];

    S_NORMAL -> S_SWAPPED [label="  Press X · action 517\n  (inline in CMD_execute_action)\n  swaps FG/BG slots + idx + trans" color="#6699ff"];
    S_SWAPPED -> S_NORMAL [label="  Press X again · action 517\n  swap is its own inverse" color="#6699ff"];
    S_NORMAL -> S_RESET [label="  Ctrl+D · action 518\n  Default Colors (White/Black)" color="#cc6666" style=dashed];
    S_SWAPPED -> S_RESET [label="  Ctrl+D · action 518\n  Default Colors (White/Black)" color="#cc6666" style=dashed];
    S_NORMAL -> S_BGTRANS [label="  Shift+Delete · action 519\n  Set BG Transparent" color="#cc66cc"];
    S_BGTRANS -> S_NORMAL [label="  Pick a solid BG color\n  PAL_BG_IS_TRANSPARENT% = FALSE" color="#66cc66"];
    S_RESET -> S_NORMAL [label="  Pick new color\n  from palette or canvas\n  FG/BG updated" color="#66cc66"];

    MAIN -> S_NORMAL [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_fg {
        label="FOREGROUND COLOR" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        FG_PAL [label="From Palette\n─────────────────\nLeft-click palette strip\nPAL_color~&(index%)\nPAL_FG_IDX% stored"];
        FG_PICK [label="From Canvas\n─────────────────\nPicker tool left-click\nSample blended color\nat canvas position"];
        FG_DIALOG [label="From Dialog\n─────────────────\naction 1505 → FG picker\nPALETTE_PICKER_show~&\nCustom color selection"];
        FG_TRANSPARENT [label="Transparent FG\n─────────────────\nPAL_FG_IS_TRANSPARENT%\n= TRUE\nEraser mode active\n_RGBA32(0,0,0,0)"];
    }

    subgraph cluster_bg {
        label="BACKGROUND COLOR" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        BG_PAL [label="From Palette\n─────────────────\nRight-click palette strip\nPAL_color~&(index%)\nPAL_BG_IDX% stored"];
        BG_PICK [label="From Canvas\n─────────────────\nPicker tool right-click\nSample blended color\nat canvas position"];
    }

    subgraph cluster_invert {
        label="IMAGE INVERT" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        INV [label="Invert (Image menu)\n─────────────────\naction 2007 → IMAGE_ADJ_invert\nR=255-R, G=255-G, B=255-B\nInverts LAYER/IMAGE pixels,\nnot the FG/BG color slots"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Set / Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Reset / Clear" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Swap / Toggle" arrowhead=normal color="#6699ff" fontsize=9.0];
        L7 -> L8 [label=" Special (BG transparent)" arrowhead=normal color="#cc66cc" fontsize=9.0];
    }
}
