digraph FILL_ADJUST {
    label="FILL ADJUST OVERLAY STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [color=gray fontcolor="#aaaaaa" fontsize=9.0 fontname="Cascadia Code PL"];
    node [color=white shape=rect style="" fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="FILL ADJUST (F8 OVERLAY)"];
    }

    S_INACTIVE [label="1 · INACTIVE\n─────────────────\nFILL_ADJ.ACTIVE% = FALSE\n(FILL_ADJ.ENABLED% may be\nTRUE, armed but idle)\nCustom brush / paint\nrenders normally tiled"];
    S_ACTIVE [label="2 · ACTIVE OVERLAY\n─────────────────\nFILL_ADJ.ACTIVE% = TRUE\nEntered via FILL_ADJ_enter_*\nafter a fill/brush release\nL-handle + rotate handle\ndrawn over tile preview\nWheel = uniform scale"];
    S_DRAG_OFFSET [label="3 · DRAGGING PAN\n─────────────────\nDRAG_MODE = FILL_ADJ_DRAG_PAN\nB1 on background\nUpdate ORIGIN_X!, ORIGIN_Y!\nFRAME_IDLE% = FALSE"];
    S_DRAG_SCALE [label="4 · DRAGGING SCALE\n─────────────────\nDRAG_MODE = UNIFORM / SCALE_X /\nSCALE_Y (L-handle hit-test)\nUpdate TILE_W!, TILE_H!"];
    S_DRAG_ROT [label="5 · DRAGGING ROTATE\n─────────────────\nDRAG_MODE = FILL_ADJ_DRAG_ROTATE\nB1 on rotation arc handle\nUpdate ROTATION! (degrees)\nvia _ATAN2 from START_ANGLE"];
    S_COMMITTING [label="6 · COMMITTING\n─────────────────\nEnter → FILL_ADJ_commit\nValues persist on tool\nPixels flushed to layer +\nHISTORY record"];

    S_INACTIVE -> S_ACTIVE [label="  F8 arms ENABLED, then a\n  fill/brush release calls\n  FILL_ADJ_enter_* (ACTIVE=TRUE)" color="#66cc66"];
    S_ACTIVE -> S_INACTIVE [label="  Esc → FILL_ADJ_cancel\n  (restore pre-shape pixels)" color="#cc6666" style=dashed];
    S_ACTIVE -> S_DRAG_OFFSET [label="  B1 on background\n  FILL_ADJ_handle_mouse_press" color="#66cc66"];
    S_DRAG_OFFSET -> S_ACTIVE [label="  B1 released" color="#cccc66"];
    S_ACTIVE -> S_DRAG_SCALE [label="  B1 on L-handle arm/corner" color="#66cc66"];
    S_DRAG_SCALE -> S_ACTIVE [label="  B1 released" color="#cccc66"];
    S_ACTIVE -> S_DRAG_ROT [label="  B1 on rotate arc handle" color="#66cc66"];
    S_DRAG_ROT -> S_ACTIVE [label="  B1 released" color="#cccc66"];
    S_ACTIVE -> S_COMMITTING [label="  Enter pressed" color="#cccc66"];
    S_COMMITTING -> S_INACTIVE [label="  Pixels written to layer\n  (ENABLED% stays latched)" color="#cc6666" style=dashed];

    subgraph cluster_handles {
        label="HANDLES" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        H1 [label="Background / Pan\n────────────\nDRAG_PAN moves tile origin\nORIGIN_X!, ORIGIN_Y!" fontsize=10.0];
        H2 [label="L-Handle\n────────────\nCorner = DRAG_UNIFORM\nHoriz arm = DRAG_SCALE_X (TILE_W)\nVert arm = DRAG_SCALE_Y (TILE_H)" fontsize=10.0];
        H3 [label="Rotation Arc Handle\n────────────\nDRAG_ROTATE\nROTATION! in degrees\n(_ATAN2 from START_ANGLE)" fontsize=10.0];
    }

    subgraph cluster_targets {
        label="APPLIES TO" labelloc=t labeljust=l
        fontcolor=orange fontsize=11.0 color=orange style=dashed penwidth=1

        TG1 [label="Custom Brush Tile\n────────────\nPAINT_MODE = FILL_ADJ_PAINT_BRUSH\nCUSTOM_BRUSH_is_active%" fontsize=10.0];
        TG2 [label="Drawer Paint Mode\n────────────\nPAINT_MODE = PATTERN / GRADIENT\nDRAWER_has_paint_mode%\nTiled fills for rect /\nellipse / polygon / flood" fontsize=10.0];
    }

    MAIN -> S_INACTIVE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deactivate" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Transition" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
