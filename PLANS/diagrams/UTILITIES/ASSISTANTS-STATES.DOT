strict digraph G {
    label=" \n DRAW UI ASSISTANT STATES \n " labelloc=t labeljust=c
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true
    bgcolor=transparent

	edge [
		color=gray arrowhead=none arrowtail=none
        headport=n

	];
  	node [
  		color=white shape=rect
  		fontname="Cascadia Code PL", fontsize=12.0, fontcolor=cyan
  	]; 

    { node [shape=folder color=darkorange penwidth=2 fontcolor=white style=filled]; ASSISTANT }

    { edge [arrowhead=normal]; node [shape=rect];
        ASSISTANT -> { node [shape=rect fontcolor=yellow margin=0.2 style=rounded]; "Z" } -> ZOOM
        ASSISTANT -> { node [shape=box3d fontcolor=yellow margin=0.2]; "SHIFT\n(hold)" } -> { node [shape=rect color=magenta style=dashed]; CROSSHAIR }
        ASSISTANT -> { node [shape=box3d fontcolor=yellow margin=0.2]; "F7" } -> { node [shape=rect color=magenta style=dashed]; SYMMETRY }
        ASSISTANT -> { node [shape=rect fontcolor=yellow margin=0.2 style=rounded]; "ALT (hold)\nor I" } -> "COLOR PICKER"
        ASSISTANT -> { node [shape=rect fontcolor=yellow margin=0.2 style=rounded]; "SPACE or\nMIDDLE-CLICK" } -> PAN
        { node [shape=plain];
            "COLOR PICKER" -> { node [fontcolor=yellow]; "LEFT CLICK" } -> "FOREGROUND\nCOLOR"
            "COLOR PICKER" -> { node [fontcolor=yellow]; "RIGHT CLICK" } -> "BACKGROUND\nCOLOR"
            ZOOM -> { node [fontcolor=yellow]; "LEFT CLICK " } -> "ZOOM\nIN"
            ZOOM -> { node [fontcolor=yellow]; "ALT CLICK " } -> "ZOOM\nOUT"
            ZOOM -> { node [fontcolor=yellow]; "DRAG REGION" } -> "ZOOM TO\nREGION"
            SYMMETRY -> { node [fontcolor=yellow]; "F8" } -> "CLEAR\nCENTER"
            SYMMETRY -> { node [fontcolor=yellow]; "CTRL+CLICK" } -> "SET\nCENTER"
            PAN -> { node [fontcolor=yellow]; "LEFT DRAG" } -> "PAN CANVAS"
          }
    }
}

