digraph CROSSHAIR_STATES {
    label="CROSSHAIR ASSISTANT STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="CROSSHAIR\nASSISTANT"];
    }

    S_OFF [label="1 · IDLE (SHIFT up)\n─────────────────\nNo crosshair drawn\nCROSSHAIR_ASSIST holds only\nfont + text-buffer scratch\n(no VISIBLE/ACTIVE flag)\nDefault state"];
    S_ON [label="2 · ACTIVE (SHIFT held)\n─────────────────\nRENDER_crosshair_and_command_palette\ncalls CROSSHAIR_render\nFull-screen H+V guide lines\nintersect at mouse position\nCoordinate label at cursor\nOutline stroke configurable"];
    S_DRAWING [label="3 · CONSTRAINED / ROTATED\n─────────────────\nCONSTRAIN_X% / CONSTRAIN_Y%\naxis-lock one line + coord\nCROSSHAIR_ANGLE <> 0 rotates\nboth guide lines\nStill only while SHIFT held"];

    S_OFF -> S_ON [label="  Hold SHIFT (no CTRL)\n  mouse over work area\n  CURRENT_TOOL% <> TOOL_TEXT" color="#66cc66"];
    S_ON -> S_OFF [label="  Release SHIFT, or mouse\n  over UI chrome, or\n  Text tool active" color="#cc6666" style=dashed];
    S_ON -> S_DRAWING [label="  CONSTRAIN_X/Y set, or\n  CROSSHAIR_ANGLE <> 0" color="#88aacc"];
    S_DRAWING -> S_ON [label="  Constraint cleared\n  angle back to 0" color="#88aacc"];
    S_ON -> S_ON [label="  Mouse moves\n  CROSSHAIR_render\n  redraws each frame" color="#88aacc"];

    MAIN -> S_OFF [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_outline {
        label="OUTLINE STROKE" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        O_NONE [label="No Outline\n─────────────────\nSingle-pixel lines\nDirect color only\noutline_width = 0"];
        O_STROKE [label="With Outline\n─────────────────\nCFG.CROSSHAIR_OUTLINE_WIDTH%\n(theme CROSSHAIR_outline_width,\nfallback 1) offset strokes\nbehind the main lines"];

        O_NONE -> O_STROKE [label="  outline_width > 0" color="#6699ff"];
        O_STROKE -> O_NONE [label="  outline_width = 0" color="#6699ff"];
    }

    subgraph cluster_rendering {
        label="RENDER PIPELINE" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        R1 [label="CROSSHAIR_render()\n─────────────────\nNo params; dest& = _DEST\nDraw vertical + horizontal\nlines at screen mouse coords\nCROSSHAIR_show_coords% gates\nlabel (FALSE when Alt+picker)"];
        R2 [label="After Scene Cache\n─────────────────\nCalled from cursor-overlay\nsection (after SkipToPointer)\nvia RENDER_crosshair_and_\ncommand_palette; not cached"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deactivate" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Self-transition" arrowhead=normal color="#88aacc" fontsize=9.0];
    }
}
