digraph GRID_STATES {
    label="GRID STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="GRID SYSTEM"];
    }

    // Main visibility states
    S_HIDDEN [label="1 · GRID HIDDEN\n─────────────────\nGRID.SHOW% = FALSE\nNo grid overlay\n(snap independent —\nGRID.SNAP% may be TRUE)"];
    S_VISIBLE [label="2 · GRID VISIBLE\n─────────────────\nGRID.SHOW% = TRUE\nGrid lines drawn\non canvas overlay\nGRID_draw() renders"];

    S_HIDDEN -> S_VISIBLE [label="  Toggle grid (action 8101)\n  ' apostrophe  or  View → Grid\n  GRID.SHOW% = NOT GRID.SHOW%" color="#66cc66"];
    S_VISIBLE -> S_HIDDEN [label="  Toggle grid (action 8101)\n  ' apostrophe  or  View → Grid\n  GRID.SHOW% = NOT GRID.SHOW%" color="#cc6666" style=dashed];
    S_VISIBLE -> S_VISIBLE [label="  Grid settings change\n  GRID_draw() re-renders\n  SCENE_DIRTY% = TRUE" color="#88aacc"];

    MAIN -> S_HIDDEN [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_snap {
        label="SNAP MODES" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        SNAP_OFF [label="Snap OFF\n─────────────────\nGRID.SNAP% = FALSE\nMouse coords unmodified\nPixel-precise placement"];
        SNAP_CORNER [label="Snap + Corner Align\n─────────────────\nGRID.SNAP% = TRUE\nGRID.ALIGN_MODE% =\nGRID_ALIGN_CORNER (0)\nSnaps to grid intersections"];
        SNAP_CENTER [label="Snap + Center Align\n─────────────────\nGRID.SNAP% = TRUE\nGRID.ALIGN_MODE% =\nGRID_ALIGN_CENTER (1)\nSnaps to grid cell centers"];

        SNAP_OFF -> SNAP_CORNER [label="  Toggle snap (action 8104)\n  ; semicolon\n  GRID.SNAP% = NOT GRID.SNAP%" color="#66cc66"];
        SNAP_CORNER -> SNAP_CENTER [label="  Toggle align (action 8105)\n  / slash — flips ALIGN_MODE" color="#6699ff"];
        SNAP_CENTER -> SNAP_CORNER [label="  Toggle align (action 8105)\n  / slash — flips ALIGN_MODE" color="#6699ff"];
        SNAP_CENTER -> SNAP_OFF [label="  Toggle snap (action 8104)\n  ; semicolon" color="#cc6666" style=dashed];
        SNAP_CORNER -> SNAP_OFF [label="  Toggle snap (action 8104)\n  ; semicolon" color="#cc6666" style=dashed];
    }

    subgraph cluster_modes {
        label="GRID GEOMETRY MODES (GRID.GRID_MODE%)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        MODE_SQUARE [label="Square Grid\n─────────────────\nGRID_MODE_SQUARE (0)\nRectangular grid\ngridWidth × gridHeight"];
        MODE_DIAGONAL [label="Diagonal Grid\n─────────────────\nGRID_MODE_DIAGONAL (1)\n45° diamond grid"];
        MODE_ISOMETRIC [label="Isometric Grid\n─────────────────\nGRID_MODE_ISOMETRIC (2)\n2:1 iso (26.565°\ndiagonals + vertical)"];
        MODE_HEX [label="Hex Grid\n─────────────────\nGRID_MODE_HEX (3)\nHexagonal grid"];

        MODE_SQUARE -> MODE_DIAGONAL [label="  Cycle mode (action 8103)\n  Ctrl+'  (MOD GRID_MODE_COUNT)" color="#6699ff"];
        MODE_DIAGONAL -> MODE_ISOMETRIC [label="  Ctrl+'" color="#6699ff"];
        MODE_ISOMETRIC -> MODE_HEX [label="  Ctrl+'" color="#6699ff"];
        MODE_HEX -> MODE_SQUARE [label="  Ctrl+'  (wraps to 0)" color="#6699ff"];
    }

    subgraph cluster_cell_fill {
        label="GRID CELL FILL" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        CF_OFF [label="Cell Fill OFF\n─────────────────\nGRID.CELL_FILL% = FALSE\nNormal pixel painting\nNo cell-wide operations"];
        CF_ON [label="Cell Fill ON\n─────────────────\nGRID.CELL_FILL% = TRUE\nFill tool fills whole\ngrid cell (not flood)"];

        CF_OFF -> CF_ON [label="  Toggle cell fill (action 908)\n  View → Grid menu\n  GRID.CELL_FILL% = NOT ..." color="#66cc66"];
        CF_ON -> CF_OFF [label="  Toggle cell fill" color="#cc6666" style=dashed];
    }

    subgraph cluster_offset_pick {
        label="GRID OFFSET PICK (G+O chord)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        OP_IDLE [label="Offset Pick IDLE\n─────────────────\nGRID_OFFSET_PICK_MODE% = FALSE\nGRID.xPos% / yPos% fixed"];
        OP_ACTIVE [label="Offset Pick ACTIVE\n─────────────────\nGRID_OFFSET_PICK_MODE% = TRUE\nClick canvas to set\ngrid origin (xPos,yPos)"];

        OP_IDLE -> OP_ACTIVE [label="  G+O chord (action 9004)\n  GRID_OFFSET_PICK_MODE% = TRUE" color="#66cc66"];
        OP_ACTIVE -> OP_IDLE [label="  Click sets offset,\n  or Esc cancels\n  (G+R resets → action 9001)" color="#cc6666" style=dashed];
    }

    subgraph cluster_rendering {
        label="RENDER REQUIREMENTS" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        R1 [label="GRID_draw()\n─────────────────\nRenders into\nGRID.imgHandle&\nMust be called on\nsettings change"];
        R2 [label="Invalidation\n─────────────────\nSet SCENE_DIRTY = TRUE\nSet FRAME_IDLE = FALSE\nAfter any grid change"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deactivate" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Mode switch" arrowhead=normal color="#6699ff" fontsize=9.0];
        L7 -> L8 [label=" Self-transition" arrowhead=normal color="#88aacc" fontsize=9.0];
    }
}
