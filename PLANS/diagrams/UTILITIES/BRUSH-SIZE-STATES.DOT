digraph BRUSH_SIZE_STATES {
    label="BRUSH SIZE STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="BRUSH SIZE\nTOOLS/BRUSH-SIZE.BM"];
    }

    S_ROUND  [label="ROUND\n─────────────────\nBRUSH_SIZE.SHAPE = 0\nBRUSH_SIZE.CURRENT = 1..25 (index)\nBRUSH_PIXEL_SIZES() = odd 1..49\nRound / circular dab"];
    S_SQUARE [label="SQUARE (default init)\n─────────────────\nBRUSH_SIZE.SHAPE = -1\nSquare brush stamp\nCURRENT = 1..25 (index)"];
    S_PIXEL_PERFECT [label="PIXEL-PERFECT edge\n─────────────────\nBRUSH_SIZE.PIXEL_PERFECT = -1\nEDGE_MODE_TARGET = EDGE_TARGET_PP\nRemoves corner pixels\nMutually exclusive with AA"];
    S_AA [label="ANTI-ALIAS edge\n─────────────────\nCFG.ANTIALIAS% = TRUE\nEDGE_MODE_TARGET = EDGE_TARGET_AA\nSoft dab edges\nMutually exclusive with PP"];

    S_ROUND -> S_SQUARE [label="  608 BRUSH_SIZE_toggle_shape\n  SHAPE = NOT SHAPE (-1)" color="#6699ff"];
    S_SQUARE -> S_ROUND [label="  608 BRUSH_SIZE_toggle_shape\n  SHAPE = NOT SHAPE (0)" color="#6699ff"];

    S_ROUND -> S_PIXEL_PERFECT [label="  609 BRUSH_SIZE_toggle_pixel_perfect (F6)\n  PIXEL_PERFECT = -1\n  turns AA off" color="#66cc66"];
    S_PIXEL_PERFECT -> S_ROUND [label="  609 toggle again\n  PIXEL_PERFECT = 0" color="#cc6666" style=dashed];
    S_PIXEL_PERFECT -> S_AA [label="  enable AA\n  clears PIXEL_PERFECT" color="#cc66cc"];
    S_AA -> S_PIXEL_PERFECT [label="  enable PP\n  clears ANTIALIAS" color="#cc66cc"];

    S_ROUND -> S_ROUND [label="  ] / Ctrl+Wheel up: increase (+1, clamp MAX 25)\n  [ / Ctrl+Wheel down: decrease (-1, clamp MIN 1)\n  601/602 -> BRUSH_SIZE_decrease/increase" color="#88aacc"];
    S_SQUARE -> S_SQUARE [label="  Same +/- step logic\n  step_size = 1" color="#88aacc"];

    MAIN -> S_ROUND [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_presets {
        label="SIZE PRESETS (set via Organizer / Edit Bar click)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        P1 [label="PRESET1\n─────────────────\nindex 1 = 1px\nBRUSH_SIZE_set_preset 1"];
        P2 [label="PRESET2\n─────────────────\nindex 2 = 3px\nBRUSH_SIZE_set_preset 2"];
        P3 [label="PRESET3\n─────────────────\nindex 3 = 5px\nBRUSH_SIZE_set_preset 3"];
        P4 [label="PRESET4 (action 606)\n─────────────────\nindex 5 = 9px\nBRUSH_SIZE_set_preset 4"];

        P1 -> P2 [style=invis];
        P2 -> P3 [style=invis];
        P3 -> P4 [style=invis];
    }

    subgraph cluster_preview {
        label="EDGE PREVIEW (brush outline)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        PR_ON [label="Preview ON (default)\n─────────────────\nBRUSH_SIZE.PREVIEW = -1\nCFG.DEFAULT_BRUSH_EDGES = TRUE\nBrush outline at cursor"];
        PR_OFF [label="Preview OFF\n─────────────────\nBRUSH_SIZE.PREVIEW = 0\nNo brush outline"];

        PR_ON -> PR_OFF [label="  607 BRUSH_SIZE_toggle_preview\n  PREVIEW = NOT PREVIEW; CONFIG_save" color="#cc6666" style=dashed];
        PR_OFF -> PR_ON [label="  607 toggle again" color="#66cc66"];
    }

    subgraph cluster_persistence {
        label="PERSISTENCE" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        D1 [label="CFG-backed\n─────────────────\nCFG.DEFAULT_BRUSH_EDGES%\nCFG.ANTIALIAS%\nEDGE_MODE_TARGET\nSaved via CONFIG_save"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L9 [label="" shape=point width=0.01]; LA [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Deactivate" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Mode toggle" arrowhead=normal color="#6699ff" fontsize=9.0];
        L7 -> L8 [label=" Self-transition" arrowhead=normal color="#88aacc" fontsize=9.0];
        L9 -> LA [label=" Edge exclusivity" arrowhead=normal color="#cc66cc" fontsize=9.0];
    }
}
