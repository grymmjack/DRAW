digraph TRANSFORM_QUICK_OPS {
    label="QUICK TRANSFORM OPERATIONS STATE MACHINE\n(Edit menu — Flip / Rotate / Scale; auto-floats a marquee selection in 2.0.0)" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="QUICK\nTRANSFORMS"];
    }

    S_IDLE [label="1 · IDLE\n─────────────────\nActive layer selected\n(CURRENT_LAYER%)\nOptional marquee selection\nNo transform pending"];

    S_AUTOFLOAT [label="2 · AUTO-FLOAT CHECK\n─────────────────\nCMD_autofloat_for_transform\n(GUI/COMMAND.BM:5752)\nIF SELECTION_has_active% THEN\n  CURRENT_TOOL% = TOOL_MOVE\n  TOOLS_reset_all FALSE\n  MOVE_capture_selection\n  → op targets floated pixels\nELSE op targets whole layer\n(non-destructive, mask-aware)"];

    MAIN -> S_IDLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    S_IDLE -> S_AUTOFLOAT [label="  Any Edit-menu\n  transform action" color="#66cc66"];

    subgraph cluster_flip {
        label="FLIP OPERATIONS" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        FLIP_H [label="Flip Horizontal (315)\n─────────────────\nEdit → FLIP HORIZONTAL\nHotkey: Home\nMirror pixels left↔right\nImmediate, no preview"];
        FLIP_V [label="Flip Vertical (316)\n─────────────────\nEdit → FLIP VERTICAL\nHotkey: End\nMirror pixels top↔bottom\nImmediate, no preview"];

        FH_EXEC [label="Execute Flip H\n─────────────────\nCMD_ml_flip_h layerIdx%\n1. Snapshot before img\n2. _PUTIMAGE mirror X\n3. HISTORY_record_transform\n   \"Flip Horizontal\""];
        FV_EXEC [label="Execute Flip V\n─────────────────\nCMD_ml_flip_v layerIdx%\n1. Snapshot before img\n2. _PUTIMAGE mirror Y\n3. HISTORY_record_transform\n   \"Flip Vertical\""];

        FLIP_H -> FH_EXEC [label="  Apply" color="#cccc66"];
        FLIP_V -> FV_EXEC [label="  Apply" color="#cccc66"];
    }

    subgraph cluster_rotate {
        label="ROTATE OPERATIONS" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        ROT_CW [label="Rotate 90 CW (319)\n─────────────────\nEdit → ROTATE 90 CW\nHotkey: >  (Shift+.)\nSwap width↔height\nRemap dst(y,W-1-x)=src(x,y)"];
        ROT_CCW [label="Rotate 90 CCW (320)\n─────────────────\nEdit → ROTATE 90 CCW\nHotkey: <  (Shift+,)\nSwap width↔height\nRemap dst(H-1-y,x)=src(x,y)"];

        RCW_EXEC [label="Execute Rotate CW\n─────────────────\nCMD_ml_rotate_cw layerIdx%\n1. New image (H×W swapped)\n2. Copy rotated pixels\n3. Replace layer img\n4. HISTORY_record_transform\n   \"Rotate 90 CW\""];
        RCCW_EXEC [label="Execute Rotate CCW\n─────────────────\nCMD_ml_rotate_ccw layerIdx%\n1. New image (H×W swapped)\n2. Copy rotated pixels\n3. Replace layer img\n4. HISTORY_record_transform\n   \"Rotate 90 CCW\""];

        ROT_CW -> RCW_EXEC [label="  Apply" color="#cccc66"];
        ROT_CCW -> RCCW_EXEC [label="  Apply" color="#cccc66"];
    }

    subgraph cluster_scale {
        label="SCALE OPERATIONS" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        SCALE_UP [label="Scale 2X (318)\n─────────────────\nEdit → SCALE 2X\nHotkey: PgUp\nEnlarge layer pixels ×2\nNearest-neighbor"];
        SCALE_DOWN [label="Scale -50% (317)\n─────────────────\nEdit → SCALE -50%\nHotkey: PgDn\nShrink layer pixels ×0.5\nNearest-neighbor"];

        SU_EXEC [label="Execute Scale 2X\n─────────────────\nCMD_ml_scale layerIdx%, 2.0!\n1. New image (W×2, H×2)\n2. _PUTIMAGE scale\n3. Replace layer img\n4. HISTORY_record_transform\n   \"Scale 2x\""];
        SD_EXEC [label="Execute Scale -50%\n─────────────────\nCMD_ml_scale layerIdx%, 0.5!\n1. New image (W×.5, H×.5)\n2. _PUTIMAGE scale\n3. Replace layer img\n4. HISTORY_record_transform\n   \"Scale -50%\""];

        SCALE_UP -> SU_EXEC [label="  Apply" color="#cccc66"];
        SCALE_DOWN -> SD_EXEC [label="  Apply" color="#cccc66"];
    }

    S_AUTOFLOAT -> FLIP_H [label="  315" color="#6699ff"];
    S_AUTOFLOAT -> FLIP_V [label="  316" color="#6699ff"];
    S_AUTOFLOAT -> ROT_CW [label="  319" color="#6699ff"];
    S_AUTOFLOAT -> ROT_CCW [label="  320" color="#6699ff"];
    S_AUTOFLOAT -> SCALE_UP [label="  318" color="#6699ff"];
    S_AUTOFLOAT -> SCALE_DOWN [label="  317" color="#6699ff"];

    subgraph cluster_notes {
        label="NOTES (2.0.0)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=magenta style=dashed penwidth=1

        NT_MULTI [label="Multi-target dispatch\n─────────────────\nEach action can apply to:\n• floated marquee selection\n• active layer\n• active custom brush\n• MULTI_SELECT layer set\nCMD_group_expand_for_op for groups"];
        NT_SPECIAL [label="Also available\n─────────────────\nSCALE 2X H (331)\nSCALE 2X V (333)\n(stretch one axis)\nvia command palette"];
        NT_MULTI -> NT_SPECIAL [style=invis];
    }

    subgraph cluster_post {
        label="POST-TRANSFORM" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        P1 [label="Invalidation\n─────────────────\nSCENE_DIRTY% = TRUE\nCANVAS_DIRTY% = TRUE\nBLEND_invalidate_cache\ncontentDirty% = TRUE\nfor affected layer"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate / Auto-float" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Dispatch operation" arrowhead=normal color="#6699ff" fontsize=9.0];
        L5 -> L6 [label=" Commit / Record" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
