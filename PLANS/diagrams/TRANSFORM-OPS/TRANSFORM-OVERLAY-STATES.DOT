digraph TRANSFORM_OVERLAY {
    label="TRANSFORM OVERLAY STATE MACHINE\n(Scale / Rotate / Shear / Distort / Perspective)" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="TRANSFORM\nOVERLAY"];
    }

    S_IDLE [label="1 · IDLE\n─────────────────\nTRANSFORM.ACTIVE = FALSE\nNo overlay visible\nNormal drawing mode"];
    S_ACTIVATED [label="2 · ACTIVATED\n─────────────────\nTRANSFORM_activate(mode)\n(TOOLS/TRANSFORM.BM:343)\nTRANSFORM.ACTIVE = TRUE\nTRANSFORM.MODE = mode\nTRANSFORM.PREV_TOOL saved\nSRC region = marquee box OR\nopaque bbox scan; SRC_IMG\ncaptured; 4 corner handles +\npivot set; GRABBED = -1"];
    S_HOVERING [label="3 · HOVERING\n─────────────────\nMouse over overlay\nTRANSFORM_hittest% (0-3 / -1)\nCursor changes on hover\nGRABBED = -1 (none)"];
    S_GRABBED [label="4 · GRABBED\n─────────────────\nTRANSFORM.GRABBED = index\n0-3 = corners (TL/TR/BR/BL)\n4 = body (move all)\nDRAG_OFX/OFY set"];
    S_DRAGGING [label="5 · DRAGGING\n─────────────────\nTRANSFORM_mouse_hold()\nupdates handle positions\nTRANSFORM_PREVIEW_DIRTY=TRUE\nTRANSFORM_compute_preview\nrewarps each frame"];
    S_COMMITTED [label="6 · COMMITTED\n─────────────────\nTRANSFORM_commit()\n(TOOLS/TRANSFORM.BM:462)\nErase SRC region, blit warp\nHISTORY_record_transform\nACTIVE = FALSE\nCURRENT_TOOL% = PREV_TOOL"];
    S_CANCELLED [label="7 · CANCELLED\n─────────────────\nTRANSFORM_cancel()\n(TOOLS/TRANSFORM.BM:442)\nDiscard SRC_IMG, layer intact\nACTIVE = FALSE\nCURRENT_TOOL% = PREV_TOOL"];

    S_IDLE -> S_ACTIVATED [label="  Transform Scale/Distort/\n  Perspective/Rotate/Shear\n  (Edit cat / Command Palette)\n  CMD_execute_action 325-329\n  TRANSFORM_activate(mode)" color="#66cc66"];
    S_ACTIVATED -> S_HOVERING [label="  Mouse enters overlay\n  (intercepted while ACTIVE,\n  INPUT/MOUSE.BM:4920)" color="#66cc66"];
    S_HOVERING -> S_GRABBED [label="  Mouse press on handle/body\n  TRANSFORM_mouse_press()\n  GRABBED = 0-3 or 4" color="#66cc66"];
    S_GRABBED -> S_DRAGGING [label="  Mouse move\n  Begin drag" color="#cccc66"];
    S_DRAGGING -> S_HOVERING [label="  Mouse release\n  TRANSFORM_mouse_release()\n  GRABBED = -1\n  Finalize drag step" color="#cc6666" style=dashed];
    S_HOVERING -> S_COMMITTED [label="  Press Enter\n  TRANSFORM_commit()" color="#cccc66"];
    S_HOVERING -> S_CANCELLED [label="  Press Escape\n  TRANSFORM_cancel()" color="#cc6666" style=dashed];
    S_DRAGGING -> S_DRAGGING [label="  Mouse moves\n  Update handle positions\n  Recompute preview" color="#88aacc"];

    MAIN -> S_IDLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    // ---- KNOWN GAP (BUG-2): plain tool switch does NOT commit/cancel ----
    BUG2 [label="⚠ KNOWN GAP — BUG-2\n─────────────────\nA plain tool switch calls\nTOOLS_reset_all (GUI/GUI.BM:22)\nwhich does NOT call\nTRANSFORM_commit / _cancel.\nTRANSFORM.ACTIVE stays TRUE →\norphaned overlay: SRC_IMG leaks,\noverlay renders over new tool.\nOnly Enter/Esc cleanly exit." fontcolor="#cc6666" color="#cc6666"];
    S_ACTIVATED -> BUG2 [label="  Switch tool\n  (no commit/cancel)" color="#cc6666" style=dashed];
    S_HOVERING  -> BUG2 [label="  Switch tool\n  (no commit/cancel)" color="#cc6666" style=dashed];

    subgraph cluster_modes {
        label="TRANSFORM MODES (TRANSFORM_MODE_*)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        M_SCALE [label="MODE_SCALE (1)\n─────────────────\nDrag corners to scale\nSCALE_X/Y computed\nfrom corner deltas\nShift = lock aspect"];
        M_ROTATE [label="MODE_ROTATE (2)\n─────────────────\nDrag corners around\nPIVOT (center point)\nANGLE computed from\nmouse angle to pivot"];
        M_SHEAR [label="MODE_SHEAR (3)\n─────────────────\nSkew one axis\nDrag top/bottom = H shear\nDrag left/right = V shear"];
        M_DISTORT [label="MODE_DISTORT (4)\n─────────────────\nFree-form corner drag\nEach corner independent\nArbitrary quadrilateral"];
        M_PERSPECTIVE [label="MODE_PERSPECTIVE (5)\n─────────────────\nHomography transform\nPerspective projection\nCorner movement with\nperspective constraints"];

        M_SCALE -> M_ROTATE [style=invis];
        M_ROTATE -> M_SHEAR [style=invis];
        M_SHEAR -> M_DISTORT [style=invis];
        M_DISTORT -> M_PERSPECTIVE [style=invis];
    }

    subgraph cluster_handles {
        label="HANDLE SYSTEM" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        H1 [label="Corner Handles (0-3)\n─────────────────\nTRANSFORM_HX/HY(0..3)\nTL=0, TR=1, BR=2, BL=3\nDrag to transform"];
        H2 [label="Body Drag (4)\n─────────────────\nGRABBED = 4\nTranslate all corners\nequally (move)"];
        H3 [label="Pivot Point\n─────────────────\nTRANSFORM_PX/PY\nCenter of rotation\nDisplayed as crosshair"];
    }

    subgraph cluster_modifiers {
        label="MODIFIER / HOTKEYS" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        MOD_SHIFT [label="SHIFT held (per mode)\n─────────────────\nSCALE: lock aspect ratio\nROTATE: 15° angle snap\nPERSPECTIVE: wall projection\n(see hint bar in\nTRANSFORM_render_status)"];
        MOD_ROTKEYS [label="> / < keys\n─────────────────\nWhile ACTIVE (KEYBOARD.BM):\n> → TRANSFORM_rotate_step 90\n< → TRANSFORM_rotate_step -90\n90° step rotation of overlay"];
        MOD_ENTER [label="ENTER / ESC\n─────────────────\nENTER → TRANSFORM_commit\nESC   → TRANSFORM_cancel\nThe ONLY clean exits\n(see BUG-2 for tool switch)"];
    }

    subgraph cluster_preview {
        label="PREVIEW RENDERING" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        PR1 [label="TRANSFORM_PREVIEW_IMG\n─────────────────\nWarped preview image\nUpdated each drag step\nTRANSFORM_PREVIEW_DIRTY\nflags when recompute needed"];
        PR2 [label="TRANSFORM_render_overlay()\n─────────────────\nRuns while TRANSFORM.ACTIVE\n(OUTPUT/SCREEN.BM:3461)\nDraw handle squares\nDraw guide lines\nDraw pivot crosshair\nDraw warped preview"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate / Start" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Cancel / Release" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Commit / Record" arrowhead=normal color="#cccc66" fontsize=9.0];
        L7 -> L8 [label=" Self-transition" arrowhead=normal color="#88aacc" fontsize=9.0];
    }
}
