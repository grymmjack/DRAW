digraph LOAD_RECENT_STATES {
    label="LOAD RECENT STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="LOAD\nRECENT"];
    }

    S_IDLE [label="1 · IDLE\n─────────────────\nCurrent project loaded\nor new blank canvas\nRecent files tracked"];
    S_UNSAVED_CHECK [label="2 · UNSAVED CHECK\n─────────────────\nCheck CANVAS_DIRTY%\nor unsaved changes\nPrompt: Save? / Don't / Cancel"];
    S_LOADING [label="3 · LOADING\n─────────────────\nDRW_load(filename) sniffs\nfirst 8 bytes:\n • PNG sig → DRW_load_from_png\n • DRW_MAGIC → DRW_load_binary\n • else → flat _LOADIMAGE\nParse + restore all state"];
    S_LOADED [label="4 · LOADED\n─────────────────\nAll layers restored\nTool state reset\nPalette loaded\nDrawer slots loaded\nGrid/symmetry reset\nCANVAS_DIRTY = FALSE"];

    S_IDLE -> S_UNSAVED_CHECK [label="  File → Open Recent\n  or File → Open\n  or recent file click\n  or deferred action" color="#66cc66"];
    S_UNSAVED_CHECK -> S_LOADING [label="  Save first (saved)\n  or Don't Save" color="#cccc66"];
    S_UNSAVED_CHECK -> S_IDLE [label="  Cancel\n  Abort load" color="#cc6666" style=dashed];
    S_LOADING -> S_LOADED [label="  File parsed OK\n  State restored" color="#66cc66"];
    S_LOADING -> S_IDLE [label="  File error\n  Invalid format\n  or file not found" color="#cc6666" style=dashed];
    S_LOADED -> S_IDLE [label="  Return to\n  normal mode" color="#cccc66"];

    MAIN -> S_IDLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_recent {
        label="RECENT FILES LIST" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        R1 [label="File → RECENT (action 213)\n─────────────────\nSubmenu enabled when\nRECENT_FILE_COUNT% > 0\nMost recent first\nFull path shown"];
        R2 [label="Stored In Config\n─────────────────\nDRAW.cfg persists\nrecent file paths\nUpdated on save/load"];
        R3 [label="Command-Line Load\n─────────────────\nDRAW.run filename.drw\nDeferred to first frame\nSkips recent menu"];
    }

    subgraph cluster_formats {
        label="SUPPORTED FORMATS" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        F_DRW [label="DRW (Native)\n─────────────────\nPNG carrying drAw chunk\n(DRW_load_from_png) OR\nlegacy binary (DRW_MAGIC,\nDRW_load_binary)\nFull project restore:\nlayers, palette, tools,\ndrawer, history"];
        F_PNG [label="PNG Image\n─────────────────\nPlain PNG (no drAw chunk)\nflattened to single layer\nvia _LOADIMAGE fall-through\nRGBA preserved"];
        F_BMP [label="BMP / JPG / GIF ...\n─────────────────\nAny QB64-PE image format\nloaded flat via _LOADIMAGE\n(DRW_load_from_png\nfall-through path)"];
        F_GPL [label="GPL Palette\n─────────────────\nGIMP palette file\n(separate load path)\nPALETTE_LOADER_load_gpl%()"];
    }

    subgraph cluster_deferred {
        label="DEFERRED LOAD PATTERN" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        D1 [label="MOUSE.DEFERRED_ACTION%\n─────────────────\nFile dialog blocks mouse\nDefer load to post-frame\nMOUSE_input_handler_loop()\nexecutes deferred action"];
        D2 [label="MOUSE_cleanup_after_dialog\n─────────────────\nDrain mouse buffer\nForce buttons up\nSUPPRESS_FRAMES = 2\nClear keyboard buffer"];
    }

    subgraph cluster_state_reset {
        label="STATE RESET ON LOAD" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        SR1 [label="DRW_load_binary resets (TOOLS/DRW.BM:625):\n─────────────────\n• TEXT_cancel · AI_JOB_cancel\n• TRANSFORM_cancel · MARQUEE_reset\n• BEZIER_reset · MOVE_init · MAGIC_WAND_reset\n• CROP_reset · ERASER_reset · PAN_reset\n• LINE/RECT/ELLIPSE/POLY_LINE/SPRAY resets\n• SS_* smart-shape resets (polygon..arrow)\n• FILL_ADJ_reset · IMAGE_IMPORT_reset\n• DRAWER_reset · PREVIEW_reset\n• COLORMIXER_reset · CHARMAP_reset\n• PALETTE_OPS_reset\n• GRID_init · PIXEL_GRID_init · SYMMETRY_init\n• HISTORY_clear (undo stack wiped)\nListed explicitly, NOT via TOOLS_reset_all"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Load / Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Cancel / Error" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Step / Complete" arrowhead=normal color="#cccc66" fontsize=9.0];
    }
}
