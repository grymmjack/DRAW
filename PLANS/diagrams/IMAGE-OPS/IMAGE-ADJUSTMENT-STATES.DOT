digraph IMAGE_ADJUSTMENTS {
    label="EFFECTS / IMAGE ADJUSTMENT STATE MACHINE (2.0.0)\n(Effects menu — split ORIG/ADJ loupe preview, wheel sliders, Redo/Recall/Blend Last Effect)" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="EFFECTS /\nADJUSTMENTS"];
    }

    S_IDLE [label="1 · IDLE\n─────────────────\nNo effect dialog open\nNormal painting mode\nLayer pixels unmodified"];
    S_DIALOG [label="2 · DIALOG OPEN\n─────────────────\nShared modal via DIALOG_CTX\n(GUI/DIALOG.BI/BM)\nIMAGE_ADJ_*_dialog() runs\norigThumb + previewThumb built\nSplit ORIG/ADJ loupe shown\nMovable; loupe re-centres"];
    S_ADJUSTING [label="3 · ADJUSTING\n─────────────────\nWheel sliders / angle dial /\ndropdowns / seed / MIX\nDIALOG_slider_drag / _wheel\npreviewDirty → recompute\nIMAGE_ADJ_* → previewThumb\nLIVE loupe update"];
    S_APPLIED [label="4 · APPLIED\n─────────────────\nOK / Enter → result = TRUE\nIMAGE_ADJ_apply_to_layer OR\nIMAGE_ADJ_apply_spatial\n(selection-clipped if active)\nHISTORY_record_transform\nIMGADJ_capture_last_fx"];
    S_CANCELLED [label="5 · CANCELLED\n─────────────────\nCancel / Esc → result = FALSE\nLayer untouched\n(preview was offscreen only)\nDIALOG_cleanup frees thumbs"];

    S_IDLE -> S_DIALOG [label="  Effects → (category) →\n  (effect...)\n  CMD_execute_action 2001+\n  Open modal dialog" color="#66cc66"];
    S_DIALOG -> S_ADJUSTING [label="  Change any control\n  previewDirty = TRUE" color="#cccc66"];
    S_ADJUSTING -> S_ADJUSTING [label="  Slider / dial / wheel\n  Recompute previewThumb\n  Refresh loupe" color="#88aacc"];
    S_ADJUSTING -> S_DIALOG [label="  Control released\n  Preview stable" color="#cccc66"];
    S_DIALOG -> S_APPLIED [label="  Press OK / Enter\n  Commit + record" color="#cccc66"];
    S_DIALOG -> S_CANCELLED [label="  Press Cancel / Esc\n  Discard" color="#cc6666" style=dashed];
    S_DIALOG -> S_DIALOG [label="  Reset-to-default button\n  IMGDLG_reset2/3/4" color="#88aacc"];
    S_APPLIED -> S_IDLE [label="  Return to normal" color="#cccc66"];
    S_CANCELLED -> S_IDLE [label="  Return to normal" color="#cc6666" style=dashed];

    MAIN -> S_IDLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_instant {
        label="INSTANT (no dialog) — direct commit" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        I_INV [label="Invert (2007)\nDesaturate (2008)\nSepia (2101)\n─────────────────\nNo slider — apply\nimmediately + record"];
        I_MISC [label="Difference Clouds (2151)\nMedian / Despeckle (2161)\n─────────────────\nSingle-shot generative /\nfilter, direct commit"];
        I_INV -> I_MISC [style=invis];
    }

    subgraph cluster_categories {
        label="EFFECT CATEGORIES (GUI/IMAGE-ADJ.BM + GJ_IMGADJ_* in GUI/IMGADJ.BM)" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        C_ADJ [label="Adjust\n─────────────────\nBrightness/Contrast (2001)\nHue/Saturation (2002)\nLevels (2003)\nColor Balance (2004)\nGamma (2107) · Posterize (2009)\nThreshold · Colorize · Duotone"];
        C_BLUR [label="Blur / Sharpen / Noise\n─────────────────\nBlur (2005) alpha-aware\nSharpen (2006) = Unsharp Mask\n  IMAGE_ADJ_apply_sharpen\n  (amount/radius/threshold)\nAdd Noise (2160, MIX+angle+seed)\nDust & Scratches · Median"];
        C_STYLE [label="Stylize\n─────────────────\nEdge Detect · Emboss · Solarize\nChromatic Aberration\nGlow · Vignette · Film Grain\nOutline/Stroke · Gradient Map\nDrop/Long Shadow · Bevel\nOuter/Inner Glow · Chrome"];
        C_DISTORT [label="Distort\n─────────────────\nWave/Ripple · Twirl\nPinch/Bulge · Kaleidoscope\nWind · Pixelate"];
        C_TESS [label="Tessellate\n─────────────────\nMosaic (2142) — cell SHAPE\n  param + grout + seed\nStained Glass · Crystallize\nExtrude · Pointillize"];
        C_RENDER [label="Render / Generate\n─────────────────\nClouds (seed) · Sky (seed)\nLens Flare · Terrain (seed)\nRender Grid · Fire · Smoke\nRust · Snow · Lightning ..."];

        C_ADJ -> C_BLUR [style=invis];
        C_BLUR -> C_STYLE [style=invis];
        C_STYLE -> C_DISTORT [style=invis];
        C_DISTORT -> C_TESS [style=invis];
        C_TESS -> C_RENDER [style=invis];
    }

    subgraph cluster_preview {
        label="LIVE LOUPE PREVIEW SYSTEM" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        PV1 [label="Loupe Capture\n─────────────────\nIMAGE_ADJ_update_loupe\nPadded crop around dialog\n(IMGADJ_LOUPE_PAD = 40)\nIMGADJ_LOUPE_CROPX/Y\nRe-captured when dialog moves\n(ctx.loupeDirty)"];
        PV2 [label="Split ORIG / ADJ\n─────────────────\nctx.origThumb (before)\nctx.previewThumb (after)\nctx.splitX draggable divider\nDIALOG_draw_preview\nSelection silhouette clip"];
        PV3 [label="Effect Compute\n─────────────────\nIMGADJ_fx_src → source\nIMAGE_ADJ_* returns new img\nIMGADJ_clip_to_selection\nif marquee active\nrecompute on previewDirty"];
    }

    subgraph cluster_lastfx {
        label="LAST EFFECT OPS (Effects menu, category 9)" labelloc=t labeljust=l
        fontcolor=magenta fontsize=11.0 fontname="Cascadia Code PL"
        color=magenta style=dashed penwidth=1

        LF1 [label="Redo Last Effect (2350)\n─────────────────\nCtrl+F\nIMAGE_ADJ_redo_last\nRe-apply last effect + params\nno dialog"];
        LF2 [label="Recall Last Effect (2351)\n─────────────────\nCtrl+Alt+F\nIMAGE_ADJ_recall_last\nRe-open last dialog with\nremembered settings"];
        LF3 [label="Blend Last Effect (2352)\n─────────────────\nCtrl+Shift+F\nIMAGE_ADJ_blend_last\nFade/blend last result\n(opacity + blend mode)\nIMGADJ_blend_compose"];
        LF1 -> LF2 [style=invis];
        LF2 -> LF3 [style=invis];
    }

    subgraph cluster_history {
        label="HISTORY / TARGETING" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        H1 [label="On Apply\n─────────────────\nIMAGE_ADJ_apply_to_layer or\nIMAGE_ADJ_apply_spatial\nBefore-image snapshot →\nHISTORY_record_transform\nTargets: active layer,\nselection region, or\nIMAGE_ADJ_collect_targets set"];
        H2 [label="Clip to Selection (2290)\n─────────────────\nEffects: Clip to Selection\ntoggle — restrict effect to\nmarquee/magic-wand coverage\nIMGADJ_sel_active / _coverage"];
        H1 -> H2 [style=invis];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Open / Activate" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Cancel / Restore" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Commit / Record" arrowhead=normal color="#cccc66" fontsize=9.0];
        L7 -> L8 [label=" Self / live update" arrowhead=normal color="#88aacc" fontsize=9.0];
    }
}
