digraph IMAGE_RESIZE_CROP {
    label="IMAGE RESIZE / CROP STATE MACHINE" labelloc=t labeljust=c
    ordering=out rankdir=TB
    fontcolor=white fontsize=24.0 fontname="Cascadia Code PL"
    splines=true compound=true
    bgcolor=transparent
    edge [
        color=gray fontcolor="#aaaaaa" fontsize=9.0
        fontname="Cascadia Code PL"
    ];
    node [
        color=white shape=rect style=""
        fontname="Cascadia Code PL" fontsize=11.0 fontcolor=cyan
    ];

    { node [shape=folder color=orange penwidth=2 fontcolor=orange fontsize=13.0];
        MAIN [label="IMAGE\nRESIZE / CROP"];
    }

    S_IDLE [label="1 · IDLE\n─────────────────\nCanvas at current size\nAll layers sized equally\nNo resize/crop pending"];

    MAIN -> S_IDLE [arrowhead=none color="#555555" style=dotted];
    { rank=min; MAIN }

    subgraph cluster_resize {
        label="RESIZE CANVAS (no content scale) — action 1801" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        R_DIALOG [label="Resize Canvas Dialog\n─────────────────\nImage → RESIZE CANVAS...\nCANVAS_resize_dialog()\nInput new W × H fields\nContent stays at top-left\n(canvas grows/crops, pixels\nNOT scaled)"];
        R_EXECUTE [label="Execute Resize\n─────────────────\nCANVAS_resize(newW,newH)\n(TOOLS/CROP.BM:35)\n1. HISTORY_record_canvas_resize\n   (isContent=FALSE)\n2. _NEWIMAGE per layer\n3. _PUTIMAGE 1:1 (no scale)\n4. Free old handles\n5. Update SCRN.canvasW/H"];
        R_DIALOG -> R_EXECUTE [label="  OK (valid W,H)" color="#cccc66"];
    }

    subgraph cluster_resize_content {
        label="RESIZE IMAGE WITH CONTENT (2.0.0) — action 1805" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=magenta style=dashed penwidth=1

        RC_DIALOG [label="Resize With Content Dialog\n─────────────────\nImage → RESIZE IMAGE\nWITH CONTENT...\nCANVAS_resize_with_content_dialog()\nW × H fields (prefilled)\nScales canvas AND pixels\ntogether"];
        RC_EXECUTE [label="Execute Scale-Resize\n─────────────────\nCANVAS_resize_with_content(w,h)\n(TOOLS/CROP.BM:209)\n1. HISTORY_record_canvas_resize\n   (isContent=TRUE)\n2. Collapse aprons\n3. _PUTIMAGE scale each layer\n   old→new (content stretches)\n4. Update SCRN.canvasW/H"];
        RC_DIALOG -> RC_EXECUTE [label="  OK (valid W,H)" color="#cccc66"];
    }

    R_CLEANUP [label="Post-Resize Cleanup\n─────────────────\nSCENE_DIRTY% = TRUE\nBLEND_invalidate_cache\nGrid phase preserved\nZoom / pan re-clamped"];
    R_EXECUTE -> R_CLEANUP [label="  Resized" color="#cccc66"];
    RC_EXECUTE -> R_CLEANUP [label="  Resized" color="#cccc66"];

    subgraph cluster_crop {
        label="CROP / GROW CANVAS (via marquee) — action 1802" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        C_ACTIVATE [label="Begin Crop\n─────────────────\nImage → CROP...\nCROP_begin() (TOOLS/CROP.BM:454)\nCROP.STATE = CROP_STATE_ACTIVE\nCROP.PREV_TOOL saved\nCURRENT_TOOL% = TOOL_MARQUEE\nBox pre-init to FULL canvas"];
        C_ADJUST [label="Adjust Box\n─────────────────\nDrag marquee handles:\n INWARD = crop\n OUTWARD past edge = grow\nBody drag to move\nArrow keys nudge\nDark overlay outside box"];
        C_APPLY [label="Apply Crop/Grow\n─────────────────\nEnter → CROP_apply()\n(TOOLS/CROP.BM:508)\n1. Read MARQUEE.BOX\n2. Resize canvas to box\n   (unified crop OR grow)\n3. Offset content, remap grid\n4. HISTORY + restore PREV_TOOL"];
        C_CANCEL [label="Cancel Crop\n─────────────────\nEsc → CROP_cancel()\n(TOOLS/CROP.BM:485)\nCROP.STATE = CROP_STATE_IDLE\nMARQUEE_reset\nRestore PREV_TOOL\nNo changes"];

        C_ACTIVATE -> C_ADJUST [label="  Full-canvas box shown" color="#66cc66"];
        C_ADJUST -> C_ADJUST [label="  Resize/move\n  handles" color="#88aacc"];
        C_ADJUST -> C_APPLY [label="  Enter" color="#cccc66"];
        C_ADJUST -> C_CANCEL [label="  Escape" color="#cc6666" style=dashed];
    }

    S_IDLE -> R_DIALOG [label="  Image → Resize Canvas" color="#6699ff"];
    S_IDLE -> RC_DIALOG [label="  Image → Resize\n  Image w/ Content" color="#6699ff"];
    S_IDLE -> C_ACTIVATE [label="  Image → Crop" color="#66cc66"];
    R_CLEANUP -> S_IDLE [label="  Done" color="#cccc66"];
    C_APPLY -> S_IDLE [label="  Committed" color="#cccc66"];
    C_CANCEL -> S_IDLE [label="  Aborted" color="#cc6666" style=dashed];

    subgraph cluster_rendering {
        label="CROP RENDERING" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=orange style=dashed penwidth=1

        CR1 [label="CROP_render(dest&)\n─────────────────\nDark overlay outside\ncrop region (50% alpha)\nSize label above marquee\nHandle indicators"];
    }

    subgraph cluster_legend {
        label="LEGEND" labelloc=t labeljust=l
        fontcolor=white fontsize=11.0 fontname="Cascadia Code PL"
        color=white style=dashed penwidth=1
        L1 [label="" shape=point width=0.01]; L2 [label="" shape=point width=0.01];
        L3 [label="" shape=point width=0.01]; L4 [label="" shape=point width=0.01];
        L5 [label="" shape=point width=0.01]; L6 [label="" shape=point width=0.01];
        L7 [label="" shape=point width=0.01]; L8 [label="" shape=point width=0.01];
        L1 -> L2 [label=" Activate / Create" arrowhead=normal color="#66cc66" fontsize=9.0];
        L3 -> L4 [label=" Cancel / Abort" arrowhead=normal color="#cc6666" style=dashed fontsize=9.0];
        L5 -> L6 [label=" Step / Commit" arrowhead=normal color="#cccc66" fontsize=9.0];
        L7 -> L8 [label=" Menu / Dialog" arrowhead=normal color="#6699ff" fontsize=9.0];
    }
}
