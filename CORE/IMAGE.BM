''
' DRAW - CORE/IMAGE.BM
' =============================================================================
' Image handle utilities implementation.
'
' QB64-PE Image Handle Rules:
' - Valid image handles are always < -1 (e.g., -2, -3, -4, ...)
' - A handle of -1 indicates a failed _NEWIMAGE or _LOADIMAGE
' - A handle of 0 is the default screen (should not be freed)
' - Always check < -1 before calling SAFE_FREEIMAGE
'
' @author Rick Christy <grymmjack@gmail.com>
'
$INCLUDEONCE

''
' Check if an image handle is valid
' @param handle LONG The image handle to check
' @return INTEGER - TRUE if handle is valid (< -1), FALSE otherwise
'
FUNCTION IMG_valid% (handle&)
    IMG_valid% = (handle& < -1)
END FUNCTION

''
' Safely free an image handle (only if valid)
' @param handle LONG The image handle to free
'
SUB IMG_safe_free (handle&)
    SAFE_FREEIMAGE handle&
END SUB

''
' Safely free an image handle and reset it to 0
' @param handle LONG The image handle to free (passed by reference, will be set to 0)
'
SUB IMG_safe_free_and_reset (handle&)
    SAFE_FREEIMAGE handle&
    handle& = 0
END SUB

''
' Check if an image handle indicates a failed creation
' @param handle LONG The image handle to check
' @return INTEGER - TRUE if handle is -1 (creation failed), FALSE otherwise
'
FUNCTION IMG_creation_failed% (handle&)
    IMG_creation_failed% = (handle& = -1)
END FUNCTION

''
' Create a new image and log error if creation fails
' @param w LONG Width of the image
' @param h LONG Height of the image
' @param bpp INTEGER Bits per pixel (typically 32)
' @return LONG - The new image handle, or -1 if creation failed
'
FUNCTION IMG_create& (w&, h&, bpp%)
    DIM handle&
    handle& = _NEWIMAGE(w&, h&, bpp%)
    IF handle& = -1 THEN
        ERR_set ERR_IMAGE_CREATE, "Failed to create image " + STR$(w&) + "x" + STR$(h&), ERR_LEVEL_ERROR
    END IF
    IMG_create& = handle&
END FUNCTION

''
' Load an image and log error if loading fails
' @param filename STRING Path to the image file
' @param bpp INTEGER Bits per pixel (typically 32)
' @return LONG - The loaded image handle, or -1 if loading failed
'
FUNCTION IMG_load& (filename$, bpp%)
    DIM handle&
    handle& = _LOADIMAGE(filename$, bpp%)
    IF handle& = -1 THEN
        ERR_set ERR_IMAGE_LOAD, "Failed to load image: " + filename$, ERR_LEVEL_ERROR
    END IF
    IMG_load& = handle&
END FUNCTION

''
' Copy an image and log error if copy fails
' @param source LONG Source image handle to copy
' @param bpp INTEGER Bits per pixel (typically 32)
' @return LONG - The copied image handle, or -1 if copy failed
'
FUNCTION IMG_copy& (source&, bpp%)
    DIM handle&
    IF source& < -1 THEN
        handle& = _COPYIMAGE(source&, bpp%)
        IF handle& = -1 THEN
            ERR_set ERR_IMAGE_CREATE, "Failed to copy image", ERR_LEVEL_ERROR
        END IF
    ELSE
        ERR_set ERR_IMAGE_INVALID, "Cannot copy invalid image handle", ERR_LEVEL_ERROR
        handle& = -1
    END IF
    IMG_copy& = handle&
END FUNCTION


''
' Fill dst (all of it) with the rect (sx, sy, sw, sh) of src, resized: the one
' place the scale ops resample (Rick 2026-11-22: "if antialias is on when we do
' transforms it should also keep antialiasing. even scale down/up and so on").
' Antialias off: the plain nearest-pixel stretch, as before. Antialias on: smooth
' (native/aa_resample.h - an area average when shrinking, bicubic when growing,
' premultiplied alpha), and dst is overwritten rather than blended onto.
' Edit > Transform has its own bicubic (TRANSFORM_sample_smooth).
'
SUB IMG_scale_rect (src AS LONG, sx AS LONG, sy AS LONG, sw AS LONG, sh AS LONG, dst AS LONG)
    DECLARE LIBRARY "../native/aa_resample"
        SUB gj_aa_resample (BYVAL dst AS _OFFSET, BYVAL dw AS LONG, BYVAL dh AS LONG, BYVAL src AS _OFFSET, BYVAL sstride AS LONG, BYVAL sx AS LONG, BYVAL sy AS LONG, BYVAL sw AS LONG, BYVAL sh AS LONG)
    END DECLARE
    DIM dw AS LONG, dh AS LONG, ms AS _MEM, md AS _MEM
    IF src >= -1 _ORELSE dst >= -1 _ORELSE sw < 1 _ORELSE sh < 1 THEN EXIT SUB
    dw = _WIDTH(dst): dh = _HEIGHT(dst)
    IF CFG.ANTIALIAS% = 0 _ORELSE (dw = sw _ANDALSO dh = sh) _ORELSE sx < 0 _ORELSE sy < 0 _ORELSE sx + sw > _WIDTH(src) _ORELSE sy + sh > _HEIGHT(src) THEN
        _PUTIMAGE (0, 0)-(dw - 1, dh - 1), src, dst, (sx, sy)-(sx + sw - 1, sy + sh - 1)
        EXIT SUB
    END IF
    ms = _MEMIMAGE(src): md = _MEMIMAGE(dst)
    gj_aa_resample md.OFFSET, dw, dh, ms.OFFSET, _WIDTH(src), sx, sy, sw, sh
    _MEMFREE ms: _MEMFREE md
END SUB


''
' IMG_scale_rect of all of src.
'
SUB IMG_scale_into (src AS LONG, dst AS LONG)
    IF src >= -1 _ORELSE dst >= -1 THEN EXIT SUB
    IMG_scale_rect src, 0, 0, _WIDTH(src), _HEIGHT(src), dst
END SUB
